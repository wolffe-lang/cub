//! member: false

use sim

fn test_cb18_each_new_foe_has_a_readable_tell_and_recovery() {
    var kind = sim.MARTEN
    while kind <= sim.WISP {
        let m = sim.new_foe_move(kind)
        assert(m.windup >= 8 && m.active > 0 && m.active <= 6, "finite tell and active window")
        assert(m.recovery >= 12, "fairness: a bite fits in recovery")
        kind += 1
    }
    assert(!sim.new_foe_move(sim.HERON).parryable, "the spear requires a dodge")
}

fn test_cb18_wisp_bite_snuffs_without_killing_or_scent() {
    var s = sim.new_foe_arena(1, 80, 24, sim.WISP)
    s.foes[0].x = s.x
    s.foes[0].y = s.y - 3 * sim.FP
    s.foes[0].phase = sim.RETREAT
    s.tick = 103
    s.started = 100
    s.action = sim.BITE
    s.action_x = s.x
    s.action_y = s.y
    s.attack_heading = 0
    s.combo = 3
    sim.strike_foes(mut s)
    assert(s.foes[0].health > 0 && s.foes[0].phase == sim.SNUFFED, "alive but snuffed")
    assert(s.foes[0].since == 103 && s.scent == 0 && s.drops.len == 0, "no kill reward")
}

fn test_cb18_moths_lose_two_per_bite_and_drop_four_each() {
    var s = sim.new_foe_arena(1, 80, 24, sim.CINDER_MOTHS)
    s.foes[0].x = s.x
    s.foes[0].y = s.y - 4 * sim.FP
    s.tick = 103
    s.started = 100
    s.action = sim.BITE
    s.action_x = s.x
    s.action_y = s.y
    s.attack_heading = 0
    s.combo = 3
    sim.strike_foes(mut s)
    assert(s.foes[0].health == 3 && s.drops.len == 1, "two of five moths")
    assert(s.drops[0].value == 8, "four scent each, never a five-moth kill reward")
}

fn test_cb18_burn_has_forty_ticks_and_does_not_lick_out() {
    var s = sim.new_foe_arena(1, 80, 24, sim.ASH_ADDER)
    (mut s.foes).reset()
    s.heart = 20
    s.health = sim.health_max(s.heart)
    let before = s.health
    sim.apply_burn(mut s)
    var tick = 0
    while tick < 40 {
        s.tick += 1
        sim.new_foe_status(mut s)
        tick += 1
    }
    assert(s.health == before - 40 && s.burn_left == 0, "exact forty damage at rest")
    sim.new_foe_status(mut s)
    assert(s.health == before - 40, "bounded expiry")
}

fn test_cb18_water_cures_burn_before_the_next_damage_tick() {
    var s = sim.new_foe_arena(1, 80, 24, sim.ASH_ADDER)
    sim.apply_burn(mut s)
    s.action = sim.DRINK
    let before = s.health
    sim.new_foe_status(mut s)
    assert(
        s.burn_left == 0 && s.health == before,
        "water extinguishes rather than interrupting itself",
    )
}

fn test_cb18_heron_parry_never_turns_the_spear() {
    var s = sim.new_foe_arena(1, 80, 24, sim.HERON)
    s.foes[0].heading = 128
    s.foes[0].phase = sim.STRIKE
    s.foes[0].since = s.tick
    s.foes[0].x = s.x
    s.foes[0].y = s.y - 4 * sim.FP
    s.action = sim.PARRY
    s.started = s.tick
    let before = s.health
    sim.new_foe_step(mut s, 0)
    assert(s.health < before && s.foes[0].phase == sim.STRIKE, "z cannot parry downward spear")
}

fn test_cb18_marten_movement_has_no_invisible_boss_arena_boundary() {
    var s = sim.new(1, 80, 24)
    let x = s.x
    let y = s.y
    (mut s.foes).reset()
    var f = sim.make_new_foe(sim.MARTEN, x, y)
    f.phase = sim.STRIKE
    f.heading = 64
    f.target_x = x + sim.FP
    f.target_y = y
    (mut s.foes).push(f)
    s.x = x - 10 * sim.FP
    sim.new_foe_step(mut s, 0)
    assert(s.foes[0].x > x, "a landing can move on open Shingle ground, outside every boss arena")
}

fn test_cb18_burn_damage_continues_during_dodge_iframes() {
    var s = sim.new_foe_arena(1, 80, 24, sim.ASH_ADDER)
    sim.apply_burn(mut s)
    s.action = sim.DODGE
    s.started = s.tick
    let before = s.health
    sim.new_foe_status(mut s)
    assert(
        s.health == before - 1 && s.burn_left == 39,
        "a roll does not extinguish an existing burn",
    )
}

fn test_cb18_adder_line_misses_a_body_off_the_committed_ray() {
    var s = sim.new_foe_arena(1, 80, 24, sim.ASH_ADDER)
    s.foes[0].heading = 128
    s.foes[0].phase = sim.STRIKE
    s.foes[0].since = s.tick
    s.x = s.foes[0].x + 3 * sim.FP
    s.y = s.foes[0].y + 4 * sim.FP
    let before = s.health
    sim.new_foe_step(mut s, 0)
    assert(
        s.health == before && s.burn_left == 0,
        "inside the old cone is not on the narrow strike line",
    )
}

fn test_cb18_every_new_foe_retains_its_actual_recovery_phase() {
    var kind = sim.MARTEN
    while kind <= sim.WISP {
        region encounter {
            var s = sim.new_foe_arena(1, 80, 24, kind)
            s.foes[0].phase = sim.RETREAT
            s.foes[0].since = 0
            s.tick = 11
            sim.new_foe_step(mut s, 0)
            assert(s.foes[0].phase == sim.RETREAT, "eleven ticks is still recovery")
            s.tick = sim.new_foe_move(kind).recovery
            sim.new_foe_step(mut s, 0)
            assert(
                s.foes[0].phase == (if kind == sim.MARTEN then sim.PERCHED else sim.HUNT),
                "recovery expires at its declared bound, never earlier",
            )
        }
        kind += 1
    }
}

fn test_cb18_adder_parry_kills_and_only_a_landed_strike_burns() {
    var s = sim.new_foe_arena(1, 80, 24, sim.ASH_ADDER)
    s.foes[0].heading = 128
    s.foes[0].phase = sim.STRIKE
    s.foes[0].since = s.tick
    let fb = sim.foe_body(s.foes[0])
    let cb = sim.cub_body_at(s, 0, 0, 0)
    s.x = s.foes[0].x
    s.y = (fb.y1 + 1 - cb.y0) * sim.FP
    s.action = sim.PARRY
    s.started = s.tick
    let before = s.health
    sim.new_foe_step(mut s, 0)
    assert(
        s.foes[0].health == 0 && s.health == before && s.burn_left == 0,
        "a parry kills the adder and does not apply the burn",
    )
    assert(s.drops.len == 1 && s.drops[0].value == 18, "parry and bite share the scent reward")
}

fn test_cb18_heron_dodge_answers_the_unparryable_spear() {
    var s = sim.new_foe_arena(1, 80, 24, sim.HERON)
    s.foes[0].phase = sim.STRIKE
    s.foes[0].since = s.tick
    let fb = sim.foe_body(s.foes[0])
    let cb = sim.cub_body_at(s, 0, 0, 0)
    s.x = s.foes[0].x
    s.y = (fb.y1 + 1 - cb.y0) * sim.FP
    s.action = sim.DODGE
    s.started = s.tick
    let before = s.health
    sim.new_foe_step(mut s, 0)
    assert(s.health == before && s.foes[0].hit, "the spear happened, but the dodge evaded it")
}

// Pending-by-name until cb15's announced merge, not skipped green tests:
// test_cb18_lynx_bite_starts_cb15_bleeding — sim.bleed(mut s).
// test_cb18_marten_bite_starts_cb15_bleeding — sim.bleed(mut s).
// test_cb18_marten_takes_one_pouch_item_and_returns_it_at_the_trunk — take_one/leave.
// test_cb18_empty_pouch_does_not_steal_water_or_scent — take_one returns none.
// test_cb18_yarrow_extinguishes_the_adder_burn — cb15's cure-use signal.
// The adder's status is burn (40), not bleed (60); this distinction is
// asserted here after the API exists and the boss/fairness baselines compare.

fn test_cb18_pre_pouch_scent_hook_is_bounded_and_returns_without_extra_meat() {
    var s = sim.new_foe_arena(1, 80, 24, sim.MARTEN)
    s.foes[0].phase = sim.STRIKE
    s.foes[0].heading = 128
    let fb = sim.foe_body(s.foes[0])
    let cb = sim.cub_body_at(s, 0, 0, 0)
    s.x = s.foes[0].x
    s.y = (fb.y1 + 1 - cb.y0) * sim.FP
    s.scent = 3
    sim.new_foe_step(mut s, 0)
    assert(
        s.scent == 0 && s.foes[0].stolen_scent == 3 && s.flasks == 3,
        "at most the carried three scent, never water or underflow",
    )
    s.tick = 103
    s.started = 100
    s.action = sim.BITE
    s.combo = 3
    s.attack_heading = 0
    s.action_x = s.x
    s.action_y = s.y
    s.foes[0].phase = sim.RETREAT
    sim.strike_foes(mut s)
    assert(
        s.foes[0].health == 8 && s.foes[0].stolen_scent == 0,
        "a surviving landing bite returns the payload",
    )
    assert(
        s.drops.len == 1 && s.drops[0].value == 3 && s.meat.len == 0,
        "return is currency, not a new animal killed for meat",
    )
    assert(
        s.drops[0].x == s.foes[0].home_x && s.drops[0].y == s.foes[0].home_y,
        "the stolen payload drops at the trunk foot, not at the cub",
    )
}
