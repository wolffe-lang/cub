//! sprites — cub's semantic sprites to cells: the sprite table (R-cb00-2 A:
//! the game owns its sprites, the engine's `tier` the tiers and the colour
//! machinery). Two tiers, as pack's:
//!
//! - **rich**: the ground's braille and heavy box drawing as pack's, the
//!   Ashwater `≈`; the creatures are `silhouette`'s pixel bitmaps (cb02b),
//!   whose block elements and braille patterns `rich_code_points` lists
//!   with the ground's; `docs/GLYPHS.md` names every code point and a test
//!   holds the two together;
//! - **plain**: code points 0-255 and the sixteen colours only —
//!   `grid.plain_ok` holds a frame to it and a test holds every sprite.
//!
//! Colours are named once in `docs/PALETTE.md` (cb01 writes it; the numbers
//! here are the Shingle's afternoon, the dusk and night keyframes to come
//! with the areas). The posture bands (the bible's section 3: ears for
//! stamina, the tail for health) are the cub's variants; the scaffold
//! draws the fresh band and names the others.

use folk
use grid
use silhouette
use tier

// Sprites.

/// Gravel: the Shingle's ground (variant 0-3: bare, three marks).
pub const SP_GRAVEL: int = 0

/// Grass (variant 0-1).
pub const SP_GRASS: int = 1

/// A trunk.
pub const SP_TRUNK: int = 2

/// Canopy (variant 0-3, lighter to darker).
pub const SP_CANOPY: int = 3

/// Deep forest: the canopy's four glyphs in the deep green (variant 0-3),
/// visible and textured everywhere, still impassable.
pub const SP_DARK: int = 4

/// The Ashwater (variant 0-3: still, three ripples).
pub const SP_WATER: int = 5

/// Reeds at the water's edge (variant 0-1).
pub const SP_REEDS: int = 6

/// Jetty stone, the crags' rock: mottled faces, distinct from foliage
/// (variant 0-1, alternated by the cell's parity so no two neighbours
/// match).
pub const SP_ROCK: int = 7

/// Shallows: the Ashwater where it can be waded (variant 0-3: still,
/// three ripples), lighter than the deep water (cb04).
pub const SP_SHALLOWS: int = 8

/// Ash (cb05): the burn's ground and Cinderwick's (variant 0-3: bare,
/// three flecks).
pub const SP_ASH: int = 9

/// A ruined wall (cb05): broken stone in two faces (variant 0-1).
pub const SP_WALL: int = 10

/// An ember that never went out (cb05): a glowing coal (variant 0-1, the
/// pulse; cb14: 2 the Burn's coal under the ash, 3 its flare).
pub const SP_EMBER: int = 11

/// The Stand's needle floor (cb14): bare, two needle marks, the crown of a
/// pine (variant 3, drawn in the cell up-left of a trunk's top).
pub const SP_NEEDLES: int = 12

/// A pine of the Stand: a full column.
pub const SP_PINE: int = 13

/// A charred trunk of the Burn (variant 0 standing, 1 and 2 leaning).
pub const SP_CHAR: int = 14

/// An ash drift (variant 0-1).
pub const SP_DRIFT: int = 15

/// A stepping stone of the Mere (variant 0 dry, 1 sinking).
pub const SP_STONE: int = 16

/// The Underteeth's wall (variant 0-1: the stone and its damp edge).
pub const SP_CAVE: int = 17

/// A glow-worm cluster (variant 0-1: the pulse).
pub const SP_GLOW: int = 18

/// The Underteeth's spring (variant 0 the pool, 1 its ripple).
pub const SP_SPRING: int = 19

/// A barrow of the Howe (variant 0-2: its three cells, west to east).
pub const SP_MOUND: int = 20

/// A standing stone (variant 0 the stone, 1 its mark when read).
pub const SP_MENHIR: int = 21

/// A gate's cells (variant 0 the windthrown pine, 1 the burnt oak, 2 the
/// stone mouth, 3 the sett's squeeze).
pub const SP_GATE: int = 22

/// The number of sprites (every id below this). The cub and the foes are
/// not sprites here: they are `silhouette`'s bitmaps.
pub const SPRITE_COUNT: int = 23

/// The most variants any sprite has (the canopy's and the gravel's four).
pub const VARIANT_COUNT: int = 4

// The palette, by role.

/// Gravel (bg).
pub const C_GRAVEL: int = 0

/// A gravel mark (fg).
pub const C_MARK: int = 1

/// Grass (fg).
pub const C_GRASS: int = 2

/// Trunk (fg).
pub const C_TRUNK: int = 3

/// Canopy light (fg).
pub const C_CANOPY: int = 4

/// Canopy dark (fg).
pub const C_CANOPY_DARK: int = 5

/// Forest floor (bg).
pub const C_FLOOR: int = 6

/// The cub's fur (fg).
pub const C_FUR: int = 7

/// The cub's fur, dim (fg).
pub const C_FUR_DIM: int = 8

/// Water (bg).
pub const C_WATER: int = 9

/// A ripple (fg).
pub const C_RIPPLE: int = 10

/// Reeds (fg).
pub const C_REED: int = 11

/// The number of palette roles.
pub const C_WEASEL: int = 12

/// Fox threat colour, separate from cub and trail.
pub const C_FOX: int = 13

/// The shallows' ripples (fg).
pub const C_SHALLOW: int = 14

/// Number of named colour roles.
pub const ROLE_COUNT: int = 15

/// The colour index a palette role has on a tier (the afternoon; the dusk
/// and night keyframes come with the areas, cb02).
pub fn palette(t: int, role: int) -> int {
    if t == tier.RICH {
        return match role {
            0 => 240,  // C_GRAVEL
            1 => 247,  // C_MARK
            2 => 64,  // C_GRASS
            3 => 94,  // C_TRUNK
            4 => 28,  // C_CANOPY
            5 => 22,  // C_CANOPY_DARK
            6 => 234,  // C_FLOOR
            7 => 180,  // C_FUR
            8 => 137,  // C_FUR_DIM
            9 => 24,  // C_WATER
            10 => 31,  // C_RIPPLE
            12 => 130,
            13 => 166,
            11 => 65,  // C_REED
            14 => 117,  // C_SHALLOW
            _ => grid.COLOR_DEFAULT,
        }
    }
    match role {
        0 => 8,  // C_GRAVEL
        1 => 7,  // C_MARK
        2 => 2,  // C_GRASS
        3 => 3,  // C_TRUNK
        4 => 2,  // C_CANOPY
        5 => 2,  // C_CANOPY_DARK
        6 => 0,  // C_FLOOR
        7 => 11,  // C_FUR
        8 => 3,  // C_FUR_DIM
        9 => 4,  // C_WATER
        10 => 6,  // C_RIPPLE
        12 => 1,
        13 => 9,
        11 => 2,  // C_REED
        14 => 14,  // C_SHALLOW
        _ => grid.COLOR_DEFAULT,
    }
}

fn c(t: int, cp: int, fg: int, bg: int, attrs: int) -> grid.Cell {
    grid.cell(cp, palette(t, fg), palette(t, bg), attrs)
}

/// The cell a sprite is on a tier, with its variant (a texture index, a
/// facing; a variant a sprite has no use for is ignored).
pub fn glyph(t: int, sprite: int, variant: int) -> grid.Cell {
    if t == tier.RICH {
        return rich(sprite, variant)
    }
    plain(sprite, variant)
}

fn rich(sprite: int, v: int) -> grid.Cell {
    let t = tier.RICH
    match sprite {
        0 =>
            c(
                t,
                if v % 4 == 0 {
                    32
                } else if v % 4 == 1 {
                    183
                } else if v % 4 == 2 {
                    8228
                } else {
                    9617
                },
                C_MARK,
                C_GRAVEL,
                0,
            ),  // SP_GRAVEL
        1 => c(t, if v % 2 == 0 then 10294 else 10262, C_GRASS, C_FLOOR, 0),  // SP_GRASS
        2 => c(t, 9475, C_TRUNK, C_FLOOR, 0),  // SP_TRUNK
        3 =>
            c(
                t,
                if v % 4 == 0 {
                    10495
                } else if v % 4 == 1 {
                    10486
                } else if v % 4 == 2 {
                    10478
                } else {
                    10294
                },
                if v % 4 < 2 then C_CANOPY else C_CANOPY_DARK,
                C_FLOOR,
                0,
            ),  // SP_CANOPY
        4 =>
            c(
                t,
                if v % 4 == 0 {
                    10495
                } else if v % 4 == 1 {
                    10486
                } else if v % 4 == 2 {
                    10478
                } else {
                    10294
                },
                C_CANOPY_DARK,
                C_FLOOR,
                0,
            ),  // SP_DARK: the canopy's four glyphs in the deep green
        5 => c(t, if v % 4 == 0 then 32 else 8776, C_RIPPLE, C_WATER, 0),  // SP_WATER
        6 => c(t, if v % 2 == 0 then 10247 else 10262, C_REED, C_WATER, 0),  // SP_REEDS
        7 => c(t, if v % 2 == 0 then 9617 else 9608, C_MARK, C_GRAVEL, 0),  // SP_ROCK
        8 => c(t, if v % 4 == 0 then 32 else 8776, C_SHALLOW, C_WATER, 0),  // SP_SHALLOWS
        9 =>
            c(
                t,
                if v % 4 == 0 {
                    32
                } else if v % 4 == 1 {
                    0x2802
                } else if v % 4 == 2 {
                    0x2810
                } else {
                    0xB7
                },
                C_MARK,
                C_GRAVEL,
                0,
            ),  // SP_ASH
        10 => c(t, if v % 2 == 0 then 0x2593 else 0x2592, C_MARK, C_GRAVEL, 0),  // SP_WALL
        11 =>
            c(
                t,
                if v % 4 == 0 {
                    0x2736
                } else if v % 4 == 1 {
                    0x2735
                } else if v % 4 == 2 {
                    0x28E4
                } else {
                    0x28FF
                },
                C_MARK,
                C_GRAVEL,
                grid.ATTR_BOLD,
            ),  // SP_EMBER
        12 =>
            c(
                t,
                if v % 4 == 0 {
                    32
                } else if v % 4 == 1 {
                    0x2801
                } else if v % 4 == 2 {
                    0x2802
                } else {
                    0x28C0
                },
                C_MARK,
                C_FLOOR,
                0,
            ),  // SP_NEEDLES
        13 => c(t, 0x28FF, C_CANOPY, C_FLOOR, 0),  // SP_PINE
        14 =>
            c(
                t,
                if v % 3 == 0 then 0x2847 else if v % 3 == 1 then 0x28B8 else 0x2838,
                C_MARK,
                C_FLOOR,
                0,
            ),  // SP_CHAR
        15 => c(t, 0x2591, C_MARK, C_FLOOR, 0),  // SP_DRIFT
        16 => c(t, 0x28FF, C_MARK, C_WATER, if v % 2 == 0 then 0 else grid.ATTR_DIM),  // SP_STONE
        17 => c(t, if v % 2 == 0 then 0x2593 else 0x2592, C_MARK, C_FLOOR, 0),  // SP_CAVE
        18 => c(t, if v % 2 == 0 then 0x2836 else 0x283F, C_MARK, C_FLOOR, grid.ATTR_BOLD),  // SP_GLOW
        19 => c(t, if v % 2 == 0 then 0x28C0 else 0x2248, C_SHALLOW, C_WATER, 0),  // SP_SPRING
        20 =>
            c(
                t,
                if v % 3 == 0 then 0x28E0 else if v % 3 == 1 then 0x28E4 else 0x28C4,
                C_MARK,
                C_FLOOR,
                0,
            ),  // SP_MOUND
        21 => c(t, if v % 2 == 0 then 0x28FF else 0x281B, C_MARK, C_FLOOR, 0),  // SP_MENHIR
        22 =>
            c(
                t,
                if v % 4 == 0 {
                    0x28C0
                } else if v % 4 == 1 {
                    0x2847
                } else if v % 4 == 2 {
                    0x2593
                } else {
                    0x2592
                },
                C_MARK,
                C_FLOOR,
                0,
            ),  // SP_GATE
        _ => grid.blank(),
    }
}

fn plain(sprite: int, v: int) -> grid.Cell {
    let t = tier.PLAIN
    match sprite {
        0 =>
            c(
                t,
                if v % 4 == 0 then 32 else if v % 4 == 1 then 46 else if v % 4 == 2 then 44 else 58,
                C_MARK,
                C_GRAVEL,
                0,
            ),  // SP_GRAVEL
        1 => c(t, if v % 2 == 0 then 34 else 39, C_GRASS, C_FLOOR, 0),  // SP_GRASS
        2 => c(t, 124, C_TRUNK, C_FLOOR, 0),  // SP_TRUNK
        3 =>
            c(
                t,
                if v % 4 == 0 then 38 else if v % 4 == 1 then 37 else if v % 4 == 2 then 42 else 59,
                if v % 4 < 2 then C_CANOPY else C_CANOPY_DARK,
                C_FLOOR,
                if v % 4 < 2 then grid.ATTR_BOLD else 0,
            ),  // SP_CANOPY
        4 =>
            c(
                t,
                if v % 4 == 0 then 38 else if v % 4 == 1 then 37 else if v % 4 == 2 then 42 else 59,
                C_CANOPY_DARK,
                C_FLOOR,
                0,
            ),  // SP_DARK
        5 => c(t, if v % 4 == 0 then 32 else 126, C_RIPPLE, C_WATER, 0),  // SP_WATER
        6 => c(t, if v % 2 == 0 then 124 else 33, C_REED, C_WATER, 0),  // SP_REEDS
        7 => c(t, if v % 2 == 0 then 79 else 35, C_MARK, C_GRAVEL, 0),  // SP_ROCK
        8 => c(t, if v % 4 == 0 then 32 else 126, C_SHALLOW, C_WATER, 0),  // SP_SHALLOWS
        9 =>
            c(
                t,
                if v % 4 == 0 then 32 else if v % 4 == 1 then 46 else if v % 4 == 2 then 44 else 39,
                C_MARK,
                C_GRAVEL,
                0,
            ),  // SP_ASH
        10 => c(t, if v % 2 == 0 then 35 else 37, C_MARK, C_GRAVEL, 0),  // SP_WALL
        11 =>
            c(
                t,
                if v % 4 == 0 then 42 else if v % 4 == 1 then 43 else if v % 4 == 2 then 42 else 64,
                C_MARK,
                C_GRAVEL,
                grid.ATTR_BOLD,
            ),  // SP_EMBER
        12 => c(t, if v % 4 == 0 || v % 4 == 3 then 32 else 46, C_MARK, C_FLOOR, 0),  // SP_NEEDLES
        13 => c(t, 124, C_CANOPY, C_FLOOR, 0),  // SP_PINE
        14 => c(t, if v % 3 == 0 then 33 else if v % 3 == 1 then 47 else 92, C_MARK, C_FLOOR, 0),  // SP_CHAR
        15 => c(t, 58, C_MARK, C_FLOOR, 0),  // SP_DRIFT
        16 => c(t, if v % 2 == 0 then 111 else 46, C_MARK, C_WATER, 0),  // SP_STONE
        17 => c(t, if v % 2 == 0 then 35 else 37, C_MARK, C_FLOOR, 0),  // SP_CAVE
        18 => c(t, if v % 2 == 0 then 111 else 79, C_MARK, C_FLOOR, grid.ATTR_BOLD),  // SP_GLOW
        19 => c(t, 126, C_SHALLOW, C_WATER, 0),  // SP_SPRING
        20 => c(t, if v % 3 == 0 then 47 else if v % 3 == 1 then 94 else 92, C_MARK, C_FLOOR, 0),  // SP_MOUND
        21 => c(t, 73, C_MARK, C_FLOOR, 0),  // SP_MENHIR
        22 =>
            c(
                t,
                if v % 4 == 0 then 61 else if v % 4 == 1 then 33 else if v % 4 == 2 then 35 else 37,
                C_MARK,
                C_FLOOR,
                0,
            ),  // SP_GATE
        _ => grid.blank(),
    }
}

/// The shadow alpha's eyes (cb04): a black circle in red over its head.
pub const CP_EYE: int = 9679

/// Every code point the rich tier can draw, each once, ascending: the
/// ground's sprites, every silhouette in every facing and the alpha's eye:
/// the list `docs/GLYPHS.md` must name (a test holds the two together),
/// and PAX's font row's specification for cub.
pub fn rich_code_points() -> List[int] {
    var cps = silhouette.all_code_points()
    // The NPCs' drawings (cb16): the raven's, the badger's, the ashen's.
    folk.code_points(mut cps)
    // Shifted/shaken head composition can form cells absent from a whole
    // unshifted pose. The rendered-art audit checks these against GLYPHS.
    for cp in [0x2831, 0x2851, 0x2861, 0x287c, 0x288a, 0x288c] {
        var present = false
        for used in cps { if used == cp { present = true } }
        if !present { (mut cps).push(cp) }
    }
    // cb18's six original foes: measured from their four-way art sheets.
    for cp in [0x285e, 0x28a9, 0x28c3] {
        var present = false
        for used in cps { if used == cp { present = true } }
        if !present { (mut cps).push(cp) }
    }
    (mut cps).push(CP_EYE)
    for cp in [9472, 9474, 9484, 9488, 9492, 9496, 9500, 9508] { (mut cps).push(cp) }
    // The den's quadrant-sampled side view and animated fire, and the
    // HUD's big scent digits (cb07), which use every quadrant block.
    for cp in [
        0x258c,
        0x2590,
        0x2596,
        0x2597,
        0x2598,
        0x2599,
        0x259a,
        0x259b,
        0x259c,
        0x259d,
        0x259e,
        0x259f,
    ] {
        var found = false
        for used in cps { if used == cp { found = true } }
        if !found { (mut cps).push(cp) }
    }
    var s = 0
    while s < SPRITE_COUNT {
        var v = 0
        while v < VARIANT_COUNT {
            let cp = glyph(tier.RICH, s, v).cp
            var seen = false
            for k in cps {
                if k == cp {
                    seen = true
                }
            }
            if !seen && cp != 32 {
                (mut cps).push(cp)
            }
            v += 1
        }
        s += 1
    }
    // Insertion sort: the list is short.
    var i = 1
    while i < cps.len {
        var j = i
        while j > 0 && cps[j - 1] > cps[j] {
            let t = cps[j]
            cps[j] = cps[j - 1]
            cps[j - 1] = t
            j -= 1
        }
        i += 1
    }
    cps
}
