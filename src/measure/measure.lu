//! measure — the gait lane's instrument (cb02c): the cub's pace on the
//! straight and in a turn, the tail's wag period as the frame draws it,
//! a fox's chase on the straight and through turns, the path cells'
//! styles by kind of path, and the body census (`census`) over a list of
//! replay scripts. Every number is read from the running code, never
//! restated from a constant: it is what `cub --measure` prints before and
//! after a change, and what the note quotes.

use art
use census
use controls
use forest
use grid
use journey
use replay
use sim
use sprites
use std.fs
use terrain
use tier

fn press(mut s: sim.Sim, k: int) {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    sim.step(mut s, keys)
}

fn press2(mut s: sim.Sim, a: int, b: int) {
    var keys = List[int]()
    (mut keys).push(a)
    (mut keys).push(b)
    sim.step(mut s, keys)
}

/// Hundredths of a cell a second from fixed-point units over `ticks`.
fn cps100(fp: int, ticks: int) -> int {
    fp * 30 * 100 / (ticks * sim.FP)
}

fn isqrt(n: int) -> int {
    var r = 0
    while (r + 1) * (r + 1) <= n { r += 1 }
    r
}

fn hundredths(v: int) -> str {
    let whole = v / 100
    let frac = v % 100
    if frac < 10 then "{whole}.0{frac}" else "{whole}.{frac}"
}

/// A cub alone on the shore's top gravel row, facing east at a stand.
fn shore_cub() -> sim.Sim {
    var s = sim.new(1, 80, 24)
    (mut s.foes).reset()
    let b = terrain.bank(1, 0)
    s.y = (b + terrain.REED_ROWS) * sim.FP + sim.FP / 2
    s.heading = 64
    s.heading_target = 64
    s
}

/// Ticks from a stand to the trot, and from the trot (the keys let go,
/// the hold expired) to a stop.
fn start_stop() -> (int, int) {
    var s = shore_cub()
    var up = 0
    while s.speed < sim.trot_at(1) && up < 100 { press(mut s, controls.KEY_RIGHT); up += 1 }
    var i = 0
    while i < 10 { press(mut s, controls.KEY_RIGHT); i += 1 }
    while s.moving && i < 100 { press(mut s, 0); i += 1 }
    var down = 0
    while s.speed > 0 && down < 100 { press(mut s, 0); down += 1 }
    (up, down)
}

/// The pace: cells a second at the trot on the straight (east along the
/// shore), on the diagonal, and through a quarter turn (east to south):
/// the ticks the turn takes, the path speed during it and the radius.
pub fn pace() -> str {
    var s = shore_cub()
    var i = 0
    while i < 30 { press(mut s, controls.KEY_RIGHT); i += 1 }
    let x0 = s.x
    let blocked0 = s.blocked
    i = 0
    while i < 30 { press(mut s, controls.KEY_RIGHT); i += 1 }
    let straight = cps100(s.x - x0, 30)
    let clear = s.blocked == blocked0
    // The quarter turn, from the trot east to holding south.
    var turn_ticks = 0
    var path: int = 0
    while s.heading != 128 && turn_ticks < 60 {
        let px = s.x
        let py = s.y
        press(mut s, controls.KEY_DOWN)
        path += isqrt((s.x - px) * (s.x - px) + (s.y - py) * (s.y - py))
        turn_ticks += 1
    }
    let turning = cps100(path, if turn_ticks > 0 then turn_ticks else 1)
    // Radius: path length over the angle (a quarter turn is pi/2; in
    // hundredths of a cell, path * 2 / pi).
    let radius = path * 100 * 2 * 1000 / (3142 * sim.FP)
    // The diagonal: down and right together from the top row, at once (a
    // 30-tick run east first, cb02c's window, meets the woods at cb03's
    // pace: `diagonal_clear` says whether the measured ticks met ground).
    var d = shore_cub()
    var di = 0
    while di < 12 { press2(mut d, controls.KEY_RIGHT, controls.KEY_DOWN); di += 1 }
    let dx1 = d.x
    let dy1 = d.y
    let blocked1 = d.blocked
    di = 0
    while di < 8 { press2(mut d, controls.KEY_RIGHT, controls.KEY_DOWN); di += 1 }
    let diag = cps100(isqrt((d.x - dx1) * (d.x - dx1) + (d.y - dy1) * (d.y - dy1)), 8)
    // Whether the diagonal's measured ticks met the ground (cb03): a
    // faster cub covers more of the shore in the same window.
    let diag_clear = d.blocked == blocked1
    let (up, down) = start_stop()
    "pace trot_fp {sim.trot_at(1)} to_trot_ticks {up} to_stop_ticks {down} straight_cps {hundredths(straight)} clear {clear} diagonal_cps {hundredths(diag)} diagonal_clear {diag_clear} quarter_turn_ticks {turn_ticks} turning_cps {hundredths(turning)} turn_radius_cells {hundredths(radius)} sneak_fp {sim.trot_at(1) / 2} foe_stalk_fp {sim.FOE_STALK_V} foe_retreat_fp {sim.FOE_RETREAT_V}"
}

/// A key for the frame's tail cells: the two west columns of an
/// east-facing cub (the north drawing's last cell row, turned), each the
/// silhouette's glyph where the fur is drawn, else nothing (the ground
/// passing under the cub is not the tail moving), folded into one number.
/// The frame dies with the call's region (a flat instrument).
fn tail_key(s: sim.Sim) -> int {
    var key: int = 0
    region frame {
        var g = grid.new(s.rows, s.cols)
        art.render(s, tier.RICH, mut g)
        let r = sim.screen_row(s)
        let c = sim.screen_col(s)
        let fur = sprites.palette(tier.RICH, sprites.C_FUR)
        let dim = sprites.palette(tier.RICH, sprites.C_FUR_DIM)
        var dr = 0
        while dr < 2 {
            var dc = -3
            while dc < -1 {
                let cell = grid.at(g, r + dr, c + dc)
                let v = if cell.fg == fur || cell.fg == dim then cell.cp % 509 + 1 else 0
                key = key * 512 + v
                dc += 1
            }
            dr += 1
        }
    }
    key
}

/// The wag over `n` ticks of a gait (`k` the key held each tick, 0
/// standing; `paw` the cub's paw), after a settling run: the period in
/// hundredths of a tick (0 when the tail never moves) and the distinct
/// tail frames.
fn wag_of(k: int, paw: int, settle: int, n: int) -> (int, int) {
    var s = shore_cub()
    s.paw = paw
    var i = 0
    while i < settle { press(mut s, k); i += 1 }
    var keys = List[int]()
    var seen = List[int]()
    i = 0
    while i < n {
        press(mut s, k)
        let key = tail_key(s)
        (mut keys).push(key)
        var have = false
        for x in seen { if x == key { have = true } }
        if !have { (mut seen).push(key) }
        i += 1
    }
    // The period: the mean gap between entries into the frame entered
    // least often (a frame the wag passes twice a cycle, such as the
    // middle, would halve it), at least twice in the window.
    var period = 0
    var best = 1000000
    for f in seen {
        var first = -1
        var last = -1
        var entries = 0
        i = 1
        while i < n {
            if keys[i] == f && keys[i - 1] != f {
                if first < 0 { first = i }
                last = i
                entries += 1
            }
            i += 1
        }
        if entries >= 2 && entries < best {
            best = entries
            period = (last - first) * 100 / (entries - 1)
        }
    }
    (period, seen.len)
}

/// The wag period standing, sneaking, walking, and walking at a full-grown
/// paw (paw 10, the fastest trot the game grants: there is no sprint), in
/// ticks, with the tail frames seen.
pub fn wag() -> str {
    let (stand, stand_frames) = wag_of(0, 1, 0, 300)
    let (sneak, sneak_frames) = wag_of(controls.KEY_SNEAK_RIGHT, 1, 30, 240)
    let (walk, walk_frames) = wag_of(controls.KEY_RIGHT, 1, 30, 240)
    let (fast, fast_frames) = wag_of(controls.KEY_RIGHT, 10, 30, 160)
    "wag standing_ticks {hundredths(stand)} standing_frames {stand_frames} sneaking_ticks {hundredths(sneak)} sneaking_frames {sneak_frames} walking_ticks {hundredths(walk)} walking_frames {walk_frames} paw10_ticks {hundredths(fast)} paw10_frames {fast_frames} paw10_trot_fp {sim.trot_at(10)}"
}

/// Whether a meadow rectangle holds no blocked cell.
fn open_square(s: sim.Sim, x0: int, y0: int, w: int, h: int) -> bool {
    var y = y0
    while y < y0 + h {
        var x = x0
        while x < x0 + w {
            if sim.blocked(s, x, y) { return false }
            x += 1
        }
        y += 1
    }
    true
}

/// A fox nine cells behind (west of) a trotting cub on its trail, two
/// cells clear of its reach, both at full speed;
/// the cub then runs `legs` legs of `leg` ticks, east and south
/// alternately. One leg is the straight, along the shore's middle row;
/// the turns are run in the first open stretch of the meadow. The
/// answer: the centre distance in hundredths of a cell at the start and
/// at the end, and the tick the fox began its attack (-1 never).
fn chase(legs: int, leg: int) -> (int, int, int) {
    var s = sim.new(1, 80, 24)
    (mut s.foes).reset()
    if legs > 1 {
        s.area = forest.LARKMEADOW
        var found = false
        var y = 20
        while y < 140 && !found {
            var x = -40
            while x < 30 && !found {
                if open_square(s, x, y, 20, 12) {
                    s.x = (x + 11) * sim.FP + sim.FP / 2
                    s.y = (y + 1) * sim.FP + sim.FP / 2
                    found = true
                }
                x += 1
            }
            y += 1
        }
        if !found { return (-1, -1, -1) }
    } else {
        let b = terrain.bank(1, 0)
        s.x = 11 * sim.FP + sim.FP / 2
        s.y = (b + terrain.REED_ROWS + 2) * sim.FP + sim.FP / 2
    }
    s.heading = 64
    s.heading_target = 64
    s.speed = sim.trot_at(1)
    var fox = sim.spawn_foes(1)[2]
    fox.x = s.x - 9 * sim.FP
    fox.y = s.y
    fox.heading = 64
    fox.speed = sim.FOE_STALK_V
    (mut s.foes).push(fox)
    // The cub came this way: its scent lies from the fox to it, a sample a
    // cell, so the fox has the trail as well as the sight to run on.
    var tx = fox.x + sim.FP
    while tx <= s.x {
        (mut s.trail).push(sim.Trail { x: tx, y: s.y, until: sim.TRAIL_TICKS })
        tx += sim.FP
    }
    let start = s.x - fox.x
    var caught = -1
    var leg_i = 0
    var t = 0
    while leg_i < legs {
        var n = 0
        while n < leg {
            press(mut s, if leg_i % 2 == 0 then controls.KEY_RIGHT else controls.KEY_DOWN)
            t += 1
            if caught < 0 && s.foes[0].phase != sim.HUNT { caught = t }
            n += 1
        }
        leg_i += 1
    }
    let f = copy s.foes[0]
    let end = isqrt((s.x - f.x) * (s.x - f.x) + (s.y - f.y) * (s.y - f.y))
    (start * 100 / sim.FP, end * 100 / sim.FP, caught)
}

/// A duel of gaits on the shore: the cub and a fox, each alone in its own
/// world from the same start on the shore's top row, both at full speed
/// east; for `east` ticks both run on, then both are turned south (the
/// cub by its key, the fox steered at a point far south of it, its own
/// hunt held off) for `south` ticks. The answer, hundredths of a cell:
/// how much further east the fox ran than the cub, and how much further
/// south the cub got than the fox once the turn was called.
pub fn duel(east: int, south: int) -> (int, int) {
    var s = shore_cub()
    s.x = 6 * sim.FP + sim.FP / 2
    s.speed = sim.trot_at(1)
    var w = shore_cub()
    var fox = sim.spawn_foes(1)[2]
    fox.x = s.x
    fox.y = s.y
    fox.heading = 64
    fox.speed = sim.FOE_STALK_V
    // Held out of its own hunt (a stagger that never ends): only the
    // duel's steering moves it, and its world's cub stands far off.
    fox.phase = sim.STAGGER
    fox.since = 1000000
    (mut w.foes).push(fox)
    w.x = -90 * sim.FP
    let cx0 = s.x
    let fx0 = w.foes[0].x
    var n = 0
    while n < east {
        press(mut s, controls.KEY_RIGHT)
        sim.run_foe(mut w, 0, w.foes[0].x + 40 * sim.FP, w.foes[0].y)
        press(mut w, 0)
        n += 1
    }
    let ahead = w.foes[0].x - fx0 - (s.x - cx0)
    let cy0 = s.y
    let fy0 = w.foes[0].y
    n = 0
    while n < south {
        press(mut s, controls.KEY_DOWN)
        sim.run_foe(mut w, 0, w.foes[0].x, w.foes[0].y + 40 * sim.FP)
        press(mut w, 0)
        n += 1
    }
    let behind = s.y - cy0 - (w.foes[0].y - fy0)
    (ahead * 100 / sim.FP, behind * 100 / sim.FP)
}

fn signed(v: int) -> str {
    if v < 0 then "-" + hundredths(0 - v) else hundredths(v)
}

/// The fox's chase on the straight and through turns, and the duel.
pub fn chases() -> str {
    let (a0, a1, ac) = chase(1, 60)
    let (b0, b1, bc) = chase(6, 8)
    let (ahead, _) = duel(30, 0)
    let (_, lost) = duel(8, 12)
    "chase straight_start {hundredths(a0)} straight_end {hundredths(a1)} straight_caught {ac} zigzag_start {hundredths(b0)} zigzag_end {hundredths(b1)} zigzag_caught {bc} duel_fox_gains_on_straight_30 {signed(ahead)} duel_fox_loses_in_turn_12 {signed(lost)}"
}

/// The style a world cell draws in on a tier (`art.ground_at`, what
/// `art.terrain_row` puts on the screen).
pub fn style_at(seed: int, area: int, t: int, x: int, y: int) -> grid.Cell {
    art.ground_at(seed, 80, area, t, x, y)
}

/// The colours and the glyphs a set of cells drew in, each once.
struct Styles {
    colours: List[str],
    glyphs: List[str],
}

fn styles() -> Styles {
    Styles { colours: List[str](), glyphs: List[str]() }
}

fn add_once(mut xs: List[str], k: str) {
    for x in xs { if x == k { return } }
    (mut xs).push(k)
}

fn add_style(mut st: Styles, c: grid.Cell) {
    add_once(mut st.colours, "{c.fg}/{c.bg}")
    add_once(mut st.glyphs, "{c.cp}")
}

fn joined(xs: List[str]) -> str {
    var out = ""
    for x in xs { out += if out == "" then x else "," + x }
    out
}

fn styles_text(st: Styles) -> str {
    "{joined(st.colours)} glyphs {joined(st.glyphs)}"
}

/// The colours (fg/bg) and glyphs every path kind's cells draw in, seed
/// 1 at field 80, each tier: the shore, the thorn route, the four coast
/// branches, the coast's log branch.
pub fn paths() -> str {
    var out = ""
    var t = 0
    while t < 2 {
        let tr = if t == 0 then tier.RICH else tier.PLAIN
        var shore = styles()
        var route = styles()
        var branch = styles()
        var log = styles()
        let o = forest.origin(1, forest.SHINGLE)
        var x = -60
        while x <= 60 {
            let b = terrain.bank(1, x)
            var y = b + terrain.REED_ROWS
            while y < b + terrain.REED_ROWS + terrain.SHINGLE_ROWS {
                add_style(mut shore, style_at(1, forest.SHINGLE, tr, x, y))
                y += 1
            }
            x += 1
        }
        var at = 12
        while at < 130 {
            add_style(mut route, style_at(1, forest.SHINGLE, tr, forest.spine(1, 0, at), o + at))
            at += 1
        }
        var cache = 0
        while cache < 4 {
            at = 8
            while at < forest.coast_end(1, cache) {
                add_style(
                    mut branch,
                    style_at(
                        1,
                        forest.SHINGLE,
                        tr,
                        forest.coast_branch_x(1, 80, cache, at),
                        o + at,
                    ),
                )
                at += 1
            }
            cache += 1
        }
        x = -30
        while x <= -12 {
            let by = 22 + forest.curve(1, 0 + 71, x) / 2
            add_style(mut log, style_at(1, forest.SHINGLE, tr, x, o + by))
            x += 1
        }
        out += "paths {if t == 0 then "rich" else "plain"} shore {styles_text(shore)} route {styles_text(route)} branches {styles_text(branch)} log_branch {styles_text(log)}\n"
        t += 1
    }
    out
}

fn frames_of(text: str) -> int {
    let i = text.find("# frames ") else -1
    if i < 0 { return 60 }
    var n = 0
    for b in text[i + 9..].bytes() {
        let d = b as int - 48
        if d < 0 || d > 9 { break }
        n = n * 10 + d
    }
    n
}

/// The census over one replay script, its own frame count.
fn census_of(path: str) -> census.Counts ! {io, parse} {
    census_as(path, -1, 0, 0)
}

/// The census over one replay script, its own frame count; `seed` and
/// `cols` by `rows` override the script's own when `seed >= 0` (the body
/// audit's other worlds: the same keys in another forest).
fn census_as(path: str, seed: int, cols: int, rows: int) -> census.Counts ! {io, parse} {
    let text = fs.read_text(path) else |_| { return io }
    var r = replay.from_text(text, controls.vocab())?
    if seed >= 0 {
        r.seed = seed
        r.cols = cols
        r.rows = rows
    }
    let frames = frames_of(text)
    var s = sim.new(r.seed, r.cols, r.rows)
    let version = replay.args_at(r, 0, controls.EV_JOURNEY)
    if version == journey.JOURNEY || version == 5 || version == 3 {
        var values = List[int]()
        var i = 0
        let count = if version == 3 {
            30
        } else if version == 5 {
            journey.SNAPSHOT_V5
        } else {
            journey.SNAPSHOT
        }
        while i < count {
            (mut values).push(replay.args_at(r, 0, controls.saved_event(i)))
            i += 1
        }
        s = journey.from_snapshot(values, r.cols, r.rows) else |_| { return parse }
    }
    var c = census.counts()
    var keys = List[int]()
    var k = 0
    while k < frames {
        (mut keys).reset()
        let (sc, sr, health) = replay.at(r, k, mut keys)
        if sc > 0 && seed < 0 { sim.resize(mut s, sc, sr) }
        if health < 0 { sim.hurt(mut s, 0 - health) }
        if health > 0 {
            s.health += health
            if s.health > sim.health_max(s.heart) { s.health = sim.health_max(s.heart) }
        }
        s.scent += replay.args_at(r, k, 1)
        if s.scent < 0 { s.scent = 0 }
        if replay.args_at(r, k, 2) == 1 { sim.opening(mut s) }
        sim.step(mut s, keys)
        census.observe(mut c, s)
        k += 1
    }
    c
}

/// The swarm (cb02c): three weasels converge from behind on a cub
/// standing at the first den, facing the river. For `wait` ticks it
/// stands and takes what comes; then it bites whichever is in its reach,
/// aimed at it, until all three are down or `ticks` pass. The census of
/// the run, the foe-ticks a weasel stood in the cub's reach, and the
/// weasels the cub killed.
pub fn swarm(seed: int, cols: int, rows: int, wait: int, ticks: int) -> (census.Counts, int, int) {
    var s = sim.new(seed, cols, rows)
    (mut s.foes).reset()
    let o = forest.origin(seed, forest.SHINGLE)
    let at = 7
    let c = forest.spine(seed, forest.SHINGLE, at)
    var k = 0
    while k < 3 {
        var w = sim.spawn_foes(seed)[0]
        w.x = (c + (k - 1) * 3) * sim.FP + sim.FP / 2
        w.y = (o + at) * sim.FP + sim.FP / 2
        w.heading = 0
        w.target_x = w.x
        w.target_y = w.y
        w.home_x = w.x
        w.home_y = w.y
        (mut s.foes).push(w)
        k += 1
    }
    var counts = census.counts()
    var engaged = 0
    var n = 0
    while n < ticks && s.action != sim.FALL {
        var keys = List[int]()
        if n >= wait && s.action == sim.IDLE {
            var i = 0
            while i < s.foes.len {
                if s.foes[i].health > 0 && sim.in_reach(s, i, 2) {
                    let h = sim.heading_to(s.x, s.y, s.foes[i].x, s.foes[i].y)
                    if h >= 0 {
                        let up = h == 0 || h == 32 || h == 224
                        let down = h == 96 || h == 128 || h == 160
                        let left = h == 160 || h == 192 || h == 224
                        let right = h == 32 || h == 64 || h == 96
                        if up { (mut keys).push(controls.KEY_UP) }
                        if down { (mut keys).push(controls.KEY_DOWN) }
                        if left { (mut keys).push(controls.KEY_LEFT) }
                        if right { (mut keys).push(controls.KEY_RIGHT) }
                    }
                    (mut keys).push(controls.KEY_BITE)
                    break
                }
                i += 1
            }
        }
        sim.step(mut s, keys)
        census.observe(mut counts, s)
        var j = 0
        while j < s.foes.len {
            if s.foes[j].health > 0 && sim.in_reach(s, j, 2) { engaged += 1 }
            j += 1
        }
        var down = 0
        for f in s.foes { if f.health <= 0 { down += 1 } }
        if down == 3 { break }
        n += 1
    }
    var kills = 0
    for f in s.foes { if f.health <= 0 { kills += 1 } }
    (counts, engaged, kills)
}

/// The body audit: fifty seeds at both sizes (80x24, 200x60), the swarm
/// and every encounter script's keys in each world, the census held to no
/// overlap, no contact out of reach and no foe in another; one line a
/// world, then the total. Exit 1 on any breach, or a swarm never fought.
pub fn body_audit(scripts: List[str]) -> int {
    print(
        "seed cols swarm_engaged swarm_contact swarm_kills scripts_contact overlap contact_unreachable foe_overlap",
    )
    var total = census.counts()
    var seed = 0
    while seed < 50 {
        var size = 0
        while size < 2 {
            let cols = if size == 0 then 80 else 200
            let rows = if size == 0 then 24 else 60
            var c = census.counts()
            var engaged = 0
            var kills = 0
            var sw_contact = 0
            var scripted_contact = 0
            // A world's runs die with its region; what leaves are ints.
            region world {
                let (sw, e, k) = swarm(seed, cols, rows, 0, 600)
                census.add(mut c, sw)
                engaged = e
                kills = k
                sw_contact = sw.contact
                for p in scripts {
                    let one = census_as(p, seed, cols, rows) else |err| {
                        eprint("body audit: {p}: {err}")
                        return 2
                    }
                    census.add(mut c, one)
                    scripted_contact += one.contact
                }
                print(
                    "{seed} {cols} {engaged} {sw_contact} {kills} {scripted_contact} {c.overlap} {c.contact_unreachable} {c.foe_overlap}",
                )
            }
            census.add(mut total, c)
            if c.overlap != 0 ||
                c.contact_unreachable != 0 ||
                c.foe_overlap != 0 ||
                engaged == 0 ||
                kills == 0 {
                return 1
            }
            size += 1
        }
        seed += 1
    }
    print("total {census.line(total)}")
    0
}

/// The rich tier's code points (`sprites.rich_code_points`), counted and
/// listed in hex: what `docs/GLYPHS.md` must name.
pub fn glyphs() -> str {
    let cps = sprites.rich_code_points()
    var out = "glyphs {cps.len}"
    for cp in cps { out += " " + hex(cp) }
    out
}

fn hex(v: int) -> str {
    let digits = "0123456789ABCDEF"
    var out = ""
    var n = v
    var i = 0
    while i < 4 {
        let d = n % 16
        out = digits[d..d + 1] + out
        n = n / 16
        i += 1
    }
    out
}

/// Everything, then one census line a script and the total.
pub fn report(paths_in: List[str]) -> int {
    print(pace())
    print(wag())
    print(chases())
    print_raw(paths())
    print(glyphs())
    var total = census.counts()
    for p in paths_in {
        // A script's run dies with its region; the counts are ints.
        region script {
            let c = census_of(p) else |e| {
                eprint("measure: {p}: {e}")
                return 2
            }
            print("census {p} {census.line(c)}")
            census.add(mut total, c)
        }
    }
    print("census total {census.line(total)}")
    0
}
