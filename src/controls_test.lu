//! member: false
//!
//! cub's vocabulary over the engine's decoder: every control from byte
//! strings through the decoder and the mapping, whole and split at every
//! byte; the replay names round trip.

use controls
use input

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode(s: str, at: int) -> List[int] {
    var d = input.new()
    var raw = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        input.feed(mut d, bs[i], if i < at then 1000 else 1010, mut raw)
        i += 1
    }
    input.flush(mut d, 1010 + input.ESC_TIMEOUT_MS, mut raw)
    var keys = List[int]()
    controls.map_all(raw, mut keys)
    keys
}

fn same_keys(a: List[int], b: List[int]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn check(s: str, want: List[int], what: str) {
    var at = 0
    while at <= s.len {
        let got = decode(s, at)
        assert(same_keys(got, want), "{what}: split at {at} gave {got}, want {want}")
        at += 1
    }
}

fn test_arrows_walk_and_shift_arrows_sneak() {
    check("\x1b[A", one(controls.KEY_UP), "up")
    check("\x1b[B", one(controls.KEY_DOWN), "down")
    check("\x1b[D", one(controls.KEY_LEFT), "left")
    check("\x1b[C", one(controls.KEY_RIGHT), "right")
    check("\x1bOB", one(controls.KEY_DOWN), "SS3 down")
    check("\x1b[1;2A", one(controls.KEY_SNEAK_UP), "Shift+Up sneaks north")
    check(
        "\x1b[1;2B",
        one(controls.KEY_SNEAK_DOWN),
        "Shift+Down sneaks south (not pack's parry: R-cb00-4 A)",
    )
    check("\x1b[1;2D", one(controls.KEY_SNEAK_LEFT), "Shift+Left")
    check("\x1b[1;2C", one(controls.KEY_SNEAK_RIGHT), "Shift+Right")
    check("\x1b[1;5A", one(controls.KEY_UP), "Ctrl+Up is Up")
}

fn test_the_moves_and_the_quit() {
    check(" ", one(controls.KEY_BITE), "space bites")
    check("s", one(controls.KEY_HEAVY), "s heavy fallback")
    check("S", one(controls.KEY_HEAVY), "S heavy fallback")
    check("x", one(controls.KEY_LUNGE), "x lunges")
    check("X", one(controls.KEY_LUNGE), "X too")
    check("z", one(controls.KEY_PARRY), "z parries")
    check("c", one(controls.KEY_DODGE), "c dodges")
    check("\t", one(controls.KEY_LOCK), "Tab locks on")
    check("w", one(controls.KEY_WATER), "w drinks")
    check("r", one(controls.KEY_REST), "r rests")
    check("q", one(controls.KEY_QUIT), "q quits")
    check("\x1b", one(controls.KEY_RELEASE), "Esc releases")
    check("\x03", one(controls.KEY_INTERRUPT), "Ctrl-C")
    var skipped = List[int]()
    var n = 0
    while n < 5 { (mut skipped).push(controls.KEY_SKIP); n += 1 }
    check("abg\r\x7f", skipped, "otherwise unused keys skip a scene and are inert during play")
    var want = List[int]()
    (mut want).push(controls.KEY_RELEASE)
    (mut want).push(controls.KEY_BITE)
    check("\x1b ", want, "Alt+Space is Esc then Space")
    var three = List[int]()
    (mut three).push(controls.KEY_LEFT)
    (mut three).push(controls.KEY_SNEAK_DOWN)
    (mut three).push(controls.KEY_BITE)
    check("\x1b[D\x1b[1;2B ", three, "three in one read")
}

fn test_key_names_round_trip() {
    var k = 1
    while k < controls.KEY_COUNT {
        let back = controls.key_of(controls.key_name(k)) else -1
        assert(back == k, "name of {k}: {controls.key_name(k)}")
        k += 1
    }
    assert((controls.key_of("leap") else -1) == -1, "pack's word is not cub's")
    assert(
        controls.key_name(controls.KEY_SNEAK_UP) == "sneak-up" &&
            controls.key_name(controls.KEY_LOCK) == "lock",
        "the words",
    )
    assert(
        controls.is_move(controls.KEY_SNEAK_RIGHT) && !controls.is_move(controls.KEY_BITE),
        "the movement keys",
    )
    let v = controls.vocab()
    assert(v.keys.len == controls.KEY_COUNT && v.args.len == controls.EV_COUNT, "the vocabulary")
}
