//! Strict, durable save index. Paths are absolute; tabs/newlines are forbidden.

use forest
use journey
use sim
use std.env
use std.fs
use std.time

/// A known save; last_played is UTC Unix milliseconds, not elapsed play time.
pub struct Entry {
    path: str,
    name: str,
    seed: int,
    difficulty: int,
    area: int,
    level: int,
    last_played: int,
}

/// Index failures remain distinct from a missing selected save.
pub error Errors = {
    registry_io,
    registry_busy,
    registry_line,
    registry_missing,
    save_corrupt,
    save_version,
    save_difficulty,
    save_io,
}

/// The user data directory; tests always supply a private HOME.
pub fn root() -> str { (env.get("HOME") else ".") + "/.cub" }

fn safe_path(path: str) -> bool {
    if !path.starts_with("/") { return false }
    for b in path.bytes() { if b as int < 32 || b as int == 127 { return false } }
    true
}

/// Exact tab-separated codec, with no ambiguous whitespace splitting.
pub fn encode(entries: List[Entry]) -> str {
    var text = ""
    for e in entries {
        text += "{e.path}\t{e.name}\t{e.seed}\t{e.difficulty}\t{e.area}\t{e.level}\t{e.last_played}\n"
    }
    text
}

/// Unknown shapes and duplicate paths are refused, never partially loaded.
pub fn decode(text: str) -> List[Entry] ! {registry_line} {
    var entries = List[Entry]()
    for line in text.lines() {
        let f = line.split("\t")
        if f.len != 7 || !safe_path(f[0]) || !journey.valid_name(f[1]) { return registry_line }
        let seed = f[2].to_int() else |_| { return registry_line }
        let difficulty = f[3].to_int() else |_| { return registry_line }
        let area = f[4].to_int() else |_| { return registry_line }
        let level = f[5].to_int() else |_| { return registry_line }
        let last_played = f[6].to_int() else |_| { return registry_line }
        if seed < -1000000000 ||
            seed > 1000000000 ||
            difficulty != 0 ||
            area < 0 ||
            area >= forest.AREAS ||
            level < 1 ||
            level > 196 ||
            last_played < 0 {
            return registry_line
        }
        for e in entries { if e.path == f[0] { return registry_line } }
        (mut entries).push(Entry {
            path: f[0],
            name: f[1],
            seed: seed,
            difficulty: difficulty,
            area: area,
            level: level,
            last_played: last_played,
        })
    }
    if encode(entries) != text { return registry_line }
    entries
}

/// An absent index is the empty first-run list; other failures are named.
pub fn load(path: str) -> List[Entry] ! Errors {
    let text = fs.read_text(path) else |e| match e {
        not_found => { return List[Entry]() },
        denied => { return registry_io },
        io => { return registry_io },
        utf8 => { return registry_line },
    }
    decode(text)?
}

/// Pick the newest save; stable path ordering breaks equal-time ties.
pub fn recent(entries: List[Entry]) -> Entry ! {registry_missing} {
    if entries.len == 0 { return registry_missing }
    var best = copy entries[0]
    for e in entries {
        if e.last_played > best.last_played ||
            e.last_played == best.last_played && e.path < best.path {
            best = copy e
        }
    }
    best
}

/// Selecting an absent registry row or a deleted save is never a fresh game.
pub fn find(entries: List[Entry], path: str) -> Entry ! {registry_missing} {
    for e in entries { if e.path == path && fs.is_file(path) { return copy e } }
    registry_missing
}

/// Durable exclusive stage, same-directory atomic replacement, directory sync.
pub fn write(path: str, entries: List[Entry]) -> () ! Errors {
    let text = encode(entries)
    let _ = decode(text)?
    let parent = fs.parent(path) else "."
    fs.create_dir_all(parent) else |_| { return registry_io }
    let temp = path + ".pending"
    var f = fs.create_new(temp) else |e| match e {
        exists => { return registry_busy },
        not_found => { return registry_io },
        denied => { return registry_io },
        io => { return registry_io },
    }
    fs.write(mut f, text) else |_| {
        fs.close(take f) else |_| {}
        fs.remove(temp) else |_| {}
        return registry_io
    }
    fs.sync(mut f) else |_| {
        fs.close(take f) else |_| {}
        fs.remove(temp) else |_| {}
        return registry_io
    }
    fs.close(take f) else |_| { fs.remove(temp) else |_| {}; return registry_io }
    fs.move_file(temp, path) else |_| { fs.remove(temp) else |_| {}; return registry_io }
    fs.sync_dir(parent) else |_| { return registry_io }
}

/// Re-read under an exclusive index lock, so two games cannot lose a row.
pub fn register(index: str, path: str, stamp: int) -> () ! Errors {
    let absolute = fs.realpath(path) else |_| { return registry_missing }
    let s = journey.load(absolute, 1, 80, 24)?
    let meta = journey.load_metadata(absolute)?
    let parent = fs.parent(index) else "."
    fs.create_dir_all(parent) else |_| { return registry_io }
    let lock = index + ".lock"
    let f = fs.create_new(lock) else |e| match e {
        exists => { return registry_busy },
        not_found => { return registry_io },
        denied => { return registry_io },
        io => { return registry_io },
    }
    fs.close(take f) else |_| { fs.remove(lock) else |_| {}; return registry_io }
    update(index, absolute, s, meta.name, stamp) else |e| {
        fs.remove(lock) else |_| {}
        match e {
            registry_busy => { return registry_busy },
            registry_line => { return registry_line },
            registry_missing => { return registry_missing },
            save_corrupt => { return save_corrupt },
            save_version => { return save_version },
            save_difficulty => { return save_difficulty },
            save_io => { return save_io },
            registry_io => { return registry_io },
        }
    }
    fs.remove(lock) else |_| { return registry_io }
}

fn update(index: str, path: str, s: sim.Sim, name: str, stamp: int) -> () ! Errors {
    var entries = load(index)?
    var next = List[Entry]()
    for e in entries { if e.path != path { (mut next).push(e) } }
    (mut next).push(Entry {
        path: path,
        name: name,
        seed: s.seed,
        difficulty: s.difficulty,
        area: s.area,
        level: sim.level(s),
        last_played: stamp,
    })
    write(index, next)?
}

/// What the first-run legacy import did (cb19, cub#91 A): `NOTICE_NONE`,
/// `NOTICE_LEFT` (a legacy save it could not read, left where it is,
/// unregistered) or `NOTICE_KEPT` (the default save too old for this build,
/// kept beside itself as `save.cubN-old`); `text` the one line that says so,
/// `kept` the old file's new path.
pub struct Notice { kind: int, text: str, kept: str }

/// Nothing to say: no legacy save, or it is registered.
pub const NOTICE_NONE: int = 0

/// The legacy save was left where it is, unregistered, with a warning.
pub const NOTICE_LEFT: int = 1

/// The legacy save was too old and is kept as `save.cubN-old`.
pub const NOTICE_KEPT: int = 2

/// The name a too-old save is kept under beside itself: `save.cubN-old`,
/// then `save.cubN-old-2`, `-3` ... (`attempt` counts from 1).
pub fn kept_name(path: str, version: int, attempt: int) -> str {
    if attempt <= 1 then "{path}.cub{version}-old" else "{path}.cub{version}-old-{attempt}"
}

/// Keep `path` under the first `kept_name` not taken: a hard link (which
/// never replaces an existing name) and then the old name removed, the
/// directory synced. The new path, or "" when the file could not be kept.
pub fn keep_old(path: str, version: int) -> str {
    var attempt = 1
    while attempt <= 1000 {
        let name = kept_name(path, version, attempt)
        fs.link(path, name) else |e| match e {
            exists => { attempt += 1; continue },
            not_found => { return "" },
            denied => { return "" },
            cross_device => { return "" },
            io => { return "" },
        }
        fs.remove(path) else |_| {
            // Both names hold the bytes; the old one stays, nothing lost.
            fs.remove(name) else |_| {}
            return ""
        }
        fs.sync_dir(fs.parent(path) else ".") else |_| {}
        return name
    }
    ""
}

/// A save older than this build reads (CUB 1 to CUB 3) kept beside itself
/// as `NAME.cubN-old` (`keep_old`) so a new journey can start at its name
/// (cb19, cub#91 A (b), and the coordinator's ruling for `--save NAME`):
/// `NOTICE_KEPT` and its line (the file, the version found, the versions
/// this cub reads, what was done); `NOTICE_NONE` for any other file, which
/// is left as it is for its reader to name.
pub fn keep_if_too_old(path: str) -> Notice {
    let none = Notice { kind: NOTICE_NONE, text: "", kept: "" }
    if !fs.is_file(path) { return none }
    let v = journey.version_at(path)
    if v < 0 || v >= journey.OLDEST { return none }
    let kept = keep_old(path, v)
    if kept == "" { return none }
    Notice {
        kind: NOTICE_KEPT,
        text: kept_text(journey.shown(path), v, journey.shown(kept)),
        kept: kept,
    }
}

/// First-run legacy import is non-destructive and does not keep stealing
/// Continue; it never stops the start (cb19, cub#91 A): whatever the legacy
/// `~/.cub/save` holds, `--save NAME` or not. A legacy save it cannot read
/// stays where it is, unregistered, and the notice's one line names the
/// file, the version found, the versions this cub reads and what was done;
/// with `default_start` (no `--save`) a save older than this build reads is
/// kept as `save.cubN-old` instead (`keep_if_too_old`) and the title offers
/// a new journey; a save from a newer cub is never renamed (R-cb19-5 A).
/// Nothing is deleted.
pub fn migrate(base: str, default_start: bool) -> Notice {
    let none = Notice { kind: NOTICE_NONE, text: "", kept: "" }
    let index = base + "/registry"
    let legacy = base + "/save"
    if !fs.is_file(legacy) { return none }
    let absolute = fs.realpath(legacy) else |_| { return left(legacy, "could not be resolved") }
    let entries = load(index) else |e| {
        return left(
            legacy,
            "was not imported: the saves list {journey.shown(index)} could not be read [{e}]",
        )
    }
    for e in entries { if e.path == absolute { return none } }
    let _ = journey.load(absolute, 1, 80, 24) else |e| {
        if default_start && "{e}" == "save_version" {
            let kept = keep_if_too_old(absolute)
            if kept.kind == NOTICE_KEPT { return kept }
        }
        let v = journey.version_at(absolute)
        return Notice {
            kind: NOTICE_LEFT,
            text: left_text(journey.shown(legacy), v, "{e}"),
            kept: "",
        }
    }
    register(index, absolute, fs.modified_ms(legacy) else time.unix_ms()) else |e| {
        return left(legacy, "was not imported this time [{e}]")
    }
    none
}

/// The line for a too-old save kept aside (`NOTICE_KEPT`): the file, the
/// version found, the versions this cub reads, its new name.
pub fn kept_text(file: str, v: int, kept: str) -> str {
    "{file} is {journey.found(v)}; {journey.wanted()}. Kept as {kept}, nothing deleted; a new journey starts here."
}

/// The line for a legacy save left where it is (`NOTICE_LEFT`): the file,
/// the version found, the versions this cub reads, what was done.
pub fn left_text(file: str, v: int, error: str) -> str {
    "{file} is {journey.found(v)}; {journey.wanted()}. Left where it is, not in the saves list; this start goes on. [{error}]"
}

fn left(path: str, why: str) -> Notice {
    Notice {
        kind: NOTICE_LEFT,
        text: "{journey.shown(path)} {why}; left where it is; this start goes on.",
        kept: "",
    }
}

/// The sentence a failed registration or index read gets (cb19): a save
/// refused by name goes to `journey.refusal` (the file, the version found,
/// the versions this cub reads, what to do); the index's own failures name
/// the index and what to do. `path` is the save, `index` the saves list.
pub fn failure(index: str, path: str, error: str) -> str {
    if error.starts_with("save_") { return journey.refusal(path, error) }
    let what = if error == "registry_busy" {
        "the saves list {journey.shown(index)} is locked by another cub ({journey.shown(index)}.lock); start again once that cub has closed, or remove the lock if none is running"
    } else if error == "registry_line" {
        "the saves list {journey.shown(index)} has a line this cub cannot read; move it aside and start again (no save is touched)"
    } else if error == "registry_missing" {
        "{journey.shown(path)} is gone or not in the saves list; choose another journey from Load, or start a new one"
    } else {
        "the saves list {journey.shown(index)} could not be read or written; check that {journey.shown(fs.parent(index) else ".")} is a writable directory"
    }
    "{what}. [{error}]"
}
