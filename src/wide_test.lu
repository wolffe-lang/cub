//! member: false
//!
//! cb05, the wide forest: the dens' spacing, the branches' shapes without
//! a sawtooth, the Ashen's bound and its fight, the embers, the retired
//! dens' migration, the lore, the town's yards. Each test samples a few
//! seeds at field 80 (the checked machine's budget); the fifty-seed,
//! both-field censuses are the shipping binary's (`cub --den-spacing`,
//! `--bends-audit`, `--foe-census`, `--spurs-audit`).

use controls
use forest
use journey
use lore
use sim
use terrain
use town
use wide

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// Cardinal tile distance between two local cells of an area, -1 unreached.
fn route_cells(seed: int, field: int, area: int, ax: int, ay: int, bx: int, by: int) -> int {
    let w = forest.bound(field, area)
    let width = w * 2 + 1
    let l = forest.length(area)
    let o = forest.origin(seed, area)
    var dist = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (l + 1) { (mut dist).push(-1); i += 1 }
    let start = ay * width + ax + w
    dist[start] = 0
    (mut queue).push(start)
    var head = 0
    while head < queue.len {
        let cell = queue[head]
        let x = cell % width - w
        let y = cell / width
        if x == bx && y == by { return dist[cell] }
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= 0 && ny <= l {
                let at = ny * width + nx + w
                if dist[at] < 0 && !forest.blocked(seed, field, area, nx, ny + o) {
                    dist[at] = dist[cell] + 1
                    (mut queue).push(at)
                }
            }
            d += 1
        }
        head += 1
    }
    -1
}

fn den_cell(seed: int, den: int) -> (int, int) {
    let (x, y) = forest.den_position(seed, den)
    (
        (x - sim.FP / 2) / sim.FP,
        (y - sim.FP / 2) / sim.FP - forest.origin(seed, forest.den_area(den)),
    )
}

fn test_cb05_two_dens_an_area_at_least_a_den_spacing_apart() {
    // R-cb05-3 A: at most two dens an area, one at least; the thicket's
    // and the meadow's pairs sit ninety rows and more apart on their
    // spines in every seed (the route between them winds further: the
    // walk over the real tiles is `cub --den-spacing`, fifty seeds, both
    // fields, least within 119 at the checkpoint).
    var area = 0
    while area < forest.AREAS {
        assert(forest.den_count(area) <= forest.DENS_PER_AREA, "at most two dens in area {area}")
        assert(forest.den_count(area) >= 1, "a den in area {area}")
        area += 1
    }
    assert(
        forest.den_count(forest.BRAMBLEHOLD) == 2 && forest.den_count(forest.LARKMEADOW) == 2,
        "two",
    )
    assert(forest.DEN_SPACING == 110, "the bar")
    var seed = 0
    while seed < 50 {
        for pair in [(2, 1), (3, 11)] {
            let (a, b) = pair
            let (_, ay) = den_cell(seed, a)
            let (_, by) = den_cell(seed, b)
            assert(
                abs(ay - by) >= 90,
                "dens {a} and {b} are {abs(ay - by)} rows apart, seed {seed}",
            )
            assert(
                !forest.blocked(
                    seed,
                    80,
                    forest.den_area(a),
                    forest.spine(seed, forest.den_area(a), ay),
                    ay,
                ),
                "den {a} on open ground seed {seed}",
            )
        }
        seed += 1
    }
}

fn test_cb05_the_retired_dens_are_landmarks_and_their_journeys_wake_at_a_kept_den() {
    assert(!forest.den_exists(8) && !forest.den_exists(9) && !forest.den_exists(10), "retired")
    assert(
        forest.den_retired(8) && forest.den_retired(9) && forest.den_retired(10),
        "named retired",
    )
    assert(!forest.den_retired(7) && forest.den_exists(7) && forest.den_exists(11), "kept")
    assert(forest.den_area(8) < 0 && forest.den_area(7) == forest.TOWN, "areas")
    // A schema-4 save whose last den is the coal roots wakes at the briar
    // hollow, the nearest kept den of Bramblehold, and lights it.
    var s = sim.new(3, 80, 24)
    s.gate_open = true
    s.last_den = 8
    s.lit_dens = sim.light_den(1, 8)
    let text = journey.encode(s)
    let back = journey.decode(text, 80, 24) else |e| {
        assert(false, "a retired last den is accepted: {e}")
        return
    }
    assert(back.last_den == 2 && back.area == forest.BRAMBLEHOLD, "wakes at the briar hollow")
    assert(sim.light_den(back.lit_dens, 2) == back.lit_dens, "the kept den is lit")
    assert(sim.light_den(back.lit_dens, 8) == back.lit_dens, "the retired bit stays")
    let (x, y) = forest.den_position(3, 2)
    assert(sim.near(back.x, back.y, x, y, 2 * sim.FP), "standing at the kept den")
    // The meadow's two retired dens stood at 66 and 90 of 160 rows: at 288
    // rows both lie nearer the high den (row 190) than the low (row 24).
    assert(
        forest.nearest_kept_den(3, 9) == 11 && forest.nearest_kept_den(3, 10) == 11,
        "the meadow's",
    )
    assert(forest.nearest_kept_den(3, 8) == 2, "the thicket's")
}

fn test_cb05_sixteen_cache_bits_and_the_town_graph() {
    assert(
        forest.cache_bit(forest.TOWN, 3) == 11 && forest.cache_bit(forest.BRAMBLEHOLD, 2) == 12,
        "bits",
    )
    assert(
        forest.cache_bit(forest.LARKMEADOW, 2) == 13 && forest.cache_bit(forest.LARKMEADOW, 1) == 7,
        "old bits kept",
    )
    var s = sim.new(1, 80, 24)
    s.gate_open = true
    s.caches = 65535
    let back = journey.decode(journey.encode(s), 80, 24) else |e| {
        assert(false, "sixteen bits: {e}")
        return
    }
    assert(back.caches == 65535, "every cache bit survives")
    assert(forest.other(forest.SHINGLE, 0) == forest.TOWN, "the gate opens on the town")
    assert(
        forest.exit_end(forest.TOWN, 9) && !forest.exit_end(forest.TOWN, 0),
        "the town's two ends",
    )
    assert(forest.length(forest.TOWN) == 288 && forest.length(forest.CRAGS) == 224, "lengths")
    assert(forest.length(forest.SHINGLE) == forest.LENGTH, "the tutorial's length stands")
}

fn test_cb05_no_branch_or_route_reverses_within_eight_cells() {
    // The sawtooths' census, sampled: every inland branch of two seeds at
    // both fields, and the thicket's fork, show no two counted turns of
    // opposite sign within BEND_WINDOW samples (the fifty-seed run is
    // `cub --bends-audit`).
    var seed = 0
    while seed < 2 {
        for field in [80, 200] {
            for area in [forest.BRAMBLEHOLD, forest.LARKMEADOW] {
                var path = 1
                while path < 2 + forest.cache_count(area) {
                    if path == 1 && area != forest.BRAMBLEHOLD { path += 1; continue }
                    let (from, to) = if path == 1 {
                        (forest.FORK_FROM, forest.FORK_TO)
                    } else {
                        (0, forest.branch_len(seed, field, area, path - 2))
                    }
                    var last_sign = 0
                    var last_at = -100
                    var t = from + wide.BEND_ARM
                    while t <= to - wide.BEND_ARM {
                        let (ax, ay) = sample(seed, field, area, path, t - wide.BEND_ARM)
                        let (bx, by) = sample(seed, field, area, path, t)
                        let (cx, cy) = sample(seed, field, area, path, t + wide.BEND_ARM)
                        let cross = (bx - ax) * (cy - by) - (by - ay) * (cx - bx)
                        if abs(cross) >= wide.BEND_TURN {
                            let sign = if cross > 0 then 1 else -1
                            assert(
                                last_sign == 0 ||
                                    sign == last_sign ||
                                    t - last_at > wide.BEND_WINDOW,
                                "a reversal within eight cells: seed {seed} field {field} area {area} path {path} at {t}",
                            )
                            last_sign = sign
                            last_at = t
                        }
                        t += 1
                    }
                    path += 1
                }
            }
        }
        seed += 1
    }
}

fn sample(seed: int, field: int, area: int, path: int, t: int) -> (int, int) {
    if path == 1 { return (forest.fork(seed, field, t), t) }
    forest.branch_point(seed, field, area, path - 2, t)
}

fn test_cb05_every_branch_centreline_is_carved_and_open() {
    // Each shape's runs, arcs and climbs are carved where its centreline
    // goes, and the cache at the end is open ground; the shapes of an
    // area's branches differ where the field allows.
    var seed = 0
    while seed < 4 {
        for area in [forest.BRAMBLEHOLD, forest.LARKMEADOW] {
            var shapes = List[int]()
            var cache = 0
            while cache < forest.cache_count(area) {
                let len = forest.branch_len(seed, 200, area, cache)
                var t = 0
                while t <= len {
                    let (x, y) = forest.branch_point(seed, 200, area, cache, t)
                    assert(
                        forest.in_branch(seed, 200, area, cache, x, y),
                        "centreline carved seed {seed} area {area} cache {cache} t {t}",
                    )
                    assert(
                        !forest.blocked(seed, 200, area, x, forest.origin(seed, area) + y),
                        "centreline open seed {seed} area {area} cache {cache} t {t}",
                    )
                    t += 3
                }
                (mut shapes).push(forest.branch_shape(seed, 200, area, cache))
                cache += 1
            }
            assert(
                shapes[0] != shapes[1] && shapes[1] != shapes[2] && shapes[0] != shapes[2],
                "three shapes at the 200 field, seed {seed} area {area}: {shapes[0]} {shapes[1]} {shapes[2]}",
            )
        }
        seed += 1
    }
    // The four shapes all occur across the seeds at the wide field.
    var seen = [false, false, false, false]
    var s2 = 0
    while s2 < 12 {
        var c = 0
        while c < 3 {
            seen[forest.branch_shape(s2, 200, forest.LARKMEADOW, c)] = true
            c += 1
        }
        s2 += 1
    }
    assert(
        seen[0] && seen[1] && seen[2] && seen[3],
        "a slow S, a hook, a loop and a 180-degree turn",
    )
}

fn town_cub(seed: int) -> sim.Sim {
    var s = sim.new(seed, 80, 24)
    s.gate_open = true
    let (x, y) = forest.den_position(seed, 7)
    sim.enter_area(mut s, forest.TOWN, x, y)
    s
}

fn test_cb05_an_ashen_never_chases_past_the_towns_edge() {
    // The cub stands on the road past the last plot; an Ashen at the
    // town's edge hears it (a trotting cub within hearing) and walks, yet
    // never steps outside `forest.in_town`.
    var s = town_cub(5)
    (mut s.foes).reset()
    let edge = town.top(town.PLOTS - 1) + town.PITCH + town.EDGE_ROWS
    // Six rows past the edge: within the Ashen's ten cells of hearing
    // (R-cb05-5) as it paces.
    s.x = town.lane(5, edge + 6) * sim.FP + sim.FP / 2
    s.y = (edge + 6) * sim.FP + sim.FP / 2
    var f = sim.make_ashen(
        town.lane(5, edge - 2) * sim.FP + sim.FP / 2,
        (edge - 2) * sim.FP + sim.FP / 2,
    )
    (mut s.foes).push(f)
    var keys = List[int]()
    (mut keys).push(controls.KEY_DOWN)
    var n = 0
    var walked = false
    while n < 160 {
        // The cub paces on the road, in hearing, so the Ashen keeps coming.
        sim.step(mut s, if n % 10 < 5 then copy keys else List[int]())
        let g = copy s.foes[0]
        if g.speed > 0 { walked = true }
        assert(
            forest.in_town(5, sim.floor_div(g.x, sim.FP), sim.floor_div(g.y, sim.FP)),
            "the Ashen stays inside the town at tick {n}: {g.x / sim.FP},{g.y / sim.FP}",
        )
        n += 1
    }
    assert(walked, "the Ashen heard the cub and walked")
    let g = copy s.foes[0]
    assert(sim.floor_div(g.y, sim.FP) <= edge, "it stopped at the edge, not past it")
}

/// An Ashen five cells north facing the cub, the cub trotting into its
/// reach (a standing cub is never heard): the tick the arms rise, or -1.
fn ashen_in_reach(mut s: sim.Sim) -> int {
    (mut s.foes).reset()
    var f = sim.make_ashen(s.x, s.y - 5 * sim.FP)
    f.heading = 128
    (mut s.foes).push(f)
    var up = List[int]()
    (mut up).push(controls.KEY_UP)
    var n = 0
    while n < 200 && s.foes[0].phase != sim.CROUCH {
        sim.step(mut s, copy up)
        n += 1
    }
    if s.foes[0].phase == sim.CROUCH then s.tick else -1
}

fn test_cb05_the_ashen_winds_up_slowly_is_parried_long_and_bitten_from_behind() {
    var s = town_cub(2)
    let wound_at = ashen_in_reach(mut s)
    assert(wound_at > 0, "the Ashen heard the cub and its arms rose")
    var n = 0
    while n < 60 && s.foes[0].phase != sim.STRIKE { sim.step(mut s, List[int]()); n += 1 }
    assert(s.foes[0].phase == sim.STRIKE, "the arms rose, then the blow")
    assert(
        s.tick - wound_at == sim.ASHEN_WINDUP,
        "the windup is {sim.ASHEN_WINDUP} ticks: {s.tick - wound_at}",
    )
    // Parried in the window: a long stagger, the riposte open.
    var t = town_cub(2)
    assert(ashen_in_reach(mut t) > 0, "again")
    n = 0
    while n < 60 && t.foes[0].phase == sim.CROUCH {
        let age = t.tick - t.foes[0].since
        var k = List[int]()
        if age == sim.ASHEN_WINDUP - 2 { (mut k).push(controls.KEY_PARRY) }
        sim.step(mut t, k)
        n += 1
    }
    while n < 70 && t.foes[0].phase == sim.STRIKE { sim.step(mut t, List[int]()); n += 1 }
    assert(t.foes[0].phase == sim.STAGGER, "parried: the Ashen staggers, phase {t.foes[0].phase}")
    assert(t.health == sim.health_max(1), "no blow landed: {t.health}")
    assert(
        t.riposte - t.tick == sim.ASHEN_STAGGER,
        "the riposte stays open {sim.ASHEN_STAGGER} ticks",
    )
    var held = 0
    while t.foes[0].phase == sim.STAGGER && held < 100 { sim.step(mut t, List[int]()); held += 1 }
    assert(held == sim.ASHEN_STAGGER, "the stagger lasts {sim.ASHEN_STAGGER} ticks: {held}")
    // A bite from behind lands twice: an Ashen in its recovery (it hears
    // nothing then) facing north, the cub walked up behind it, biting north.
    var u = town_cub(2)
    (mut u.foes).reset()
    var h = sim.make_ashen(u.x, u.y - 5 * sim.FP)
    h.heading = 0
    h.phase = sim.RETREAT
    h.since = u.tick
    (mut u.foes).push(h)
    var up = List[int]()
    (mut up).push(controls.KEY_UP)
    var m = 0
    while m < 30 && sim.gap(sim.cub_body(u), sim.foe_body(u.foes[0])) > 0 {
        sim.step(mut u, copy up)
        m += 1
    }
    assert(sim.gap(sim.cub_body(u), sim.foe_body(u.foes[0])) == 0, "behind it, touching")
    assert(u.foes[0].heading == 0, "it faces away still")
    u.heading = 0
    u.heading_target = 0
    var bite = List[int]()
    (mut bite).push(controls.KEY_BITE)
    sim.step(mut u, bite)
    m = 0
    while m < 6 { sim.step(mut u, List[int]()); m += 1 }
    assert(
        u.foes[0].health == 36 - 2 * sim.bite_damage(1),
        "twice the bite from behind: {u.foes[0].health}",
    )
}

fn test_cb05_an_ember_burns_a_little_and_a_dug_cache_says_its_line() {
    var s = town_cub(4)
    (mut s.foes).reset()
    // Stand on an ember.
    let (ex, ey) = town.square_ember(4, 1)
    assert(forest.kind(4, 80, forest.TOWN, ex, ey) == terrain.EMBER, "an ember in the square")
    s.x = ex * sim.FP + sim.FP / 2
    s.y = ey * sim.FP + sim.FP / 2
    let before = s.health
    var n = 0
    while n < sim.EMBER_TICKS * 3 { sim.step(mut s, List[int]()); n += 1 }
    assert(
        s.health == before - 3 * sim.EMBER_HURT,
        "the ember's heat: {before - s.health} over thirty ticks",
    )
    // Dig the town's third cache: a lore line, shown for LINE_TICKS.
    let (cx, cy) = forest.cache_position(4, 80, forest.TOWN, 2)
    s.x = cx
    s.y = cy
    var dig = List[int]()
    (mut dig).push(controls.KEY_REST)
    sim.step(mut s, dig)
    let (reward, line) = sim.cache_reward(forest.TOWN, 2)
    assert(reward == lore.LORE && line == lore.TOWN_FIRE, "the fire's line")
    assert(
        s.lore == lore.TOWN_FIRE && s.lore_until == s.tick + lore.LINE_TICKS,
        "the line is shown",
    )
    assert(sim.cache_open(s, 2) && s.marrow == 0, "a lore cache gives no pouch")
    var k = 0
    while k < lore.LINE_TICKS { sim.step(mut s, List[int]()); k += 1 }
    assert(s.lore < 0, "the line lapses")
    assert(
        lore.line(lore.TOWN_FIRE).contains("last warm hollow") ||
            lore.line(lore.TOWN_FIRE).contains("still warm"),
        "it says where the fire went",
    )
    // The marrow yard.
    let (r1, _) = sim.cache_reward(forest.TOWN, 1)
    assert(r1 == lore.MARROW, "the second yard's marrow")
}

fn test_cb05_the_towns_yards_and_hearth_are_reached_through_their_passages() {
    // The flood over the town's tiles is the world audit's (fifty seeds,
    // both fields, 0 unreached); here the way is walked piece by piece in
    // three seeds: the lane open row by row, every yard's cache on ash
    // behind a standing far wall, its gap cells open, the passage from
    // the verge to the gap one cell wide and open, the hearth on ash.
    var seed = 0
    while seed < 3 {
        // The lane past the thorn collar at the town's start.
        var at = forest.thorn_row(seed, forest.TOWN) + 1
        while at <= forest.length(forest.TOWN) {
            assert(
                forest.kind(seed, 80, forest.TOWN, town.lane(seed, at), at) != terrain.WALL,
                "the lane row {at}",
            )
            assert(
                !forest.blocked(seed, 80, forest.TOWN, town.lane(seed, at), at),
                "the lane open row {at}",
            )
            at += 1
        }
        var c = 0
        while c < 4 {
            let (x, y) = forest.cache_position(seed, 80, forest.TOWN, c)
            let lx = (x - sim.FP / 2) / sim.FP
            let ly = (y - sim.FP / 2) / sim.FP
            let (side, plot) = town.cache_plot(c)
            let (near, far) = town.house_x(seed, side, plot)
            assert(forest.kind(seed, 80, forest.TOWN, lx, ly) == terrain.ASH, "a yard is ash")
            assert(
                forest.kind(seed, 80, forest.TOWN, far, ly) == terrain.WALL,
                "the far wall stands",
            )
            let (which, past) = town.yard_gap(seed, side, plot)
            let gap_row = if which == 0 then town.top(plot) else town.bottom(plot)
            let passage = if which == 0 then town.top(plot) - 1 else town.bottom(plot) + 1
            let gx = far + side * past
            assert(
                forest.kind(seed, 80, forest.TOWN, gx, gap_row) == terrain.ASH &&
                    forest.kind(seed, 80, forest.TOWN, gx + side, gap_row) == terrain.ASH,
                "the gap is open, seed {seed} cache {c}",
            )
            // From the verge beside the near wall to the gap's column along
            // the passage row: open, and walled on the house's side.
            var px = near - side
            while side * (gx + side - px) >= 0 {
                // Ash, or the lane's own floor where the lane swings close.
                assert(
                    !forest.blocked(seed, 80, forest.TOWN, px, passage),
                    "the passage open at {px}, seed {seed} cache {c}",
                )
                px += side
            }
            // One cell wide: the house's corners on the passage's side stand
            // (a ruin's fallen cells lie between them, never at a corner).
            let house_row = if which == 0 then town.top(plot) else town.bottom(plot)
            assert(
                forest.kind(seed, 80, forest.TOWN, far, house_row) == terrain.WALL,
                "the far corner stands",
            )
            assert(
                forest.kind(seed, 80, forest.TOWN, near, house_row) == terrain.WALL,
                "the near corner stands",
            )
            c += 1
        }
        let (hx, hy) = den_cell(seed, 7)
        assert(
            forest.kind(seed, 80, forest.TOWN, hx, hy) == terrain.ASH,
            "the hearth on ash seed {seed}",
        )
        seed += 1
    }
    assert(town.PASSAGE == 1, "single file")
}

fn test_cb05_the_landmarks_stand_on_open_ground_within_sight_of_their_dens() {
    var seed = 0
    while seed < 3 {
        var area = 0
        while area < forest.AREAS {
            var k = 0
            while k < forest.landmark_count(area) {
                let (kind, lx, ly) = forest.landmark(seed, 80, area, k)
                assert(
                    !forest.blocked(seed, 80, area, lx, forest.origin(seed, area) + ly),
                    "landmark {k} of area {area} open, seed {seed}",
                )
                assert(ly == forest.landmark_row(seed, area, k), "the row guard agrees")
                if kind == forest.LM_SPLIT_OAK ||
                    kind == forest.LM_CLEFT ||
                    kind == forest.LM_WILLOW {
                    let den = if kind == forest.LM_SPLIT_OAK {
                        1
                    } else if kind == forest.LM_CLEFT {
                        4
                    } else {
                        5
                    }
                    let (dx, dy) = den_cell(seed, den)
                    assert(abs(dx - lx) <= 8 && abs(dy - ly) <= 3, "within sight of den {den}")
                }
                k += 1
            }
            area += 1
        }
        seed += 1
    }
    assert(
        forest.landmark_count(forest.LARKMEADOW) == 4 && forest.landmark_count(forest.TOWN) == 2,
        "counts",
    )
}

fn test_cb05_two_ashen_pursue_and_a_third_keeps_its_post() {
    // R-cb05-5: three Ashen within hearing of a trotting cub; two take its
    // trail, the third stands turned toward it; when one of the two is
    // beaten the third comes.
    var s = town_cub(2)
    (mut s.foes).reset()
    var k = 0
    while k < 3 {
        var f = sim.make_ashen(s.x + (k - 1) * 4 * sim.FP, s.y - 5 * sim.FP)
        f.heading = 128
        (mut s.foes).push(f)
        k += 1
    }
    // The cub trots south, away from them, a few ticks: still within
    // hearing, and heard (a standing cub is not).
    var down = List[int]()
    (mut down).push(controls.KEY_DOWN)
    var n = 0
    while n < 8 { sim.step(mut s, copy down); n += 1 }
    assert(sim.ashen_pursuers(s) == 2, "two pursue: {sim.ashen_pursuers(s)}")
    var posted = 0
    var i = 0
    while i < 3 {
        if !s.foes[i].chasing {
            posted += 1
            assert(s.foes[i].speed == 0, "the third keeps its post")
        }
        i += 1
    }
    assert(posted == 1, "one keeps its post")
    // One of the two falls: the third takes the trail.
    i = 0
    while i < 3 { if s.foes[i].chasing { s.foes[i].health = 0; break }; i += 1 }
    n = 0
    while n < 4 { sim.step(mut s, copy down); n += 1 }
    assert(sim.ashen_pursuers(s) == 2, "the third comes: {sim.ashen_pursuers(s)}")
}

fn test_cb05_an_ashen_hears_ten_cells_and_two_sneaking() {
    var s = town_cub(2)
    (mut s.foes).reset()
    var far = sim.make_ashen(s.x, s.y - 12 * sim.FP)
    far.heading = 128
    (mut s.foes).push(far)
    var down = List[int]()
    (mut down).push(controls.KEY_DOWN)
    var n = 0
    while n < 6 { sim.step(mut s, copy down); n += 1 }
    assert(!s.foes[0].chasing, "twelve cells off, unheard")
    var t = town_cub(2)
    (mut t.foes).reset()
    var near = sim.make_ashen(t.x, t.y - 9 * sim.FP)
    near.heading = 128
    (mut t.foes).push(near)
    n = 0
    while n < 6 { sim.step(mut t, copy down); n += 1 }
    assert(t.foes[0].chasing, "nine cells off, heard")
    assert(
        sim.ASHEN_HEARING == 10 && sim.ASHEN_HEARING_SNEAK == 2 && sim.ASHEN_PURSUERS == 2,
        "R-cb05-5's numbers",
    )
}
