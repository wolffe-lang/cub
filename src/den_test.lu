//! member: false

use forest
use sim

fn test_cb04a_bramblehold_den_is_down_a_winding_leg() {
    var seed = 0
    while seed < 50 {
        let (_, y) = forest.den_position(seed, 1)
        let at = y / sim.FP
        var walked = 0
        var row = 1
        while row <= at {
            let dx = forest.spine(seed, 1, row) - forest.spine(seed, 1, row - 1)
            walked += 1 + (if dx < 0 then -dx else dx)
            row += 1
        }
        assert(walked * 3 >= forest.path_length(seed, 1), "den beyond one third of the path")
        assert(at > 56, "past the first foe cluster")
        seed += 1
    }
}

fn den_key(k: int) -> List[int] {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    keys
}

fn test_cb04a_den_enters_at_three_cells_and_pauses_world() {
    var s = sim.new(7, 80, 24)
    s.x += 3 * sim.FP
    s.health = 1
    sim.step(mut s, den_key(15))
    assert(s.den && s.health == 52, "r enters at the visible den edge")
    let x = s.x
    let foe_x = s.foes[0].x
    sim.step(mut s, den_key(4))
    sim.step(mut s, den_key(9))
    assert(s.den && s.x == x && s.foes[0].x == foe_x && s.action == sim.IDLE, "rest pauses play")
    sim.step(mut s, den_key(18))
    assert(!s.den && s.x == x, "Esc leaves without stale held motion")
    sim.step(mut s, den_key(15))
    assert(s.den, "r reenters")
    s.health = 40
    sim.step(mut s, den_key(15))
    assert(!s.den && s.health == 40, "leaving is not another rest")
}

fn test_cb04a_death_wakes_at_rested_den_two_not_the_start() {
    var s = sim.new(7, 80, 24)
    s.gate_open = true
    let (x, y) = forest.den_position(7, 2)
    sim.enter_area(mut s, 1, x + 3 * sim.FP, y)
    sim.step(mut s, den_key(15))
    assert(s.den && s.last_den == 2, "rest from the den contact edge")
    sim.step(mut s, den_key(18))
    s.scent = 37
    sim.hurt(mut s, 1000)
    let death_x = s.mark_x
    let death_y = s.mark_y
    var n = 0
    while n < 30 { sim.step(mut s, den_key(0)); n += 1 }
    assert(s.area == 1 && s.x == x && s.y == y && s.last_den == 2, "death checkpoint, not start")
    assert(
        s.mark &&
            s.mark_area == 1 &&
            s.mark_x == death_x &&
            s.mark_y == death_y &&
            s.mark_scent == 37,
        "death spot retained",
    )
    assert(s.health == sim.health_max(s.heart) && s.action == sim.IDLE, "same reset as rest")
}
