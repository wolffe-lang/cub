/// The demo as a replay (`parse` cannot happen: the lines are a committed case).
pub fn load() -> replay.Replay {
    var text = ""
    for l in lines() { text += l + "\n" }
    replay.from_text(text, controls.vocab()) else replay.new(1, 1, 80, 24)
}
