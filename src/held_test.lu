//! member: false

use controls
use forest
use input
use sim

fn exact_cub() -> sim.Sim {
    var s = sim.new(1, 200, 40)
    (mut s.foes).reset()
    s.key_state = input.state_new(true)
    s
}

fn test_cb04b_release_resumes_held_direction() {
    var s = exact_cub()
    sim.step(mut s, [controls.KEY_DOWN])
    sim.step(mut s, [controls.KEY_LEFT])
    assert(sim.held_direction(s) == 160, "two held arrows form a diagonal")
    sim.step(mut s, [controls.KEY_ARROW_RELEASE + 2])
    assert(sim.held_direction(s) == 128, "release Left must resume still-held Down")
    var i = 0
    while i < 30 { sim.step(mut s, List[int]()); i += 1 }
    assert(sim.held_direction(s) == 128, "exact hold never expires on unrelated ticks")
    sim.step(mut s, [controls.KEY_ARROW_RELEASE + 1])
    assert(sim.held_direction(s) == -1, "last release stops movement")
}

fn test_cb04b_event_release_never_attacks_and_ctrl_is_independent() {
    var keys = List[int]()
    controls.events(
        [input.Event { key: input.char_key(99), mods: 0, kind: input.RELEASE }],
        mut keys,
    )
    for k in keys { assert(k != controls.KEY_DODGE, "release is not a roll") }
    var s = exact_cub()
    sim.step(mut s, [controls.KEY_CTRL_DOWN, controls.KEY_RIGHT])
    assert(s.sprinting && s.action == sim.IDLE, "Ctrl arrow starts sprint without dodging")
    sim.step(mut s, [controls.KEY_CTRL_UP])
    assert(!s.sprinting && sim.held_direction(s) == 64, "Ctrl release leaves arrow held")
}

fn test_cb04b_bite_aim_latches_each_held_diagonal() {
    for h in [0, 32, 64, 96, 128, 160, 192, 224] {
        var s = exact_cub()
        var keys = List[int]()
        if h == 0 || h == 32 || h == 224 { (mut keys).push(controls.KEY_UP) }
        if h == 96 || h == 128 || h == 160 { (mut keys).push(controls.KEY_DOWN) }
        if h == 160 || h == 192 || h == 224 { (mut keys).push(controls.KEY_LEFT) }
        if h == 32 || h == 64 || h == 96 { (mut keys).push(controls.KEY_RIGHT) }
        (mut keys).push(controls.KEY_BITE)
        sim.step(mut s, keys)
        assert(s.attack_heading == h, "bite aims toward held direction {h}")
        sim.step(mut s, [controls.KEY_UP])
        assert(s.attack_heading == h, "attack aim stays latched")
    }
}

fn test_cb04b_exact_arrow_remains_held_across_a_doorway() {
    var s = exact_cub()
    sim.step(mut s, [controls.KEY_DOWN])
    let (x, y) = forest.portal(s.seed, 0, 0)
    s.x = x
    s.y = y - 3 * sim.FP - 1
    s.heading = 128
    s.heading_target = 128
    s.speed = sim.trot_at(1)
    s.gate_open = true
    s.edge_ready = true
    sim.step(mut s, List[int]())
    assert(s.area == 1, "body crossed the doorway")
    assert(sim.held_direction(s) == 128, "physical Down survives area entry")
}

fn test_cb04b_ctrl_release_before_space_ends_the_sprint_snap() {
    var s = exact_cub()
    sim.step(mut s, [controls.KEY_CTRL_DOWN, controls.KEY_RIGHT])
    assert(s.sprinting, "fixture is already sprinting")
    sim.step(mut s, [controls.KEY_CTRL_UP, controls.KEY_BITE])
    assert(
        s.action == sim.BITE && s.attack_heading == 64,
        "release Control before Space gives an aimed bite",
    )
    var fresh = exact_cub()
    sim.step(mut fresh, [controls.KEY_CTRL_DOWN, controls.KEY_RIGHT, controls.KEY_BITE])
    assert(
        fresh.action == sim.BITE && fresh.attack_heading == 64,
        "a standing chord is not a stale-facing sprint snap",
    )
}
