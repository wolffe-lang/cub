//! walker — the real-key walker (cb02's witness, cb02c's bodies, cb04's
//! fighter's legs): a breadth-first plan over the area's real tiles,
//! followed by ordinary directional keys, with combat keys when a foe is
//! in reach. No teleport, collision override, heal or state mutation: what
//! the walker presses is what a hand would, and every key is recorded in
//! the replay it is given. `proof` records witnesses with it; `fight`
//! walks to the arenas and fights the bosses with it.

use controls
use forest
use replay
use sim

/// Press `keys` this tick: recorded in `r`, applied to `s`.
pub fn press(mut s: sim.Sim, mut r: replay.Replay, keys: List[int]) {
    for key in keys { replay.push_key(mut r, s.tick, key) }
    sim.step(mut s, keys)
}

/// One key as a key list (0: none).
pub fn key(k: int) -> List[int] {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    keys
}

/// The arrows toward fixed-point offset `(x, y)`, pushed onto `keys`.
pub fn aim(mut keys: List[int], x: int, y: int) {
    if y < -sim.FP / 4 { (mut keys).push(controls.KEY_UP) }
    if y > sim.FP / 4 { (mut keys).push(controls.KEY_DOWN) }
    if x < -sim.FP / 4 { (mut keys).push(controls.KEY_LEFT) }
    if x > sim.FP / 4 { (mut keys).push(controls.KEY_RIGHT) }
}

/// One tick toward `(x, y)`, fighting any foe in reach on the way.
pub fn drive(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int) {
    drive_as(mut s, mut r, x, y, false)
}

/// One tick toward `(x, y)`; `passive` never bites (the natural-death
/// witness lets the fox win).
pub fn drive_as(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int, passive: bool) {
    var keys = List[int]()
    var fighting = false
    var i = 0
    while i < s.foes.len {
        let foe = copy s.foes[i]
        if foe.health > 0 {
            if foe.kind == sim.HAWK &&
                foe.phase == sim.CROUCH &&
                sim.near(s.x, s.y, foe.target_x, foe.target_y, sim.FP) {
                fighting = true
                if s.action == sim.IDLE && s.tick - foe.since >= sim.HAWK_TELL - 6 {
                    (mut keys).push(controls.KEY_PARRY)
                }
                break
            }
            // A foe in reach (two cells from the bodies, cb02c) is fought;
            // one behind a trunk is walked round (the planned path avoids
            // its body).
            if foe.kind != sim.HAWK && sim.in_reach(s, i, 2) && !passive {
                fighting = true
                if s.action == sim.IDLE {
                    // Quarter-cell path arrows can retain a diagonal when
                    // the foe is almost cardinal. Commit the same intentional
                    // lock a player uses before a slanted bite; death releases it.
                    if s.locked < 0 { (mut keys).push(controls.KEY_LOCK) }
                    aim(mut keys, foe.x - s.x, foe.y - s.y)
                    (mut keys).push(controls.KEY_BITE)
                    // The aim is latched at Space. Release before following
                    // the next path segment; lock otherwise steers movement.
                    (mut keys).push(controls.KEY_RELEASE)
                }
                break
            }
            // A foe a little further off blocks the next cell when the cub
            // stands still against it: close on it rather than wait.
            if (foe.kind == sim.WEASEL || foe.kind == sim.FOX) &&
                s.speed == 0 &&
                sim.body_gap(s, i) <= 2 &&
                sim.visible(s, s.x, s.y, foe.x, foe.y) {
                fighting = true
                aim(mut keys, foe.x - s.x, foe.y - s.y)
                break
            }
        }
        i += 1
    }
    if !fighting { aim(mut keys, x - s.x, y - s.y) }
    press(mut s, mut r, keys)
}

/// Follow a BFS route by ordinary directional keys, with combat keys when
/// threatened. No teleport, collision override, heal or state mutation.
pub fn walk(mut s: sim.Sim, mut r: replay.Replay, tx: int, ty: int) -> bool {
    walk_stop(mut s, mut r, tx, ty, -1, false)
}

/// Whether the cub standing on a cell, facing as it faces, would share a
/// cell with a live ground foe's body: the walker routes round bodies as
/// it routes round trunks (cb02c: bodies are the drawings' footprints).
pub fn body_on(s: sim.Sim, x: int, y: int) -> bool {
    let b = sim.cub_body_at(s, x * sim.FP + sim.FP / 2, y * sim.FP + sim.FP / 2, s.body_facing)
    for f in s.foes {
        if sim.solid(f) && sim.overlap(b, sim.foe_body(f)) { return true }
    }
    false
}

/// `walk`, stopping early when foe `stop_foe` (or -1 for none) winds up;
/// `passive` never bites on the way.
pub fn walk_stop(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> bool {
    var replans = 0
    while replans < 20 {
        let outcome = walk_once(mut s, mut r, tx, ty, stop_foe, passive)
        if outcome != 2 {
            if outcome == 0 { walk_failure(s, tx, ty, "failed") }
            return outcome == 1
        }
        // No progress for thirty ticks: plan again from where the cub stands,
        // the foes where they now are.
        replans += 1
    }
    walk_failure(s, tx, ty, "stalled")
    false
}

/// A breadth-first plan over the area's cells from `start` toward `goal`
/// (indices into the area's rows from `top`): the parents, -1 unreached.
/// With `bodies` the cells where the cub's body would meet a foe's are
/// closed as trunks are.
pub fn plan(
    s: sim.Sim,
    w: int,
    top: int,
    origin: int,
    start: int,
    goal: int,
    bodies: bool,
) -> List[int] {
    let width = w * 2 + 1
    // An approach to an outside destination must not become an unmeasured
    // boss fight. A body-blocked route falls back to fighting the ordinary
    // blocker, not a detour through the arena on its other side.
    let outside = sim.boss_index(s) >= 0 &&
        !forest.in_arena(s.seed, s.field, s.area, start % width - w, start / width + top) &&
        !forest.in_arena(s.seed, s.field, s.area, goal % width - w, goal / width + top)
    let doors = avoid_doorways(
        s,
        start % width - w,
        start / width + top + origin,
        goal % width - w,
        goal / width + top + origin,
    )
    var parent = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (forest.LENGTH - top + 1) { (mut parent).push(-1); i += 1 }
    parent[start] = start
    (mut queue).push(start)
    var head = 0
    while head < queue.len && parent[goal] < 0 {
        let at = queue[head]
        let x = at % width - w
        let y = at / width + top
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= top && ny <= forest.LENGTH {
                let next = (ny - top) * width + nx + w
                if parent[next] < 0 &&
                    !sim.blocked(s, nx, ny + origin) &&
                    !door_blocked(doors, nx, ny + origin) &&
                    (!outside || !forest.in_arena(s.seed, s.field, s.area, nx, ny)) &&
                    (next == goal || !bodies || !body_on(s, nx, ny + origin)) {
                    parent[next] = at
                    (mut queue).push(next)
                }
            }
            d += 1
        }
        head += 1
    }
    parent
}

/// One planned walk: 1 arrived (or stopped as asked), 0 failed, 2 stuck.
pub fn walk_once(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> int {
    let area = s.area
    let w = forest.bound(s.field, area)
    let width = w * 2 + 1
    // The coast's rows run from the river (the bank wanders north of the
    // spawn's row); an inland area's from its entry row.
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let origin = forest.origin(s.seed, area)
    let sx = sim.cell_x(s)
    let sy = sim.cell_y(s) - origin
    let gx = sim.floor_div(tx, sim.FP)
    let gy = sim.floor_div(ty, sim.FP) - origin
    if sx < 0 - w || sx > w || sy < top || sy > forest.LENGTH { return 0 }
    let start = (sy - top) * width + sx + w
    let goal = (gy - top) * width + gx + w
    // Round the bodies where there is room; where a body closes the way
    // (a foe as wide as the path, cb02c), plan through it and fight it.
    var parent = plan(s, w, top, origin, start, goal, true)
    if parent[goal] < 0 { parent = plan(s, w, top, origin, start, goal, false) }
    if parent[goal] < 0 { return 0 }
    var i = 0
    var path = List[int]()
    var at = goal
    while at != start { (mut path).push(at); at = parent[at] }
    i = path.len - 1
    let until = s.tick + 18000
    // Ticks left of following the plan rather than closing straight on the
    // foe (cb02c: a trunk between two bodies can stop the straight line).
    var detour = 0
    var stalled = 0
    while i >= 0 {
        let cell = path[i]
        let x = (cell % width - w) * sim.FP + sim.FP / 2
        let y = (cell / width + top + origin) * sim.FP + sim.FP / 2
        var still = 0
        var last_x = s.x
        var last_y = s.y
        while !sim.near(s.x, s.y, x, y, sim.FP / 2) {
            if s.tick > until || s.action == sim.FALL { return 0 }
            if stop_foe >= 0 && sim.body_gap(s, stop_foe) <= 3 && detour == 0 {
                let bx = s.x
                let by = s.y
                var keys = List[int]()
                aim(mut keys, s.foes[stop_foe].x - s.x, s.foes[stop_foe].y - s.y)
                press(mut s, mut r, keys)
                if s.x == bx && s.y == by { stalled += 1 } else { stalled = 0 }
                if stalled >= 10 {
                    detour = 30
                    stalled = 0
                }
            } else {
                if detour > 0 { detour -= 1 }
                drive_as(mut s, mut r, x, y, passive)
            }
            if stop_foe >= 0 &&
                (s.foes[stop_foe].phase == sim.CROUCH || s.foes[stop_foe].phase == sim.FEINT) {
                return 1
            }
            if s.area != area { return 1 }
            if s.x == last_x && s.y == last_y { still += 1 } else { still = 0 }
            last_x = s.x
            last_y = s.y
            if still >= 30 { return 2 }
        }
        i -= 1
    }
    1
}

fn walk_failure(s: sim.Sim, tx: int, ty: int, reason: str) {
    eprint(
        "walker {reason} seed {s.seed} area {s.area} at {sim.cell_x(s)},{sim.cell_y(s)} goal {sim.floor_div(tx, sim.FP)},{sim.floor_div(ty, sim.FP)} tick {s.tick} health {s.health} stamina {s.stamina} action {s.action} goal_blocked {sim.blocked(s, sim.floor_div(tx, sim.FP), sim.floor_div(ty, sim.FP))}",
    )
    var i = 0
    while i < s.foes.len {
        if s.foes[i].health > 0 && sim.body_gap(s, i) <= 4 {
            eprint(
                "walker foe {i} kind {s.foes[i].kind} health {s.foes[i].health} phase {s.foes[i].phase} gap {sim.body_gap(s, i)} bearing {sim.heading_to(s.x, s.y, s.foes[i].x, s.foes[i].y)} aim {s.attack_heading} combo {s.combo}",
            )
        }
        i += 1
    }
}

/// Plan around an unlocked doorway unless it is this walk's source or goal.
/// The maximum turned body envelope leaves room for ordinary steering, not a
/// collision override. This prevents a cache walk taking an unintended shortcut.
fn avoid_doorways(s: sim.Sim, sx: int, sy: int, gx: int, gy: int) -> List[sim.Body] {
    var doors = List[sim.Body]()
    var edge = 0
    while edge < forest.EDGES {
        if forest.other(s.area, edge) >= 0 &&
            (forest.path_edge(edge) && (edge != 0 || s.gate_open) || sim.shortcut_open(s, edge)) {
            let (px, py) = forest.portal(s.seed, s.area, edge)
            var box = sim.cub_body_at(s, 0, 0, 0)
            var facing = 0
            while facing < 4 {
                let b = sim.cub_body_at(s, 0, 0, facing)
                if b.x0 < box.x0 { box.x0 = b.x0 }
                if b.x1 > box.x1 { box.x1 = b.x1 }
                if b.y0 < box.y0 { box.y0 = b.y0 }
                if b.y1 > box.y1 { box.y1 = b.y1 }
                facing += 1
            }
            let door = sim.Body {
                x0: px / sim.FP - 3 - box.x1 - 1,
                x1: px / sim.FP + 3 - box.x0 + 1,
                y0: py / sim.FP - 1 - box.y1 - 1,
                y1: py / sim.FP + 1 - box.y0 + 1,
            }
            if !inside(door, sx, sy) && !inside(door, gx, gy) { (mut doors).push(door) }
        }
        edge += 1
    }
    doors
}

fn inside(b: sim.Body, x: int, y: int) -> bool { x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1 }

fn door_blocked(doors: List[sim.Body], x: int, y: int) -> bool {
    for door in doors { if inside(door, x, y) { return true } }
    false
}
