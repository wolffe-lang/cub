//! walker — the real-key walker (cb02's witness, cb02c's bodies, cb04's
//! fighter's legs): a breadth-first plan over the area's real tiles,
//! followed by ordinary directional keys, with combat keys when a foe is
//! in reach. No teleport, collision override, heal or state mutation: what
//! the walker presses is what a hand would, and every key is recorded in
//! the replay it is given. `proof` records witnesses with it; `fight`
//! walks to the arenas and fights the bosses with it.

use controls
use forest
use replay
use sim
use pouch

/// Press `keys` this tick: recorded in `r`, applied to `s`.
pub fn press(mut s: sim.Sim, mut r: replay.Replay, keys: List[int]) {
    if s.action == sim.FALL && s.tick + 1 - s.started >= sim.DEATH_FADE + sim.DEATH_HOLD {
        replay.push_key(mut r, s.tick, controls.KEY_SKIP)
        sim.step(mut s, [controls.KEY_SKIP])
        return
    }
    for key in keys { replay.push_key(mut r, s.tick, key) }
    sim.step(mut s, keys)
}

/// One key as a key list (0: none).
pub fn key(k: int) -> List[int] {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    keys
}

/// The arrows toward fixed-point offset `(x, y)`, pushed onto `keys`.
pub fn aim(mut keys: List[int], x: int, y: int) {
    if y < -sim.FP / 4 { (mut keys).push(controls.KEY_UP) }
    if y > sim.FP / 4 { (mut keys).push(controls.KEY_DOWN) }
    if x < -sim.FP / 4 { (mut keys).push(controls.KEY_LEFT) }
    if x > sim.FP / 4 { (mut keys).push(controls.KEY_RIGHT) }
}

/// The arrows of the eight-way direction nearest `heading` (cb07): a
/// strike at a foe in reach aims at its bearing, not at the per-axis
/// quarter-cell arrows of `aim`, which press a diagonal at a foe a
/// little to one side and put hit 1's slanted cone past it.
pub fn aim_at(mut keys: List[int], heading: int) {
    let k = ((heading + 16) % sim.TURN + sim.TURN) % sim.TURN / 32
    if k == 7 || k == 0 || k == 1 { (mut keys).push(controls.KEY_UP) }
    if k == 3 || k == 4 || k == 5 { (mut keys).push(controls.KEY_DOWN) }
    if k == 5 || k == 6 || k == 7 { (mut keys).push(controls.KEY_LEFT) }
    if k == 1 || k == 2 || k == 3 { (mut keys).push(controls.KEY_RIGHT) }
}

// A planning probe only: never applied to the live simulation. Lock aims
// at the centre, but after a diagonal turn the jaws may lie beside it.
// Reject a prospective bite that would first push the target out of its
// committed aim; step to a clear jaw-aligned stance instead of biting air.
fn jaw_stance(s: sim.Sim, i: int, x: int, y: int) -> bool {
    region probe {
        if sim.blocked(s, sim.floor_div(x, sim.FP), sim.floor_div(y, sim.FP)) { return false }
        var aimed = copy s
        aimed.x = x
        aimed.y = y
        aimed.action_x = x
        aimed.action_y = y
        aimed.action = sim.BITE
        aimed.combo = 1
        aimed.attack_heading = sim.heading_to(x, y, s.foes[i].x, s.foes[i].y)
        if aimed.attack_heading < 0 { return false }
        aimed.body_facing = sim.eighth(aimed.attack_heading)
        let cb = sim.cub_body(aimed)
        for foe in s.foes {
            if sim.solid(foe) && sim.overlap(cb, sim.foe_body(foe)) { return false }
        }
        return sim.jaws_reach_body(aimed, cb, sim.foe_body(s.foes[i]), 2)
    }
}

// Ordinary arrows to the nearest clear stance within four cells. The
// real step still enforces terrain and actors; no position is assigned.
fn align_jaws(s: sim.Sim, i: int, mut keys: List[int]) {
    // Combat sidesteps obey the same doorway exclusion as the route.
    // Otherwise a jaw-alignment step can leave the area through a nearby
    // unlocked shortcut while the route itself correctly avoids it.
    let doors = avoid_doorways(s, sim.cell_x(s), sim.cell_y(s), sim.cell_x(s), sim.cell_y(s))
    let outside = sim.boss_index(s) >= 0 && !sim.cub_in_arena(s)
    var best = 1000000000
    var tx = s.x
    var ty = s.y
    var dy = -4
    while dy <= 4 {
        var dx = -4
        while dx <= 4 {
            let x = (sim.cell_x(s) + dx) * sim.FP + sim.FP / 2
            let y = (sim.cell_y(s) + dy) * sim.FP + sim.FP / 2
            let distance = (x - s.x) * (x - s.x) + (y - s.y) * (y - s.y)
            if distance > 0 &&
                distance < best &&
                !door_blocked(doors, sim.floor_div(x, sim.FP), sim.floor_div(y, sim.FP)) &&
                (
                    !outside ||
                        !forest.in_arena(
                            s.seed,
                            s.field,
                            s.area,
                            sim.floor_div(x, sim.FP),
                            sim.floor_div(y, sim.FP),
                        )
                ) &&
                sim.visible(s, s.x, s.y, x, y) &&
                jaw_stance(s, i, x, y) {
                best = distance
                tx = x
                ty = y
            }
            dx += 1
        }
        dy += 1
    }
    if s.locked >= 0 { (mut keys).push(controls.KEY_RELEASE) }
    aim(mut keys, tx - s.x, ty - s.y)
}

// Plan the same Tab cycle the real input handler applies. The nearest
// visible foe is not necessarily the ordinal whose stance was selected.
// Only key codes leave this planning region; live state is never assigned.
fn lock_onto(s: sim.Sim, target: int, mut keys: List[int]) {
    region selection {
        var probe = copy s
        var tabs = 0
        while probe.locked != target && tabs <= s.foes.len {
            sim.lock_next(mut probe)
            tabs += 1
        }
        if probe.locked == target {
            var n = 0
            while n < tabs { (mut keys).push(controls.KEY_LOCK); n += 1 }
            return
        }
    }
    // A target outside the lock's sight/range still gets the ordinary
    // arrow aim, never a lock silently redirected to a different foe.
    if s.locked >= 0 { (mut keys).push(controls.KEY_RELEASE) }
}

/// One tick toward `(x, y)`, fighting any foe in reach on the way.
pub fn drive(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int) {
    drive_as(mut s, mut r, x, y, false)
}

// Harness only: old kinds never enter this dispatch. These are the same
// public tells, motion and resource windows the arena fighter reads.
fn new_kind_tactics(s: sim.Sim, mut keys: List[int]) -> bool {
    var present = false
    for f in s.foes { if sim.is_new_foe(f.kind) { present = true } }
    if !present { return false }
    if s.pouch.open {
        if s.pouch.bleeding > 0 && sim.item_count(s, pouch.YARROW) > 0 {
            (mut keys).push(controls.KEY_BITE)
        } else {
            (mut keys).push(controls.KEY_INVENTORY)
        }
        return true
    }
    if s.pouch.bleeding > 0 && sim.item_count(s, pouch.YARROW) > 0 {
        (mut keys).push(controls.KEY_INVENTORY)
        return true
    }
    if s.action != sim.IDLE { return false }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        if f.health > 0 && sim.is_new_foe(f.kind) {
            let m = sim.new_foe_move(f.kind)
            let gap = sim.body_gap(s, i)
            let travel_reach = (m.travel * m.active + sim.FP - 1) / sim.FP
            if m.damage > 0 && gap <= m.reach - 1 + travel_reach {
                let active = f.phase == sim.STRIKE && !f.hit
                let remaining = m.windup - (s.tick - f.since) + 1
                let extra = if gap > m.reach - 1 then gap - (m.reach - 1) else 0
                let arrives = remaining + (if m.travel > 0 then extra * sim.FP / m.travel else 0)
                if m.parryable &&
                    s.stamina >= 10 &&
                    !s.exhausted &&
                    (active || f.phase == sim.CROUCH && arrives <= 6) {
                    (mut keys).push(controls.KEY_PARRY)
                    return true
                }
                if !m.parryable &&
                    s.stamina >= 18 &&
                    !s.exhausted &&
                    (active || f.phase == sim.CROUCH && remaining <= 2) {
                    var side = (f.heading + 64) % sim.TURN
                    let x = sim.floor_div(s.x + 3 * sim.sin(side), sim.FP)
                    let y = sim.floor_div(s.y - 3 * sim.cos(side), sim.FP)
                    if sim.blocked(s, x, y) { side = (side + 128) % sim.TURN }
                    aim(mut keys, sim.sin(side), 0 - sim.cos(side))
                    (mut keys).push(controls.KEY_DODGE)
                    return true
                }
            }
        }
        i += 1
    }
    if s.pouch.bleeding > 0 {
        var safe = true
        i = 0
        while i < s.foes.len {
            let f = copy s.foes[i]
            let harmless = f.kind == sim.WISP ||
                f.kind == sim.CINDER_MOTHS ||
                f.kind == sim.GLOW_WORMS ||
                f.kind == sim.MARTEN &&
                    (
                        f.phase == sim.RETREAT ||
                            f.phase == sim.STAGGER ||
                            f.phase == sim.PERCHED ||
                            f.phase == sim.CROUCH
                    )
            if f.health > 0 && !harmless && sim.body_gap(s, i) <= 4 { safe = false }
            i += 1
        }
        if safe {
            // A visible bleed is licked at rest. Explicit releases stop
            // inferred arrows too; no position or health is assigned.
            var d = 0
            while d < 4 { (mut keys).push(controls.KEY_ARROW_RELEASE + d); d += 1 }
            (mut keys).push(controls.KEY_CTRL_UP)
            (mut keys).push(controls.KEY_SHIFT_UP)
            return true
        }
    }
    false
}

/// One tick toward `(x, y)`; `passive` never bites (the natural-death
/// witness lets the fox win).
pub fn drive_as(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int, passive: bool) {
    var keys = List[int]()
    // Choose the earliest Ashen blow across the pair, not the first
    // ordinal. A jaw-alignment detour can put both in reach; waiting for
    // the first one's long windup must not ignore the second one's strike.
    if s.action == sim.IDLE {
        var due = 1000000
        var threat = 0
        while threat < s.foes.len {
            let f = copy s.foes[threat]
            if f.health > 0 && f.kind == sim.ASHEN && sim.in_reach(s, threat, 2) {
                let remaining = if f.phase == sim.CROUCH {
                    sim.ASHEN_WINDUP - (s.tick - f.since)
                } else if f.phase == sim.STRIKE && !f.hit {
                    0
                } else {
                    1000000
                }
                if remaining < due { due = remaining }
            }
            threat += 1
        }
        // Do not begin an eleven-tick bite inside another blow's window.
        if due <= 11 {
            if due <= 2 { (mut keys).push(controls.KEY_PARRY) }
            press(mut s, mut r, keys)
            return
        }
    }
    if !passive && new_kind_tactics(s, mut keys) {
        press(mut s, mut r, keys)
        return
    }
    var fighting = false
    var i = 0
    while i < s.foes.len {
        let foe = copy s.foes[i]
        if foe.health > 0 &&
            !(foe.kind == sim.WISP && foe.phase == sim.SNUFFED) &&
            !(foe.kind == sim.MARTEN && (foe.phase == sim.PERCHED || foe.phase == sim.CROUCH)) {
            if foe.kind == sim.HAWK &&
                foe.phase == sim.CROUCH &&
                sim.near(s.x, s.y, foe.target_x, foe.target_y, sim.FP) {
                fighting = true
                if s.action == sim.IDLE && s.tick - foe.since >= sim.HAWK_TELL - 6 {
                    (mut keys).push(controls.KEY_PARRY)
                }
                break
            }
            // An Ashen's windup in reach is parried two ticks before the
            // blow (cb05: Book-II play, one parry, no roll), on a passive
            // walk too: a parry is no bite.
            if foe.kind == sim.ASHEN && foe.phase == sim.CROUCH && sim.in_reach(s, i, 2) {
                fighting = true
                if s.action == sim.IDLE && s.tick - foe.since >= sim.ASHEN_WINDUP - 2 {
                    (mut keys).push(controls.KEY_PARRY)
                }
                break
            }
            // A foe in reach (two cells from the bodies, cb02c) is fought;
            // one behind a trunk is walked round (the planned path avoids
            // its body).
            if foe.kind != sim.HAWK && sim.in_reach(s, i, 2) && !passive {
                fighting = true
                if s.action == sim.IDLE && !jaw_stance(s, i, s.x, s.y) {
                    align_jaws(s, i, mut keys)
                } else if s.action == sim.IDLE {
                    // Quarter-cell path arrows can retain a diagonal when
                    // the foe is almost cardinal. Commit the same intentional
                    // lock a player uses before a slanted bite; death releases it.
                    lock_onto(s, i, mut keys)
                    aim_at(mut keys, sim.heading_to(s.x, s.y, foe.x, foe.y))
                    (mut keys).push(controls.KEY_BITE)
                    // The aim is latched at Space. Release before following
                    // the next path segment; lock otherwise steers movement.
                    (mut keys).push(controls.KEY_RELEASE)
                }
                break
            }
            // A foe a little further off blocks the next cell when the cub
            // stands still against it: close on it rather than wait.
            if (foe.kind == sim.WEASEL || foe.kind == sim.FOX) &&
                s.speed == 0 &&
                sim.body_gap(s, i) <= 2 &&
                sim.visible(s, s.x, s.y, foe.x, foe.y) {
                fighting = true
                aim(mut keys, foe.x - s.x, foe.y - s.y)
                break
            }
        }
        i += 1
    }
    if !fighting { aim(mut keys, x - s.x, y - s.y) }
    press(mut s, mut r, keys)
}

/// Follow a BFS route by ordinary directional keys, with combat keys when
/// threatened. No teleport, collision override, heal or state mutation.
pub fn walk(mut s: sim.Sim, mut r: replay.Replay, tx: int, ty: int) -> bool {
    walk_stop(mut s, mut r, tx, ty, -1, false)
}

/// `walk`, narrated (cb07: `cub --crossing-trace`): a line a tick while
/// a live ground foe is within two cells of the body, with the cub's
/// action, its aim and whether each strike reaches the foe.
pub fn walk_narrated(mut s: sim.Sim, mut r: replay.Replay, tx: int, ty: int) -> bool {
    walk_stop_as(mut s, mut r, tx, ty, -1, false, true)
}

/// Whether the cub standing on a cell, facing as it faces, would share a
/// cell with a live ground foe's body: the walker routes round bodies as
/// it routes round trunks (cb02c: bodies are the drawings' footprints).
pub fn body_on(s: sim.Sim, x: int, y: int) -> bool {
    let b = sim.cub_body_at(s, x * sim.FP + sim.FP / 2, y * sim.FP + sim.FP / 2, s.body_facing)
    for f in s.foes {
        if sim.solid(f) && sim.overlap(b, sim.foe_body(f)) { return true }
    }
    false
}

/// `walk`, stopping early when foe `stop_foe` (or -1 for none) winds up;
/// `passive` never bites on the way.
pub fn walk_stop(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> bool {
    walk_stop_as(mut s, mut r, tx, ty, stop_foe, passive, false)
}

// A target beaten during a close-approach replan is a completed hand-off,
// not another route goal. No movement or combat input follows its death.
fn stop_beaten(s: sim.Sim, stop_foe: int) -> bool {
    stop_foe >= 0 &&
        stop_foe < s.foes.len &&
        (
            s.foes[stop_foe].health <= 0 ||
                s.foes[stop_foe].kind == sim.WISP && s.foes[stop_foe].phase == sim.SNUFFED
        )
}

fn walk_stop_as(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
    narrate: bool,
) -> bool {
    if stop_beaten(s, stop_foe) { return true }
    if !clear_arrival(mut s, mut r, tx, ty) { return false }
    var replans = 0
    while replans < 20 {
        let outcome = walk_once_as(mut s, mut r, tx, ty, stop_foe, passive, narrate)
        if narrate { print("walk: plan {replans} outcome {outcome} tick {s.tick}") }
        if outcome != 2 {
            if outcome == 0 { walk_failure(s, tx, ty, "failed") }
            return outcome == 1
        }
        // No progress for thirty ticks: plan again from where the cub stands,
        // the foes where they now are.
        replans += 1
    }
    walk_failure(s, tx, ty, "stalled")
    false
}

/// A breadth-first plan over the area's cells from `start` toward `goal`
/// (indices into the area's rows from `top`): the parents, -1 unreached.
/// With `bodies` the cells where the cub's body would meet a foe's are
/// closed as trunks are.
pub fn plan(
    s: sim.Sim,
    w: int,
    top: int,
    origin: int,
    start: int,
    goal: int,
    bodies: bool,
) -> List[int] {
    let width = w * 2 + 1
    // An approach to an outside destination must not become an unmeasured
    // boss fight. A body-blocked route falls back to fighting the ordinary
    // blocker, not a detour through the arena on its other side.
    let outside = sim.boss_index(s) >= 0 &&
        !forest.in_arena(s.seed, s.field, s.area, start % width - w, start / width + top) &&
        !forest.in_arena(s.seed, s.field, s.area, goal % width - w, goal / width + top)
    let doors = avoid_doorways(
        s,
        start % width - w,
        start / width + top + origin,
        goal % width - w,
        goal / width + top + origin,
    )
    var parent = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (forest.length(s.area) - top + 1) { (mut parent).push(-1); i += 1 }
    parent[start] = start
    (mut queue).push(start)
    var head = 0
    while head < queue.len && parent[goal] < 0 {
        let at = queue[head]
        let x = at % width - w
        let y = at / width + top
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= top && ny <= forest.length(s.area) {
                let next = (ny - top) * width + nx + w
                if parent[next] < 0 &&
                    !sim.blocked(s, nx, ny + origin) &&
                    !door_blocked(doors, nx, ny + origin) &&
                    (!outside || !forest.in_arena(s.seed, s.field, s.area, nx, ny)) &&
                    (next == goal || !bodies || !body_on(s, nx, ny + origin)) {
                    parent[next] = at
                    (mut queue).push(next)
                }
            }
            d += 1
        }
        head += 1
    }
    parent
}

/// One planned walk: 1 arrived (or stopped as asked), 0 failed, 2 stuck.
pub fn walk_once(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> int {
    walk_once_as(mut s, mut r, tx, ty, stop_foe, passive, false)
}

fn narrate_tick(s: sim.Sim) {
    var k = 0
    while k < s.foes.len {
        let f = copy s.foes[k]
        if f.health > 0 && f.kind != sim.HAWK && sim.body_gap(s, k) <= 2 {
            print(
                "walk: t {s.tick} cub {s.x},{s.y} cell {sim.cell_x(s)},{sim.cell_y(s)} action {s.action} combo {s.combo} age {s.tick - s.started} aim {s.attack_heading} dir {sim.attack_direction(s)} held {sim.held_direction(s)} locked {s.locked} health {s.health} stamina {s.stamina} | foe {k} kind {f.kind} phase {f.phase} health {f.health} at {f.x},{f.y} gap {sim.body_gap(s, k)} bearing {sim.heading_to(s.x, s.y, f.x, f.y)} reach {if sim.in_reach(s, k, 2) then 1 else 0} strike {if sim.strike_reaches(s, k, 2) then 1 else 0} hit {if f.last_hit == s.started then 1 else 0}",
            )
        }
        k += 1
    }
}

fn walk_once_as(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
    narrate: bool,
) -> int {
    if stop_beaten(s, stop_foe) { return 1 }
    let area = s.area
    let w = forest.bound(s.field, area)
    let width = w * 2 + 1
    // The coast's rows run from the river (the bank wanders north of the
    // spawn's row); an inland area's from its entry row.
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let origin = forest.origin(s.seed, area)
    let sx = sim.cell_x(s)
    let sy = sim.cell_y(s) - origin
    let gx = sim.floor_div(tx, sim.FP)
    let gy = sim.floor_div(ty, sim.FP) - origin
    if sx < 0 - w || sx > w || sy < top || sy > forest.length(area) { return 0 }
    let start = (sy - top) * width + sx + w
    let goal = (gy - top) * width + gx + w
    // Round the bodies where there is room; where a body closes the way
    // (a foe as wide as the path, cb02c), plan through it and fight it.
    var parent = plan(s, w, top, origin, start, goal, true)
    if parent[goal] < 0 { parent = plan(s, w, top, origin, start, goal, false) }
    if parent[goal] < 0 { return 0 }
    var i = 0
    var path = List[int]()
    var at = goal
    while at != start { (mut path).push(at); at = parent[at] }
    i = path.len - 1
    let until = s.tick + 18000
    // Ticks left of following the plan rather than closing straight on the
    // foe (cb02c: a trunk between two bodies can stop the straight line).
    var detour = 0
    var stalled = 0
    while i >= 0 {
        let cell = path[i]
        let x = (cell % width - w) * sim.FP + sim.FP / 2
        let y = (cell / width + top + origin) * sim.FP + sim.FP / 2
        var still = 0
        var last_x = s.x
        var last_y = s.y
        while !sim.near(s.x, s.y, x, y, sim.FP / 2) {
            if s.tick > until || s.action == sim.FALL { return 0 }
            if stop_foe >= 0 && sim.body_gap(s, stop_foe) <= 3 && detour == 0 {
                let bx = s.x
                let by = s.y
                var keys = List[int]()
                aim(mut keys, s.foes[stop_foe].x - s.x, s.foes[stop_foe].y - s.y)
                press(mut s, mut r, keys)
                if s.x == bx && s.y == by { stalled += 1 } else { stalled = 0 }
                if stalled >= 10 {
                    detour = 30
                    stalled = 0
                }
            } else {
                if detour > 0 { detour -= 1 }
                drive_as(mut s, mut r, x, y, passive)
            }
            if narrate { narrate_tick(s) }
            if stop_beaten(s, stop_foe) { return 1 }
            if stop_foe >= 0 &&
                (s.foes[stop_foe].phase == sim.CROUCH || s.foes[stop_foe].phase == sim.FEINT) {
                return 1
            }
            if s.area != area { return 1 }
            // A tick spent fighting in place is not a still tick (cb07: a
            // strike blocked on both axes by a foe ahead and a wall beside
            // leaves the cub exactly where it stood; cb04b's bites always
            // moved it a quarter cell, which hid this).
            // A passive walk (never biting) against a foe is stuck, not
            // fighting: it must replan round the body as before.
            var engaged = s.action != sim.IDLE
            var k = 0
            while k < s.foes.len && !passive {
                if s.foes[k].health > 0 &&
                    s.foes[k].kind != sim.HAWK &&
                    !(s.foes[k].kind == sim.WISP && s.foes[k].phase == sim.SNUFFED) &&
                    sim.in_reach(s, k, 2) {
                    engaged = true
                }
                k += 1
            }
            if engaged || s.x != last_x || s.y != last_y { still = 0 } else { still += 1 }
            last_x = s.x
            last_y = s.y
            if still >= 30 { return 2 }
        }
        i -= 1
    }
    1
}

fn walk_failure(s: sim.Sim, tx: int, ty: int, reason: str) {
    eprint(
        "walker {reason} seed {s.seed} area {s.area} at {sim.cell_x(s)},{sim.cell_y(s)} goal {sim.floor_div(tx, sim.FP)},{sim.floor_div(ty, sim.FP)} tick {s.tick} health {s.health} stamina {s.stamina} action {s.action} goal_blocked {sim.blocked(s, sim.floor_div(tx, sim.FP), sim.floor_div(ty, sim.FP))}",
    )
    var i = 0
    while i < s.foes.len {
        if s.foes[i].health > 0 && sim.body_gap(s, i) <= 4 {
            eprint(
                "walker foe {i} kind {s.foes[i].kind} health {s.foes[i].health} phase {s.foes[i].phase} gap {sim.body_gap(s, i)} bearing {sim.heading_to(s.x, s.y, s.foes[i].x, s.foes[i].y)} aim {s.attack_heading} combo {s.combo}",
            )
        }
        i += 1
    }
}

/// Plan around an unlocked doorway unless it is this walk's source or goal.
/// The maximum turned body envelope leaves room for ordinary steering, not a
/// collision override. This prevents a cache walk taking an unintended shortcut.
fn avoid_doorways(s: sim.Sim, sx: int, sy: int, gx: int, gy: int) -> List[sim.Body] {
    var doors = List[sim.Body]()
    var edge = 0
    while edge < forest.EDGES {
        if forest.other(s.area, edge) >= 0 &&
            (forest.path_edge(edge) && (edge != 0 || s.gate_open) || sim.shortcut_open(s, edge)) {
            let (px, py) = forest.portal(s.seed, s.area, edge)
            let door = door_envelope(s, px, py, 1)
            let physical = door_envelope(s, px, py, 0)
            if !inside(door, gx, gy) {
                if !inside(door, sx, sy) {
                    (mut doors).push(door)
                } else if !inside(physical, sx, sy) {
                    // Arrival can clear the shadow without clearing the
                    // extra planning margin: the next row may be a wall.
                    // Keep the physical envelope forbidden while escaping
                    // that margin sideways, rather than omitting the door.
                    (mut doors).push(physical)
                }
            }
        }
        edge += 1
    }
    doors
}

// One envelope for planning and departure clearance. Clearing only the
// current drawing can leave the anchor inside the plan's wider envelope;
// the next route then omits its arrival door and walks straight back in.
fn door_envelope(s: sim.Sim, px: int, py: int, margin: int) -> sim.Body {
    var box = sim.cub_body_at(s, 0, 0, 0)
    var facing = 1
    while facing < 8 {
        let b = sim.cub_body_at(s, 0, 0, facing)
        if b.x0 < box.x0 { box.x0 = b.x0 }
        if b.x1 > box.x1 { box.x1 = b.x1 }
        if b.y0 < box.y0 { box.y0 = b.y0 }
        if b.y1 > box.y1 { box.y1 = b.y1 }
        facing += 1
    }
    sim.Body {
        x0: px / sim.FP - 3 - box.x1 - margin,
        x1: px / sim.FP + 3 - box.x0 + margin,
        y0: py / sim.FP - 1 - box.y1 - margin,
        y1: py / sim.FP + 1 - box.y0 + margin,
    }
}

fn inside(b: sim.Body, x: int, y: int) -> bool { x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1 }

fn door_blocked(doors: List[sim.Body], x: int, y: int) -> bool {
    for door in doors { if inside(door, x, y) { return true } }
    false
}

// A non-return route first clears its arrival shadow straight ahead. A
// parry permits the ordinary arrow turn while standing still, so steering
// across an already-overlapping side never becomes an unintended return.
fn clear_arrival(mut s: sim.Sim, mut r: replay.Replay, tx: int, ty: int) -> bool {
    if s.tick - s.entered > 3 { return true }
    let area = s.area
    var edge = 0
    while edge < forest.EDGES {
        if forest.other(area, edge) >= 0 {
            let (px, py) = forest.portal(s.seed, area, edge)
            let arrival = door_envelope(s, px, py, 0)
            let touching = inside(arrival, sim.cell_x(s), sim.cell_y(s))
            if touching &&
                !forest.shadow_cell(
                    s.seed,
                    area,
                    edge,
                    sim.floor_div(tx, sim.FP),
                    sim.floor_div(ty, sim.FP),
                ) {
                let heading = if s.y > py then 128 else 0
                let arrow = if heading == 128 then controls.KEY_DOWN else controls.KEY_UP
                if s.heading != heading {
                    var wait = 0
                    while (s.action != sim.IDLE || s.stamina < 10) && wait < 60 {
                        press(mut s, mut r, key(0))
                        wait += 1
                    }
                    if s.action != sim.IDLE || s.stamina < 10 { return false }
                    var keys = key(arrow)
                    (mut keys).push(controls.KEY_PARRY)
                    press(mut s, mut r, keys)
                }
                var steps = 0
                while steps < 90 {
                    let envelope = door_envelope(s, px, py, 0)
                    if sim.cell_y(s) < envelope.y0 || sim.cell_y(s) > envelope.y1 { return true }
                    press(mut s, mut r, key(arrow))
                    if s.area != area || s.action == sim.FALL { return false }
                    steps += 1
                }
                return false
            }
        }
        edge += 1
    }
    true
}
