//! silhouette — solid sprites from pixels (cb02b). A silhouette is a bitmap
//! at the rich tier's finest grain, two pixels across and four down a
//! cell: the braille grid, whose pixels are square at a 1:2 cell. One
//! drawing per creature, facing north; east, south and west are the same
//! bitmap turned a quarter, a half and three quarters (the maintainer's
//! word, 2026-10-25: "it should look the same, just rotated"; R-cb02b-2
//! A), so a creature is never a different drawing when it turns, and a
//! bitmap of 4 by 12 pixels is 2 by 3 cells north and 6 by 1 east.
//!
//! Each cell of a bitmap becomes one glyph: the full block where all eight
//! pixels are lit, a half block where exactly one half is, the braille
//! pattern of the lit pixels otherwise, and nothing where none are. The
//! shapes are original; pack's wolf (ears, head, a long body) was read for
//! its silhouette only.

use grid

/// A bitmap: `w` pixels across (a multiple of 2), `h` down (a multiple of
/// 4), row-major, 1 lit.
pub struct Bitmap {
    w: int,
    h: int,
    px: List[int],
}

/// The bitmap drawn by `rows`: `#` lit, anything else dark. Every row has
/// the first row's length (`assert`).
pub fn parse(rows: List[str]) -> Bitmap {
    assert(rows.len > 0, "silhouette.parse: a bitmap has rows")
    let w = rows[0].len
    var px = List[int]()
    for row in rows {
        assert(row.len == w, "silhouette.parse: ragged rows")
        for b in row.bytes() {
            (mut px).push(if b as int == 35 then 1 else 0)
        }
    }
    Bitmap { w: w, h: rows.len, px: px }
}

/// The bitmap with every pixel outside cell row `cr` (four pixel rows)
/// dark: the cells of that row alone, in every facing.
pub fn cell_row(b: Bitmap, cr: int) -> Bitmap {
    var px = List[int]()
    var r = 0
    while r < b.h {
        var c = 0
        while c < b.w {
            (mut px).push(if r / 4 == cr then b.px[r * b.w + c] else 0)
            c += 1
        }
        r += 1
    }
    Bitmap { w: b.w, h: b.h, px: px }
}

/// The pixel at `(r, c)`, 0 outside the bitmap.
pub fn at(b: Bitmap, r: int, c: int) -> int {
    if r < 0 || c < 0 || r >= b.h || c >= b.w { return 0 }
    b.px[r * b.w + c]
}

/// The bitmap turned to `facing`: 0 as drawn (north), 1 a quarter turn
/// clockwise (east), 2 a half turn (south), 3 a quarter turn anticlockwise
/// (west). Pixel for pixel: nothing is redrawn.
pub fn turned(b: Bitmap, facing: int) -> Bitmap {
    let f = (facing % 4 + 4) % 4
    if f == 0 { return copy b }
    let w = if f == 2 then b.w else b.h
    let h = if f == 2 then b.h else b.w
    var px = List[int]()
    var r = 0
    while r < h {
        var c = 0
        while c < w {
            // The source pixel that lands at (r, c) after the turn.
            let v = if f == 1 {
                at(b, b.h - 1 - c, r)
            } else if f == 2 {
                at(b, b.h - 1 - r, b.w - 1 - c)
            } else {
                at(b, c, b.w - 1 - r)
            }
            (mut px).push(v)
            c += 1
        }
        r += 1
    }
    Bitmap { w: w, h: h, px: px }
}

/// Cells across a bitmap draws.
pub fn cols(b: Bitmap) -> int {
    (b.w + 1) / 2
}

/// Cells down a bitmap draws.
pub fn rows(b: Bitmap) -> int {
    (b.h + 3) / 4
}

/// The code point for cell `(cr, cc)` of a bitmap: 32 (nothing) when no
/// pixel of the cell is lit, U+2588 when all eight are, U+2580 / U+2584
/// for exactly the upper / lower half, U+258C / U+2590 for exactly the
/// left / right half, else the braille pattern of the lit pixels
/// (U+2800 + the dot bits: the left column dots 1 2 3 7, the right 4 5 6 8).
pub fn cell_cp(b: Bitmap, cr: int, cc: int) -> int {
    var bits = 0
    var lit = 0
    var r = 0
    while r < 4 {
        var c = 0
        while c < 2 {
            if at(b, cr * 4 + r, cc * 2 + c) == 1 {
                lit += 1
                let dot = if c == 0 {
                    (if r == 3 then 64 else 1 * (if r == 0 then 1 else if r == 1 then 2 else 4))
                } else {
                    (if r == 3 then 128 else 8 * (if r == 0 then 1 else if r == 1 then 2 else 4))
                }
                bits += dot
            }
            c += 1
        }
        r += 1
    }
    if lit == 0 { return 32 }
    if lit == 8 { return 9608 }
    if bits == 1 + 2 + 8 + 16 { return 9600 }
    if bits == 4 + 64 + 32 + 128 { return 9604 }
    if bits == 1 + 2 + 4 + 64 { return 9612 }
    if bits == 8 + 16 + 32 + 128 { return 9616 }
    10240 + bits
}

/// Draw a bitmap with its top-left cell at `(row, col)` in `style`'s
/// colours; cells with no lit pixel are left as they are.
pub fn draw(mut g: grid.Grid, row: int, col: int, b: Bitmap, style: grid.Cell) {
    var cr = 0
    while cr < rows(b) {
        var cc = 0
        while cc < cols(b) {
            let cp = cell_cp(b, cr, cc)
            if cp != 32 {
                var cell = copy style
                cell.cp = cp
                // A default background lets the ground show behind the body.
                if cell.bg == grid.COLOR_DEFAULT { cell.bg = grid.at(g, row + cr, col + cc).bg }
                grid.put(mut g, row + cr, col + cc, cell)
            }
            cc += 1
        }
        cr += 1
    }
}

/// Where a bitmap's top-left cell sits so that its anchor (the creature's
/// own cell) is at `(row, col)`: the middle cell, rounded up and left (a
/// 4 by 4 cell silhouette spans rows -1..2 and columns -1..2 about it, its
/// 8 by 2 turn rows 0..1 and columns -3..4).
pub fn anchor(b: Bitmap, facing: int) -> (int, int) {
    let t = turned(b, facing)
    (0 - (rows(t) - 1) / 2, 0 - (cols(t) - 1) / 2)
}

/// The cells a drawing `w` by `h` pixels covers facing `facing`, from its
/// anchor cell, without building it: `(dc, dr, cols, rows)`, the left
/// column and top row offsets and the size, as `draw_at` places it (cb02c:
/// the simulation's bodies are these rectangles; `gait_test` holds them to
/// the drawings).
pub fn footprint(w: int, h: int, facing: int) -> (int, int, int, int) {
    let f = (facing % 4 + 4) % 4
    let tw = if f % 2 == 0 then w else h
    let th = if f % 2 == 0 then h else w
    let cols = (tw + 1) / 2
    let rows = (th + 3) / 4
    (0 - (cols - 1) / 2, 0 - (rows - 1) / 2, cols, rows)
}

/// The cub's drawing's size in pixels, north: eight across, sixteen down.
pub fn cub_size() -> (int, int) {
    (8, 16)
}

/// A ground foe's drawing's size in pixels, north (the simulation's
/// kinds: 0 weasel, 1 fox, 3 deer; the bosses 4 boar, 5 lynx, 6 elk, 7
/// shadow alpha, cb04: big bodies, two to three cells larger than the cub
/// each way).
pub fn foe_size(kind: int) -> (int, int) {
    match kind {
        0 => (4, 12),
        8 => (4, 12),
        1 => (8, 12),
        4 => (12, 24),
        5 => (10, 20),
        6 => (14, 28),
        7 => (12, 24),
        _ => (8, 16),
    }
}

/// The wolf the cub becomes at the end (cb04): the cub's drawing grown
/// one size, twelve pixels across and twenty-four down (six cells by six
/// north, twelve by three east).
pub fn wolf_size() -> (int, int) {
    (12, 24)
}

/// Draw a creature at its cell `(row, col)` facing `facing`.
pub fn draw_at(mut g: grid.Grid, row: int, col: int, b: Bitmap, facing: int, style: grid.Cell) {
    let t = turned(b, facing)
    let (dr, dc) = anchor(b, facing)
    draw(mut g, row + dr, col + dc, t, style)
}

/// Every code point a bitmap can produce facing each of the four ways,
/// appended to `cps` once each (32 excluded).
pub fn code_points(b: Bitmap, mut cps: List[int]) {
    var f = 0
    while f < 4 {
        let t = turned(b, f)
        var cr = 0
        while cr < rows(t) {
            var cc = 0
            while cc < cols(t) {
                let cp = cell_cp(t, cr, cc)
                if cp != 32 {
                    var seen = false
                    for k in cps { if k == cp { seen = true } }
                    if !seen { (mut cps).push(cp) }
                }
                cc += 1
            }
            cr += 1
        }
        f += 1
    }
}

/// The bitmap with only its head (the first four pixel rows, one cell
/// row north) kept, or only the rest: the two parts a head shake draws.
pub fn strip(b: Bitmap, head: bool) -> Bitmap {
    var out = copy b
    var i = 0
    while i < out.px.len {
        if (i / out.w < 4) != head { out.px[i] = 0 }
        i += 1
    }
    out
}

/// Whether two bitmaps are the same size with the same pixels.
pub fn same(a: Bitmap, b: Bitmap) -> bool {
    if a.w != b.w || a.h != b.h { return false }
    var i = 0
    while i < a.px.len {
        if a.px[i] != b.px[i] { return false }
        i += 1
    }
    true
}

/// Lit pixels.
pub fn count(b: Bitmap) -> int {
    var n = 0
    for p in b.px { n += p }
    n
}

fn row(s: str, mut out: List[str]) {
    (mut out).push(s)
}

// The creatures, each facing north (the head up the screen). Eight pixels
// across and sixteen down is four cells by four north and eight by two
// east; the weasel is four across (two cells by three, six by one).

/// The tail's offset at eighth `phase` of a wag (cb02c, R-cb02c-2 A):
/// walking the full swing, two pixels each side, through the middle;
/// standing (or sneaking, panting, winding up) a slow sway of one pixel.
/// Eight steps a wag, so the tail passes through every intermediate frame.
pub fn wag(phase: int, walking: bool) -> int {
    let p = (phase % 8 + 8) % 8
    if walking {
        return match p {
            0 => 0,
            1 => 1,
            2 => 2,
            3 => 1,
            4 => 0,
            5 => -1,
            6 => -2,
            _ => -1,
        }
    }
    match p {
        0 => 0,
        1 => 0,
        2 => 1,
        3 => 1,
        4 => 0,
        5 => 0,
        6 => -1,
        _ => -1,
    }
}

/// The tail's two pixel rows at offset `tail` (-2..2): the base row moves
/// at the full swing only, the tip one pixel further than the base.
fn tail_rows(tail: int, mut r: List[str]) {
    row(if tail >= 2 then "....##.." else if tail <= -2 then "..##...." else "...##...", mut r)
    row(
        if tail >= 2 {
            ".....##."
        } else if tail == 1 {
            "....##.."
        } else if tail == 0 {
            "...##..."
        } else if tail == -1 {
            "..##...."
        } else {
            ".##....."
        },
        mut r,
    )
}

/// The cub, a wolf from above: a nose, a muzzle, the head with its ears
/// out, a neck, shoulders, a long body, haunches and a tail trailing
/// south. `pose` 0 stands, 1 walks (`legs` 0 or 1 sets the paws), 2
/// sneaks (the muzzle tucked, the ears back), 3 pants (ears flat, the
/// mouth open); `tail` is the tail's offset (`wag`), -2 to 2 pixels, in
/// every pose. One drawing: the frames differ in the paws and the tail.
pub fn cub(pose: int, legs: int, tail: int) -> Bitmap {
    cub_posed(pose, legs, tail, 0, 0)
}

/// The cub with its health and its breath in the drawing (cb03, posture as
/// HUD): `hurt` is the health band (0 full, 1 hurt, 2 badly hurt, 3
/// dying) and `breath` the breath's frame (1 the in-breath; panting, 1
/// the open mouth). Hurt, the ears go back (1: along the head; 2: laid
/// back at the neck; 3: flat), the tail drops (1: half its swing; 2 and
/// 3: hanging still), the trot shortens (2: one paw out a step; 3: none)
/// and, dying, the head drops like the sneak's. Breathing in, the
/// shoulders and the haunches widen a pixel each side. The same 8 by 16
/// drawing in every band: what is drawn is what collides.
pub fn cub_posed(pose: int, legs: int, tail: int, hurt: int, breath: int) -> Bitmap {
    var r = List[str]()
    let swing = legs % 2 == 0
    let low = pose == 2 || pose == 3 || hurt >= 3
    let open = pose == 3 && breath == 1 && hurt < 3
    // The snap (pose 5, cb07): the jaws thrown open at the nose, the ears
    // back along the head, the tail straight out behind: the strike's
    // body, stretched from jaw to tail, distinct from the walk and the
    // lunge's crouch.
    let snap = pose == 5
    row(
        if snap {
            "##....##"
        } else if open {
            "..#..#.."
        } else if low {
            "........"
        } else {
            "...##..."
        },
        mut r,
    )
    row(if snap then ".##..##." else if low then "...##..." else "..####..", mut r)
    row(if open then "..#..#.." else "..####..", mut r)
    row(if low || snap then "..####.." else ".######.", mut r)
    row(
        if hurt >= 2 {
            "..####.."
        } else if hurt == 1 || low || snap {
            ".######."
        } else {
            "#.####.#"
        },
        mut r,
    )
    row(if hurt == 2 then "#.####.#" else "..####..", mut r)
    row(if breath == 1 && pose != 3 then "########" else ".######.", mut r)
    let step = pose == 1 && hurt < 3
    row(
        if step && swing && hurt < 2 {
            "########"
        } else if step {
            "#######."
        } else {
            ".######."
        },
        mut r,
    )
    row("########", mut r)
    row("########", mut r)
    row(
        if step && !swing && hurt < 2 {
            "########"
        } else if step && !swing {
            ".#######"
        } else {
            ".######."
        },
        mut r,
    )
    row(".######.", mut r)
    row(if breath == 1 && pose != 3 then ".######." else "..####..", mut r)
    row("...##...", mut r)
    if hurt >= 2 || snap {
        row("...##...", mut r)
        row("...##...", mut r)
    } else {
        tail_rows(if hurt == 1 then tail / 2 else tail, mut r)
    }
    parse(r)
}

/// Foe species the sheet and the frame draw: 0 weasel, 1 fox, 3 deer
/// (the simulation's numbers); 2, the hawk, has `hawk`. Phases are the
/// simulation's: 0 hunt, 1 crouch, 2 strike, 3 retreat, 4 stagger, 5
/// feint, 6 pause; a crouch tucks the head, a strike thrusts it, a flight
/// streams the tail, a stagger splits the body, a feint curls the tail.
pub fn foe(kind: int, phase: int, fade: int) -> Bitmap {
    if kind == 8 { return ashen(phase, fade) }
    if kind >= 4 { return boss(kind, phase, fade) }
    var r = List[str]()
    let crouch = phase == 1 || phase == 5
    let strike = phase == 2
    let stagger = phase == 4
    let flee = phase == 3
    let feint = phase == 5
    if kind == 3 {
        row("#.#..#.#", mut r)
        row(".#.##.#.", mut r)
        row("..####..", mut r)
        row("..####..", mut r)
        row("...##...", mut r)
        row(".######.", mut r)
        row("########", mut r)
        row("########", mut r)
        row("########", mut r)
        row("########", mut r)
        row(".######.", mut r)
        row(".######.", mut r)
        row("..####..", mut r)
        row("...##...", mut r)
        row("........", mut r)
        row("........", mut r)
    } else if kind == 1 {
        row(if strike then "...##..." else if crouch then "........" else "....#...", mut r)
        row(if crouch then "........" else "...##...", mut r)
        row(if crouch then "...##..." else if stagger then "#.#..#.#" else "#.####.#", mut r)
        row(if stagger then ".#....#." else ".######.", mut r)
        row("..####..", mut r)
        row(if stagger then "##....##" else ".######.", mut r)
        row(if stagger then "##....##" else ".######.", mut r)
        row("..####..", mut r)
        row(if feint then "...#####" else if flee then ".####..." else "..####..", mut r)
        row(if feint then "......##" else if flee then "..######" else ".######.", mut r)
        row(if feint then "....####" else if flee then "....####" else ".######.", mut r)
        row(if feint then "...##..." else if flee then "......##" else "..####..", mut r)
    } else {
        row(if strike then ".##." else if crouch then "...." else ".##.", mut r)
        row(if crouch then ".##." else "####", mut r)
        row(if stagger then "#..#" else ".##.", mut r)
        row(".##.", mut r)
        row(".##.", mut r)
        row(if stagger then "#..#" else ".##.", mut r)
        row(".##.", mut r)
        row(".##.", mut r)
        row(if flee then "..##" else "..#.", mut r)
        row(if flee then "...#" else "..#.", mut r)
        row(if feint then ".#.." else "..#.", mut r)
        row(if feint then "##.." else if flee then "...#" else ".#..", mut r)
    }
    var b = parse(r)
    // A death erodes from the head: the head at five ticks, the body at ten.
    if fade >= 5 {
        var i = 0
        while i < b.px.len {
            let pr = i / b.w
            if pr < 4 || fade >= 10 && pr < 9 { b.px[i] = 0 }
            i += 1
        }
    }
    b
}

/// An Ashen (cb05): one of Cinderwick's dead from above, four pixels
/// across and twelve down (two cells by three north, six by one turned):
/// the head, the shoulders, a long thin body, the legs. The windup is the
/// tell a person reads: the arms rise, slowly, up beside the head; the
/// blow thrusts one arm out; a stagger splits the body. A death erodes
/// from the head as every foe's does.
fn ashen(phase: int, fade: int) -> Bitmap {
    var r = List[str]()
    let windup = phase == 1
    let strike = phase == 2
    let stagger = phase == 4
    row(if windup then "#..#" else ".##.", mut r)
    row(if windup then "#..#" else if stagger then "#..#" else ".##.", mut r)
    row(if windup then "####" else if stagger then "...." else "####", mut r)
    row(if strike then "##.#" else ".##.", mut r)
    row(if stagger then "#..#" else ".##.", mut r)
    row(".##.", mut r)
    row(".##.", mut r)
    row(if stagger then "...." else ".##.", mut r)
    row(if windup || strike then ".##." else "#..#", mut r)
    row(if windup then ".##." else "#..#", mut r)
    row(if stagger then "...." else "#..#", mut r)
    row(if windup || stagger then "#..#" else "....", mut r)
    var b = parse(r)
    if fade >= 5 {
        var i = 0
        while i < b.px.len {
            let pr = i / b.w
            if pr < 4 || fade >= 10 && pr < 9 { b.px[i] = 0 }
            i += 1
        }
    }
    b
}

/// The hawk's shadow on the ground, 8 pixels across (4 cells by 1), wings
/// out while it circles (0), spread wide at the stop (1), folded in the
/// stoop (2), half open recovering (3).
pub fn hawk(phase: int, fade: int) -> Bitmap {
    var r = List[str]()
    if phase == 2 {
        row("...##...", mut r)
        row("..####..", mut r)
        row("...##...", mut r)
        row("...##...", mut r)
    } else if phase == 1 {
        row("##....##", mut r)
        row("########", mut r)
        row(".######.", mut r)
        row("...##...", mut r)
    } else if phase == 3 {
        row("........", mut r)
        row(".##..##.", mut r)
        row("..####..", mut r)
        row("...##...", mut r)
    } else {
        row("#......#", mut r)
        row(".######.", mut r)
        row("..####..", mut r)
        row("...##...", mut r)
    }
    var b = parse(r)
    if fade >= 5 {
        var i = 0
        while i < b.px.len {
            if i / b.w < 2 || fade >= 10 && i / b.w < 3 { b.px[i] = 0 }
            i += 1
        }
    }
    b
}

/// A wrapped bundle (10 by 12 pixels, 5 by 3 cells): a knot above a round
/// parcel with its cord crossing; opened, the loose binding alone.
pub fn bundle(opened: bool) -> Bitmap {
    var r = List[str]()
    if opened {
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..........", mut r)
        row("..#....#..", mut r)
        row("...#..#...", mut r)
        row("##########", mut r)
        row("..........", mut r)
    } else {
        row("....##....", mut r)
        row("...####...", mut r)
        row(".###..###.", mut r)
        row("###....###", mut r)
        row("###....###", mut r)
        row("####..####", mut r)
        row("####..####", mut r)
        row("###....###", mut r)
        row("###....###", mut r)
        row(".###..###.", mut r)
        row("..######..", mut r)
        row("...####...", mut r)
    }
    parse(r)
}

/// The bosses (cb04), each one drawing facing north, its tells postures of
/// the drawing: 0 hunt, 1 windup, 2 strike, 3 recovery, 4 stagger; the
/// alpha's 7 guard (its parry) and 8 hop (its dodge). A death erodes the
/// head at fifteen ticks and the body at thirty (the boss fade is forty-
/// five). The shapes are cub's own.
pub fn boss(kind: int, phase: int, fade: int) -> Bitmap {
    var b = if kind == 4 {
        boar(phase)
    } else if kind == 5 {
        lynx(phase)
    } else if kind == 6 {
        elk(phase)
    } else {
        alpha(phase)
    }
    if fade >= 15 {
        // The fade clears whole cell rows (four pixel rows each) from the
        // top: a quarter of the body at 15, three quarters at 30, so a
        // fading boss draws only cells its postures draw (and blanks).
        let top = if fade >= 30 then b.h * 3 / 4 / 4 * 4 else b.h / 4 / 4 * 4
        var i = 0
        while i < b.px.len {
            if i / b.w < top { b.px[i] = 0 }
            i += 1
        }
    }
    b
}

/// Old Snag, the boar of the thicket: a broad snout, one tusk whole and
/// one broken (the right), a bristled back, a short tail. Twelve pixels by
/// twenty-four. The windup lowers the head and raises the bristles; the
/// strike thrusts the snout; the stagger splits the body; recovery turns
/// the tail up.
fn boar(phase: int) -> Bitmap {
    var r = List[str]()
    let windup = phase == 1
    let strike = phase == 2
    let stagger = phase == 4
    row(if strike then "...######..." else if windup then "............" else "....####....", mut r)
    row(if windup then "............" else "...######...", mut r)
    row(if windup then "....####...." else "..########..", mut r)
    row(if windup then "##.######.#." else "##.######.#.", mut r)
    row(if windup then "#.########.." else "..########..", mut r)
    row(if windup then "#..######..." else "...######...", mut r)
    row(if windup then "#.#.#.#.#.#." else "..########..", mut r)
    row(if stagger then ".##......##." else ".##########.", mut r)
    row(
        if windup then "#.#.#.#.#.#." else if stagger then "##.######.##" else "############",
        mut r,
    )
    row("############", mut r)
    row(if windup then "#.#.#.#.#.#." else "############", mut r)
    row(if stagger then "##.######.##" else "############", mut r)
    row("############", mut r)
    row(if stagger then ".##......##." else ".##########.", mut r)
    row(".##########.", mut r)
    row("..########..", mut r)
    row("..########..", mut r)
    row("...######...", mut r)
    row("...######...", mut r)
    row("....####....", mut r)
    row(if phase == 3 then "....######.." else "....####....", mut r)
    row(if phase == 3 then ".......##..." else ".....##.....", mut r)
    row(if phase == 3 then "........#..." else ".....##.....", mut r)
    row(if phase == 3 then "............" else "......#.....", mut r)
    parse(r)
}

/// Whisper, the lynx of the crags: tufted ears, a round head, a long lean
/// body, the tail curled. Ten pixels by twenty. The windup flattens the
/// body to the ground (the long steady tell before a pounce); the strike
/// stretches it full length; the stagger splits it; recovery straightens
/// the tail.
fn lynx(phase: int) -> Bitmap {
    var r = List[str]()
    let windup = phase == 1
    let strike = phase == 2
    let stagger = phase == 4
    row(if windup then ".#......#." else ".##....##.", mut r)
    row(if windup then "..######.." else "..######..", mut r)
    row(if strike then "##########" else ".########.", mut r)
    row("..######..", mut r)
    row(if windup then "..######.." else "...####...", mut r)
    row(if windup then ".########." else "..######..", mut r)
    row(if windup then "##########" else ".########.", mut r)
    row(if stagger then ".##....##." else if windup then "##########" else ".########.", mut r)
    row(if windup then "##########" else if strike then "##########" else ".########.", mut r)
    row(if stagger then ".##....##." else if windup then "##########" else ".########.", mut r)
    row(if windup then ".########." else ".########.", mut r)
    row(if windup then "..######.." else "..######..", mut r)
    row("..######..", mut r)
    row(if strike then "..######.." else "...####...", mut r)
    row("...####...", mut r)
    row(if phase == 3 then "....##...." else "....##....", mut r)
    row(if phase == 3 then "....##...." else "....##....", mut r)
    row(if phase == 3 then "....##...." else ".....#....", mut r)
    row(if phase == 3 then "....##...." else "....#.....", mut r)
    row(if phase == 3 then "....##...." else "...#......", mut r)
    parse(r)
}

/// Alder, the elk of the river: a spread of antlers, a long head, a deep
/// chest, a short tail. Fourteen pixels by twenty-eight. The windup lowers
/// the antlers to one side (the sweep's tell) or rears the body wide (the
/// stamp's, the same posture read from the body); the strike brings the
/// antlers down level; the stagger splits the body.
fn elk(phase: int) -> Bitmap {
    var r = List[str]()
    let windup = phase == 1
    let strike = phase == 2
    let stagger = phase == 4
    row(
        if windup then ".............." else if strike then ".............." else "#.#........#.#",
        mut r,
    )
    row(
        if windup then "#.#.#........." else if strike then ".............." else ".#.#......#.#.",
        mut r,
    )
    row(
        if windup then ".#.#.#........" else if strike then "#.#.#....#.#.#" else "..#.#....#.#..",
        mut r,
    )
    row(
        if windup then "..##.#........" else if strike then ".#.#.#..#.#.#." else "...##....##...",
        mut r,
    )
    row(
        if windup then "...######....." else if strike then "..############" else "....######....",
        mut r,
    )
    row(if windup then "...######....." else "....######....", mut r)
    row(if windup then "....####......" else ".....####.....", mut r)
    row(".....####.....", mut r)
    row(if windup then "..##########.." else "....######....", mut r)
    row(if windup then "##############" else "..##########..", mut r)
    row(if stagger then ".##........##." else ".############.", mut r)
    row(if stagger then "##..########.." else ".############.", mut r)
    row(".############.", mut r)
    row(if stagger then "##..########.." else ".############.", mut r)
    row(".############.", mut r)
    row(if stagger then ".##........##." else ".############.", mut r)
    row("..##########..", mut r)
    row("..##########..", mut r)
    row("...########...", mut r)
    row("...########...", mut r)
    row("....######....", mut r)
    row("....######....", mut r)
    row(".....####.....", mut r)
    row(if phase == 3 then ".....######..." else "......##......", mut r)
    row(if phase == 3 then "........##...." else "......##......", mut r)
    row("..............", mut r)
    row("..............", mut r)
    row("..............", mut r)
    parse(r)
}

/// Ashgrim, the shadow alpha: the cub's own shape grown, a wolf of smoke,
/// its body drawn in streaks (every other pixel) so the ground shows
/// through it. Twelve pixels by twenty-four. The windup lays the ears
/// back and lowers the head as the cub's sneak does; the strike thrusts
/// the head; the guard (7) widens the shoulders; the hop (8) streams the
/// body; the stagger splits it.
fn alpha(phase: int) -> Bitmap {
    var r = List[str]()
    let windup = phase == 1
    let strike = phase == 2
    let stagger = phase == 4
    let guard = phase == 7
    let hop = phase == 8
    row(if strike then "...######..." else if windup then "............" else "....####....", mut r)
    row(if windup then "....####...." else "...######...", mut r)
    row(if windup then "...######..." else "..########..", mut r)
    row(if windup then "..########.." else if guard then "############" else ".#..####..#.", mut r)
    row(if windup then ".#.######.#." else "..########..", mut r)
    row(if guard then "############" else "...######...", mut r)
    row(if guard then "############" else "..########..", mut r)
    row(if stagger then ".#.#....#.#." else ".#.#.#.#.#.#", mut r)
    row(if hop then "#.#.#.#.#.#." else "#.#.#.#.#.#.", mut r)
    row(if stagger then "##........##" else ".#.#.#.#.#.#", mut r)
    row("#.#.#.#.#.#.", mut r)
    row(if stagger then ".#.#....#.#." else ".#.#.#.#.#.#", mut r)
    row(if hop then ".#.#.#.#.#.#" else "#.#.#.#.#.#.", mut r)
    row("..#.#.#.#.#.", mut r)
    row(if hop then "#.#.#.#.#.#." else "..#.#.#.#...", mut r)
    row("...#.#.#....", mut r)
    row(if hop then ".#.#.#.#.#.." else "...#.#.#....", mut r)
    row("....#.#.....", mut r)
    row("....#.#.....", mut r)
    row(if hop then ".#.#.#.#...." else ".....#......", mut r)
    row(".....#......", mut r)
    row(if hop then "...#.#.#...." else ".....#......", mut r)
    row("......#.....", mut r)
    row(if hop then ".....#.#...." else ".......#....", mut r)
    parse(r)
}

/// The wolf the cub becomes at the end (cb04): the cub's drawing grown
/// one size, solid, the tail long; `pose` 0 stands, 1 walks (`legs` the
/// paws' frame), as the cub's.
pub fn wolf(pose: int, legs: int) -> Bitmap {
    var r = List[str]()
    let swing = legs % 2 == 0
    row("....####....", mut r)
    row("...######...", mut r)
    row("..########..", mut r)
    row(".#..####..#.", mut r)
    row("..########..", mut r)
    row("...######...", mut r)
    row("..########..", mut r)
    row(".##########.", mut r)
    row(
        if pose == 1 && swing {
            "############"
        } else if pose == 1 {
            "###########."
        } else {
            ".##########."
        },
        mut r,
    )
    row("############", mut r)
    row("############", mut r)
    row("############", mut r)
    row(
        if pose == 1 && !swing {
            "############"
        } else if pose == 1 {
            ".###########"
        } else {
            ".##########."
        },
        mut r,
    )
    row(".##########.", mut r)
    row("..########..", mut r)
    row("..########..", mut r)
    row("...######...", mut r)
    row("....####....", mut r)
    row(".....##.....", mut r)
    row(".....##.....", mut r)
    row(".....##.....", mut r)
    row("......##....", mut r)
    row("......##....", mut r)
    row(".......#....", mut r)
    parse(r)
}

/// The highest code point a silhouette cell can be: a braille pattern.
/// The presence table's span: U+2500 (the box drawing and block elements)
/// up to the braille patterns' end, U+28FF; a glyph outside it would be a
/// silhouette bug, so `collect` traps on one.
const CP_BASE: int = 9472

const CP_SPAN: int = 1024

/// Every code point `b` can produce facing each of the four ways, each
/// once across the whole enumeration (`seen` by code point), appended to
/// `cps` (32 excluded).
fn collect(b: Bitmap, mut seen: List[bool], mut cps: List[int]) {
    var f = 0
    while f < 4 {
        let t = turned(b, f)
        var cr = 0
        while cr < rows(t) {
            var cc = 0
            while cc < cols(t) {
                let cp = cell_cp(t, cr, cc)
                if cp != 32 {
                    assert(
                        cp >= CP_BASE && cp < CP_BASE + CP_SPAN,
                        "a silhouette glyph outside U+2500..U+28FF",
                    )
                    if !seen[cp - CP_BASE] {
                        seen[cp - CP_BASE] = true
                        (mut cps).push(cp)
                    }
                }
                cc += 1
            }
            cr += 1
        }
        f += 1
    }
}

/// Every code point every silhouette can draw, facing each way, each once,
/// ascending: what `docs/GLYPHS.md` must list for them. A presence table
/// does the dedup (cb04: the bosses doubled the drawings, and a linear
/// scan per cell put the checked tests over their budget).
pub fn all_code_points() -> List[int] {
    var cps = List[int]()
    var seen = List[bool]()
    (mut seen).reserve(CP_SPAN)
    var n = 0
    while n < CP_SPAN { (mut seen).push(false); n += 1 }
    // The cub's frames, one cell row at a time with the parameters that
    // reach it (cb03: the health bands and the breath multiply the frames,
    // and the checked machine's budget is finite): rows 0-3 the head
    // (the pose, a dying head, the pant's mouth); rows 4-7 the ears, neck,
    // shoulders and fore paws (the pose, the paws, every band, the
    // breath); rows 8-11 the body and hind paws (the pose, the paws, the
    // band); rows 12-15 the haunches and tail (the breath, the band, the
    // tail's offset). A row group's cells are its own in every facing, so
    // the enumeration is complete.
    var pose = 0
    while pose < 4 {
        var breath = 0
        while breath < 2 {
            collect(cell_row(cub_posed(pose, 0, 0, 0, breath), 0), mut seen, mut cps)
            collect(cell_row(cub_posed(pose, 0, 0, 3, breath), 0), mut seen, mut cps)
            var legs = 0
            while legs < 2 {
                var hurt = 0
                while hurt < 4 {
                    collect(cell_row(cub_posed(pose, legs, 0, hurt, breath), 1), mut seen, mut cps)
                    if breath == 0 {
                        collect(cell_row(cub_posed(pose, legs, 0, hurt, 0), 2), mut seen, mut cps)
                    }
                    hurt += 1
                }
                legs += 1
            }
            breath += 1
        }
        pose += 1
    }
    var hurt = 0
    while hurt < 4 {
        var tail = -2
        while tail <= 2 {
            collect(cell_row(cub_posed(0, 0, tail, hurt, 0), 3), mut seen, mut cps)
            collect(cell_row(cub_posed(0, 0, tail, hurt, 1), 3), mut seen, mut cps)
            tail += 1
        }
        hurt += 1
    }
    var kind = 0
    while kind < 4 {
        if kind != 2 {
            var phase = 0
            while phase < 7 {
                collect(foe(kind, phase, -1), mut seen, mut cps)
                collect(foe(kind, phase, 5), mut seen, mut cps)
                collect(foe(kind, phase, 10), mut seen, mut cps)
                phase += 1
            }
        }
        kind += 1
    }
    var phase = 0
    while phase < 4 {
        collect(hawk(phase, -1), mut seen, mut cps)
        collect(hawk(phase, 5), mut seen, mut cps)
        collect(hawk(phase, 10), mut seen, mut cps)
        phase += 1
    }
    // The bosses in every posture, the wolf in its two poses. A boss's fade
    // clears whole cell rows (`boss`), so it draws no cell its postures do
    // not: the fades need no enumeration (the checked machine's budget).
    kind = 4
    while kind < 8 {
        phase = 0
        while phase < 9 {
            if phase <= 4 || phase >= 7 { collect(boss(kind, phase, -1), mut seen, mut cps) }
            phase += 1
        }
        kind += 1
    }
    collect(wolf(0, 0), mut seen, mut cps)
    collect(wolf(1, 0), mut seen, mut cps)
    collect(wolf(1, 1), mut seen, mut cps)
    collect(bundle(false), mut seen, mut cps)
    collect(bundle(true), mut seen, mut cps)
    var i = 1
    while i < cps.len {
        var j = i
        while j > 0 && cps[j - 1] > cps[j] {
            let t = cps[j]
            cps[j] = cps[j - 1]
            cps[j - 1] = t
            j -= 1
        }
        i += 1
    }
    cps
}
