//! member: false
//!
//! The frame: the same state twice gives the same grid; the cub is drawn
//! at the centre on both tiers, facing the way it does; the sheet is the
//! size the art study says, and the plain sheet keeps the plain promise.

use art
use controls
use grid
use sim
use sprites
use tier

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn test_render_is_pure() {
    let s = sim.new(3, 80, 24)
    var a = grid.new(24, 80)
    var b = grid.new(24, 80)
    art.render(s, tier.RICH, mut a)
    art.render(s, tier.RICH, mut b)
    var i = 0
    while i < a.cells.len {
        assert(grid.same(a.cells[i], b.cells[i]), "cell {i}")
        i += 1
    }
}

fn test_the_cub_is_at_the_centre_on_both_tiers() {
    let s = sim.new(3, 80, 24)
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    let body = sprites.glyph(tier.RICH, sprites.SP_CUB_BODY, 0)
    assert(
        grid.same(grid.at(g, 12, 40), body) && grid.same(grid.at(g, 12, 41), body),
        "the body row at the centre",
    )
    assert(
        grid.at(g, 11, 40).cp == 9629 && grid.at(g, 11, 41).cp == 9624,
        "the ears above, facing north",
    )
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(grid.at(p, 12, 40).cp == 67 && grid.at(p, 12, 39).cp == 94, "the plain C with its mark")
    assert(grid.plain_ok(p), "the plain frame keeps the promise")
}

fn test_the_cub_turns_on_the_screen() {
    var s = sim.new(3, 80, 24)
    var i = 0
    while i < 30 {
        sim.step(mut s, if i % 2 == 0 then one(controls.KEY_RIGHT) else none_keys())
        i += 1
    }
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    assert(
        grid.at(g, 11, 41).cp == 9629 && grid.at(g, 12, 41).cp == 9623,
        "the ears on the east side",
    )
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(grid.at(p, 12, 39).cp == 62, "the plain mark points east")
}

fn none_keys() -> List[int] {
    List[int]()
}

fn test_the_sheet() {
    let r = art.sheet(tier.RICH)
    let p = art.sheet(tier.PLAIN)
    assert(r.rows == 24 && r.cols == 60 && p.rows == 24 && p.cols == 60, "24 by 60")
    assert(grid.plain_ok(p), "the plain sheet keeps the promise")
    assert(!grid.plain_ok(r), "the rich sheet uses the rich glyphs")
}
