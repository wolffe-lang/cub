//! member: false
//!
//! The frame: the same state twice gives the same grid; the cub is drawn
//! at the centre on both tiers, facing the way it does; the sheet is the
//! size the art study says, and the plain sheet keeps the plain promise.

use art
use controls
use grid
use silhouette
use sim
use sprites
use tier

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn test_render_is_pure() {
    let s = sim.new(3, 80, 24)
    var a = grid.new(24, 80)
    var b = grid.new(24, 80)
    art.render(s, tier.RICH, mut a)
    art.render(s, tier.RICH, mut b)
    var i = 0
    while i < a.cells.len {
        assert(grid.same(a.cells[i], b.cells[i]), "cell {i}")
        i += 1
    }
}

fn test_the_cub_is_at_the_centre_on_both_tiers() {
    let s = sim.new(3, 80, 24)
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    // The cub's own cell is the silhouette's second cell row and column
    // (four by four about it: rows 11..14, columns 39..42).
    let b = silhouette.turned(silhouette.cub(0, 0, 0), 0)
    assert(
        grid.at(g, 12, 40).cp == silhouette.cell_cp(b, 1, 1) &&
            grid.at(g, 12, 41).cp == silhouette.cell_cp(b, 1, 2) &&
            grid.at(g, 12, 40).cp != 32 &&
            grid.at(g, 12, 40).fg == sprites.palette(tier.RICH, sprites.C_FUR),
        "the shoulders at the centre",
    )
    assert(
        grid.at(g, 11, 40).cp == silhouette.cell_cp(b, 0, 1) && grid.at(g, 11, 40).cp != 32,
        "the head above, facing north",
    )
    assert(grid.at(g, 12, 40).bg == grid.at(g, 12, 39).bg, "the ground shows behind the body")
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(
        grid.at(p, 12, 40).cp == 35 && grid.at(p, 11, 40).cp == 94,
        "the plain body with its ears",
    )
    assert(grid.plain_ok(p), "the plain frame keeps the promise")
}

fn test_the_cub_turns_on_the_screen() {
    var s = sim.new(3, 80, 24)
    var i = 0
    while i < 30 {
        sim.step(mut s, if i % 2 == 0 then one(controls.KEY_RIGHT) else none_keys())
        i += 1
    }
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    // East: the north silhouette turned a quarter, two rows (12 and 13)
    // from c-3 to c+4, the head in the last cells, the same pose the frame
    // drew (walking while the key is held, standing otherwise).
    let pose = if s.speed > 0 then 1 else 0
    let east = silhouette.turned(
        silhouette.cub(pose, sim.legs(s), silhouette.wag(sim.tail_phase(s), pose == 1)),
        1,
    )
    assert(
        grid.at(g, 12, 44).cp == silhouette.cell_cp(east, 0, 7) &&
            grid.at(g, 12, 37).cp == silhouette.cell_cp(east, 0, 0) &&
            grid.at(g, 13, 44).cp == silhouette.cell_cp(east, 1, 7) &&
            grid.at(g, 12, 44).cp != 32,
        "the turned silhouette along the cub's rows",
    )
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(grid.at(p, 13, 43).cp == 62, "the plain head points east")
}

fn none_keys() -> List[int] {
    List[int]()
}

fn test_the_sheet() {
    let r = art.sheet(tier.RICH)
    let p = art.sheet(tier.PLAIN)
    assert(r.rows == 56 && r.cols == 80 && p.rows == 56 && p.cols == 80, "56 by 80")
    assert(grid.plain_ok(p), "the plain sheet keeps the promise")
    assert(!grid.plain_ok(r), "the rich sheet uses the rich glyphs")
}

fn posture_pair(action: int) {
    var s = sim.new(7, 80, 24)
    var before = grid.new(24, 80)
    s.action = if action > 0 then action - 1 else sim.FALL
    art.render(s, tier.PLAIN, mut before)
    s.action = action
    s.tick = if action == sim.BITE then 3 else if action == sim.LUNGE then 10 else 0
    if action == sim.BITE || action == sim.LUNGE { s.attack_heading = 64 }
    var after = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut after)
    assert(grid.plain_ok(after), "plain posture")
    var different = false
    var i = 0
    while i < after.cells.len {
        if !grid.same(after.cells[i], before.cells[i]) { different = true }
        i += 1
    }
    assert(different, "distinct posture {action}")
}

fn test_combat_posture_0() { posture_pair(0) }

fn test_combat_posture_1() { posture_pair(1) }

fn test_combat_posture_2() { posture_pair(2) }

fn test_combat_posture_3() { posture_pair(3) }

fn test_combat_posture_4() { posture_pair(4) }

fn test_combat_posture_5() { posture_pair(5) }

fn test_combat_posture_6() { posture_pair(6) }

fn test_cb01b_sideways_silhouette_keeps_body_cells() {
    // One silhouette, four facings: east and west are the north drawing
    // turned, pixel for pixel; north and south fill four cells by four,
    // east and west eight by two; the plain tier keeps the same footprints.
    var pose = 0
    while pose < 4 {
        let north = silhouette.cub(pose, 0, 0)
        assert(north.w == 8 && north.h == 16, "eight by sixteen pixels")
        var f = 0
        while f < 4 {
            let turned = silhouette.turned(north, f)
            assert(
                silhouette.count(turned) == silhouette.count(north),
                "the same pixels facing {f}",
            )
            assert(
                silhouette.rows(turned) == (if f % 2 == 0 then 4 else 2) &&
                    silhouette.cols(turned) == (if f % 2 == 0 then 4 else 8),
                "footprint facing {f}",
            )
            var t = tier.PLAIN
            while t <= tier.RICH {
                var g = grid.new(8, 14)
                art.draw_pose(mut g, t, 3, 6, f, 0, pose, 0, 0, true, 0, 0)
                var lit = 0
                var row = 0
                while row < 8 {
                    var col = 0
                    while col < 14 {
                        if grid.at(g, row, col).cp != 32 {
                            lit += 1
                            let inside = if f % 2 == 0 {
                                row >= 2 && row <= 5 && col >= 5 && col <= 8
                            } else {
                                row >= 3 && row <= 4 && col >= 3 && col <= 10
                            }
                            assert(inside, "inside the footprint facing {f} pose {pose}")
                        }
                        col += 1
                    }
                    row += 1
                }
                assert(lit >= 8, "a visible body facing {f} pose {pose} tier {t}")
                if t == tier.PLAIN { assert(grid.plain_ok(g), "plain posture") }
                t += 1
            }
            f += 1
        }
        pose += 1
    }
    // East is north turned clockwise; west anticlockwise; south twice.
    let b = silhouette.cub(0, 0, 0)
    assert(
        silhouette.same(silhouette.turned(silhouette.turned(b, 1), 1), silhouette.turned(b, 2)) &&
            silhouette.same(
                silhouette.turned(silhouette.turned(b, 2), 1),
                silhouette.turned(b, 3),
            ) &&
            silhouette.same(silhouette.turned(silhouette.turned(b, 3), 1), b),
        "four quarter turns return the drawing",
    )
}

fn test_cb01b_each_foe_has_head_body_tail_tell_and_fade_on_both_tiers() {
    var t = tier.PLAIN
    while t <= tier.RICH {
        var kind = sim.WEASEL
        while kind <= sim.FOX {
            var phase = sim.HUNT
            while phase <= sim.PAUSE {
                var g = grid.new(10, 14)
                art.draw_foe(mut g, t, 4, 5, kind, phase, 0, -1)
                assert(grid.at(g, 4, 5).cp != 32 && grid.at(g, 4, 6).cp != 32, "two body cells")
                assert(grid.at(g, 3, 5).cp != 32 || grid.at(g, 3, 6).cp != 32, "a head")
                assert(grid.at(g, 5, 5).cp != 32 || grid.at(g, 5, 6).cp != 32, "a tail")
                assert(
                    grid.at(g, 4, 5).fg != sprites.palette(t, sprites.C_FUR),
                    "foe colour not cub/trail",
                )
                if t == tier.PLAIN {
                    if phase == sim.CROUCH {
                        assert(grid.at(g, 3, 5).cp == 95, "crouching head is tell")
                    }
                    if phase == sim.RETREAT { assert(grid.at(g, 5, 5).cp == 126, "fleeing tail") }
                    assert(grid.plain_ok(g), "plain foe")
                } else {
                    // The tell is a posture of the one silhouette: a crouch
                    // draws fewer pixels than the hunt, a flight another tail.
                    let hunt = silhouette.foe(kind, sim.HUNT, -1)
                    let posed = silhouette.foe(kind, phase, -1)
                    if phase == sim.CROUCH {
                        assert(
                            silhouette.count(posed) < silhouette.count(hunt),
                            "crouch lowers the head",
                        )
                    }
                    if phase == sim.RETREAT {
                        assert(!silhouette.same(posed, hunt), "flight trails the tail")
                    }
                    assert(grid.at(g, 4, 5).cp >= 9600, "a block or braille body")
                }
                phase += 1
            }
            var fading = grid.new(10, 14)
            art.draw_foe(mut fading, t, 4, 5, kind, sim.HUNT, 0, 10)
            if t == tier.PLAIN {
                assert(grid.at(fading, 4, 5).cp == 46, "late fade")
            } else {
                assert(
                    grid.at(fading, 3, 5).cp == 32 &&
                        grid.at(fading, 3, 6).cp == 32 &&
                        grid.at(fading, 4, 5).cp == 32,
                    "the head and body erode by ten ticks",
                )
            }
            var gone = grid.new(10, 14)
            art.draw_foe(mut gone, t, 4, 5, kind, sim.HUNT, 0, sim.FOE_FADE_TICKS)
            assert(grid.at(gone, 4, 5).cp == 32 && grid.at(gone, 5, 5).cp == 32, "fade ends")
            kind += 1
        }
        t += 1
    }
}

fn test_cb01b_scent_hud_updates_on_kill_death_and_recovery() {
    var s = sim.new(7, 80, 24)
    s.heading = 64
    s.foes[0].x = s.x + sim.FP * 3 / 2
    s.foes[0].y = s.y
    sim.step(mut s, one(controls.KEY_BITE))
    var n = 0
    while n < 3 { sim.step(mut s, none_keys()); n += 1 }
    assert(s.scent == 0 && s.drops.len == 1, "kill leaves a visible pickup")
    s.x = s.foes[0].x
    s.y = s.foes[0].y
    sim.step(mut s, none_keys())
    assert(s.scent == 8 && art.hud_text(s).contains("scent 8"), "pickup updates counter")
    sim.hurt(mut s, 100)
    assert(art.hud_text(s).contains("scent 0") && s.mark_scent == 8, "death drops carried scent")
    var t = tier.PLAIN
    while t <= tier.RICH {
        var g = grid.new(24, 80)
        art.render(s, t, mut g)
        assert(grid.at(g, 0, 1).cp == 115, "HUD survives death fade (the scent, cb03)")
        if t == tier.PLAIN { assert(grid.plain_ok(g), "death card is plain") }
        t += 1
    }
    n = 0
    while n < 30 { sim.step(mut s, none_keys()); n += 1 }
    s.x = s.mark_x
    s.y = s.mark_y
    sim.step(mut s, none_keys())
    assert(
        !s.mark && s.scent == 8 && art.hud_text(s).contains("scent 8"),
        "mark recovery updates HUD",
    )
    let carried = s.scent
    sim.step(mut s, one(controls.KEY_HEART))
    assert(s.scent == carried && s.heart == 1, "HUD cannot spend outside den")
}
