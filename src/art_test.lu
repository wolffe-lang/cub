//! member: false
//!
//! The frame: the same state twice gives the same grid; the cub is drawn
//! at the centre on both tiers, facing the way it does; the sheet is the
//! size the art study says, and the plain sheet keeps the plain promise.

use art
use controls
use grid
use sim
use sprites
use tier

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn test_render_is_pure() {
    let s = sim.new(3, 80, 24)
    var a = grid.new(24, 80)
    var b = grid.new(24, 80)
    art.render(s, tier.RICH, mut a)
    art.render(s, tier.RICH, mut b)
    var i = 0
    while i < a.cells.len {
        assert(grid.same(a.cells[i], b.cells[i]), "cell {i}")
        i += 1
    }
}

fn test_the_cub_is_at_the_centre_on_both_tiers() {
    let s = sim.new(3, 80, 24)
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    let body = sprites.glyph(tier.RICH, sprites.SP_CUB_BODY, 0)
    assert(
        grid.same(grid.at(g, 12, 40), body) && grid.same(grid.at(g, 12, 41), body),
        "the body row at the centre",
    )
    assert(
        grid.at(g, 11, 40).cp == 9629 && grid.at(g, 11, 41).cp == 9624,
        "the ears above, facing north",
    )
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(
        grid.at(p, 12, 40).cp == 67 && grid.at(p, 11, 40).cp == 94,
        "the plain body with its ears",
    )
    assert(grid.plain_ok(p), "the plain frame keeps the promise")
}

fn test_the_cub_turns_on_the_screen() {
    var s = sim.new(3, 80, 24)
    var i = 0
    while i < 30 {
        sim.step(mut s, if i % 2 == 0 then one(controls.KEY_RIGHT) else none_keys())
        i += 1
    }
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    assert(
        grid.at(g, 11, 40).cp == 9629 && grid.at(g, 11, 41).cp == 9623,
        "east ears above the unchanged body",
    )
    var p = grid.new(24, 80)
    art.render(s, tier.PLAIN, mut p)
    assert(grid.at(p, 11, 40).cp == 62, "the plain mark points east")
}

fn none_keys() -> List[int] {
    List[int]()
}

fn test_the_sheet() {
    let r = art.sheet(tier.RICH)
    let p = art.sheet(tier.PLAIN)
    assert(r.rows == 40 && r.cols == 80 && p.rows == 40 && p.cols == 80, "40 by 80")
    assert(grid.plain_ok(p), "the plain sheet keeps the promise")
    assert(!grid.plain_ok(r), "the rich sheet uses the rich glyphs")
}

fn test_every_combat_posture_on_both_tiers_is_valid_and_distinct() {
    var s = sim.new(7, 80, 24)
    var action = sim.IDLE
    var previous = grid.new(24, 80)
    while action <= sim.FALL {
        s.action = action
        s.tick = if action == sim.BITE then 3 else if action == sim.LUNGE then 10 else 0
        if action == sim.BITE || action == sim.LUNGE { s.attack_heading = 64 }
        var plain = grid.new(24, 80)
        art.render(s, tier.PLAIN, mut plain)
        assert(grid.plain_ok(plain), "combat plain tier {action}")
        var different = false
        var i = 0
        while i < plain.cells.len {
            if !grid.same(plain.cells[i], previous.cells[i]) { different = true }
            i += 1
        }
        assert(different, "action {action} has a distinct glyph")
        previous = plain
        action += 1
    }
}

fn test_cb01b_sideways_silhouette_keeps_body_cells() {
    var t = tier.PLAIN
    while t <= tier.RICH {
        var f = 0
        while f < 4 {
            var pose = 0
            while pose < 4 {
                var g = grid.new(8, 12)
                art.draw_pose(mut g, t, 2, 4, f, 0, pose, 0)
                let body = sprites.glyph(t, sprites.SP_CUB_BODY, 0)
                assert(grid.same(grid.at(g, 3, 4), body), "first body cell facing {f} pose {pose}")
                assert(grid.same(grid.at(g, 3, 5), body), "second body cell facing {f} pose {pose}")
                assert(grid.at(g, 2, 4).cp != 32 && grid.at(g, 2, 5).cp != 32, "two ears")
                if t == tier.PLAIN { assert(grid.plain_ok(g), "plain posture") }
                pose += 1
            }
            f += 1
        }
        t += 1
    }
}

fn test_cb01b_each_foe_has_head_body_tail_tell_and_fade_on_both_tiers() {
    var t = tier.PLAIN
    while t <= tier.RICH {
        var kind = sim.WEASEL
        while kind <= sim.FOX {
            var phase = sim.HUNT
            while phase <= sim.PAUSE {
                var g = grid.new(10, 14)
                art.draw_foe(mut g, t, 4, 5, kind, phase, 64, -1)
                assert(grid.at(g, 4, 5).cp != 32 && grid.at(g, 4, 6).cp != 32, "two body cells")
                assert(grid.at(g, 3, 5).cp != 32 && grid.at(g, 5, 5).cp != 32, "head and tail")
                assert(
                    grid.at(g, 4, 5).fg != sprites.palette(t, sprites.C_FUR),
                    "foe colour not cub/trail",
                )
                if phase == sim.CROUCH {
                    assert(grid.at(g, 3, 5).cp == 95, "crouching head is tell")
                }
                if phase == sim.RETREAT { assert(grid.at(g, 5, 5).cp == 126, "fleeing tail") }
                if t == tier.PLAIN { assert(grid.plain_ok(g), "plain foe") }
                phase += 1
            }
            var fading = grid.new(10, 14)
            art.draw_foe(mut fading, t, 4, 5, kind, sim.HUNT, 64, 10)
            assert(grid.at(fading, 4, 5).cp == 46, "late fade")
            var gone = grid.new(10, 14)
            art.draw_foe(mut gone, t, 4, 5, kind, sim.HUNT, 64, sim.FOE_FADE_TICKS)
            assert(grid.at(gone, 4, 5).cp == 32, "fade ends")
            kind += 1
        }
        t += 1
    }
}
