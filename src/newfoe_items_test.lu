fn test_cb18_save_before_burn_entry_preserves_the_same_melt_boundary() {
    var s = sim.new(1, 80, 24)
    let _ = sim.give_item(mut s, pouch.ICE)
    let _ = sim.give_item(mut s, pouch.YARROW)
    let text = journey.encode(s)
    var loaded = journey.decode(text, 80, 24) else {
        assert(false, "real CUB7 core/items wrapper")
        sim.new(1, 80, 24)
    }
    for area in [forest.LARKMEADOW, forest.BURN] {
        let x = forest.spine(1, area, 20) * sim.FP
        sim.enter_area(mut s, area, x, 20 * sim.FP)
        sim.enter_area(mut loaded, area, x, 20 * sim.FP)
        assert(
            sim.item_count(s, pouch.ICE) == sim.item_count(loaded, pouch.ICE) &&
                sim.item_count(loaded, pouch.YARROW) == 1,
            "save/load does not move the boundary",
        )
    }
    assert(sim.item_count(loaded, pouch.ICE) == 0, "melt occurs on actual entry after loading")
}
