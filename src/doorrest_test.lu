//! member: false

use art
use forest
use grid
use sim

fn test_cb04d_foe_inside_view_is_not_culled_by_anchor_sight() {
    var s = sim.new(7, 80, 24)
    s.area = 1
    s.x = 0
    s.y = 80 * sim.FP
    var f = copy s.foes[0]
    f.x = 12 * sim.FP
    f.y = s.y
    f.health = 8
    f.kind = sim.WEASEL
    f.phase = sim.HUNT
    f.heading = 0
    s.foes = List[sim.Foe]()
    (mut s.foes).push(f)
    for t in [0, 1] {
        var expected = grid.new(24, 80)
        var actual = grid.new(24, 80)
        art.render(s, t, mut actual)
        art.draw_foe(
            mut expected,
            t,
            sim.screen_row(s),
            sim.screen_col(s) + 12,
            f.kind,
            f.phase,
            f.heading,
            -1,
        )
        var marks = 0
        var i = 0
        while i < expected.cells.len {
            let e = copy expected.cells[i]
            if e.cp != 32 {
                assert(
                    actual.cells[i].cp == e.cp && actual.cells[i].fg == e.fg,
                    "visible foe survives centre sight cull",
                )
                marks += 1
            }
            i += 1
        }
        assert(marks > 0, "nonempty foe witness")
    }
}

fn test_cb04d_doorway_edge_crosses_and_arrival_does_not_bounce() {
    var s = sim.new(7, 80, 24)
    s.gate_open = true
    s.area = 1
    s.x = 4 * sim.FP
    s.y = (forest.length(1) - 1) * sim.FP
    s.body_facing = 0
    assert(sim.transitions(mut s, 5 * sim.FP, s.y), "right edge of drawn shadow enters meadow")
    assert(s.area == 2 && s.y == 3 * sim.FP, "unchanged arrival placement")
    let x = s.x
    let y = s.y
    assert(!sim.transitions(mut s, x, y) && s.area == 2, "no bounce on arrival")
    assert(s.edge_ready, "arrival centre rearms without leaving the body shadow")
    s.y -= 1
    assert(sim.transitions(mut s, x, y) && s.area == 1, "first return cell crosses immediately")
}

fn test_cb04d_foe_is_clipped_at_each_view_edge_not_dropped_whole() {
    var s = sim.new(7, 80, 24)
    s.area = 1
    s.x = 0
    s.y = 0
    var f = copy s.foes[0]
    f.health = 8
    f.kind = sim.FOX
    f.phase = sim.HUNT
    f.heading = 64
    s.foes = List[sim.Foe]()
    (mut s.foes).push(f)
    for t in [0, 1] {
        for col in [-1, 0, 79, 80] {
            s.foes[0].x = (col - sim.screen_col(s)) * sim.FP
            s.foes[0].y = (10 - sim.screen_row(s)) * sim.FP
            var g = grid.new(24, 80)
            art.draw_foes(s, t, mut g)
            var expected = grid.new(24, 80)
            art.draw_foe(mut expected, t, 10, col, f.kind, f.phase, f.heading, -1)
            var count = 0
            var i = 0
            while i < g.cells.len {
                assert(
                    grid.same(g.cells[i], expected.cells[i]),
                    "edge clip retains each in-view sprite cell",
                )
                if g.cells[i].cp != 32 { count += 1 }
                i += 1
            }
            assert(count > 0, "partially visible footprint")
        }
    }
}

fn test_cb04d_shadow_to_shadow_motion_leaves_an_arrival_without_bouncing() {
    var s = sim.new(7, 80, 24)
    s.gate_open = true
    s.area = 2
    s.x = 0
    s.y = 3 * sim.FP
    s.body_facing = 0
    s.edge_ready = false
    let x = s.x
    let y = s.y
    s.x -= 1
    s.y += 1
    assert(
        !sim.transitions(mut s, x, y) && s.area == 2,
        "shadow-to-shadow cells are not new doorway entry",
    )
}
