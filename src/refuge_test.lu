//! member: false

use forest
use sim
use journey
use controls

fn test_cb03a_fifty_seed_den_census_rejects_an_empty_area() {
    var seed = 0
    while seed < 50 {
        var area = 0
        while area < 3 {
            assert(forest.den_count(area) >= 1, "every area has a den")
            var den = 0
            var prior = -1
            while den < forest.DEN_LIMIT {
                if forest.den_area(den) == area {
                    let (x, y) = forest.den_position(seed, den)
                    assert(
                        !forest.blocked(
                            seed,
                            80,
                            area,
                            sim.floor_div(x, sim.FP),
                            sim.floor_div(y, sim.FP),
                        ),
                        "den is on open ground",
                    )
                    assert(prior != y, "distinct refuges")
                    prior = y
                }
                den += 1
            }
            area += 1
        }
        seed += 1
    }
}

fn test_cb03a_each_new_den_rests_and_roundtrips_schema_three() {
    // cb05: of cb03a's refuges the last warm hollow (11) stays; 8, 9 and
    // 10 are landmarks now; the cold hearth (7) is the town's.
    for den in [7, 11] {
        var s = sim.new(4, 80, 24)
        s.gate_open = true
        let (x, y) = forest.den_position(s.seed, den)
        sim.enter_area(mut s, forest.den_area(den), x, y)
        s.health = 1
        var keys = List[int]()
        (mut keys).push(controls.KEY_REST)
        sim.step(mut s, keys)
        assert(s.den && s.last_den == den && s.health == sim.health_max(s.heart), "new den rests")
        let text = journey.encode(s)
        assert(text.starts_with("CUB 6\n"), "schema three from cb04")
        let restored = journey.decode(text, 80, 24) else {
            assert(false, "den save refused")
            return
        }
        assert(restored.last_den == den && restored.lit_dens == s.lit_dens, "new den roundtrip")
    }
}

fn check_clearings(first: int) {
    var seed = first
    while seed < first + 10 {
        assert(forest.switchbacks(seed) >= 4, "real turns of at least ninety degrees")
        assert(forest.path_length(seed, 1) > forest.LENGTH + 100, "not the straight meander")
        var n = 0
        while n < forest.CLEARINGS {
            let (x, y, radius) = forest.clearing(seed, n)
            assert(radius * 2 + 1 >= 7 && radius * 2 + 1 <= 12, "room width")
            assert(forest.clearing_reason(n) != "", "each room has a reason")
            var dy = -radius
            while dy <= radius {
                var dx = -radius
                while dx <= radius {
                    assert(!forest.blocked(seed, 80, 1, x + dx, y + dy), "open clearing")
                    dx += 1
                }
                dy += 1
            }
            n += 1
        }
        seed += 1
    }
}

fn test_cb03a_clearings_seeds_0_9() { check_clearings(0) }

fn test_cb03a_clearings_seeds_10_19() { check_clearings(10) }

fn test_cb03a_clearings_seeds_20_29() { check_clearings(20) }

fn test_cb03a_clearings_seeds_30_39() { check_clearings(30) }

fn test_cb03a_clearings_seeds_40_49() { check_clearings(40) }

fn test_cb03a_reserved_den_bits_are_not_valid_found_locations() {
    var s = sim.new(1, 80, 24)
    s.gate_open = true
    // Bit 12 is reserved (cb05: 7 is the cold hearth now).
    s.lit_dens = 4097
    var refused = false
    let _ = journey.decode(journey.encode(s), 80, 24) else { refused = true; sim.new(1, 80, 24) }
    assert(refused, "reserved id12 must not enter a save before it exists")
}
