//! member: false
//!
//! The three strikes, visible (cb07): the strike census's rows hold each
//! hit's drawn body against the standing body at every age. The peaks are
//! whole cells held for ticks a person sees; the third hit's head leaves
//! the body on both swings. The checked machine's step budget holds a
//! test here to one tier and two aims (east and north-east);
//! `--strike-census` holds all eight aims on the native build and exits 1
//! on a break (`combatproof.strike_row_breaks`).

use combatproof
use sim
use tier

fn aims() -> List[int] { [64, 32] }

fn tier_name(t: int) -> str { if t == tier.RICH then "rich" else "plain" }

/// Every age in `[from, to]` of `rows` is at the peak: `forward` at least
/// the bound, and `left` between `lo` and `hi` (hundredths of a cell).
fn held(
    rows: List[combatproof.StrikeRow],
    from: int,
    to: int,
    forward: int,
    lo: int,
    hi: int,
    what: str,
) {
    var age = from
    while age <= to {
        let r = copy rows[age]
        assert(r.age == age, "{what}: row {age} is age {r.age}")
        assert(r.forward >= forward, "{what}: age {age} forward {r.forward} under {forward}")
        assert(r.left >= lo && r.left <= hi, "{what}: age {age} left {r.left} outside {lo}..{hi}")
        age += 1
    }
}

fn hit_one(t: int) {
    for h in aims() {
        let rows = combatproof.strike_rows(h, 1, t)
        held(rows, 3, 6, 100, 100, 1000, "hit 1 aim {h} {tier_name(t)}")
        assert(rows[2].forward < 100, "hit 1 aim {h} {tier_name(t)}: the windup does not lunge")
    }
}

fn test_cb07_hit_one_lunges_a_cell_forward_left_held_four_ticks_plain() { hit_one(tier.PLAIN) }

fn test_cb07_hit_one_lunges_a_cell_forward_left_held_four_ticks_rich() { hit_one(tier.RICH) }

fn hit_two(t: int) {
    for h in aims() {
        let rows = combatproof.strike_rows(h, 2, t)
        held(rows, 3, 6, 100, -1000, -100, "hit 2 aim {h} {tier_name(t)}")
    }
}

fn test_cb07_hit_two_lunges_a_cell_forward_right_held_four_ticks_plain() { hit_two(tier.PLAIN) }

fn test_cb07_hit_two_lunges_a_cell_forward_right_held_four_ticks_rich() { hit_two(tier.RICH) }

fn hit_three(t: int) {
    for h in aims() {
        let rows = combatproof.strike_rows(h, 3, t)
        held(rows, 3, 8, 200, -1000, 1000, "hit 3 aim {h} {tier_name(t)}")
    }
}

fn test_cb07_hit_three_leaps_two_cells_forward_held_six_ticks_plain() { hit_three(tier.PLAIN) }

fn test_cb07_hit_three_leaps_two_cells_forward_held_six_ticks_rich() { hit_three(tier.RICH) }

fn shakes(t: int) {
    for h in aims() {
        let rows = combatproof.strike_rows(h, 3, t)
        for age in [5, 6, 9, 10] {
            assert(rows[age].shake == -1, "hit 3 aim {h} {tier_name(t)}: age {age} shakes left")
        }
        for age in [7, 8, 11, 12] {
            assert(rows[age].shake == 1, "hit 3 aim {h} {tier_name(t)}: age {age} shakes right")
        }
        var age = 5
        while age <= 12 {
            // The head drawn a cell out of the body: the shaken drawing
            // paints cells the same drawing with its head still does not.
            assert(
                rows[age].out >= 1,
                "hit 3 aim {h} {tier_name(t)}: age {age} paints {rows[age].out} cells beyond the body",
            )
            age += 1
        }
        assert(rows[4].shake == 0 && rows[13].shake == 0, "the shake is ages 5-12")
        assert(
            rows[4].out == 0 && rows[13].out == 0 && rows[3].span > 0,
            "no head out without a shake",
        )
    }
}

fn test_cb07_hit_three_shakes_its_head_two_full_swings_each_side_two_ticks_plain() {
    shakes(tier.PLAIN)
}

fn test_cb07_hit_three_shakes_its_head_two_full_swings_each_side_two_ticks_rich() {
    shakes(tier.RICH)
}

fn eases(t: int, hit: int) {
    let rows = combatproof.strike_rows(64, hit, t)
    let last = copy rows[rows.len - 1]
    assert(
        last.changed == 0 && last.forward == 0 && last.left == 0,
        "hit {hit} {tier_name(t)}: the last age stands at the commitment point",
    )
    // The ease is monotone: no age after the hold is further forward
    // than the one before it.
    var age = sim.strike_hold(hit) + 1
    while age < rows.len {
        assert(
            rows[age].forward <= rows[age - 1].forward + 10,
            "hit {hit} {tier_name(t)}: age {age} eases back",
        )
        age += 1
    }
}

fn test_cb07_hit_one_eases_back_to_the_commitment_point_plain() { eases(tier.PLAIN, 1) }

fn test_cb07_hit_two_eases_back_to_the_commitment_point_plain() { eases(tier.PLAIN, 2) }

fn test_cb07_hit_three_eases_back_to_the_commitment_point_plain() { eases(tier.PLAIN, 3) }

fn test_cb07_hit_one_eases_back_to_the_commitment_point_rich() { eases(tier.RICH, 1) }

fn test_cb07_hit_two_eases_back_to_the_commitment_point_rich() { eases(tier.RICH, 2) }

fn test_cb07_hit_three_eases_back_to_the_commitment_point_rich() { eases(tier.RICH, 3) }

fn breaks(hit: int) {
    for r in combatproof.strike_rows(64, hit, tier.RICH) {
        assert(!combatproof.strike_row_breaks(hit, r), "hit {hit} age {r.age} breaks the contract")
    }
}

fn test_cb07_no_row_of_hit_one_breaks_the_contract_east_rich() { breaks(1) }

fn test_cb07_no_row_of_hit_two_breaks_the_contract_east_rich() { breaks(2) }

fn test_cb07_no_row_of_hit_three_breaks_the_contract_east_rich() { breaks(3) }

fn test_cb07_strike_offsets_are_whole_cells_at_the_peak_and_zero_at_the_end() {
    let (f1, s1) = sim.strike_offset(1, 3)
    let (f2, s2) = sim.strike_offset(2, 6)
    let (f3, s3) = sim.strike_offset(3, 8)
    assert(f1 == sim.FP && s1 == 0 - sim.FP, "hit 1 a cell forward, a cell left")
    assert(f2 == sim.FP && s2 == sim.FP, "hit 2 a cell forward, a cell right")
    assert(f3 == 2 * sim.FP && s3 == 0, "hit 3 two cells forward")
    for hit in [1, 2, 3] {
        let (fw, sd) = sim.strike_offset(hit, 2)
        assert(fw == 0 && sd == 0, "the windup holds still")
        let (fe, se) = sim.strike_offset(hit, sim.combo_duration(hit) - 1)
        assert(fe == 0 && se == 0, "the last age is home")
        let (fa, _) = sim.strike_offset(hit, sim.strike_hold(hit) + 1)
        assert(
            fa > 0 && fa < (if hit == 3 then 2 * sim.FP else sim.FP),
            "the ease begins after the hold",
        )
    }
}

fn test_cb07_costs_durations_and_the_active_window_are_cb04bs() {
    assert(sim.combo_cost(1) == 12 && sim.combo_cost(2) == 14 && sim.combo_cost(3) == 18, "costs")
    assert(
        sim.combo_duration(1) == 11 && sim.combo_duration(2) == 13 && sim.combo_duration(3) == 17,
        "durations",
    )
}
