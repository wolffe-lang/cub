//! town — Cinderwick (cb05, R-cb05-1 A): the village on the Ashwater
//! above the Shingle, burnt the night the fire came and never left. A lane
//! runs through it (the route); either side, plots of ruined houses with a
//! one-cell passage between each pair, and behind every house a walled
//! yard the passage leads to; a square in the middle with the cold hearth;
//! embers that never went out in the verges and the yards; the dark wood
//! closed round the back walls. The smoke never lifted: it is always the
//! night of the fire here (the night keyframe is `art`'s).
//!
//! Every answer is a pure function of the seed and a cell: a plot is found
//! by division, so a frame's cells cost a few hashes each and no table is
//! built. The lane's centre is the town's own (`lane`), so `forest.spine`
//! can delegate to it without a cycle.

use terrain
use world

/// Fixed-point units a cell.
pub const FP: int = 256

/// The town's length along the route, cells (R-cb05-2 A).
pub const LENGTH: int = 288

/// The first plot's top wall row.
pub const FIRST: int = 20

/// Rows from one plot's top wall to the next: a thirteen-row house (its
/// walls on the first and last) and the one-cell passage after it.
pub const PITCH: int = 14

/// Plots a side: rows 20..272.
pub const PLOTS: int = 18

/// The square: two plots with no houses, the cold hearth in the middle.
pub const SQUARE_PLOT: int = 7

/// The lane's half width, cells.
pub const LANE_HALF: int = 4

/// Ash between the lane's nearest edge and a house's near wall, cells.
pub const VERGE: int = 4

/// The farthest a yard's back wall stands from the lane's centre: the
/// lane, the verge, the lane's reach across a plot (up to six cells),
/// the widest house, the deepest yard and the wall.
pub const EXTENT: int = LANE_HALF + VERGE + 6 + 1 + 11 + 9 + 1

/// How far the Ashen roam past the last walls, rows (the town's edge).
pub const EDGE_ROWS: int = 6

/// The passage between two houses is this many cells wide: one.
pub const PASSAGE: int = 1

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// The lane's anchor at plot `k`'s middle row, fixed point: the street
/// weaves three to six cells to alternate sides of the plots, three
/// beside the road in and out, nothing beyond them (the thorn throat at
/// row 0 and the way on stand at x = 0).
fn lane_anchor_fp(seed: int, k: int) -> int {
    if k <= -2 || k > PLOTS { return 0 }
    let sign = if (k % 2 + 2) % 2 == 0 then 1 else -1
    if k == -1 || k == PLOTS { return sign * 3 * FP }
    sign * (3 + world.hash(seed, 36, k + 2, 4)) * FP
}

/// Rows of easing at each end of a segment between two anchors.
const EASE: int = 2

/// The blend from one anchor to the next at row `r` of the pitch, in
/// `[0, FP]`: a short ease out of the anchor, a straight slant, a short
/// ease into the next (a smoothstep lies flat for four rows about every
/// anchor, a straight run of nine cells; this one for two).
fn blend(r: int) -> int {
    let run = PITCH - EASE
    if r <= EASE { return FP * r * r / (2 * EASE * run) }
    if r >= PITCH - EASE {
        let left = PITCH - r
        return FP - FP * left * left / (2 * EASE * run)
    }
    FP * (2 * r - EASE) / (2 * run)
}

/// The lane's centre at local row `at`, fixed point: the blend between
/// the anchors at the plots' middle rows, monotone between two anchors,
/// so its reach toward a house over a plot's rows is read at the plot's
/// end rows or its middle (`lane_edge`).
pub fn lane_fp(seed: int, at: int) -> int {
    let rel = at - (FIRST + PITCH / 2)
    var k = rel / PITCH
    var r = rel % PITCH
    if r < 0 { k -= 1; r += PITCH }
    let a = lane_anchor_fp(seed, k)
    let b = lane_anchor_fp(seed, k + 1)
    a + (b - a) / FP * blend(r)
}

/// The lane's centre at local row `at`, cells.
pub fn lane(seed: int, at: int) -> int {
    terrain.floor_cells(lane_fp(seed, at))
}

/// The lane's farthest centre toward `side` over plot `k`'s rows (its
/// walls and the passage after it): at the plot's first row, its middle
/// (an anchor) or its last, the lane being monotone between anchors.
fn lane_edge(seed: int, side: int, k: int) -> int {
    // The anchors alternate sides: the plot's own anchor is the reach on
    // its side; on the other side the lane is farthest at one of the
    // plot's end rows.
    let sign = if k % 2 == 0 then 1 else -1
    if side == sign { return lane(seed, top(k) + PITCH / 2) }
    let a = lane(seed, top(k))
    let b = lane(seed, bottom(k) + 1)
    if side * (b - a) > 0 then b else a
}

/// The plot a local row lies in (its house's rows and the passage after
/// it), or -1 on the road before the first plot and after the last.
pub fn plot(at: int) -> int {
    if at < FIRST { return -1 }
    let k = (at - FIRST) / PITCH
    if k >= PLOTS then -1 else k
}

/// Whether plot `k` is the square (no houses, open ash, the hearth).
pub fn square(k: int) -> bool {
    k == SQUARE_PLOT || k == SQUARE_PLOT + 1
}

/// A plot's top wall row.
pub fn top(k: int) -> int {
    FIRST + k * PITCH
}

/// A plot's bottom wall row (the passage is the row after it).
pub fn bottom(k: int) -> int {
    top(k) + PITCH - 2
}

/// The house on side `side` (-1 west, 1 east) of plot `k`: its near wall's
/// column (toward the lane), its far wall's, measured from the lane's
/// farthest reach toward it over the plot's rows so the whole house keeps
/// the verge (the verge widens where the street bends away).
pub fn house_x(seed: int, side: int, k: int) -> (int, int) {
    let c = lane_edge(seed, side, k)
    let near = c + side * (LANE_HALF + VERGE + 1)
    let width = 8 + world.hash(seed, 401 + side, k, 4)
    (near, near + side * (width - 1))
}

/// The yard behind a house: the column just past the far wall to the
/// yard's last open column, and the back wall's column after it.
pub fn yard_x(seed: int, side: int, k: int) -> (int, int, int) {
    let (_, far) = house_x(seed, side, k)
    yard_behind(seed, side, k, far)
}

/// `yard_x` with the house's far wall already known (`kind` evaluates each
/// house once a cell).
fn yard_behind(seed: int, side: int, k: int, far: int) -> (int, int, int) {
    let depth = 6 + world.hash(seed, 411 + side, k, 4)
    (far + side, far + side * depth, far + side * (depth + 1))
}

/// The house's door: a two-row gap in its near wall, rows `top+d..top+d+1`.
pub fn door_row(seed: int, side: int, k: int) -> int {
    top(k) + 3 + world.hash(seed, 421 + side, k, 7)
}

/// The yard's gap: a two-cell opening in its top wall (0) or bottom wall
/// (1), at this many cells past the house's far wall.
pub fn yard_gap(seed: int, side: int, k: int) -> (int, int) {
    // The first plot's yard opens on the passage after it, the last's on
    // the passage before it: beyond them lies the road's closed wood.
    let which = if k == 0 then 1 else if k == PLOTS - 1 then 0 else world.hash(seed, 431 + side, k, 2)
    (which, 2 + world.hash(seed, 441 + side, k, 3))
}

/// Whether a wall cell has fallen (a ruin's gaps: one cell in nine, never
/// a corner).
fn fallen(seed: int, x: int, at: int) -> bool {
    world.hash(seed + 451, x, at, 9) == 0
}

/// The ember of plot `k` on `side`, if it has one (local cells), else
/// (-1000, -1000): in the verge by the lane for the odd plots, in the yard
/// for the even ones, never in the square's plots (the square has its own).
pub fn ember(seed: int, side: int, k: int) -> (int, int) {
    if k < 0 || k >= PLOTS || square(k) { return (-1000, -1000) }
    if world.hash(seed, 461 + side, k, 100) >= 42 { return (-1000, -1000) }
    let at = top(k) + 2 + world.hash(seed, 471 + side, k, 9)
    if k % 2 == 1 {
        let (near, _) = house_x(seed, side, k)
        return (near - side * (1 + world.hash(seed, 481 + side, k, 2)), at)
    }
    let (yin, yout, _) = yard_x(seed, side, k)
    let span = abs(yout - yin)
    (yin + side * world.hash(seed, 491 + side, k, span + 1), at)
}

/// The square's two embers and the hearth: the hearth off the lane on the
/// seeded side at the square's middle row; an ember on each side of the
/// lane a few rows off.
pub fn hearth(seed: int) -> (int, int) {
    let at = top(SQUARE_PLOT) + PITCH - 2 + world.hash(seed, 501, 0, 4)
    let side = if world.hash(seed, 502, 0, 2) == 0 then -1 else 1
    (lane(seed, at) + side * 9, at)
}

/// The square's ember on `side`.
pub fn square_ember(seed: int, side: int) -> (int, int) {
    let at = top(SQUARE_PLOT) + 3 + world.hash(seed, 511 + side, 0, 20)
    (lane(seed, at) + side * (LANE_HALF + 2 + world.hash(seed, 521 + side, 0, 6)), at)
}

/// The ember nearest a local cell among the plots around it (and the
/// square's), reached from the lane (the verges' and the square's, never
/// a yard's behind its walls), or the cell itself when none is within two
/// plots: where a lane's Ashen goes to stand when it hears nothing.
pub fn nearest_ember(seed: int, x: int, at: int) -> (int, int) {
    let k = plot(at)
    var bx = x
    var by = at
    var best = 1000000
    var j = k - 2
    while j <= k + 2 {
        for side in [-1, 1] {
            if j >= 0 && j < PLOTS {
                let (ex, ey) = ember(seed, side, j)
                let d = (ex - x) * (ex - x) + (ey - at) * (ey - at)
                if ex > -1000 && j % 2 == 1 && d < best { best = d; bx = ex; by = ey }
                if square(j) {
                    let (sx, sy) = square_ember(seed, side)
                    let e = (sx - x) * (sx - x) + (sy - at) * (sy - at)
                    if e < best { best = e; bx = sx; by = sy }
                }
            }
        }
        j += 1
    }
    (bx, by)
}

/// Whether local cell `(x, at)` is an ember.
pub fn is_ember(seed: int, x: int, at: int) -> bool {
    let k = plot(at)
    if k < 0 { return false }
    for side in [-1, 1] {
        let (ex, ey) = ember(seed, side, k)
        if ex == x && ey == at { return true }
        if square(k) {
            let (sx, sy) = square_ember(seed, side)
            if sx == x && sy == at { return true }
        }
    }
    false
}

/// The ember light at a cell: 2 within three columns (a row and a half) of
/// an ember, 1 within six, else 0. Cells are twice as tall as wide, so a
/// row counts double.
pub fn light(seed: int, x: int, at: int) -> int {
    let k = plot(at)
    var best = 0
    var j = k - 1
    while j <= k + 1 {
        for side in [-1, 1] {
            var ex = -1000
            var ey = -1000
            if j >= 0 && j < PLOTS {
                let (px, py) = ember(seed, side, j)
                ex = px
                ey = py
                if square(j) {
                    let (sx, sy) = square_ember(seed, side)
                    let d = (sx - x) * (sx - x) + 4 * (sy - at) * (sy - at)
                    if d <= 9 { best = 2 } else if d <= 36 && best < 1 { best = 1 }
                }
            }
            let d = (ex - x) * (ex - x) + 4 * (ey - at) * (ey - at)
            if d <= 9 { best = 2 } else if d <= 36 && best < 1 { best = 1 }
        }
        j += 1
    }
    best
}

/// Whether the yard cache `cache` (0..3) lies in plot `k` on `side`: four
/// yards hold caches, two a side, alternating, in plots 2, 5, 11 and 15.
pub fn cache_plot(cache: int) -> (int, int) {
    match cache {
        0 => (-1, 2),
        1 => (1, 5),
        2 => (-1, 11),
        _ => (1, 15),
    }
}

/// A yard cache's local cell: the middle of its yard.
pub fn cache(seed: int, k: int) -> (int, int) {
    let (side, p) = cache_plot(k)
    let (yin, yout, _) = yard_x(seed, side, p)
    ((yin + yout) / 2, top(p) + PITCH / 2)
}

/// An old scent mark in a yard without a cache (two of them, the
/// dead ends that reward): local cells.
pub fn scent_mark(seed: int, k: int) -> (int, int) {
    let side = if k == 0 then 1 else -1
    let p = if k == 0 then 9 else 13
    let (yin, yout, _) = yard_x(seed, side, p)
    ((yin + yout) / 2 + side, top(p) + 4 + world.hash(seed, 531, k, 5))
}

/// Whether a local cell is inside the lane's carved width (the route).
pub fn on_lane(seed: int, x: int, at: int) -> bool {
    abs(x - lane(seed, at)) <= LANE_HALF
}

/// Whether local cell `(x, at)` lies within the town's walls: the Ashen's
/// bound (they do not chase past the town's edge): between the road's
/// ends and inside the back walls' reach.
pub fn bound(seed: int, x: int, at: int) -> bool {
    at >= FIRST - EDGE_ROWS && at <= top(PLOTS - 1) + PITCH + EDGE_ROWS &&
        abs(x - lane(seed, at)) <= EXTENT
}

/// The ground of local cell `(x, at)` off the lane: the walls, the ash, the
/// embers, and beyond the back walls the closed wood (`terrain.DARK` with
/// trunks). The lane itself is carved by `forest` before this is asked.
pub fn kind(seed: int, x: int, at: int) -> int {
    let c = lane(seed, at)
    let side = if x < c then -1 else 1
    let off = abs(x - c)
    if is_ember(seed, x, at) { return terrain.EMBER }
    let k = plot(at)
    if k < 0 {
        // The road in and out: a verge of ash, then the wood.
        if off <= LANE_HALF + VERGE { return terrain.ASH }
        return closed(seed, x, at)
    }
    if square(k) {
        // The square: open ash to the back walls' line, rubble here and
        // there (never about the hearth), the wood beyond.
        if off > EXTENT - 2 { return closed(seed, x, at) }
        let (hx, hy) = hearth(seed)
        let by_hearth = abs(x - hx) <= 5 && abs(at - hy) <= 3
        if !by_hearth && world.hash(seed + 541, x, at, 23) == 0 && off > LANE_HALF + 2 {
            return terrain.WALL
        }
        return terrain.ASH
    }
    let (near, far) = house_x(seed, side, k)
    let (yin, yout, back) = yard_behind(seed, side, k, far)
    let t = top(k)
    let b = bottom(k)
    if at == b + 1 {
        // The passage between this house and the next, and the corridor
        // behind it between the yards: one cell wide, ash, to the farther
        // of the two yards' back walls (the next yard's gap may lie past
        // this one's wall).
        var reach = abs(back - c)
        if k + 1 < PLOTS && !square(k + 1) {
            let (_, _, next_back) = yard_x(seed, side, k + 1)
            if abs(next_back - c) > reach { reach = abs(next_back - c) }
        }
        return if off <= reach then terrain.ASH else closed(seed, x, at)
    }
    if off < abs(near - c) { return terrain.ASH }
    if off > abs(back - c) { return closed(seed, x, at) }
    let on_x = side * (x - near) >= 0 && side * (far - x) >= 0
    let in_yard = side * (x - yin) >= 0 && side * (yout - x) >= 0
    // The house's walls: the near wall with its door, the far wall, the top
    // and bottom; a ruin's fallen cells.
    if on_x {
        let wall = x == near || x == far || at == t || at == b
        if wall {
            let d = door_row(seed, side, k)
            if x == near && (at == d || at == d + 1) { return terrain.ASH }
            // A corner stands; the far wall stands (the yard is reached by
            // its passage, never through the house); elsewhere a ruin's
            // fallen cell is another way in.
            let corner = (x == near || x == far) && (at == t || at == b)
            if corner || x == far { return terrain.WALL }
            return if fallen(seed, x, at) then terrain.ASH else terrain.WALL
        }
        return terrain.ASH
    }
    if in_yard {
        // The yard's walls continue the house's top and bottom walls, with
        // one two-cell gap into the corridor; the back wall closes it.
        if at == t || at == b {
            let (which, past) = yard_gap(seed, side, k)
            let gap_row = if which == 0 then t else b
            let gx = far + side * past
            if at == gap_row && (x == gx || x == gx + side) { return terrain.ASH }
            if fallen(seed, x, at) { return terrain.ASH }
            return terrain.WALL
        }
        return terrain.ASH
    }
    if x == back {
        return if at == t || at == b then terrain.WALL else if fallen(seed, x, at) then terrain.ASH else terrain.WALL
    }
    terrain.ASH
}

/// The closed wood beyond the walls: the forest's own texture, every cell
/// solid.
fn closed(seed: int, x: int, at: int) -> int {
    if world.hash(seed + 6 * 79, x, at, 100) < 16 then terrain.TRUNK else terrain.DARK
}
