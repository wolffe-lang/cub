//! member: false
//!
//! cub — a cub, separated from its pack, finds its way home through
//! Thornmere. The entry: the command line, the live loop (one wait a tick
//! on the terminal and the signals, the simulation stepped once a tick,
//! the screen diffed once a frame), the headless run that writes frames
//! for the goldens, the replay and record paths, and the tools the pty
//! runner and the art study need (`--apply`, `--art-study`,
//! `--probe-glyphs`, `--selftest`).
//!
//! Track 19 of the wolffe-lang planning repo, the cub track (ruling #130).
//! cb00 is the scaffold on the lair engine (M-CB0): the Shingle, a cub
//! that walks and turns, the camera on it. The moves, the foes, the dens
//! and the areas are cb01's and cb02's.

use art
use census
use coast
use forest
use journey
use denmemory
use measure
use motionproof
use look
use clock
use controls
use cross
use combatproof
use demo
use denproof
use doorproof
use fight
use ghost
use grid
use glow
use headless
use input
use probe
use pathaudit
use wide
use props
use proof
use replay
use score
use sim
use sound
use sprites
use std.env
use std.fs
use term
use tier
use walker

/// What the command line asked for.
struct Options {
    headless: bool,
    seed: int,
    script: str,
    frames: int,
    every: int,
    from_tick: int,
    tier: int,
    cols: int,
    rows: int,
    dump: str,
    replay_path: str,
    record_path: str,
    trap_at: int,
    ticks: int,
    truecolor: int,
    apply_path: str,
    art_study: bool,
    probe_glyphs: bool,
    selftest: bool,
    trace: bool,
    help: bool,
    version: bool,
    bench: bool,
    ghost_dir: str,
    save_path: str,
    save_cut: bool,
    save_delay: int,
    world_audit: bool,
    make_proof: str,
    mute: bool,
    sound_dir: str,
    score_render: str,
    score_wav: str,
    score_replay: str,
    score_out: str,
    score_list: bool,
    no_title: bool,
    pace: int,
    combat_witness: bool,
}

fn usage_text() -> str {
    "cub — a cub finds its way home through Thornmere\n\n" +
        "  cub [--seed N] [--tier rich|plain] [--record FILE]\n" +
        "  cub --replay FILE                 reproduce a recorded run\n" +
        "  cub --headless --seed N [--script FILE] --frames N [--every K] [--from T]\n" +
        "      --tier T --size WxH --dump DIR\n" +
        "  cub --apply CAPTURE --size WxH    a captured byte stream as a frame\n" +
        "  cub --art-study --dump DIR        the sprite sheets, both tiers\n" +
        "  cub --strike-census              every strike at every aim, both tiers: the drawn body against standing\n" +
        "  cub --hud-census                  the HUD census: every painted cell a bar, a label or a digit\n" +
        "  cub --look-audit                  fifty-seed world sprite census\n" +
        "  cub --paths-audit / --doorways-audit / --foes-audit  route and clipping censuses\n" +
        "  cub --probe-glyphs                measure the rich glyphs' widths here\n" +
        "  cub --selftest                    the decoder table and the diff property, on THIS binary\n\n" +
        "  keys: arrows walk (the cub turns at its turn rate), Shift+arrow sneaks,\n" +
        "        Space bite/combo, x forward lunge, s heavy, z parry, c roll, Ctrl+arrow sprint, Tab lock, Esc release, q quit,\n" +
        "        w water, r rest; at the den arrows allocate, Enter/Space confirms, Esc discards\n" +
        "  --mute                            no music (CUB_SOUND=0 too; m toggles it in play)\n" +
        "  --sound-dir DIR                   where the rendered WAVs go (default ~/.cub/sound)\n" +
        "  --score-list                      every part with its length\n" +
        "  --score-render NAME OUT           a part as raw stereo S16_LE PCM, its own length\n" +
        "  --score-wav NAME OUT              the same PCM in a WAV\n" +
        "  --score-replay OUT                the cue schedule through the mixer, 180 ticks of PCM\n" +
        "  --bench                           render/diff timings for the performance gate\n" +
        "  --save PATH                       journey file (live default ~/.cub/save)\n" +
        "  --save-cut                        test a cut write; previous save stays intact\n" +
        "  --save-delay N                    ticks between staging and replacement (test witness)\n" +
        "  --make-world-proof DIR             generate real-key world test scripts\n" +
        "  --feel-audit / --chase-audit / --mouth-audit  den, path and real-key pursuit censuses\n" +
        "  --den-spacing / --foe-census / --bends-audit / --spurs-audit / --gen-bench  the wide forest's censuses (cb05)\n" +
        "  --crossing-census / --hitbox-audit  Cinderwick crossed by a scripted cub; a bite from eight aims (cb05)\n" +
        "  --world-audit                     graph/density census over seeds 0..49\n" +
        "  --den-census                      shortest den paths and both faces of every thorn gate\n" +
        "  --make-den-proof DIR              regional rest, healing and checkpoint scripts\n" +
        "  --measure [SCRIPT...]             pace, wag, chase, path styles, body census (last flag)\n" +
        "  --body-audit [SCRIPT...]          the body census over 50 seeds x 2 sizes, a swarm each\n" +
        "  --boss-census                     the fairness census: every boss fought in 50 seeds x 2 sizes\n" +
        "  --ghost-dir DIR                   the death archives (live default ~/.cub/ghosts): read for the\n" +
        "                                    ghosts, written on a death; headless, both\n" +
        "  --pace N                          debug walk/sprint speed,25..300 percent of default\n" +
        "  --no-title                        begin in play, without the title card\n" +
        "  --truecolor / --no-truecolor      override COLORTERM\n" +
        "  --ticks N                         quit after N ticks\n" +
        "  --trace                           one line a tick on standard error: the bytes read, the keys\n" +
        "                                    applied, the heading and the position\n"
}

fn options_default() -> Options {
    Options {
        headless: false,
        seed: 1,
        script: "",
        frames: 60,
        every: 1,
        from_tick: 0,
        tier: -1,
        cols: 0,
        rows: 0,
        dump: "",
        replay_path: "",
        record_path: "",
        trap_at: 0,
        ticks: 0,
        truecolor: -1,
        apply_path: "",
        art_study: false,
        probe_glyphs: false,
        selftest: false,
        trace: false,
        help: false,
        version: false,
        bench: false,
        ghost_dir: "",
        save_path: "",
        save_cut: false,
        save_delay: 1,
        world_audit: false,
        make_proof: "",
        mute: false,
        sound_dir: "",
        score_render: "",
        score_wav: "",
        score_replay: "",
        score_out: "",
        score_list: false,
        no_title: false,
        pace: 100,
        combat_witness: false,
    }
}

fn parse_args(args: List[str]) -> Options ! {usage, parse} {
    var o = options_default()
    var i = 0
    while i < args.len {
        let a = args[i]
        let more = i + 1 < args.len
        let two = i + 2 < args.len
        if a == "--combat-witness" {
            o.combat_witness = true
        } else if more && a == "--pace" {
            i += 1
            o.pace = args[i].to_int()?
            if o.pace < 25 || o.pace > 300 { return usage }
        } else if more && a == "--make-world-proof" {
            i += 1
            o.make_proof = args[i]
        } else if a == "--mute" {
            o.mute = true
        } else if a == "--score-list" {
            o.score_list = true
        } else if more && a == "--sound-dir" {
            i += 1
            o.sound_dir = args[i]
        } else if more && a == "--score-replay" {
            i += 1
            o.score_replay = args[i]
        } else if two && a == "--score-render" {
            o.score_render = args[i + 1]
            o.score_out = args[i + 2]
            i += 2
        } else if two && a == "--score-wav" {
            o.score_wav = args[i + 1]
            o.score_out = args[i + 2]
            i += 2
        } else if a == "--world-audit" {
            o.world_audit = true
        } else if a == "--no-title" {
            o.no_title = true
        } else if a == "--save-cut" {
            o.save_cut = true
        } else if more && a == "--save" {
            i += 1
            o.save_path = args[i]
        } else if more && a == "--save-delay" {
            i += 1
            o.save_delay = args[i].to_int()?
            if o.save_delay < 1 || o.save_delay > 300 { return usage }
        } else if a == "--headless" {
            o.headless = true
        } else if a == "--bench" {
            o.bench = true
        } else if more && a == "--ghost-dir" {
            i += 1
            o.ghost_dir = args[i]
        } else if a == "--help" || a == "-h" {
            o.help = true
        } else if a == "--version" {
            o.version = true
        } else if a == "--art-study" {
            o.art_study = true
        } else if a == "--probe-glyphs" {
            o.probe_glyphs = true
        } else if a == "--selftest" {
            o.selftest = true
        } else if a == "--trace" {
            o.trace = true
        } else if a == "--truecolor" {
            o.truecolor = 1
        } else if a == "--no-truecolor" {
            o.truecolor = 0
        } else if more && a == "--seed" {
            i += 1
            o.seed = args[i].to_int()?
        } else if more && a == "--frames" {
            i += 1
            o.frames = args[i].to_int()?
        } else if more && a == "--every" {
            i += 1
            o.every = args[i].to_int()?
        } else if more && a == "--from" {
            i += 1
            o.from_tick = args[i].to_int()?
        } else if more && a == "--trap-at" {
            i += 1
            o.trap_at = args[i].to_int()?
        } else if more && a == "--ticks" {
            i += 1
            o.ticks = args[i].to_int()?
        } else if more && a == "--tier" {
            i += 1
            o.tier = tier.of_name(args[i]) else |_| {
                return usage
            }
        } else if more && a == "--size" {
            i += 1
            let (c, r) = replay.parse_size(args[i]) else |_| {
                return usage
            }
            o.cols = c
            o.rows = r
        } else if more && a == "--script" {
            i += 1
            o.script = args[i]
        } else if more && a == "--dump" {
            i += 1
            o.dump = args[i]
        } else if more && a == "--replay" {
            i += 1
            o.replay_path = args[i]
        } else if more && a == "--record" {
            i += 1
            o.record_path = args[i]
        } else if more && a == "--apply" {
            i += 1
            o.apply_path = args[i]
        } else {
            return usage
        }
        i += 1
    }
    if o.frames < 1 ||
        o.every < 1 ||
        o.from_tick < 0 ||
        o.seed < -1000000000 ||
        o.seed > 1000000000 {
        return usage
    }
    o
}

/// The replay a run follows: the file named by `--script` or `--replay`,
/// or an empty one from the options. Flags given on the command line
/// override the file's header.
fn load_replay(o: Options, want_cols: int, want_rows: int) -> replay.Replay ! {parse, io} {
    let path = if o.script != "" then o.script else o.replay_path
    var r = replay.new(o.seed, if o.tier < 0 then tier.RICH else o.tier, want_cols, want_rows)
    if path != "" {
        let text = fs.read_text(path) else |_| {
            return io
        }
        r = replay.from_text(text, controls.vocab())?
        if o.cols > 0 {
            r.cols = o.cols
            r.rows = o.rows
        }
        if o.tier >= 0 {
            r.tier = o.tier
        }
    }
    r
}

fn seed_given(args: List[str]) -> bool {
    for a in args {
        if a == "--seed" {
            return true
        }
    }
    false
}

/// The headless run: `frames` ticks from the script, every `every`th
/// frame from tick `from_tick` on and the final one written to `dump` as
/// cell text and styles (the engine's formats).
fn run_headless(o: Options, args: List[str]) -> int {
    var r = load_replay(
        o,
        if o.cols > 0 then o.cols else 80,
        if o.rows > 0 then o.rows else 24,
    ) else |e| {
        eprint("cub: the script could not be read ({e})")
        return 2
    }
    if seed_given(args) {
        r.seed = o.seed
    }
    if o.dump == "" {
        eprint("cub: --headless needs --dump DIR")
        return 2
    }
    fs.create_dir_all(o.dump) else |_| {
        eprint("cub: cannot create {o.dump}")
        return 2
    }
    var s = if o.save_path != "" {
        journey.load(o.save_path, r.seed, r.cols, r.rows) else |e| { eprint("cub: {e}"); return 2 }
    } else {
        sim.new(r.seed, r.cols, r.rows)
    }
    if seed_given(args) &&
        (
            s.seed != o.seed ||
                replay.args_at(r, 0, controls.EV_JOURNEY) != 0 &&
                    replay.args_at(r, 0, controls.EV_SAVED) != o.seed
        ) {
        eprint("cub: save_seed_conflict: a saved journey keeps its seed")
        return 2
    }
    s = replay_initial(r, s) else |e| { eprint("cub: {e}"); return 2 }
    s.pace_percent = o.pace
    if o.script == "" && o.replay_path == "" { sim.opening(mut s) }
    // The ghosts a script shows: the flag's directory, or the one a case
    // names on a `# ghost-dir DIR` line (read only, never written: the
    // goldens' cases carry committed deaths).
    let shown_dir = if o.ghost_dir != "" then o.ghost_dir else script_ghost_dir(o)
    var extra = art.extra_none()
    extra.ghosts = ghost.load(shown_dir, s.seed)
    var history = ghost.history()
    let demo_r = demo.load()
    var demo_tick = 0
    var g = grid.new(r.rows, r.cols)
    var keys = List[int]()
    var k = 0
    var archived = s.deaths
    while k < o.frames {
        (mut keys).reset()
        let (c, rows, health) = replay.at(r, k, mut keys)
        if c > 0 {
            sim.resize(mut s, c, rows)
            g = grid.new(rows, c)
        }
        replay_numbers(mut s, health, replay.args_at(r, k, controls.EV_SCENT))
        replay_events(mut s, r, k)
        sim.step(mut s, keys)
        ghost.record(mut history, s.tick, frame_of(s))
        demo_step(mut extra, s, demo_r, mut demo_tick)
        if s.deaths > archived {
            archived = s.deaths
            if o.ghost_dir != "" {
                write_ghost(r, s, history, o.ghost_dir) else |_| { return 2 }
                extra.ghosts = ghost.load(o.ghost_dir, s.seed)
            }
        }
        if o.trace { eprint(state_text(s)) }
        if k + 1 >= o.from_tick && (k + 1) % o.every == 0 && k + 1 < o.frames {
            art.render_with(s, extra, r.tier, mut g)
            headless.write_frame(o.dump, "frame-{headless.pad4(k + 1)}", g) else |_| {
                eprint("cub: cannot write into {o.dump}")
                return 2
            }
        }
        k += 1
    }
    if o.save_path != "" {
        journey.prepare(o.save_path, s, o.save_cut) else |e| { eprint("cub: {e}"); return 2 }
        journey.commit(o.save_path) else |e| { eprint("cub: {e}"); return 2 }
        s.save_status = 2
    }
    // The last frame is always `final` (the pty runner compares it).
    art.render_with(s, extra, r.tier, mut g)
    headless.write_frame(o.dump, "final", g) else |_| {
        eprint("cub: cannot write into {o.dump}")
        return 2
    }
    fs.write_text(o.dump + "/final.state", state_text(s)) else |_| { return 2 }
    0
}

/// `--apply`: a captured byte stream through the terminal model, written
/// to standard output as text then styles (the pty runner compares it with
/// the headless `final`).
fn run_apply(o: Options) -> int {
    if o.cols == 0 {
        eprint("cub: --apply needs --size WxH")
        return 2
    }
    let bytes = fs.read_bytes(o.apply_path) else |_| {
        eprint("cub: cannot read {o.apply_path}")
        return 2
    }
    var tout = fs.stdout()
    fs.write_chunk(mut tout, headless.apply(bytes, o.cols, o.rows)) else |_| {
        return 2
    }
    0
}

/// `--art-study`: the sprite sheets on both tiers into `dump`.
fn run_art_study(o: Options) -> int {
    if o.dump == "" {
        eprint("cub: --art-study needs --dump DIR")
        return 2
    }
    fs.create_dir_all(o.dump) else |_| {
        eprint("cub: cannot create {o.dump}")
        return 2
    }
    combatproof.generate(o.dump) else |_| { return 2 }
    headless.write_frame(o.dump, "sheet-rich", art.sheet(tier.RICH)) else |_| {
        return 2
    }
    headless.write_frame(o.dump, "sheet-plain", art.sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "meat-rich", art.healing_sheet(tier.RICH, false)) else |_| {
        return 2
    }
    headless.write_frame(o.dump, "meat-plain", art.healing_sheet(tier.PLAIN, false)) else |_| {
        return 2
    }
    headless.write_frame(o.dump, "spring-rich", art.healing_sheet(tier.RICH, true)) else |_| {
        return 2
    }
    headless.write_frame(o.dump, "spring-plain", art.healing_sheet(tier.PLAIN, true)) else |_| {
        return 2
    }
    headless.write_frame(o.dump, "glow-rich", glow.sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "glow-plain", glow.sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "props-rich", props.sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "props-plain", props.sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "coast-rich", art.coast_sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "coast-plain", art.coast_sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "meadow-rich", art.meadow_sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "meadow-plain", art.meadow_sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "hawk-rich", art.hawk_sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "hawk-plain", art.hawk_sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "boss-rich", art.boss_sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "boss-plain", art.boss_sheet(tier.PLAIN)) else |_| { return 2 }
    headless.write_frame(o.dump, "wolf-rich", art.wolf_sheet(tier.RICH)) else |_| { return 2 }
    headless.write_frame(o.dump, "wolf-plain", art.wolf_sheet(tier.PLAIN)) else |_| { return 2 }
    0
}

/// The environment's tier and colour depth, where the flags left them.
fn pick_tier(o: Options) -> (int, bool) {
    var t = o.tier
    if t < 0 {
        let lang = env.get("LC_ALL") else (env.get("LANG") else "")
        t = tier.detect(env.get("TERM") else "", lang)
    }
    var truecolor = o.truecolor == 1
    if o.truecolor < 0 {
        truecolor = tier.truecolor_of(env.get("COLORTERM") else "")
    }
    (t, truecolor)
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_all(s: str, split_at: int) -> List[int] {
    var d = input.new()
    var raw = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        input.feed(mut d, bs[i], if i < split_at then 1000 else 1010, mut raw)
        i += 1
    }
    input.flush(mut d, 1010 + input.ESC_TIMEOUT_MS, mut raw)
    var keys = List[int]()
    controls.map_all(raw, mut keys)
    keys
}

fn keys_text(keys: List[int]) -> str {
    var t = ""
    for k in keys {
        t = "{t} {k}"
    }
    t
}

fn describe(seq: str) -> str {
    var t = ""
    for b in seq.bytes() {
        t = "{t} {b as int}"
    }
    "bytes{t}"
}

/// `--selftest`: cub's controls through the engine's decoder (every
/// control, whole and split at every byte) and the diff property, on THIS
/// binary, the tier that ships (pack's pk00 found the release tier's
/// mid-end miscompiling the decoder while the unit tests passed). Exit 1
/// on any mismatch.
fn run_selftest() -> int {
    var bad = 0
    var rows = List[str]()
    (mut rows).push("\x1b[A|1")
    (mut rows).push("\x1b[B|2")
    (mut rows).push("\x1b[D|3")
    (mut rows).push("\x1b[C|4")
    (mut rows).push("\x1bOA|1")
    (mut rows).push("\x1b[1;2A|5")
    (mut rows).push("\x1b[1;2B|6")
    (mut rows).push("\x1b[1;2D|7")
    (mut rows).push("\x1b[1;2C|8")
    (mut rows).push("\x1b[1;5B|2")
    (mut rows).push(" |9")
    (mut rows).push("x|10")
    (mut rows).push("z|11")
    (mut rows).push("c|12")
    (mut rows).push("\t|13")
    (mut rows).push("w|14")
    (mut rows).push("r|15")
    (mut rows).push("q|16")
    (mut rows).push("Q|16")
    (mut rows).push("\x1b|18")
    (mut rows).push("\x03|17")
    (mut rows).push("\x1b |18 9")
    (mut rows).push("\x1b[57;2u|")
    (mut rows).push("\x1b[5~|")
    (mut rows).push("\x1b[D\x1b[1;2B |3 6 9")
    for row in rows {
        let (seq, want_raw) = row.split_once("|") else (row, "")
        let want = if want_raw.len == 0 then "" else " {want_raw}"
        var at = 0
        while at <= seq.len {
            let got = keys_text(decode_all(seq, at))
            if got != want {
                print("selftest: decoder: {describe(seq)} split at {at}: got{got}, want{want}")
                bad += 1
            }
            at += 1
        }
    }
    bad += headless.diff_property()
    if bad == 0 {
        print(
            "selftest: ok (the controls table whole and split at every byte; the diff property over 12 frames)",
        )
        return 0
    }
    print("selftest: {bad} FAILED")
    1
}

/// The live game: the terminal opened and entered, one run, the terminal
/// left on every path out.
fn run_live(o: Options, args: List[str]) -> int {
    let t = term.open() else |e| {
        eprint(term.message("{e}", "cub"))
        return 2
    }
    let (tr, truecolor) = pick_tier(o)
    var rp = load_replay(o, t.cols, t.rows) else |e| {
        eprint("cub: the replay could not be read ({e})")
        return 2
    }
    let replaying = o.replay_path != ""
    if !replaying {
        rp.tier = tr
        if seed_given(args) {
            rp.seed = o.seed
        }
    }
    var cols = t.cols
    var rows = t.rows
    if replaying {
        // The replay's size is the field's; the terminal must be at least
        // that (the pty runner sizes it so).
        cols = rp.cols
        rows = rp.rows
    }
    var rec = replay.new(rp.seed, rp.tier, cols, rows)
    let dialect = tier.dialect(rp.tier, truecolor)
    let save_path = if o.save_path != "" {
        o.save_path
    } else {
        (env.get("HOME") else ".") + "/.cub/save"
    }
    var s = if !replaying {
        journey.load(save_path, rp.seed, cols, rows) else |e| {
            eprint("cub: {e}: {save_path}")
            return 2
        }
    } else {
        sim.new(rp.seed, cols, rows)
    }
    s.pace_percent = o.pace
    if !replaying {
        replay.push_arg(mut rec, 0, controls.EV_PACE, o.pace)
        if seed_given(args) && s.seed != o.seed {
            eprint("cub: save_seed_conflict: choose another --save path")
            return 2
        }
        rp.seed = s.seed
        rec.seed = s.seed
        s.entered = 0
        let initial = journey.snapshot(s)
        replay.push_arg(mut rec, 0, controls.EV_JOURNEY, journey.JOURNEY)
        var part = 0
        while part < initial.len {
            replay.push_arg(mut rec, 0, controls.saved_event(part), initial[part])
            part += 1
        }
        // The title first (cb04), unless `--no-title`; the opening follows
        // it for a new journey (the title's end starts it). Either is a
        // recorded event, so a replay shows the same.
        if o.no_title { sim.opening(mut s) } else { sim.title(mut s) }
        if s.scene == 1 { replay.push_arg(mut rec, 0, controls.EV_OPENING, 1) }
        if s.scene == sim.SCENE_TITLE { replay.push_arg(mut rec, 0, controls.EV_TITLE, 1) }
    }
    if o.combat_witness && !replaying {
        sim.combat_witness(mut s)
        replay.push_arg(mut rec, 0, controls.EV_COMBAT_WITNESS, 1)
    }
    if replaying { s = replay_initial(rp, s) else |e| { eprint("cub: {e}"); return 2 } }
    // The score (cb03): the parts rendered to WAVs and the backend probed
    // before the terminal is entered, so every refusal names itself on a
    // plain stderr. Off for a replay, under --mute and under CUB_SOUND=0.
    let sound_on = !replaying && !o.mute && (env.get("CUB_SOUND") else "1") != "0"
    let sound_dir = if o.sound_dir != "" {
        o.sound_dir
    } else {
        (env.get("HOME") else ".") + "/.cub/sound"
    }
    var player = score.player(score.backend_of(env.get("CUB_SOUND_BACKEND") else ""), sound_dir)
    var sch = score.schedule(List[score.Cue]())
    var muted = !sound_on
    var prepared_us = 0
    if sound_on {
        let p0 = clock.now_ns()
        if score.write_wavs(player) != 0 { return 2 }
        sch = score.schedule(score.cues() else |_| { return 2 })
        let _answers = score.probe(mut player)
        prepared_us = (clock.now_ns() - p0) / 1000
    }
    var saved = journey.encode(s)
    var pending = ""
    var pending_at = 0
    var save_error = false
    var front = grid.new(rows, cols)
    var back = grid.new(rows, cols)
    var pen = grid.pen_new()
    var out = List[byte]()
    var keys = List[int]()
    var raw = List[input.Event]()
    var tick_keys = List[int]()
    var d = input.new()
    var session = term.open_input(term.MIN_COLS, term.MIN_ROWS) else |_| {
        eprint(term.message("io", "cub"))
        return 3
    }
    if session.keyboard && !replaying { (mut keys).push(controls.KEY_EXACT) }
    input.events_all(mut d, session.startup, clock.now_ns() / 1000000, mut raw)
    controls.events(raw, mut keys)
    (mut raw).reset()
    if !replaying && !fs.exists(save_path) {
        journey.prepare(save_path, s, o.save_cut) else |e| {
            term.close_input(mut session)
            eprint("cub: {e}")
            return 2
        }
        journey.commit(save_path) else |e| {
            term.close_input(mut session)
            eprint("cub: {e}")
            return 2
        }
    }
    var c = clock.new(clock.now_ns())
    var full = true
    var quit = false
    var frames = 0
    var render_ns = 0
    var render_max_ns = 0
    var ended = "the loop"
    let t0_ns = clock.now_ns()
    var ghost_error = false
    var archived = s.deaths
    let ghost_dir = if o.ghost_dir != "" {
        o.ghost_dir
    } else {
        (env.get("HOME") else ".") + "/.cub/ghosts"
    }
    var extra = art.extra_none()
    extra.ghosts = ghost.load(ghost_dir, s.seed)
    var history = ghost.history()
    let demo_r = demo.load()
    var demo_tick = 0
    var trace_bytes = 0
    var trace_first_key_ns = 0
    loop {
        var deadline = clock.next_due_ns(c)
        if input.esc_pending(d) {
            let esc = input.esc_deadline_ms(d) * 1000000
            if esc < deadline {
                deadline = esc
            }
        }
        let w = clock.wait_until(mut c, deadline, term.signal_set()) else |_| {
            ended = "a failed wait"
            quit = true
            break
        }
        let now = clock.now_ns()
        let now_ms = now / 1000000
        if w.meaning != 0 {
            if w.meaning == 16384 {
                if term.resize_input(mut session) && !replaying {
                    cols = session.terminal.cols
                    rows = session.terminal.rows
                    sim.resize(mut s, cols, rows)
                    front = grid.new(rows, cols)
                    back = grid.new(rows, cols)
                    pen = grid.pen_new()
                    full = true
                    replay.push_size(mut rec, s.tick, cols, rows)
                }
            } else {
                ended = if w.meaning == 16 then "the interrupt" else "a signal ({w.meaning})"
                quit = true
            }
        }
        if w.input_ready {
            let got = term.read_keys(64) else |e| {
                eprint("cub: standard input: {e}")
                ended = "standard input ({e})"
                quit = true
                List[byte]()
            }
            let before = keys.len
            input.events_all(mut d, got, now_ms, mut raw)
            controls.events(raw, mut keys)
            (mut raw).reset()
            trace_bytes += got.len
            if keys.len > before && trace_first_key_ns == 0 {
                trace_first_key_ns = now
            }
        }
        input.flush_events(mut d, now_ms, mut raw)
        controls.events(raw, mut keys)
        (mut raw).reset()
        let due = clock.advance(mut c, now)
        var n = 0
        while n < due {
            (mut tick_keys).reset()
            if replaying {
                let (rc, rr, health) = replay.at(rp, s.tick, mut tick_keys)
                replay_numbers(mut s, health, replay.args_at(rp, s.tick, controls.EV_SCENT))
                replay_events(mut s, rp, s.tick)
                if rc > 0 {
                    sim.resize(mut s, rc, rr)
                    front = grid.new(rr, rc)
                    back = grid.new(rr, rc)
                    pen = grid.pen_new()
                    full = true
                }
                if s.tick > replay.last_tick(rp) && o.ticks == 0 {
                    ended = "the replay's end"
                    quit = true
                }
                if n == 0 {
                    for k in keys {
                        if k == controls.KEY_QUIT || k == controls.KEY_INTERRUPT {
                            ended = if k == controls.KEY_QUIT {
                                "the quit key"
                            } else {
                                "Ctrl-C"
                            }
                            quit = true
                        }
                    }
                }
            } else if n == 0 {
                for k in keys {
                    if k == controls.KEY_QUIT || k == controls.KEY_INTERRUPT {
                        ended = if k == controls.KEY_QUIT {
                            "the quit key"
                        } else {
                            "Ctrl-C"
                        }
                        quit = true
                        replay.push_key(mut rec, s.tick, k)
                    } else {
                        if k == controls.KEY_MUTE && sound_on {
                            // The music off, or on again from the scene's part.
                            muted = !muted
                            if muted { score.stop(mut player) } else { score.restart(mut sch) }
                        }
                        (mut tick_keys).push(k)
                        replay.push_key(mut rec, s.tick, k)
                    }
                }
            }
            sim.step(mut s, tick_keys)
            if sound_on && !muted && !quit {
                let c = score.step(mut sch, score.scene_of(s), s.tick)
                if c != "" { score.play(mut player, c) }
            }
            ghost.record(mut history, s.tick, frame_of(s))
            demo_step(mut extra, s, demo_r, mut demo_tick)
            // A quit key still advances this simulation tick. Commit a
            // previously staged save whose delay has elapsed before exiting;
            // quit forbids NEW stages below, not an already-due commit.
            if !replaying {
                if pending != "" && s.tick - pending_at >= o.save_delay {
                    journey.commit(save_path) else |e| {
                        eprint("cub: {e}")
                        save_error = true
                        quit = true
                        ended = "a failed save"
                    }
                    if !save_error {
                        saved = pending
                        pending = ""
                        s.save_status = 2
                    }
                }
                let current = journey.encode(s)
                if !quit && pending == "" && current != saved {
                    journey.prepare(save_path, s, o.save_cut) else |e| {
                        eprint("cub: {e}")
                        save_error = true
                        quit = true
                        ended = "a failed save"
                    }
                    if !save_error {
                        pending = current
                        pending_at = s.tick
                        s.save_status = 1
                    }
                }
            }
            if (!replaying || o.ghost_dir != "") && s.deaths > archived {
                archived = s.deaths
                write_ghost(
                    if replaying then copy rp else copy rec,
                    s,
                    history,
                    ghost_dir,
                ) else |_| {
                    ghost_error = true
                    ended = "a failed death archive"
                    quit = true
                }
                if !ghost_error { extra.ghosts = ghost.load(ghost_dir, s.seed) }
            }
            if o.trace {
                eprint(
                    "trace tick {s.tick} live_foes {denmemory.live(s)} rest_row {s.rest_row} pending {sim.rest_levels(s)} needed {s.rest_refused} level {sim.level(s)} scent {s.scent} resting {if s.den then 1 else 0} area {s.area} den_id {s.last_den} health {s.health} deaths {s.deaths} mark {if s.mark then 1 else 0} mark_area {s.mark_area} capacity {s.flask_max} flasks {s.flasks} action {s.action} aim {s.attack_heading} combo {s.combo} stamina {s.stamina} sprint {if s.sprinting then 1 else 0} dash_hits {sim.dash_hits(s)} in {trace_bytes} keys {tick_keys.len} queue {keys.len} heading {s.heading} target {s.heading_target} speed {s.speed} x {s.x} y {s.y} held {sim.held_direction(s)} exact {if input.exact(s.key_state) then 1 else 0} sneak {if s.sneaking then 1 else 0} blocked {s.blocked} scene {s.scene} demo {if extra.demo_on then 1 else 0} wall_us {(clock.now_ns() - t0_ns) / 1000}",
                )
                trace_bytes = 0
            }
            if o.trap_at > 0 && s.tick == o.trap_at {
                // The planted trap: a broken contract, as any trap would be.
                // The runtime restores the terminal (`[os.term.restore]`).
                assert(false, "cub: --trap-at {o.trap_at} (a planted trap)")
            }
            if o.ticks > 0 && s.tick >= o.ticks {
                ended = "--ticks"
                quit = true
            }
            n += 1
        }
        if due > 0 {
            (mut keys).reset()
            let r0 = clock.now_ns()
            art.render_with(s, extra, rp.tier, mut back)
            grid.diff(front, back, full, mut pen, mut out, dialect)
            let r1 = clock.now_ns()
            render_ns += r1 - r0
            if r1 - r0 > render_max_ns {
                render_max_ns = r1 - r0
            }
            term.write(out) else |_| {
                ended = "a failed write"
                quit = true
            }
            (mut out).reset()
            let tmp = front
            front = back
            back = tmp
            full = false
            frames += 1
            if o.trace && trace_first_key_ns != 0 {
                eprint(
                    "trace frame {frames} tick {s.tick} carries_key inner_us {(clock.now_ns() - trace_first_key_ns) / 1000} wall_us {(clock.now_ns() - t0_ns) / 1000}",
                )
                trace_first_key_ns = 0
            }
        }
        if quit {
            break
        }
    }
    if pending != "" {
        journey.abort(save_path) else |e| {
            eprint("cub: {e} while cancelling save")
            save_error = true
        }
        eprint("cub: pending save cancelled; previous journey preserved")
    }
    term.close_input(mut session)
    if sound_on { score.close(mut player) }
    if o.record_path != "" {
        var text = List[byte]()
        replay.format(rec, controls.vocab(), mut text)
        fs.write_bytes(o.record_path, text) else |_| {
            eprint("cub: cannot write {o.record_path}")
        }
    }
    let avg_us = if frames > 0 then render_ns / frames / 1000 else 0
    eprint(
        "cub: ended by {ended}; {s.tick} ticks, {frames} frames, {c.dropped} dropped, {c.waits} waits, {sim.distance_cells(s)} cells, blocked {s.blocked}; heading {s.heading} at {sim.cell_x(s)},{sim.cell_y(s)}; render avg {avg_us} us max {render_max_ns / 1000} us; seed {rp.seed} tier {tier.name(rp.tier)} {cols}x{rows}; sound {if sound_on then "on" else "off"} backend {player.backend} answers {if player.on then 1 else 0} prepared {prepared_us} us starts {player.starts} stops {player.stops} cue {sch.current}",
    )
    if ghost_error || save_error then 2 else 0
}

fn main() -> int {
    let args = env.args()
    if args.len > 0 && args[0] == "--doorways-audit" { return doorproof.census() }
    if args.len > 0 && args[0] == "--den-spacing" { return wide.den_spacing() }
    if args.len > 0 && args[0] == "--foe-census" { return wide.foe_census() }
    if args.len > 0 && args[0] == "--bends-audit" { return wide.bends() }
    if args.len > 0 && args[0] == "--spurs-audit" { return wide.spurs() }
    if args.len > 0 && args[0] == "--gen-bench" { return wide.gen_bench() }
    if args.len > 0 && args[0] == "--crossing-census" { return cross.crossing() }
    if args.len > 0 && args[0] == "--hitbox-audit" { return cross.hitbox() }
    if args.len == 3 && args[0] == "--town-map" {
        return cross.town_map(args[1].to_int() else 1, args[2].to_int() else 80)
    }
    if args.len == 6 && args[0] == "--route-view" {
        return pathaudit.view(
            args[1].to_int() else 0,
            args[2].to_int() else 0,
            args[3].to_int() else 0,
            args[4].to_int() else 80,
            args[5],
        )
    }
    if args.len > 0 && args[0] == "--fox-roll-census" { return motionproof.fox_census() }
    if args.len > 0 && args[0] == "--motion-render" { return motionproof.render_census() }
    if args.len > 0 && args[0] == "--motion-census" { return motionproof.census() }
    if args.len > 0 && args[0] == "--strike-census" { return combatproof.strike_census() }
    if args.len > 0 && args[0] == "--hud-census" { return combatproof.hud_census() }
    if args.len > 0 && args[0] == "--paths-audit" { return pathaudit.census() }
    if args.len > 0 && args[0] == "--den-census" { return denproof.census() }
    if args.len == 2 && args[0] == "--make-den-proof" { return denproof.generate(args[1]) }
    if args.len > 0 && args[0] == "--mouth-audit" { return run_mouth_audit() }
    if args.len > 0 && args[0] == "--chase-audit" { return run_chase_audit() }
    if args.len > 0 && args[0] == "--feel-audit" { return run_feel_audit() }
    if args.len > 0 && args[0] == "--body-audit" {
        // Fifty seeds at both sizes: the swarm and the given scripts' keys.
        var paths = List[str]()
        var i = 1
        while i < args.len { (mut paths).push(args[i]); i += 1 }
        return measure.body_audit(paths)
    }
    if (args.len == 3 || args.len == 4) && args[0] == "--fight-trace" {
        // The fighter's instrument (cb04): one boss, one seed, narrated;
        // cb07: the census's own loop, at 80 or 200 columns.
        let kind = args[1].to_int() else 4
        let seed = args[2].to_int() else 1
        let cols = if args.len == 4 then (args[3].to_int() else 80) else 80
        return fight.trace(kind, seed, cols)
    }
    if args.len > 0 && args[0] == "--den-memory-census" { return denmemory.census() }
    if args.len > 1 && args[0] == "--make-den-memory" { return denmemory.generate(args[1]) }
    if args.len > 0 && args[0] == "--foes-audit" { return look.foe_census() }
    if args.len > 0 && args[0] == "--look-audit" { return look.census() }
    if args.len > 0 && args[0] == "--boss-census" {
        // The fairness census (cb04): every boss, fifty seeds, both sizes.
        return fight.census()
    }
    if args.len > 0 && args[0] == "--measure" {
        // The gait lane's instrument: every argument after it is a script.
        var paths = List[str]()
        var i = 1
        while i < args.len { (mut paths).push(args[i]); i += 1 }
        return measure.report(paths)
    }
    let o = parse_args(args) else |_| {
        eprint(usage_text())
        return 2
    }
    if o.make_proof != "" { return proof.generate(o.make_proof) }
    if o.world_audit { return run_world_audit() }
    if o.score_list || o.score_render != "" || o.score_wav != "" || o.score_replay != "" {
        return run_score(o)
    }
    if o.help {
        print(usage_text())
        return 0
    }
    if o.version {
        print("cub 0.2.0 (the connected forest and persistent journey)")
        return 0
    }
    if o.apply_path != "" {
        return run_apply(o)
    }
    if o.art_study {
        return run_art_study(o)
    }
    if o.probe_glyphs {
        return probe.run("cub", sprites.rich_code_points())
    }
    if o.selftest {
        return run_selftest()
    }
    if o.bench { return run_bench(o) }
    if o.headless {
        return run_headless(o, args)
    }
    run_live(o, args)
}

/// The score's evidence paths (cb03): `--score-list` every part's name
/// and length; `--score-render NAME OUT` and `--score-wav NAME OUT` one
/// part at its own length, deterministic bytes; `--score-replay OUT` the
/// cue schedule through the engine's mixer. Exit 2 names a part that does
/// not parse (the engine's reader says where).
fn run_score(o: Options) -> int {
    if o.score_list {
        for n in score.names() {
            let seconds = score.seconds_of(n) else |_| { return 2 }
            print("part {n} seconds {seconds} once {if score.plays_once(n) then 1 else 0}")
        }
        return 0
    }
    if o.score_replay != "" {
        let pcm = score.replay_pcm() else |_| { return 2 }
        fs.write_bytes(o.score_replay, pcm) else |_| {
            eprint("cub: cannot write {o.score_replay}")
            return 2
        }
        return 0
    }
    let name = if o.score_render != "" then o.score_render else o.score_wav
    let part = score.load(name) else |_| {
        eprint("cub: score: {name}: no such part, or it does not parse")
        return 2
    }
    let bytes = if o.score_wav != "" {
        sound.wav(part.pcm) else |_| { eprint("cub: score: {name}: not a WAV"); return 2 }
    } else {
        copy part.pcm
    }
    fs.write_bytes(o.score_out, bytes) else |_| {
        eprint("cub: cannot write {o.score_out}")
        return 2
    }
    0
}

fn replay_numbers(mut s: sim.Sim, health: int, scent: int) {
    if health < 0 { sim.hurt(mut s, 0 - health) }
    if health > 0 {
        s.health += health
        if s.health > sim.health_max(s.heart) { s.health = sim.health_max(s.heart) }
    }
    s.scent += scent
    if s.scent < 0 { s.scent = 0 }
}

/// The scene and test events at `tick`: `opening 1`, `title 1` (cb04) and
/// `bosses N` (a debug delta setting the beaten bits, as `health` moves
/// the cub's).
fn replay_events(mut s: sim.Sim, r: replay.Replay, tick: int) {
    if replay.args_at(r, tick, controls.EV_OPENING) == 1 { sim.opening(mut s) }
    if replay.args_at(r, tick, controls.EV_TITLE) == 1 { sim.title(mut s) }
    if replay.args_at(r, tick, controls.EV_COMBAT_WITNESS) == 1 { sim.combat_witness(mut s) }
    let pace = replay.args_at(r, tick, controls.EV_PACE)
    if pace >= 25 && pace <= 300 { s.pace_percent = pace }
    let bosses = replay.args_at(r, tick, controls.EV_BOSSES)
    if bosses > 0 { s.bosses = bosses % 16 }
}

/// The cub's frame this tick, for a ghost's trailer.
fn frame_of(s: sim.Sim) -> ghost.Frame {
    ghost.Frame { x: s.x, y: s.y, facing: s.body_facing, pose: art.pose_of(s), area: s.area }
}

/// The title's demo (cb04): after `TITLE_IDLE` idle ticks on the title the
/// committed replay's world runs behind the card, its keys by tick, round
/// again at its end; the demo's size is the replay's (the field it was
/// made for), the camera the terminal's.
fn demo_step(mut extra: art.Extra, s: sim.Sim, r: replay.Replay, mut demo_tick: int) {
    let on = s.scene == sim.SCENE_TITLE && s.tick - s.scene_started >= sim.TITLE_IDLE
    extra.demo_on = on
    if !on {
        if extra.demo.len > 0 { (mut extra.demo).reset(); demo_tick = 0 }
        return
    }
    if extra.demo.len == 0 {
        var d = sim.new(r.seed, r.cols, r.rows)
        sim.resize(mut d, s.cols, s.rows)
        (mut extra.demo).push(d)
        demo_tick = 0
    }
    if demo_tick > replay.last_tick(r) + 30 {
        var d = sim.new(r.seed, r.cols, r.rows)
        sim.resize(mut d, s.cols, s.rows)
        extra.demo[0] = d
        demo_tick = 0
    }
    var keys = List[int]()
    let (_, _, health) = replay.at(r, demo_tick, mut keys)
    replay_numbers(mut extra.demo[0], health, replay.args_at(r, demo_tick, controls.EV_SCENT))
    if extra.demo[0].cols != s.cols || extra.demo[0].rows != s.rows {
        sim.resize(mut extra.demo[0], s.cols, s.rows)
    }
    sim.step(mut extra.demo[0], keys)
    demo_tick += 1
}

/// The `# ghost-dir DIR` line of a headless script, or "".
fn script_ghost_dir(o: Options) -> str {
    let path = if o.script != "" then o.script else o.replay_path
    if path == "" { return "" }
    let text = fs.read_text(path) else |_| { return "" }
    for raw in text.lines() {
        let line = raw.trim()
        if line.starts_with("# ghost-dir ") { return line[12..].trim() }
    }
    ""
}

fn state_text(s: sim.Sim) -> str {
    var text = "tick {s.tick} resting {if s.den then 1 else 0} capacity {s.flask_max} level {sim.level(s)} meat {s.meat.len} area {s.area} den_id {s.last_den} shortcuts {s.shortcuts} caches {s.caches} scene {s.scene} drops {s.drops.len} mark_area {s.mark_area} x {s.x} y {s.y} heading {s.heading} action {s.action} started {s.started} health {s.health} stamina {s.stamina} flasks {s.flasks} scent {s.scent} deaths {s.deaths} mark {if s.mark then 1 else 0} mark_scent {s.mark_scent} gate {if s.gate_open then 1 else 0} trail {s.trail.len} lock {s.locked} aim {s.attack_heading} combo {s.combo} body {s.body_facing} gait {s.gait} sprint {if s.sprinting then 1 else 0} cone {sim.attack_direction(s)} bosses {s.bosses} end {if s.end then 1 else 0} arena {if sim.cub_in_arena(s) then 1 else 0} played {sim.played_ticks(s)} lost {s.lost}\n"
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        text += "foe {i} kind {f.kind} health {f.health} phase {f.phase} since {f.since} x {f.x} y {f.y} heading {f.heading} gap {sim.body_gap(s, i)} last_hit {f.last_hit} attack {f.attack} poise {f.poise}\n"
        i += 1
    }
    text
}

fn write_ghost(r: replay.Replay, s: sim.Sim, history: ghost.History, dir: str) -> () ! {io} {
    fs.create_dir_all(dir) else |_| { return io }
    var death = replay.new(r.seed, r.tier, r.cols, r.rows)
    for e in r.events {
        if e.tick < s.tick { (mut death.events).push(copy e) }
    }
    // A zero health event pins the exact last tick even when no key was pressed.
    replay.push_arg(mut death, s.tick - 1, 0, 0)
    // The ghost's trailer (cb04): the last seconds' positions, in tick order.
    ghost.trailer(mut death, history, s.tick, s.deaths)
    var bytes = List[byte]()
    replay.format(death, controls.vocab(), mut bytes)
    // Exclusive creation, not a clock, protects earlier runs and concurrent games.
    var serial = 0
    loop {
        let path = "{dir}/death-{r.seed}-{s.tick}-{serial}.pk"
        var file = fs.create_new(path) else |e| match e {
            exists => { serial += 1; continue },
            not_found => { return io },
            denied => { return io },
            io => { return io },
        }
        fs.write_chunk(mut file, bytes) else |_| {
            fs.close(take file) else |_| {}
            return io
        }
        fs.sync(mut file) else |_| {
            fs.close(take file) else |_| {}
            return io
        }
        fs.close(take file) else |_| { return io }
        eprint("cub: death archive {path}")
        return
    }
}

fn run_bench(o: Options) -> int {
    let cols = if o.cols > 0 then o.cols else 80
    let rows = if o.rows > 0 then o.rows else 24
    let t = if o.tier < 0 then tier.RICH else o.tier
    var s = sim.new(o.seed, cols, rows)
    var front = grid.new(rows, cols)
    var back = grid.new(rows, cols)
    var pen = grid.pen_new()
    var out = List[byte]()
    var samples = List[int]()
    var sum = 0
    var maximum = 0
    var n = 0
    while n < o.frames {
        var keys = List[int]()
        if n % 2 == 0 { (mut keys).push(controls.KEY_RIGHT) }
        if n % 37 == 0 { (mut keys).push(controls.KEY_BITE) }
        if n % 91 == 0 { (mut keys).push(controls.KEY_PARRY) }
        sim.step(mut s, keys)
        let before = clock.now_ns()
        art.render(s, t, mut back)
        grid.diff(front, back, n == 0, mut pen, mut out, tier.dialect(t, false))
        let elapsed = clock.now_ns() - before
        sum += elapsed
        if elapsed > maximum { maximum = elapsed }
        (mut samples).push(elapsed)
        (mut out).reset()
        let old = front
        front = back
        back = old
        n += 1
    }
    // Small fixed benchmark; insertion sort avoids platform-dependent timing APIs.
    var i = 1
    while i < samples.len {
        var j = i
        while j > 0 && samples[j] < samples[j - 1] {
            let old = samples[j]
            samples[j] = samples[j - 1]
            samples[j - 1] = old
            j -= 1
        }
        i += 1
    }
    print(
        "bench {cols}x{rows} {tier.name(t)} frames {o.frames} avg_us {sum / o.frames / 1000} p99_us {samples[(samples.len - 1) * 99 / 100] / 1000} max_us {maximum / 1000}",
    )
    0
}

fn replay_initial(r: replay.Replay, fallback: sim.Sim) -> sim.Sim ! {
    save_corrupt,
    save_version,
    save_difficulty,
} {
    let version = replay.args_at(r, 0, controls.EV_JOURNEY)
    if version == 0 { return copy fallback }
    if version != journey.JOURNEY && version != 3 { return save_version }
    var values = List[int]()
    var i = 0
    while i < (if version == 3 then 30 else journey.SNAPSHOT) {
        (mut values).push(replay.args_at(r, 0, controls.saved_event(i)))
        i += 1
    }
    let initial = journey.from_snapshot(values, r.cols, r.rows)?
    if initial.seed != r.seed { return save_corrupt }
    initial
}

fn run_world_audit() -> int {
    print(
        "seed field area reached required longest_straight min_foe_cells caches bank_step flat_run textured_pct useful_steps path_off",
    )
    var seed = 0
    while seed < 50 {
        var size = 0
        while size < 2 {
            let field = if size == 0 then 80 else 200
            let bank_max = coast.bank_step(seed, field)
            let (flat, textured) = coast.texture(seed, field)
            let steps = coast.walk_bound(seed, field)
            var area = 0
            while area < forest.AREAS {
                let reached = forest.reach_count(seed, field, area)
                let required = forest.required(area)
                let straight = forest.straight_run(seed, area)
                let foes = sim.area_foes(seed, field, area, 0)
                var closest = 1000000
                for foe in foes {
                    if forest.blocked(
                        seed,
                        field,
                        area,
                        sim.floor_div(foe.x, sim.FP),
                        sim.floor_div(foe.y, sim.FP),
                    ) {
                        eprint("world: blocked spawn {seed} {field} {area}")
                        return 1
                    }
                    var den = 0
                    while den < forest.DEN_LIMIT {
                        if forest.den_area(den) == area {
                            let (x, y) = forest.den_position(seed, den)
                            let dx = (foe.x - x) / sim.FP
                            let dy = (foe.y - y) / sim.FP
                            let distance2 = dx * dx + dy * dy
                            if distance2 < closest { closest = distance2 }
                        }
                        den += 1
                    }
                }
                var distance = 0
                while (distance + 1) * (distance + 1) <= closest { distance += 1 }
                let path_off = art.path_audit(seed, field, area)
                print(
                    "{seed} {field} {area} {reached} {required} {straight} {distance} {forest.cache_count(area)} {bank_max} {flat} {textured} {steps} {path_off}",
                )
                if path_off != 0 ||
                    reached != required ||
                    straight > forest.STRAIGHT_MAX ||
                    bank_max > 1 ||
                    distance < forest.FIRST_FOE_CELLS {
                    return 1
                }
                area += 1
            }
            size += 1
        }
        seed += 1
    }
    0
}

fn run_feel_audit() -> int {
    print("seed area dens min_spacing max_spacing switchbacks clearings path_length")
    var seed = 0
    while seed < 50 {
        var area = 0
        while area < 3 {
            var count = 0
            var low = 1000000
            var high = 0
            var den = 0
            while den < forest.DEN_LIMIT {
                if forest.den_area(den) == area {
                    count += 1
                    let (x, y) = forest.den_position(seed, den)
                    if forest.blocked(
                        seed,
                        80,
                        area,
                        sim.floor_div(x, sim.FP),
                        sim.floor_div(y, sim.FP),
                    ) {
                        return 1
                    }
                    var other = den + 1
                    while other < forest.DEN_LIMIT {
                        if forest.den_area(other) == area {
                            let (ox, oy) = forest.den_position(seed, other)
                            let dx = if x > ox then x - ox else ox - x
                            let dy = if y > oy then y - oy else oy - y
                            let gap = (dx + dy) / sim.FP
                            if gap < low { low = gap }
                            if gap > high { high = gap }
                        }
                        other += 1
                    }
                }
                den += 1
            }
            if count == 1 { low = 0 }
            print(
                "{seed} {area} {count} {low} {high} {if area == 1 then forest.switchbacks(seed) else 0} {if area == 1 then forest.CLEARINGS else 0} {forest.path_length(seed, area)}",
            )
            if count < 1 || count != forest.den_count(area) { return 1 }
            area += 1
        }
        seed += 1
    }
    0
}

fn run_chase_audit() -> int {
    print("seed kind ticks travel_fp caught overlap unreachable foe_overlap")
    var seed = 0
    while seed < 50 {
        var kind = 0
        while kind < 4 {
            if kind == sim.HAWK { kind += 1; continue }
            region chase {
                var s = sim.new(seed, 80, 24)
                let y = 40
                let x = forest.spine(seed, 2, y)
                sim.enter_area(mut s, 2, x * sim.FP, y * sim.FP)
                var foe = copy s.foes[0]
                foe.kind = kind
                foe.x = x * sim.FP
                foe.y = (y + 7) * sim.FP
                foe.heading = 128
                foe.health = 100
                foe.stamina = 60
                foe.phase = sim.RETREAT
                foe.since = 0
                foe.target_x = s.x
                foe.target_y = s.y
                (mut s.foes).reset()
                (mut s.foes).push(foe)
                s.heading = 128
                s.heading_target = 128
                var ticks = 0
                var travel = 0
                var caught = false
                var c = census.counts()
                while ticks < 240 && s.health > 0 {
                    var keys = List[int]()
                    let f = copy s.foes[0]
                    let h = sim.heading_to(s.x, s.y, f.x, f.y)
                    if h == 0 || h == 32 || h == 224 { (mut keys).push(controls.KEY_UP) }
                    if h == 96 || h == 128 || h == 160 { (mut keys).push(controls.KEY_DOWN) }
                    if h == 160 || h == 192 || h == 224 { (mut keys).push(controls.KEY_LEFT) }
                    if h == 32 || h == 64 || h == 96 { (mut keys).push(controls.KEY_RIGHT) }
                    (mut keys).push(controls.KEY_CTRL_DOWN)
                    if s.sprinting &&
                        sim.in_reach(s, 0, 3) &&
                        sim.abs(sim.turn_toward(s.heading, h)) <= 32 {
                        (mut keys).push(controls.KEY_BITE)
                    }
                    let ox = s.x
                    let oy = s.y
                    sim.step(mut s, keys)
                    travel += sim.abs(s.x - ox) + sim.abs(s.y - oy)
                    region frame { census.observe(mut c, s) }
                    if s.foes[0].health < 100 { caught = true }
                    ticks += 1
                    if caught { break }
                }
                print(
                    "{seed} {kind} {ticks} {travel} {if caught then 1 else 0} {c.overlap} {c.contact_unreachable} {c.foe_overlap}",
                )
                if !caught ||
                    travel > 30 * sim.FP ||
                    c.overlap != 0 ||
                    c.contact_unreachable != 0 ||
                    c.foe_overlap != 0 {
                    return 1
                }
            }
            kind += 1
        }
        seed += 1
    }
    0
}

fn run_mouth_audit() -> int {
    print("seed field kind reached ticks health in_arena")
    var failures = 0
    var seed = 0
    while seed < 50 {
        var kind = sim.BOAR
        while kind <= sim.ALPHA {
            var size = 0
            while size < 2 {
                region trial {
                    let cols = if size == 0 then 80 else 200
                    var s = fight.journey_at(seed, cols, 24, kind)
                    var r = replay.new(seed, 1, cols, 24)
                    replay.push_arg(mut r, 0, controls.EV_JOURNEY, journey.JOURNEY)
                    let saved = journey.snapshot(s)
                    var part = 0
                    while part < saved.len {
                        replay.push_arg(mut r, 0, controls.saved_event(part), saved[part])
                        part += 1
                    }
                    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
                    let (x, y) = fight.mouth(s, kind)
                    let reached = walker.walk(mut s, mut r, x, y)
                    print(
                        "{seed} {cols} {kind} {if reached then 1 else 0} {s.tick} {s.health} {if sim.cub_in_arena(s) then 1 else 0}",
                    )
                    if !reached {
                        failures += 1
                        var bytes = List[byte]()
                        replay.format(r, controls.vocab(), mut bytes)
                        fs.write_bytes("target/mouth-{seed}-{cols}-{kind}.pk", bytes) else |_| {
                            return 2
                        }
                    }
                }
                size += 1
            }
            kind += 1
        }
        seed += 1
    }
    if failures > 0 then 1 else 0
}
