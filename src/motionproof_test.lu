//! member: false

use controls
use forest
use motionproof
use sim
use terrain

fn test_cb04b_census_arrows_cover_all_eight_headings() {
    var h = 0
    while h < sim.TURN {
        let keys = motionproof.arrows(h, false)
        var up = false
        var down = false
        var left = false
        var right = false
        for k in keys {
            if k == controls.KEY_UP { up = true }
            if k == controls.KEY_DOWN { down = true }
            if k == controls.KEY_LEFT { left = true }
            if k == controls.KEY_RIGHT { right = true }
        }
        assert(sim.heading_of(up, down, left, right) == h, "census heading {h}")
        let sneak = motionproof.arrows(h, true)
        assert(sneak.len == keys.len, "same chord when sneaking")
        var i = 0
        while i < keys.len { assert(sneak[i] == keys[i] + 4, "sneak vocabulary"); i += 1 }
        h += 32
    }
}

fn test_cb04b_census_samples_actual_steady_motion() {
    let y = terrain.bank(1, 0) + terrain.REED_ROWS + 2
    let (east, ey, eb) = motionproof.sample(1, 200, forest.SHINGLE, 0, y, 64, 0)
    let (west, wy, wb) = motionproof.sample(1, 200, forest.SHINGLE, 0, y, 192, 0)
    assert(east == sim.trot_at(1) && west == 0 - east, "opposed steady displacement")
    assert(ey == 0 && wy == 0 && eb == 0 && wb == 0, "clear coast, not a wall measurement")
    let (sneak, _, _) = motionproof.sample(1, 200, forest.SHINGLE, 0, y, 64, 1)
    let (sprint, _, _) = motionproof.sample(1, 200, forest.SHINGLE, 0, y, 64, 2)
    assert(sneak == east / 2 && sprint > east, "gait probes really change movement")
}
