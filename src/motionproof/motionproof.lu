//! Movement census: the same instrument before and after cb04b's tuning.
//! Each terrain row samples actual generated cells. A steady-state sixty-tick
//! probe resets position, not its integrator, to separate gait from walls,
//! turning and acceleration. The 14-tick trials below are continuous travel.

use art
use controls
use clock
use grid
use forest
use input
use sim
use terrain

/// Keys pointing to one of the eight compass headings.
pub fn arrows(h: int, sneak: bool) -> List[int] {
    var keys = List[int]()
    let offset = if sneak then 4 else 0
    if h == 0 || h == 32 || h == 224 { (mut keys).push(controls.KEY_UP + offset) }
    if h == 96 || h == 128 || h == 160 { (mut keys).push(controls.KEY_DOWN + offset) }
    if h == 160 || h == 192 || h == 224 { (mut keys).push(controls.KEY_LEFT + offset) }
    if h == 32 || h == 64 || h == 96 { (mut keys).push(controls.KEY_RIGHT + offset) }
    keys
}

fn alone(seed: int, field: int, area: int, x: int, y: int, h: int) -> sim.Sim {
    var s = sim.new(seed, field, 24)
    (mut s.foes).reset()
    s.area = area
    s.x = x * sim.FP + sim.FP / 2
    s.y = y * sim.FP + sim.FP / 2
    s.heading = h
    s.heading_target = h
    s.body_facing = sim.eighth(h)
    // Isolate movement from portals/pickups; their independent gates remain.
    s.edge_ready = false
    s.gate_open = true
    s.flask_max = 3
    s.tick = 100
    s
}

fn sprint_keys(mut s: sim.Sim, mut keys: List[int]) {
    // Baseline binding. Changed alongside the binding, not the measurement.
    input.hold_press(mut s.sprint_hold, s.tick - 1)
    input.hold_press(mut s.sprint_hold, s.tick)
    (mut keys).push(controls.KEY_CTRL_DOWN)
}

/// Sixty unobstructed steady ticks on a genuine terrain sample. Position
/// is reset to isolate terrain, but fractional integration is retained.
pub const SAMPLE_TICKS: int = 60

/// Integrated displacement over SAMPLE_TICKS (not a one-tick rounding proxy).
pub fn sample(seed: int, field: int, area: int, x: int, y: int, h: int, gait: int) -> (
    int,
    int,
    int,
) {
    var s = alone(seed, field, area, x, y, h)
    var keys = arrows(h, gait == 1)
    if gait == 2 { sprint_keys(mut s, mut keys) }
    let cap = if gait == 1 {
        sim.trot_at(1) / 2
    } else if gait == 2 {
        sim.sprint_at(1)
    } else {
        sim.trot_at(1)
    }
    s.speed = if sim.in_shallows(s, s.x, s.y) && gait != 1 then cap / 2 else cap
    if sim.sin(h) > 0 { s.x -= 1 }
    if sim.cos(h) < 0 { s.y -= 1 }
    let ox = s.x
    let oy = s.y
    var dx = 0
    var dy = 0
    var n = 0
    while n < SAMPLE_TICKS {
        s.x = ox
        s.y = oy
        sim.step(mut s, keys)
        dx += s.x - ox
        dy += s.y - oy
        n += 1
    }
    (dx, dy, s.blocked)
}

/// One genuine cell per present walkable kind, over the area's full extent.
/// Kind ids are data, not indices into a list sized by an older terrain enum.
pub fn terrain_samples(seed: int, field: int, area: int) -> List[(int, int, int)] {
    let origin = forest.origin(seed, area)
    let first = if area == forest.SHINGLE then forest.COAST_TOP else origin
    terrain_window(seed, field, area, first, origin + forest.length(area))
}

/// Bounded sampling window; the full census calls this over every route row.
pub fn terrain_window(seed: int, field: int, area: int, first: int, last: int) -> List[(
    int,
    int,
    int,
)] {
    var samples = List[(int, int, int)]()
    let bound = forest.bound(field, area)
    var y = first
    while y <= last {
        var x = 0 - bound
        while x <= bound {
            let kind = forest.kind(seed, field, area, x, y)
            var seen = false
            for prior in samples {
                let (previous, _, _) = prior
                if previous == kind { seen = true }
            }
            if !seen && !forest.blocked(seed, field, area, x, y) {
                (mut samples).push((kind, x, y))
            }
            x += 1
        }
        y += 1
    }
    samples
}

fn terrain_rows(seed: int, field: int, area: int, t: int) -> int {
    var count = 0
    for cell_sample in terrain_samples(seed, field, area) {
        let (kind, x, y) = cell_sample
        // At paw1 even sprint moves less than half a cell: from the
        // centre this probe stays inside this actual terrain cell.
        // Do not exclude one-cell reed bands beside blocked water.
        let cell = art.ground_at(seed, field, area, t, x, y)
        var h = 0
        while h < sim.TURN {
            var gait = 0
            while gait < 3 {
                let (dx, dy, blocked) = sample(seed, field, area, x, y, h, gait)
                print(
                    "pace seed={seed} field={field} area={area} tier={t} terrain={kind} heading={h} gait={gait} ticks={SAMPLE_TICKS} dx={dx} dy={dy} blocked={blocked} glyph={cell.cp}",
                )
                if blocked != 0 { return -1 }
                count += 1
                gait += 1
            }
            h += 32
        }
    }
    count
}

fn travel(paw: int, gait: int) {
    // The Shingle's open coast, east from its middle; no foe or portal.
    let seed = 1
    let x = 0
    let y = terrain.bank(seed, x) + terrain.REED_ROWS + 2
    var s = alone(seed, 200, forest.SHINGLE, x, y, 64)
    s.paw = paw
    s.speed = if gait == 2 then sim.sprint_at(paw) else sim.trot_at(paw)
    let ox = s.x
    let oy = s.y
    var n = 0
    while n < 14 {
        var keys = arrows(64, false)
        if gait == 2 { sprint_keys(mut s, mut keys) }
        if gait == 3 && n == 0 { (mut keys).push(controls.KEY_DODGE) }
        sim.step(mut s, keys)
        n += 1
    }
    print(
        "travel paw={paw} gait={gait} ticks=14 dx={s.x - ox} dy={s.y - oy} blocked={s.blocked} health={s.health} stamina={s.stamina}",
    )
}

/// Fifty seeds, both field sizes and display tiers, every present walkable
/// terrain class and eight headings. Gaits 0 walk /1 sneak /2 sprint /3 roll.
pub fn census() -> int {
    print(
        "motion-census dial={sim.WALK_PERCENT} FP={sim.FP} hz=30; steady sixty-tick probes, continuous fourteen-tick travel",
    )
    var total = 0
    var seed = 0
    while seed < 50 {
        for field in [80, 200] {
            var area = 0
            while area < forest.AREAS {
                for t in [0, 1] {
                    region row {
                        let n = terrain_rows(seed, field, area, t)
                        if n < 0 { eprint("motion-census: blocked steady probe"); return 1 }
                        total += n
                    }
                }
                area += 1
            }
        }
        seed += 1
    }
    for paw in [1, 10] { for gait in [0, 2, 3] { travel(paw, gait) } }
    print("motion-census rows={total}")
    if total == 0 then 1 else 0
}

/// Area/seed render timing is separate from deterministic motion output.
/// One warmup then four actual full frames per seed, both sizes and tiers.
pub fn render_census() -> int {
    for field in [80, 200] {
        let rows = if field == 80 then 24 else 60
        var area = 0
        while area < forest.AREAS {
            for t in [0, 1] {
                var seed = 0
                while seed < 50 {
                    region trial {
                        var s = sim.new(seed, field, rows)
                        let x = forest.spine(seed, area, 80) * sim.FP
                        let y = (forest.origin(seed, area) + 80) * sim.FP
                        sim.enter_area(mut s, area, x, y)
                        var g = grid.new(rows, field)
                        art.render(s, t, mut g)
                        var total = 0
                        var maximum = 0
                        var n = 0
                        while n < 4 {
                            let before = clock.now_ns()
                            art.render(s, t, mut g)
                            let elapsed = clock.now_ns() - before
                            total += elapsed
                            if elapsed > maximum { maximum = elapsed }
                            n += 1
                        }
                        print(
                            "render seed={seed} field={field} area={area} tier={t} avg_us={total / 4000} max_us={maximum / 1000}",
                        )
                    }
                    seed += 1
                }
            }
            area += 1
        }
    }
    0
}

/// Controlled contact fixture: roll towards the fox's body, so distance
/// cannot mask whether its false tell or real strike defeated the iframes.
pub fn fox_census() -> int {
    print("fox-census: contact fixture; none/false/real; inward roll is body-blocked")
    for paw in [1, 10] {
        for mode in [0, 1, 2] {
            var s = sim.new(1, 80, 24)
            var f = copy s.foes[2]
            (mut s.foes).reset()
            s.area = forest.BRAMBLEHOLD
            let (x, y, _) = forest.arena(s.seed, s.field, s.area)
            s.x = x * sim.FP + sim.FP / 2
            s.y = (forest.origin(s.seed, s.area) + y) * sim.FP + sim.FP / 2
            s.paw = paw
            s.flask_max = 2
            s.flasks = 2
            f.kind = sim.FOX
            f.heading = 128
            f.x = s.x
            f.health = 24
            f.phase = sim.FEINT
            f.since = 0
            f.target_x = s.x
            f.target_y = s.y
            var d = 2 * sim.FP
            var contact = false
            while d < 10 * sim.FP {
                f.y = s.y - d
                if !sim.overlap(sim.cub_body(s), sim.foe_body(f)) &&
                    sim.gap(sim.cub_body(s), sim.foe_body(f)) == 0 {
                    contact = true
                    break
                }
                d += sim.FP / 4
            }
            if !contact { return 1 }
            (mut s.foes).push(f)
            var rolled = -1
            var real = -1
            var strike = -1
            let oy = s.y
            var n = 0
            while n < 40 {
                var keys = List[int]()
                if rolled < 0 &&
                    (
                        mode == 1 && n == 0 ||
                            mode == 2 &&
                                s.foes[0].phase == sim.CROUCH &&
                                s.tick - s.foes[0].since == 10
                    ) {
                    (mut keys).push(controls.KEY_UP)
                    (mut keys).push(controls.KEY_DODGE)
                    rolled = s.tick + 1
                }
                sim.step(mut s, keys)
                if real < 0 && s.foes[0].phase == sim.CROUCH { real = s.tick }
                if strike < 0 && s.foes[0].phase == sim.STRIKE { strike = s.tick }
                n += 1
            }
            print(
                "fox paw={paw} mode={mode} false=0 real={real} strike={strike} roll_at={rolled} health={s.health} flasks={s.flasks} dy={s.y - oy} blocked={s.blocked}",
            )
            if real != 16 || strike - real != 12 { return 1 }
            if mode == 2 && s.health != sim.health_max(1) { return 1 }
            if mode != 2 && s.health >= sim.health_max(1) { return 1 }
        }
    }
    0
}
