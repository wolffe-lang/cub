//! member: false
//!
//! The score's promises (cb03): every part parses and has its written
//! length, the binary carries the committed text, and the cue schedule
//! does what the design says: an area's loop restarts at its length, an
//! area change cues the new part (the engine fades the old slot out), a
//! boss theme replaces the area's loop (the duck), the death sting stops
//! it and is never cut short, the loop resumes at the den after it, a
//! den's rest sounds while the cub rests, a slot without a part is the
//! silence. The checked machine renders no audio here: the renders are
//! tools/score-check's, over the binaries.
//!
//! cb17's rows: every area and every moment names a part the bank holds
//! (a missing part is a red row here and a red cue-schedule golden in
//! tools/score-check), the new parts' written lengths, the moments read
//! from the game (the reveal, the crossing, the walk, the Hush's wait,
//! R-cb17-1 A), the end's Moonford, the reveal held to its end, and every
//! scene script's bank inside the engine's sixteen (R-cb17-2 A).

use forest
use score
use sim
use sound
use std.fs

fn length_of(name: str) -> int {
    score.seconds_of(name) else |_| {
        assert(false, "{name} does not parse")
        0
    }
}

fn test_cb03_every_part_parses_at_its_written_length() {
    assert(length_of("title") == 20, "the title: 6 bars of 4/4 at 72")
    assert(length_of("shingle") == 24, "the Shingle: 6 bars of 4/4 at 60")
    assert(length_of("bramblehold") == 24, "Bramblehold: 10 bars of 4/4 at 100")
    assert(length_of("larkmeadow") == 24, "Larkmeadow: 16 bars of 3/4 at 120")
    assert(length_of("boss-boar") == 16, "the boar: 8 bars of 4/4 at 120")
    assert(length_of("boss-lynx") == 12, "the lynx: 10 bars of 3/4 at 150")
    assert(length_of("boss-elk") == 20, "the elk: 8 bars of 4/4 at 96")
    assert(length_of("boss-alpha") == 24, "the shadow alpha: 6 bars of 4/4 at 60")
    assert(length_of("den") == 10, "the den: 4 bars of 3/4 at 72")
    assert(length_of("death") == 12, "the sting: a bar of 4/4 at 60 and two silent")
    assert(length_of("crack") == 5, "crack: three bars at 144")
    assert(length_of("silence") == 2, "the silence: one bar at 120")
    assert(score.names().len == 25, "twenty-five parts since cb17")
    var seen = List[str]()
    for n in score.names() {
        for s in seen { assert(s != n, "{n} named twice") }
        (mut seen).push(n)
    }
}

fn test_cb03_the_binary_carries_the_committed_parts() {
    // tools/score-embed writes src/score/parts.lu from score/*.part; a
    // part edited without a rerun is this red row (read from the root,
    // where tools/test runs).
    for n in score.names() {
        let file = fs.read_text("score/{n}.part") else |_| {
            assert(false, "score/{n}.part is read from the repository root")
            ""
        }
        assert(file == score.part_text(n), "score/{n}.part is the text the binary carries")
        assert(file.contains("Original,"), "{n} says it is original")
    }
}

fn test_cb03_each_part_names_its_cue_fade() {
    // Every part carries lair's cue line: a replace with a fade, so the
    // engine fades the old slot out as the new one rises.
    for n in score.names() {
        var seen = false
        for line in score.part_text(n).lines() {
            let ws = line.words()
            if ws.len == 4 && ws[0] == "cue" {
                assert(ws[1] == "replace" && ws[2] == "fade", "{n}: a replace cue with a fade")
                seen = true
            }
        }
        assert(seen, "{n} names its cue")
    }
}

fn test_cb03_the_areas_and_bosses_have_their_parts_and_slots() {
    assert(score.area_part(0) == "shingle" && score.area_part(1) == "bramblehold", "areas")
    assert(score.area_part(2) == "larkmeadow", "the meadow")
    // cb17: cb04's slots (`crags`, `river`, `old-den`), cb05's and cb14's
    // `none`s are parts now, named for the areas.
    assert(
        score.area_part(3) == "teeth" &&
            score.area_part(4) == "shallows" &&
            score.area_part(5) == "hush",
        "cb04's areas have their parts",
    )
    assert(
        score.area_part(6) == "cinderwick" && score.area_part(7) == "stand",
        "the town's part; the Stand's",
    )
    assert(
        score.area_part(12) == "gravehollow" && score.area_part(13) == "none",
        "Gravehollow's part, no fourteenth area",
    )
    assert(score.boss_part(0) == "boss-boar" && score.boss_part(3) == "boss-alpha", "bosses")
    assert(score.boss_part(-1) == "" && score.boss_part(4) == "", "no fifth boss")
    assert(score.plays_once("death") && !score.plays_once("shingle"), "the sting alone plays once")
}

/// Small cues for the schedule tests: lengths in ticks.
fn cues() -> List[score.Cue] {
    [
        score.Cue { name: "title", ticks: 20, once: false },
        score.Cue { name: "shingle", ticks: 30, once: false },
        score.Cue { name: "bramblehold", ticks: 30, once: false },
        score.Cue { name: "boss-boar", ticks: 16, once: false },
        score.Cue { name: "den", ticks: 10, once: false },
        score.Cue { name: "death", ticks: 12, once: true },
        score.Cue { name: "silence", ticks: 6, once: false },
    ]
}

fn scene(area: int) -> score.Scene {
    score.in_area(area)
}

fn test_cb03_want_decides_in_order() {
    var sc = scene(1)
    assert(score.want(sc) == "bramblehold", "the area")
    sc.boss = 0
    assert(score.want(sc) == "boss-boar", "a boss over the area")
    sc.den = true
    assert(score.want(sc) == "den", "the den over a boss")
    sc.title = true
    assert(score.want(sc) == "title", "the title over the den")
    sc.fallen = true
    assert(score.want(sc) == "death", "the sting over everything")
}

fn test_cb03_an_area_loop_restarts_at_its_length() {
    var sch = score.schedule(cues())
    assert(score.step(mut sch, scene(0), 0) == "shingle", "the first tick cues the area")
    var t = 1
    while t < 30 {
        assert(score.step(mut sch, scene(0), t) == "", "nothing while it sounds: tick {t}")
        t += 1
    }
    assert(score.step(mut sch, scene(0), 30) == "shingle", "the loop restarts at 30 ticks")
    assert(score.step(mut sch, scene(0), 31) == "", "and sounds on")
    assert(score.sounding(sch, 59) && !score.sounding(sch, 60), "sounding through its length")
}

fn test_cb03_an_area_change_crossfades() {
    var sch = score.schedule(cues())
    let _first = score.step(mut sch, scene(0), 0)
    assert(score.step(mut sch, scene(1), 7) == "bramblehold", "the new area's part at once")
    // The engine's side of the crossfade: a replace cue marks every
    // sounding slot leaving while the new slot fades in.
    var m = sound.mixer(
        [
            sound.Part { name: "shingle", pcm: pcm(6400), layer: false, fade: 1 },
            sound.Part { name: "bramblehold", pcm: pcm(6400), layer: false, fade: 1 },
        ],
    ) else |_| {
        assert(false, "bank")
        sound.Mixer { bank: [], which: [], position: [], level: [], leaving: [] }
    }
    assert(sound.cue(mut m, "shingle"), "cue")
    let _one = sound.tick(mut m)
    assert(sound.cue(mut m, "bramblehold"), "replace")
    assert(m.leaving[0] && !m.leaving[1], "the old slot fades out, the new fades in")
}

fn pcm(frames: int) -> List[byte] {
    var b = List[byte]()
    var i = 0
    while i < frames * 4 {
        (mut b).push((if i % 2 == 0 { 0 } else { 16 }) as byte)
        i += 1
    }
    b
}

fn test_cb03_a_boss_theme_ducks_the_area_loop() {
    var sch = score.schedule(cues())
    let _first = score.step(mut sch, scene(0), 0)
    var fight = scene(0)
    fight.boss = 0
    assert(score.step(mut sch, fight, 10) == "boss-boar", "the boar's theme replaces the loop")
    assert(score.step(mut sch, fight, 11) == "", "and holds")
    assert(score.step(mut sch, fight, 26) == "boss-boar", "the theme loops at its 16 ticks")
    assert(
        score.step(mut sch, scene(0), 30) == "shingle",
        "the area's loop returns when the boss falls",
    )
}

fn test_cb03_the_death_sting_stops_the_loop_and_is_never_cut() {
    var sch = score.schedule(cues())
    let _first = score.step(mut sch, scene(0), 0)
    var fallen = scene(0)
    fallen.fallen = true
    assert(score.step(mut sch, fallen, 5) == "death", "the sting replaces the loop at the fall")
    // The wake comes before the sting ends (the fall is 30 ticks, the
    // sting 12 here): the loop waits for its end.
    var t = 6
    while t < 17 {
        assert(score.step(mut sch, scene(0), t) == "", "the sting sounds through: tick {t}")
        t += 1
    }
    assert(
        score.step(mut sch, scene(0), 17) == "shingle",
        "the area resumes at the den once it has",
    )
    // A sting that ended is not restarted while the scene still falls.
    var sch2 = score.schedule(cues())
    assert(score.step(mut sch2, fallen, 0) == "death", "cued")
    assert(score.step(mut sch2, fallen, 12) == "" && score.step(mut sch2, fallen, 40) == "", "once")
}

fn test_cb03_the_den_rests_and_the_loop_resumes() {
    var sch = score.schedule(cues())
    let _first = score.step(mut sch, scene(0), 0)
    var den = scene(0)
    den.den = true
    assert(score.step(mut sch, den, 3) == "den", "the den's rest")
    assert(score.step(mut sch, den, 13) == "den", "it loops while the cub rests")
    assert(score.step(mut sch, scene(0), 15) == "shingle", "the area's loop resumes on leaving")
}

fn test_cb03_the_title_plays_over_the_opening() {
    var sch = score.schedule(cues())
    var opening = scene(0)
    opening.title = true
    assert(score.step(mut sch, opening, 0) == "title", "the title")
    assert(score.step(mut sch, scene(0), 9) == "shingle", "the area's part when the scene ends")
}

fn test_cb03_a_slot_without_a_part_is_the_silence() {
    var sch = score.schedule(cues())
    let _first = score.step(mut sch, scene(0), 0)
    // An area id past the thirteen is `none`; a part the schedule does
    // not know (these test cues have no `teeth`) is the silence too.
    assert(score.step(mut sch, scene(13), 4) == "silence", "no fourteenth area: the silence")
    assert(score.step(mut sch, scene(13), 5) == "", "silence holds")
    assert(score.step(mut sch, scene(3), 6) == "", "a part the schedule lacks is the same silence")
    assert(score.step(mut sch, scene(0), 8) == "shingle", "back in the Shingle")
    score.restart(mut sch)
    assert(score.step(mut sch, scene(0), 9) == "shingle", "a restart cues the scene's part afresh")
}

fn test_cb03_the_replay_scenes_cover_the_schedule() {
    // The golden's six seconds: the title, the Shingle, a den, the
    // Shingle, the boar, a fall, the wake; cued in that order.
    var sch = score.schedule(cues())
    var cued = ""
    var t = 0
    while t < score.REPLAY_TICKS {
        let c = score.step(mut sch, score.replay_scene(t), t)
        if c != "" && !cued.ends_with(" {c}") { cued = "{cued} {c}" }
        t += 1
    }
    assert(
        cued == " title shingle den shingle boss-boar death shingle",
        "the replay's cues in order:{cued}",
    )
}

fn has(names: List[str], name: str) -> bool {
    for n in names {
        if n == name { return true }
    }
    false
}

fn test_cb17_every_area_and_moment_has_a_part_in_the_bank() {
    let bank = score.names()
    var area = 0
    while area < forest.AREAS {
        let p = score.area_part(area)
        assert(has(bank, p), "area {area} ({forest.name(area)}) cues {p}, a part the bank holds")
        area += 1
    }
    var m = score.MOMENT_REVEAL
    while m <= score.MOMENT_WALK {
        assert(
            has(bank, score.moment_part(m)),
            "moment {m}'s part {score.moment_part(m)} is in the bank",
        )
        m += 1
    }
    assert(score.moment_part(score.MOMENT_HUSH_WAIT) == "silence", "the Hush's wait is the silence")
    assert(has(bank, "moonford"), "Moonford's part is in the bank")
    assert(score.wav_names().len == 26, "the live sink writes 25 parts and the silence")
}

fn test_cb17_the_new_parts_parse_at_their_written_lengths() {
    assert(length_of("cinderwick") == 20, "Cinderwick: 8 bars of 3/4 at 72")
    assert(length_of("stand") == 24, "the Stand: 6 bars of 4/4 at 60")
    assert(length_of("burn") == 21, "the Burn: 7 bars of 4/4 at 80")
    assert(length_of("teeth") == 16, "the Teeth: 6 bars of 4/4 at 90")
    assert(length_of("underteeth") == 24, "the Underteeth: 5 bars of 4/4 at 50")
    assert(length_of("mere") == 24, "the Mere: 6 bars of 4/4 at 60")
    assert(length_of("shallows") == 20, "the Shallows: 12 bars of 3/4 at 108")
    assert(length_of("hush") == 24, "the Hush: 6 bars of 4/4 at 60")
    assert(length_of("howe") == 20, "the Howe: 8 bars of 3/4 at 72")
    assert(length_of("gravehollow") == 20, "Gravehollow: 5 bars of 4/4 at 60")
    assert(length_of("moonford") == 20, "Moonford: 6 bars of 4/4 at 72")
    assert(length_of("reveal") == 8, "the reveal: 3 bars of 4/4 at 90")
    assert(length_of("crossing") == 12, "the crossing: 3 bars of 4/4 at 60")
    assert(length_of("walk") == 16, "the walk: 4 bars of 4/4 at 60")
    assert(score.plays_once("reveal") && score.holds("reveal"), "the reveal plays once and holds")
    assert(score.plays_once("crack") && !score.holds("crack"), "the crack is cut by a skip")
    assert(!score.plays_once("moonford") && !score.plays_once("walk"), "Moonford and the walk loop")
}

fn play(area: int) -> sim.Sim {
    var s = sim.new(1, 80, 24)
    s.scene = 0
    s.area = area
    s.tick = 1000
    s.entered = 0
    s
}

fn at_row(mut s: sim.Sim, row: int) {
    s.y = (forest.origin(s.seed, s.area) + row) * sim.FP + sim.FP / 2
}

fn test_cb17_the_moments_are_read_from_the_ground() {
    // The lookout's reveal: sixty ticks from the cub's arrival.
    var stand = play(forest.STAND)
    assert(score.moment_of(stand) == score.MOMENT_NONE, "the Stand before the lookout")
    stand.reveal_at = stand.tick
    assert(score.moment_of(stand) == score.MOMENT_REVEAL, "the reveal")
    assert(score.want(score.scene_of(stand)) == "reveal", "the reveal's part")
    stand.tick += sim.REVEAL_TICKS
    assert(score.moment_of(stand) == score.MOMENT_NONE, "the reveal over")
    // The Mere's crossing: between the causeways (60 rows each end).
    var mere = play(forest.MERE)
    at_row(mut mere, 60)
    assert(score.want(score.scene_of(mere)) == "mere", "the first causeway is the Mere's")
    at_row(mut mere, 61)
    assert(score.want(score.scene_of(mere)) == "crossing", "the first stone row is the crossing")
    at_row(mut mere, 110)
    assert(score.want(score.scene_of(mere)) == "crossing", "the dry island is on the way across")
    at_row(mut mere, forest.length(forest.MERE) - 61)
    assert(score.want(score.scene_of(mere)) == "crossing", "the last row short of the causeway")
    at_row(mut mere, forest.length(forest.MERE) - 60)
    assert(score.want(score.scene_of(mere)) == "mere", "the far causeway")
    // The Howe's walk: from the fourth standing stone to the mouth.
    var howe = play(forest.HOWE)
    at_row(mut howe, forest.menhir_row(3) - 1)
    assert(score.want(score.scene_of(howe)) == "howe", "the barrows")
    at_row(mut howe, forest.menhir_row(3))
    assert(score.want(score.scene_of(howe)) == "walk", "the walk past the fourth stone")
    let (gate, _) = forest.gate_rows(forest.HOWE)
    at_row(mut howe, gate)
    assert(score.want(score.scene_of(howe)) == "walk", "the walk at the stone mouth")
    // The other areas have no moment.
    var shingle = play(forest.SHINGLE)
    at_row(mut shingle, 100)
    assert(score.moment_of(shingle) == score.MOMENT_NONE, "the Shingle has none")
}

fn test_cb17_the_hush_waits_in_silence_while_its_den_is_unlit() {
    // R-cb17-1 A: 300 ticks of the silence after an entry while the cold
    // den is unlit, then the shadows' motif; once lit, the motif at once.
    var s = play(forest.HUSH)
    s.entered = s.tick
    assert(!score.den_lit(s.lit_dens, score.HUSH_DEN), "the cold den starts unlit")
    assert(score.want(score.scene_of(s)) == "silence", "the first entry is silent")
    s.tick = s.entered + score.HUSH_WAIT - 1
    assert(score.want(score.scene_of(s)) == "silence", "silent through tick 299")
    s.tick = s.entered + score.HUSH_WAIT
    assert(score.want(score.scene_of(s)) == "hush", "then the shadows' motif")
    s.lit_dens = sim.light_den(s.lit_dens, score.HUSH_DEN)
    s.entered = s.tick
    assert(score.den_lit(s.lit_dens, score.HUSH_DEN), "lit")
    assert(score.want(score.scene_of(s)) == "hush", "with the den lit, the motif at once")
    var other = play(forest.HOWE)
    other.entered = other.tick
    assert(score.want(score.scene_of(other)) == "howe", "no wait outside the Hush")
}

fn test_cb17_the_end_is_moonford_not_the_title() {
    var s = play(forest.GRAVEHOLLOW)
    assert(score.want(score.scene_of(s)) == "gravehollow", "Gravehollow outside the fight")
    s.scene = sim.SCENE_END
    s.scene_started = s.tick
    let sc = score.scene_of(s)
    assert(sc.end && !sc.title, "the end is not the title")
    assert(score.want(sc) == "moonford", "the end plays Moonford")
    s.scene = sim.SCENE_TITLE
    assert(score.want(score.scene_of(s)) == "title", "the title is still the title")
}

fn test_cb17_the_reveal_holds_to_its_end_and_a_fall_cuts_it() {
    let cs = [
        score.Cue { name: "stand", ticks: 30, once: false },
        score.Cue { name: "reveal", ticks: 24, once: true },
        score.Cue { name: "death", ticks: 12, once: true },
        score.Cue { name: "silence", ticks: 6, once: false },
    ]
    var sch = score.schedule(cs)
    let stand = scene(forest.STAND)
    var reveal = scene(forest.STAND)
    reveal.moment = score.MOMENT_REVEAL
    assert(score.step(mut sch, stand, 0) == "stand", "the Stand")
    assert(score.step(mut sch, reveal, 5) == "reveal", "the reveal replaces the Stand")
    assert(score.step(mut sch, stand, 10) == "", "the camera is back; the reveal holds")
    assert(score.step(mut sch, stand, 28) == "", "and sounds through its 24 ticks")
    assert(score.step(mut sch, stand, 29) == "stand", "then the Stand's loop returns")
    var sch2 = score.schedule(cs)
    let _first = score.step(mut sch2, reveal, 0)
    var fallen = scene(forest.STAND)
    fallen.fallen = true
    assert(score.step(mut sch2, fallen, 3) == "death", "a fall cuts the reveal")
}

fn test_cb17_every_scene_script_fits_the_mixer_and_cues_its_part() {
    let cs = score.cues() else |_| {
        assert(false, "every part parses")
        List[score.Cue]()
    }
    for name in score.scene_names() {
        assert(score.scene_ticks(name) > 0, "{name} has ticks")
        let bank = score.scene_bank_with(name, cs)
        assert(
            bank.len >= 1 && bank.len <= score.BANK_MAX,
            "{name}'s bank fits the mixer: {bank.len}",
        )
        if name != "six" { assert(has(bank, name), "{name}'s script cues {name}") }
    }
    let six = score.scene_bank_with("six", cs)
    assert(six.len == 5, "the six-second replay reaches five cues: {six.len}")
    assert(score.scene_ticks("none") == 0 && score.script("none").len == 0, "no such script")
}

fn joined(lines: List[str]) -> str {
    var out = ""
    for l in lines { out = out + l + ";" }
    out
}

fn test_cb17_the_trigger_scripts_cue_in_order() {
    let cs = score.cues() else |_| {
        assert(false, "every part parses")
        List[score.Cue]()
    }
    let reveal = joined(score.scene_cues_with("reveal", cs))
    assert(
        reveal == "tick 0 cue stand;tick 30 cue reveal;tick 270 cue stand;",
        "the reveal holds its eight seconds: {reveal}",
    )
    assert(
        joined(score.scene_cues_with("crossing", cs)) ==
            "tick 0 cue mere;tick 75 cue crossing;tick 165 cue mere;",
        "the crossing in and out, each change settled",
    )
    assert(
        joined(score.scene_cues_with("walk", cs)) ==
            "tick 0 cue howe;tick 75 cue walk;tick 135 cue gravehollow;",
        "the walk to the mouth: settled in, the mouth at once",
    )
    assert(
        joined(score.scene_cues_with("gravehollow", cs)) ==
            "tick 0 cue walk;tick 30 cue gravehollow;tick 120 cue boss-alpha;tick 180 cue gravehollow;",
        "Gravehollow around the alpha's fight",
    )
    assert(
        joined(score.scene_cues_with("moonford", cs)) ==
            "tick 0 cue gravehollow;tick 30 cue moonford;",
        "the end",
    )
    let hush = joined(score.scene_cues_with("hush", cs))
    assert(
        hush ==
            "tick 0 cue shallows;tick 45 cue silence;tick 105 cue silence;tick 165 cue silence;tick 225 cue silence;tick 285 cue silence;tick 345 cue hush;tick 405 cue den;tick 450 cue hush;",
        "the Hush's first entry, its den, and leaving it lit: {hush}",
    )
    assert(
        joined(score.scene_cues_with("cinderwick", cs)) ==
            "tick 0 cue shingle;tick 45 cue cinderwick;",
        "an area's entry",
    )
}

fn test_cb17_a_ground_change_settles_before_it_sounds() {
    // The census's finding: the walker's sway across the fourth stone's
    // row cued walk, howe, walk within eight ticks. A change between an
    // area's ground parts sounds only when it has held SETTLE ticks; an
    // area change sounds at once.
    let cs = [
        score.Cue { name: "howe", ticks: 30, once: false },
        score.Cue { name: "walk", ticks: 30, once: false },
        score.Cue { name: "gravehollow", ticks: 30, once: false },
        score.Cue { name: "silence", ticks: 6, once: false },
    ]
    var sch = score.schedule(cs)
    let howe = scene(forest.HOWE)
    var walk = scene(forest.HOWE)
    walk.moment = score.MOMENT_WALK
    assert(score.step(mut sch, howe, 0) == "howe", "the barrows")
    assert(score.step(mut sch, walk, 5) == "", "past the stone: settling")
    assert(score.step(mut sch, howe, 8) == "", "back over the line: no restart")
    var t = 10
    while t < 40 {
        let want = if t == 30 then "howe" else ""
        assert(
            score.step(mut sch, walk, t) == want,
            "settling at {t}: the Howe's loop only at its length",
        )
        t += 1
    }
    assert(
        score.step(mut sch, walk, 40) == "walk",
        "the walk once it has held {score.SETTLE} ticks",
    )
    assert(
        score.step(mut sch, scene(forest.GRAVEHOLLOW), 41) == "gravehollow",
        "an area change at once",
    )
    assert(
        score.ground("crossing", forest.MERE) && !score.ground("crossing", forest.HOWE),
        "the crossing is the Mere's",
    )
    assert(
        score.ground("hush", forest.HUSH) && !score.ground("silence", forest.HUSH),
        "the Hush's wait is no ground part",
    )
}
