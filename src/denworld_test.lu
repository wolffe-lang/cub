//! member: false

use grid
use replay
use restscene
use sim
use walker

fn key(k: int) -> List[int] {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    keys
}

fn live(s: sim.Sim) -> int {
    var n = 0
    for f in s.foes { if f.health > 0 { n += 1 } }
    n
}

fn test_cb04f_slain_survive_path_and_log() {
    var s = sim.new(1, 80, 24)
    // The first Shingle foe bitten dead by the test walker's ordinary keys
    // (cb05 moved the Shingle's curve under cb04f's hand-recorded keys; the
    // walker presses the same keys, no health or foe mutation).
    var r = replay.new(1, 1, 80, 24)
    var t = 0
    while t < 2400 && s.foes[0].health > 0 && s.action != sim.FALL {
        walker.drive(mut s, mut r, s.foes[0].x, s.foes[0].y)
        t += 1
    }
    assert(s.foes[0].health <= 0, "witness killed first Shingle foe with a bite")
    let remaining = live(s)
    s.gate_open = true
    assert(sim.cross_edge(mut s, 0), "path to Cinderwick (the gate opens on the town since cb05)")
    assert(sim.cross_edge(mut s, 0), "path back to the Shingle")
    assert(live(s) == remaining, "cb04f path must not revive slain Shingle foe")
    sim.open_shortcut(mut s, 2)
    assert(sim.cross_edge(mut s, 2), "open log to Bramblehold")
    assert(sim.cross_edge(mut s, 2), "open log to Shingle")
    assert(live(s) == remaining, "cb04f log must not revive slain Shingle foe")
}

fn test_cb04f_ledger_centre_at_three_sizes() {
    for cols in [80, 120, 200] {
        let rows = if cols == 80 then 24 else if cols == 120 then 40 else 60
        let s = sim.new(7, cols, rows)
        let w = restscene.panel_width(s)
        let h = restscene.panel_height(s)
        let left = restscene.panel_left(s)
        let top = (rows - h) / 2
        assert(left + w / 2 == cols / 2 - cols / 6, "cb04f ledger centre is one sixth left")
        assert(top + h / 2 == rows / 2, "cb04f ledger vertically centred")
        assert(left >= 0 && left + w <= cols && top >= 0 && top + h <= rows, "whole ledger")
        for tier in [0, 1] {
            var g = grid.new(rows, cols)
            restscene.menu(s, tier, mut g)
            let border = if tier == 0 then 124 else 0x2502
            assert(grid.at(g, top + 2, left).cp == border, "measured rendered left border")
            assert(grid.at(g, top + 2, left + w - 1).cp == border, "measured rendered right border")
        }
    }
}

fn test_cb04f_narrow_ledger_does_not_slice_scene_labels() {
    let s = sim.new(7, 80, 24)
    for tier in [0, 1] {
        var g = grid.new(24, 80)
        restscene.render(s, tier, mut g)
        restscene.menu(s, tier, mut g)
        let left = restscene.panel_left(s) + restscene.panel_width(s) + 2
        assert(
            grid.at(g, 1, left).cp == 84 && grid.at(g, 1, left + 13).cp == 103,
            "whole hollow-log name beside ledger",
        )
        assert(
            grid.at(g, 2, left).cp == 84 && grid.at(g, 2, left + 10).cp == 101,
            "whole regional name beside ledger",
        )
    }
}
