//! member: false
//! cb06: timing, material separation, blinking and score synchronisation.

use art
use controls
use grid
use forest
use terrain
use sprites
use silhouette
use score
use sim
use tier

fn test_cb06_shots_and_whole_scene_skip() {
    let starts = [0, 210, 225, 300, 330, 360, 420, 480, 510, 600, 660, 720, 765, 789, 810, 840]
    var index = 0
    for age in starts {
        assert(sim.opening_shot(age) == index, "shot {index} starts at {age}")
        var s = sim.new(1, 80, 24)
        sim.opening(mut s)
        s.tick = age
        let x = s.x
        let y = s.y
        sim.step(mut s, [controls.KEY_RIGHT])
        assert(s.scene == 0 && s.opening_seen, "one key skips shot {index}")
        assert(s.x == x && s.y == y, "skip is not a move")
        index += 1
    }
    var s = sim.new(1, 80, 24)
    sim.opening(mut s)
    var i = 0
    while i < sim.OPENING_TICKS {
        assert(s.scene == 1 && !s.opening_seen, "opening still active at {i}")
        sim.step(mut s, List[int]())
        i += 1
    }
    assert(s.scene == 0 && s.opening_seen && s.area == 0, "900 ticks land on the Shingle")
}

fn test_cb06_sky_ice_water_are_disjoint_cell_styles() {
    for t in [tier.PLAIN, tier.RICH] {
        var a = 0
        while a < 3 {
            var b = a + 1
            while b < 3 {
                var i = 0
                while i < 4 {
                    var j = 0
                    while j < 4 {
                        let x = art.opening_material(t, a, i)
                        let y = art.opening_material(t, b, j)
                        assert(
                            x.fg != y.fg || x.bg != y.bg || x.attrs != y.attrs,
                            "sky ice and water cannot share a style",
                        )
                        j += 1
                    }
                    i += 1
                }
                b += 1
            }
            a += 1
        }
    }
}

fn test_cb06_first_blink_never_opens_fully() {
    assert(art.opening_aperture(510) == 0, "first waking frame is black")
    var age = 510
    while age < 660 {
        assert(art.opening_aperture(age) <= 60, "first blink stays narrow and dim")
        age += 1
    }
    assert(art.opening_aperture(600) == 60, "first peak is partial")
    assert(art.opening_aperture(720) == 80, "second peak is wider")
    assert(art.opening_aperture(789) == 95, "third peak almost wakes")
    assert(art.opening_aperture(840) == 100, "final view fully awake")
}

fn test_cb06_crack_frame_has_the_cue() {
    var s = sim.new(1, 80, 24)
    sim.opening(mut s)
    s.tick = 209
    assert(score.want(score.scene_of(s)) == "title", "crossing keeps title")
    s.tick = 210
    assert(score.want(score.scene_of(s)) == "crack", "first crack cues the shock on the same tick")
    s.tick = 359
    assert(score.want(score.scene_of(s)) == "crack", "hold through the spreading cracks")
    s.tick = 360
    assert(score.want(score.scene_of(s)) == "silence", "sting ends at the drop")
    s.tick = 510
    assert(score.want(score.scene_of(s)) == "shingle", "waking hears the shore")
    var sch = score.schedule(
        [
            score.Cue { name: "crack", ticks: 150, once: true },
            score.Cue { name: "shingle", ticks: 720, once: false },
        ],
    )
    s.tick = 210
    assert(score.step(mut sch, score.scene_of(s), s.tick) == "crack", "start sting")
    sim.step(mut s, [controls.KEY_RIGHT])
    assert(
        score.step(mut sch, score.scene_of(s), s.tick) == "shingle",
        "skip cuts sting immediately",
    )
}

fn test_cb06_clear_view_is_the_actual_spawn() {
    var s = sim.new(1, 80, 24)
    sim.opening(mut s)
    s.tick = 840
    var a = grid.new(24, 80)
    var b = grid.new(24, 80)
    art.opening_frame(s, tier.PLAIN, mut a)
    s.scene = 0
    art.render(s, tier.PLAIN, mut b)
    var i = 0
    while i < a.cells.len {
        assert(grid.same(a.cells[i], b.cells[i]), "final shot is the actual spawn cell {i}")
        i += 1
    }
}

fn test_cb06_cub_freezes_while_the_pack_walks() {
    for t in [tier.PLAIN, tier.RICH] {
        var s = sim.new(1, 80, 24)
        sim.opening(mut s)
        var a = grid.new(24, 80)
        var b = grid.new(24, 80)
        s.tick = 210
        art.opening_frame(s, t, mut a)
        s.tick = 260
        art.opening_frame(s, t, mut b)
        var r = 12
        while r <= 14 {
            var c = 26
            while c <= 31 {
                assert(
                    grid.same(grid.at(a, r, c), grid.at(b, r, c)),
                    "cub holds still during shock",
                )
                c += 1
            }
            r += 1
        }
        var changed = 0
        r = 8
        while r < 12 {
            var c = 40
            while c < 80 {
                if !grid.same(grid.at(a, r, c), grid.at(b, r, c)) { changed += 1 }
                c += 1
            }
            r += 1
        }
        assert(changed > 10, "pack keeps walking during cub's freeze")
    }
}

fn test_cb06_rendered_wolves_contrast_with_ice_and_water() {
    for t in [tier.PLAIN, tier.RICH] {
        for age in [120, 440] {
            var s = sim.new(1, 80, 24)
            sim.opening(mut s)
            s.tick = age
            var g = grid.new(24, 80)
            art.opening_frame(s, t, mut g)
            var count = 0
            let bg = if age == 120 {
                (if t == tier.RICH then 153 else 7)
            } else {
                (if t == tier.RICH then 17 else 4)
            }
            let fg = if age == 120 {
                (if t == tier.RICH then 52 else 0)
            } else {
                sprites.palette(t, sprites.C_FUR)
            }
            for cell in g.cells {
                if cell.bg == bg &&
                    cell.attrs == (if t == tier.RICH then 0 else grid.ATTR_BOLD) &&
                    cell.cp != 32 &&
                    cell.fg != art.opening_material(t, if age == 120 then 1 else 2, 0).fg {
                    assert(cell.fg == fg, "rendered fur must contrast with its actual ground")
                    count += 1
                }
            }
            assert(count >= 8, "witness must contain a visible wolf")
            if t == tier.PLAIN { assert(grid.plain_ok(g), "contrast keeps plain palette") }
        }
    }
}

fn opening_pair_in(cells: List[grid.Cell], value: grid.Cell) -> bool {
    for cell in cells { if grid.same(cell, value) { return true } }
    false
}

fn check_opening_banks(size: int, t: int) {
    let cols = if size == 24 then 80 else if size == 40 then 120 else 200
    let s = sim.new(1, cols, size)
    let (top, bottom) = art.opening_ice_rows(size)
    let shore = art.opening_shore_rows(size)
    assert(shore == (if size == 24 then 5 else 7), "coast scale follows the Shingle")

    var scene = copy s
    sim.opening(mut scene)
    scene.tick = 120
    var g = grid.new(size, cols)
    art.opening_frame(scene, t, mut g)
    var gravel_pairs = List[grid.Cell]()
    var forest_pairs = List[grid.Cell]()
    var row = 3
    while row < size {
        if row >= top && row < bottom { row += 1; continue }
        var col = 0
        while col < cols {
            let (x, y) = art.opening_bank_source(s, row, col)
            let kind = forest.kind(s.seed, s.field, forest.SHINGLE, x, y)
            let gravel = row >= top - shore && row < top || row >= bottom && row < bottom + shore
            assert(
                if gravel {
                    kind == terrain.GRAVEL
                } else {
                    kind == terrain.TRUNK || kind == terrain.DARK
                },
                "both banks have real Shingle gravel then thick forest",
            )
            let expected = art.ground_at(s.seed, s.field, forest.SHINGLE, t, x, y)
            if gravel {
                if !opening_pair_in(gravel_pairs, expected) { (mut gravel_pairs).push(expected) }
            } else if !opening_pair_in(forest_pairs, expected) {
                (mut forest_pairs).push(expected)
            }
            assert(
                grid.same(art.opening_bank_cell(s, t, row, col), expected),
                "bank source pair is emitted by the world's renderer",
            )
            assert(
                grid.same(grid.at(g, row, col), expected),
                "the actual crossing uses the shared cell",
            )
            col += 7
        }
        row += 1
    }
    // Check every displayed land cell against pairs independently emitted
    // by the Shingle's renderer, not just the coordinate samples above.
    row = 3
    while row < size {
        if row >= top && row < bottom { row += 1; continue }
        let gravel = row >= top - shore && row < top || row >= bottom && row < bottom + shore
        var col = 0
        while col < cols {
            assert(
                if gravel {
                    opening_pair_in(gravel_pairs, grid.at(g, row, col))
                } else {
                    opening_pair_in(forest_pairs, grid.at(g, row, col))
                },
                "every opening bank/forest glyph-style pair belongs to the Shingle",
            )
            col += 1
        }
        row += 1
    }
}

fn test_cb06_both_shingle_banks_24_plain() { check_opening_banks(24, tier.PLAIN) }

fn test_cb06_both_shingle_banks_24_rich() { check_opening_banks(24, tier.RICH) }

fn test_cb06_both_shingle_banks_40_plain() { check_opening_banks(40, tier.PLAIN) }

fn test_cb06_both_shingle_banks_40_rich() { check_opening_banks(40, tier.RICH) }

fn test_cb06_both_shingle_banks_60_plain() { check_opening_banks(60, tier.PLAIN) }

fn test_cb06_both_shingle_banks_60_rich() { check_opening_banks(60, tier.RICH) }

fn test_cb06_opening_wolves_are_the_game_silhouettes() {
    for t in [tier.PLAIN, tier.RICH] {
        for small in [true, false] {
            for material in [1, 2] {
                var actual = grid.new(24, 80)
                var expected = grid.new(24, 80)
                var i = 0
                while i < actual.cells.len {
                    actual.cells[i] = art.opening_material(t, material, 0)
                    expected.cells[i] = art.opening_material(t, material, 0)
                    i += 1
                }
                art.opening_wolf(mut actual, t, 12, 40, small, 2)
                if small {
                    art.draw_pose(mut expected, t, 12, 40, 2, 0, 1, 2, 0, true, 0, 0)
                } else {
                    art.draw_wolf(mut expected, t, 12, 40, 2, 0, 1, 2)
                }
                let (w, h) = if small then silhouette.cub_size() else silhouette.wolf_size()
                let (dc, dr, width, height) = silhouette.footprint(w, h, 1)
                var drawn = 0
                i = 0
                while i < expected.cells.len {
                    var want = copy expected.cells[i]
                    if want.fg == sprites.palette(t, sprites.C_FUR) {
                        drawn += 1
                        let row = i / 80
                        let col = i % 80
                        assert(
                            row >= 12 + dr &&
                                row < 12 + dr + height &&
                                col >= 40 + dc &&
                                col < 40 + dc + width,
                            "shared sprite stays in its physical footprint",
                        )
                        if material == 1 { want.fg = if t == tier.RICH then 52 else 0 }
                    }
                    assert(
                        grid.same(actual.cells[i], want),
                        "opening reuses every in-game sprite cell, only ice shade changes",
                    )
                    i += 1
                }
                assert(drawn > 0, "sprite witness is nonempty")
            }
        }
    }
}
