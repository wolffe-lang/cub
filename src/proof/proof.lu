//! A deterministic real-key route witness (the walker is `walker`). The
//! only numeric fixture inputs are starting scent for growth, the
//! deliberate cross-area death, and cb04's journey snapshots that start a
//! boss witness at its area's den.

use controls
use fight
use forest
use journey
use replay
use sim
use town
use std.fs
use walker

fn snapshot(dir: str, name: str, s: sim.Sim, r: replay.Replay) -> () ! {io} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else |_| { return io }
    fs.append_text(dir + "/" + name + ".pk", "\n# frames {s.tick} every {s.tick}\n") else |_| {
        return io
    }
    print(
        "witness {name} tick {s.tick} area {s.area} scent {s.scent} mark {s.mark_scent} shortcuts {s.shortcuts}",
    )
}

/// A witness whose frames start at tick `from`, one a tick.
fn snapshot_from(dir: str, name: str, s: sim.Sim, r: replay.Replay, from: int) -> () ! {io} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else |_| { return io }
    fs.append_text(dir + "/" + name + ".pk", "\n# frames {s.tick} every 1 from {from}\n") else |_| {
        return io
    }
    print("witness {name} tick {s.tick} from {from} area {s.area}")
}

/// Generate replayable key witnesses for the whole connected journey.
pub fn generate(dir: str) -> int {
    fs.create_dir_all(dir) else |_| { return 2 }
    var s = sim.new(1, 80, 24)
    var r = replay.new(1, 1, 80, 24)
    replay.push_arg(mut r, 0, 1, 10000)
    s.scent = 10000
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    var stat = 0
    while stat < 3 {
        var n = 0
        while n < 9 { walker.press(mut s, mut r, walker.key(controls.KEY_RIGHT)); n += 1 }
        walker.press(mut s, mut r, walker.key(controls.KEY_DOWN))
        stat += 1
    }
    walker.press(mut s, mut r, walker.key(controls.KEY_DOWN))
    walker.press(mut s, mut r, walker.key(controls.KEY_DOWN))
    walker.press(mut s, mut r, walker.key(controls.KEY_CONFIRM))
    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
    let (spring_x, spring_y) = sim.spring_position(s.seed, 0)
    if !walker.walk(mut s, mut r, spring_x, spring_y) || s.flask_max != 2 {
        eprint("proof: first spring not discovered")
        return 1
    }
    snapshot(dir, "spring-found", s, r) else { return 2 }
    if !walker.walk(mut s, mut r, 0, (sim.gate_y(s) - 2) * sim.FP) {
        eprint("proof: gate approach at {sim.cell_x(s)},{sim.cell_y(s)} tick {s.tick}")
        return 1
    }
    snapshot(dir, "world-gate", s, r) else |_| { return 2 }
    var keys = walker.key(controls.KEY_DOWN)
    (mut keys).push(controls.KEY_BITE)
    walker.press(mut s, mut r, keys)
    var n = 0
    while n < 16 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
    snapshot(dir, "world-thorns", s, r) else |_| { return 2 }
    keys = walker.key(controls.KEY_DOWN)
    (mut keys).push(controls.KEY_LUNGE)
    walker.press(mut s, mut r, keys)
    n = 0
    var broke = false
    while n < 25 {
        walker.press(mut s, mut r, walker.key(0))
        // The tick after the thorns give: the gate's own witness.
        if s.gate_open && !broke {
            broke = true
            walker.press(mut s, mut r, walker.key(0))
            n += 1
            snapshot(dir, "thorn-gate", s, r) else |_| { return 2 }
        }
        n += 1
    }
    if !s.gate_open { eprint("proof: gate did not open"); return 1 }
    snapshot(dir, "world-open", s, r) else |_| { return 2 }
    let (ex, ey) = forest.portal(s.seed, 0, 0)
    if !walker.walk(mut s, mut r, ex, ey) || s.area != forest.TOWN {
        eprint("proof: the town's gate")
        return 1
    }
    // Cinderwick (cb05): down the lane past the Ashen to the way on, the
    // cold hearth rested at on the way.
    let (hx, hy) = forest.den_position(s.seed, 7)
    if !walker.walk(mut s, mut r, hx, hy) { eprint("proof: the cold hearth"); return 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    if !s.den || s.last_den != 7 { eprint("proof: no rest at the hearth"); return 1 }
    snapshot(dir, "town-den", s, r) else |_| { return 2 }
    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
    let (tx, ty) = forest.portal(s.seed, forest.TOWN, 9)
    if !walker.walk(mut s, mut r, tx, ty) || s.area != 1 { eprint("proof: thicket edge"); return 1 }
    let (dx, dy) = forest.den_position(s.seed, 1)
    if !walker.walk(mut s, mut r, dx, dy) { eprint("proof: thicket den"); return 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    if !s.den || s.last_den != 1 { eprint("proof: no rest"); return 1 }
    snapshot(dir, "world-den", s, r) else |_| { return 2 }
    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
    let (mx, my) = forest.portal(s.seed, 1, 1)
    if !walker.walk(mut s, mut r, mx, my) || s.area != 2 { eprint("proof: meadow edge"); return 1 }
    snapshot(dir, "world-meadow", s, r) else |_| { return 2 }
    let hawk_x = s.foes[0].x
    let hawk_y = s.foes[0].y
    // Walk to the hawk's ground until its shadow stops over the cub.
    if !walker.walk_stop(mut s, mut r, hawk_x, hawk_y, 0, false) {
        eprint("proof: hawk approach")
        return 1
    }
    n = 0
    var shadow_at = if s.foes[0].phase == sim.CROUCH then s.tick else -1
    var stooped = false
    while s.foes[0].health > 0 && n < 300 {
        walker.drive(mut s, mut r, hawk_x, hawk_y)
        // The hawk's two witnesses: its shadow stopped (three ticks into
        // the tell), and the stoop (with the two ticks before it).
        if shadow_at < 0 && s.foes[0].phase == sim.CROUCH { shadow_at = s.tick }
        if shadow_at >= 0 && s.tick == shadow_at + 3 {
            snapshot_from(dir, "hawk-shadow", s, r, shadow_at) else |_| { return 2 }
        }
        if !stooped && (s.foes[0].phase == sim.STRIKE || s.foes[0].health <= 0) {
            stooped = true
            snapshot_from(dir, "hawk-stoop", s, r, s.tick - 2) else |_| { return 2 }
        }
        n += 1
    }
    if s.foes[0].health > 0 || shadow_at < 0 { eprint("proof: hawk unanswered"); return 1 }
    snapshot(dir, "world-hawk", s, r) else |_| { return 2 }
    replay.push_arg(mut r, s.tick, 0, -1000)
    sim.hurt(mut s, 1000)
    walker.press(mut s, mut r, walker.key(0))
    n = 0
    while n < 30 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
    if s.area != 1 || !s.mark || s.mark_area != 2 { eprint("proof: cross-area death"); return 1 }
    if !walker.walk(mut s, mut r, mx, my) || s.area != 2 {
        eprint("proof: return to mark area")
        return 1
    }
    if !walker.walk(mut s, mut r, s.mark_x, s.mark_y) { eprint("proof: reach mark"); return 1 }
    walker.press(mut s, mut r, walker.key(0))
    if s.mark { eprint("proof: mark not recovered"); return 1 }
    snapshot(dir, "world-recovered", s, r) else |_| { return 2 }
    let (hx, hy) = forest.portal(s.seed, 2, 3)
    if !walker.walk(mut s, mut r, hx, hy) { eprint("proof: hedge approach"); return 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    if s.area != 1 || s.shortcuts != 2 { eprint("proof: hedge not opened"); return 1 }
    let (lx, ly) = forest.portal(s.seed, 1, 2)
    if !walker.walk(mut s, mut r, lx, ly) { eprint("proof: log approach"); return 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    if s.area != 0 || s.shortcuts != 3 {
        eprint("proof: log not opened area {s.area} shortcuts {s.shortcuts} at {s.x},{s.y}")
        return 1
    }
    snapshot(dir, "world-return", s, r) else |_| { return 2 }
    var cache = 0
    while cache < forest.cache_count(0) {
        let (cx, cy) = forest.cache_position(s.seed, s.field, 0, cache)
        if !walker.walk(mut s, mut r, cx, cy) {
            eprint(
                "proof: coast cache {cache} tick {s.tick} action {s.action} health {s.health} speed {s.speed} blocked {s.blocked} at {s.x},{s.y} goal {sim.floor_div(cx, sim.FP)},{sim.floor_div(cy, sim.FP)}",
            )
            for foe in s.foes {
                if sim.near(s.x, s.y, foe.x, foe.y, 5 * sim.FP) {
                    eprint(
                        "proof: foe kind {foe.kind} health {foe.health} phase {foe.phase} at {foe.x},{foe.y}",
                    )
                }
            }
            return 1
        }
        // The guard must be fought before the dig: hunt every live guard
        // within the dig's six cells, by ordinary keys.
        var guard = 0
        while guard < s.foes.len {
            var rounds = 0
            while s.foes[guard].health > 0 &&
                s.foes[guard].kind != sim.HAWK &&
                sim.near(s.foes[guard].x, s.foes[guard].y, cx, cy, 6 * sim.FP) &&
                rounds < 6 {
                let fx = s.foes[guard].x
                let fy = s.foes[guard].y
                let _ = walker.walk(mut s, mut r, fx, fy)
                var n = 0
                while s.foes[guard].health > 0 && n < 300 && s.action != sim.FALL {
                    walker.drive(mut s, mut r, s.foes[guard].x, s.foes[guard].y)
                    n += 1
                }
                rounds += 1
            }
            guard += 1
        }
        if !walker.walk(mut s, mut r, cx, cy) {
            eprint("proof: coast cache {cache} return")
            return 1
        }
        walker.press(mut s, mut r, walker.key(controls.KEY_REST))
        if !sim.cache_open(s, cache) {
            eprint(
                "proof: cache remains guarded {cache} area {s.area} at {sim.cell_x(s)},{sim.cell_y(s)} goal {cx / sim.FP},{cy / sim.FP}",
            )
            return 1
        }
        snapshot(dir, "coast-cache-{cache}", s, r) else |_| { return 2 }
        cache += 1
    }
    if encounters(dir) != 0 { return 1 }
    if sprint_witness(dir) != 0 { return 1 }
    if bosses(dir) != 0 { return 1 }
    if ghosts(dir) != 0 { return 1 }
    if areas(dir) != 0 { return 1 }
    if cinderwick(dir) != 0 { return 1 }
    if lanes(dir) != 0 { return 1 }
    if landmarks(dir) != 0 { return 1 }
    demo(dir)
}

/// Cinderwick's lane at night at the two sizes (cb05): from the cold
/// hearth, a hundred and twenty ticks down the lane, a frame every forty.
pub fn lanes(dir: str) -> int {
    for size in [(80, 24), (120, 40)] {
        let (cols, rows) = size
        let s0 = town_journey_sized(1, cols, rows)
        var s = copy s0
        var r = snapshot_replay(s0)
        walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
        var n = 0
        while n < 120 { walker.press(mut s, mut r, walker.key(controls.KEY_DOWN)); n += 1 }
        snapshot_range(dir, "town-lane-{cols}x{rows}", r, s.tick, 40, 1) else |_| { return 2 }
    }
    0
}

/// A journey at a kept den with the growth of its area's boss fight (the
/// bosses before it beaten), validated by the save's own decoder.
fn den_journey(seed: int, den: int) -> sim.Sim {
    let area = forest.den_area(den)
    let kind = if area == forest.CRAGS {
        sim.LYNX
    } else if area == forest.RIVER {
        sim.ELK
    } else if area == forest.OLDDEN {
        sim.ALPHA
    } else if area == forest.LARKMEADOW {
        sim.LYNX
    } else {
        sim.BOAR
    }
    var s = fight.journey_at(seed, 80, 24, kind)
    s.last_den = den
    s.lit_dens = sim.light_den(s.lit_dens, den)
    let text = journey.encode(s)
    journey.decode(text, 80, 24) else |e| {
        assert(false, "proof.den_journey: den {den} is not a valid save: {e}")
        s
    }
}

/// Every landmark (cb05): from the nearest kept den of its area, the walk
/// to the clearing's corner beside it, and one frame there.
pub fn landmarks(dir: str) -> int {
    let seed = 1
    var area = 1
    while area < forest.AREAS {
        var k = 0
        while k < forest.landmark_count(area) {
            let (_, lx, ly) = forest.landmark(seed, 80, area, k)
            // The kept den of the area nearest the landmark's row.
            var den = -1
            var gap = 100000
            var id = 0
            while id < forest.DEN_LIMIT {
                if forest.den_area(id) == area {
                    let g = abs(forest.den_row(seed, id) - ly)
                    if g < gap { gap = g; den = id }
                }
                id += 1
            }
            if den < 0 { eprint("proof: no den for landmark {area}-{k}"); return 1 }
            let s0 = den_journey(seed, den)
            var s = copy s0
            var r = snapshot_replay(s0)
            walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
            let o = forest.origin(seed, area)
            // The clearing's corner beside the landmark, or the cell below
            // it, or its own cell: the first open one (a yard's mark sits
            // by its back wall). Fighting what it meets on the way (a
            // pocket's guard).
            var tx = lx + 2
            var ty = ly + 1
            if forest.blocked(seed, 80, area, tx, o + ty) { tx = lx }
            if forest.blocked(seed, 80, area, tx, o + ty) { ty = ly }
            if !walker.walk(
                mut s,
                mut r,
                tx * sim.FP + sim.FP / 2,
                (o + ty) * sim.FP + sim.FP / 2,
            ) {
                eprint("proof: the walk to landmark {area}-{k}")
                return 1
            }
            var n = 0
            while n < 6 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
            snapshot_range(dir, "landmark-{area}-{k}", r, s.tick, 1, s.tick) else |_| { return 2 }
            k += 1
        }
        area += 1
    }
    0
}

/// A journey at Cinderwick's cold hearth with a little growth (heart,
/// wind and fang 3), the gate open, the first spring found: the town
/// witnesses' start, validated by the save's own decoder.
fn town_journey(seed: int) -> sim.Sim {
    town_journey_sized(seed, 80, 24)
}

/// `town_journey` at a terminal size.
fn town_journey_sized(seed: int, cols: int, rows: int) -> sim.Sim {
    var s = sim.new(seed, cols, rows)
    s.gate_open = true
    s.opening_seen = true
    s.heart = 3
    s.wind = 3
    s.fang = 3
    s.flask_max = 2
    s.flasks = 2
    s.last_den = 7
    s.lit_dens = sim.light_den(1, 7)
    let text = journey.encode(s)
    journey.decode(text, 80, 24) else |e| {
        assert(false, "proof.town_journey: the fixture is not a valid save: {e}")
        s
    }
}

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// Whether no foe stands within four cells of a cell.
fn ember_unguarded(s: sim.Sim, x: int, y: int) -> bool {
    for f in s.foes {
        if f.health > 0 &&
            sim.near(f.x, f.y, x * sim.FP + sim.FP / 2, y * sim.FP + sim.FP / 2, 4 * sim.FP) {
            return false
        }
    }
    true
}

/// Cinderwick's witnesses (cb05): a single-file passage walked into a
/// yard, an Ashen's windup parried, an ember stood on, a yard's cache dug
/// once its guard is down. Each from the cold hearth on seed 1.
pub fn cinderwick(dir: str) -> int {
    let seed = 1
    let o = forest.origin(seed, forest.TOWN)
    // 1. The passage: plot 3's east yard holds a scent mark and is reached
    // only through the one-cell passage its gap opens on; the walk from
    // the lane's verge at the passage's mouth to the mark.
    var s = town_journey(seed)
    var r = snapshot_replay(s)
    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
    let (near, _) = town.house_x(seed, 1, 3)
    let (which, _) = town.yard_gap(seed, 1, 3)
    let row = if which == 0 then town.top(3) - 1 else town.bottom(3) + 1
    let mouth_x = (near - 1) * sim.FP + sim.FP / 2
    let mouth_y = (o + row) * sim.FP + sim.FP / 2
    if !walker.walk(mut s, mut r, mouth_x, mouth_y) {
        eprint("proof: the passage's mouth")
        return 1
    }
    let from = s.tick
    let (mx, my) = town.scent_mark(seed, 0)
    if !walker.walk(mut s, mut r, mx * sim.FP + sim.FP / 2, (o + my) * sim.FP + sim.FP / 2) {
        eprint("proof: the passage to the yard's mark")
        return 1
    }
    var n = 0
    while n < 12 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
    snapshot_range(dir, "town-passage", r, s.tick, 6, from) else |_| { return 2 }
    // 2. The Ashen parried: the first yard's guard (plot 2, west; the
    // lane's Ashen stand at yard embers behind walls, where no blow
    // lands), met inside its yard, approached until its arms rise, the
    // parry two ticks before the blow, the stagger watched.
    var t = town_journey(seed)
    var q = snapshot_replay(t)
    walker.press(mut t, mut q, walker.key(controls.KEY_RELEASE))
    let (yx, yy) = forest.cache_position(seed, t.field, forest.TOWN, 0)
    // To the passage's mouth fighting what the lane sends (the walker
    // bites), then into the yard without biting, so the guard is met whole.
    let (gnear, _) = town.house_x(seed, -1, 2)
    let (gwhich, _) = town.yard_gap(seed, -1, 2)
    let grow = if gwhich == 0 then town.top(2) - 1 else town.bottom(2) + 1
    if !walker.walk(mut t, mut q, (gnear + 1) * sim.FP + sim.FP / 2, grow * sim.FP + sim.FP / 2) {
        eprint("proof: the first yard's mouth")
        return 1
    }
    if !walker.walk_stop(mut t, mut q, yx, yy - 4 * sim.FP, -1, true) {
        eprint("proof: the first yard")
        return 1
    }
    var target = -1
    var best = 1000000
    var i = 0
    while i < t.foes.len {
        let f = copy t.foes[i]
        if f.kind == sim.ASHEN && f.health > 0 {
            let d = (f.x - yx) * (f.x - yx) / sim.FP + (f.y - yy) * (f.y - yy) / sim.FP
            if d < best { best = d; target = i }
        }
        i += 1
    }
    if target < 0 || best > 8 * 8 * sim.FP { eprint("proof: no guard in the first yard"); return 1 }
    let fx = t.foes[target].x
    let fy = t.foes[target].y
    if !walker.walk_stop(mut t, mut q, fx, fy, target, true) {
        eprint("proof: the guard's approach")
        return 1
    }
    var m = 0
    var parried = false
    var windup_at = -1
    while m < 400 && !parried {
        let f = copy t.foes[target]
        if f.phase == sim.CROUCH && windup_at < 0 { windup_at = t.tick }
        var keys = List[int]()
        if f.phase == sim.CROUCH && t.tick - f.since == sim.ASHEN_WINDUP - 2 {
            (mut keys).push(controls.KEY_PARRY)
        }
        if f.phase == sim.HUNT {
            // Stand in its way, still: it hears a touch, never a standing cub.
            walker.aim(mut keys, f.x - t.x, f.y - t.y)
        }
        walker.press(mut t, mut q, keys)
        if t.foes[target].phase == sim.STAGGER { parried = true }
        m += 1
    }
    if !parried || windup_at < 0 {
        let f = copy t.foes[target]
        eprint(
            "proof: the Ashen was not parried: windup at {windup_at}, phase {f.phase}, cub {t.x / sim.FP},{t.y / sim.FP}, Ashen {f.x / sim.FP},{f.y / sim.FP}",
        )
        return 1
    }
    n = 0
    while n < 20 { walker.press(mut t, mut q, walker.key(0)); n += 1 }
    snapshot_range(dir, "ashen-parry", q, t.tick, 5, windup_at) else |_| { return 2 }
    // 3. A fire touched: an ember no Ashen stands by (they stand by the
    // square's), walked onto and stood on for forty ticks.
    var u = town_journey(seed)
    var v = snapshot_replay(u)
    walker.press(mut u, mut v, walker.key(controls.KEY_RELEASE))
    var ex = -1000
    var ey = -1000
    var k = 0
    while k < town.PLOTS && ex == -1000 {
        for side in [-1, 1] {
            let (cx, cy) = town.ember(seed, side, k)
            if cx > -1000 && ex == -1000 && ember_unguarded(u, cx, o + cy) {
                if walker.walk(
                    mut u,
                    mut v,
                    cx * sim.FP + sim.FP / 2,
                    (o + cy) * sim.FP + sim.FP / 2,
                ) {
                    ex = cx
                    ey = cy
                }
            }
        }
        k += 1
    }
    if ex == -1000 { eprint("proof: no ember to stand on"); return 1 }
    // The walker stops within half a cell of the centre; settle until the
    // body covers the ember.
    var settle = 0
    while !sim.on_ember(u) && settle < 60 {
        walker.drive(mut u, mut v, ex * sim.FP + sim.FP / 2, (o + ey) * sim.FP + sim.FP / 2)
        settle += 1
    }
    let touched = u.tick
    let health = u.health
    n = 0
    while n < 40 { walker.press(mut u, mut v, walker.key(0)); n += 1 }
    if u.health >= health {
        eprint(
            "proof: the ember did not burn: ember ({ex}, {ey}) cub cell ({sim.cell_x(u)}, {sim.cell_y(u)})",
        )
        return 1
    }
    snapshot_range(dir, "ember-touch", v, u.tick, 10, touched) else |_| { return 2 }
    // 4. A cache dug behind a guard: the first yard (plot 2, west), its
    // Ashen fought down, the heap dug.
    var w = town_journey(seed)
    var z = snapshot_replay(w)
    walker.press(mut w, mut z, walker.key(controls.KEY_RELEASE))
    let (cx, cy) = forest.cache_position(seed, w.field, forest.TOWN, 0)
    if !walker.walk(mut w, mut z, cx, cy - 4 * sim.FP) { eprint("proof: the yard"); return 1 }
    var guard = 0
    while guard < w.foes.len {
        var rounds = 0
        while w.foes[guard].health > 0 &&
            sim.near(w.foes[guard].x, w.foes[guard].y, cx, cy, 6 * sim.FP) &&
            rounds < 6 {
            var k = 0
            while w.foes[guard].health > 0 && k < 400 && w.action != sim.FALL {
                walker.drive(mut w, mut z, w.foes[guard].x, w.foes[guard].y)
                k += 1
            }
            rounds += 1
        }
        guard += 1
    }
    if w.action == sim.FALL { eprint("proof: the guard won"); return 1 }
    if !walker.walk(mut w, mut z, cx, cy) { eprint("proof: the heap"); return 1 }
    let dug = w.tick
    walker.press(mut w, mut z, walker.key(controls.KEY_REST))
    if !sim.cache_open(w, 0) { eprint("proof: the yard's cache stayed shut"); return 1 }
    n = 0
    while n < 12 { walker.press(mut w, mut z, walker.key(0)); n += 1 }
    snapshot_range(dir, "yard-cache", z, w.tick, 4, dug - 8) else |_| { return 2 }
    0
}

/// A replay that begins from a journey snapshot (cb04): `journey 2` and
/// the saved values at tick 0, as a live resume records them.
fn snapshot_replay(s: sim.Sim) -> replay.Replay {
    var r = replay.new(s.seed, 1, s.cols, s.rows)
    replay.push_arg(mut r, 0, controls.EV_JOURNEY, journey.JOURNEY)
    let v = journey.snapshot(s)
    var i = 0
    while i < v.len { replay.push_arg(mut r, 0, controls.EV_SAVED + i, v[i]); i += 1 }
    r
}

/// A witness whose frames run every `every` ticks from `from` to `to`.
fn snapshot_range(dir: str, name: str, r: replay.Replay, to: int, every: int, from: int) -> () ! {
    io,
} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else |_| { return io }
    fs.append_text(
        dir + "/" + name + ".pk",
        "\n# frames {to} every {every} from {from}\n",
    ) else |_| {
        return io
    }
    print("witness {name} frames {to} every {every} from {from}")
}

/// The boss witnesses (cb04): from each boss's den with the bible's growth,
/// the walk to the arena and the scripted fighter's winning fight (seed 1,
/// 80 by 24); three cases a boss share the keys and differ in their frames:
/// a windup, the second phase, the beaten boss fading; the alpha's fall
/// runs on into the end, its card, and the wolf at play.
pub fn bosses(dir: str) -> int {
    var kind = sim.BOAR
    while kind <= sim.ALPHA {
        let name = if kind == sim.BOAR {
            "boar"
        } else if kind == sim.LYNX {
            "lynx"
        } else if kind == sim.ELK {
            "elk"
        } else {
            "alpha"
        }
        let s0 = fight.journey_at(1, 80, 24, kind)
        var r = snapshot_replay(s0)
        let o = fight.fight_world(1, 80, 24, kind, mut r)
        if o.attempts == 0 || o.first_windup < 0 || o.beaten_at < 0 {
            eprint("proof: the fighter did not beat the {name}: attempts {o.attempts}")
            return 1
        }
        print(
            "boss {name} attempts {o.attempts} ticks {o.ticks} windup {o.first_windup} phase2 {o.phase2_at} beaten {o.beaten_at} hits {o.hits[0]} {o.hits[1]} {o.hits[2]} unparryable {o.unparryable}",
        )
        snapshot_range(
            dir,
            "boss-{name}-windup",
            r,
            o.first_windup + 7,
            1,
            o.first_windup + 5,
        ) else |_| {
            return 2
        }
        if o.phase2_at >= 0 {
            snapshot_range(
                dir,
                "boss-{name}-phase2",
                r,
                o.phase2_at + 2,
                1,
                o.phase2_at + 1,
            ) else |_| {
                return 2
            }
        }
        if kind == sim.ALPHA {
            // The end: the fade, the ford's three frames, the card, then `r`
            // and the wolf at play.
            let end_at = o.beaten_at + sim.BOSS_FADE_TICKS
            replay.push_key(mut r, end_at + 285, controls.KEY_REST)
            snapshot_range(dir, "end", r, end_at + 300, 45, end_at) else |_| { return 2 }
        }
        snapshot_range(
            dir,
            "boss-{name}-beaten",
            r,
            o.beaten_at + sim.BOSS_FADE_TICKS + 1,
            15,
            o.beaten_at + 1,
        ) else |_| { return 2 }
        kind += 1
    }
    0
}

/// The ghost witnesses (cb04): a short run east of the first den ended by
/// a numeric death (its archive, written with `--ghost-dir`, is the
/// committed ghost under tests/ghosts), and a run that walks toward that
/// spot and stands, showing the mark and the ghost's replay (its case
/// names the committed directory on a `# ghost-dir` line).
pub fn ghosts(dir: str) -> int {
    var s = sim.new(1, 80, 24)
    var r = replay.new(1, 1, 80, 24)
    let (x0, y0) = (s.x, s.y)
    if !walker.walk(mut s, mut r, x0 + 20 * sim.FP, y0) { eprint("proof: ghost walk"); return 1 }
    // A life of at least a hundred ticks: the trailer's ninety frames all
    // from the run, none from before the start.
    while s.tick < 100 { walker.press(mut s, mut r, walker.key(0)) }
    replay.push_arg(mut r, s.tick, controls.EV_HEALTH, -1000)
    sim.hurt(mut s, 1000)
    walker.press(mut s, mut r, walker.key(0))
    snapshot(dir, "ghost-death", s, r) else |_| { return 2 }
    var t = sim.new(1, 80, 24)
    var q = replay.new(1, 1, 80, 24)
    if !walker.walk(mut t, mut q, x0 + 14 * sim.FP, y0) {
        eprint("proof: ghost approach")
        return 1
    }
    var n = 0
    while n < 200 { walker.press(mut t, mut q, walker.key(0)); n += 1 }
    var bytes = List[byte]()
    replay.format(q, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/ghost.pk", bytes) else |_| { return 2 }
    fs.append_text(
        dir + "/ghost.pk",
        "\n# ghost-dir tests/ghosts\n# frames {t.tick} every 20 from 60\n",
    ) else |_| {
        return 2
    }
    print("witness ghost tick {t.tick}")
    0
}

/// The new areas' witnesses (cb04): from each area's den, a walk down the
/// route for a hundred and twenty ticks, frames every forty.
pub fn areas(dir: str) -> int {
    var kind = sim.LYNX
    while kind <= sim.ALPHA {
        let name = if kind == sim.LYNX {
            "crags"
        } else if kind == sim.ELK {
            "river"
        } else {
            "old-den"
        }
        let s0 = fight.journey_at(1, 80, 24, kind)
        var s = copy s0
        var r = snapshot_replay(s0)
        walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
        var n = 0
        while n < 120 { walker.press(mut s, mut r, walker.key(controls.KEY_DOWN)); n += 1 }
        snapshot_range(dir, name, r, s.tick, 40, 1) else |_| { return 2 }
        kind += 1
    }
    0
}

/// The title's demo (cb04): the first weasel pair fought from the start,
/// three hundred ticks of ordinary keys; embedded by tools/embed-demo.py.
pub fn demo(dir: str) -> int {
    var s = sim.new(1, 80, 24)
    var r = replay.new(1, 1, 80, 24)
    if !approach(mut s, mut r, 0) { eprint("proof: demo approach"); return 1 }
    var n = 0
    while n < 300 && s.action != sim.FALL {
        var target = -1
        var i = 0
        while i < s.foes.len {
            if s.foes[i].health > 0 &&
                s.foes[i].kind == sim.WEASEL &&
                sim.near(s.x, s.y, s.foes[i].x, s.foes[i].y, 12 * sim.FP) {
                target = i
                break
            }
            i += 1
        }
        if target >= 0 {
            walker.drive(mut s, mut r, s.foes[target].x, s.foes[target].y)
        } else {
            walker.press(mut s, mut r, walker.key(0))
        }
        n += 1
    }
    snapshot(dir, "demo", s, r) else |_| { return 2 }
    0
}

fn approach(mut s: sim.Sim, mut r: replay.Replay, foe: int) -> bool {
    approach_as(mut s, mut r, foe, false)
}

/// Walk to foe `foe` until it winds up; `passive` never bites on the way.
fn approach_as(mut s: sim.Sim, mut r: replay.Replay, foe: int, passive: bool) -> bool {
    walker.walk_stop(mut s, mut r, s.foes[foe].x, s.foes[foe].y, foe, passive) &&
        s.foes[foe].health > 0 &&
        s.action != sim.FALL
}

/// Refresh the original combat scripts at the new down-path encounters.
/// These scripts use default growth and no numeric health or scent inputs.
pub fn encounters(dir: str) -> int {
    var kind = 0
    while kind < 7 {
        var s = sim.new(1, 80, 24)
        var r = replay.new(1, 1, 80, 24)
        let foe = if kind == 4 || kind == 5 then 2 else 0
        if kind == 4 {
            let (x, y) = sim.spring_position(s.seed, 0)
            if !walker.walk(mut s, mut r, x, y) || s.flask_max != 2 { return 1 }
        }
        if !approach(mut s, mut r, foe) { eprint("proof: encounter approach {kind}"); return 1 }
        var n = 0
        if kind == 0 {
            while s.foes[0].health > 0 && n < 120 {
                walker.drive(mut s, mut r, s.foes[0].x, s.foes[0].y)
                n += 1
            }
            if !walker.walk(mut s, mut r, s.foes[0].x, s.foes[0].y) { return 1 }
        } else if kind == 1 || kind == 2 {
            while n < 10 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
            var keys = List[int]()
            if kind == 2 { (mut keys).push(controls.KEY_LEFT) }
            (mut keys).push(if kind == 1 then controls.KEY_PARRY else controls.KEY_DODGE)
            walker.press(mut s, mut r, keys)
            n = 0
            while n < 5 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
        } else if kind == 3 {
            while n < 16 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
        } else if kind == 4 {
            while n < 30 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
        } else if kind == 5 {
            while s.action != sim.FALL && n < 1200 {
                var keys = List[int]()
                walker.aim(mut keys, s.foes[foe].x - s.x, s.foes[foe].y - s.y)
                walker.press(mut s, mut r, keys)
                if n % 60 == 59 && s.action != sim.FALL {
                    let _ = approach_as(mut s, mut r, foe, true)
                }
                n += 1
            }
            if s.action != sim.FALL { eprint("proof: natural death never happened"); return 1 }
        } else {
            var keys = walker.key(controls.KEY_RIGHT)
            (mut keys).push(controls.KEY_LOCK)
            (mut keys).push(controls.KEY_BITE)
            walker.press(mut s, mut r, keys)
            n = 0
            while n < 12 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
        }
        let name = match kind {
            0 => "bite",
            1 => "parry",
            2 => "dodge",
            3 => "weasel-retreat",
            4 => "fox-feint",
            5 => "natural-death",
            _ => "aim-lock",
        }
        snapshot(dir, name, s, r) else |_| { return 2 }
        kind += 1
    }
    0
}

fn sprint_witness(dir: str) -> int {
    var s = sim.new(1, 80, 24)
    var r = replay.new(1, 1, 80, 24)
    if !approach_as(mut s, mut r, 0, true) { return 1 }
    let health = s.foes[0].health
    var n = 0
    var landed = false
    while n < 180 && s.action != sim.FALL {
        var keys = List[int]()
        walker.aim(mut keys, s.foes[0].x - s.x, s.foes[0].y - s.y)
        (mut keys).push(controls.KEY_DODGE)
        if s.sprinting && sim.in_reach(s, 0, 4) { (mut keys).push(controls.KEY_BITE) }
        walker.press(mut s, mut r, keys)
        if s.action == sim.DASH && s.foes[0].health < health { landed = true; break }
        n += 1
    }
    if !landed { eprint("proof: sprint attack never landed"); return 1 }
    var n2 = 0
    while n2 < 12 { walker.press(mut s, mut r, walker.key(0)); n2 += 1 }
    snapshot_from(dir, "sprint-hit", s, r, s.tick - 25) else |_| { return 2 }
    0
}
