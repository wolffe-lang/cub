//! A deterministic real-key route witness. The only numeric fixture inputs
//! are starting scent for growth and the deliberate cross-area death.

use controls
use forest
use replay
use sim
use std.fs

fn press(mut s: sim.Sim, mut r: replay.Replay, keys: List[int]) {
    for key in keys { replay.push_key(mut r, s.tick, key) }
    sim.step(mut s, keys)
}

fn key(k: int) -> List[int] {
    var keys = List[int]()
    if k > 0 { (mut keys).push(k) }
    keys
}

fn aim(mut keys: List[int], x: int, y: int) {
    if y < -sim.FP / 4 { (mut keys).push(controls.KEY_UP) }
    if y > sim.FP / 4 { (mut keys).push(controls.KEY_DOWN) }
    if x < -sim.FP / 4 { (mut keys).push(controls.KEY_LEFT) }
    if x > sim.FP / 4 { (mut keys).push(controls.KEY_RIGHT) }
}

fn drive(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int) {
    drive_as(mut s, mut r, x, y, false)
}

/// One tick toward `(x, y)`; `passive` never bites (the natural-death
/// witness lets the fox win).
fn drive_as(mut s: sim.Sim, mut r: replay.Replay, x: int, y: int, passive: bool) {
    var keys = List[int]()
    var fighting = false
    var i = 0
    while i < s.foes.len {
        let foe = copy s.foes[i]
        if foe.health > 0 {
            if foe.kind == sim.HAWK &&
                foe.phase == sim.CROUCH &&
                sim.near(s.x, s.y, foe.target_x, foe.target_y, sim.FP) {
                fighting = true
                if s.action == sim.IDLE && s.tick - foe.since >= sim.HAWK_TELL - 6 {
                    (mut keys).push(controls.KEY_PARRY)
                }
                break
            }
            // A foe in reach (two cells from the bodies, cb02c) is fought;
            // one behind a trunk is walked round (the planned path avoids
            // its body).
            if foe.kind != sim.HAWK && sim.in_reach(s, i, 2) && !passive {
                fighting = true
                if s.action == sim.IDLE {
                    aim(mut keys, foe.x - s.x, foe.y - s.y)
                    (mut keys).push(controls.KEY_BITE)
                }
                break
            }
            // A foe a little further off blocks the next cell when the cub
            // stands still against it: close on it rather than wait.
            if (foe.kind == sim.WEASEL || foe.kind == sim.FOX) &&
                s.speed == 0 &&
                sim.body_gap(s, i) <= 2 &&
                sim.visible(s, s.x, s.y, foe.x, foe.y) {
                fighting = true
                aim(mut keys, foe.x - s.x, foe.y - s.y)
                break
            }
        }
        i += 1
    }
    if !fighting { aim(mut keys, x - s.x, y - s.y) }
    press(mut s, mut r, keys)
}

/// Follow a BFS route by ordinary directional keys, with combat keys when
/// threatened. No teleport, collision override, heal or state mutation.
fn walk(mut s: sim.Sim, mut r: replay.Replay, tx: int, ty: int) -> bool {
    walk_stop(mut s, mut r, tx, ty, -1, false)
}

/// Whether the cub standing on a cell, facing as it faces, would share a
/// cell with a live ground foe's body: the walker routes round bodies as
/// it routes round trunks (cb02c: bodies are the drawings' footprints).
fn body_on(s: sim.Sim, x: int, y: int) -> bool {
    let b = sim.cub_body_at(s, x * sim.FP + sim.FP / 2, y * sim.FP + sim.FP / 2, s.body_facing)
    for f in s.foes {
        if sim.solid(f) && sim.overlap(b, sim.foe_body(f)) { return true }
    }
    false
}

fn walk_stop(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> bool {
    var replans = 0
    while replans < 20 {
        let outcome = walk_once(mut s, mut r, tx, ty, stop_foe, passive)
        if outcome != 2 { return outcome == 1 }
        // No progress for thirty ticks: plan again from where the cub stands,
        // the foes where they now are.
        replans += 1
    }
    false
}

/// A breadth-first plan over the area's cells from `start` toward `goal`
/// (indices into the area's rows from `top`): the parents, -1 unreached.
/// With `bodies` the cells where the cub's body would meet a foe's are
/// closed as trunks are.
fn plan(
    s: sim.Sim,
    w: int,
    top: int,
    origin: int,
    start: int,
    goal: int,
    bodies: bool,
) -> List[int] {
    let width = w * 2 + 1
    var parent = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (forest.LENGTH - top + 1) { (mut parent).push(-1); i += 1 }
    parent[start] = start
    (mut queue).push(start)
    var head = 0
    while head < queue.len && parent[goal] < 0 {
        let at = queue[head]
        let x = at % width - w
        let y = at / width + top
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= top && ny <= forest.LENGTH {
                let next = (ny - top) * width + nx + w
                if parent[next] < 0 &&
                    !sim.blocked(s, nx, ny + origin) &&
                    (next == goal || !bodies || !body_on(s, nx, ny + origin)) {
                    parent[next] = at
                    (mut queue).push(next)
                }
            }
            d += 1
        }
        head += 1
    }
    parent
}

/// One planned walk: 1 arrived (or stopped as asked), 0 failed, 2 stuck.
fn walk_once(
    mut s: sim.Sim,
    mut r: replay.Replay,
    tx: int,
    ty: int,
    stop_foe: int,
    passive: bool,
) -> int {
    let area = s.area
    let w = forest.bound(s.field, area)
    let width = w * 2 + 1
    // The coast's rows run from the river (the bank wanders north of the
    // spawn's row); an inland area's from its entry row.
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let origin = forest.origin(s.seed, area)
    let sx = sim.cell_x(s)
    let sy = sim.cell_y(s) - origin
    let gx = sim.floor_div(tx, sim.FP)
    let gy = sim.floor_div(ty, sim.FP) - origin
    if sx < 0 - w || sx > w || sy < top || sy > forest.LENGTH { return 0 }
    let start = (sy - top) * width + sx + w
    let goal = (gy - top) * width + gx + w
    // Round the bodies where there is room; where a body closes the way
    // (a foe as wide as the path, cb02c), plan through it and fight it.
    var parent = plan(s, w, top, origin, start, goal, true)
    if parent[goal] < 0 { parent = plan(s, w, top, origin, start, goal, false) }
    if parent[goal] < 0 { return 0 }
    var i = 0
    var path = List[int]()
    var at = goal
    while at != start { (mut path).push(at); at = parent[at] }
    i = path.len - 1
    let until = s.tick + 18000
    // Ticks left of following the plan rather than closing straight on the
    // foe (cb02c: a trunk between two bodies can stop the straight line).
    var detour = 0
    var stalled = 0
    while i >= 0 {
        let cell = path[i]
        let x = (cell % width - w) * sim.FP + sim.FP / 2
        let y = (cell / width + top + origin) * sim.FP + sim.FP / 2
        var still = 0
        var last_x = s.x
        var last_y = s.y
        while !sim.near(s.x, s.y, x, y, sim.FP / 2) {
            if s.tick > until || s.action == sim.FALL { return 0 }
            if stop_foe >= 0 && sim.body_gap(s, stop_foe) <= 3 && detour == 0 {
                let bx = s.x
                let by = s.y
                var keys = List[int]()
                aim(mut keys, s.foes[stop_foe].x - s.x, s.foes[stop_foe].y - s.y)
                press(mut s, mut r, keys)
                if s.x == bx && s.y == by { stalled += 1 } else { stalled = 0 }
                if stalled >= 10 {
                    detour = 30
                    stalled = 0
                }
            } else {
                if detour > 0 { detour -= 1 }
                drive_as(mut s, mut r, x, y, passive)
            }
            if stop_foe >= 0 &&
                (s.foes[stop_foe].phase == sim.CROUCH || s.foes[stop_foe].phase == sim.FEINT) {
                return 1
            }
            if s.area != area { return 1 }
            if s.x == last_x && s.y == last_y { still += 1 } else { still = 0 }
            last_x = s.x
            last_y = s.y
            if still >= 30 { return 2 }
        }
        i -= 1
    }
    1
}

fn snapshot(dir: str, name: str, s: sim.Sim, r: replay.Replay) -> () ! {io} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else |_| { return io }
    fs.append_text(dir + "/" + name + ".pk", "\n# frames {s.tick} every {s.tick}\n") else |_| {
        return io
    }
    print(
        "witness {name} tick {s.tick} area {s.area} scent {s.scent} mark {s.mark_scent} shortcuts {s.shortcuts}",
    )
}

/// A witness whose frames start at tick `from`, one a tick.
fn snapshot_from(dir: str, name: str, s: sim.Sim, r: replay.Replay, from: int) -> () ! {io} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else |_| { return io }
    fs.append_text(dir + "/" + name + ".pk", "\n# frames {s.tick} every 1 from {from}\n") else |_| {
        return io
    }
    print("witness {name} tick {s.tick} from {from} area {s.area}")
}

/// Generate replayable key witnesses for the whole connected journey.
pub fn generate(dir: str) -> int {
    fs.create_dir_all(dir) else |_| { return 2 }
    var s = sim.new(1, 80, 24)
    var r = replay.new(1, 1, 80, 24)
    replay.push_arg(mut r, 0, 1, 10000)
    s.scent = 10000
    press(mut s, mut r, key(controls.KEY_REST))
    var stat = controls.KEY_HEART
    while stat <= controls.KEY_FANG {
        var n = 0
        while n < 9 { press(mut s, mut r, key(stat)); n += 1 }
        stat += 1
    }
    press(mut s, mut r, key(controls.KEY_RELEASE))
    if !walk(mut s, mut r, 0, (sim.gate_y(s) - 2) * sim.FP) {
        eprint("proof: gate approach at {sim.cell_x(s)},{sim.cell_y(s)} tick {s.tick}")
        return 1
    }
    snapshot(dir, "world-gate", s, r) else |_| { return 2 }
    var keys = key(controls.KEY_DOWN)
    (mut keys).push(controls.KEY_BITE)
    press(mut s, mut r, keys)
    var n = 0
    while n < 16 { press(mut s, mut r, key(0)); n += 1 }
    snapshot(dir, "world-thorns", s, r) else |_| { return 2 }
    keys = key(controls.KEY_DOWN)
    (mut keys).push(controls.KEY_LUNGE)
    press(mut s, mut r, keys)
    n = 0
    var broke = false
    while n < 25 {
        press(mut s, mut r, key(0))
        // The tick after the thorns give: the gate's own witness.
        if s.gate_open && !broke {
            broke = true
            press(mut s, mut r, key(0))
            n += 1
            snapshot(dir, "thorn-gate", s, r) else |_| { return 2 }
        }
        n += 1
    }
    if !s.gate_open { eprint("proof: gate did not open"); return 1 }
    snapshot(dir, "world-open", s, r) else |_| { return 2 }
    let (ex, ey) = forest.portal(s.seed, 0, 0)
    if !walk(mut s, mut r, ex, ey) || s.area != 1 { eprint("proof: thicket edge"); return 1 }
    let (dx, dy) = forest.den_position(s.seed, 1)
    if !walk(mut s, mut r, dx, dy) { eprint("proof: thicket den"); return 1 }
    press(mut s, mut r, key(controls.KEY_REST))
    if !s.den || s.last_den != 1 { eprint("proof: no rest"); return 1 }
    snapshot(dir, "world-den", s, r) else |_| { return 2 }
    press(mut s, mut r, key(controls.KEY_RELEASE))
    let (mx, my) = forest.portal(s.seed, 1, 1)
    if !walk(mut s, mut r, mx, my) || s.area != 2 { eprint("proof: meadow edge"); return 1 }
    snapshot(dir, "world-meadow", s, r) else |_| { return 2 }
    let hawk_x = s.foes[0].x
    let hawk_y = s.foes[0].y
    // Walk to the hawk's ground until its shadow stops over the cub.
    if !walk_stop(mut s, mut r, hawk_x, hawk_y, 0, false) {
        eprint("proof: hawk approach")
        return 1
    }
    n = 0
    var shadow_at = if s.foes[0].phase == sim.CROUCH then s.tick else -1
    var stooped = false
    while s.foes[0].health > 0 && n < 300 {
        drive(mut s, mut r, hawk_x, hawk_y)
        // The hawk's two witnesses: its shadow stopped (three ticks into
        // the tell), and the stoop (with the two ticks before it).
        if shadow_at < 0 && s.foes[0].phase == sim.CROUCH { shadow_at = s.tick }
        if shadow_at >= 0 && s.tick == shadow_at + 3 {
            snapshot_from(dir, "hawk-shadow", s, r, shadow_at) else |_| { return 2 }
        }
        if !stooped && (s.foes[0].phase == sim.STRIKE || s.foes[0].health <= 0) {
            stooped = true
            snapshot_from(dir, "hawk-stoop", s, r, s.tick - 2) else |_| { return 2 }
        }
        n += 1
    }
    if s.foes[0].health > 0 || shadow_at < 0 { eprint("proof: hawk unanswered"); return 1 }
    snapshot(dir, "world-hawk", s, r) else |_| { return 2 }
    replay.push_arg(mut r, s.tick, 0, -1000)
    sim.hurt(mut s, 1000)
    press(mut s, mut r, key(0))
    n = 0
    while n < 30 { press(mut s, mut r, key(0)); n += 1 }
    if s.area != 1 || !s.mark || s.mark_area != 2 { eprint("proof: cross-area death"); return 1 }
    if !walk(mut s, mut r, mx, my) || s.area != 2 { eprint("proof: return to mark area"); return 1 }
    if !walk(mut s, mut r, s.mark_x, s.mark_y) { eprint("proof: reach mark"); return 1 }
    press(mut s, mut r, key(0))
    if s.mark { eprint("proof: mark not recovered"); return 1 }
    snapshot(dir, "world-recovered", s, r) else |_| { return 2 }
    let (hx, hy) = forest.portal(s.seed, 2, 3)
    if !walk(mut s, mut r, hx, hy) { eprint("proof: hedge approach"); return 1 }
    press(mut s, mut r, key(controls.KEY_REST))
    if s.area != 1 || s.shortcuts != 2 { eprint("proof: hedge not opened"); return 1 }
    let (lx, ly) = forest.portal(s.seed, 1, 2)
    if !walk(mut s, mut r, lx, ly) { eprint("proof: log approach"); return 1 }
    press(mut s, mut r, key(controls.KEY_REST))
    if s.area != 0 || s.shortcuts != 3 { eprint("proof: log not opened"); return 1 }
    snapshot(dir, "world-return", s, r) else |_| { return 2 }
    var cache = 0
    while cache < forest.cache_count(0) {
        let (cx, cy) = forest.cache_position(s.seed, s.field, 0, cache)
        if !walk(mut s, mut r, cx, cy) {
            eprint(
                "proof: coast cache {cache} tick {s.tick} action {s.action} health {s.health} speed {s.speed} blocked {s.blocked} at {s.x},{s.y} goal {sim.floor_div(cx, sim.FP)},{sim.floor_div(cy, sim.FP)}",
            )
            for foe in s.foes {
                if sim.near(s.x, s.y, foe.x, foe.y, 5 * sim.FP) {
                    eprint(
                        "proof: foe kind {foe.kind} health {foe.health} phase {foe.phase} at {foe.x},{foe.y}",
                    )
                }
            }
            return 1
        }
        // The guard must be fought before the dig: hunt every live guard
        // within the dig's six cells, by ordinary keys.
        var guard = 0
        while guard < s.foes.len {
            var rounds = 0
            while s.foes[guard].health > 0 &&
                s.foes[guard].kind != sim.HAWK &&
                sim.near(s.foes[guard].x, s.foes[guard].y, cx, cy, 6 * sim.FP) &&
                rounds < 6 {
                let fx = s.foes[guard].x
                let fy = s.foes[guard].y
                let _ = walk(mut s, mut r, fx, fy)
                var n = 0
                while s.foes[guard].health > 0 && n < 300 && s.action != sim.FALL {
                    drive(mut s, mut r, s.foes[guard].x, s.foes[guard].y)
                    n += 1
                }
                rounds += 1
            }
            guard += 1
        }
        if !walk(mut s, mut r, cx, cy) { eprint("proof: coast cache {cache} return"); return 1 }
        press(mut s, mut r, key(controls.KEY_REST))
        if !sim.cache_open(s, cache) { eprint("proof: cache remains guarded {cache}"); return 1 }
        snapshot(dir, "coast-cache-{cache}", s, r) else |_| { return 2 }
        cache += 1
    }
    encounters(dir)
}

fn approach(mut s: sim.Sim, mut r: replay.Replay, foe: int) -> bool {
    approach_as(mut s, mut r, foe, false)
}

/// Walk to foe `foe` until it winds up; `passive` never bites on the way.
fn approach_as(mut s: sim.Sim, mut r: replay.Replay, foe: int, passive: bool) -> bool {
    walk_stop(mut s, mut r, s.foes[foe].x, s.foes[foe].y, foe, passive) &&
        s.foes[foe].health > 0 &&
        s.action != sim.FALL
}

/// Refresh the original combat scripts at the new down-path encounters.
/// These scripts use default growth and no numeric health or scent inputs.
pub fn encounters(dir: str) -> int {
    var kind = 0
    while kind < 7 {
        var s = sim.new(1, 80, 24)
        var r = replay.new(1, 1, 80, 24)
        let foe = if kind == 4 || kind == 5 then 2 else 0
        if !approach(mut s, mut r, foe) { eprint("proof: encounter approach {kind}"); return 1 }
        var n = 0
        if kind == 0 {
            while s.foes[0].health > 0 && n < 120 {
                drive(mut s, mut r, s.foes[0].x, s.foes[0].y)
                n += 1
            }
            if !walk(mut s, mut r, s.foes[0].x, s.foes[0].y) { return 1 }
        } else if kind == 1 || kind == 2 {
            while n < 10 { press(mut s, mut r, key(0)); n += 1 }
            var keys = List[int]()
            if kind == 2 { (mut keys).push(controls.KEY_LEFT) }
            (mut keys).push(if kind == 1 then controls.KEY_PARRY else controls.KEY_DODGE)
            press(mut s, mut r, keys)
            n = 0
            while n < 5 { press(mut s, mut r, key(0)); n += 1 }
        } else if kind == 3 {
            while n < 16 { press(mut s, mut r, key(0)); n += 1 }
        } else if kind == 4 {
            while n < 30 { press(mut s, mut r, key(0)); n += 1 }
        } else if kind == 5 {
            while s.action != sim.FALL && n < 1200 {
                var keys = List[int]()
                aim(mut keys, s.foes[foe].x - s.x, s.foes[foe].y - s.y)
                press(mut s, mut r, keys)
                if n % 60 == 59 && s.action != sim.FALL {
                    let _ = approach_as(mut s, mut r, foe, true)
                }
                n += 1
            }
            if s.action != sim.FALL { eprint("proof: natural death never happened"); return 1 }
        } else {
            var keys = key(controls.KEY_RIGHT)
            (mut keys).push(controls.KEY_LOCK)
            (mut keys).push(controls.KEY_LUNGE)
            press(mut s, mut r, keys)
            n = 0
            while n < 12 { press(mut s, mut r, key(0)); n += 1 }
        }
        let name = match kind {
            0 => "bite",
            1 => "parry",
            2 => "dodge",
            3 => "weasel-retreat",
            4 => "fox-feint",
            5 => "natural-death",
            _ => "aim-lock",
        }
        snapshot(dir, name, s, r) else |_| { return 2 }
        kind += 1
    }
    0
}
