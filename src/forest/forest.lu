//! Seeded curved routes over the fixed area graph. Terrain decoration
//! cannot occupy a carved route, den, cache, arena or portal approach.
//!
//! Every area is sized by the journey's **field**: the terminal's columns
//! when the journey began (floor 80), saved with it and never moved by a
//! resize or a resume in another terminal (cb02b, R-cb02b-4 A). The coast
//! reaches `coast_extent` cells each way from the spawn, the inland areas
//! `half_width` each side of their spine, so the world fills the screen it
//! was made for and the shore is a screen's walk long before its jetty.
//!
//! cb04 added the last three areas the bosses need: the Teeth (the crags,
//! a climb of narrow ledges between stone, the lynx's ground), the Shallows
//! (the river upstream, the Ashwater along the west and the ford the elk
//! keeps) and Gravehollow (the old den in the deep wood, the pack's scent
//! everywhere, the shadow alpha's clearing).
//!
//! cb05 widened the forest (the maintainer's word, 2026-10-26: "areas are
//! also too small ... Dens are too frequent and too close ... Remove
//! sawtooth paths"): every area has its own length (`length`, R-cb05-2 A),
//! at most two dens an area at least `DEN_SPACING` route cells apart
//! (R-cb05-3 A; the retired dens are landmarks now), cache branches drawn
//! from four smooth shapes (a slow S, a hook, a loop, a 180-degree turn
//! where the field has room; `branch_point` is their centreline), a fork
//! that rejoins and a second way into the boar's clearing in Bramblehold,
//! short pockets that end at an old scent mark, the burn's landmarks, and
//! Cinderwick (`town`, area 6) threaded between the Shingle and
//! Bramblehold: Shingle - Cinderwick - Bramblehold - Larkmeadow - the Teeth
//! - the Shallows - Gravehollow.

use lands
use meadow
use terrain
use town
use world

/// Area identities are stable save-format values.
pub const SHINGLE: int = 0

/// The dense thicket.
pub const BRAMBLEHOLD: int = 1

/// Open ground at dusk.
pub const LARKMEADOW: int = 2

/// The Teeth: the crags, narrow ledges between stone (cb04).
pub const CRAGS: int = 3

/// The Shallows: the river upstream, the elk's ford (cb04).
pub const RIVER: int = 4

/// The Hush: the deep wood, night always, the cold den at its entry (cb04
/// built it as "Gravehollow" with the old den's arena at its far end; cb14
/// split the arena off into `GRAVEHOLLOW` and gave the wood the bible's
/// name for it, so the Howe can lie between the two).
pub const HUSH: int = 5

/// Cinderwick: the burnt town between the Shingle and Bramblehold (cb05).
pub const TOWN: int = 6

/// The Stand (cb14): an old pine stand on a ridge between Bramblehold and
/// Larkmeadow, the lookout at its top.
pub const STAND: int = 7

/// The Burn (cb14): the old fire's ground between Larkmeadow and the Teeth.
pub const BURN: int = 8

/// The Mere (cb14): the dark lake between the Teeth and the Shallows.
pub const MERE: int = 9

/// The Underteeth (cb14): the cavern under the Teeth, a branch from
/// Dunmoss's sett out into the Hush.
pub const UNDERTEETH: int = 10

/// The Howe (cb14): the barrow field between the Hush and Gravehollow.
pub const HOWE: int = 11

/// Gravehollow (cb14, split from area 5): the old den under the fallen
/// oak's roots, the stone mouth at its entry, the shadow alpha's arena.
pub const GRAVEHOLLOW: int = 12

/// The number of areas (every id below this).
pub const AREAS: int = 13

/// The number of dens in the first bank of ids (0..7): the hollow log, the
/// split roots, the briar hollow, the grass nest, the ledge cleft, the
/// willow root, the cold den, the cold hearth. Ids 8..15 are the second
/// bank (`DEN_LIMIT`): 11 the last warm hollow; 8, 9 and 10 retired; 12
/// the root hollow, 13 the kiln, 14 the dry island, 15 the bone cache
/// (cb14).
pub const DENS: int = 8

/// The number of edges (ids 0..19): the thorn path (the Shingle into
/// Cinderwick), the ridge path (Bramblehold into the Stand), the log, the
/// hedge, the burn path (Larkmeadow into the Burn), the mere path (the
/// Teeth into the Mere), the hush path (the Shallows into the Hush), the
/// ledge, the shallows, the town's way on into Bramblehold; then cb14's:
/// the meadow path (the Stand into Larkmeadow), the crags path (the Burn
/// into the Teeth), the river path (the Mere into the Shallows), the howe
/// path (the Hush into the Howe), the stone mouth (the Howe into
/// Gravehollow), the scree (the Stand back to Bramblehold), the streambed
/// (the Burn back to Larkmeadow), the raft (the Mere back to the Teeth),
/// the sett (the Teeth into the Underteeth), the roots (the Underteeth
/// out into the Hush).
pub const EDGES: int = 20

/// The first of cb14's edges.
pub const EDGE_STAND_OUT: int = 10

/// The Burn into the Teeth.
pub const EDGE_BURN_OUT: int = 11

/// The Mere into the Shallows.
pub const EDGE_MERE_OUT: int = 12

/// The Hush into the Howe.
pub const EDGE_HOWE_IN: int = 13

/// The stone mouth: the Howe into Gravehollow.
pub const EDGE_MOUTH: int = 14

/// The scree: the Stand back to Bramblehold's second den.
pub const EDGE_SCREE: int = 15

/// The dry streambed: the Burn back to Larkmeadow.
pub const EDGE_STREAMBED: int = 16

/// The log raft: the Mere back to the Teeth.
pub const EDGE_RAFT: int = 17

/// The sett: the Teeth into the Underteeth (the growth gate).
pub const EDGE_SETT: int = 18

/// The roots: the Underteeth out into the Hush.
pub const EDGE_ROOTS: int = 19

/// The smallest field: the engine's minimum terminal width.
pub const FIELD_MIN: int = 80

/// Distance along the Shingle, cells: the tutorial's length, unchanged;
/// every other area's is `length`.
pub const LENGTH: int = 160

/// The longest area, cells: the size of every per-row buffer.
pub const LENGTH_MAX: int = 288

/// At most this many dens an area (R-cb05-3 A).
pub const DENS_PER_AREA: int = 2

/// At least this many route cells between any two dens, along the way on
/// (R-cb05-3 A); a shortcut is short by design and measured apart.
pub const DEN_SPACING: int = 110

/// Fixed-point units per cell.
pub const FP: int = 256

/// Longest permitted equal-centre run in the 50-seed census.
pub const STRAIGHT_MAX: int = 12

/// Every initial enemy is at least this far from every den in its area.
pub const FIRST_FOE_CELLS: int = 30

/// The coast's least reach each way from the spawn, cells (R-cb02b-1 A).
pub const COAST_MIN: int = 120

/// How far from a route the coast's canopy stays open, cells: beyond it
/// the wood is deep and solid, so every walkable cell is a bounded walk
/// from the shore, the thorn route or an alcove.
pub const OPEN_REACH: int = 16

/// The boar's clearing in Bramblehold: a side branch east of the route.
pub const BOAR_X: int = 30

/// Its local row (two fifths of the way in).
pub const BOAR_ROW: int = 108

/// A cache branch's half width, cells.
pub const BRANCH_HALF: int = 3

/// The branch shapes (`branch_shape`): a slow S, a hook (a run, a quarter
/// turn, a climb), a loop round a copse, a 180-degree turn back toward
/// the route.
pub const SHAPE_S: int = 0

/// A hook.
pub const SHAPE_HOOK: int = 1

/// A loop.
pub const SHAPE_LOOP: int = 2

/// A 180-degree turn.
pub const SHAPE_UTURN: int = 3

/// The hook's turning radius, cells.
pub const HOOK_RADIUS: int = 7

/// The loop's radius, cells (its copse inside).
pub const LOOP_RADIUS: int = 10

/// The 180-degree turn's radius, cells.
pub const UTURN_RADIUS: int = 8

/// Landmark kinds (cb05): the low embers (a ring of coals still warm in
/// the grass), the ash shelter (the charred frame of a hut), the coal roots
/// (a burnt stump-field at the thicket's edge), the lightning-split oak by
/// the split roots, the crack in the stone by the ledge cleft, the willow
/// over the water by the willow root, Quill's first perch, an old scent
/// mark (the dead ends' reward).
pub const LM_COALS: int = 0

/// The ash shelter.
pub const LM_FRAME: int = 1

/// The coal roots.
pub const LM_STUMPS: int = 2

/// The split oak.
pub const LM_SPLIT_OAK: int = 3

/// The cleft.
pub const LM_CLEFT: int = 4

/// The willow.
pub const LM_WILLOW: int = 5

/// Quill's perch.
pub const LM_PERCH: int = 6

/// An old scent mark.
pub const LM_SCENT: int = 7

/// The number of landmark kinds.
pub const LM_COUNT: int = 8

/// The field a terminal of `cols` columns starts: never below `FIELD_MIN`.
pub fn field_of(cols: int) -> int {
    if cols < FIELD_MIN then FIELD_MIN else cols
}

/// An inland area's half width, cells: half the field and a margin, so
/// the grove covers the screen it was made for (48 at 80 columns, 108 at
/// 200; R-cb02b-6 A).
pub fn half_width(field: int) -> int {
    field / 2 + 8
}

/// The coast's reach each way from the spawn, cells: one screen past the
/// initial view's edge (three halves of the field), floor `COAST_MIN`
/// (R-cb02b-1 A): 120 at 80 columns, 300 at 200.
pub fn coast_extent(field: int) -> int {
    let e = field * 3 / 2
    if e < COAST_MIN then COAST_MIN else e
}

/// An area's half width: the coast's extent on the Shingle, `half_width`
/// inland.
pub fn bound(field: int, area: int) -> int {
    if area == SHINGLE then coast_extent(field) else half_width(field)
}

/// An area's length along its route, cells (R-cb05-2 A): the Shingle's
/// 160 (the tutorial), 288 for the town, the thicket and the meadow, 224
/// for the Teeth, the Shallows and Gravehollow.
pub fn length(area: int) -> int {
    if area == SHINGLE { return LENGTH }
    if area == TOWN { return town.LENGTH }
    if area == BRAMBLEHOLD || area == LARKMEADOW { return LENGTH_MAX }
    // cb14: the Hush keeps the wood and loses the arena's rows; Gravehollow
    // is the short last walk to the old den; the Underteeth a cavern.
    if area == HUSH { return 160 }
    if area == GRAVEHOLLOW { return 128 }
    if area == UNDERTEETH { return 192 }
    224
}

/// The area entry line.
pub fn name(area: int) -> str {
    match area {
        0 => "The Shingle",
        1 => "Bramblehold",
        2 => "Larkmeadow",
        3 => "The Teeth",
        4 => "The Shallows",
        5 => "The Hush",
        6 => "Cinderwick",
        7 => "The Stand",
        8 => "The Burn",
        9 => "The Mere",
        10 => "The Underteeth",
        11 => "The Howe",
        _ => "Gravehollow",
    }
}

/// The den ids the save format holds: 0..15.
pub const DEN_LIMIT: int = 16

/// Whether a den id is a place the cub can rest at: 0..7 and 11..15. Ids
/// 8, 9 and 10 are retired (cb05: landmarks now, `den_retired`). Unknown
/// ids are not locations.
pub fn den_exists(den: int) -> bool {
    den >= 0 && den <= 7 || den >= 11 && den <= 15
}

/// Whether a den id was a den once and is a landmark now (cb05): the coal
/// roots, the low embers, the ash shelter. The save keeps the ids; a
/// journey whose last den is one wakes at the nearest kept den.
pub fn den_retired(den: int) -> bool {
    den >= 8 && den <= 10
}

/// Area containing a den, or -1 for an unimplemented, reserved or retired
/// id.
pub fn den_area(den: int) -> int {
    if !den_exists(den) { return -1 }
    match den {
        0 => SHINGLE,
        1 => BRAMBLEHOLD,
        2 => BRAMBLEHOLD,
        3 => LARKMEADOW,
        4 => CRAGS,
        5 => RIVER,
        6 => HUSH,
        7 => TOWN,
        11 => LARKMEADOW,
        12 => STAND,
        13 => BURN,
        14 => MERE,
        _ => UNDERTEETH,
    }
}

/// The area a retired den stood in (for the migration and its landmark).
pub fn retired_area(den: int) -> int {
    if den == 8 then BRAMBLEHOLD else if den == 9 || den == 10 then LARKMEADOW else -1
}

/// Count implemented dens in an area.
pub fn den_count(area: int) -> int {
    var n = 0
    var id = 0
    while id < DEN_LIMIT {
        if den_area(id) == area { n += 1 }
        id += 1
    }
    n
}

/// Display name of a persistent den id (the retired ones keep their names
/// as landmarks).
pub fn den_name(den: int) -> str {
    match den {
        0 => "The hollow log",
        1 => "The split roots",
        2 => "The briar hollow",
        3 => "The grass nest",
        4 => "The ledge cleft",
        5 => "The willow root",
        6 => "The cold den",
        7 => "The cold hearth",
        8 => "The coal roots",
        9 => "The low embers",
        10 => "The ash shelter",
        11 => "The last warm hollow",
        12 => "The root hollow",
        13 => "The kiln",
        14 => "The dry island",
        _ => "The bone cache",
    }
}

/// The area's local coordinate origin is its entry row.
pub fn origin(seed: int, area: int) -> int {
    if area == SHINGLE {
        let (_, y) = terrain.start(seed)
        return (y - FP / 2) / FP
    }
    0
}

/// Layered value noise, as pack's centre/width model, plus a seeded short
/// wave whose alternating anchors prevent quantised plateaus. Every point
/// is queried independently; no random stream or host floating point.
pub fn curve(seed: int, ch: int, at: int) -> int { terrain.meander(seed, ch, at) }

/// Smoothstep of `t` in `[0, FP]`, in `[0, FP]`.
fn ss(t: int) -> int {
    let c = if t < 0 then 0 else if t > FP then FP else t
    c * c / FP * (3 * FP - 2 * c) / FP
}

/// A route through wood (cb05: "Make the path shapes more varied"):
/// anchors every `ROUTE_LATTICE` rows carry a slow drift, so the path
/// leans one way and then the other over `SWEEP_ANCHORS` anchors (a
/// drift of 4..7 cells), while the alternation at each anchor (9..12
/// cells, wider and slower than the Shingle's 3..5 every sixteen rows,
/// and wider than the drift so the two never cancel into a straight run)
/// bends the route every screen. One smoothstep between combined anchors,
/// plus the noise: two curves summed would run straight where their slopes
/// cancel, and a sixteen-row alternation with these swings would reverse
/// within three cells at every apex (measured over fifty seeds: 0.50
/// reversals per ten samples); this shape measures 0.07 against cb04d's
/// 0.15, with no straight run over eleven cells.
fn route_anchor_fp(seed: int, ch: int, k: int, l: int) -> int {
    // Zero at and beyond the route's ends: the portals stand at x = 0; the
    // anchors beside them carry no drift, so the ramp from a portal
    // always has a slope (the drift can oppose the alternation).
    if k <= 0 || k * ROUTE_LATTICE >= l { return 0 }
    let fast = if (k % 2 + 2) % 2 == 0 then 1 else -1
    if k == 1 || (k + 1) * ROUTE_LATTICE >= l {
        return fast * (9 + world.hash(seed, ch, k, 4)) * FP
    }
    drift_fp(seed, ch, k) + fast * (9 + world.hash(seed, ch, k, 4)) * FP
}

/// The drift at anchor `k`: smoothstepped between its own anchors every
/// `SWEEP_ANCHORS`.
fn drift_fp(seed: int, ch: int, k: int) -> int {
    var j = k / SWEEP_ANCHORS
    var r = k % SWEEP_ANCHORS
    if r < 0 { j -= 1; r += SWEEP_ANCHORS }
    let sign = if (j % 2 + 2) % 2 == 0 then 1 else -1
    let a = sign * (4 + world.hash(seed, ch + 1000, j, 4)) * FP
    let b = 0 - sign * (4 + world.hash(seed, ch + 1000, j + 1, 4)) * FP
    a + (b - a) / FP * ss(r * FP / SWEEP_ANCHORS)
}

/// The route's centre in fixed point (`route_anchor_fp` between anchors
/// every `ROUTE_LATTICE` rows, the meander's noise on top, rounded once).
fn route_fp(seed: int, ch: int, at: int, l: int) -> int {
    var k = at / ROUTE_LATTICE
    var r = at % ROUTE_LATTICE
    if r < 0 { k -= 1; r += ROUTE_LATTICE }
    let a = route_anchor_fp(seed, ch, k, l)
    let b = route_anchor_fp(seed, ch, k + 1, l)
    // The first and last segments ramp straight from the portal (a
    // smoothstep from zero starts flat: a long straight run); the noise is
    // detrended to zero at both portals (`terrain.noise_detrended`).
    let ends = k <= 0 || (k + 1) * ROUTE_LATTICE >= l
    let blend = if ends then r * FP / ROUTE_LATTICE else ss(r * FP / ROUTE_LATTICE)
    terrain.noise_detrended(seed, ch, at, l) + a + (b - a) / FP * blend
}

/// Rows between a route's anchors.
pub const ROUTE_LATTICE: int = 32

/// Anchors between the drift's turns: six (a hundred and ninety-two rows).
pub const SWEEP_ANCHORS: int = 6

/// Bramblehold's switchbacks (cb03a, lengthened by cb05): six legs of
/// thirty-six rows between rows 20 and 236 swinging `amp` (24..28) cells
/// either side (a wider swing than cb03a's 18..22, so the longer legs
/// still meet at ninety degrees), a taper in over the first sixteen rows
/// and out over the last fifty-six. The first den and final exit remain fixed, with short
/// tapered approaches rather than a long straight corridor.
fn switchback(seed: int, at: int) -> int {
    let amp = 24 + world.hash(seed, 91, 0, 5)
    // The way in (cb05): four rows straight from the doorway, so the
    // arrival cell stays on the route, then one straight slant to the
    // first apex (a smoothstep here bent one way and then the other
    // within eight rows: a reversal the bends census sees).
    if at < 4 { return 0 }
    if at < 20 { return 0 - amp * (at - 4) / 16 }
    if at >= 236 { return -amp * (LENGTH_MAX - at) / 52 }
    let leg = (at - 20) / 36
    let part = (at - 20) % 36
    let sign = if leg % 2 == 0 then -1 else 1
    sign * (amp - 2 * amp * part / 36)
}

/// Path centre in cells. Bramblehold's switchbacks round each apex over
/// five rows (cb04d); the town's lane is the town's own; the other areas
/// ride the short meander on the long sweep, tapered to the portals.
pub fn spine(seed: int, area: int, at: int) -> int {
    if area == BRAMBLEHOLD {
        let part = (at - 20 + 2 + 36) % 36
        if at < 18 || at > 238 || part > 4 { return switchback(seed, at) }
        return (
            switchback(seed, at - 2) +
                2 * switchback(seed, at - 1) +
                3 * switchback(seed, at) +
                2 * switchback(seed, at + 1) +
                switchback(seed, at + 2)
        ) /
            9
    }
    if area == TOWN { return town.lane(seed, at) }
    // The route stands at x = 0 at both portals by its end anchors (cb05),
    // never by a taper: a curve tapered by a factor bends one way and
    // then the other wherever its slope opposes its sign.
    let l = length(area)
    if area == SHINGLE {
        return terrain.floor_cells(terrain.meander_ends_fp(seed, 31 + area, at, l))
    }
    terrain.floor_cells(route_fp(seed, 31 + area, at, l))
}

/// The path half-width breathes from a separate noise ch, 4..6 cells
/// (cb04d: a cell of clearance each side for the body); the crags' ledges
/// are narrower, 3..4 (cb04: a climb); the town's lane is fixed.
pub fn half(seed: int, area: int, at: int) -> int {
    if area == TOWN { return town.LANE_HALF }
    // The crags' ledges, the Mere's causeway and the Underteeth's tunnel
    // are narrow: 3..4.
    if area == CRAGS || area == MERE || area == UNDERTEETH {
        return 3 + world.noise(seed, 45 + area, at * 3) / FP
    }
    4 + world.noise(seed, 45 + area, at * 3) * 2 / FP
}

/// A den's local row (cb05, R-cb05-3 A): the briar hollow a third into
/// Bramblehold and the split roots two thirds; the grass nest at the entry to
/// Larkmeadow and the last warm hollow past its middle; the cold hearth in
/// Cinderwick's square; the later areas' dens near their entries (the
/// ledge cleft a little further in, so the way on from the last warm
/// hollow is a den's spacing). The seed moves each by up to three rows.
pub fn den_row(seed: int, den: int) -> int {
    // cb14: the root hollow under the Stand's ridge (96, a den's spacing
    // from the split roots behind and the grass nest ahead), the kiln in
    // the Burn's middle (112), the dry island in the Mere's middle (104),
    // the bone cache in the Underteeth's deepest chamber (100).
    let base = match den {
        1 => 196,
        2 => 100,
        3 => 8,
        4 => 18,
        7 => 132,
        11 => 190,
        12 => 96,
        13 => 112,
        14 => 104,
        15 => 100,
        _ => 7,
    }
    base + world.hash(seed, den, 92, 4)
}

/// Den locations vary with the seed while preserving their graph roles.
/// Stable ids preserve save/checkpoint identities.
pub fn den_position(seed: int, den: int) -> (int, int) {
    if den == 0 { return terrain.start(seed) }
    if den == 7 {
        let (hx, hy) = town.hearth(seed)
        return (hx * FP + FP / 2, hy * FP + FP / 2)
    }
    let area = den_area(den)
    let y = den_row(seed, den)
    // The grass nest sits in the doorway's line (the route's centre at
    // the meadow's first row, exactly), where the meadow opens past the
    // shadow.
    if den == 3 { return (spine(seed, area, 0) * FP + FP / 2, y * FP + FP / 2) }
    ((spine(seed, area, y) + world.hash(seed, den, 91, 3) - 1) * FP + FP / 2, y * FP + FP / 2)
}

/// The kept den a retired den's journey wakes at (cb05): the kept den of
/// the same area nearest the retired den's old row (the coal roots at 66
/// of 160, the low embers at 66, the ash shelter at 90, as rows of the
/// lengthened area).
pub fn nearest_kept_den(seed: int, den: int) -> int {
    let area = retired_area(den)
    if area < 0 { return 0 }
    let old = (if den == 10 then 90 else 66) * length(area) / LENGTH
    var best = 0
    var best_gap = 100000
    var id = 0
    while id < DEN_LIMIT {
        if den_area(id) == area {
            let gap = abs(den_row(seed, id) - old)
            if gap < best_gap { best = id; best_gap = gap }
        }
        id += 1
    }
    best
}

/// Finite caches in an area: three inland in the thicket and the meadow,
/// reached by shaped side branches; four in the town's yards; on the
/// Shingle the coast's offshoots (`cache_count`).
pub fn cache_position(seed: int, field: int, area: int, cache: int) -> (int, int) {
    if area == SHINGLE {
        let at = coast_end(seed, cache)
        return (
            coast_branch_x(seed, field, cache, at) * FP + FP / 2,
            (origin(seed, area) + at) * FP + FP / 2,
        )
    }
    if area == TOWN {
        let (x, at) = town.cache(seed, cache)
        return (x * FP + FP / 2, at * FP + FP / 2)
    }
    let (x, at) = branch_point(seed, field, area, cache, branch_len(seed, field, area, cache))
    (x * FP + FP / 2, (origin(seed, area) + at) * FP + FP / 2)
}

/// The row a cache branch leaves the route: a fifth, just under a half
/// and four fifths of the way in (the middle one placed so its shape,
/// bending toward the farther den, keeps the quiet radius from both), the
/// seed moving each by up to four rows.
pub fn cache_row(seed: int, area: int, cache: int) -> int {
    // From the Teeth on (cb14) each area's alcoves have their own rows and
    // sides (`cache_mouth`), clear of its den, its mouths, its pockets,
    // its arena and its landmarks by thirty cells and more.
    if area >= CRAGS && area != TOWN {
        let (row, _) = cache_mouth(area, cache)
        return row + world.hash(seed, area, cache + 62, 5)
    }
    (if cache == 0 then 60 else if cache == 1 then 136 else 232) +
        world.hash(seed, area, cache + 62, 5)
}

/// The row and side (-1 west, 1 east) a cb14 alcove's branch leaves the
/// route on, from the Teeth on: the Teeth 50 east (the shallows' mouth at
/// 22 east is clear), 110 west (past the pocket at 60 and the sett at 72),
/// 190 east (the raft's landing at 200 east is ten rows on); the Shallows
/// east of the route (the Ashwater lies west) at 50, 110 and 190, its ford
/// at 138..174 astride; the Hush 50 east (the roots' mouth at 40 west), 90
/// west, 140 east (the pocket at 120 east is twenty rows back); the Stand
/// 40 west, 150 east, 190 west (the lookout's ledge at 200 east); the Burn
/// 50 west (the streambed's mouth at 40 east), 160 east, 200 west; the
/// Mere 40 west (a causeway), 140 east (from the third island), 206 east
/// (the raft's mouth at 190 west); the Underteeth 40 east, 140 west, 172
/// east (between its chambers); the Howe 46 west, 105 east, 180 west
/// (the standing stones alternate the other way); Gravehollow 26 west and
/// 60 east, before its bowl.
pub fn cache_mouth(area: int, cache: int) -> (int, int) {
    if area == CRAGS { return if cache == 0 then (50, 1) else if cache == 1 then (110, -1) else (190, 1) }
    if area == RIVER { return if cache == 0 then (50, 1) else if cache == 1 then (110, 1) else (190, 1) }
    if area == HUSH { return if cache == 0 then (50, 1) else if cache == 1 then (90, -1) else (100, 1) }
    if area == STAND { return if cache == 0 then (40, -1) else if cache == 1 then (150, 1) else (184, -1) }
    if area == BURN { return if cache == 0 then (50, -1) else if cache == 1 then (160, 1) else (184, -1) }
    if area == MERE { return if cache == 0 then (40, -1) else if cache == 1 then (140, 1) else (180, 1) }
    if area == UNDERTEETH {
        return if cache == 0 then (40, 1) else if cache == 1 then (140, -1) else (156, -1)
    }
    if area == HOWE { return if cache == 0 then (46, -1) else if cache == 1 then (105, 1) else (180, -1) }
    if cache == 0 then (34, -1) else (60, 1)
}

/// A cache branch's geometry (cb05), computed once per query: its mouth
/// row, side, the route's column there, its reach, shape, bend direction,
/// the S's amplitude, the hook's climb, its centreline's length and its
/// end (the cache).
pub struct Branch {
    m: int,
    side: int,
    x0: int,
    r: int,
    shape: int,
    dir: int,
    amp: int,
    climb: int,
    len: int,
    end_x: int,
    end_y: int,
    stem: bool,
}

/// The side a cache branch leaves on: even caches west, odd east; in
/// Bramblehold the side the switchback has swung away from, so every
/// branch has the field's width to run in.
pub fn branch_side(seed: int, area: int, cache: int) -> int {
    if area == BRAMBLEHOLD {
        return if spine(seed, area, cache_row(seed, area, cache)) > 0 then -1 else 1
    }
    // From the Teeth on each alcove's side is its own (cb14, `cache_mouth`).
    if area >= CRAGS && area != TOWN {
        let (_, side) = cache_mouth(area, cache)
        return side
    }
    if cache % 2 == 0 then -1 else 1
}

/// The shape of cache branch `cache` (cb05): the area's branches take
/// distinct shapes from a seeded order of the four (a slow S, a hook, a
/// loop, a 180-degree turn), each folded into the shapes it has room for
/// (the turn needs forty-six cells of reach, the loop thirty, the hook
/// twenty), so no two branches in sight are alike where the field allows.
fn shape_of(seed: int, area: int, cache: int, r: int) -> int {
    let n = if r >= 46 then 4 else if r >= 30 then 3 else if r >= 20 then 2 else 1
    // The twenty-four orders of 0..3, the k-th in lexicographic order
    // decoded digit by digit (cb14: no list a cell; the same orders cb05
    // listed, byte for byte).
    let k = world.hash(seed, area, 90, 24)
    let d0 = k / 6
    let r1 = k % 6
    let a = if d0 == 0 then 1 else 0
    let b = if d0 <= 1 then 2 else 1
    let c = if d0 <= 2 then 3 else 2
    let i1 = r1 / 2
    let d1 = if i1 == 0 then a else if i1 == 1 then b else c
    let e = if i1 == 0 then b else a
    let f = if i1 == 2 then b else c
    let d2 = if r1 % 2 == 0 then e else f
    let digit = if cache == 0 then d0 else if cache == 1 then d1 else d2
    digit % n
}

/// The hook's and the turn's bend direction, and the S's: toward the
/// side (by row) whose nearest den is the farther off, so no branch
/// bends into a den's quiet radius; north (-1) or south (1).
fn branch_dir(seed: int, area: int, cache: int) -> int {
    let m = cache_row(seed, area, cache)
    var above = 100000
    var below = 100000
    var id = 0
    while id < DEN_LIMIT {
        if den_area(id) == area && id != 0 {
            let row = den_row(seed, id)
            if row < m && m - row < above { above = m - row }
            if row > m && row - m < below { below = row - m }
        }
        id += 1
    }
    if above == 100000 && below == 100000 {
        return if world.hash(seed, area, cache + 74, 2) == 0 then -1 else 1
    }
    if below > above then 1 else -1
}

/// sin of `i` twelfths of a quarter turn, in `[0, FP]`.
fn qsin(i: int) -> int {
    let k = if i < 0 then 0 else if i > 12 then 12 else i
    match k {
        0 => 0,
        1 => 33,
        2 => 66,
        3 => 98,
        4 => 128,
        5 => 157,
        6 => 181,
        7 => 203,
        8 => 221,
        9 => 237,
        10 => 248,
        11 => 254,
        _ => 256,
    }
}

/// Samples along a quarter arc.
const ARC_Q: int = 12

/// The branch's geometry, from its mouth's row and the route's column
/// there (`x0`, one spine evaluation: callers that know it pass it).
pub fn branch_geom_at(seed: int, field: int, area: int, cache: int, m: int, x0: int) -> Branch {
    let side = if area == BRAMBLEHOLD {
        (if x0 > 0 then -1 else 1)
    } else {
        branch_side(seed, area, cache)
    }
    let edge = half_width(field) - 13 + world.hash(seed, area, cache + 66, 4)
    let r = edge - side * x0
    let shape = shape_of(seed, area, cache, r)
    let dir = branch_dir(seed, area, cache)
    let amp = dir * (6 + world.hash(seed, area, cache + 78, 7))
    let climb = 12 + world.hash(seed, area, cache + 82, 7)
    var g = Branch {
        m: m,
        side: side,
        x0: x0,
        r: r,
        shape: shape,
        dir: dir,
        amp: amp,
        climb: climb,
        len: 0,
        end_x: 0,
        end_y: 0,
        // cb14: from the Teeth on an S carries a stem along the route's
        // column from its start row to its mouth row, so the S joins the
        // route where the route is (over the Mere's water or through the
        // Underteeth's stone a gap would cut it off).
        stem: area >= CRAGS && area != TOWN,
    }
    g.len = if shape == SHAPE_S {
        r
    } else if shape == SHAPE_HOOK {
        r - HOOK_RADIUS - 1 + ARC_Q + climb
    } else if shape == SHAPE_LOOP {
        r - LOOP_RADIUS + 2 * ARC_Q
    } else {
        let r1 = r - UTURN_RADIUS - BRANCH_HALF - 1
        r1 + 2 * ARC_Q + r1 * 3 / 5
    }
    let (ex, ey) = point_on(g, g.len)
    g.end_x = ex
    g.end_y = ey
    g
}

/// The branch's geometry.
pub fn branch_geom(seed: int, field: int, area: int, cache: int) -> Branch {
    let m = cache_row(seed, area, cache)
    branch_geom_at(seed, field, area, cache, m, spine(seed, area, m))
}

/// The shape a cache branch takes.
pub fn branch_shape(seed: int, field: int, area: int, cache: int) -> int {
    branch_geom(seed, field, area, cache).shape
}

/// The length of a cache branch's centreline in samples (one a cell along
/// the runs; `ARC_Q` a quarter turn).
pub fn branch_len(seed: int, field: int, area: int, cache: int) -> int {
    branch_geom(seed, field, area, cache).len
}

/// The centreline of a branch at sample `t` (0 at the route, `len` at the
/// cache), local cells: the shapes' runs, arcs and climbs.
fn point_on(g: Branch, t: int) -> (int, int) {
    let m = g.m
    let side = g.side
    let x0 = g.x0
    let r = g.r
    let dir = g.dir
    if g.shape == SHAPE_S {
        let u = if t < 0 then 0 else if t > r then r else t
        return (x0 + side * u, m + g.amp * (2 * ss(u * FP / r) - FP) / FP)
    }
    if g.shape == SHAPE_HOOK {
        let r1 = r - HOOK_RADIUS - 1
        if t <= r1 { return (x0 + side * t, m) }
        let cx = x0 + side * r1
        let cy = m + dir * HOOK_RADIUS
        if t <= r1 + ARC_Q {
            let i = t - r1
            return (
                cx + side * HOOK_RADIUS * qsin(i) / FP,
                cy - dir * HOOK_RADIUS * qsin(12 - i) / FP,
            )
        }
        let c = t - r1 - ARC_Q
        return (cx + side * HOOK_RADIUS, cy + dir * (if c > g.climb then g.climb else c))
    }
    if g.shape == SHAPE_LOOP {
        // The run meets the ring where the ring's tangent is the run's
        // own (its near pole), so the way in bends one way only; the
        // centreline follows half the ring to the far pole, where the
        // cache is (the ring is carved all the way round).
        let r1 = r - LOOP_RADIUS
        if t <= r1 { return (x0 + side * t, m) }
        let cx = x0 + side * r1
        let cy = m + dir * LOOP_RADIUS
        let i = t - r1
        if i <= ARC_Q {
            return (
                cx + side * LOOP_RADIUS * qsin(i) / FP,
                cy - dir * LOOP_RADIUS * qsin(12 - i) / FP,
            )
        }
        let j = i - ARC_Q
        return (cx + side * LOOP_RADIUS * qsin(12 - j) / FP, cy + dir * LOOP_RADIUS * qsin(j) / FP)
    }
    // The 180-degree turn: out along the row, a half turn, back along the
    // row two radii off for three fifths of the way.
    let r1 = r - UTURN_RADIUS - BRANCH_HALF - 1
    if t <= r1 { return (x0 + side * t, m) }
    let cx = x0 + side * r1
    let cy = m + dir * UTURN_RADIUS
    if t <= r1 + 2 * ARC_Q {
        let i = t - r1
        if i <= ARC_Q {
            return (
                cx + side * UTURN_RADIUS * qsin(i) / FP,
                cy - dir * UTURN_RADIUS * qsin(12 - i) / FP,
            )
        }
        let j = i - ARC_Q
        return (
            cx + side * UTURN_RADIUS * qsin(12 - j) / FP,
            cy + dir * UTURN_RADIUS * qsin(j) / FP,
        )
    }
    let back = t - r1 - 2 * ARC_Q
    let r2 = r1 * 3 / 5
    (cx - side * (if back > r2 then r2 else back), m + 2 * dir * UTURN_RADIUS)
}

/// The centreline of cache branch `cache` at sample `t` (0 at the route,
/// `branch_len` at the cache), local cells (`docs/DESIGN.md`, "The wide
/// forest").
pub fn branch_point(seed: int, field: int, area: int, cache: int, t: int) -> (int, int) {
    point_on(branch_geom(seed, field, area, cache), t)
}

/// Whether local cell `(x, at)` lies within `half` of a point on a run
/// along a row, between two columns inclusive.
fn on_run(x: int, at: int, row: int, xa: int, xb: int, hw: int) -> bool {
    let lo = if xa < xb then xa else xb
    let hi = if xa < xb then xb else xa
    x >= lo - hw && x <= hi + hw && abs(at - row) <= hw
}

/// Whether local cell `(x, at)` lies within `half` of an arc of radius
/// `radius` round `(cx, cy)`, restricted to the quadrant(s) `qx` (the sign
/// of x - cx, 0 for both) and `qy` (the sign of at - cy, 0 for both).
fn on_arc(x: int, at: int, cx: int, cy: int, radius: int, hw: int, qx: int, qy: int) -> bool {
    let dx = x - cx
    let dy = at - cy
    if qx != 0 && qx * dx < 0 || qy != 0 && qy * dy < 0 { return false }
    let d2 = dx * dx + dy * dy
    d2 >= (radius - hw) * (radius - hw) && d2 <= (radius + hw) * (radius + hw)
}

/// Whether local cell `(x, at)` lies on a branch (its shape's runs, arcs
/// and climb, and the alcove at its end).
fn on_branch(g: Branch, x: int, at: int) -> bool {
    let m = g.m
    let side = g.side
    let x0 = g.x0
    let r = g.r
    let dir = g.dir
    let hw = BRANCH_HALF
    if side * (x - x0) < 0 - hw || side * (x - x0) > r + hw { return false }
    if (x - g.end_x) * (x - g.end_x) + (at - g.end_y) * (at - g.end_y) <= 16 { return true }
    if g.shape == SHAPE_S {
        if g.stem && abs(x - x0) <= hw && (at - m) * g.amp <= 0 && abs(at - m) <= abs(g.amp) {
            return true
        }
        let u = side * (x - x0)
        if u < 0 || u > r { return false }
        return abs(at - (m + g.amp * (2 * ss(u * FP / r) - FP) / FP)) <= hw
    }
    if g.shape == SHAPE_HOOK {
        let r1 = r - HOOK_RADIUS - 1
        if on_run(x, at, m, x0, x0 + side * r1, hw) { return true }
        let cx = x0 + side * r1
        let cy = m + dir * HOOK_RADIUS
        if on_arc(x, at, cx, cy, HOOK_RADIUS, hw, side, 0 - dir) { return true }
        return abs(x - (cx + side * HOOK_RADIUS)) <= hw &&
            dir * (at - cy) >= 0 &&
            dir * (at - cy) <= g.climb
    }
    if g.shape == SHAPE_LOOP {
        let r1 = r - LOOP_RADIUS
        if on_run(x, at, m, x0, x0 + side * r1, hw) { return true }
        return on_arc(x, at, x0 + side * r1, m + dir * LOOP_RADIUS, LOOP_RADIUS, hw, 0, 0)
    }
    let r1 = r - UTURN_RADIUS - BRANCH_HALF - 1
    if on_run(x, at, m, x0, x0 + side * r1, hw) { return true }
    let cx = x0 + side * r1
    let cy = m + dir * UTURN_RADIUS
    if on_arc(x, at, cx, cy, UTURN_RADIUS, hw, side, 0) { return true }
    let r2 = r1 * 3 / 5
    on_run(x, at, m + 2 * dir * UTURN_RADIUS, cx, cx - side * r2, hw)
}

/// Whether local cell `(x, at)` lies on cache branch `cache` of an inland
/// area. The row band is tested first (a hash), then the side of the
/// route (one spine evaluation), and only then the shape.
pub fn in_branch(seed: int, field: int, area: int, cache: int, x: int, at: int) -> bool {
    let m = cache_row(seed, area, cache)
    if abs(at - m) > 32 { return false }
    // A cell on the far side of the field from an inland branch is never
    // on it: the route itself never leaves the middle third (the switchbacks'
    // 28, the routes' 19 and the noise), so the side is known before the
    // mouth's column is evaluated.
    if area != BRAMBLEHOLD {
        let side = branch_side(seed, area, cache)
        if side * x < 0 - 24 - BRANCH_HALF { return false }
    }
    let x0 = spine(seed, area, m)
    let side = if area == BRAMBLEHOLD {
        (if x0 > 0 then -1 else 1)
    } else {
        branch_side(seed, area, cache)
    }
    if side * (x - x0) < 0 - BRANCH_HALF { return false }
    on_branch(branch_geom_at(seed, field, area, cache, m, x0), x, at)
}

/// Short carved pockets off the route (cb05, "every dead end rewards"):
/// seven to nine cells deep, two cells of half width, an alcove at the end
/// with an old scent mark in it. Two in Bramblehold, one each in the
/// meadow, the Teeth and Gravehollow.
pub fn pocket_count(area: int) -> int {
    if area == BRAMBLEHOLD {
        2
    } else if area == LARKMEADOW || area == CRAGS || area == HUSH {
        1
    } else {
        0
    }
}

/// A pocket's row and side.
pub fn pocket_mouth(area: int, k: int) -> (int, int) {
    if area == BRAMBLEHOLD { return if k == 0 then (36, 1) else (214, 1) }
    if area == LARKMEADOW { return (210, 1) }
    if area == CRAGS { return (60, -1) }
    (120, 1)
}

/// A pocket's end (the scent mark's cell), local.
pub fn pocket_end(seed: int, area: int, k: int) -> (int, int) {
    let (row, side) = pocket_mouth(area, k)
    let depth = 7 + world.hash(seed, area, k + 86, 3)
    (spine(seed, area, row) + side * (half(seed, area, row) + depth), row)
}

/// Whether local cell `(x, at)` lies in pocket `k`.
fn in_pocket(seed: int, area: int, k: int, x: int, at: int) -> bool {
    let (row, side) = pocket_mouth(area, k)
    if abs(at - row) > 3 { return false }
    let (ex, _) = pocket_end(seed, area, k)
    if (x - ex) * (x - ex) + (at - row) * (at - row) <= 4 { return true }
    on_run(x, at, row, spine(seed, area, row), ex, 2) && side * (x - spine(seed, area, row)) >= 0
}

/// Bramblehold's fork (cb05, "forks that rejoin"): a second way between
/// rows 92 and 188, fourteen to eighteen cells west of the switchbacks,
/// easing out and back over twenty-four rows at each end, each ease
/// inside one leg of the switchbacks (an ease over an apex, or a shorter
/// one, is an S the bends census counts).
pub const FORK_FROM: int = 92

/// Where the fork rejoins.
pub const FORK_TO: int = 188

/// The fork's centre at a local row (the spine's when outside its rows);
/// it never comes within six cells of the field's edge.
pub fn fork(seed: int, field: int, at: int) -> int {
    let c = spine(seed, BRAMBLEHOLD, at)
    if at < FORK_FROM || at > FORK_TO { return c }
    let d = 14 + world.hash(seed, 93, 0, 5)
    let edge = if at - FORK_FROM < FORK_TO - at then at - FORK_FROM else FORK_TO - at
    let t = if edge > 24 then FP else edge * FP / 24
    let f = c - d * ss(t) / FP
    let limit = 6 - half_width(field)
    if f < limit then limit else f
}

fn in_fork(seed: int, field: int, x: int, at: int) -> bool {
    at >= FORK_FROM && at <= FORK_TO && abs(x - fork(seed, field, at)) <= 3
}

/// The second way into the boar's clearing (cb05): from the route at row
/// `BOAR_ROW + 22`, a run east and a climb north into the clearing's
/// south side, rounded by a short arc.
fn in_boar_back(seed: int, x: int, at: int) -> bool {
    let row = BOAR_ROW + 22
    if at > row + 3 || at < row - 16 || x < 0 { return false }
    let c = spine(seed, BRAMBLEHOLD, row)
    let cx = BOAR_X - 6 - 5
    if on_run(x, at, row, c, cx, 3) { return true }
    if on_arc(x, at, cx, row - 5, 5, 3, 1, 1) { return true }
    abs(x - (cx + 5)) <= 3 && at <= row - 5 && at >= row - 16
}

/// Seeded end of a shore offshoot, well beyond the den's quiet radius.
pub fn coast_end(seed: int, cache: int) -> int {
    40 + world.hash(seed, 201, cache, 6)
}

/// Each offshoot turns independently of the thorn route. The eight-cell
/// bends use the full curve, rather than the old half-amplitude branches.
pub fn coast_branch_x(seed: int, field: int, cache: int, at: int) -> int {
    coast_mouth(seed, field, cache) + curve(seed, 203 + cache, at)
}

/// Where an offshoot leaves the shore path, cells from the spawn: four
/// branches, two each side of the thorn path (R-cb02b-3 A), at a third
/// and two thirds of the coast's reach, the seed jittering each by up to
/// three cells. Even caches lie west, odd east; 0 and 1 near, 2 and 3 far.
pub fn coast_mouth(seed: int, field: int, cache: int) -> int {
    let sign = if cache % 2 == 0 then -1 else 1
    let rank = cache / 2 + 1
    sign * (coast_extent(field) * rank / 3 + world.hash(seed, 205, cache, 7) - 3)
}

/// True inside a shore branch or its rounded terminal clearing.
pub fn coast_branch(seed: int, field: int, cache: int, x: int, at: int) -> bool {
    let end = coast_end(seed, cache)
    let cx = coast_branch_x(seed, field, cache, end)
    let dx = x - cx
    let dy = at - end
    if dx * dx + dy * dy <= 16 { return true }
    if at < -10 || at > end { return false }
    let c = coast_branch_x(seed, field, cache, at)
    x >= c - 3 && x <= c + 3
}

/// A jetty at each end of the coast, a screen's walk from the initial
/// view's edge, varied by the seed; never both in view from the spawn.
pub fn jetty_x(seed: int, field: int, side: int) -> int {
    (if side == 0 then -1 else 1) * (coast_extent(field) + world.hash(seed, 211, side, 3))
}

/// Rocks cross the complete shore path and lap six cells into the river.
pub fn jetty(seed: int, field: int, x: int, y: int) -> bool {
    var side = 0
    while side < 2 {
        let c = jetty_x(seed, field, side)
        if x >= c - 1 && x <= c + 1 {
            let b = terrain.bank(seed, x) - 1
            if y >= b - 6 && y <= b + terrain.REED_ROWS + terrain.SHINGLE_ROWS + 2 + 3 {
                return true
            }
        }
        side += 1
    }
    false
}

/// The closed forest beyond an area's bounds and beyond the jetties: the
/// forest's own texture (trunks among the deep canopy), every cell solid;
/// in the crags the closed ground is stone.
fn closed(seed: int, area: int, x: int, y: int) -> int {
    if area == CRAGS { return terrain.ROCK }
    if area == UNDERTEETH { return terrain.CAVE }
    if area == MERE { return terrain.WATER }
    if area == STAND { return terrain.PINE }
    if world.hash(seed + area * 79, x, y, 100) < 16 then terrain.TRUNK else terrain.DARK
}

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// Whether a coast cell lies within `OPEN_REACH` of the shore, the thorn
/// route or one of the four branches (its alcove included).
pub fn near_route(seed: int, field: int, x: int, at: int) -> bool {
    if at <= OPEN_REACH { return true }
    if abs(x - spine(seed, SHINGLE, at)) <= OPEN_REACH { return true }
    var cache = 0
    while cache < cache_count(SHINGLE) {
        let mouth = coast_mouth(seed, field, cache)
        if x >= mouth - 2 * OPEN_REACH && x <= mouth + 2 * OPEN_REACH {
            let end = coast_end(seed, cache)
            if at <= end + OPEN_REACH {
                let c = coast_branch_x(seed, field, cache, if at > end then end else at)
                if abs(x - c) <= OPEN_REACH { return true }
            }
        }
        cache += 1
    }
    false
}

/// The one ground every path cell of an area draws (cb02c; the
/// maintainer's word, 2026-10-25: "The branch paths should be the same
/// color as the coastline/forest paths."): the shore's gravel on the
/// coast, for the shore, the thorn route, every branch and alcove, the
/// log branch and the gate's exit alike; the grass inland, under the
/// area's dusk keyframe; the crags' ledges and the river's bank are
/// gravel (stone and shingle) under their own keyframes; the town's lane
/// is gravel too (its cobbles under the night keyframe). Every carved cell
/// returns this kind, so a new path cannot drift into another colour
/// (`docs/PALETTE.md`, "path"); `art.path_styles` is the one set of styles
/// a path cell may draw in, and `--world-audit`'s `path_off` holds every
/// area to it.
pub fn path_kind(area: int) -> int {
    if area == SHINGLE || area == CRAGS || area == RIVER || area == TOWN || area == UNDERTEETH {
        terrain.GRAVEL
    } else if area == STAND {
        terrain.NEEDLES
    } else if area == BURN {
        terrain.ASH
    } else if area == MERE {
        terrain.REEDS
    } else {
        terrain.GRASS
    }
}

/// Whether an area holds a boss arena: Bramblehold (the boar), the Teeth
/// (the lynx), the Shallows (the elk), Gravehollow (the alpha).
pub fn has_arena(area: int) -> bool {
    area == BRAMBLEHOLD || area == CRAGS || area == RIVER || area == GRAVEHOLLOW
}

/// Whether an area has cb02's shortcut band (the cross path at row 22,
/// both sides): the five areas whose mouths cb02, cb03a and cb04 placed
/// there. cb14's mouths each carve their own run (`mouth_run`).
pub fn has_shortcut(area: int) -> bool {
    area == SHINGLE || area == BRAMBLEHOLD || area == LARKMEADOW || area == CRAGS || area == RIVER
}

/// The west bank of the Ashwater in the Shallows at local row `at`: the
/// river runs along the west of the route, the bank wandering about
/// fourteen cells west of the spine whatever the field, so the ford's
/// arena always straddles the route.
pub fn river_bank(seed: int, field: int, at: int) -> int {
    river_bank_at(seed, field, at, spine(seed, RIVER, at))
}

/// `river_bank` with the route's centre at the row already evaluated.
fn river_bank_at(seed: int, field: int, at: int, c: int) -> int {
    c - 14 + curve(seed, 97, at) + (field - field)
}

/// The local row a boss's arena is centred on in the crags, the river and
/// the old den: on the route, seven tenths of the way in, the den far
/// behind (156 of 224).
pub fn arena_row(area: int) -> int {
    length(area) * 7 / 10
}

/// A boss arena, local cells: `(cx, cy, radius)`. The boar's clearing is a
/// side branch east of Bramblehold's route; the lynx's bowl, the elk's
/// ford and the alpha's clearing lie on their routes at `arena_row`, the
/// elk's astride the bank so the shallows are half of it.
pub fn arena(seed: int, field: int, area: int) -> (int, int, int) {
    if area == BRAMBLEHOLD { return (BOAR_X, BOAR_ROW, BOAR_RADIUS) }
    let row = arena_row(area)
    if area == RIVER { return (river_bank(seed, field, row) + 4, row, ELK_RADIUS) }
    if area == GRAVEHOLLOW { return (spine(seed, area, row), row, ALPHA_RADIUS) }
    (spine(seed, area, row), row, LYNX_RADIUS)
}

/// The arenas' radii (cb14, item 12: every boss arena grown by half, the
/// shapes kept): the boar's clearing 11 -> 14, the lynx's bowl 12 -> 14,
/// the elk's ford 14 -> 18, the old den's bowl 12 -> 20.
pub const BOAR_RADIUS: int = 14

/// The lynx's bowl.
pub const LYNX_RADIUS: int = 14

/// The elk's ford.
pub const ELK_RADIUS: int = 18

/// The old den's bowl.
pub const ALPHA_RADIUS: int = 20

/// The largest arena radius (the row guard's reach).
pub const ARENA_MAX: int = 20

/// Whether local cell `(x, at)` lies inside the area's arena (within its
/// radius of the centre, inclusive).
pub fn in_arena(seed: int, field: int, area: int, x: int, at: int) -> bool {
    if !has_arena(area) { return false }
    // The row first: the centre's column costs a spine evaluation.
    let cy0 = if area == BRAMBLEHOLD then BOAR_ROW else arena_row(area)
    if abs(at - cy0) > ARENA_MAX { return false }
    let (cx, cy, r) = arena(seed, field, area)
    let dx = x - cx
    let dy = at - cy
    dx * dx + dy * dy <= r * r
}

/// The number of stone pillars in the lynx's bowl: its ledges.
pub const PILLARS: int = 3

/// A pillar's top-left local cell in the crags' arena: two cells by two,
/// five to seven cells east or west of the route at its own row (the
/// ledge's half width is at most three, so the route stays clear), two to
/// six rows from the centre, spread round it by the seed.
pub fn pillar(seed: int, field: int, k: int) -> (int, int) {
    let (cx, cy, _) = arena(seed, field, CRAGS)
    // Three bands of rows, so no two pillars share a row: above, level
    // with and below the centre.
    let dy = k * 4 - 5 + world.hash(seed, 302, k, 2)
    let py = cy + dy
    let reach = 5 + world.hash(seed, 301, k, 3)
    // Beside the route at its own row, on the pillar's side unless the
    // route has wandered that way and the pillar would leave the bowl
    // (within eight cells of the centre, both of its columns).
    let side = if k == 1 then -1 else 1
    var px = spine(seed, CRAGS, py) + side * reach
    if px < cx - 8 || px + 1 > cx + 8 { px = spine(seed, CRAGS, py) - side * reach }
    (px, py)
}

/// The kind an arena forces on local cell `(x, at)`, or -1 outside the
/// arena or where the area's own rule decides (the river's west half: the
/// water, the shallows and the reeds keep their kinds). Inside: the
/// area's path kind, the open ground a fight needs; in the crags the
/// pillars' stone.
pub fn arena_cell(seed: int, field: int, area: int, x: int, at: int) -> int {
    if !in_arena(seed, field, area, x, at) { return -1 }
    if area == CRAGS {
        var k = 0
        while k < PILLARS {
            let (px, py) = pillar(seed, field, k)
            if x >= px && x <= px + 1 && at >= py && at <= py + 1 { return terrain.ROCK }
            k += 1
        }
    }
    if area == RIVER && x < river_bank(seed, field, at) + 1 { return -1 }
    path_kind(area)
}

/// Whether local cell `(x, at)` (inside the area's bounds) is carved: the
/// route, a branch or its alcove, a pocket, the fork, a shortcut branch,
/// the gate's exit, an arena's open floor and the boar clearing's two
/// branches. In the town only the lane is carved: the rest of the town is
/// the town's own ground (`town.kind`).
pub fn carved(seed: int, field: int, area: int, x: int, at: int) -> bool {
    carved_at(seed, field, area, x, at, spine(seed, area, at))
}

/// `carved`, with the route's centre at the row already evaluated (one
/// spine evaluation a cell, cb05: `kind` passes it on).
fn carved_at(seed: int, field: int, area: int, x: int, at: int, c: int) -> bool {
    if area == BRAMBLEHOLD && in_clearing(seed, x, at) { return true }
    if thorn_collar(area, x, at) { return false }
    // A gate's cells are the gate's, not path: they draw as the gate and
    // the simulation holds them (cb14); the Underteeth's glow-worm
    // clusters on the tunnel's floor likewise draw as themselves.
    if gate_cell(seed, area, x, at) { return false }
    if area == UNDERTEETH && lands.glow_here(seed, x, at, c) { return false }
    let hw = half(seed, area, at)
    // The Mere's stepping stones are the route over open water, but not
    // path: they sink, and draw as stone (the path audit holds the reeds).
    if area == MERE && lands.stone_row(seed, length(area), at) && x >= c - hw && x <= c + hw {
        return false
    }
    if x >= c - hw && x <= c + hw { return true }
    if area == TOWN { return false }
    if arena_cell(seed, field, area, x, at) == path_kind(area) { return true }
    if area == BRAMBLEHOLD {
        // The den's approach stays west of the arena: the switchback must
        // not send the shortest walk through the boss before reaching its
        // mouth.
        if at >= BOAR_ROW && at <= BOAR_ROW + 38 && x >= BOAR_X - 19 && x <= BOAR_X - 11 {
            return true
        }
        // The boar's clearing is reached by a short branch east of the
        // route, and from the south by a second way (cb05).
        if at >= BOAR_ROW - 2 && at <= BOAR_ROW + 2 && x >= c && x <= BOAR_X { return true }
        if in_boar_back(seed, x, at) { return true }
        if in_fork(seed, field, x, at) { return true }
    }
    var cache = 0
    while cache < cache_count(area) {
        if area == SHINGLE {
            if coast_branch(seed, field, cache, x, at) { return true }
        } else if in_branch(seed, field, area, cache, x, at) {
            return true
        }
        cache += 1
    }
    var k = 0
    while k < pocket_count(area) {
        if in_pocket(seed, area, k, x, at) { return true }
        k += 1
    }
    // Shortcut branches also curve, each toward its fixed graph mouth, and
    // end there: a path never runs on to the area's edge. In the Shallows
    // the cross path is the gravel bar across the river the shallows
    // shortcut names.
    if has_shortcut(area) && at >= 15 && at <= 30 && x >= -34 && x <= 34 {
        let by = 22 + curve(seed, area + 71, x) / 2
        if at >= by - 3 && at <= by + 3 { return true }
    }
    // cb14's mouths: a curved run from the route to each mouth at its own
    // row, on the mouth's side alone (`later_mouths`: at most two an area,
    // so a cell costs no more than two row guards).
    let (first, second) = later_mouths(area)
    if first >= 0 && mouth_run(seed, area, first, x, at, c) { return true }
    if second >= 0 && mouth_run(seed, area, second, x, at, c) { return true }
    // The thorn wall sits at the end of a deliberate treeless branch.
    if area == SHINGLE && at >= 140 && at <= LENGTH {
        let exit_centre = if at < 150 then spine(seed, area, 140) * (150 - at) / 10 else 0
        if x >= exit_centre - 3 && x <= exit_centre + 3 { return true }
    }
    false
}

/// Whether world cell `(x, y)` is path: the shore's gravel rows between
/// the jetties, or a carved cell inside the area's bounds.
pub fn on_path(seed: int, field: int, area: int, x: int, y: int) -> bool {
    if area == SHINGLE {
        let b = terrain.bank(seed, x) - 1
        if y >= b + terrain.REED_ROWS && y < b + terrain.REED_ROWS + terrain.SHINGLE_ROWS + 2 {
            return !jetty(seed, field, x, y) &&
                x > jetty_x(seed, field, 0) &&
                x < jetty_x(seed, field, 1)
        }
        if y < b + terrain.REED_ROWS { return false }
    }
    let at = y - origin(seed, area)
    let w = bound(field, area)
    if x < 0 - w || x > w || at < 0 && area != SHINGLE || at > length(area) { return false }
    carved(seed, field, area, x, at)
}

/// The number of landmarks in an area (cb05).
pub fn landmark_count(area: int) -> int {
    match area {
        1 => 4,
        2 => 4,
        3 => 2,
        4 => 1,
        5 => 1,
        6 => 2,
        7 => 2,
        8 => 1,
        9 => 1,
        10 => 1,
        11 => 6,
        12 => 1,
        _ => 0,
    }
}

/// Landmark kinds of cb14: the lookout at the Stand's top (the map's
/// reveal), the cutters' ruin beside it (the Hermit's), the kiln (the
/// charcoal-burners', the Burn's den), the sett at the Teeth's foot
/// (Dunmoss's, the Underteeth's mouth), the causeway's first post in the
/// Mere, the bone cache's heap in the Underteeth, a standing stone of the
/// Howe (five, one line each), the stone mouth into Gravehollow.
pub const LM_LOOKOUT: int = 8

/// The cutters' ruin.
pub const LM_RUIN: int = 9

/// The kiln.
pub const LM_KILN: int = 10

/// Dunmoss's sett.
pub const LM_SETT: int = 11

/// The causeway's post.
pub const LM_POST: int = 12

/// The bone heap.
pub const LM_BONES: int = 13

/// A standing stone.
pub const LM_MENHIR: int = 14

/// The stone mouth.
pub const LM_MOUTH: int = 15

/// The number of landmark kinds, cb14's counted.
pub const LM_KINDS: int = 16

/// The local row the lookout stands on: the Stand's top, before the
/// windthrown pine.
pub const LOOKOUT_ROW: int = 200

/// The lookout's local cell: a ledge east of the route at the ridge's top.
pub fn lookout(seed: int) -> (int, int) {
    (spine(seed, STAND, LOOKOUT_ROW) + 8, LOOKOUT_ROW)
}

/// The rows of the Howe's five standing stones.
pub fn menhir_row(k: int) -> int {
    30 + 40 * k
}

/// A standing stone's local cell: beside the route, alternating sides,
/// six to eight cells off it.
pub fn menhir(seed: int, k: int) -> (int, int) {
    let row = menhir_row(k)
    let side = if k % 2 == 0 then -1 else 1
    (spine(seed, HOWE, row) + side * (6 + world.hash(seed, 310, k, 3)), row)
}

/// Whether local cell `(x, at)` is one of a standing stone's two cells
/// (the stone stands on its row and the row above).
pub fn on_menhir(seed: int, x: int, at: int) -> bool {
    var k = 0
    while k < 5 {
        let row = menhir_row(k)
        if at == row || at == row - 1 {
            let (mx, _) = menhir(seed, k)
            if x == mx { return true }
        }
        k += 1
    }
    false
}

/// The rows a gate's cells span at an area's far end (the way on): the
/// last five rows but two.
pub fn gate_rows(area: int) -> (int, int) {
    (length(area) - 6, length(area) - 4)
}

/// Whether local cell `(x, at)` is a gate cell of the area (cb14): the
/// Stand's windthrown pine (a squeeze three cells wide), the Burn's burnt
/// oak, the Howe's stone mouth, across the route at the far end; the sett
/// at the Teeth's mouth of the Underteeth.
pub fn gate_cell(seed: int, area: int, x: int, at: int) -> bool {
    if area == STAND || area == BURN || area == HOWE {
        let (lo, hi) = gate_rows(area)
        return at >= lo && at <= hi && x >= -2 && x <= 2
    }
    if area == CRAGS {
        // The row first (a hash): the mouth's run costs a curve.
        let (m, _) = mouth(area, EDGE_SETT)
        if abs(at - m) > 8 { return false }
        let (px, py) = portal(seed, area, EDGE_SETT)
        return abs(x - px / FP) <= 2 && abs(at - (py / FP - origin(seed, area))) <= 1
    }
    false
}

/// Landmark `k` of an area: its kind and local cell. The den features
/// stand within sight of their dens (the split oak east of the split
/// roots, the cleft west of the ledge cleft, the willow over the water
/// west of the willow root); the burn's landmarks where the retired dens
/// stood (the coal roots at the thicket's edge, the low embers and the ash
/// shelter in the meadow's burn); Quill's perch a screen into the meadow;
/// the scent marks at the pockets' and the yards' ends.
pub fn landmark(seed: int, field: int, area: int, k: int) -> (int, int, int) {
    if area == BRAMBLEHOLD {
        if k == 0 { return (LM_STUMPS, spine(seed, area, 56) - 9, 56) }
        if k == 1 {
            let (dx, dy) = den_position(seed, 1)
            return (LM_SPLIT_OAK, (dx - FP / 2) / FP + 6, (dy - FP / 2) / FP - 2)
        }
        let (px, py) = pocket_end(seed, area, k - 2)
        return (LM_SCENT, px, py)
    }
    if area == LARKMEADOW {
        if k == 0 { return (LM_PERCH, spine(seed, area, 30) + 7, 30) }
        if k == 1 { return (LM_COALS, spine(seed, area, 96) + 7, 96) }
        if k == 2 { return (LM_FRAME, spine(seed, area, 140) - 11, 140) }
        let (px, py) = pocket_end(seed, area, 0)
        return (LM_SCENT, px, py)
    }
    if area == CRAGS {
        if k == 0 {
            let (dx, dy) = den_position(seed, 4)
            return (LM_CLEFT, (dx - FP / 2) / FP - 6, (dy - FP / 2) / FP)
        }
        let (px, py) = pocket_end(seed, area, 0)
        return (LM_SCENT, px, py)
    }
    if area == RIVER {
        let (dx, dy) = den_position(seed, 5)
        return (LM_WILLOW, (dx - FP / 2) / FP - 7, (dy - FP / 2) / FP - 1)
    }
    if area == HUSH {
        let (px, py) = pocket_end(seed, area, 0)
        return (LM_SCENT, px, py)
    }
    if area == STAND {
        let (lx, ly) = lookout(seed)
        if k == 0 { return (LM_LOOKOUT, lx, ly) }
        return (LM_RUIN, lx + 5, ly - 3)
    }
    if area == BURN {
        let (dx, dy) = den_position(seed, 13)
        return (LM_KILN, (dx - FP / 2) / FP + 6, (dy - FP / 2) / FP - 1)
    }
    if area == MERE { return (LM_POST, spine(seed, area, 12) + 4, 12) }
    if area == UNDERTEETH {
        let (dx, dy) = den_position(seed, 15)
        return (LM_BONES, (dx - FP / 2) / FP + 4, (dy - FP / 2) / FP - 1)
    }
    if area == HOWE {
        if k < 5 {
            let (mx, my) = menhir(seed, k)
            return (LM_MENHIR, mx, my)
        }
        let (lo, _) = gate_rows(area)
        return (LM_MOUTH, 0, lo - 2)
    }
    if area == GRAVEHOLLOW {
        let (cx, cy, r) = arena(seed, field, area)
        return (LM_SCENT, cx, cy - r - 3)
    }
    let (sx, sy) = town.scent_mark(seed, k)
    (LM_SCENT, sx, sy)
}

/// A landmark's row alone (cheap: a hash at most), for the row guard the
/// per-cell test takes before it asks for the column.
pub fn landmark_row(seed: int, area: int, k: int) -> int {
    if area == BRAMBLEHOLD {
        if k == 0 { return 56 }
        if k == 1 { return den_row(seed, 1) - 2 }
        let (row, _) = pocket_mouth(area, k - 2)
        return row
    }
    if area == LARKMEADOW {
        if k == 0 { return 30 }
        if k == 1 { return 96 }
        if k == 2 { return 140 }
        let (row, _) = pocket_mouth(area, 0)
        return row
    }
    if area == CRAGS {
        if k == 0 { return den_row(seed, 4) }
        let (row, _) = pocket_mouth(area, 0)
        return row
    }
    if area == RIVER { return den_row(seed, 5) - 1 }
    if area == HUSH {
        let (row, _) = pocket_mouth(area, 0)
        return row
    }
    if area == STAND { return if k == 0 then LOOKOUT_ROW else LOOKOUT_ROW - 3 }
    if area == BURN { return den_row(seed, 13) - 1 }
    if area == MERE { return 12 }
    if area == UNDERTEETH { return den_row(seed, 15) - 1 }
    if area == HOWE {
        if k < 5 { return menhir_row(k) }
        let (lo, _) = gate_rows(area)
        return lo - 2
    }
    if area == GRAVEHOLLOW { return arena_row(area) - ALPHA_RADIUS - 3 }
    let (_, sy) = town.scent_mark(seed, k)
    sy
}

/// Whether a local cell lies in a landmark's cleared patch (seven cells by
/// three; the stump-field's is the open ash its stumps stand round).
pub fn landmark_clear(seed: int, field: int, area: int, x: int, at: int) -> bool {
    var k = 0
    while k < landmark_count(area) {
        if abs(at - landmark_row(seed, area, k)) <= 1 {
            let (_, lx, ly) = landmark(seed, field, area, k)
            if abs(x - lx) <= 3 && abs(at - ly) <= 1 { return true }
        }
        k += 1
    }
    false
}

/// Whether a local cell lies in the burn (cb05): the stump-field at the
/// thicket's edge (rows 34..78) and the meadow's burnt ground (rows
/// 84..152), where the fire's noise ran hot; ash underfoot, the odd
/// burnt stump standing.
pub fn burnt(seed: int, area: int, x: int, at: int) -> bool {
    if area == BRAMBLEHOLD {
        return at >= 34 && at <= 78 && terrain.noise2(seed + 7, 8, x, at) > 118
    }
    if area == LARKMEADOW {
        return at >= 84 && at <= 152 && terrain.noise2(seed + 7, 8, x, at) > 128
    }
    false
}

/// Seeded collision tile after route carving.
pub fn kind(seed: int, field: int, area: int, x: int, y: int) -> int {
    let at = y - origin(seed, area)
    // Water, one clean bank row, and a constant-width horizontal path.
    // Never clip these bands at the den's local y=0.
    if area == SHINGLE {
        let b = terrain.bank(seed, x) - 1
        if jetty(seed, field, x, y) { return terrain.ROCK }
        if y < b { return terrain.WATER }
        if (x <= jetty_x(seed, field, 0) || x >= jetty_x(seed, field, 1)) &&
            y < b + terrain.REED_ROWS + terrain.SHINGLE_ROWS + 2 {
            return closed(seed, area, x, y)
        }
        if y < b + terrain.REED_ROWS { return terrain.REEDS }
        if y < b + terrain.REED_ROWS + terrain.SHINGLE_ROWS + 2 { return path_kind(area) }
    }
    // The coast's rows above the spawn's are the shore's own (the bank
    // wanders eight cells); inland an area begins at its entry row.
    let w = bound(field, area)
    if x < 0 - w || x > w || at < 0 && area != SHINGLE || at > length(area) {
        return closed(seed, area, x, y)
    }
    if thorn_collar(area, x, at) { return closed(seed, area, x, y) }
    // The route's centre at this row, evaluated once for the cell.
    let c = spine(seed, area, at)
    if area == TOWN {
        // The lane is the route; everything else is the town's.
        if carved_at(seed, field, area, x, at, c) { return path_kind(area) }
        return town.kind(seed, field, x, at)
    }
    let forced = arena_cell(seed, field, area, x, at)
    if forced >= 0 { return forced }
    if area == RIVER {
        // The Ashwater along the west: the water, the shallows where the
        // arena reaches into it (the ford), a row of reeds, three of
        // shingle; the carved gravel bar of the cross path crosses the
        // river itself.
        let b = river_bank_at(seed, field, at, c)
        if x < b {
            if carved_at(seed, field, area, x, at, c) { return path_kind(area) }
            if in_arena(seed, field, area, x, at) { return terrain.SHALLOWS }
            return terrain.WATER
        }
        if x == b {
            return if carved_at(seed, field, area, x, at, c) then path_kind(area) else terrain.REEDS
        }
        if x <= b + 3 { return path_kind(area) }
    }
    // The sett's squeeze (the Underteeth's mouth in the Teeth): open
    // ground off the route's run, held shut by the simulation.
    if area == CRAGS && gate_cell(seed, area, x, at) { return terrain.GATE }
    if area < STAND && carved_at(seed, field, area, x, at, c) { return path_kind(area) }
    if area == SHINGLE && !near_route(seed, field, x, at) { return closed(seed, area, x, y) }
    if area >= STAND {
        // cb14's areas: carved cells are the area's path kind (the Mere's
        // stones apart: `lands.mere` says), the rest is `lands`'s; a
        // landmark's patch is cleared as in every area (the standing
        // stones are their own terrain).
        let carved_here = carved_at(seed, field, area, x, at, c)
        let cleared = area != HOWE && landmark_clear(seed, field, area, x, at)
        if area == MERE {
            if cleared { return terrain.REEDS }
            return lands.mere(seed, length(area), x, at, c, half(seed, area, at), carved_here)
        }
        if gate_cell(seed, area, x, at) { return terrain.GATE }
        if cleared { return path_kind(area) }
        if area == STAND {
            let (lo, hi) = gate_rows(area)
            if at >= lo && at <= hi { return terrain.PINE }
            return lands.stand(seed, x, at, y, carved_here)
        }
        if area == BURN {
            let (lo, hi) = gate_rows(area)
            if at >= lo && at <= hi { return terrain.CHAR }
            return lands.burn(seed, x, at, y, carved_here)
        }
        if area == UNDERTEETH {
            let ch = lands.chamber_at(at)
            let cr = if ch >= 0 then spine(seed, area, lands.chamber_row(ch)) else 0
            return lands.underteeth(seed, x, at, c, half(seed, area, at), cr, carved_here)
        }
        if area == HOWE {
            let (lo, hi) = gate_rows(area)
            if at >= lo && at <= hi { return terrain.MENHIR }
            return lands.howe(seed, x, at, y, c, on_menhir(seed, x, at), carved_here)
        }
        return lands.gravehollow(seed, x, y, carved_here)
    }
    let h = world.hash(seed + area * 79, x, y, 100)
    if landmark_clear(seed, field, area, x, at) {
        return if burnt(seed, area, x, at) then terrain.ASH else terrain.GRASS
    }
    if burnt(seed, area, x, at) {
        // Ash underfoot, burnt stumps standing (more at the coal roots).
        return if h < (if area == BRAMBLEHOLD then 9 else 4) then terrain.TRUNK else terrain.ASH
    }
    let n = terrain.noise2(seed + area * 101, 5, x, y)
    if area == LARKMEADOW {
        if at == meadow.creek(seed, x) { return terrain.WATER }
        if meadow.solid(seed, x, y) { return terrain.TRUNK }
        return if h < 15 then terrain.REEDS else terrain.GRASS
    }
    if area == CRAGS {
        // Stone in masses, boulders among the open ledges, a dead pine, a
        // tuft of scree grass: a climb, not a wood.
        if n > 100 || h < 10 { return terrain.ROCK }
        return if h < 14 then terrain.TRUNK else if h < 34 then terrain.GRASS else terrain.GRAVEL
    }
    if area == HUSH {
        // The deep wood: night always, the brush thick, the floor open
        // under it where the pack's scent lies.
        if h < 14 { return terrain.TRUNK }
        return if n > 110 then terrain.DARK else if h < 50 then terrain.CANOPY else terrain.GRASS
    }
    if area == RIVER {
        if h < 10 { return terrain.TRUNK }
        return if n > 140 then terrain.DARK else if h < 55 then terrain.CANOPY else terrain.GRASS
    }
    if h < 16 then terrain.TRUNK else if n > 130 then terrain.DARK else terrain.CANOPY
}

/// Terrain collision, shared by actors and the independent reachability flood.
pub fn blocked(seed: int, field: int, area: int, x: int, y: int) -> bool {
    terrain.solid(kind(seed, field, area, x, y))
}

/// Whether an edge is a path (an area's entry or exit, crossed by walking
/// through) rather than a shortcut (opened, then crossed with `r`).
pub fn path_edge(edge: int) -> bool {
    edge == 0 ||
        edge == 1 ||
        edge == 4 ||
        edge == 5 ||
        edge == 6 ||
        edge == 9 ||
        edge >= EDGE_STAND_OUT && edge <= EDGE_MOUTH
}

/// The two ends of an edge: the area it leaves (the far end of the way
/// on, for a path edge) and the area it enters.
fn ends(edge: int) -> (int, int) {
    match edge {
        0 => (SHINGLE, TOWN),
        1 => (BRAMBLEHOLD, STAND),
        2 => (BRAMBLEHOLD, SHINGLE),
        3 => (LARKMEADOW, BRAMBLEHOLD),
        4 => (LARKMEADOW, BURN),
        5 => (CRAGS, MERE),
        6 => (RIVER, HUSH),
        7 => (CRAGS, LARKMEADOW),
        8 => (RIVER, CRAGS),
        9 => (TOWN, BRAMBLEHOLD),
        10 => (STAND, LARKMEADOW),
        11 => (BURN, CRAGS),
        12 => (MERE, RIVER),
        13 => (HUSH, HOWE),
        14 => (HOWE, GRAVEHOLLOW),
        15 => (STAND, BRAMBLEHOLD),
        16 => (BURN, LARKMEADOW),
        17 => (MERE, CRAGS),
        18 => (CRAGS, UNDERTEETH),
        19 => (UNDERTEETH, HUSH),
        _ => (-1, -1),
    }
}

/// Whether a path edge's portal in `area` is the area's far end (local row
/// `length - 1`), the way on; else its entry (row 1), the way back.
pub fn exit_end(area: int, edge: int) -> bool {
    let (from, _) = ends(edge)
    path_edge(edge) && from == area
}

/// The column a shortcut's mouth stands in: the log and the ledge west,
/// the hedge east; the shallows east of the crags and west (over the
/// water, on the gravel bar) in the Shallows; cb14's mouths by `mouth`.
pub fn shortcut_x(area: int, edge: int) -> int {
    if edge >= EDGE_STAND_OUT {
        let (_, x) = mouth(area, edge)
        return x
    }
    if edge == 2 || edge == 7 { return -32 }
    if edge == 8 && area == RIVER then -32 else 32
}

/// A cb14 shortcut mouth in an area: its local row and column. The scree
/// leaves the Stand west at row 60 and lands beside Bramblehold's split
/// roots (east, row 212); the streambed leaves the Burn east at row 40 and
/// lands past Larkmeadow's last warm hollow (east, row 250); the raft
/// leaves the Mere's far shore west at row 190 and lands at the Teeth's
/// way on (east, row 200); the sett is west of the Teeth's route at row
/// 72 and is the Underteeth's entry; the roots are the Underteeth's far end
/// and open into the Hush west at row 40.
pub fn mouth(area: int, edge: int) -> (int, int) {
    if edge == EDGE_SCREE { return if area == STAND then (60, -32) else (212, 32) }
    if edge == EDGE_STREAMBED { return if area == BURN then (40, 32) else (250, 32) }
    if edge == EDGE_RAFT { return if area == MERE then (190, -32) else (200, 32) }
    if edge == EDGE_SETT { return if area == CRAGS then (72, -32) else (1, 0) }
    if area == UNDERTEETH then (length(UNDERTEETH) - 1, 0) else (40, -32)
}

/// The cb14 shortcut edges with a side mouth in an area (at most two),
/// -1 for none: the scree in the Stand and Bramblehold, the streambed in
/// the Burn and Larkmeadow, the raft in the Mere and the Teeth, the sett
/// in the Teeth, the roots in the Hush (the Underteeth's two mouths are
/// its ends, not side mouths).
pub fn later_mouths(area: int) -> (int, int) {
    if area == CRAGS { return (EDGE_RAFT, EDGE_SETT) }
    if area == STAND || area == BRAMBLEHOLD { return (EDGE_SCREE, -1) }
    if area == BURN || area == LARKMEADOW { return (EDGE_STREAMBED, -1) }
    if area == MERE { return (EDGE_RAFT, -1) }
    if area == HUSH { return (EDGE_ROOTS, -1) }
    (-1, -1)
}

/// Whether local cell `(x, at)` lies on the run from the route to a cb14
/// mouth: a curve of half width 3 from the route's centre at the mouth's
/// row to the mouth's column (`c` is the route's centre at `at`).
fn mouth_run(seed: int, area: int, edge: int, x: int, at: int, c: int) -> bool {
    let (m, mx) = mouth(area, edge)
    if mx == 0 || abs(at - m) > 8 { return false }
    let by = m + curve(seed, area + 71 + edge, x) / 2
    if at < by - 3 || at > by + 3 { return false }
    let x0 = spine(seed, area, m)
    let _ = c
    if mx < 0 then x >= mx && x <= x0 else x >= x0 && x <= mx
}

/// Portals: a path edge's at the area's end (the entry row 1 or the far
/// row), a shortcut's at its mouth.
pub fn portal(seed: int, area: int, edge: int) -> (int, int) {
    let o = origin(seed, area)
    if path_edge(edge) {
        return if exit_end(area, edge) then (0, (o + length(area) - 1) * FP) else (0, FP)
    }
    if edge >= EDGE_STAND_OUT {
        let (m, x) = mouth(area, edge)
        if x == 0 { return (0, (o + m) * FP) }
        return (x * FP, (o + m + curve(seed, area + 71 + edge, x) / 2) * FP)
    }
    let x = shortcut_x(area, edge)
    (x * FP, (o + 22 + curve(seed, area + 71, x) / 2) * FP)
}

/// Other area for an incident edge, -1 otherwise.
pub fn other(area: int, edge: int) -> int {
    let (a, b) = ends(edge)
    if area == a then b else if area == b then a else -1
}

/// The shortcut bit an edge sets in the journey's `shortcuts`: the log 1,
/// the hedge 2, the ledge 4, the shallows 8, the scree 16, the streambed
/// 32, the raft 64, the sett 128, the roots 256; 0 for a path edge.
pub fn shortcut_bit(edge: int) -> int {
    match edge {
        2 => 1,
        3 => 2,
        7 => 4,
        8 => 8,
        15 => 16,
        16 => 32,
        17 => 64,
        18 => 128,
        19 => 256,
        _ => 0,
    }
}

/// Every shortcut bit set.
pub const SHORTCUTS_ALL: int = 511

/// Longest quantised straight run of centre positions in an area.
pub fn straight_run(seed: int, area: int) -> int {
    var longest = 1
    var run = 1
    var y = 1
    while y <= length(area) {
        if spine(seed, area, y) == spine(seed, area, y - 1) { run += 1 } else { run = 1 }
        if run > longest { longest = run }
        y += 1
    }
    longest
}

/// The coast's flood begins at the river: the bank wanders eight rows
/// either side of the spawn's, so shore cells lie north of local row 0.
pub const COAST_TOP: int = -16

/// The flood of an area's actual tiles from its entry: the reached flags,
/// one a cell, `width` cells a row from `top`. Independent of path
/// carving: it asks `blocked` alone.
pub fn flood(seed: int, field: int, area: int) -> List[int] {
    let w = bound(field, area)
    let width = w * 2 + 1
    let top = if area == SHINGLE then COAST_TOP else 0
    let o = origin(seed, area)
    let l = length(area)
    var seen = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (l - top + 1) { (mut seen).push(0); i += 1 }
    let start = (0 - top) * width + w
    seen[start] = 1
    (mut queue).push(start)
    var head = 0
    while head < queue.len {
        let cell = queue[head]
        let x = cell % width - w
        let y = cell / width + top
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= top && ny <= l {
                let at = (ny - top) * width + nx + w
                if seen[at] == 0 && !blocked(seed, field, area, nx, ny + o) {
                    seen[at] = 1
                    (mut queue).push(at)
                }
            }
            d += 1
        }
        head += 1
    }
    seen
}

/// Whether the flood reached local cell `(x, at)`.
pub fn reached(seen: List[int], field: int, area: int, x: int, at: int) -> bool {
    let w = bound(field, area)
    let width = w * 2 + 1
    let top = if area == SHINGLE then COAST_TOP else 0
    if x < 0 - w || x > w || at < top || at > length(area) { return false }
    seen[(at - top) * width + x + w] == 1
}

/// BFS of actual tiles, independent of path-carving logic. Returns the
/// number of reached required destinations: dens + incident portals +
/// caches + the arena's centre + the landmarks.
pub fn reach_count(seed: int, field: int, area: int) -> int {
    let seen = flood(seed, field, area)
    let o = origin(seed, area)
    var count = 0
    var den = 0
    while den < DEN_LIMIT {
        if den_area(den) == area {
            let (x, y) = den_position(seed, den)
            if reached(seen, field, area, (x - FP / 2) / FP, (y - FP / 2) / FP - o) { count += 1 }
        }
        den += 1
    }
    var edge = 0
    while edge < EDGES {
        if other(area, edge) >= 0 {
            let (x, y) = portal(seed, area, edge)
            if reached(seen, field, area, x / FP, y / FP - o) { count += 1 }
        }
        edge += 1
    }
    var cache = 0
    while cache < cache_count(area) {
        let (x, y) = cache_position(seed, field, area, cache)
        if reached(seen, field, area, (x - FP / 2) / FP, (y - FP / 2) / FP - o) { count += 1 }
        cache += 1
    }
    if has_arena(area) {
        let (cx, cy, _) = arena(seed, field, area)
        if reached(seen, field, area, cx, cy) { count += 1 }
    }
    var k = 0
    while k < landmark_count(area) {
        let (_, lx, ly) = landmark(seed, field, area, k)
        if reached(seen, field, area, lx, ly) { count += 1 }
        k += 1
    }
    count
}

/// Finite caches in an area: the coast's four alcoves, three inland in the
/// thicket and the meadow, four in the town's yards; none in the last
/// three areas (the bosses hold them).
pub fn cache_count(area: int) -> int {
    if area == SHINGLE || area == TOWN {
        4
    } else if area == GRAVEHOLLOW {
        2
    } else {
        3
    }
}

/// The journey's bit for a cache: the Shingle's four first (0..3), then
/// the thicket's first two (4, 5), the meadow's first two (6, 7), the
/// town's four (8..11), the thicket's third (12), the meadow's third (13);
/// sixteen bits in all (cb05 widened the eight). cb14's alcoves follow:
/// the Teeth's, the Shallows' and the Hush's three each (16..24), then the
/// Stand's, the Burn's, the Mere's, the Underteeth's, the Howe's three
/// each and Gravehollow's two (25..41): forty-two bits.
pub fn cache_bit(area: int, cache: int) -> int {
    if area == SHINGLE { return cache }
    if area == TOWN { return 8 + cache }
    if area == BRAMBLEHOLD || area == LARKMEADOW {
        if cache == 2 { return if area == BRAMBLEHOLD then 12 else 13 }
        return if area == BRAMBLEHOLD then 4 + cache else 6 + cache
    }
    if area <= HUSH { return 16 + 3 * (area - CRAGS) + cache }
    25 + 3 * (area - STAND) + cache
}

/// The number of cache bits a journey may hold (`cache_bit` below it).
pub const CACHE_BITS: int = 42

/// Destinations an area must reach: its dens, incident portals, caches,
/// its arena's centre and its landmarks.
pub fn required(area: int) -> int {
    var n = cache_count(area) + (if has_arena(area) then 1 else 0) + landmark_count(area)
    var den = 0
    while den < DEN_LIMIT {
        if den_area(den) == area { n += 1 }
        den += 1
    }
    var edge = 0
    while edge < EDGES {
        if other(area, edge) >= 0 { n += 1 }
        edge += 1
    }
    n
}

/// Every den, incident edge, cache, arena and landmark is reachable in
/// this area.
pub fn reachable(seed: int, field: int, area: int) -> bool {
    reach_count(seed, field, area) == required(area)
}

/// Six small rooms along the thicket route, each attached to a reason.
pub const CLEARINGS: int = 6

/// Clearing centre and radius in cells; widths are seven, nine or eleven.
pub fn clearing(seed: int, n: int) -> (int, int, int) {
    let y = clearing_row(n)
    let x = spine(seed, BRAMBLEHOLD, y) + (if n % 2 == 0 then -3 else 3)
    (x, y, 3 + world.hash(seed, n, 212, 3))
}

/// A room's existing attraction, not an empty widening.
pub fn clearing_reason(n: int) -> str {
    if n == 0 {
        "entry"
    } else if n == 1 {
        "shortcut view"
    } else if n == 2 {
        "scent cache"
    } else if n == 3 || n == 4 {
        "den"
    } else {
        "foe cluster"
    }
}

/// The rooms' rows (cb05: the entry, the shortcut view, the first cache's
/// mouth, the briar hollow, the split roots, the last cluster).
pub fn clearing_row(n: int) -> int {
    if n == 0 {
        8
    } else if n == 1 {
        22
    } else if n == 2 {
        60
    } else if n == 3 {
        100
    } else if n == 4 {
        196
    } else {
        260
    }
}

fn in_clearing(seed: int, x: int, y: int) -> bool {
    var n = 0
    while n < CLEARINGS {
        if abs(y - clearing_row(n)) > 5 { n += 1; continue }
        let (cx, cy, radius) = clearing(seed, n)
        if abs(x - cx) <= radius && abs(y - cy) <= radius { return true }
        n += 1
    }
    false
}

/// Count bends whose incoming/outgoing route vectors turn at least 90
/// degrees (the switchbacks' apexes, rows 20 + 36 k).
pub fn switchbacks(seed: int) -> int {
    var count = 0
    var at = 20
    while at <= 236 {
        let a = spine(seed, BRAMBLEHOLD, at) - spine(seed, BRAMBLEHOLD, at - 8)
        let b = spine(seed, BRAMBLEHOLD, at + 8) - spine(seed, BRAMBLEHOLD, at)
        if a * b + 64 <= 0 { count += 1 }
        at += 36
    }
    count
}

/// Cardinal route distance of the seeded centreline, including lateral travel.
pub fn path_length(seed: int, area: int) -> int {
    var total = length(area)
    var y = 1
    while y <= length(area) {
        total += abs(spine(seed, area, y) - spine(seed, area, y - 1))
        y += 1
    }
    total
}

/// One thorn gate joins the Shingle to Cinderwick (edge zero).
pub const THORN_GATES: int = 1

/// The throat has five cells, not the spine's wider accidental bypass.
pub fn thorn_collar(area: int, x: int, at: int) -> bool {
    (area == SHINGLE && at >= LENGTH - 4 || area == TOWN && at <= 1) && (x < -2 || x > 2)
}

/// The same boundary seen from either incident area, in world cell rows.
pub fn thorn_row(seed: int, area: int) -> int {
    origin(seed, area) + (if area == SHINGLE then LENGTH - 3 else 0)
}

/// The drawn seven-by-three doorway shadow, in world cells (all incident edges).
pub fn shadow_cell(seed: int, area: int, edge: int, x: int, y: int) -> bool {
    if other(area, edge) < 0 { return false }
    let (px, py) = portal(seed, area, edge)
    // Portal coordinates are exact whole cells, including negative mouths.
    x >= px / FP - 3 && x <= px / FP + 3 && y >= py / FP - 1 && y <= py / FP + 1
}

/// Whether a local cell lies within the town's walls: the Ashen's bound
/// (cb05; they do not chase past the town's edge).
pub fn in_town(seed: int, field: int, x: int, at: int) -> bool {
    town.bound(seed, field, x, at)
}
