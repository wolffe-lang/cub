//! member: false
//!
//! The sprite table's promises: the plain tier inside Latin-1 and the
//! sixteen colours for every sprite and variant; the rich tier's colours
//! indices; the cub's ears face the way it does; the ground's backgrounds.

use grid
use silhouette
use sprites
use tier

fn test_plain_tier_keeps_its_promise() {
    var s = 0
    while s < sprites.SPRITE_COUNT {
        var v = 0
        while v < sprites.VARIANT_COUNT {
            let c = sprites.glyph(tier.PLAIN, s, v)
            assert(c.cp >= 32 && c.cp <= 255, "sprite {s} variant {v}: cp {c.cp}")
            assert(c.fg <= 15 || c.fg == grid.COLOR_DEFAULT, "sprite {s}: fg {c.fg}")
            assert(c.bg <= 15 || c.bg == grid.COLOR_DEFAULT, "sprite {s}: bg {c.bg}")
            v += 1
        }
        s += 1
    }
}

fn test_rich_tier_colours_are_indices() {
    var s = 0
    while s < sprites.SPRITE_COUNT {
        let c = sprites.glyph(tier.RICH, s, 0)
        assert(c.fg >= 0 && c.fg <= 255 && c.bg >= 0 && c.bg <= 255, "sprite {s}")
        s += 1
    }
}

fn test_the_cub_is_one_silhouette_turned_to_face_the_way() {
    // North as drawn: the nose at the top, an ear out at each side, the
    // tail at the bottom, eight pixels across and sixteen down; east the
    // quarter turn, the nose on the right; every facing the same pixels.
    let b = silhouette.cub(0, 0, 0)
    assert(b.w == 8 && b.h == 16, "eight by sixteen")
    assert(silhouette.at(b, 0, 3) == 1 && silhouette.at(b, 0, 0) == 0, "the nose at the top")
    assert(silhouette.at(b, 4, 0) == 1 && silhouette.at(b, 4, 1) == 0, "an ear out at the side")
    assert(silhouette.at(b, 15, 3) == 1 && silhouette.at(b, 15, 7) == 0, "the tail at the bottom")
    let e = silhouette.turned(b, 1)
    assert(e.w == 16 && e.h == 8, "sixteen by eight facing east")
    assert(silhouette.at(e, 3, 15) == 1 && silhouette.at(e, 0, 15) == 0, "the nose on the right")
    let w = silhouette.turned(b, 3)
    assert(silhouette.at(w, 4, 0) == 1 && silhouette.at(w, 0, 0) == 0, "the nose on the left")
    let sth = silhouette.turned(b, 2)
    assert(
        silhouette.at(sth, 15, 4) == 1 && silhouette.at(sth, 15, 7) == 0,
        "the nose at the bottom",
    )
    // The encoder: a full cell is the full block, a lit half a half block,
    // anything else the braille pattern of its pixels, nothing a space.
    var rows = List[str]()
    (mut rows).push("##.#")
    (mut rows).push("##.#")
    (mut rows).push("##..")
    (mut rows).push("##..")
    let t = silhouette.parse(rows)
    assert(silhouette.cell_cp(t, 0, 0) == 9608, "full block")
    assert(silhouette.cell_cp(t, 0, 1) == 10240 + 8 + 16, "braille dots 4 and 5")
    // A cell is two pixels across: a lit left column is the left half
    // block; turned a quarter it is the top pixel row, braille dots 1 and 4.
    var half = List[str]()
    (mut half).push("#...")
    (mut half).push("#...")
    (mut half).push("#...")
    (mut half).push("#...")
    assert(silhouette.cell_cp(silhouette.parse(half), 0, 0) == 9612, "left half block")
    assert(
        silhouette.cell_cp(silhouette.turned(silhouette.parse(half), 1), 0, 0) == 10240 + 1 + 8,
        "turned a quarter, the top pixel row",
    )
    var top = List[str]()
    (mut top).push("##")
    (mut top).push("##")
    (mut top).push("..")
    (mut top).push("..")
    assert(silhouette.cell_cp(silhouette.parse(top), 0, 0) == 9600, "upper half block")
    // The rich list carries every silhouette glyph and the ground's.
    let cps = sprites.rich_code_points()
    var has_block = false
    var has_canopy = false
    for cp in cps {
        if cp == 9608 { has_block = true }
        if cp == 10495 { has_canopy = true }
    }
    assert(has_block && has_canopy, "silhouettes and ground in one list")
}

fn test_water_and_floor_backgrounds_differ_from_the_gravel() {
    let gravel = sprites.glyph(tier.RICH, sprites.SP_GRAVEL, 0).bg
    assert(
        sprites.glyph(tier.RICH, sprites.SP_WATER, 0).bg != gravel,
        "water reads against the shingle",
    )
    assert(
        sprites.glyph(tier.RICH, sprites.SP_GRASS, 0).bg != gravel,
        "the forest floor reads against the shingle",
    )
    assert(
        sprites.glyph(tier.RICH, sprites.SP_REEDS, 0).bg ==
            sprites.glyph(tier.RICH, sprites.SP_WATER, 0).bg,
        "reeds stand in the water",
    )
    assert(sprites.rich_code_points().len >= 12, "a dozen glyphs at least")
}
