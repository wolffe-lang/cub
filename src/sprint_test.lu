//! member: false

use sim
use controls
use input

fn sprint_keys(attack: bool) -> List[int] {
    var keys = List[int]()
    (mut keys).push(controls.KEY_RIGHT)
    (mut keys).push(controls.KEY_CTRL_DOWN)
    if attack { (mut keys).push(controls.KEY_BITE) }
    keys
}

fn runner() -> sim.Sim {
    var s = sim.new(1, 80, 24)
    (mut s.foes).reset()
    s.heading = 64
    s.heading_target = 64
    s.tick = 20
    input.hold_press(mut s.sprint_hold, 18)
    input.hold_press(mut s.sprint_hold, 19)
    s
}

fn test_cb03a_combo_cones_slant_left_right_forward() {
    var s = runner()
    s.action = sim.BITE
    var direction = 0
    while direction < 256 {
        s.attack_heading = direction
        s.combo = 1
        assert(
            sim.attack_direction(s) == (direction + 245) % 256,
            "first slants left fifteen degrees",
        )
        s.combo = 2
        assert(
            sim.attack_direction(s) == (direction + 11) % 256,
            "second slants right fifteen degrees",
        )
        s.combo = 3
        assert(sim.attack_direction(s) == direction, "third is exactly forward")
        direction += 32
    }
}

fn test_cb03a_x_uses_facing_and_two_backward_steps() {
    var s = runner()
    var keys = List[int]()
    (mut keys).push(controls.KEY_LEFT)
    (mut keys).push(controls.KEY_LUNGE)
    sim.step(mut s, keys)
    assert(s.attack_heading == 64, "x ignores the west arrow and remains facing east")
    s.tick = s.started + 3
    let (one, _) = sim.attack_offset(s)
    s.tick = s.started + 6
    let (two, _) = sim.attack_offset(s)
    assert(one == -sim.FP && two == -2 * sim.FP, "two backwards windup steps")
    s.tick = s.started + 10
    let (apex, _) = sim.attack_offset(s)
    assert(apex == 3 * sim.FP, "unchanged forward reach and arc")
}

fn test_cb03a_sprint_charges_twelve_per_second_and_stops_empty() {
    var s = runner()
    let keys = sprint_keys(false)
    var n = 0
    while n < 30 { sim.step(mut s, keys); n += 1 }
    assert(s.stamina == 58, "sprint costs twelve stamina per second, no regeneration")
    assert(s.speed == 128 && sim.sprint_at(1) > sim.FOE_RETREAT_V, "sprint catches retreat")
    s.stamina = 1
    s.sprint_charge = 18
    sim.step(mut s, keys)
    assert(s.stamina == 0 && s.exhausted && !s.sprinting, "zero stops sprint")
}

fn test_cb03a_tap_dodges_and_sprint_bite_costs_more_than_lunge() {
    var tap = sim.new(1, 80, 24)
    var key = List[int]()
    (mut key).push(controls.KEY_DODGE)
    sim.step(mut tap, key)
    assert(tap.action == sim.DODGE && tap.stamina == 52, "tap is still dodge")
    var s = runner()
    let held = sprint_keys(false)
    sim.step(mut s, held)
    let before = s.stamina
    sim.step(mut s, sprint_keys(true))
    assert(s.action == sim.DASH && before - s.stamina == 36, "sprinting bite costs thirty-six")
    assert(s.attack_heading == 64, "snapping lunge is forward")
    s.tick = s.started + 3
    assert(sim.head_shake(s) == -1, "first snap left")
    s.tick += 1
    assert(sim.head_shake(s) == 1, "second snap right")
    s.tick += 1
    assert(sim.head_shake(s) == -1, "third snap left")
}

fn check_forward_contact(direction: int) {
    var combo = 1
    while combo <= 3 {
        var s = sim.new(1, 80, 24)
        var f = copy s.foes[0]
        (mut s.foes).reset()
        s.heading = direction
        s.heading_target = direction
        s.attack_heading = direction
        s.body_facing = sim.eighth(direction)
        s.action = sim.BITE
        s.combo = combo
        s.started = 0
        s.tick = 2
        f.heading = direction
        f.phase = sim.STAGGER
        f.health = 100
        f.since = 0
        f.last_hit = -1
        // Dead ahead means ahead of the jaws, not the anchor: a diagonal
        // rectangle's front corner is not on its anchor-to-foe ray.
        let (jx, jy) = sim.jaws(sim.cub_body(s), s.body_facing)
        var distance = 0
        var contact = false
        while distance <= 12 * sim.FP {
            f.x = jx + distance * sim.sin(direction) / sim.FP
            f.y = jy - distance * sim.cos(direction) / sim.FP
            if !sim.overlap(sim.cub_body(s), sim.foe_body(f)) &&
                sim.gap(sim.cub_body(s), sim.foe_body(f)) == 0 {
                contact = true
                break
            }
            distance += sim.FP / 4
        }
        assert(contact, "contact fixture exists for direction {direction}")
        (mut s.foes).push(f)
        var keys = List[int]()
        sim.step(mut s, keys)
        assert(
            s.body_facing == sim.eighth(direction),
            "slant moves the head, not a ninety-degree body flip",
        )
        assert(
            s.foes[0].health == 100 - sim.bite_damage(1),
            "dead ahead contact hit {combo} direction {direction}",
        )
        combo += 1
    }
}

fn test_cb03a_every_combo_hits_dead_ahead_contact_cardinals() {
    check_forward_contact(0)
    check_forward_contact(64)
    check_forward_contact(128)
    check_forward_contact(192)
}

fn test_cb03a_every_combo_hits_dead_ahead_contact_diagonals() {
    check_forward_contact(32)
    check_forward_contact(96)
    check_forward_contact(160)
    check_forward_contact(224)
}

fn test_cb03a_snapping_head_checks_the_landing_body_not_the_start() {
    var s = sim.new(1, 80, 24)
    var f = copy s.foes[0]
    (mut s.foes).reset()
    s.heading = 64
    s.heading_target = 64
    s.attack_heading = 64
    s.body_facing = 2
    s.action = sim.DASH
    s.started = 0
    s.tick = 4
    // A neighbour beside the apex is not beside the standing body.
    // Search the small contact ring to cover both clipping and an empty arc.
    var dx = 3
    while dx <= 10 {
        var dy = -3
        while dy <= 3 {
            f.x = s.x + dx * sim.FP
            f.y = s.y + dy * sim.FP
            f.heading = 0
            f.health = 8
            f.died = -1
            (mut s.foes).reset()
            if !sim.overlap(sim.cub_body(s), sim.foe_body(f)) {
                (mut s.foes).push(copy f)
                let (ox, oy) = sim.attack_offset(s)
                var b = sim.cub_body_at(s, s.x + ox, s.y + oy, s.body_facing)
                let shake = sim.head_shake(s)
                if shake < 0 { b.y0 -= 1 } else if shake > 0 { b.y1 += 1 }
                assert(!sim.overlap(b, sim.foe_body(f)), "snapping head at landing {dx},{dy}")
            }
            dy += 1
        }
        dx += 1
    }
}
