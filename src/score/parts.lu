//! parts — the score's text, embedded (GENERATED by tools/score-embed
//! from score/*.part; edit the files, rerun the tool). cb03, cb17.

/// The text of the part `name` as committed under score/, or "".
pub fn text(name: str) -> str {
    if name == "title" {
        return "# The Ford at Dawn — the title: the pack's call, D minor opening to F.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 72: 20 s.\ntitle The Ford at Dawn\ncue replace fade 6\ntempo 72\nmeter 4/4\npart call horn mf pan -10\npart high strings mp pan 35\npart low strings mp pan -35\npart harp harp mf pan 20\nbar 1\ncall r/4 D4/4 A4/2\nhigh A4/1~\nlow D3/1~\nharp D3/8 A3/8 D4/8 F4/8 A4/8 F4/8 D4/8 A3/8\nbar 2\ncall F4/2 E4/4 D4/4\nhigh A4/1\nlow D3/1\nharp D3/8 A3/8 D4/8 F4/8 A4/8 F4/8 D4/8 A3/8\nbar 3\ncall < C4/2 D4/4 E4/4\nhigh G4/2 A4/2\nlow C3/2 A2/2\nharp C3/8 G3/8 C4/8 E4/8 G4/8 E4/8 C4/8 G3/8\nbar 4\ncall F4/2. f r/4\nhigh F4/1\nlow F3/1\nharp F3/8 C4/8 F4/8 A4/8 C5/8 A4/8 F4/8 C4/8\nbar 5\ncall D4/4 A4/4 F4/4 E4/4\nhigh D5/2 C5/2\nlow Bb2/2 G2/2\nharp Bb2/8 F3/8 Bb3/8 D4/8 G2/8 D3/8 G3/8 Bb3/8\nbar 6\ncall > D4/2 mp r/2\nhigh A4/2 r/2\nlow D3/2 r/2\nharp D3/8 A3/8 r/2.\n"
    } else if name == "shingle" {
        return "# Gravel and Slack Water — the Shingle: A minor, open water, a breath of flute.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 60: 24 s, a loop.\ntitle Gravel and Slack Water\ncue replace fade 9\ntempo 60\nmeter 4/4\npart breath flute mp pan 25 gain 6\npart ripple harp p pan -30 gain 6\npart bed strings p pan 0 gain 6\npart deep strings p pan -15 gain 3\nbar 1\nbreath r/2 E5/4 D5/4\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed A4,E5/1~\ndeep A2/1~\nbar 2\nbreath C5/2_ A4/2\nripple G3/8 D4/8 G4/8 B4/8 D4/8 G4/8 B4/8 D5/8\nbed A4,E5/1\ndeep A2/1\nbar 3\nbreath r/4 G4/4 A4/2~\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed G4,D5/1~\ndeep G2/1~\nbar 4\nbreath A4/2 r/2\nripple F3/8 C4/8 F4/8 A4/8 C4/8 F4/8 A4/8 C5/8\nbed G4,D5/1\ndeep G2/1\nbar 5\nbreath r/2 D5/4 E5/4\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed A4,C5/1~\ndeep F2/1\nbar 6\nbreath C5/2- r/2\nripple A3/8 E4/8 A4/4 r/2\nbed A4,C5/2 r/2\ndeep A2/2 r/2\n"
    } else if name == "bramblehold" {
        return "# Under the Thorn — Bramblehold: D minor with a raised Eb, low tremolo, a reed.\n# Original, cb03 (2026-10-26). 10 bars of 4/4 at 100: 24 s, a loop.\ntitle Under the Thorn\ncue replace fade 9\ntempo 100\nmeter 4/4\npart floor strings p pan -20 gain 6\npart reed clarinet mp pan 20 gain 6\npart skin timpani p pan 0 gain 6\npart step drum p pan -10 gain 6\nbar 1\nfloor D3,A3/1*\nskin D2/4 r/2.\nbar 2\nfloor D3,A3/1*\nreed r/2 F4/4' E4/4'\nstep r/2. C2/4'\nbar 3\nfloor D3,Bb3/1*\nreed D4/2. r/4\nskin D2/4 r/2.\nbar 4\nfloor Eb3,Bb3/1*\nreed r/4 Eb4/8' D4/8' Bb3/2\nbar 5\nfloor D3,A3/1*\nskin D2/4 r/4 A1/4 r/4\nstep r/2. C2/4'\nbar 6\nfloor D3,A3/1*\nreed < A4/4 Bb4/4 A4/2 mf\nbar 7\nfloor C3,G3/1*\nreed G4/2 F4/4 E4/4\nskin C2/4 r/2.\nbar 8\nfloor Bb2,F3/1*\nreed > D4/2. p r/4\nstep r/2 C2/4' r/4\nbar 9\nfloor A2,E3/1*\nreed r/2 E4/4' F4/4'\nskin A1/4 r/2.\nbar 10\nfloor D3,A3/2. r/4\nreed D4/2 r/2\n"
    } else if name == "larkmeadow" {
        return "# Larks over Long Grass — Larkmeadow: F major, an oboe over strings and harp.\n# Original, cb03 (2026-10-26). 16 bars of 3/4 at 120: 24 s, a loop.\ntitle Larks over Long Grass\ncue replace fade 9\ntempo 120\nmeter 3/4\npart lark oboe mf pan 15\npart grass strings mp pan -25\npart sway harp mp pan 30\nbar 1\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 2\ngrass F3,C4/2.\nsway F3/4 C4/4 A3/4\nbar 3\nlark A4/2 C5/4\ngrass D3,A3/2.\nsway D3/4 F3/4 A3/4\nbar 4\nlark Bb4/2 A4/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 5\nlark G4/2 F4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 6\nlark E4/2 F4/4\ngrass C3,G3/2.\nsway C3/4 E4/4 G3/4\nbar 7\nlark A4/4 C5/4 D5/4\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 8\nlark C5/2.~\ngrass F3,A3/2.\nsway F3/4 C4/4 A3/4\nbar 9\nlark C5/4 A4/4 F4/4\ngrass D3,A3/2.\nsway D3/4 F3/4 A3/4\nbar 10\nlark G4/2 E4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 11\nlark F4/2 D4/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 12\nlark E4/2 C4/4\ngrass C3,G3/2.\nsway C3/4 E4/4 G3/4\nbar 13\nlark F4/4 A4/4 C5/4\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 14\nlark D5/2 C5/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 15\nlark A4/2 G4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 16\nlark F4/2 r/4\ngrass F3,C4/2 r/4\n"
    } else if name == "boss-boar" {
        return "# Bristle — the boar of the thicket: drum and timpani under a trombone, D minor.\n# Original, cb03 (2026-10-26). 8 bars of 4/4 at 120: 16 s, a loop. cb04 wires it.\ntitle Bristle\ncue replace fade 6\ntempo 120\nmeter 4/4\npart hoof drum mf pan -10\npart hide timpani mp pan 10\npart tusk trombone mf pan 0\npart thicket strings mp pan -30\nbar 1\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide D2/4 r/4 D2/8 D2/8 r/4\ntusk D3/4> r/4 D3/8 F3/8 E3/4\nthicket D3,A3/2* D3,A3/2*\nbar 2\nhoof C2/4 C2/8 C2/8 C2/4 C2/8 C2/8\nhide D2/4 r/4 A1/4 r/4\ntusk D3/4> r/4 F3/8 G3/8 F3/4\nthicket D3,A3/2* C3,G3/2*\nbar 3\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide Bb1/4 r/4 Bb1/8 Bb1/8 r/4\ntusk Bb2/4> r/4 Bb2/8 D3/8 C3/4\nthicket Bb2,F3/2* Bb2,F3/2*\nbar 4\nhoof C2/4 C2/8 C2/8 C2/8 C2/8 C2/4\nhide A1/4 A1/4 A1/4 A1/4\ntusk A2/2^ A2/4' A2/4'\nthicket A2,E3/2* A2,E3/4* r/4\nbar 5\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide D2/4 r/4 D2/8 D2/8 r/4\ntusk D3/4> E3/4 F3/4 G3/4\nthicket D3,A3/2* F3,C4/2*\nbar 6\nhoof C2/4 C2/8 C2/8 C2/4 C2/8 C2/8\nhide D2/4 r/4 A1/4 r/4\ntusk A3/2> G3/4 F3/4\nthicket A3,E4/2* G3,D4/2*\nbar 7\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide Bb1/4 r/4 Bb1/8 Bb1/8 r/4\ntusk E3/4> F3/4 E3/4 D3/4\nthicket E3,Bb3/2* D3,A3/2*\nbar 8\nhoof C2/4 r/2.\ntusk D3/2 r/2\nthicket D3,A3/2* r/2\n"
    } else if name == "boss-lynx" {
        return "# Claw in the Scree — the lynx of the crags: G minor tremolo, a flute's cry, a cymbal.\n# Original, cb03 (2026-10-26). 10 bars of 3/4 at 150: 12 s, a loop. cb04 wires it.\ntitle Claw in the Scree\ncue replace fade 4\ntempo 150\nmeter 3/4\npart scree strings mf pan -20\npart cry flute mf pan 30\npart clash cymbal mp pan 0\npart rock timpani mp pan 10\nbar 1\nscree G4,D5/2.*\nrock G2/4' r/4 G2/4'\nbar 2\nscree G4,D5/4* Ab4,Eb5/4* G4,D5/4*\ncry r/4 D5/8' Eb5/8' D5/4'\nclash r/2 C4/4\nbar 3\nscree F4,C5/2.*\nrock F2/4' r/4 F2/4'\nbar 4\nscree F4,C5/4* G4,D5/4* Ab4,Eb5/4*\ncry r/4 G5/8' Ab5/8' G5/4^\nbar 5\nscree G4,D5/2.*\ncry Bb5/4' r/2\nrock G2/4' G2/4' r/4\nbar 6\nscree Eb4,Bb4/4* D4,A4/4* C4,G4/4*\ncry r/4 Eb5/8' D5/8' C5/4'\nclash r/2 C4/4\nbar 7\nscree D4,A4/2.*\nrock D2/4' r/4 D2/4'\nbar 8\nscree D4,A4/4* Eb4,Bb4/4* D4,A4/4*\ncry r/4 D5/8' Eb5/8' D5/4^\nbar 9\nscree G4,D5/2.*\ncry G5/4' r/2\nbar 10\nscree G4,D5/2 r/4\n"
    } else if name == "boss-elk" {
        return "# The Ford Runs High — the elk of the river: C minor horns over tremolo, timpani.\n# Original, cb03 (2026-10-26). 8 bars of 4/4 at 96: 20 s, a loop. cb04 wires it.\ntitle The Ford Runs High\ncue replace fade 6\ntempo 96\nmeter 4/4\npart antler horn f pan -15\npart water strings mp pan 25\npart ford trombone mf pan 0 gain -3\npart hoof timpani mp pan -20\nbar 1\nantler C4/2 Eb4/4 G4/4\nwater C4,G4/1*\nford C3/2 r/2\nhoof C2/4 r/4 C2/4 r/4\nbar 2\nantler F4/2. Eb4/4\nwater Ab3,Eb4/1*\nford Ab2/2 r/2\nhoof Ab1/4 r/4 Ab1/4 r/4\nbar 3\nantler D4/2 F4/4 Ab4/4\nwater Bb3,F4/1*\nford Bb2/2 r/2\nhoof Bb1/4 r/4 Bb1/4 r/4\nbar 4\nantler G4/1~\nwater G3,D4/1*\nford G2/2 r/2\nhoof G1/4 r/4 G1/8 G1/8 r/4\nbar 5\nantler G4/4 C5/2 Bb4/4\nwater C4,Eb4/1*\nford C3/2 r/2\nhoof C2/4 r/4 C2/4 r/4\nbar 6\nantler Ab4/2 G4/4 F4/4\nwater Ab3,C4/1*\nford Ab2/2 r/2\nhoof Ab1/4 r/4 Ab1/4 r/4\nbar 7\nantler Eb4/2 D4/4 Bb3/4\nwater Bb3,D4/1*\nford Bb2/2 r/2\nhoof Bb1/4 r/4 Bb1/4 r/4\nbar 8\nantler C4/2. r/4\nwater C4,G4/2. r/4\nford C3/2 r/2\n"
    } else if name == "boss-alpha" {
        return "# The Shadow at the Old Den — the shadow alpha: organ pedal, a choir, a tam-tam, D minor.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 60: 24 s, a loop. cb04 wires it.\ntitle The Shadow at the Old Den\ncue replace fade 9\ntempo 60\nmeter 4/4\npart below pedal p pan 0 gain 6\npart shade choir p pan -20 gain 6\npart breath organ p pan 20 gain 6\npart gong tamtam p pan 0 gain 6\nbar 1\nbelow D2/1~\nshade D4,A4/1~\ngong C3/4 r/2.\nbar 2\nbelow D2/1\nshade D4,A4/2 Eb4,A4/2\nbreath r/2 A4/4 F4/4\nbar 3\nbelow Bb2/1~\nshade Bb3,F4/1~\nbreath D4/2. r/4\nbar 4\nbelow Bb2/1\nshade Bb3,F4/2 A3,E4/2\nbreath r/2 < E4/4 F4/4 mp\nbar 5\nbelow A2/1~\nshade A3,E4/1\nbreath > D4/2. p r/4\nbar 6\nbelow A2/2 r/2\n"
    } else if name == "den" {
        return "# Embers — a den's rest: harp and flute settle on D, a short loop.\n# Original, cb03 (2026-10-26). 4 bars of 3/4 at 72: 10 s, a loop.\ntitle Embers\ncue replace fade 6\ntempo 72\nmeter 3/4\npart glow harp mp pan -20 gain 6\npart warm flute p pan 25 gain 6\npart hush strings p pan 10 gain 6\nbar 1\nglow D3/4 A3/4 F4/4\nhush D3,A3/2.~\nbar 2\nglow A3/4 D4/4 F4/4\nwarm A4/2 F4/4\nhush D3,A3/2.\nbar 3\nglow G3/4 D4/4 Bb3/4\nwarm G4/2.-\nhush G3,D4/2.~\nbar 4\nwarm F4/2 r/4\nhush G3,D4/2 r/4\n"
    } else if name == "death" {
        return "# Fallen — the death sting: a struck chord falling to nothing, a tam-tam, a last breath.\n# Original, cb03 (2026-10-26). 1 bar of 4/4 at 60 and two silent bars: 12 s, once.\ntitle Fallen\ncue replace fade 3\ntempo 60\nmeter 4/4\npart fall strings ff pan 0\npart gong tamtam mf pan 0\npart last flute mp pan 20\nbar 1\nfall sfz D3,Ab3/4 > D3,G3/2. pp\ngong C3/4 r/2.\nlast r/4 F4/4 E4/8 Eb4/8 D4/4-\nbar 2\nfall r/1\nbar 3\nfall r/1\n"
    } else if name == "crack" {
        return "# A Footstep Too Light — the ice answers before the cub can move.\n# Original, cb06 (2026-10-26). Three bars of 4/4 at 144: 5 s, once.\n# Low struck open chord; thinning strings; eighths become sixteenths.\ntitle A Footstep Too Light\ncue replace fade 1\ntempo 144\nmeter 4/4\npart shock timpani ff pan 0\npart edge strings mf pan -12\npart splinter harp mp pan 18\nbar 1\nshock sfz C2,Gb2/8 r/2..\nedge C3,Gb3,B3/2 > C3,Gb3/2 pp\nsplinter r/1\nbar 2\nshock r/1\nedge C3/1 ppp\nsplinter r/2 r/4 Db5/8 G5/8\nbar 3\nshock r/1\nedge r/1\nsplinter C5/8 Gb5/8 D5/16 Ab5/16 E5/16 Bb5/16 F5/16 B5/16 Gb5/16 C6/16 r/4\n"
    } else if name == "cinderwick" {
        return "# The Cold Hearths — Cinderwick, the burnt town: G Dorian (the shared key's), a clarinet's tune\n# over a harp in three, low strings, a cracked bell. Original, cb17 (2026-10-29). 8 bars of 3/4 at\n# 72: 20 s, a loop.\ntitle The Cold Hearths\ncue replace fade 9\ntempo 72\nmeter 3/4\npart tune clarinet mp pan 15 gain 5\npart hearth harp p pan -25 gain 8\npart beam strings p pan -10 gain 5\npart bell bells pp pan 30 gain 2\nbar 1\ntune r/4 D4/4 G4/4\nhearth G2/4 D3/4 Bb3/4\nbeam G2,D3/2.~\nbell G3/4 r/2\nbar 2\ntune A4/4. Bb4/8 A4/4\nhearth C3/4 G3/4 E4/4\nbeam G2,D3/2.\nbar 3\ntune G4/2 D4/4\nhearth G2/4 D3/4 Bb3/4\nbeam G2,D3/2.\nbar 4\ntune F4/4 E4/4 D4/4\nhearth D3/4 A3/4 F4/4\nbeam D3,A3/2.\nbar 5\ntune Bb3/4 D4/4 F4/4\nhearth Bb2/4 F3/4 D4/4\nbeam Bb2,F3/2.\nbell D4/4 r/2\nbar 6\ntune E4/2 C4/4\nhearth C3/4 G3/4 E4/4\nbeam C3,G3/2.\nbar 7\ntune D4/4. C4/8 A3/4\nhearth D3/4 A3/4 C4/4\nbeam D3,A3/2.\nbar 8\ntune G3/2 r/4\nhearth G2/4 r/2\nbeam G2,D3/2 r/4\n"
    } else if name == "stand" {
        return "# Wind in the Pines — the Stand: C Mixolydian (the shared key's), the wind in the strings swelling\n# and falling, the pack's call far off on a horn, a flute above the ridge. Original, cb17\n# (2026-10-29). 6 bars of 4/4 at 60: 24 s, a loop.\ntitle Wind in the Pines\ncue replace fade 9\ntempo 60\nmeter 4/4\npart gust strings pp pan -35 gain 12\npart ridge strings pp pan 20 gain 9\npart far horn p pan 45 gain 3\npart whistle flute pp pan -10 gain 6\nbar 1\ngust < G4,C5/2* > G4,C5/2* pp\nridge C3,G3/1~\nbar 2\ngust < F4,Bb4/2* > F4,D5/2* pp\nridge C3,G3/1\nfar r/4 C4/4 G4/2\nbar 3\ngust < G4,C5/2* > E4,C5/2* pp\nridge Bb2,F3/1\nfar E4/2 D4/4 C4/4\nbar 4\ngust < F4,A4/2* > F4,C5/2* pp\nridge F2,C3/1\nwhistle r/2 G5/4 F5/4\nbar 5\ngust < F4,Bb4/2* > D4,Bb4/2* pp\nridge Bb2,F3/1\nfar r/2 Bb3/4 C4/4\nwhistle D5/2. r/4\nbar 6\ngust < E4,G4/2* > E4,G4/4* pp r/4\nridge C3,G3/2. r/4\nfar C4/2. r/4\n"
    } else if name == "burn" {
        return "# Ash and a Single Reed — the Burn: D Aeolian (the shared key's), dry, a clarinet alone; embers\n# ticking under the ash, a charred trunk's timpani. Original, cb17 (2026-10-29). 7 bars of 4/4 at\n# 80: 21 s, a loop.\ntitle Ash and a Single Reed\ncue replace fade 9\ntempo 80\nmeter 4/4\npart reed clarinet mp pan 10 gain 8\npart ember drum pp pan 35 gain 2\npart ground timpani pp pan -20 gain 2\nbar 1\nreed D4/2 r/4 F4/8 E4/8\nember r/2 r/8 C4/16' r/16 r/4\nground D2/4 r/2.\nbar 2\nreed D4/4. C4/8 A3/2\nbar 3\nreed r/2 A3/8 C4/8 D4/4\nember r/4 C4/16' r/16 r/8 r/2\nbar 4\nreed < F4/4. E4/8 D4/4 mf Bb3/4\nground A1/4 r/2.\nbar 5\nreed > A3/2. p r/4\nember r/2. C4/16' r/16 C4/16' r/16\nbar 6\nreed r/4 D4/8 F4/8 G4/4 A4/4\nbar 7\nreed G4/4 F4/8 E4/8 D4/4 r/4\n"
    } else if name == "teeth" {
        return "# The Marked Stones — the Teeth: A Phrygian (the shared key's), the ledge's edge in staccato\n# strings, the pack's call worn into the stone on a horn, a timpani under, scree on a cymbal.\n# Original, cb17 (2026-10-29). 6 bars of 4/4 at 90: 16 s, a loop.\ntitle The Marked Stones\ncue replace fade 9\ntempo 90\nmeter 4/4\npart ledge strings mp pan -20 gain 5\npart stone timpani p pan 10 gain 5\npart mark horn mp pan 25 gain 2\npart height strings pp pan 40 gain 2\npart scree cymbal pp pan -35 gain 2\nbar 1\nledge A2/8' A2/8' Bb2/8' A2/8' r/8 A2/8' Bb2/8' A2/8'\nstone A1/4 r/2.\nbar 2\nledge A2/8' A2/8' Bb2/8' A2/8' r/8 A2/8' Bb2/8' A2/8'\nstone A1/4 r/2 A1/4'\nmark r/4 A3/4 E4/2\nbar 3\nledge Bb2/8' Bb2/8' C3/8' Bb2/8' r/8 Bb2/8' C3/8' Bb2/8'\nstone Bb1/4 r/2.\nmark C4/2 Bb3/4 A3/4\nheight < E5/1*\nbar 4\nledge G2/8' G2/8' A2/8' G2/8' r/8 G2/8' A2/8' G2/8'\nstone G1/4 r/2 G1/4'\nmark r/4 G3/4 D4/2\nheight > D5/1* pp\nbar 5\nledge F2/8' F2/8' G2/8' F2/8' r/8 F2/8' G2/8' A2/8'\nstone F1/4 r/2.\nmark F4/2 E4/4 D4/4\nscree r/2. C4/4\nbar 6\nledge A2/8' A2/8' Bb2/8' A2/8' r/2\nstone A1/4 r/2.\nmark A3/2 r/2\n"
    } else if name == "underteeth" {
        return "# Drip — the Underteeth: D Aeolian (the shared key's), sparse and dripping: drops on bells and a\n# harp, the pedal's deep stone, wet stone in the strings, long silences between. Original, cb17\n# (2026-10-29). 5 bars of 4/4 at 50: 24 s, a loop.\ntitle Drip\ncue replace fade 9\ntempo 50\nmeter 4/4\npart stone pedal pp pan 0 gain 9\npart drip bells p pan 30 gain 3\npart drop harp p pan -30 gain 6\npart damp strings ppp pan 10 gain 6\nbar 1\nstone D2/1~\ndrip r/4 r/8 A5/16' r/16 r/2\nbar 2\nstone D2/1\ndrip r/2 r/8 F5/16' r/16 r/4\ndrop r/4 D5/8 r/8 r/2\nbar 3\nstone C2/1~\ndrip A5/16' r/16 r/8 r/4 r/2\ndrop r/2. E5/8 r/8\ndamp A4,E5/1~\nbar 4\nstone C2/1\ndrip r/4 G5/16' r/16 r/8 r/4 pp G5/16' r/16 r/8\ndamp A4,E5/2 r/2\nbar 5\nstone D2/2 r/2\ndrop r/8 A5/16 r/16 r/2.\n"
    } else if name == "mere" {
        return "# Still Water — the Mere: B flat Lydian (the shared key's), the ripple's beat on a harp, a note a\n# second as the ripple row moves a cell a second; voices in the mist, a pedal of black water.\n# Original, cb17 (2026-10-29). 6 bars of 4/4 at 60: 24 s, a loop.\ntitle Still Water\ncue replace fade 9\ntempo 60\nmeter 4/4\npart ripple harp p pan -25 gain 10\npart mist choir pp pan 15 gain 9\npart black strings pp pan -5 gain 8\npart one voice pp pan 35 gain 6\nbar 1\nripple Bb2/4 F3/4 D4/4 F3/4\nmist Bb3,F4/1~\nblack Bb1/1~\nbar 2\nripple C3/4 G3/4 E4/4 G3/4\nmist Bb3,F4/2 C4,E4/2\nblack Bb1/1\nbar 3\nripple Bb2/4 F3/4 D4/4 F3/4\nmist D4,F4/1\nblack Bb1/1~\nbar 4\nripple G2/4 D3/4 Bb3/4 D3/4\nmist D4,G4/1\nblack Bb1/1\none r/2 F4/2\nbar 5\nripple A2/4 E3/4 C4/4 E3/4\nmist C4,E4/1\nblack A1/1\none E4/2. D4/4\nbar 6\nripple Bb2/4 F3/4 r/2\nmist D4,F4/2. r/4\nblack Bb1/2. r/4\n"
    } else if name == "shallows" {
        return "# Grey Water Running — the Shallows: F major, the Ashwater's current in a harp's eighths, a long\n# line in the strings, then a horn for the elk who keeps the ford. Original, cb17 (2026-10-29).\n# 12 bars of 3/4 at 108: 20 s, a loop.\ntitle Grey Water Running\ncue replace fade 9\ntempo 108\nmeter 3/4\npart current harp mp pan -30 gain 3\npart line strings mp pan 20\npart bed strings p pan -5 gain 3\npart alder horn mp pan 30\nbar 1\ncurrent F2/8 C3/8 F3/8 A3/8 C4/8 A3/8\nline C5/2_ A4/4\nbed F2,C3/2.\nbar 2\ncurrent E2/8 C3/8 E3/8 G3/8 C4/8 G3/8\nline G4/2_ E4/4\nbed E2,C3/2.\nbar 3\ncurrent D2/8 A2/8 D3/8 F3/8 A3/8 F3/8\nline F4/4_ E4/4_ D4/4\nbed D2,A2/2.\nbar 4\ncurrent Bb1/8 F2/8 Bb2/8 D3/8 F3/8 D3/8\nline D4/2.\nbed Bb1,F2/2.\nbar 5\ncurrent F2/8 C3/8 F3/8 A3/8 C4/8 A3/8\nline C4/4_ F4/4_ A4/4\nbed F2,C3/2.\nbar 6\ncurrent G2/8 D3/8 G3/8 Bb3/8 D4/8 Bb3/8\nline Bb4/2_ A4/4\nbed G2,D3/2.\nbar 7\ncurrent C2/8 G2/8 C3/8 E3/8 G3/8 E3/8\nline G4/2.~\nbed C2,G2/2.~\nbar 8\ncurrent C2/8 G2/8 Bb2/8 E3/8 G3/8 E3/8\nline G4/2 r/4\nbed C2,G2/2.\nbar 9\ncurrent D2/8 A2/8 D3/8 F3/8 A3/8 F3/8\nbed D2,A2/2.\nalder A3/2 D4/4\nbar 10\ncurrent Bb1/8 F2/8 Bb2/8 D3/8 F3/8 D3/8\nbed Bb1,F2/2.\nalder F4/2 D4/4\nbar 11\ncurrent C2/8 G2/8 C3/8 E3/8 G3/8 r/8\nbed C2,G2/2.\nalder E4/4 G4/4 Bb3/4\nbar 12\nbed F2,C3/2 r/4\nalder A3/2 r/4\n"
    } else if name == "hush" {
        return "# The Hush — the deep wood: D minor darkening to E flat, no wind, no birds; low strings, voices on\n# an open fifth, the shadows' motif (D, E flat, D, the A below) on a low clarinet. Original, cb17\n# (2026-10-29). 6 bars of 4/4 at 60: 24 s, a loop; its first 300 ticks are the silence while the\n# cold den is unlit (R-cb17-1 A).\ntitle The Hush\ncue replace fade 9\ntempo 60\nmeter 4/4\npart deep strings pp pan -15 gain 10\npart voices choir pp pan 15 gain 7\npart shadow clarinet p pan 30 gain 7\nbar 1\ndeep D2,A2/1~\nvoices D4,A4/1~\nbar 2\ndeep D2,A2/1\nvoices D4,A4/2 Eb4,A4/2\nshadow D4/4 Eb4/4 D4/2\nbar 3\ndeep D2,A2/1\nvoices D4,A4/1\nshadow A3/1\nbar 4\ndeep Bb1,F2/1\nvoices Bb3,F4/1\nbar 5\ndeep A1,E2/1\nvoices A3,E4/2 A3,Eb4/2\nshadow D4/4 Eb4/4 F4/4 Eb4/4\nbar 6\ndeep D2,A2/2. r/4\nvoices D4,A4/2. r/4\nshadow D4/2. r/4\n"
    } else if name == "howe" {
        return "# The Barrows — the Howe: D minor in three, an elegy for the alphas under the mounds; the shadows'\n# motif on a horn, voices, a standing stone's bell, a wisp's flute. Original, cb17 (2026-10-29).\n# 8 bars of 3/4 at 72: 20 s, a loop.\ntitle The Barrows\ncue replace fade 9\ntempo 72\nmeter 3/4\npart elegy horn mp pan -10 gain 2\npart mound choir pp pan 20 gain 5\npart turf strings p pan -25 gain 5\npart stones bells pp pan 35 gain 2\npart wisp flute pp pan -35 gain 2\nbar 1\nelegy D4/4 Eb4/4 D4/4\nmound D3,A3/2.~\nturf D2/2.~\nstones A4/4 r/2\nbar 2\nelegy A3/2.\nmound D3,A3/2.\nturf D2/2.\nbar 3\nelegy Bb3/4 D4/4 G4/4\nmound G3,D4/2.\nturf G2/2.\nwisp r/4 r/8 A5/16 Bb5/16 A5/4\nbar 4\nelegy F4/2 E4/4\nmound F3,C4/2.\nturf F2/2.\nbar 5\nelegy D4/4 Eb4/4 D4/4\nmound D3,A3/2.\nturf D2/2.\nstones D5/4 r/2\nbar 6\nelegy Bb3/2 A3/4\nmound Bb2,F3/2.\nturf Bb1/2.\nwisp r/2 D6/8 r/8\nbar 7\nelegy C4/4 Bb3/4 A3/4\nmound A2,E3/2.\nturf A1/2.\nbar 8\nelegy D4/2 r/4\nmound D3,A3/2 r/4\nturf D2/2 r/4\n"
    } else if name == "gravehollow" {
        return "# Under the Fallen Oak — Gravehollow before the fight: D minor; the shadows' motif slowed on an\n# organ over the roots' tremolo, voices on the fifth, one bell tolling. Original, cb17\n# (2026-10-29). 5 bars of 4/4 at 60: 20 s, a loop; the alpha's theme replaces it in the fight.\ntitle Under the Fallen Oak\ncue replace fade 9\ntempo 60\nmeter 4/4\npart roots strings pp pan -20 gain 10\npart voices choir pp pan 20 gain 7\npart shadow organ p pan 10 gain 7\npart toll bells p pan -35 gain 3\nbar 1\nroots D2,A2/1*\nvoices D4,A4/1~\nshadow D4/2 Eb4/2\ntoll D3/4 r/2.\nbar 2\nroots D2,A2/1*\nvoices D4,A4/1\nshadow D4/2 A3/2\nbar 3\nroots Bb1,F2/1*\nvoices D4,A4/2 Eb4,A4/2\ntoll D3/4 r/2.\nbar 4\nroots A1,E2/1*\nvoices D4,A4/1\nshadow F4/2 Eb4/2\nbar 5\nroots D2,A2/2.* r/4\nvoices D4,A4/2. r/4\nshadow D4/2. r/4\n"
    } else if name == "moonford" {
        return "# Moonford at Dawn — the end, the ford from the far bank: the title's call returning in D major,\n# horn over strings and a harp's eighths, the pack's voices, a bell at dawn. Original, cb17\n# (2026-10-29). 6 bars of 4/4 at 72: 20 s, a loop under the end's frames and its card.\ntitle Moonford at Dawn\ncue replace fade 6\ntempo 72\nmeter 4/4\npart call horn mf pan -10\npart high strings mp pan 35\npart low strings mp pan -35\npart harp harp mf pan 20\npart pack choir p pan 0\npart dawn bells p pan 25\nbar 1\ncall r/4 D4/4 A4/2\nhigh A4/1~\nlow D3/1~\nharp D3/8 A3/8 D4/8 F#4/8 A4/8 F#4/8 D4/8 A3/8\nbar 2\ncall F#4/2 E4/4 D4/4\nhigh A4/2 F#4/2\nlow D3/2 B2/2\nharp B2/8 F#3/8 B3/8 D4/8 F#4/8 D4/8 B3/8 F#3/8\nbar 3\ncall < E4/2 F#4/4 G4/4\nhigh G4/2 B4/2\nlow G2/1\nharp G2/8 D3/8 G3/8 B3/8 D4/8 B3/8 G3/8 D3/8\nbar 4\ncall A4/2. f r/4\nhigh A4/1\nlow A2/1\nharp A2/8 E3/8 A3/8 C#4/8 E4/8 C#4/8 A3/8 E3/8\npack < A3,E4/1\ndawn D5/4 r/2.\nbar 5\ncall B4/4 A4/4 F#4/4 E4/4\nhigh D5/2 C#5/2\nlow G2/2 A2/2\nharp G2/8 D3/8 G3/8 B3/8 A2/8 E3/8 A3/8 C#4/8\npack B3,D4/2 mf A3,C#4/2\nbar 6\ncall > D4/2 mp r/2\nhigh D5/2 r/2\nlow D3/2 r/2\nharp D3/8 A3/8 r/2.\npack > A3,D4/2 p r/2\n"
    } else if name == "reveal" {
        return "# The Whole of Thornmere — the lookout's reveal: F major, the strings rising out of the Stand's\n# wind, a harp's sweep, the pack's call whole on a horn as the names fade in. Original, cb17\n# (2026-10-29). 3 bars of 4/4 at 90: 8 s, once, held to its end like the sting.\ntitle The Whole of Thornmere\ncue replace fade 3\ntempo 90\nmeter 4/4\npart rise strings p pan -20\npart sweep harp mf pan 25\npart call horn f pan -5\npart floor timpani mp pan 10\npart air cymbal p pan 0\nbar 1\nrise < F3,C4/4* A3,F4/4* C4,A4/4* F4,C5/4*\nsweep F2/16 C3/16 F3/16 A3/16 C4/16 F4/16 A4/16 C5/16 F5/16 A5/16 C6/16 F6/16 r/4\nbar 2\nrise f F4,A4,C5/2* > D4,F4,A4/2*\ncall r/4 F4/4 C5/2\nfloor F2/4 r/2.\nair C4/4 r/2.\nbar 3\nrise C4,F4,A4/2 p r/2\ncall A4/4 G4/4 F4/4 r/4\nsweep F3/8 C4/8 F4/8 A4/8 r/2\n"
    } else if name == "crossing" {
        return "# Stone by Stone — the Mere's crossing: the Mere's key, the stones' beat (each sinks a beat after\n# the step) on a staccato timpani, the ripple doubled to eighths, a low reed, the ice's tritone held\n# in tremolo. Original, cb17 (2026-10-29). 3 bars of 4/4 at 60: 12 s, a loop.\ntitle Stone by Stone\ncue replace fade 6\ntempo 60\nmeter 4/4\npart ripple harp p pan -25 gain 6\npart beat timpani p pan 10 gain 3\npart low clarinet p pan 25 gain 3\npart ice strings pp pan -40 gain 3\nbar 1\nripple Bb2/8 F3/8 D4/8 F3/8 Bb2/8 F3/8 D4/8 F3/8\nbeat Bb1/4' F2/4' Bb1/4' F2/4'\nlow F3/2 E3/2\nice Bb4,E5/1*\nbar 2\nripple C3/8 G3/8 E4/8 G3/8 C3/8 G3/8 E4/8 G3/8\nbeat C2/4' G2/4' C2/4' G2/4'\nlow G3/2 F3/4 E3/4\nice C5,E5/1*\nbar 3\nripple Bb2/8 F3/8 D4/8 F3/8 r/2\nbeat Bb1/4' F2/4' r/2\nlow F3/2. r/4\nice Bb4,D5/2* r/2\n"
    } else if name == "walk" {
        return "# To the Stone Mouth — the Howe's walk, its last stretch to the gate: D minor, a slow tread on a\n# muffled drum, the shadows' motif low in a trombone, voices rising toward the mouth. Original,\n# cb17 (2026-10-29). 4 bars of 4/4 at 60: 16 s, a loop.\ntitle To the Stone Mouth\ncue replace fade 9\ntempo 60\nmeter 4/4\npart tread drum p pan -10 gain 5\npart toll timpani pp pan 10 gain 5\npart shadow trombone p pan 0 gain 2\npart rising choir pp pan 25 gain 5\npart roots strings ppp pan -30 gain 8\nbar 1\ntread C2/2 C2/2\ntoll D2/4 r/2.\nshadow D3/4 Eb3/4 D3/2\nrising D4,A4/1\nroots D2,A2/1*\nbar 2\ntread C2/2 C2/2\ntoll D2/4 r/2.\nshadow A2/1\nrising < D4,A4/1\nroots D2,A2/1*\nbar 3\ntread C2/2 C2/2\ntoll D2/4 r/2.\nshadow D3/4 Eb3/4 F3/2\nrising Eb4,A4/1 mp\nroots D2,A2/1*\nbar 4\ntread C2/2 r/2\nshadow D3/2. r/4\nrising > D4,A4/2. pp r/4\nroots D2,A2/2* r/2\n"
    }
    ""
}
