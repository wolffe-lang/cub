//! parts — the score's text, embedded (GENERATED by tools/score-embed
//! from score/*.part; edit the files, rerun the tool). cb03.

/// The text of the part `name` as committed under score/, or "".
pub fn text(name: str) -> str {
    if name == "title" {
        return "# The Ford at Dawn — the title: the pack's call, D minor opening to F.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 72: 20 s.\ntitle The Ford at Dawn\ncue replace fade 6\ntempo 72\nmeter 4/4\npart call horn mf pan -10\npart high strings mp pan 35\npart low strings mp pan -35\npart harp harp mf pan 20\nbar 1\ncall r/4 D4/4 A4/2\nhigh A4/1~\nlow D3/1~\nharp D3/8 A3/8 D4/8 F4/8 A4/8 F4/8 D4/8 A3/8\nbar 2\ncall F4/2 E4/4 D4/4\nhigh A4/1\nlow D3/1\nharp D3/8 A3/8 D4/8 F4/8 A4/8 F4/8 D4/8 A3/8\nbar 3\ncall < C4/2 D4/4 E4/4\nhigh G4/2 A4/2\nlow C3/2 A2/2\nharp C3/8 G3/8 C4/8 E4/8 G4/8 E4/8 C4/8 G3/8\nbar 4\ncall F4/2. f r/4\nhigh F4/1\nlow F3/1\nharp F3/8 C4/8 F4/8 A4/8 C5/8 A4/8 F4/8 C4/8\nbar 5\ncall D4/4 A4/4 F4/4 E4/4\nhigh D5/2 C5/2\nlow Bb2/2 G2/2\nharp Bb2/8 F3/8 Bb3/8 D4/8 G2/8 D3/8 G3/8 Bb3/8\nbar 6\ncall > D4/2 mp r/2\nhigh A4/2 r/2\nlow D3/2 r/2\nharp D3/8 A3/8 r/2.\n"
    } else if name == "shingle" {
        return "# Gravel and Slack Water — the Shingle: A minor, open water, a breath of flute.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 60: 24 s, a loop.\ntitle Gravel and Slack Water\ncue replace fade 9\ntempo 60\nmeter 4/4\npart breath flute mp pan 25 gain 6\npart ripple harp p pan -30 gain 6\npart bed strings p pan 0 gain 6\npart deep strings p pan -15 gain 3\nbar 1\nbreath r/2 E5/4 D5/4\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed A4,E5/1~\ndeep A2/1~\nbar 2\nbreath C5/2_ A4/2\nripple G3/8 D4/8 G4/8 B4/8 D4/8 G4/8 B4/8 D5/8\nbed A4,E5/1\ndeep A2/1\nbar 3\nbreath r/4 G4/4 A4/2~\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed G4,D5/1~\ndeep G2/1~\nbar 4\nbreath A4/2 r/2\nripple F3/8 C4/8 F4/8 A4/8 C4/8 F4/8 A4/8 C5/8\nbed G4,D5/1\ndeep G2/1\nbar 5\nbreath r/2 D5/4 E5/4\nripple A3/8 E4/8 A4/8 C5/8 E4/8 A4/8 C5/8 E5/8\nbed A4,C5/1~\ndeep F2/1\nbar 6\nbreath C5/2- r/2\nripple A3/8 E4/8 A4/4 r/2\nbed A4,C5/2 r/2\ndeep A2/2 r/2\n"
    } else if name == "bramblehold" {
        return "# Under the Thorn — Bramblehold: D minor with a raised Eb, low tremolo, a reed.\n# Original, cb03 (2026-10-26). 10 bars of 4/4 at 100: 24 s, a loop.\ntitle Under the Thorn\ncue replace fade 9\ntempo 100\nmeter 4/4\npart floor strings p pan -20 gain 6\npart reed clarinet mp pan 20 gain 6\npart skin timpani p pan 0 gain 6\npart step drum p pan -10 gain 6\nbar 1\nfloor D3,A3/1*\nskin D2/4 r/2.\nbar 2\nfloor D3,A3/1*\nreed r/2 F4/4' E4/4'\nstep r/2. C2/4'\nbar 3\nfloor D3,Bb3/1*\nreed D4/2. r/4\nskin D2/4 r/2.\nbar 4\nfloor Eb3,Bb3/1*\nreed r/4 Eb4/8' D4/8' Bb3/2\nbar 5\nfloor D3,A3/1*\nskin D2/4 r/4 A1/4 r/4\nstep r/2. C2/4'\nbar 6\nfloor D3,A3/1*\nreed < A4/4 Bb4/4 A4/2 mf\nbar 7\nfloor C3,G3/1*\nreed G4/2 F4/4 E4/4\nskin C2/4 r/2.\nbar 8\nfloor Bb2,F3/1*\nreed > D4/2. p r/4\nstep r/2 C2/4' r/4\nbar 9\nfloor A2,E3/1*\nreed r/2 E4/4' F4/4'\nskin A1/4 r/2.\nbar 10\nfloor D3,A3/2. r/4\nreed D4/2 r/2\n"
    } else if name == "larkmeadow" {
        return "# Larks over Long Grass — Larkmeadow: F major, an oboe over strings and harp.\n# Original, cb03 (2026-10-26). 16 bars of 3/4 at 120: 24 s, a loop.\ntitle Larks over Long Grass\ncue replace fade 9\ntempo 120\nmeter 3/4\npart lark oboe mf pan 15\npart grass strings mp pan -25\npart sway harp mp pan 30\nbar 1\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 2\ngrass F3,C4/2.\nsway F3/4 C4/4 A3/4\nbar 3\nlark A4/2 C5/4\ngrass D3,A3/2.\nsway D3/4 F3/4 A3/4\nbar 4\nlark Bb4/2 A4/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 5\nlark G4/2 F4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 6\nlark E4/2 F4/4\ngrass C3,G3/2.\nsway C3/4 E4/4 G3/4\nbar 7\nlark A4/4 C5/4 D5/4\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 8\nlark C5/2.~\ngrass F3,A3/2.\nsway F3/4 C4/4 A3/4\nbar 9\nlark C5/4 A4/4 F4/4\ngrass D3,A3/2.\nsway D3/4 F3/4 A3/4\nbar 10\nlark G4/2 E4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 11\nlark F4/2 D4/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 12\nlark E4/2 C4/4\ngrass C3,G3/2.\nsway C3/4 E4/4 G3/4\nbar 13\nlark F4/4 A4/4 C5/4\ngrass F3,C4/2.\nsway F3/4 A3/4 C4/4\nbar 14\nlark D5/2 C5/4\ngrass Bb2,F3/2.\nsway Bb2/4 F3/4 D4/4\nbar 15\nlark A4/2 G4/4\ngrass C3,G3/2.\nsway C3/4 G3/4 E4/4\nbar 16\nlark F4/2 r/4\ngrass F3,C4/2 r/4\n"
    } else if name == "boss-boar" {
        return "# Bristle — the boar of the thicket: drum and timpani under a trombone, D minor.\n# Original, cb03 (2026-10-26). 8 bars of 4/4 at 120: 16 s, a loop. cb04 wires it.\ntitle Bristle\ncue replace fade 6\ntempo 120\nmeter 4/4\npart hoof drum mf pan -10\npart hide timpani mp pan 10\npart tusk trombone mf pan 0\npart thicket strings mp pan -30\nbar 1\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide D2/4 r/4 D2/8 D2/8 r/4\ntusk D3/4> r/4 D3/8 F3/8 E3/4\nthicket D3,A3/2* D3,A3/2*\nbar 2\nhoof C2/4 C2/8 C2/8 C2/4 C2/8 C2/8\nhide D2/4 r/4 A1/4 r/4\ntusk D3/4> r/4 F3/8 G3/8 F3/4\nthicket D3,A3/2* C3,G3/2*\nbar 3\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide Bb1/4 r/4 Bb1/8 Bb1/8 r/4\ntusk Bb2/4> r/4 Bb2/8 D3/8 C3/4\nthicket Bb2,F3/2* Bb2,F3/2*\nbar 4\nhoof C2/4 C2/8 C2/8 C2/8 C2/8 C2/4\nhide A1/4 A1/4 A1/4 A1/4\ntusk A2/2^ A2/4' A2/4'\nthicket A2,E3/2* A2,E3/4* r/4\nbar 5\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide D2/4 r/4 D2/8 D2/8 r/4\ntusk D3/4> E3/4 F3/4 G3/4\nthicket D3,A3/2* F3,C4/2*\nbar 6\nhoof C2/4 C2/8 C2/8 C2/4 C2/8 C2/8\nhide D2/4 r/4 A1/4 r/4\ntusk A3/2> G3/4 F3/4\nthicket A3,E4/2* G3,D4/2*\nbar 7\nhoof C2/4 C2/8 C2/8 C2/4 r/4\nhide Bb1/4 r/4 Bb1/8 Bb1/8 r/4\ntusk E3/4> F3/4 E3/4 D3/4\nthicket E3,Bb3/2* D3,A3/2*\nbar 8\nhoof C2/4 r/2.\ntusk D3/2 r/2\nthicket D3,A3/2* r/2\n"
    } else if name == "boss-lynx" {
        return "# Claw in the Scree — the lynx of the crags: G minor tremolo, a flute's cry, a cymbal.\n# Original, cb03 (2026-10-26). 10 bars of 3/4 at 150: 12 s, a loop. cb04 wires it.\ntitle Claw in the Scree\ncue replace fade 4\ntempo 150\nmeter 3/4\npart scree strings mf pan -20\npart cry flute mf pan 30\npart clash cymbal mp pan 0\npart rock timpani mp pan 10\nbar 1\nscree G4,D5/2.*\nrock G2/4' r/4 G2/4'\nbar 2\nscree G4,D5/4* Ab4,Eb5/4* G4,D5/4*\ncry r/4 D5/8' Eb5/8' D5/4'\nclash r/2 C4/4\nbar 3\nscree F4,C5/2.*\nrock F2/4' r/4 F2/4'\nbar 4\nscree F4,C5/4* G4,D5/4* Ab4,Eb5/4*\ncry r/4 G5/8' Ab5/8' G5/4^\nbar 5\nscree G4,D5/2.*\ncry Bb5/4' r/2\nrock G2/4' G2/4' r/4\nbar 6\nscree Eb4,Bb4/4* D4,A4/4* C4,G4/4*\ncry r/4 Eb5/8' D5/8' C5/4'\nclash r/2 C4/4\nbar 7\nscree D4,A4/2.*\nrock D2/4' r/4 D2/4'\nbar 8\nscree D4,A4/4* Eb4,Bb4/4* D4,A4/4*\ncry r/4 D5/8' Eb5/8' D5/4^\nbar 9\nscree G4,D5/2.*\ncry G5/4' r/2\nbar 10\nscree G4,D5/2 r/4\n"
    } else if name == "boss-elk" {
        return "# The Ford Runs High — the elk of the river: C minor horns over tremolo, timpani.\n# Original, cb03 (2026-10-26). 8 bars of 4/4 at 96: 20 s, a loop. cb04 wires it.\ntitle The Ford Runs High\ncue replace fade 6\ntempo 96\nmeter 4/4\npart antler horn f pan -15\npart water strings mp pan 25\npart ford trombone mf pan 0 gain -3\npart hoof timpani mp pan -20\nbar 1\nantler C4/2 Eb4/4 G4/4\nwater C4,G4/1*\nford C3/2 r/2\nhoof C2/4 r/4 C2/4 r/4\nbar 2\nantler F4/2. Eb4/4\nwater Ab3,Eb4/1*\nford Ab2/2 r/2\nhoof Ab1/4 r/4 Ab1/4 r/4\nbar 3\nantler D4/2 F4/4 Ab4/4\nwater Bb3,F4/1*\nford Bb2/2 r/2\nhoof Bb1/4 r/4 Bb1/4 r/4\nbar 4\nantler G4/1~\nwater G3,D4/1*\nford G2/2 r/2\nhoof G1/4 r/4 G1/8 G1/8 r/4\nbar 5\nantler G4/4 C5/2 Bb4/4\nwater C4,Eb4/1*\nford C3/2 r/2\nhoof C2/4 r/4 C2/4 r/4\nbar 6\nantler Ab4/2 G4/4 F4/4\nwater Ab3,C4/1*\nford Ab2/2 r/2\nhoof Ab1/4 r/4 Ab1/4 r/4\nbar 7\nantler Eb4/2 D4/4 Bb3/4\nwater Bb3,D4/1*\nford Bb2/2 r/2\nhoof Bb1/4 r/4 Bb1/4 r/4\nbar 8\nantler C4/2. r/4\nwater C4,G4/2. r/4\nford C3/2 r/2\n"
    } else if name == "boss-alpha" {
        return "# The Shadow at the Old Den — the shadow alpha: organ pedal, a choir, a tam-tam, D minor.\n# Original, cb03 (2026-10-26). 6 bars of 4/4 at 60: 24 s, a loop. cb04 wires it.\ntitle The Shadow at the Old Den\ncue replace fade 9\ntempo 60\nmeter 4/4\npart below pedal p pan 0 gain 6\npart shade choir p pan -20 gain 6\npart breath organ p pan 20 gain 6\npart gong tamtam p pan 0 gain 6\nbar 1\nbelow D2/1~\nshade D4,A4/1~\ngong C3/4 r/2.\nbar 2\nbelow D2/1\nshade D4,A4/2 Eb4,A4/2\nbreath r/2 A4/4 F4/4\nbar 3\nbelow Bb2/1~\nshade Bb3,F4/1~\nbreath D4/2. r/4\nbar 4\nbelow Bb2/1\nshade Bb3,F4/2 A3,E4/2\nbreath r/2 < E4/4 F4/4 mp\nbar 5\nbelow A2/1~\nshade A3,E4/1\nbreath > D4/2. p r/4\nbar 6\nbelow A2/2 r/2\n"
    } else if name == "den" {
        return "# Embers — a den's rest: harp and flute settle on D, a short loop.\n# Original, cb03 (2026-10-26). 4 bars of 3/4 at 72: 10 s, a loop.\ntitle Embers\ncue replace fade 6\ntempo 72\nmeter 3/4\npart glow harp mp pan -20 gain 6\npart warm flute p pan 25 gain 6\npart hush strings p pan 10 gain 6\nbar 1\nglow D3/4 A3/4 F4/4\nhush D3,A3/2.~\nbar 2\nglow A3/4 D4/4 F4/4\nwarm A4/2 F4/4\nhush D3,A3/2.\nbar 3\nglow G3/4 D4/4 Bb3/4\nwarm G4/2.-\nhush G3,D4/2.~\nbar 4\nwarm F4/2 r/4\nhush G3,D4/2 r/4\n"
    } else if name == "death" {
        return "# Fallen — the death sting: a struck chord falling to nothing, a tam-tam, a last breath.\n# Original, cb03 (2026-10-26). 1 bar of 4/4 at 60 and two silent bars: 12 s, once.\ntitle Fallen\ncue replace fade 3\ntempo 60\nmeter 4/4\npart fall strings ff pan 0\npart gong tamtam mf pan 0\npart last flute mp pan 20\nbar 1\nfall sfz D3,Ab3/4 > D3,G3/2. pp\ngong C3/4 r/2.\nlast r/4 F4/4 E4/8 Eb4/8 D4/4-\nbar 2\nfall r/1\nbar 3\nfall r/1\n"
    } else if name == "crack" {
        return "# A Footstep Too Light — the ice answers before the cub can move.\n# Original, cb06 (2026-10-26). Three bars of 4/4 at 144: 5 s, once.\n# Low struck open chord; thinning strings; eighths become sixteenths.\ntitle A Footstep Too Light\ncue replace fade 1\ntempo 144\nmeter 4/4\npart shock timpani ff pan 0\npart edge strings mf pan -12\npart splinter harp mp pan 18\nbar 1\nshock sfz C2,Gb2/8 r/2..\nedge C3,Gb3,B3/2 > C3,Gb3/2 pp\nsplinter r/1\nbar 2\nshock r/1\nedge C3/1 ppp\nsplinter r/2 r/4 Db5/8 G5/8\nbar 3\nshock r/1\nedge r/1\nsplinter C5/8 Gb5/8 D5/16 Ab5/16 E5/16 Bb5/16 F5/16 B5/16 Gb5/16 C6/16 r/4\n"
    }
    ""
}
