//! cross — Cinderwick's second-pass instruments (cb05, item 8): the
//! crossing census (a scripted cub with the Shingle's health and no flask
//! walks the lane from the gate to the cold hearth, biting what it meets
//! and parrying an Ashen's blow, never rolling: Book-II play) and the
//! hitbox audit (a bite from each of the eight aims at an Ashen standing
//! still: which body cell the cub touches, whether the anchor and the
//! nearest body cell lie in the bite's cone, whether the bite lands).

use controls
use forest
use replay
use sim
use terrain
use town
use walker

/// Seeds the crossing census walks at each field.
pub const CROSSING_SEEDS: int = 10

/// The seeds that must survive at each field (R-cb05-5's bar: nine of ten).
pub const CROSSING_BAR: int = 9

/// A fresh cub at Cinderwick's thorn throat: the Shingle's heart, no
/// flask, the gate open.
fn fresh_cub(seed: int, field: int) -> sim.Sim {
    var s = sim.new(seed, field, 24)
    s.gate_open = true
    s.opening_seen = true
    s.flask_max = 0
    s.flasks = 0
    sim.enter_area(mut s, forest.TOWN, sim.FP / 2, 2 * sim.FP + sim.FP / 2)
    s
}

/// Whether the cub's cell lies off the lane and off the square: in a yard,
/// a passage or a verge (the census says where a death came).
fn off_lane(s: sim.Sim) -> bool {
    !town.on_lane(s.seed, sim.cell_x(s), sim.cell_y(s)) && !town.square(town.plot(sim.cell_y(s)))
}

/// The crossing census: `CROSSING_SEEDS` seeds at both fields, each a walk
/// from the throat to the hearth; a row a walk (seed, field, outcome,
/// tick, health, ashen fought, where); green when at least `CROSSING_BAR`
/// survive at each field and no death comes on the lane.
pub fn crossing() -> int {
    print("seed field outcome tick health beaten where")
    var red = 0
    for field in [80, 200] {
        var survived = 0
        var seed = 0
        while seed < CROSSING_SEEDS {
            var s = fresh_cub(seed, field)
            var r = replay.new(seed, 1, field, 24)
            let (hx, hy) = forest.den_position(seed, 7)
            let arrived = walker.walk(mut s, mut r, hx, hy)
            var beaten = 0
            var i = 0
            while i < s.foes.len {
                if s.foes[i].kind == sim.ASHEN && s.foes[i].health <= 0 { beaten += 1 }
                i += 1
            }
            let outcome = if arrived && s.action != sim.FALL {
                "arrived"
            } else if s.action == sim.FALL {
                "died"
            } else {
                "stalled"
            }
            let where = if s.action != sim.FALL then "-" else if off_lane(s) then "yard" else "lane"
            print("{seed} {field} {outcome} {s.tick} {s.health} {beaten} {where}")
            if arrived && s.action != sim.FALL { survived += 1 }
            if s.action == sim.FALL && !off_lane(s) { red += 1 }
            seed += 1
        }
        print("crossing: field {field} survived {survived} of {CROSSING_SEEDS}")
        if survived < CROSSING_BAR { red += 1 }
    }
    if red > 0 {
        print("crossing: RED")
        return 1
    }
    print(
        "crossing: green, at least {CROSSING_BAR} of {CROSSING_SEEDS} seeds cross at each field, no death on the lane",
    )
    0
}

/// `--crossing-trace SEED FIELD`: one crossing, narrated by the walker
/// while a foe is within two cells (cb07's instrument for a stall).
pub fn crossing_trace(seed: int, field: int) -> int {
    var s = fresh_cub(seed, field)
    var r = replay.new(seed, 1, field, 24)
    let (hx, hy) = forest.den_position(seed, 7)
    let arrived = walker.walk_narrated(mut s, mut r, hx, hy)
    print(
        "crossing-trace: seed {seed} field {field} arrived {arrived} tick {s.tick} health {s.health} action {s.action}",
    )
    if arrived && s.action != sim.FALL then 0 else 1
}

/// The eight aims, headings: north, north-east, east, ... (TURN 256).
fn aim_heading(k: int) -> int {
    k * 32
}

/// The cub placed touching the Ashen's body on the side the aim comes
/// from: from the body's centre, back along the aim until the bodies'
/// gap is zero (never overlapping).
fn place_touching(mut s: sim.Sim, k: int) {
    place_at_gap(mut s, k, 0)
}

/// A jaw-aligned stance with exactly `want` clear cells. The diagonal
/// body's leading corner, not its anchor-to-centre ray, faces the target.
fn place_at_gap(mut s: sim.Sim, k: int, want: int) {
    let fb = sim.foe_body(s.foes[0])
    let h = aim_heading(k)
    s.heading = h
    s.heading_target = h
    s.body_facing = sim.eighth(h)
    let cb = sim.cub_body_at(s, 0, 0, s.body_facing)
    let dx = sim.sin(h)
    let dy = 0 - sim.cos(h)
    let distance = want + 1
    let x = if dx > 0 {
        fb.x0 - distance - cb.x1
    } else if dx < 0 {
        fb.x1 + distance - cb.x0
    } else {
        (fb.x0 + fb.x1 - cb.x0 - cb.x1) / 2
    }
    let y = if dy > 0 {
        fb.y0 - distance - cb.y1
    } else if dy < 0 {
        fb.y1 + distance - cb.y0
    } else {
        (fb.y0 + fb.y1 - cb.y0 - cb.y1) / 2
    }
    s.x = x * sim.FP
    s.y = y * sim.FP
}

/// The hitbox audit: sixteen rows (aim, the cub's cell, the gap, the
/// anchor in the cone, the nearest body cell in the cone, landed), the
/// Ashen at rest facing north in open ground, the cub touching it and then
/// a cell off (the bite's reach is two); red when any such bite misses.
pub fn hitbox() -> int {
    print("aim cub_x cub_y gap anchor_in_cone body_in_cone landed")
    if hitbox_rows(0, 16) != 0 { return 1 }
    if hawk_rows(0, 16) != 0 { return 1 }
    print("hitbox: green, a bite in reach lands from every aim, touching and a cell off")
    0
}

/// The same audit rows, split only for checked-machine test fuel. The
/// shipping command always runs all sixteen; an empty range is refused.
pub fn hitbox_rows(first: int, last: int) -> int {
    if first < 0 || last > 16 || first >= last { return 1 }
    var misses = 0
    var k = first
    while k < last {
        let want = k / 8
        var s = sim.new(3, 80, 24)
        s.gate_open = true
        sim.enter_area(mut s, forest.LARKMEADOW, 0, 40 * sim.FP)
        (mut s.foes).reset()
        var f = sim.make_ashen(sim.FP / 2, 40 * sim.FP + sim.FP / 2)
        f.heading = 0
        f.phase = sim.RETREAT
        f.since = s.tick
        (mut s.foes).push(f)
        place_at_gap(mut s, k % 8, want)
        let fb = sim.foe_body(s.foes[0])
        let gap = sim.gap(sim.cub_body(s), fb)
        let h = aim_heading(k % 8)
        let anchor = sim.in_front(s.x, s.y, h, s.foes[0].x, s.foes[0].y)
        // The body cell nearest the jaws; retain the anchor column above
        // as the old rule's reference, not as the hit condition.
        let (jx, jy) = sim.jaws(sim.cub_body(s), s.body_facing)
        var best = 1000000
        var bx = 0
        var by = 0
        var y = fb.y0
        while y <= fb.y1 {
            var x = fb.x0
            while x <= fb.x1 {
                let px = x * sim.FP + sim.FP / 2
                let py = y * sim.FP + sim.FP / 2
                let d = (px - jx) * (px - jx) / sim.FP + (py - jy) * (py - jy) / sim.FP
                if d < best {
                    best = d
                    bx = px
                    by = py
                }
                x += 1
            }
            y += 1
        }
        let body = sim.in_front(jx, jy, h, bx, by)
        let before = s.foes[0].health
        var keys = List[int]()
        (mut keys).push(controls.KEY_LOCK)
        // Held arrows, not the lock, commit bite aim. Point toward the
        // declared target; the old reverse chord tested a bite away from it.
        walker.aim(mut keys, sim.sin(h), 0 - sim.cos(h))
        (mut keys).push(controls.KEY_BITE)
        sim.step(mut s, keys)
        if s.attack_heading != h {
            eprint("hitbox: expected aim {h}, committed {s.attack_heading}")
            return 1
        }
        assert(gap == want, "hitbox audit keeps the exact requested body gap")
        var n = 0
        while n < 8 { sim.step(mut s, List[int]()); n += 1 }
        let landed = s.foes[0].health < before
        if !landed { misses += 1 }
        print("{k % 8} {sim.cell_x(s)} {sim.cell_y(s)} {gap} {anchor} {body} {landed}")
        k += 1
    }
    if misses > 0 {
        print("hitbox: RED {misses} of {last - first} bites in reach miss")
        return 1
    }
    0
}

/// Low hawks: real keyed bites at all aims, both body gaps, both windows.
/// Each row keeps the hawk AI running: STRIKE naturally enters RETREAT.
pub fn hawk_rows(first: int, last: int) -> int {
    var misses = 0
    var k = first
    while k < last {
        for phase in [sim.STRIKE, sim.RETREAT] {
            var s = sim.new(3, 80, 24)
            sim.enter_area(mut s, forest.LARKMEADOW, 0, 40 * sim.FP)
            (mut s.foes).reset()
            var f = sim.make_ashen(sim.FP / 2, 40 * sim.FP + sim.FP / 2)
            f.kind = sim.HAWK
            f.health = sim.foe_health(sim.HAWK)
            f.phase = phase
            f.since = s.tick
            f.heading = k % 4 * 64
            (mut s.foes).push(f)
            place_at_gap(mut s, k % 8, k / 8)
            var keys = List[int]()
            let h = aim_heading(k % 8)
            walker.aim(mut keys, sim.sin(h), 0 - sim.cos(h))
            (mut keys).push(controls.KEY_BITE)
            sim.step(mut s, keys)
            var n = 0
            while n < 4 { sim.step(mut s, List[int]()); n += 1 }
            let dead = s.foes[0].health == 0
            print(
                "hitbox hawk phase={phase} aim={k % 8} gap={k / 8} quarter={k % 4} one-bite={dead}",
            )
            if !dead { misses += 1 }
        }
        k += 1
    }
    if misses > 0 { print("hitbox hawk RED misses={misses}") }
    misses
}

/// A map of Cinderwick at a field, a row a line, a character a cell
/// (`=` the lane, `.` ash, `#` a wall, `*` an ember, `T` a trunk, a blank
/// the dark wood), from x = -half to half: the block plan seen whole.
pub fn town_map(seed: int, field: int) -> int {
    let half = forest.bound(field, forest.TOWN)
    var at = 0
    while at <= town.LENGTH {
        var line = ""
        var x = 0 - half
        while x <= half {
            let k = forest.kind(seed, field, forest.TOWN, x, at)
            line = line +
                (
                    if k == terrain.EMBER {
                        "*"
                    } else if k == terrain.WALL {
                        "#"
                    } else if k == terrain.ASH {
                        "."
                    } else if k == terrain.TRUNK {
                        "T"
                    } else if k == terrain.DARK || k == terrain.CANOPY {
                        " "
                    } else {
                        "="
                    }
                )
            x += 1
        }
        print(line)
        at += 1
    }
    0
}

/// Seeds the encounter census fights at each field, and how many must
/// come out under the bar (cb07, R-cb07-1: nine of ten).
pub const ENCOUNTER_SEEDS: int = 10

/// The bar: at most this share of `health_max` lost to one Ashen.
pub const ENCOUNTER_LOST_PERCENT: int = 35

/// Seeds that must stay under the bar at each field.
pub const ENCOUNTER_BAR: int = 9

/// The one-Ashen encounter census (cb07, item 3): a fresh cub (the
/// Shingle's heart and wind, no flask) stands five cells from one posted
/// Ashen, every other foe of the town removed (a disclosed fixture: one
/// encounter, not the lane), and fights it with Book-II play — the
/// walker's: walk at it, bite what is in reach (Space links the three
/// strikes), parry its windup two ticks before the blow, never roll —
/// until the Ashen falls, the cub falls, or 1200 ticks pass. A row a
/// fight: the health lost and the ticks. Green when at least
/// `ENCOUNTER_BAR` of `ENCOUNTER_SEEDS` seeds lose at most
/// `ENCOUNTER_LOST_PERCENT` of `health_max` at each field.
pub fn encounter() -> int {
    print("play seed field outcome ticks lost health_max ashen_health blow")
    var red = 0
    for parry in [true, false] {
        for field in [80, 200] {
            if encounter_rows(parry, field) < ENCOUNTER_BAR && parry { red += 1 }
        }
    }
    if red > 0 {
        print("encounter: RED")
        return 1
    }
    print(
        "encounter: green, at least {ENCOUNTER_BAR} of {ENCOUNTER_SEEDS} seeds lose at most {ENCOUNTER_LOST_PERCENT} percent to one Ashen at each field with Book-II play (health {sim.foe_health(sim.ASHEN)}, blow {sim.ASHEN_DAMAGE}); the no-parry rows are the human-mistake proxy, reported, not barred",
    )
    0
}

/// One tick of the player who never parries: at the Ashen, the three
/// strikes when a body is in reach, nothing else (the walker's keys
/// without its parry: what a blow costs a cub that missed the window).
fn drive_no_parry(mut s: sim.Sim, mut r: replay.Replay) {
    var keys = List[int]()
    let f = copy s.foes[0]
    if f.health > 0 && sim.in_reach(s, 0, 2) {
        if s.action == sim.IDLE {
            if s.locked < 0 { (mut keys).push(controls.KEY_LOCK) }
            walker.aim_at(mut keys, sim.heading_to(s.x, s.y, f.x, f.y))
            (mut keys).push(controls.KEY_BITE)
            (mut keys).push(controls.KEY_RELEASE)
        }
    } else {
        walker.aim(mut keys, f.x - s.x, f.y - s.y)
    }
    walker.press(mut s, mut r, keys)
}

/// The census's rows for one play at one field: the seeds under the bar.
pub fn encounter_rows(parry: bool, field: int) -> int {
    let play = if parry then "parry" else "noparry"
    var under = 0
    var seed = 0
    while seed < ENCOUNTER_SEEDS {
        var s = fresh_cub(seed, field)
        var r = replay.new(seed, 1, field, 24)
        var k = -1
        var i = 0
        while i < s.foes.len {
            if k < 0 && s.foes[i].kind == sim.ASHEN && s.foes[i].health > 0 { k = i }
            i += 1
        }
        if k < 0 {
            print("{play} {seed} {field} none 0 0 {sim.health_max(s.heart)} 0 {sim.ASHEN_DAMAGE}")
            seed += 1
            continue
        }
        let one = copy s.foes[k]
        (mut s.foes).reset()
        (mut s.foes).push(one)
        // Five cells before it, on the side the cub comes from.
        let h = sim.heading_to(s.x, s.y, one.x, one.y)
        place_at_gap(mut s, ((h + 16) / 32 + 8) % 8, 5)
        let start = s.tick
        var n = 0
        while n < 1200 && s.foes[0].health > 0 && s.action != sim.FALL {
            if parry {
                walker.drive(mut s, mut r, s.foes[0].x, s.foes[0].y)
            } else {
                drive_no_parry(mut s, mut r)
            }
            n += 1
        }
        let maximum = sim.health_max(s.heart)
        let lost = if s.action == sim.FALL then maximum else maximum - s.health
        let outcome = if s.foes[0].health <= 0 {
            "beaten"
        } else if s.action == sim.FALL {
            "died"
        } else {
            "stalled"
        }
        print(
            "{play} {seed} {field} {outcome} {s.tick - start} {lost} {maximum} {s.foes[0].health} {sim.ASHEN_DAMAGE}",
        )
        if lost * 100 <= ENCOUNTER_LOST_PERCENT * maximum { under += 1 }
        seed += 1
    }
    print("encounter: {play} field {field} under the bar {under} of {ENCOUNTER_SEEDS}")
    under
}
