//! member: false

use art
use forest
use grid
use sim
use sprites
use terrain
use tier

fn test_cb02a_forest_fill_is_visible_beyond_area_bounds() {
    // One terrain row of the wide field, far below the shore: its first
    // column lies beyond the coast's bound and must still draw forest.
    var s = sim.new(0, 200, 60)
    s.x = (forest.coast_extent(s.field) + 60) * sim.FP
    var g = grid.new(60, 200)
    art.terrain_row(s, tier.RICH, 45, mut g)
    let cell = grid.at(g, 45, 1)
    assert(cell.cp != 32 && cell.fg != cell.bg, "forest fill outside collision bounds")
    let dark = sprites.glyph(tier.PLAIN, sprites.SP_DARK, 0)
    assert(dark.cp != 32 && dark.fg != dark.bg, "plain deep forest visible")
}

fn test_cb02a_bank_has_no_sawtooth_steps() {
    var seed = 0
    while seed < 5 {
        var x = -100
        while x < 100 {
            let delta = terrain.bank(seed, x + 1) - terrain.bank(seed, x)
            assert(delta >= -1 && delta <= 1, "gentle bank")
            x += 1
        }
        seed += 1
    }
}

fn test_cb02a_each_branch_ends_in_an_alcove() {
    var seed = 0
    while seed < 5 {
        var cache = 0
        while cache < forest.cache_count(forest.SHINGLE) {
            let (x, y) = forest.cache_position(seed, 80, forest.SHINGLE, cache)
            let cx = sim.floor_div(x, sim.FP)
            let cy = sim.floor_div(y, sim.FP)
            var dx = -3
            while dx <= 3 {
                var dy = -3
                while dy <= 3 {
                    if dx * dx + dy * dy <= 16 {
                        assert(!forest.blocked(seed, 80, 0, cx + dx, cy + dy), "cache alcove floor")
                    }
                    dy += 1
                }
                dx += 1
            }
            let foes = sim.area_foes(seed, 80, 0)
            var guards = 0
            for f in foes {
                if sim.near(f.x, f.y, x, y, 4 * sim.FP) && f.kind == sim.FOX && f.health == 40 {
                    guards += 1
                }
            }
            assert(guards == 1, "one stronger fox guarding each bundle")
            cache += 1
        }
        seed += 1
    }
}

fn test_cb02a_jetties_never_cut_den_from_thorn_route() {
    var seed = 0
    while seed < 5 {
        let o = forest.origin(seed, 0)
        var at = 0
        while at <= 15 {
            assert(
                !forest.blocked(seed, 80, 0, forest.spine(seed, 0, at), o + at),
                "jetty between den and thorn route",
            )
            at += 1
        }
        var side = 0
        while side < 2 {
            let x = forest.jetty_x(seed, 80, side)
            assert(x < -32 || x > 32, "jetty beyond the last shore branch")
            var y = terrain.bank(seed, x) - 5
            while y <= terrain.bank(seed, x) + terrain.REED_ROWS + terrain.SHINGLE_ROWS {
                assert(
                    forest.kind(seed, 80, 0, x, y) == terrain.ROCK &&
                        forest.blocked(seed, 80, 0, x, y),
                    "solid rock from water across whole path",
                )
                y += 1
            }
            side += 1
        }
        seed += 1
    }
}

fn test_cb02a_coast_sheet_keeps_plain_tier_and_sprite_footprints() {
    let g = art.coast_sheet(tier.PLAIN)
    assert(grid.plain_ok(g), "plain coast sheet")
    assert(grid.at(g, 4, 4).cp == 79, "hollow log end grain")
    assert(grid.at(g, 4, 19).cp == 60 && grid.at(g, 4, 27).cp == 62, "shortcut passage")
    assert(grid.at(g, 4, 39).cp == 88, "bundle binding")
    var k = 0
    while k < 5 {
        var n = 0
        var dx = 0
        while dx < 5 {
            if grid.at(g, 10, 4 + k * 13 + dx).cp != 32 { n += 1 }
            if grid.at(g, 11, 4 + k * 13 + dx).cp != 32 { n += 1 }
            dx += 1
        }
        assert(n >= 6, "each flotsam sprite has a silhouette")
        k += 1
    }
}

fn test_cb02a_rich_props_emit_scalar_glyphs_not_utf8_bytes() {
    let g = art.coast_sheet(tier.RICH)
    assert(grid.at(g, 3, 5).cp == 9617, "one wood grain cell")
    assert(grid.at(g, 4, 38).cp == 9617 && grid.at(g, 4, 40).cp == 9617, "one cell per bundle fold")
    for cell in g.cells {
        assert(cell.cp < 128 || cell.cp >= 160, "no split UTF-8 continuation byte")
    }
}

fn test_cb02a_branches_join_the_shore_without_an_origin_seam() {
    // Ten seeds here; the fifty-seed sweep is the shipping binary's audit.
    var seed = 0
    while seed < 10 {
        var cache = 0
        while cache < forest.cache_count(forest.SHINGLE) {
            var at = -10
            while at <= forest.coast_end(seed, cache) {
                let x = forest.coast_branch_x(seed, 80, cache, at)
                let y = forest.origin(seed, 0) + at
                if y >= terrain.bank(seed, x) + terrain.REED_ROWS {
                    assert(!forest.blocked(seed, 80, 0, x, y), "branch meets actual shore")
                }
                at += 1
            }
            cache += 1
        }
        seed += 1
    }
}

fn test_cb02a_guard_does_not_hide_the_treasure_sprite() {
    var s = sim.new(1, 80, 24)
    let (x, y) = forest.cache_position(s.seed, s.field, 0, 0)
    s.x = x - 8 * sim.FP
    s.y = y
    var g = grid.new(24, 80)
    art.render(s, tier.RICH, mut g)
    assert(grid.at(g, 12, 48).cp == 88, "bundle binding remains visible beside guard")
}
