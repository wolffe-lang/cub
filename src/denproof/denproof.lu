//! Independent tile distances, gate census and real-key den witnesses.

use art
use controls
use forest
use grid
use journey
use replay
use sim
use std.fs
use tier
use walker

// Flood actual walkable tiles, not the generator's centreline formula.
fn distances(seed: int, field: int) -> List[int] {
    let w = forest.bound(field, 1)
    let width = 2 * w + 1
    var dist = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (forest.length(1) + 1) { (mut dist).push(-1); i += 1 }
    dist[w] = 0
    (mut queue).push(w)
    var head = 0
    while head < queue.len {
        let cell = queue[head]
        let x = cell % width - w
        let y = cell / width
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= -w && nx <= w && ny >= 0 && ny <= forest.length(1) {
                let at = ny * width + nx + w
                if dist[at] < 0 && !forest.blocked(seed, field, 1, nx, ny) {
                    dist[at] = dist[cell] + 1
                    (mut queue).push(at)
                }
            }
            d += 1
        }
        head += 1
    }
    dist
}

/// Fifty seeds at both fields, shortest tile paths and every gate face/tier.
pub fn census() -> int {
    var seed = 0
    while seed < 50 {
        var size = 0
        while size < 2 {
            region row {
                let field = if size == 0 then 80 else 200
                let w = forest.bound(field, 1)
                let width = 2 * w + 1
                let dist = distances(seed, field)
                let (dx, dy) = forest.den_position(seed, 1)
                let den = dist[sim.floor_div(dy, sim.FP) * width + sim.floor_div(dx, sim.FP) + w]
                let full = dist[forest.length(1) * width + w]
                let centreline = forest.path_length(seed, 1)
                print(
                    "den seed {seed} field {field} distance {den} exit {full} centreline {centreline}",
                )
                if den < 0 || full < 0 || den * 3 < full || den * 3 < centreline { return 1 }
                for area in [forest.SHINGLE, forest.TOWN] {
                    var s = sim.new(seed, field, 24)
                    s.area = area
                    s.x = sim.FP / 2
                    let y = forest.thorn_row(seed, area)
                    s.y = (y - 5) * sim.FP
                    var t = 0
                    while t < 2 {
                        var g = grid.new(24, field)
                        art.draw_thorn_boundary(s, t, mut g)
                        let row = y - sim.cell_y(s) + sim.screen_row(s)
                        var x = -2
                        while x <= 2 {
                            if !sim.blocked(s, x, y) ||
                                grid.at(g, row, x + sim.screen_col(s)).cp !=
                                    art.thorn_cell(t, x + 4).cp {
                                return 1
                            }
                            x += 1
                        }
                        s.gate_open = true
                        grid.clear(mut g)
                        art.draw_thorn_boundary(s, t, mut g)
                        if sim.blocked(s, 0, y) ||
                            grid.at(g, row, sim.screen_col(s)).cp != 32 ||
                            grid.at(g, row, sim.screen_col(s) + 4).cp == 32 {
                            return 1
                        }
                        s.gate_open = false
                        t += 1
                    }
                }
                print(
                    "gates seed {seed} field {field} gates {forest.THORN_GATES} faces 2 tiers 2 closed-present open-gap",
                )
            }
            size += 1
        }
        seed += 1
    }
    print("den-census: green (100 den paths, 400 gate-face-tier rows, 0 skips)")
    0
}

fn initial(s: sim.Sim) -> replay.Replay {
    var r = replay.new(s.seed, tier.RICH, s.cols, s.rows)
    replay.push_arg(mut r, 0, controls.EV_JOURNEY, journey.JOURNEY)
    let values = journey.snapshot(s)
    var i = 0
    while i < values.len { replay.push_arg(mut r, 0, controls.EV_SAVED + i, values[i]); i += 1 }
    r
}

fn write_case(dir: str, name: str, s: sim.Sim, r: replay.Replay, every: int) -> () ! {io} {
    var bytes = List[byte]()
    replay.format(r, controls.vocab(), mut bytes)
    fs.write_bytes(dir + "/" + name + ".pk", bytes) else { return io }
    fs.append_text(dir + "/" + name + ".pk", "\n# frames {s.tick} every {every}\n") else {
        return io
    }
}

/// Goldens per region/size and an ordinary walk, rest, leave, death, wake.
pub fn generate(dir: str) -> int {
    fs.create_dir_all(dir) else { return 2 }
    var area = 0
    while area < forest.AREAS {
        var size = 0
        while size < 2 {
            region scene {
                let cols = if size == 0 then 80 else 120
                let rows = if size == 0 then 24 else 40
                var s = sim.new(7, cols, rows)
                s.gate_open = true
                s.last_den = if area < 2 then area else if area == 6 then 7 else area + 1
                s.lit_dens = sim.light_den(1, s.last_den)
                s.opening_seen = true
                s.flask_max = 2
                s.scent = 100
                sim.wake(mut s)
                var r = initial(s)
                walker.press(mut s, mut r, walker.key(controls.KEY_REST))
                while s.tick < 36 { walker.press(mut s, mut r, walker.key(0)) }
                let name = match area {
                    0 => "shingle",
                    1 => "bramblehold",
                    2 => "larkmeadow",
                    3 => "teeth",
                    4 => "shallows",
                    5 => "old-den",
                    _ => "cinderwick",
                }
                write_case(dir, "rest-{name}-{cols}x{rows}", s, r, 7) else { return 2 }
            }
            size += 1
        }
        area += 1
    }
    var water = sim.new(7, 80, 24)
    var water_replay = replay.new(7, tier.RICH, 80, 24)
    let (spring_x, spring_y) = sim.spring_position(7, 0)
    if !walker.walk(mut water, mut water_replay, spring_x, spring_y) || water.flask_max != 2 {
        return 1
    }
    replay.push_arg(mut water_replay, water.tick, controls.EV_HEALTH, -30)
    sim.hurt(mut water, 30)
    walker.press(mut water, mut water_replay, walker.key(controls.KEY_WATER))
    var water_ticks = 0
    while water_ticks < 35 {
        walker.press(mut water, mut water_replay, walker.key(0))
        water_ticks += 1
    }
    if water.flasks != 1 || water.health != 52 { return 1 }
    write_case(dir, "spring-drink", water, water_replay, water.tick) else { return 2 }
    let (home_x, home_y) = forest.den_position(7, 0)
    if !walker.walk(mut water, mut water_replay, home_x, home_y) { return 1 }
    walker.press(mut water, mut water_replay, walker.key(controls.KEY_REST))
    if !water.den || water.flasks != 2 { return 1 }
    write_case(dir, "water-refill", water, water_replay, water.tick) else { return 2 }
    var s = sim.new(7, 80, 24)
    s.gate_open = true
    s.last_den = 8
    s.lit_dens = sim.light_den(1, 8)
    s.opening_seen = true
    s.flask_max = 2
    sim.wake(mut s)
    var r = initial(s)
    let (x, y) = forest.den_position(s.seed, 2)
    if !walker.walk(mut s, mut r, x + 2 * sim.FP, y) { eprint("den-proof: walk failed"); return 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_REST))
    if !s.den || s.last_den != 2 { eprint("den-proof: entry failed"); return 1 }
    var n = 0
    while n < 20 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
    walker.press(mut s, mut r, walker.key(controls.KEY_RELEASE))
    // The only non-key fixture is a disclosed fatal hit, away from the checkpoint.
    if !walker.walk(mut s, mut r, x, y + 5 * sim.FP) { return 1 }
    s.scent += 37
    replay.push_arg(mut r, s.tick, controls.EV_SCENT, 37)
    replay.push_arg(mut r, s.tick, controls.EV_HEALTH, -10000)
    sim.hurt(mut s, 10000)
    let death_x = s.x
    let death_y = s.y
    n = 0
    while n < 30 { walker.press(mut s, mut r, walker.key(0)); n += 1 }
    if s.area != 1 ||
        s.x != x ||
        s.y != y ||
        !s.mark ||
        s.mark_x != death_x ||
        s.mark_y != death_y {
        return 1
    }
    write_case(dir, "den-checkpoint", s, r, s.tick) else { return 2 }
    print("den-proof: green, den2 wake at {x},{y}; death at {death_x},{death_y}; {s.tick} ticks")
    0
}
