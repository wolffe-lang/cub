//! member: false
//!
//! The Shingle is a pure function of the seed: the noise in range and
//! smooth, the bank wanders within its swing, the bands lie in order from
//! the water to the woods, and the start is open ground.

use terrain
use world

fn test_noise2_bounds_and_determinism() {
    var x = -40
    while x < 80 {
        var y = -30
        while y < 60 {
            let n = terrain.noise2(3, 1, x, y)
            assert(n >= 0 && n <= terrain.FP, "noise {n} at {x},{y}")
            assert(n == terrain.noise2(3, 1, x, y), "twice the same")
            y += 1
        }
        x += 1
    }
    assert(
        terrain.noise2(1, 1, 5, 5) != terrain.noise2(2, 1, 5, 5) ||
            terrain.noise2(1, 1, 30, 9) != terrain.noise2(2, 1, 30, 9),
        "seeds differ",
    )
}

fn test_noise2_is_smooth() {
    var x = 0
    while x < 200 {
        let a = terrain.noise2(5, 1, x, 7)
        let b = terrain.noise2(5, 1, x + 1, 7)
        let d = if a > b then a - b else b - a
        assert(d <= terrain.FP * 3 / (2 * terrain.LATTICE) + 2, "a step of {d} at {x}")
        x += 1
    }
}

fn test_the_bank_wanders_within_its_swing() {
    var x = -100
    while x < 100 {
        let b = terrain.bank(9, x)
        assert(
            b >= terrain.BANK_ROW && b <= terrain.BANK_ROW + terrain.BANK_SWING,
            "bank {b} at {x}",
        )
        x += 1
    }
}

fn test_the_bands_lie_in_order() {
    var x = -30
    while x < 30 {
        let b = terrain.bank(4, x)
        assert(terrain.kind(4, x, b - 1) == terrain.WATER, "water above the bank at {x}")
        let edge = terrain.kind(4, x, b)
        assert(edge == terrain.REEDS || edge == terrain.GRASS, "reeds at the edge at {x}")
        assert(
            terrain.kind(4, x, b + terrain.REED_ROWS) == terrain.GRAVEL,
            "gravel below the reeds at {x}",
        )
        assert(
            terrain.kind(4, x, b + terrain.REED_ROWS + terrain.SHINGLE_ROWS - 1) == terrain.GRAVEL,
            "the shingle's last row at {x}",
        )
        x += 1
    }
}

fn woods_range(first: int) {
    var grass = 0
    var trunks = 0
    var dark = 0
    var canopy = 0
    var x = first
    while x < first + 100 {
        var y = 20
        while y < 60 {
            let k = terrain.kind(6, x, y)
            if k == terrain.GRASS {
                grass += 1
            } else if k == terrain.TRUNK {
                trunks += 1
            } else if k == terrain.DARK {
                dark += 1
            } else if k == terrain.CANOPY {
                canopy += 1
            }
            y += 1
        }
        x += 1
    }
    assert(
        grass > 0 && trunks > 0 && canopy > 0 && dark > 0,
        "every kind appears: {grass} {trunks} {canopy} {dark}",
    )
    assert(grass > dark, "more open ground than deep forest near the bank: {grass} over {dark}")
}

fn test_the_start_is_open_ground() {
    var seed = 1
    while seed < 40 {
        let (x, y) = terrain.start(seed)
        assert(
            !terrain.blocked(seed, x / terrain.FP, y / terrain.FP),
            "seed {seed} starts on open ground",
        )
        assert(
            terrain.kind(seed, x / terrain.FP, y / terrain.FP) == terrain.GRAVEL,
            "on the gravel",
        )
        seed += 1
    }
    assert(
        terrain.variant(1, 3, 4, 4) >= 0 && terrain.variant(1, 3, 4, 4) < 4,
        "a variant in range",
    )
    assert(world.FP == terrain.FP, "one fixed point")
}

fn test_woods_cover_0() { woods_range(0) }

fn test_woods_cover_1() { woods_range(100) }

fn test_woods_cover_2() { woods_range(200) }

fn test_woods_cover_3() { woods_range(300) }
