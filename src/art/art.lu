//! art — a frame from the simulation: the Shingle around the camera and
//! the cub at its centre, drawn onto a grid through a tier. Pure: the same
//! simulation state and tier give the same grid, which the goldens pin.
//!
//! The sprites (`docs/ART.md`): the rich cub is two cells by two, its
//! ears on the side it faces (quadrant blocks), its body the full block;
//! the plain cub is a bold `C` with a facing mark beside it. The ground is
//! the terrain's kind at each world cell with the seed's texture.

use draw
use forest
use ghost
use grid
use glow
use meadow
use props
use restscene
use silhouette
use sim
use sprites
use terrain
use tier
use world

/// What a frame shows beyond the simulation (cb04): the ghosts of the
/// journey's deaths, and on the title the demo's own world (a list of one
/// simulation, or empty).
pub struct Extra {
    ghosts: ghost.Set,
    demo: List[sim.Sim],
    demo_on: bool,
}

/// No ghosts, no demo.
pub fn extra_none() -> Extra {
    Extra { ghosts: ghost.empty(), demo: List[sim.Sim](), demo_on: false }
}

/// The terrain of screen row `row` into `g` on tier `t`.
pub fn terrain_row(s: sim.Sim, t: int, row: int, mut g: grid.Grid) {
    var col = 0
    while col < s.cols {
        let (x, y) = sim.world_cell(s, row, col)
        var cell = ground_at(s.seed, s.field, s.area, t, x, y)
        // Sight hides creatures, never the forest itself.
        if s.area == forest.BRAMBLEHOLD &&
            !sim.near(s.x, s.y, x * sim.FP, y * sim.FP, 12 * sim.FP) {
            cell.attrs = 0
        }
        grid.put(mut g, row, col, cell)
        col += 1
    }
}

/// The ground world cell `(x, y)` of an area draws on tier `t`: its kind's
/// sprite with the seed's texture, under the area's keyframe.
pub fn ground_at(seed: int, field: int, area: int, t: int, x: int, y: int) -> grid.Cell {
    let k = forest.kind(seed, field, area, x, y)
    let v = world.hash(seed + 31, x, y, 4)
    // Foliage variants alternate their glyph set by the cell's parity,
    // so two adjacent canopy or deep-forest cells are never identical:
    // the forest reads as texture, never as a run of one tile.
    let foliage = 2 * (((x + y) % 2 + 2) % 2) + world.hash(seed + 31, x, y, 2)
    let variant = if k == terrain.GRAVEL {
        if terrain.variant(seed, x, y, 7) == 0 then 1 + v % 3 else 0
    } else if k == terrain.WATER || k == terrain.SHALLOWS {
        if terrain.variant(seed, x, y, 5) == 0 then 1 + v % 3 else 0
    } else if k == terrain.TRUNK {
        0
    } else if k == terrain.CANOPY || k == terrain.DARK {
        foliage
    } else if k == terrain.ROCK {
        // Stone alternates its two faces by parity too (cb04: the crags
        // are stone, and stone is held to the no-flat-fill rule).
        ((x + y) % 2 + 2) % 2
    } else {
        v
    }
    kind_cell(area, t, k, variant, foliage)
}

/// The sprite a terrain kind draws.
fn sprite_of(k: int) -> int {
    if k == terrain.GRAVEL {
        sprites.SP_GRAVEL
    } else if k == terrain.GRASS {
        sprites.SP_GRASS
    } else if k == terrain.TRUNK {
        sprites.SP_TRUNK
    } else if k == terrain.CANOPY {
        sprites.SP_CANOPY
    } else if k == terrain.WATER {
        sprites.SP_WATER
    } else if k == terrain.ROCK {
        sprites.SP_ROCK
    } else if k == terrain.REEDS {
        sprites.SP_REEDS
    } else if k == terrain.SHALLOWS {
        sprites.SP_SHALLOWS
    } else {
        sprites.SP_DARK
    }
}

/// A terrain kind's cell in an area on a tier, at a variant: the sprite,
/// then the area's dusk keyframe over it inland.
pub fn kind_cell(area: int, t: int, k: int, variant: int, foliage: int) -> grid.Cell {
    var cell = sprites.glyph(t, sprite_of(k), variant)
    // The Shallows' water, shallows and reeds keep the river's own colours
    // under its keyframe; everything else inland takes the area's floor.
    let water = k == terrain.WATER ||
        k == terrain.SHALLOWS ||
        k == terrain.REEDS && area == forest.RIVER
    if area != forest.SHINGLE && !water {
        cell.bg = if t == tier.RICH then floor_of(area) else 0
        cell.fg = dusk_ink(area, t, k, foliage)
        // The old den's open floor carries the pack's scent: a dim mark on
        // every other grass cell (cb04).
        if area == forest.OLDDEN && k == terrain.GRASS && variant % 2 == 0 {
            cell.cp = if variant % 4 == 0 then 58 else 46
        }
    }
    cell
}

/// An inland area's floor colour on the rich tier (`docs/PALETTE.md`).
fn floor_of(area: int) -> int {
    match area {
        1 => 233,
        2 => 235,
        3 => 236,
        4 => 233,
        _ => 232,
    }
}

/// Every style a path cell of an area draws on a tier (cb02c): the area's
/// one path kind (`forest.path_kind`) at each of its texture variants.
/// A path cell in any other style is a path drawn in the wrong colour.
pub fn path_styles(area: int, t: int) -> List[grid.Cell] {
    var out = List[grid.Cell]()
    var v = 0
    while v < sprites.VARIANT_COUNT {
        (mut out).push(kind_cell(area, t, forest.path_kind(area), v, 0))
        v += 1
    }
    out
}

/// Whether a cell's style is one of a path's.
pub fn is_path_style(area: int, t: int, c: grid.Cell) -> bool {
    among(path_styles(area, t), c)
}

/// Path cells of an area drawn outside its path styles, on either tier:
/// every walkable cell `forest.on_path` names, the coast's rows from the
/// river, the whole width of the field. Zero is the bar (cb02c).
pub fn path_audit(seed: int, field: int, area: int) -> int {
    let w = forest.bound(field, area)
    let o = forest.origin(seed, area)
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let rich = path_styles(area, tier.RICH)
    let plain = path_styles(area, tier.PLAIN)
    var off = 0
    var y = o + top
    while y <= o + forest.LENGTH {
        var x = 0 - w
        while x <= w {
            if forest.on_path(seed, field, area, x, y) && !forest.blocked(seed, field, area, x, y) {
                if !among(rich, ground_at(seed, field, area, tier.RICH, x, y)) ||
                    !among(plain, ground_at(seed, field, area, tier.PLAIN, x, y)) {
                    off += 1
                }
            }
            x += 1
        }
        y += 1
    }
    off
}

fn among(styles: List[grid.Cell], c: grid.Cell) -> bool {
    for p in styles {
        if grid.same(p, c) { return true }
    }
    false
}

/// The dusk keyframes (`docs/PALETTE.md`): the thicket's two foliage
/// greens over its floor, the meadow's gold grass and tall grass with the
/// dusk woods closing round it; trunks share one dusk brown. Two tones
/// per foliage kind keep the forest's texture under the recolour.
fn dusk_ink(area: int, t: int, k: int, foliage: int) -> int {
    let thicket = area == forest.BRAMBLEHOLD
    if area == forest.CRAGS { return crag_ink(t, k, foliage) }
    if area == forest.OLDDEN { return night_ink(t, k, foliage) }
    if area == forest.RIVER { return river_ink(t, k, foliage) }
    if t != tier.RICH {
        if k == terrain.TRUNK { return 3 }
        if k == terrain.GRASS || k == terrain.REEDS { return if thicket then 2 else 3 }
        return 2
    }
    if k == terrain.TRUNK { return 95 }
    if k == terrain.GRASS { return if thicket then 65 else 137 }
    if k == terrain.REEDS { return if thicket then 65 else 143 }
    if k == terrain.CANOPY {
        return if thicket {
            (if foliage % 4 < 2 then 29 else 23)
        } else {
            (if foliage % 4 < 2 then 58 else 22)
        }
    }
    if thicket then 23 else 58
}

/// The Teeth's keyframe (cb04): grey stone in two faces, pale gravel marks
/// on the ledges, scree tufts in a dry green, dead pines.
fn crag_ink(t: int, k: int, foliage: int) -> int {
    if t != tier.RICH {
        if k == terrain.ROCK { return if foliage % 2 == 0 then 7 else 15 }
        if k == terrain.GRASS { return 2 }
        if k == terrain.TRUNK { return 3 }
        return 7
    }
    if k == terrain.ROCK { return if foliage % 2 == 0 then 243 else 250 }
    if k == terrain.GRAVEL { return 245 }
    if k == terrain.GRASS { return 101 }
    if k == terrain.TRUNK { return 95 }
    if k == terrain.CANOPY { return if foliage % 4 < 2 then 58 else 22 }
    240
}

/// Gravehollow's keyframe (cb04): night in the deep wood, the brush in
/// two cold greens over a black floor, the pack's scent marks dim grey.
fn night_ink(t: int, k: int, foliage: int) -> int {
    if t != tier.RICH {
        if k == terrain.TRUNK { return 3 }
        if k == terrain.GRASS { return 8 }
        return 2
    }
    if k == terrain.TRUNK { return 59 }
    if k == terrain.GRASS { return 240 }
    if k == terrain.CANOPY { return if foliage % 4 < 2 then 23 else 17 }
    17
}

/// The Shallows' keyframe (cb04): willow greens over a dark floor, the
/// bank's shingle in a cold grey; the water keeps the river's colours.
fn river_ink(t: int, k: int, foliage: int) -> int {
    if t != tier.RICH {
        if k == terrain.TRUNK { return 3 }
        if k == terrain.GRAVEL { return 7 }
        return 2
    }
    if k == terrain.TRUNK { return 94 }
    if k == terrain.GRAVEL { return 250 }
    if k == terrain.GRASS { return 66 }
    if k == terrain.CANOPY { return if foliage % 4 < 2 then 66 else 23 }
    23
}

/// The cub's fur on a tier for a stamina band: fresh, tired or spent.
fn fur(t: int, band: int) -> grid.Cell {
    grid.cell(
        32,
        sprites.palette(t, if band == 0 then sprites.C_FUR else sprites.C_FUR_DIM),
        grid.COLOR_DEFAULT,
        if t == tier.RICH then 0 else grid.ATTR_BOLD,
    )
}

/// The plain tier's cub, the rich footprint in ASCII: four cells by four
/// north and south (ears, shoulders, body, tail), eight by two east and
/// west (the head leading, the tail trailing). The tail `,` sits on the
/// side the rich tail swings to (`tail` the wag's offset; at the middle
/// the side it swings toward next, `rising`), so the plain tail wags on
/// the gait too, one cell each side. `hurt` is the health band (cb03).
fn plain_cub(facing: int, pose: int, tail: int, rising: bool, hurt: int) -> List[str] {
    var rows = List[str]()
    // Hurt, the ears go back (the sneak's low row); badly hurt, the tail
    // hangs still on the left (cb03, posture as HUD).
    let low = pose == 2 || pose == 3 || hurt >= 1
    // The tail's side seen from above, the cub's own right positive.
    let right = hurt < 2 && (tail > 0 || tail == 0 && rising)
    if facing == 0 {
        (mut rows).push(if low then ".__." else ".^^.")
        (mut rows).push("####")
        (mut rows).push("####")
        (mut rows).push(if right then "..,." else ".,..")
    } else if facing == 2 {
        (mut rows).push(if right then ".,.." else "..,.")
        (mut rows).push("####")
        (mut rows).push("####")
        (mut rows).push(if low then ".__." else ".vv.")
    } else if facing == 1 {
        (mut rows).push(
            if low {
                (if right then ".=####_." else ",=####_.")
            } else {
                (if right then ".=####^." else ",=####^.")
            },
        )
        (mut rows).push(if right then ",=####>." else ".=####>.")
    } else {
        (mut rows).push(
            if low {
                (if right then "._####=," else "._####=.")
            } else {
                (if right then ".^####=," else ".^####=.")
            },
        )
        (mut rows).push(if right then ".<####=." else ".<####=,")
    }
    rows
}

/// Draw the cub at its own cell `(row, col)` facing `facing` (0 north, 1
/// east, 2 south, 3 west) with stamina `band`, standing (or panting when
/// spent), the paws and tail at rest. Rich:
/// one silhouette turned to the facing (`silhouette.cub`); plain: the
/// same footprint in ASCII. The ground shows through unlit cells.
pub fn draw_cub(mut g: grid.Grid, t: int, row: int, col: int, facing: int, band: int) {
    let pant = band == 2
    draw_pose(
        mut g,
        t,
        row,
        col,
        facing,
        band,
        if pant then 3 else 0,
        0,
        0,
        true,
        0,
        if pant then 1 else 0,
    )
}

/// The whole frame with nothing beyond the simulation (the tests', the
/// instrument's): `render_with` and no extra.
pub fn render(s: sim.Sim, t: int, mut g: grid.Grid) {
    render_with(s, extra_none(), t, mut g)
}

/// The pose the frame draws the cub in: 0 standing, 1 walking, 2 sneaking
/// (and an attack's windup), 3 panting, 4 fallen (the ghosts record it).
pub fn pose_of(s: sim.Sim) -> int {
    if s.action == sim.FALL {
        4
    } else if s.exhausted {
        3
    } else if s.sneaking ||
        s.action == sim.BITE && s.tick - s.started < 3 ||
        s.action == sim.LUNGE && s.tick - s.started < 9 {
        2
    } else if s.speed > 0 {
        1
    } else {
        0
    }
}

/// The whole frame: the ground on every row, the ghosts, then the cub at
/// the centre, the bosses' bar, the lines. `g` must be the simulation's
/// size (`assert`). A scene (the opening, the title, the end) draws its
/// own frame instead.
pub fn render_with(s: sim.Sim, extra: Extra, t: int, mut g: grid.Grid) {
    assert(g.rows == s.rows && g.cols == s.cols, "art.render: the grid is the simulation's size")
    if s.scene == 1 { opening_frame(s, t, mut g); return }
    if s.scene == sim.SCENE_TITLE { title_frame(s, extra, t, mut g); return }
    if s.scene == sim.SCENE_END { end_frame(s, t, mut g); return }
    if s.den {
        restscene.render(s, t, mut g)
        den_menu(s, t, mut g)
        return
    }
    var row = 0
    while row < s.rows {
        terrain_row(s, t, row, mut g)
        row += 1
    }
    meadow_finds(s, t, mut g)
    shore_finds(s, t, mut g)
    shade_exits(s, t, mut g)
    draw_ghosts(s, extra.ghosts, t, mut g)
    draw_world_marks(s, t, mut g)
    // The cub's own cell is the centre; the silhouette hangs about it.
    let (ox, oy) = sim.attack_offset(s)
    let r = sim.screen_row(s) + sim.floor_div(s.y + oy, sim.FP) - sim.cell_y(s)
    let c = sim.screen_col(s) + sim.floor_div(s.x + ox, sim.FP) - sim.cell_x(s)
    // The body's facing (cb02c): the aim's during an attack, the heading's
    // quarter otherwise, held while a swing has no room for it.
    let facing = s.body_facing
    let pose = if pose_of(s) == 4 then 0 else pose_of(s)
    if s.end {
        // The wolf (cb04): the cub grown one size, the same gait.
        draw_wolf(
            mut g,
            t,
            r,
            c,
            facing,
            band(s.stamina, sim.stamina_max(s.wind)),
            pose,
            sim.legs(s),
        )
        draw_posture(s, t, mut g)
        draw_hud(s, t, mut g)
        draw_boss_bar(s, t, mut g)
        world_lines(s, t, mut g)
        return
    }
    let shake = sim.head_shake(s)
    if shake != 0 && t == tier.RICH {
        // The third bite's head shake: the body stays, the head cells move
        // one cell across the aim (a column north or south, a row east or
        // west), the same silhouette in two parts.
        let style = fur(t, band(s.stamina, sim.stamina_max(s.wind)))
        let body = silhouette.cub_posed(
            pose,
            sim.legs(s),
            silhouette.wag(sim.tail_phase(s), pose == 1),
            sim.hurt_band(s),
            sim.breath(s),
        )
        silhouette.draw_at(mut g, r, c, silhouette.strip(body, false), facing, style)
        let dr = if facing % 2 == 0 then 0 else shake
        let dc = if facing % 2 == 0 then shake else 0
        silhouette.draw_at(mut g, r + dr, c + dc, silhouette.strip(body, true), facing, style)
    } else {
        draw_pose(
            mut g,
            t,
            r,
            c,
            facing,
            band(s.stamina, sim.stamina_max(s.wind)),
            pose,
            sim.legs(s),
            silhouette.wag(sim.tail_phase(s), pose == 1),
            sim.tail_phase(s) < 4,
            sim.hurt_band(s),
            sim.breath(s),
        )
        if shake != 0 {
            // Plain: the ears row shifts across the aim.
            let dr = if facing == 0 then -1 else if facing == 2 then 2 else shake
            let dc = if facing % 2 == 0 then shake - 1 else (if facing == 1 then 3 else -2)
            draw.put_text(
                mut g,
                r + dr,
                c + dc,
                if facing % 2 == 0 then ".^^." else "^",
                ink(t, true),
            )
        }
    }
    draw_posture(s, t, mut g)
    draw_hud(s, t, mut g)
    draw_boss_bar(s, t, mut g)
    world_lines(s, t, mut g)
    if s.gate_hint_until > s.tick {
        draw.put_text(mut g, s.rows - 2, 1, "the thorns need a lunge", ink(t, true))
    }
}

/// The art study's sheet (`docs/ART.md`): the cub facing each of the four
/// ways in each of its four poses over a strip of the Shingle (water,
/// reeds, gravel, grass, the woods, the deep forest), then every foe in
/// every phase and fade facing north and the east form of each, on a 56 by
/// 80 grid. Committed as a golden on both tiers.
pub fn sheet(t: int) -> grid.Grid {
    var g = grid.new(56, 80)
    // Bands of ground, top to bottom.
    var row = 0
    while row < 56 {
        var col = 0
        while col < 80 {
            let v = (row * 7 + col * 13) % 4
            let foliage = 2 * ((row + col) % 2) + (row * 3 + col) % 2
            let cell = if row < 3 {
                sprites.glyph(
                    t,
                    sprites.SP_WATER,
                    if (row * 31 + col * 17) % 5 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 5 {
                sprites.glyph(t, sprites.SP_REEDS, v)
            } else if row < 11 {
                sprites.glyph(
                    t,
                    sprites.SP_GRAVEL,
                    if (row * 11 + col * 3) % 7 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 15 {
                sprites.glyph(t, sprites.SP_GRASS, v)
            } else if row < 25 {
                if (row * 5 + col * 11) % 9 == 0 {
                    sprites.glyph(t, sprites.SP_TRUNK, 0)
                } else {
                    sprites.glyph(t, sprites.SP_CANOPY, foliage)
                }
            } else if row < 28 {
                sprites.glyph(t, sprites.SP_DARK, foliage)
            } else {
                sprites.glyph(t, sprites.SP_GRAVEL, 0)
            }
            grid.put(mut g, row, col, cell)
            col += 1
        }
        row += 1
    }
    draw.put_text(mut g, 5, 1, "cub:   N          E          S          W", ink(t, true))
    var pose = 0
    while pose < 4 {
        var f = 0
        while f < 4 {
            draw_pose(
                mut g,
                t,
                8 + pose * 5,
                10 + f * 11,
                f,
                if pose == 3 then 2 else 0,
                pose,
                0,
                0,
                true,
                0,
                if pose == 3 then 1 else 0,
            )
            f += 1
        }
        draw.put_text(
            mut g,
            8 + pose * 5,
            1,
            if pose == 0 {
                "stand"
            } else if pose == 1 {
                "walk"
            } else if pose == 2 {
                "sneak"
            } else {
                "pant"
            },
            ink(t, true),
        )
        pose += 1
    }
    // The wag's frames (cb02c): the walking cub facing north with its tail
    // at each offset the gait passes, -2 to 2 pixels; the paws' two frames.
    draw.put_text(mut g, 6, 51, "wag: -2  -1   0  +1  +2", ink(t, true))
    var tail = -2
    while tail <= 2 {
        draw_pose(mut g, t, 13, 54 + (tail + 2) * 5, 0, 0, 1, (tail + 2) % 2, tail, true, 0, 0)
        tail += 1
    }
    // The health bands (cb03, R-cb03-2 A): the walking cub facing north in
    // each band, full to dying; and the breath's frames at rest: fresh out
    // and in, the pant's mouth closed and open.
    draw.put_text(mut g, 17, 51, "hurt: full hurt bad dying", ink(t, true))
    var hurt = 0
    while hurt < 4 {
        draw_pose(mut g, t, 19, 54 + hurt * 5, 0, 0, 1, 0, 1, true, hurt, 0)
        hurt += 1
    }
    draw.put_text(mut g, 23, 51, "breath: out in  pant0 pant1", ink(t, true))
    var frame = 0
    while frame < 4 {
        let pant = frame >= 2
        draw_pose(
            mut g,
            t,
            25,
            54 + frame * 5,
            0,
            if pant then 2 else 0,
            if pant then 3 else 0,
            0,
            0,
            true,
            0,
            frame % 2,
        )
        frame += 1
    }
    var kind = 0
    while kind < 3 {
        let species = if kind == 2 then sim.DEER else kind
        let top = 29 + kind * 9
        draw.put_text(
            mut g,
            top,
            1,
            if kind == 0 {
                "weasel: hunt   crouch strike flee   stagger feint  pause  fade0  fade5  fade10"
            } else if kind == 1 {
                "fox:    hunt   crouch strike flee   stagger feint  pause  fade0  fade5  fade10"
            } else {
                "deer:   stand  flee                                       fade0  fade5  fade10"
            },
            ink(t, true),
        )
        var phase = 0
        while phase < 10 {
            if kind < 2 || phase < 2 || phase >= 7 {
                draw_foe(
                    mut g,
                    t,
                    top + 3,
                    9 + phase * 7,
                    species,
                    if phase < 7 {
                        (if phase == 1 && kind == 2 then sim.RETREAT else phase)
                    } else {
                        sim.HUNT
                    },
                    0,
                    if phase < 7 then -1 else (phase - 7) * 5,
                )
            }
            phase += 1
        }
        // The east form: the same silhouette turned, hunting and striking.
        draw.put_text(mut g, top + 6, 1, "east:", ink(t, true))
        draw_foe(mut g, t, top + 6, 12, species, sim.HUNT, 64, -1)
        draw_foe(
            mut g,
            t,
            top + 6,
            24,
            species,
            if kind == 2 then sim.RETREAT else sim.STRIKE,
            64,
            -1,
        )
        draw_foe(mut g, t, top + 6, 36, species, sim.HUNT, 192, -1)
        kind += 1
    }
    g
}

fn band(value: int, maximum: int) -> int {
    if value * 3 > maximum * 2 then 0 else if value * 3 > maximum then 1 else 2
}

fn ink(t: int, bright: bool) -> grid.Cell {
    grid.cell(
        32,
        if t == tier.RICH then (if bright then 180 else 137) else (if bright then 11 else 3),
        sprites.palette(t, sprites.C_GRAVEL),
        if bright then grid.ATTR_BOLD else 0,
    )
}

fn at_world(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int, text: str, bright: bool) {
    draw.put_text(
        mut g,
        y - sim.cell_y(s) + sim.screen_row(s),
        x - sim.cell_x(s) + sim.screen_col(s),
        text,
        ink(t, bright),
    )
}

fn world_orb(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int) {
    let cx = sim.floor_div(x, sim.FP)
    let cy = sim.floor_div(y, sim.FP)
    glow.orb(
        mut g,
        t,
        cy - sim.cell_y(s) + sim.screen_row(s),
        cx - sim.cell_x(s) + sim.screen_col(s),
        s.seed,
        cx,
        cy,
        s.tick,
    )
}

fn world_prop(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int, kind: int, opened: bool) {
    props.draw_at(
        mut g,
        t,
        y - sim.cell_y(s) + sim.screen_row(s),
        x - sim.cell_x(s) + sim.screen_col(s),
        kind,
        opened,
        s.tick,
    )
}

fn draw_world_marks(s: sim.Sim, t: int, mut g: grid.Grid) {
    for meat in s.meat {
        draw_meat(
            mut g,
            t,
            sim.floor_div(meat.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s),
            sim.floor_div(meat.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s),
            s.tick,
        )
    }
    var spring = 0
    while spring < sim.SPRINGS {
        if s.area == sim.spring_area(spring) {
            let (x, y) = sim.spring_position(s.seed, spring)
            draw_spring(
                mut g,
                t,
                sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s),
                sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s),
                s.tick,
                sim.spring_available(s, spring),
            )
        }
        spring += 1
    }
    for drop in s.drops {
        world_orb(s, t, mut g, drop.x, drop.y)
    }
    draw_thorn_boundary(s, t, mut g)
    var cache = 0
    while cache < forest.cache_count(s.area) {
        let (x, y) = forest.cache_position(s.seed, s.field, s.area, cache)
        if s.area == forest.SHINGLE {
            draw_bundle(
                mut g,
                t,
                sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s) - 1,
                sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s) - 2,
                sim.cache_open(s, cache),
            )
            if !sim.cache_open(s, cache) {
                let cx = sim.floor_div(x, sim.FP)
                let cy = sim.floor_div(y, sim.FP)
                let spread = if s.tick / 24 % 2 == 0 then 3 else 4
                at_world(s, t, mut g, cx - spread, cy - 2, "*", true)
                at_world(s, t, mut g, cx + spread, cy + 1, "*", true)
            }
        } else {
            world_prop(
                s,
                t,
                mut g,
                sim.floor_div(x, sim.FP),
                sim.floor_div(y, sim.FP),
                if cache == 0 then props.HOLLOW else props.BURROW,
                sim.cache_open(s, cache),
            )
        }
        if sim.pickup_near(s, x, y) && !s.den {
            draw.put_text(
                mut g,
                s.rows - 2,
                1,
                if sim.cache_open(s, cache) {
                    if s.area == forest.SHINGLE {
                        "The wrapping is empty; a bundle is in your pouch."
                    } else if cache == 0 {
                        "Old bones. Nothing here carries a scent."
                    } else {
                        "The burrow is empty; its herb is in your pouch."
                    }
                } else {
                    "r dig; the guards must be gone"
                },
                ink(t, true),
            )
        }
        cache += 1
    }
    for tr in s.trail {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(tr.x, sim.FP),
            sim.floor_div(tr.y, sim.FP),
            if tr.until - s.tick > 150 then ":" else ".",
            false,
        )
    }
    var den = 0
    while den < forest.DEN_LIMIT {
        if forest.den_area(den) == s.area {
            let (dx, dy) = forest.den_position(s.seed, den)
            draw_den(s, t, mut g, dx, dy)
            if sim.near(s.x, s.y, dx, dy, 10 * sim.FP) && !s.den {
                draw.put_text(
                    mut g,
                    2,
                    24,
                    forest.name(s.area) + " - a den ahead; scent of home",
                    ink(t, true),
                )
            }
        }
        den += 1
    }
    if s.area == forest.SHINGLE {
        world_prop(s, t, mut g, 0, sim.gate_y(s) - 3, props.THICKET, false)
    } else if s.area == forest.BRAMBLEHOLD {
        world_prop(s, t, mut g, 0, forest.LENGTH - 3, props.MEADOW, false)
        world_prop(s, t, mut g, 12, forest.BOAR_ROW - 2, props.BOAR, false)
        world_prop(s, t, mut g, -10, 24, props.EMBER, false)
        world_prop(s, t, mut g, -4, 18, props.BONES, false)
    } else if s.area == forest.LARKMEADOW {
        world_prop(s, t, mut g, 10, 24, props.TREE, false)
        world_prop(s, t, mut g, 0, forest.LENGTH - 3, props.CRAGS, false)
    } else if s.area == forest.CRAGS {
        world_prop(s, t, mut g, 0, forest.LENGTH - 3, props.RIVER, false)
        world_prop(s, t, mut g, 8, 30, props.TRACKS, false)
    } else if s.area == forest.RIVER {
        world_prop(s, t, mut g, 0, forest.LENGTH - 3, props.OLD_DEN, false)
    } else {
        world_prop(s, t, mut g, 0, 36, props.TRACKS, false)
    }
    var edge = 0
    while edge < forest.EDGES {
        if !forest.path_edge(edge) && forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if edge == 2 {
                draw_log(
                    mut g,
                    t,
                    sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s) - 1,
                    sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s) - 4,
                    false,
                )
            } else {
                world_prop(
                    s,
                    t,
                    mut g,
                    sim.floor_div(x, sim.FP),
                    sim.floor_div(y, sim.FP),
                    if edge == 3 {
                        props.HEDGE
                    } else if edge == 7 {
                        props.LEDGE
                    } else {
                        props.FORD
                    },
                    sim.shortcut_open(s, edge),
                )
            }
        }
        edge += 1
    }
    if s.mark &&
        s.mark_area == s.area &&
        sim.near(s.x, s.y, s.mark_x, s.mark_y, sim.scent_reach(s.nose) * sim.FP) {
        world_orb(s, t, mut g, s.mark_x, s.mark_y)
    }
    if s.pickup_area == s.area {
        glow.burst(
            mut g,
            t,
            sim.floor_div(s.pickup_y, sim.FP) - sim.cell_y(s) + sim.screen_row(s),
            sim.floor_div(s.pickup_x, sim.FP) - sim.cell_x(s) + sim.screen_col(s),
            s.tick - s.pickup_at,
        )
    }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        let fade = if f.health > 0 {
            -1
        } else if f.died >= 0 {
            s.tick - f.died
        } else {
            sim.BOSS_FADE_TICKS
        }
        let gone = if sim.is_boss(f.kind) then sim.BOSS_FADE_TICKS else sim.FOE_FADE_TICKS
        // Perception controls AI, never presentation. Drawing clips each cell.
        if fade < gone {
            let r = sim.floor_div(f.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let c = sim.floor_div(f.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            draw_foe(mut g, t, r, c, f.kind, f.phase, f.heading, fade)
            if s.locked == i { draw.put_text(mut g, r + 2, c, "[]", ink(t, true)) }
        }
        i += 1
    }
}

fn draw_posture(s: sim.Sim, t: int, mut g: grid.Grid) {
    let (ox, oy) = sim.attack_offset(s)
    let r = sim.screen_row(s) + sim.floor_div(s.y + oy, sim.FP) - sim.cell_y(s)
    let c = sim.screen_col(s) + sim.floor_div(s.x + ox, sim.FP) - sim.cell_x(s)
    // Health is the cub's gait, ears and tail (cb03, posture as HUD:
    // `silhouette.cub_posed`); cb01's health tail mark left with the bars.
    let posture = if s.action == sim.PARRY {
        "]"
    } else if s.action == sim.DODGE {
        "o"
    } else if s.action == sim.DRINK {
        "~"
    } else if s.action == sim.FALL {
        "_"
    } else if s.exhausted {
        ":"
    } else {
        ""
    }
    draw.put_text(mut g, r - 1, c + 5, posture, ink(t, true))
    let burst = sim.burst_age(s)
    if burst >= 0 {
        let (bx, by) = sim.burst_point(s)
        let x = sim.floor_div(bx, sim.FP)
        let y = sim.floor_div(by, sim.FP)
        let spread = if burst < 2 then 1 else 2
        at_world(s, t, mut g, x - spread, y - spread, if burst < 2 then "*" else ".", burst == 0)
        at_world(s, t, mut g, x + spread, y - spread, if burst < 2 then "*" else ".", burst == 0)
        at_world(s, t, mut g, x - spread, y + spread, if burst < 2 then "+" else ".", burst == 0)
        at_world(s, t, mut g, x + spread, y + spread, if burst < 2 then "+" else ".", burst == 0)
    }
    if sim.landing(s) {
        let (x, y) = sim.landing_point(s)
        at_world(s, t, mut g, sim.floor_div(x, sim.FP), sim.floor_div(y, sim.FP) + 1, "*", true)
    }
    if s.action == sim.FALL {
        // Thirty ticks: progressively erase the field in a deterministic dissolve.
        var row = 0
        while row < s.rows {
            var col = 0
            while col < s.cols {
                if (row * 7 + col * 11) % 30 < s.tick - s.started {
                    grid.put(mut g, row, col, grid.blank())
                }
                col += 1
            }
            row += 1
        }
        // The death card is one of the two places the numbers show
        // (R-cb03-3 A); the den is the other.
        draw.put_text(mut g, r, c - 4, "fallen - scent lost {s.mark_scent}", ink(t, false))
        draw.put_text(
            mut g,
            r + 2,
            c - 4,
            "health 0   stamina {s.stamina}   water {s.flasks}   scent {s.scent}",
            ink(t, false),
        )
    }
    if at_log_hint(s) {
        draw.put_text(
            mut g,
            s.rows - 1,
            1,
            "r rest at " + forest.den_name(sim.den_here(s)),
            ink(t, false),
        )
    }
}

fn at_log_hint(s: sim.Sim) -> bool { sim.at_den(s) && !s.den && s.action != sim.FALL }

/// Four poses of one silhouette, turned to the facing on the rich tier
/// (`silhouette.cub`), the same footprint in ASCII on the plain. `(row,
/// col)` is the cub's own cell; `legs` the paws' frame, `tail` the wag's
/// offset and `rising` its direction through the middle (the gait's,
/// `sim.legs` and `sim.tail_phase`). Every mark stays inside the rich
/// footprint, so the plain cub never covers a cell the rich one leaves.
/// `hurt` is the health band and `breath` the breath's frame (cb03,
/// posture as HUD: `sim.hurt_band`, `sim.breath`).
pub fn draw_pose(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    facing: int,
    band: int,
    pose: int,
    legs: int,
    tail: int,
    rising: bool,
    hurt: int,
    breath: int,
) {
    draw_pose_in(mut g, t, row, col, facing, fur(t, band), pose, legs, tail, rising, hurt, breath)
}

/// `draw_pose` in a given style (a ghost's grey, cb04).
pub fn draw_pose_in(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    facing: int,
    style: grid.Cell,
    pose: int,
    legs: int,
    tail: int,
    rising: bool,
    hurt: int,
    breath: int,
) {
    if t == tier.RICH {
        silhouette.draw_at(
            mut g,
            row,
            col,
            silhouette.cub_posed(pose, legs, tail, hurt, breath),
            facing,
            style,
        )
        return
    }
    let rows = plain_cub(facing, pose, tail, rising, hurt)
    let top = if facing % 2 == 0 then row - 1 else row
    let left = if facing % 2 == 0 then col - 1 else col - 3
    var i = 0
    while i < rows.len {
        put_over(mut g, top + i, left, rows[i], style)
        i += 1
    }
    if pose == 1 && facing % 2 == 0 {
        // The walk sets a hind paw out, one each half stride, at the
        // haunches' corner (inside the footprint, beside the tail).
        let paw_row = if facing == 0 then row + 2 else row - 1
        put_over(mut g, paw_row, if legs == 0 then col - 1 else col + 2, "'", style)
    }
}

/// The quarter a heading faces: 0 north, 1 east, 2 south, 3 west.
fn quarter(heading: int) -> int {
    ((heading + 32) % sim.TURN + sim.TURN) % sim.TURN / 64
}

/// Every foe is one solid silhouette on the rich tier, turned to its
/// heading, its tell a posture of the same drawing (`silhouette.foe`); the
/// plain tier keeps a head, body and tail in ASCII with the same footprint.
/// `(row, col)` is the foe's own cell.
pub fn draw_foe(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    kind: int,
    phase: int,
    heading: int,
    fade: int,
) {
    if sim.is_boss(kind) { draw_boss(mut g, t, row, col, kind, phase, heading, fade); return }
    if fade >= sim.FOE_FADE_TICKS { return }
    if kind == sim.HAWK { draw_hawk(mut g, t, row, col, phase, fade); return }
    let colour = if kind == sim.DEER {
        (if t == tier.RICH then 180 else 11)
    } else {
        sprites.palette(t, if kind == sim.FOX then sprites.C_FOX else sprites.C_WEASEL)
    }
    let style = grid.cell(32, colour, grid.COLOR_DEFAULT, if fade < 0 then grid.ATTR_BOLD else 0)
    if t == tier.RICH {
        silhouette.draw_at(
            mut g,
            row,
            col,
            silhouette.foe(kind, phase, fade),
            quarter(heading),
            style,
        )
        return
    }
    let rows = plain_foe(kind, phase, fade, quarter(heading))
    let h = rows.len
    let w = rows[0].len
    let top = row - (h - 1) / 2
    let left = col - (w - 1) / 2
    var i = 0
    while i < h {
        put_over(mut g, top + i, left, rows[i], style)
        i += 1
    }
}

/// The plain tier's foes in ASCII with the rich footprints: the weasel two
/// cells by three (six by one turned), the fox four by three and the deer
/// four by four (six by two and eight by two turned). The head leads; a
/// crouch flattens it to `_`, a stagger lifts `!`, a flight trails `~`, a
/// feint curls `?`, a strike thrusts `'`; the fade erodes the head at five
/// ticks and the body at ten.
fn plain_foe(kind: int, phase: int, fade: int, facing: int) -> List[str] {
    var rows = List[str]()
    let crouch = phase == sim.CROUCH || phase == sim.FEINT
    let deer = kind == sim.DEER
    let fox = kind == sim.FOX
    let weasel = kind == sim.WEASEL
    let head = if fade >= 5 {
        (if weasel then ".." else "....")
    } else if deer {
        "Y..Y"
    } else if crouch {
        (if weasel then "__" else "____")
    } else if phase == sim.STAGGER {
        (if weasel then "!!" else "!!!!")
    } else if fox {
        "/^^\\"
    } else {
        "oo"
    }
    let body = if fade >= 10 {
        (if weasel then ". " else " .. ")
    } else if weasel {
        "=="
    } else {
        "####"
    }
    let tail = if phase == sim.RETREAT {
        (if weasel then "~ " else " ~~ ")
    } else if phase == sim.FEINT {
        (if weasel then "? " else " ?? ")
    } else if deer {
        ".||."
    } else if fox {
        " /\\ "
    } else {
        ", "
    }
    if facing % 2 == 0 {
        let north = facing == 0
        (mut rows).push(if north then head else tail)
        if deer { (mut rows).push(if north then "(oo)" else "####") }
        (mut rows).push(if deer then (if north then "####" else "(oo)") else body)
        (mut rows).push(if north then tail else head)
        return rows
    }
    // East and west: the tail, the body and the head along the rows.
    let strike = phase == sim.STRIKE && !deer
    if weasel {
        let strip = if fade >= 10 {
            " .    "
        } else if fade >= 5 {
            ",==.. "
        } else if strike {
            ",==oo'"
        } else {
            ",==oo "
        }
        (mut rows).push(if facing == 1 then strip else reversed(strip))
        return rows
    }
    let top = if deer {
        ".=####Y."
    } else if fade >= 5 {
        "./###.."
    } else if strike {
        "./###^'"
    } else {
        "./###^."
    }
    let low = if deer {
        ",=####>."
    } else if fade >= 10 {
        ",. .  ."
    } else if strike {
        ",=###>'"
    } else {
        ",=###>."
    }
    (mut rows).push(if facing == 1 then top else reversed(top))
    (mut rows).push(if facing == 1 then low else reversed(low))
    rows
}

/// A string reversed, `<`, `>`, `/` and `\\` mirrored.
fn reversed(s: str) -> str {
    var out = ""
    var i = s.len
    while i > 0 {
        i -= 1
        let c = s[i..i + 1]
        out += if c == "<" {
            ">"
        } else if c == ">" {
            "<"
        } else if c == "/" {
            "\\"
        } else if c == "\\" {
            "/"
        } else {
            c
        }
    }
    out
}

/// Text in `style` over the ground, the ground's own background kept.
fn put_over(mut g: grid.Grid, row: int, col: int, text: str, style: grid.Cell) {
    var j = 0
    for b in text.bytes() {
        if b as int != 32 {
            var cell = copy style
            cell.cp = b as int
            cell.bg = grid.at(g, row, col + j).bg
            grid.put(mut g, row, col + j, cell)
        }
        j += 1
    }
}

/// Compact bars reserve eight cells each: the debug HUD's (`--hud`).
/// Compact text description; the rendered bars retain labels as a non-colour channel.
pub fn hud_text(s: sim.Sim) -> str { "health stamina scent {s.scent}" }

fn draw_hud(s: sim.Sim, t: int, mut g: grid.Grid) {
    let rich = t == tier.RICH
    let outline = if rich then 250 else 7
    let background = if rich then 235 else 0
    // The HUD owns its rectangle and one cell of right padding. Previously
    // only strokes were painted: world lettering could show through beside
    // the stamina bar (the c in "bones, no scent" at camera 22,27).
    draw.fill(mut g, 0, 0, 5, 23, grid.cell(32, outline, background, 0))
    // The progression HUD owns water charges at row 3, columns 24..48.
    draw.fill(mut g, 3, 23, 1, 26, grid.cell(32, outline, background, 0))
    if rich {
        var row = 0
        while row <= 4 {
            var col = 8
            while col <= 21 {
                let cp = if row % 2 == 1 then 9474 else if col == 8 {
                    if row == 0 then 9484 else if row == 2 then 9500 else 9492
                } else if col == 21 {
                    if row == 0 then 9488 else if row == 2 then 9508 else 9496
                } else {
                    9472
                }
                if row % 2 == 0 || col == 8 || col == 21 {
                    grid.put(mut g, row, col, grid.cell(cp, outline, background, 0))
                }
                col += 1
            }
            row += 1
        }
    }
    var bar = 0
    while bar < 2 {
        let row = if rich then 1 + bar * 2 else bar
        let value = if bar == 0 then s.health else s.stamina
        let maximum = if bar == 0 then sim.health_max(s.heart) else sim.stamina_max(s.wind)
        let colour = if rich then (if bar == 0 then 203 else 84) else (if bar == 0 then 12 else 10)
        draw.put_text(
            mut g,
            row,
            1,
            if bar == 0 then "health" else "stamina",
            grid.cell(32, outline, background, 0),
        )
        if !rich {
            grid.put(mut g, row, 8, grid.cell(91, outline, background, 0))
            grid.put(mut g, row, 21, grid.cell(93, outline, background, 0))
        }
        var i = 0
        while i < 12 {
            let filled = value > 0 && value * 12 > i * maximum
            grid.put(
                mut g,
                row,
                9 + i,
                grid.cell(
                    if filled then (if rich then 9608 else 61) else 32,
                    colour,
                    background,
                    0,
                ),
            )
            i += 1
        }
        bar += 1
    }
    draw.put_text(mut g, 1, 24, "scent {s.scent}", ink(t, true))
    draw_water(s, t, mut g)
}

/// Hazard-only thorn pair, disjoint from wall and label glyph/colour pairs.
pub fn thorn_cell(t: int, variant: int) -> grid.Cell {
    grid.cell(
        if t == tier.RICH {
            (if variant % 2 == 0 then 10478 else 10486)
        } else {
            (if variant % 2 == 0 then 37 else 38)
        },
        if t == tier.RICH then 196 else 12,
        if t == tier.RICH then 234 else 0,
        grid.ATTR_BOLD,
    )
}

/// Every exit and shortcut has this dim ground band, not a text label.
pub fn exit_shadow(t: int) -> grid.Cell {
    grid.cell(
        if t == tier.RICH then 183 else 46,
        if t == tier.RICH then 238 else 8,
        if t == tier.RICH then 232 else 0,
        0,
    )
}

fn world_lines(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.tick - s.entered < sim.ENTRY_TICKS {
        draw.put_text(mut g, 0, 24, forest.name(s.area), ink(t, true))
    }
    if s.den || s.action == sim.FALL { return }
    if s.area == forest.BRAMBLEHOLD && sim.near(s.x, s.y, -10 * sim.FP, 24 * sim.FP, 3 * sim.FP) {
        draw.put_text(
            mut g,
            s.rows - 2,
            1,
            "Ember: Keep out of the clearing. Old Snag hears the roots.",
            ink(t, true),
        )
    }
    var edge = 0
    while edge < forest.EDGES {
        if !forest.path_edge(edge) && forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if sim.near(s.x, s.y, x, y, 2 * sim.FP) {
                draw.put_text(mut g, s.rows - 1, 1, shortcut_hint(s, edge), ink(t, true))
            }
        }
        edge += 1
    }
}

/// The hawk's shadow on the ground at its cell: on the rich tier one
/// silhouette four cells across (`silhouette.hawk`: wings out circling,
/// spread wide at the stop, folded in the stoop, half open recovering);
/// the plain tier keeps its ASCII wings, body and shadow mark.
pub fn draw_hawk(mut g: grid.Grid, t: int, row: int, col: int, phase: int, fade: int) {
    if fade >= sim.FOE_FADE_TICKS { return }
    let style = grid.cell(
        32,
        if t == tier.RICH then 181 else 13,
        grid.COLOR_DEFAULT,
        if fade < 0 then grid.ATTR_BOLD else 0,
    )
    if t == tier.RICH {
        let posture = if phase == sim.CROUCH {
            1
        } else if phase == sim.STRIKE {
            2
        } else if phase == sim.RETREAT {
            3
        } else {
            0
        }
        // A connected bird: beak, wings, body, tail. The old one-row
        // diamond shadow was easy to mistake for a thrown boomerang.
        if fade < 5 { put_over(mut g, row - 2, col, "v", style) }
        silhouette.draw(mut g, row - 1, col - 1, silhouette.hawk(posture, fade), style)
        if fade < 10 { put_over(mut g, row, col, "O", style) }
        put_over(mut g, row + 1, col, if phase == sim.STRIKE then "|" else "v", style)
        return
    }
    let wings = if phase == sim.CROUCH {
        "\\_/"
    } else if phase == sim.STRIKE {
        " | "
    } else if phase == sim.RETREAT {
        "/v\\"
    } else {
        "-v-"
    }
    if fade < 5 { put_over(mut g, row - 2, col, "v", style) }
    put_over(mut g, row - 1, col - 1, if fade >= 5 then "..." else wings, style)
    if fade < 10 { put_over(mut g, row, col, "O", style) }
    put_over(mut g, row + 1, col, if phase == sim.STRIKE then "|" else "v", style)
}

/// Separate hawk study keeps every posture and fade readable on both tiers.
pub fn hawk_sheet(t: int) -> grid.Grid {
    var g = grid.new(12, 80)
    draw.put_text(
        mut g,
        1,
        1,
        "hawk: circle   stop     stoop    recover   fade0    fade5    fade10",
        ink(t, true),
    )
    var i = 0
    while i < 7 {
        draw_hawk(
            mut g,
            t,
            7,
            8 + i * 10,
            if i < 4 then i else sim.HUNT,
            if i < 4 then -1 else (i - 4) * 5,
        )
        i += 1
    }
    g
}

/// Original opening frames: the crossing, the break, the bank. Scene time
/// is simulation time; no renderer or wall clock can advance it.
pub fn opening_frame(s: sim.Sim, t: int, mut g: grid.Grid) {
    let age = s.tick - s.scene_started
    let frame = age / sim.SCENE_TICKS
    let style = grid.cell(
        32,
        if t == tier.RICH then 153 else 7,
        if t == tier.RICH then 17 else 4,
        0,
    )
    var row = 0
    while row < s.rows {
        var col = 0
        while col < s.cols {
            var cell = copy style
            if row > s.rows / 2 && (row * 7 + col + age / 6) % 9 == 0 {
                cell.cp = if t == tier.RICH then 8776 else 126
            }
            grid.put(mut g, row, col, cell)
            col += 1
        }
        row += 1
    }
    let mid = s.cols / 2
    if frame == 0 {
        var wolf = 0
        while wolf < 4 {
            draw_cub(mut g, t, s.rows / 2 - 2, mid - 18 + wolf * 10, 1, 0)
            wolf += 1
        }
        draw.put_text(mut g, 3, 4, "Late winter. The pack crosses the frozen Ashwater.", style)
        draw.put_text(mut g, 4, 4, "The smallest follows the tracks it knows.", style)
        draw.put_text(mut g, s.rows / 2 + 1, mid - 15, "_____  ______  ______  _____", style)
    } else if frame == 1 {
        draw.put_text(mut g, 3, 4, "The ice gives beneath the last of the line.", style)
        draw.put_text(mut g, 4, 4, "A cry, then water. The tracks are gone.", style)
        draw_cub(mut g, t, s.rows / 2 + 2, mid, 2, 2)
        draw.put_text(mut g, s.rows / 2, mid - 8, "__   _     __   _", style)
    } else {
        draw.put_text(
            mut g,
            3,
            4,
            "Dawn. Gravel beneath its paws. Its mother's scent gone cold.",
            style,
        )
        draw.put_text(mut g, 4, 4, "Home is upstream, and up.", style)
        draw_cub(mut g, t, s.rows / 2 - 2, mid, 0, 1)
        draw.put_text(mut g, s.rows / 2 + 1, mid - 8, ". , . , . , . , .", style)
    }
    draw.put_text(mut g, s.rows - 2, 4, "Any key skips; m mutes the music", style)
}

/// The line at a shortcut's mouth: how it opens, or that it is open.
fn shortcut_hint(s: sim.Sim, edge: int) -> str {
    if edge == 2 {
        if sim.shortcut_open(s, edge) {
            "r cross the fallen log"
        } else if s.area == forest.BRAMBLEHOLD {
            "r push the fallen log toward the bank"
        } else {
            "The log must be pushed from Bramblehold"
        }
    } else if edge == 3 {
        if sim.shortcut_open(s, edge) {
            "r crawl through the hedge"
        } else if s.area == forest.LARKMEADOW {
            "r dig under the hedge"
        } else {
            "The roots yield from the meadow side"
        }
    } else if edge == 7 {
        if sim.shortcut_open(s, edge) {
            "r jump the ledge"
        } else if s.area == forest.CRAGS {
            "The ledge is the lynx's; beat it and the way down is yours"
        } else {
            "A ledge too high to climb; the way round is through the Teeth"
        }
    } else if sim.shortcut_open(s, edge) {
        "r wade the shallows"
    } else if s.area == forest.RIVER {
        "The ford is the elk's; beat it and the shallows are yours"
    } else {
        "The current is too strong here; the ford is upstream"
    }
}

fn shade_exits(s: sim.Sim, t: int, mut g: grid.Grid) {
    var edge = 0
    while edge < forest.EDGES {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            let row = sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let col = sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            var dy = -1
            while dy <= 1 {
                var dx = -3
                while dx <= 3 { grid.put(mut g, row + dy, col + dx, exit_shadow(t)); dx += 1 }
                dy += 1
            }
        }
        edge += 1
    }
}

/// Original cut timber: hollow end grain for the den, a lengthwise passage
/// and direction marks for the fallen-log shortcut. Same footprint on both tiers.
pub fn draw_log(mut g: grid.Grid, t: int, row: int, col: int, hollow: bool) {
    let wood = grid.cell(
        32,
        sprites.palette(t, sprites.C_TRUNK),
        sprites.palette(t, sprites.C_GRAVEL),
        grid.ATTR_BOLD,
    )
    draw.put_text(mut g, row, col + 1, "_==_==_", wood)
    draw.put_text(mut g, row + 1, col, if hollow then "(O)===//)" else "<o=====o>", wood)
    draw.put_text(mut g, row + 2, col + 1, "_--_---", wood)
    if t == tier.RICH {
        var grain = copy wood
        grain.cp = 9617
        grid.put(mut g, row, col + 2, grain)
        grid.put(mut g, row, col + 3, grain)
        grid.put(mut g, row, col + 5, grain)
        grid.put(mut g, row, col + 6, grain)
        grid.put(mut g, row + 2, col + 1, grain)
        grid.put(mut g, row + 2, col + 4, grain)
    }
}

/// Wrapped cache treasure; its opened form leaves only the loose binding.
/// Inventory identity is the existing finite Shingle cache bits. Rich: one
/// solid silhouette five cells by three (`silhouette.bundle`); plain: the
/// knot, the cord's cross and the binding in ASCII.
pub fn draw_bundle(mut g: grid.Grid, t: int, row: int, col: int, opened: bool) {
    let cloth = if opened {
        ink(t, false)
    } else {
        grid.cell(
            32,
            if t == tier.RICH then 229 else 15,
            sprites.palette(t, sprites.C_GRAVEL),
            grid.ATTR_BOLD,
        )
    }
    if t == tier.RICH {
        var style = copy cloth
        style.bg = grid.COLOR_DEFAULT
        silhouette.draw(mut g, row, col, silhouette.bundle(opened), style)
        return
    }
    if opened {
        draw.put_text(mut g, row + 2, col, "_x___", cloth)
        return
    }
    draw.put_text(mut g, row, col + 1, "\\|/", cloth)
    draw.put_text(mut g, row + 1, col, "(:X:)", cloth)
    draw.put_text(mut g, row + 2, col + 1, "---", cloth)
}

/// Five original shore finds, each five cells wide and two rows tall.
pub fn draw_flotsam(mut g: grid.Grid, t: int, row: int, col: int, kind: int) {
    let wood = grid.cell(
        32,
        if kind == 2 || kind == 3 {
            sprites.palette(t, sprites.C_REED)
        } else {
            sprites.palette(t, sprites.C_TRUNK)
        },
        sprites.palette(t, sprites.C_GRAVEL),
        0,
    )
    let top = if kind == 0 {
        " __/ "
    } else if kind == 1 {
        "/X_/|"
    } else if kind == 2 {
        "~v~v "
    } else if kind == 3 {
        "  _! "
    } else {
        "/x/x/"
    }
    let bottom = if kind == 0 {
        "==/=="
    } else if kind == 1 {
        "|_/ /"
    } else if kind == 2 {
        " v~v~"
    } else if kind == 3 {
        " (__)"
    } else {
        "x/x/~"
    }
    draw.put_text(mut g, row, col, top, wood)
    draw.put_text(mut g, row + 1, col, bottom, wood)
    if t == tier.RICH {
        var face = copy wood
        face.cp = if kind == 2 then 10294 else if kind == 3 then 9617 else 183
        grid.put(mut g, row + 1, col + 2, face)
    }
}

fn shore_finds(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.area != forest.SHINGLE { return }
    // Finds lie along the whole shore, eleven cells a slot, the seed
    // jittering each; none within eight cells of the spawn.
    let reach = forest.coast_extent(s.field)
    var slot = 0
    while slot * 11 < 2 * reach - 10 {
        let x = 4 - reach + slot * 11 + terrain.variant(s.seed, slot, 211, 3)
        let y = terrain.bank(s.seed, x) + terrain.REED_ROWS + 1
        var clear = x < -8 || x > 7
        var dx = 0
        while dx < 5 {
            var dy = 0
            while dy < 2 {
                if forest.kind(s.seed, s.field, s.area, x + dx, y + dy) != terrain.GRAVEL {
                    clear = false
                }
                dy += 1
            }
            dx += 1
        }
        if clear {
            draw_flotsam(
                mut g,
                t,
                y - sim.cell_y(s) + sim.screen_row(s),
                x - sim.cell_x(s) + sim.screen_col(s),
                (slot + terrain.variant(s.seed, 211, 0, 5)) % 5,
            )
        }
        slot += 1
    }
}

/// Both-tier coast study: logs, all five shore finds, full and empty bundles.
pub fn coast_sheet(t: int) -> grid.Grid {
    var g = grid.new(20, 80)
    var row = 0
    while row < g.rows {
        var col = 0
        while col < g.cols {
            grid.put(mut g, row, col, sprites.glyph(t, sprites.SP_GRAVEL, 0))
            col += 1
        }
        row += 1
    }
    draw.put_text(mut g, 1, 2, "hollow log      fallen log       bundle       opened", ink(t, true))
    draw_log(mut g, t, 3, 3, true)
    draw_log(mut g, t, 3, 19, false)
    draw_bundle(mut g, t, 3, 37, false)
    draw_bundle(mut g, t, 3, 50, true)
    draw.put_text(
        mut g,
        8,
        2,
        "driftwood    crate        kelp         bottle       net",
        ink(t, true),
    )
    var kind = 0
    while kind < 5 { draw_flotsam(mut g, t, 10, 4 + kind * 13, kind); kind += 1 }
    draw.put_text(mut g, 15, 2, "stone in water / forest beyond the bank", ink(t, true))
    var col = 3
    while col < 70 {
        grid.put(
            mut g,
            17,
            col,
            sprites.glyph(
                t,
                if col < 12 {
                    sprites.SP_ROCK
                } else if col < 35 {
                    sprites.SP_WATER
                } else {
                    sprites.SP_DARK
                },
                col % 4,
            ),
        )
        col += 1
    }
    g
}

// The bosses, the ghosts, the title and the end (cb04).

/// A boss's colour on a tier: the boar's bristle brown, the lynx's tawny
/// coat, the elk's grey, the alpha's smoke (`docs/PALETTE.md`).
fn boss_colour(t: int, kind: int) -> int {
    if t == tier.RICH {
        return match kind {
            4 => 130,
            5 => 179,
            6 => 145,
            _ => 244,
        }
    }
    match kind {
        4 => 1,
        5 => 3,
        6 => 7,
        _ => 8,
    }
}

/// A boss at its cell: on the rich tier one solid silhouette turned to its
/// heading, its tell a posture of the drawing (`silhouette.boss`), the
/// alpha's red eyes over it; the plain tier a head, body and tail in ASCII
/// in the same footprint. A beaten boss fades over forty-five ticks.
pub fn draw_boss(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    kind: int,
    phase: int,
    heading: int,
    fade: int,
) {
    if fade >= sim.BOSS_FADE_TICKS { return }
    let style = grid.cell(
        32,
        boss_colour(t, kind),
        grid.COLOR_DEFAULT,
        if fade < 0 && kind != sim.ALPHA then grid.ATTR_BOLD else 0,
    )
    let facing = quarter(heading)
    if t == tier.RICH {
        silhouette.draw_at(mut g, row, col, silhouette.boss(kind, phase, fade), facing, style)
    } else {
        let rows = plain_boss(kind, phase, fade, facing)
        let (w, h) = silhouette.foe_size(kind)
        let (dc, dr, _, _) = silhouette.footprint(w, h, facing)
        var i = 0
        while i < rows.len {
            put_over(mut g, row + dr + i, col + dc, rows[i], style)
            i += 1
        }
    }
    if kind == sim.ALPHA && fade < 15 {
        // Two red eyes at the head's sides, whichever way it faces.
        let (w, h) = silhouette.foe_size(kind)
        let (dc, dr, cols, rows) = silhouette.footprint(w, h, facing)
        var eyes = List[int]()
        if facing == 0 {
            (mut eyes).push(row + dr + 1)
            (mut eyes).push(col + dc + 1)
            (mut eyes).push(row + dr + 1)
            (mut eyes).push(col + dc + cols - 2)
        } else if facing == 2 {
            (mut eyes).push(row + dr + rows - 2)
            (mut eyes).push(col + dc + 1)
            (mut eyes).push(row + dr + rows - 2)
            (mut eyes).push(col + dc + cols - 2)
        } else if facing == 1 {
            (mut eyes).push(row + dr)
            (mut eyes).push(col + dc + cols - 2)
            (mut eyes).push(row + dr + rows - 1)
            (mut eyes).push(col + dc + cols - 2)
        } else {
            (mut eyes).push(row + dr)
            (mut eyes).push(col + dc + 1)
            (mut eyes).push(row + dr + rows - 1)
            (mut eyes).push(col + dc + 1)
        }
        var k = 0
        while k < 4 {
            var cell = grid.at(g, eyes[k], eyes[k + 1])
            cell.cp = if t == tier.RICH then sprites.CP_EYE else 111
            cell.fg = if t == tier.RICH then 196 else 9
            cell.attrs = grid.ATTR_BOLD
            grid.put(mut g, eyes[k], eyes[k + 1], cell)
            k += 2
        }
    }
}

/// The plain tier's bosses in ASCII with the rich footprints (the boar six
/// cells by six north, twelve by three east; the lynx five by five, ten by
/// three; the elk seven by seven, fourteen by four; the alpha six by six,
/// twelve by three). The head leads: a windup lowers it to `_`, a strike
/// thrusts `'`, a stagger lifts `!`, the alpha's guard `]`; the fade erodes
/// the head at fifteen ticks and the body at thirty.
fn plain_boss(kind: int, phase: int, fade: int, facing: int) -> List[str] {
    let (w, h) = silhouette.foe_size(kind)
    let (_, _, cols, rows) = silhouette.footprint(w, h, facing)
    let windup = phase == sim.CROUCH
    let strike = phase == sim.STRIKE
    let stagger = phase == sim.STAGGER
    let guard = phase == sim.FOE_PARRY
    let mark = if fade >= 15 {
        "."
    } else if windup {
        "_"
    } else if strike {
        "'"
    } else if stagger {
        "!"
    } else if guard {
        "]"
    } else if kind == sim.BOAR {
        "o"
    } else if kind == sim.LYNX {
        "^"
    } else if kind == sim.ELK {
        "Y"
    } else {
        "o"
    }
    let body = if fade >= 30 then "." else "#"
    var out = List[str]()
    if facing % 2 == 0 {
        var r = 0
        while r < rows {
            var line = ""
            var c = 0
            while c < cols {
                let head_row = if facing == 0 then r == 0 else r == rows - 1
                let tail_row = if facing == 0 then r == rows - 1 else r == 0
                line += if head_row {
                    (if c == 0 || c == cols - 1 then " " else mark)
                } else if tail_row {
                    (if c == cols / 2 then (if phase == sim.RETREAT then "~" else ",") else " ")
                } else if c == 0 || c == cols - 1 {
                    (if r == 1 || r == rows - 2 then " " else body)
                } else {
                    body
                }
                c += 1
            }
            (mut out).push(line)
            r += 1
        }
        return out
    }
    var r = 0
    while r < rows {
        var line = ""
        var c = 0
        while c < cols {
            let head_col = if facing == 1 then c >= cols - 2 else c <= 1
            let tail_col = if facing == 1 then c == 0 else c == cols - 1
            line += if head_col {
                (if r == rows / 2 then mark else " ")
            } else if tail_col {
                (if r == rows / 2 then "," else " ")
            } else if r == 0 || r == rows - 1 {
                (if c % 3 == 0 then " " else body)
            } else {
                body
            }
            c += 1
        }
        (mut out).push(line)
        r += 1
    }
    out
}

/// The wolf the cub becomes (cb04): rich, `silhouette.wolf` turned to the
/// facing; plain, a six-by-six ASCII body (twelve by three turned).
pub fn draw_wolf(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    facing: int,
    band: int,
    pose: int,
    legs: int,
) {
    let style = fur(t, band)
    if t == tier.RICH {
        silhouette.draw_at(mut g, row, col, silhouette.wolf(pose, legs), facing, style)
        return
    }
    let (w, h) = silhouette.wolf_size()
    let (dc, dr, cols, rows) = silhouette.footprint(w, h, facing)
    var r = 0
    while r < rows {
        var line = ""
        var c = 0
        while c < cols {
            line += if facing % 2 == 0 {
                let head = if facing == 0 then r == 0 else r == rows - 1
                let tail = if facing == 0 then r == rows - 1 else r == 0
                if head {
                    (if c == 1 || c == cols - 2 then "^" else " ")
                } else if tail {
                    (if c == cols / 2 then "," else " ")
                } else if c == 0 || c == cols - 1 {
                    (if r == 2 || r == 3 then "#" else " ")
                } else {
                    "#"
                }
            } else {
                let head = if facing == 1 then c == cols - 1 else c == 0
                let tail = if facing == 1 then c == 0 else c == cols - 1
                if head {
                    (if r == rows / 2 then (if facing == 1 then ">" else "<") else " ")
                } else if tail {
                    (if r == rows / 2 then "," else " ")
                } else if r == 0 || r == rows - 1 {
                    (if c == 2 || c == cols - 3 then "^" else "=")
                } else {
                    "#"
                }
            }
            c += 1
        }
        put_over(mut g, row + dr + r, col + dc, line, style)
        r += 1
    }
}

/// The boss's health bar (R-cb04-2 A): a line under the boss's name while
/// the cub stands in the arena and the boss lives, the one number-like
/// element the HUD allows beside the scent counter; `!` marks the second
/// phase.
fn draw_boss_bar(s: sim.Sim, t: int, mut g: grid.Grid) {
    let i = sim.boss_index(s)
    if i < 0 { return }
    let f = copy s.foes[i]
    // The bar is the boss's, shown while it is engaged (R-cb04-2 A): the
    // cub at the arena's mouth under a charge sees it too.
    if !f.engaged || f.health <= 0 { return }
    let text = boss_bar_text(f)
    let left = if (s.cols - text.len) / 2 < 43 then 43 else (s.cols - text.len) / 2
    draw.put_text(mut g, 1, left, text, ink(t, true))
    // The filled cells in the boss's colour.
    let filled = f.health * 20 / sim.foe_health(f.kind)
    var k = 0
    while k < filled {
        var cell = grid.at(g, 1, left + sim.boss_name(f.kind).len + 2 + k)
        cell.fg = boss_colour(t, f.kind)
        grid.put(mut g, 1, left + sim.boss_name(f.kind).len + 2 + k, cell)
        k += 1
    }
}

/// The bar's text: the name, twenty cells of `#` and `.`, the phase mark.
pub fn boss_bar_text(f: sim.Foe) -> str {
    let filled = f.health * 20 / sim.foe_health(f.kind)
    var bar = sim.boss_name(f.kind) + " ["
    var k = 0
    while k < 20 {
        bar += if k < filled then "#" else "."
        k += 1
    }
    bar + "]" + (if sim.phase_two(f) then " !" else "")
}

/// A ghost's grey by rank (0 the newest), rich and plain: fading by age
/// (R-cb04-1 A).
fn ghost_style(t: int, rank: int) -> grid.Cell {
    if t == tier.RICH {
        let shade = match rank {
            0 => 251,
            1 => 248,
            2 => 245,
            3 => 242,
            _ => 239,
        }
        return grid.cell(32, shade, grid.COLOR_DEFAULT, grid.ATTR_DIM)
    }
    grid.cell(
        32,
        if rank == 0 then 7 else 8,
        grid.COLOR_DEFAULT,
        if rank == 0 then grid.ATTR_BOLD else 0,
    )
}

/// The ghosts of the area: a dim silhouette lying at each death's spot
/// (the plain tier an `x`), and when the cub is near one, that death's
/// last seconds replayed as a ghost moving through the world, driven by
/// the file's trailer alone (`ghost.playing`).
fn draw_ghosts(s: sim.Sim, set: ghost.Set, t: int, mut g: grid.Grid) {
    var rank = 0
    while rank < set.ghosts.len {
        let gh = copy set.ghosts[rank]
        if gh.area == s.area {
            let style = ghost_style(t, rank)
            let r = sim.floor_div(gh.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let c = sim.floor_div(gh.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            if t == tier.RICH {
                silhouette.draw_at(mut g, r, c, silhouette.cub(0, 0, 0), gh.facing, style)
            } else {
                put_over(mut g, r, c, "x", style)
            }
            if sim.near(s.x, s.y, gh.x, gh.y, ghost.NEAR * sim.FP) {
                let i = ghost.playing(gh, s.tick)
                if i >= 0 {
                    let f = copy gh.frames[i]
                    let fr = sim.floor_div(f.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
                    let fc = sim.floor_div(f.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
                    draw_pose_in(
                        mut g,
                        t,
                        fr,
                        fc,
                        f.facing,
                        style,
                        if f.pose == 4 then 0 else f.pose,
                        i % 2,
                        0,
                        true,
                        0,
                        0,
                    )
                }
            }
        }
        rank += 1
    }
}

/// The title (cb04): over the demo's world when it plays (after ten idle
/// seconds) or the opening's river, the game's name, the four bosses as
/// silhouettes lit where the save says beaten, the keys, and the word that
/// begins.
fn title_frame(s: sim.Sim, extra: Extra, t: int, mut g: grid.Grid) {
    if extra.demo_on && extra.demo.len > 0 {
        render_with(extra.demo[0], extra_none(), t, mut g)
    } else {
        let style = grid.cell(
            32,
            if t == tier.RICH then 153 else 7,
            if t == tier.RICH then 17 else 4,
            0,
        )
        var row = 0
        while row < s.rows {
            var col = 0
            while col < s.cols {
                var cell = copy style
                if (row * 7 + col + s.tick / 6) % 9 == 0 {
                    cell.cp = if t == tier.RICH then 8776 else 126
                }
                grid.put(mut g, row, col, cell)
                col += 1
            }
            row += 1
        }
    }
    let top = (s.rows - 22) / 2
    let mid = s.cols / 2
    let bright = ink(t, true)
    let dim = ink(t, false)
    // A dark band for the card, so it reads over the demo.
    draw.fill(mut g, top, mid - 36, 22, 72, grid.cell(32, bright.fg, bright.bg, 0))
    draw.put_text(mut g, top + 1, mid - 9, "c  u  b", bright)
    draw.put_text(mut g, top + 2, mid - 24, "a cub finds its way home through Thornmere", dim)
    // The four bosses, lit when beaten: the boar, the lynx, the elk, the
    // alpha, their names under them.
    var k = 0
    while k < 4 {
        let kind = sim.BOAR + k
        let beaten = s.bosses / sim.boss_bit(kind) % 2 == 1
        let col = mid - 27 + k * 18
        let style = if beaten {
            grid.cell(32, boss_colour(t, kind), bright.bg, grid.ATTR_BOLD)
        } else {
            grid.cell(32, if t == tier.RICH then 240 else 8, bright.bg, 0)
        }
        if t == tier.RICH {
            silhouette.draw_at(mut g, top + 7, col + 3, silhouette.boss(kind, 0, -1), 0, style)
        } else {
            let rows = plain_boss(kind, sim.HUNT, -1, 0)
            let (w, h) = silhouette.foe_size(kind)
            let (dc, dr, _, _) = silhouette.footprint(w, h, 0)
            var i = 0
            while i < rows.len {
                put_over(mut g, top + 7 + dr + i, col + 3 + dc, rows[i], style)
                i += 1
            }
        }
        draw.put_text(
            mut g,
            top + 12,
            col,
            sim.boss_name(kind),
            if beaten then copy bright else copy dim,
        )
        draw.put_text(mut g, top + 13, col, if beaten then "beaten" else "      ", dim)
        k += 1
    }
    draw.put_text(
        mut g,
        top + 15,
        mid - 34,
        "arrows walk   Shift+arrow sneak   Space bite   x lunge   s heavy",
        dim,
    )
    draw.put_text(
        mut g,
        top + 16,
        mid - 34,
        "z parry   c dodge   Tab lock   w water   r rest   q quit",
        dim,
    )
    draw.put_text(mut g, top + 18, mid - 7, "any key begins", bright)
    draw.put_text(
        mut g,
        top + 20,
        mid - 20,
        if s.end {
            "the pack is home; the forest is yours to roam"
        } else if s.opening_seen {
            "the journey resumes at " + forest.den_name(s.last_den)
        } else {
            "a new journey; the first night is the hardest"
        },
        dim,
    )
}

/// The end (cb04): the ford at dawn seen from the far bank, the wolf that
/// crosses (three frames of ninety ticks), then the card with the run's
/// numbers (time, deaths, scent lost, bosses) and `r` to keep playing
/// (R-cb04-4 A).
fn end_frame(s: sim.Sim, t: int, mut g: grid.Grid) {
    let age = s.tick - s.scene_started
    let dawn = grid.cell(32, if t == tier.RICH then 180 else 7, if t == tier.RICH then 17 else 4, 0)
    let mid = s.cols / 2
    if age < sim.END_CARD_AT {
        // The Ashwater across the middle, the far bank above, the near below.
        var row = 0
        while row < s.rows {
            var col = 0
            while col < s.cols {
                let cell = if row < s.rows / 3 {
                    kind_cell(
                        forest.SHINGLE,
                        t,
                        terrain.GRAVEL,
                        if (row * 11 + col * 3) % 7 == 0 then 1 + (row + col) % 3 else 0,
                        0,
                    )
                } else if row < s.rows * 2 / 3 {
                    sprites.glyph(
                        t,
                        if col > mid - 12 && col < mid + 12 {
                            sprites.SP_SHALLOWS
                        } else {
                            sprites.SP_WATER
                        },
                        if (row * 31 + col * 17 + age / 6) % 5 == 0 then 1 + (row + col) % 3 else 0,
                    )
                } else {
                    kind_cell(
                        forest.SHINGLE,
                        t,
                        terrain.GRAVEL,
                        if (row * 5 + col * 13) % 7 == 0 then 1 + (row + col) % 3 else 0,
                        0,
                    )
                }
                grid.put(mut g, row, col, cell)
                col += 1
            }
            row += 1
        }
        // The pack on the far bank, four wolves facing the river.
        var k = 0
        while k < 4 {
            draw_wolf(mut g, t, s.rows / 6, mid - 24 + k * 14, 2, 0, 0, 0)
            k += 1
        }
        // The wolf: at the near bank, then crossing, then among the pack.
        let frame = age / sim.SCENE_TICKS
        let near_row = s.rows * 5 / 6
        let far_row = s.rows / 6 + 8
        let r = if frame == 0 {
            near_row
        } else if frame == 1 {
            near_row - (near_row - far_row) * (age - sim.SCENE_TICKS) / sim.SCENE_TICKS
        } else {
            far_row
        }
        draw_wolf(mut g, t, r, mid, 0, 0, if frame == 1 then 1 else 0, age / 6 % 2)
        draw.put_text(
            mut g,
            2,
            4,
            if frame == 0 {
                "Dawn at Moonford. On the far bank, the pack is waiting."
            } else if frame == 1 {
                "It is not a cub any more that crosses."
            } else {
                "The pack howls. Home."
            },
            dawn,
        )
        draw.put_text(mut g, s.rows - 2, 4, "Any key", dawn)
        return
    }
    // The card.
    var row = 0
    while row < s.rows {
        var col = 0
        while col < s.cols {
            grid.put(mut g, row, col, dawn)
            col += 1
        }
        row += 1
    }
    let top = s.rows / 2 - 6
    let style = ink(t, true)
    let soft = ink(t, false)
    draw.fill(mut g, top, mid - 22, 12, 44, grid.cell(32, style.fg, style.bg, 0))
    draw.put_text(mut g, top + 1, mid - 2, "Home", style)
    let secs = sim.played_ticks(s) / 30
    let mins = secs / 60
    let rest = secs % 60
    draw.put_text(
        mut g,
        top + 3,
        mid - 18,
        "time        {mins}:{if rest < 10 then "0" else ""}{rest}",
        soft,
    )
    draw.put_text(mut g, top + 4, mid - 18, "deaths      {s.deaths}", soft)
    draw.put_text(mut g, top + 5, mid - 18, "scent lost  {s.lost}", soft)
    var beaten = 0
    var k = 0
    while k < 4 {
        if s.bosses / sim.boss_bit(sim.BOAR + k) % 2 == 1 { beaten += 1 }
        k += 1
    }
    draw.put_text(mut g, top + 6, mid - 18, "bosses      {beaten} of 4", soft)
    draw.put_text(mut g, top + 8, mid - 18, "The forest is yours to roam, a wolf now.", soft)
    draw.put_text(mut g, top + 10, mid - 18, "r keeps playing; q leaves", style)
}

/// The boss study: every boss in every posture and three fade stages,
/// north, and the east form of each, on both tiers (`docs/ART.md`).
pub fn boss_sheet(t: int) -> grid.Grid {
    var g = grid.new(60, 100)
    var row = 0
    while row < g.rows {
        var col = 0
        while col < g.cols {
            grid.put(mut g, row, col, sprites.glyph(t, sprites.SP_GRAVEL, 0))
            col += 1
        }
        row += 1
    }
    var k = 0
    while k < 4 {
        let kind = sim.BOAR + k
        let top = 1 + k * 15
        draw.put_text(
            mut g,
            top,
            1,
            sim.boss_name(kind) +
                ":  hunt     windup   strike   recover  stagger  guard    hop      fade15   fade30   east",
            ink(t, true),
        )
        var i = 0
        while i < 9 {
            let phase = if i < 5 {
                i
            } else if i == 5 {
                sim.FOE_PARRY
            } else if i == 6 {
                sim.FOE_DODGE
            } else {
                sim.HUNT
            }
            let fade = if i == 7 then 15 else if i == 8 then 30 else -1
            draw_boss(mut g, t, top + 6, 13 + i * 9, kind, phase, 0, fade)
            i += 1
        }
        draw_boss(mut g, t, top + 6, 92, kind, sim.HUNT, 64, -1)
        k += 1
    }
    g
}

/// The wolf study: the wolf standing and walking in the four facings, the
/// cub beside it for the size (`docs/ART.md`).
pub fn wolf_sheet(t: int) -> grid.Grid {
    var g = grid.new(14, 80)
    var row = 0
    while row < g.rows {
        var col = 0
        while col < g.cols {
            grid.put(mut g, row, col, sprites.glyph(t, sprites.SP_GRAVEL, 0))
            col += 1
        }
        row += 1
    }
    draw.put_text(
        mut g,
        1,
        1,
        "wolf:  N          E              S          W              cub",
        ink(t, true),
    )
    draw_wolf(mut g, t, 7, 9, 0, 0, 0, 0)
    draw_wolf(mut g, t, 7, 24, 1, 0, 1, 0)
    draw_wolf(mut g, t, 7, 42, 2, 0, 0, 0)
    draw_wolf(mut g, t, 7, 57, 3, 0, 1, 1)
    draw_cub(mut g, t, 7, 72, 0, 0)
    g
}

/// A warm hollow, its ember and a breathing smoke wisp; never a label alone.
pub fn draw_den(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int) {
    let row = sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
    let col = sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
    let warm = if t == tier.RICH then 94 else 3
    let ember = if t == tier.RICH then 208 else 9
    var dy = -1
    while dy <= 2 {
        var dx = -3
        while dx <= 3 {
            grid.put(
                mut g,
                row + dy,
                col + dx,
                grid.cell(46, warm, if t == tier.RICH then 52 else 0, 0),
            )
            dx += 1
        }
        dy += 1
    }
    let style = grid.cell(32, warm, if t == tier.RICH then 52 else 0, grid.ATTR_BOLD)
    draw.put_text(mut g, row - 1, col - 3, "_.---._", style)
    draw.put_text(mut g, row, col - 3, "(     )", style)
    draw.put_text(mut g, row + 1, col - 3, "(_   _)", style)
    grid.put(
        mut g,
        row + 1,
        col,
        grid.cell(
            if s.tick / 6 % 2 == 0 then 42 else 111,
            ember,
            if t == tier.RICH then 52 else 0,
            grid.ATTR_BOLD,
        ),
    )
    grid.put(
        mut g,
        row - 2,
        col + s.tick / 15 % 2,
        grid.cell(126, if t == tier.RICH then 137 else 7, if t == tier.RICH then 234 else 0, 0),
    )
}

/// Trees and landmarks are placed only off the carved routes; the roots alone collide.
pub fn meadow_finds(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.area != forest.LARKMEADOW { return }
    var row = 0
    while row < s.rows {
        var col = 0
        while col < s.cols {
            let (x, y) = sim.world_cell(s, row, col)
            let (ax, ay, kind) = meadow.anchor(s.seed, x, y)
            if ay >= 6 &&
                ay < forest.LENGTH - 4 &&
                ax > -forest.half_width(s.field) + 4 &&
                ax < forest.half_width(s.field) - 4 &&
                !forest.on_path(s.seed, s.field, s.area, ax, ay) {
                var dx = x - ax + 1
                if kind == 1 {
                    if x < ax - 1 { dx += 3 }
                    if x > ax + 2 { dx -= 3 }
                }
                let line = y - ay + 2
                if dx >= 0 &&
                    dx < 4 &&
                    line >= 0 &&
                    line < 3 &&
                    !forest.on_path(s.seed, s.field, s.area, x, y) {
                    let lifted = sim.near(s.x, s.y, ax * sim.FP, ay * sim.FP, 5 * sim.FP)
                    let text = meadow.row(kind, line, lifted)
                    let cp = text.bytes()[dx] as int
                    if cp != 32 {
                        grid.put(
                            mut g,
                            row,
                            col,
                            grid.cell(
                                if t == tier.RICH && cp == 124 then 9475 else cp,
                                if t == tier.RICH {
                                    (if kind == 3 then 180 else 59)
                                } else {
                                    (if kind == 3 then 7 else 8)
                                },
                                if t == tier.RICH then 235 else 0,
                                0,
                            ),
                        )
                    }
                }
            }
            col += 1
        }
        row += 1
    }
}

/// Both-tier landmark atlas: each original drawing, including the lifted flock.
pub fn meadow_sheet(t: int) -> grid.Grid {
    var g = grid.new(12, 64)
    var k = 0
    while k < 8 {
        var line = 0
        while line < 3 {
            var x = 0
            let text = meadow.row(k, line, false)
            while x < 4 {
                let cp = text.bytes()[x] as int
                grid.put(
                    mut g,
                    2 + line,
                    k * 8 + x,
                    grid.cell(
                        if t == tier.RICH && cp == 124 then 9475 else cp,
                        if t == tier.RICH then 59 else 8,
                        if t == tier.RICH then 235 else 0,
                        0,
                    ),
                )
                x += 1
            }
            line += 1
        }
        draw.put_text(mut g, 0, k * 8, "{k}", ink(t, true))
        k += 1
    }
    draw.put_text(mut g, 8, 0, "v^v^  lifted crows       ~~~ creek / path ford", ink(t, true))
    g
}

/// Draw a meat pickup at screen-cell row/column. The simulation owns its
/// spawn/heal/expiry; this pure helper owns both-tier shape and idle glint.
pub fn draw_meat(mut g: grid.Grid, t: int, row: int, col: int, tick: int) {
    glow.meat(mut g, t, row, col, tick)
}

/// Draw a spring at screen-cell row/column, bright while available and an
/// empty basin once learned. No dependency on the progression lane's fields.
pub fn draw_spring(mut g: grid.Grid, t: int, row: int, col: int, tick: int, available: bool) {
    glow.spring(mut g, t, row, col, tick, available)
}

/// The healing-pickup study: two idle phases, plus the spring's empty form.
pub fn healing_sheet(t: int, spring: bool) -> grid.Grid {
    var g = grid.new(12, 60)
    grid.fill(mut g, grid.cell(32, 7, if t == tier.RICH then 234 else 0, 0))
    if spring {
        draw_spring(mut g, t, 6, 10, 0, true)
        draw_spring(mut g, t, 6, 30, 24, true)
        draw_spring(mut g, t, 6, 50, 0, false)
    } else {
        draw_meat(mut g, t, 6, 15, 0)
        draw_meat(mut g, t, 6, 45, 24)
    }
    g
}

fn den_menu(s: sim.Sim, t: int, mut g: grid.Grid) {
    let style = grid.cell(
        32,
        if t == tier.PLAIN then 7 else 250,
        restscene.background(s.area, t),
        0,
    )
    let row = s.rows - 10
    draw.put_text(
        mut g,
        row,
        3,
        "health {s.health}   stamina {s.stamina}   water {s.flasks}/{s.flask_max}",
        style,
    )
    draw.put_text(
        mut g,
        row + 1,
        3,
        "Level {sim.level(s)}    Scent {s.scent}    Next level {sim.level_cost(sim.level(s))}",
        style,
    )
    var stat = 0
    while stat < 5 {
        let name = match stat {
            0 => "Heart / health",
            1 => "Wind / stamina",
            2 => "Fang / bite",
            3 => "Paw / pace FP",
            _ => "Nose / scent cells",
        }
        let value = sim.stat_value(s, stat)
        let now = sim.stat_effect(stat, value)
        let next = sim.stat_effect(stat, value + 1)
        let effect = if value >= sim.STAT_MAX then "capped" else "{now} -> {next}"
        draw.put_text(mut g, row + 3 + stat, 3, "{stat + 1}  {name}  {value}   {effect}", style)
        stat += 1
    }
    draw.put_text(mut g, row + 8, 3, "1-5 spend scent    r / Esc leave", style)
    draw.put_text(
        mut g,
        row + 9,
        3,
        if s.save_status == 1 {
            "Saving journey..."
        } else if s.save_status == 2 {
            "Journey saved"
        } else {
            "Resting"
        },
        style,
    )
}

/// Healing HUD seam: row3, column24; clear of the bars and boss row1.
pub fn draw_water(s: sim.Sim, t: int, mut g: grid.Grid) {
    let text = if s.flask_max == 0 {
        "Water 0/0 - find a spring"
    } else {
        "Water {s.flasks}/{s.flask_max}  w drink"
    }
    draw.put_text(
        mut g,
        3,
        24,
        text,
        grid.cell(32, if t == tier.PLAIN then 14 else 117, if t == tier.PLAIN then 0 else 235, 0),
    )
}

/// Persistent edge-zero thorns: intact across the throat, broken flanks
/// after the lunge, visible from both areas without closing the opened gap.
pub fn draw_thorn_boundary(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.area != forest.SHINGLE && s.area != forest.BRAMBLEHOLD { return }
    let row = forest.thorn_row(s.seed, s.area) - sim.cell_y(s) + sim.screen_row(s)
    var x = -4
    while x <= 4 {
        if !s.gate_open || x < -2 || x > 2 {
            var cell = thorn_cell(t, x + 4)
            if s.gate_open { cell.attrs = grid.ATTR_DIM }
            grid.put(mut g, row, x - sim.cell_x(s) + sim.screen_col(s), cell)
        }
        x += 1
    }
}
