//! art — a frame from the simulation: the Shingle around the camera and
//! the cub at its centre, drawn onto a grid through a tier. Pure: the same
//! simulation state and tier give the same grid, which the goldens pin.
//!
//! The sprites (`docs/ART.md`): the rich cub is two cells by two, its
//! ears on the side it faces (quadrant blocks), its body the full block;
//! the plain cub is a bold `C` with a facing mark beside it. The ground is
//! the terrain's kind at each world cell with the seed's texture.

use draw
use grid
use sim
use sprites
use terrain
use tier

/// The terrain of screen row `row` into `g` on tier `t`.
fn terrain_row(s: sim.Sim, t: int, row: int, mut g: grid.Grid) {
    var col = 0
    while col < s.cols {
        let (x, y) = sim.world_cell(s, row, col)
        let k = terrain.kind(s.seed, x, y)
        let v = sim.variant(s, x, y, 4)
        let cell = if k == terrain.GRAVEL {
            sprites.glyph(
                t,
                sprites.SP_GRAVEL,
                if terrain.variant(s.seed, x, y, 7) == 0 then 1 + v % 3 else 0,
            )
        } else if k == terrain.GRASS {
            sprites.glyph(t, sprites.SP_GRASS, v)
        } else if k == terrain.TRUNK {
            sprites.glyph(t, sprites.SP_TRUNK, 0)
        } else if k == terrain.CANOPY {
            sprites.glyph(t, sprites.SP_CANOPY, v)
        } else if k == terrain.WATER {
            sprites.glyph(
                t,
                sprites.SP_WATER,
                if terrain.variant(s.seed, x, y, 5) == 0 then 1 + v % 3 else 0,
            )
        } else if k == terrain.REEDS {
            sprites.glyph(t, sprites.SP_REEDS, v)
        } else {
            sprites.glyph(t, sprites.SP_DARK, 0)
        }
        grid.put(mut g, row, col, cell)
        col += 1
    }
}

/// Draw the cub at screen `row`, `col` (its top-left cell) facing
/// `facing` (0 north, 1 east, 2 south, 3 west) with stamina `band`. Rich:
/// two by two, the ears on the facing side; plain: the mark then `C`.
pub fn draw_cub(mut g: grid.Grid, t: int, row: int, col: int, facing: int, band: int) {
    let body = sprites.glyph(t, sprites.SP_CUB_BODY, 0)
    let e0 = if t == tier.RICH {
        sprites.glyph(t, sprites.SP_CUB_EAR, band * 8 + facing * 2)
    } else {
        sprites.glyph(t, sprites.SP_CUB_MARK, facing)
    }
    let e1 = if t == tier.RICH {
        sprites.glyph(t, sprites.SP_CUB_EAR, band * 8 + facing * 2 + 1)
    } else {
        copy e0
    }
    // One body, every heading: ears above the same two body cells.
    grid.put(mut g, row, col, e0)
    grid.put(mut g, row, col + 1, e1)
    grid.put(mut g, row + 1, col, body)
    grid.put(mut g, row + 1, col + 1, body)
}

/// The whole frame: the ground on every row, then the cub at the centre.
/// `g` must be the simulation's size (`assert`).
pub fn render(s: sim.Sim, t: int, mut g: grid.Grid) {
    assert(g.rows == s.rows && g.cols == s.cols, "art.render: the grid is the simulation's size")
    var row = 0
    while row < s.rows {
        terrain_row(s, t, row, mut g)
        row += 1
    }
    draw_world_marks(s, t, mut g)
    // The rich cub's two rows sit on the cub's cell and the one above, so
    // its body is at the centre; the plain cub's mark is left of the centre.
    let r = sim.screen_row(s)
    let c = sim.screen_col(s)
    draw_pose(
        mut g,
        t,
        r - 1,
        c,
        sim.facing(s),
        band(s.stamina, sim.stamina_max(s.wind)),
        if s.exhausted then 3 else if s.sneaking then 2 else if s.speed > 0 then 1 else 0,
        s.tick,
    )
    draw_posture(s, t, mut g)
}

/// The art study's sheet (`docs/ART.md`): the cub facing each of the four
/// ways over a strip of the Shingle (water, reeds, gravel, grass, the
/// woods, the deep forest), on a 24 by 60 grid. Committed as a golden on
/// both tiers.
pub fn sheet(t: int) -> grid.Grid {
    var g = grid.new(24, 60)
    // Bands of ground, top to bottom.
    var row = 0
    while row < 24 {
        var col = 0
        while col < 60 {
            let v = (row * 7 + col * 13) % 4
            let cell = if row < 3 {
                sprites.glyph(
                    t,
                    sprites.SP_WATER,
                    if (row * 31 + col * 17) % 5 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 5 {
                sprites.glyph(t, sprites.SP_REEDS, v)
            } else if row < 11 {
                sprites.glyph(
                    t,
                    sprites.SP_GRAVEL,
                    if (row * 11 + col * 3) % 7 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 15 {
                sprites.glyph(t, sprites.SP_GRASS, v)
            } else if row < 20 {
                if (row * 5 + col * 11) % 9 == 0 {
                    sprites.glyph(t, sprites.SP_TRUNK, 0)
                } else {
                    sprites.glyph(t, sprites.SP_CANOPY, v)
                }
            } else {
                sprites.glyph(t, sprites.SP_DARK, 0)
            }
            grid.put(mut g, row, col, cell)
            col += 1
        }
        row += 1
    }
    var pose = 0
    while pose < 4 {
        var f = 0
        while f < 4 {
            draw_pose(mut g, t, 6 + pose * 4, 14 + f * 9, f, if pose == 3 then 2 else 0, pose, 0)
            f += 1
        }
        draw.put_text(
            mut g,
            6 + pose * 4,
            1,
            if pose == 0 {
                "stand"
            } else if pose == 1 {
                "walk"
            } else if pose == 2 {
                "sneak"
            } else {
                "pant"
            },
            sprites.glyph(t, sprites.SP_GRAVEL, 0),
        )
        pose += 1
    }
    draw.put_text(
        mut g,
        5,
        13,
        "N        E        S        W",
        sprites.glyph(t, sprites.SP_GRAVEL, 0),
    )
    g
}

fn band(value: int, maximum: int) -> int {
    if value * 3 > maximum * 2 then 0 else if value * 3 > maximum then 1 else 2
}

fn ink(t: int, bright: bool) -> grid.Cell {
    grid.cell(
        32,
        if t == tier.RICH then (if bright then 180 else 137) else (if bright then 11 else 3),
        sprites.palette(t, sprites.C_GRAVEL),
        if bright then grid.ATTR_BOLD else 0,
    )
}

fn at_world(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int, text: str, bright: bool) {
    draw.put_text(
        mut g,
        y - sim.cell_y(s) + sim.screen_row(s),
        x - sim.cell_x(s) + sim.screen_col(s),
        text,
        ink(t, bright),
    )
}

fn draw_world_marks(s: sim.Sim, t: int, mut g: grid.Grid) {
    for tr in s.trail {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(tr.x, sim.FP),
            sim.floor_div(tr.y, sim.FP),
            if tr.until - s.tick > 150 then ":" else ".",
            false,
        )
    }
    let (dx, dy) = terrain.start(s.seed)
    at_world(
        s,
        t,
        mut g,
        sim.floor_div(dx, sim.FP) - 3,
        sim.floor_div(dy, sim.FP) + 1,
        "( hollow log )",
        false,
    )
    at_world(s, t, mut g, -2, sim.gate_y(s), if s.gate_open then "  /  " else "#X#X#", true)
    at_world(s, t, mut g, -5, sim.gate_y(s) + 2, "Bramblehold", false)
    if s.mark && sim.near(s.x, s.y, s.mark_x, s.mark_y, (8 + s.nose * 2) * sim.FP) {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(s.mark_x, sim.FP),
            sim.floor_div(s.mark_y, sim.FP),
            "*",
            true,
        )
    }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        if f.health > 0 {
            let r = sim.floor_div(f.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let c = sim.floor_div(f.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            let glyph = if f.kind == sim.FOX then "f" else "w"
            let tell = if f.phase == sim.CROUCH {
                "_"
            } else if f.phase == sim.FEINT {
                "~"
            } else if f.phase == sim.STRIKE {
                ">"
            } else if f.phase == sim.STAGGER {
                "!"
            } else if f.phase == sim.RETREAT {
                "<"
            } else {
                "^"
            }
            draw.put_text(
                mut g,
                r,
                c,
                glyph + tell,
                ink(t, f.phase == sim.CROUCH || f.phase == sim.STRIKE),
            )
            if f.phase == sim.STRIKE {
                // Presentation only: airborne accent over the ground envelope.
                draw.put_text(mut g, r - 1, c, "'", ink(t, true))
            }
            if s.locked == i { draw.put_text(mut g, r + 1, c, "[]", ink(t, true)) }
        }
        i += 1
    }
}

fn draw_posture(s: sim.Sim, t: int, mut g: grid.Grid) {
    let r = sim.screen_row(s)
    let c = sim.screen_col(s)
    let health = band(s.health, sim.health_max(s.heart))
    let tail = if health == 0 then "/" else if health == 1 then "-" else "_"
    draw.put_text(mut g, r + 1, c - 1, tail, ink(t, health == 0))
    let posture = if s.action == sim.BITE {
        ">"
    } else if s.action == sim.LUNGE {
        ">>"
    } else if s.action == sim.PARRY {
        "]"
    } else if s.action == sim.DODGE {
        "o"
    } else if s.action == sim.DRINK {
        "~"
    } else if s.action == sim.FALL {
        "_"
    } else if s.exhausted {
        ":"
    } else {
        ""
    }
    draw.put_text(mut g, r, c + 2, posture, ink(t, true))
    if s.action == sim.LUNGE && s.tick - s.started >= 9 && s.tick - s.started < 12 {
        draw.put_text(mut g, r - 2, c + 1, "'", ink(t, true))
    }
    if s.action == sim.FALL {
        // Thirty ticks: progressively erase the field in a deterministic dissolve.
        var row = 0
        while row < s.rows {
            var col = 0
            while col < s.cols {
                if (row * 7 + col * 11) % 30 < s.tick - s.started {
                    grid.put(mut g, row, col, grid.blank())
                }
                col += 1
            }
            row += 1
        }
        draw.put_text(mut g, r, c - 4, "fallen", ink(t, false))
    }
    if at_log_hint(s) {
        draw.put_text(mut g, s.rows - 1, 1, "r rest at the hollow log", ink(t, false))
    }
    if s.den {
        let style = ink(t, true)
        var row = 3
        while row < 13 {
            draw.put_text(
                mut g,
                row,
                3,
                "                                                        ",
                style,
            )
            row += 1
        }
        draw.put_text(mut g, 3, 4, "The hollow log", style)
        draw.put_text(
            mut g,
            5,
            4,
            "health {s.health}   stamina {s.stamina}   water {s.flasks}   scent {s.scent}",
            style,
        )
        draw.put_text(
            mut g,
            7,
            4,
            "1 heart {s.heart} (next {40 * (s.heart + 1)})   2 wind {s.wind} (next {40 * (s.wind + 1)})",
            style,
        )
        draw.put_text(
            mut g,
            8,
            4,
            "3 fang {s.fang} (next {40 * (s.fang + 1)})   4 paw {s.paw} (next {40 * (s.paw + 1)})",
            style,
        )
        draw.put_text(mut g, 9, 4, "5 nose {s.nose} (next {40 * (s.nose + 1)})", style)
        draw.put_text(mut g, 11, 4, "r or Esc leave; a stat cannot grow past ten", style)
    }
}

fn at_log_hint(s: sim.Sim) -> bool { sim.at_den(s) && !s.den && s.action != sim.FALL }

/// Four posture silhouettes, invariant under heading on either glyph tier.
pub fn draw_pose(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    facing: int,
    band: int,
    pose: int,
    tick: int,
) {
    draw_cub(mut g, t, row, col, facing, band)
    if pose == 2 {
        draw.put_text(mut g, row, col, "__", ink(t, false))
    }
    if pose == 1 {
        draw.put_text(mut g, row + 2, col + tick % 2, "'", ink(t, false))
    }
    if pose == 3 {
        draw.put_text(mut g, row, col, "__", ink(t, false))
        draw.put_text(mut g, row + 1, col + 2, ":", ink(t, false))
    }
}
