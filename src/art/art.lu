//! art — a frame from the simulation: the Shingle around the camera and
//! the cub at its centre, drawn onto a grid through a tier. Pure: the same
//! simulation state and tier give the same grid, which the goldens pin.
//!
//! The sprites (`docs/ART.md`): the rich cub is two cells by two, its
//! ears on the side it faces (quadrant blocks), its body the full block;
//! the plain cub is a bold `C` with a facing mark beside it. The ground is
//! the terrain's kind at each world cell with the seed's texture.

use draw
use forest
use grid
use silhouette
use sim
use sprites
use terrain
use tier

/// The terrain of screen row `row` into `g` on tier `t`.
pub fn terrain_row(s: sim.Sim, t: int, row: int, mut g: grid.Grid) {
    var col = 0
    while col < s.cols {
        let (x, y) = sim.world_cell(s, row, col)
        let k = forest.kind(s.seed, s.field, s.area, x, y)
        let v = sim.variant(s, x, y, 4)
        // Foliage variants alternate their glyph set by the cell's parity,
        // so two adjacent canopy or deep-forest cells are never identical:
        // the forest reads as texture, never as a run of one tile.
        let foliage = 2 * (((x + y) % 2 + 2) % 2) + sim.variant(s, x, y, 2)
        var cell = if k == terrain.GRAVEL {
            sprites.glyph(
                t,
                sprites.SP_GRAVEL,
                if terrain.variant(s.seed, x, y, 7) == 0 then 1 + v % 3 else 0,
            )
        } else if k == terrain.GRASS {
            sprites.glyph(t, sprites.SP_GRASS, v)
        } else if k == terrain.TRUNK {
            sprites.glyph(t, sprites.SP_TRUNK, 0)
        } else if k == terrain.CANOPY {
            sprites.glyph(t, sprites.SP_CANOPY, foliage)
        } else if k == terrain.WATER {
            sprites.glyph(
                t,
                sprites.SP_WATER,
                if terrain.variant(s.seed, x, y, 5) == 0 then 1 + v % 3 else 0,
            )
        } else if k == terrain.ROCK {
            sprites.glyph(t, sprites.SP_ROCK, v)
        } else if k == terrain.REEDS {
            sprites.glyph(t, sprites.SP_REEDS, v)
        } else {
            sprites.glyph(t, sprites.SP_DARK, foliage)
        }
        if s.area != forest.SHINGLE {
            cell.bg = if t == tier.RICH {
                (if s.area == forest.BRAMBLEHOLD then 233 else 235)
            } else {
                0
            }
            cell.fg = dusk_ink(s.area, t, k, foliage)
            // Sight hides creatures, never the forest itself.
            if s.area == forest.BRAMBLEHOLD &&
                !sim.near(s.x, s.y, x * sim.FP, y * sim.FP, 12 * sim.FP) {
                cell.attrs = 0
            }
        }
        grid.put(mut g, row, col, cell)
        col += 1
    }
}

/// The dusk keyframes (`docs/PALETTE.md`): the thicket's two foliage
/// greens over its floor, the meadow's gold grass and tall grass with the
/// dusk woods closing round it; trunks share one dusk brown. Two tones
/// per foliage kind keep the forest's texture under the recolour.
fn dusk_ink(area: int, t: int, k: int, foliage: int) -> int {
    let thicket = area == forest.BRAMBLEHOLD
    if t != tier.RICH {
        if k == terrain.TRUNK { return 3 }
        if k == terrain.GRASS || k == terrain.REEDS { return if thicket then 2 else 3 }
        return 2
    }
    if k == terrain.TRUNK { return 95 }
    if k == terrain.GRASS { return if thicket then 65 else 137 }
    if k == terrain.REEDS { return if thicket then 65 else 143 }
    if k == terrain.CANOPY {
        return if thicket {
            (if foliage % 4 < 2 then 29 else 23)
        } else {
            (if foliage % 4 < 2 then 58 else 22)
        }
    }
    if thicket then 23 else 58
}

/// The cub's fur on a tier for a stamina band: fresh, tired or spent.
fn fur(t: int, band: int) -> grid.Cell {
    grid.cell(
        32,
        sprites.palette(t, if band == 0 then sprites.C_FUR else sprites.C_FUR_DIM),
        grid.COLOR_DEFAULT,
        if t == tier.RICH then 0 else grid.ATTR_BOLD,
    )
}

/// The plain tier's cub, the rich footprint in ASCII: four cells by four
/// north and south (ears, shoulders, body, tail), eight by two east and
/// west (the head leading, the tail trailing).
fn plain_cub(facing: int, pose: int) -> List[str] {
    var rows = List[str]()
    let low = pose == 2 || pose == 3
    if facing == 0 {
        (mut rows).push(if low then ".__." else ".^^.")
        (mut rows).push("####")
        (mut rows).push("####")
        (mut rows).push(".,..")
    } else if facing == 2 {
        (mut rows).push("..,.")
        (mut rows).push("####")
        (mut rows).push("####")
        (mut rows).push(if low then ".__." else ".vv.")
    } else if facing == 1 {
        (mut rows).push(if low then ".=####_." else ".=####^.")
        (mut rows).push(",=####>.")
    } else {
        (mut rows).push(if low then "._####=." else ".^####=.")
        (mut rows).push(".<####=,")
    }
    rows
}

/// Draw the cub at its own cell `(row, col)` facing `facing` (0 north, 1
/// east, 2 south, 3 west) with stamina `band`, in `pose` at `tick`. Rich:
/// one silhouette turned to the facing (`silhouette.cub`); plain: the
/// same footprint in ASCII. The ground shows through unlit cells.
pub fn draw_cub(mut g: grid.Grid, t: int, row: int, col: int, facing: int, band: int) {
    draw_pose(mut g, t, row, col, facing, band, if band == 2 then 3 else 0, 0)
}

/// The whole frame: the ground on every row, then the cub at the centre.
/// `g` must be the simulation's size (`assert`).
pub fn render(s: sim.Sim, t: int, mut g: grid.Grid) {
    assert(g.rows == s.rows && g.cols == s.cols, "art.render: the grid is the simulation's size")
    if s.scene != 0 { opening_frame(s, t, mut g); return }
    var row = 0
    while row < s.rows {
        terrain_row(s, t, row, mut g)
        row += 1
    }
    shore_finds(s, t, mut g)
    shade_exits(s, t, mut g)
    draw_world_marks(s, t, mut g)
    // The cub's own cell is the centre; the silhouette hangs about it.
    let (ox, oy) = sim.attack_offset(s)
    let r = sim.screen_row(s) + sim.floor_div(s.y + oy, sim.FP) - sim.cell_y(s)
    let c = sim.screen_col(s) + sim.floor_div(s.x + ox, sim.FP) - sim.cell_x(s)
    let facing = if s.action == sim.BITE || s.action == sim.LUNGE || s.action == sim.HEAVY {
        (s.attack_heading + 32) % sim.TURN / 64
    } else {
        sim.facing(s)
    }
    let pose = if s.exhausted {
        3
    } else if s.sneaking ||
        s.action == sim.BITE && s.tick - s.started < 3 ||
        s.action == sim.LUNGE && s.tick - s.started < 9 {
        2
    } else if s.speed > 0 {
        1
    } else {
        0
    }
    let shake = sim.head_shake(s)
    if shake != 0 && t == tier.RICH {
        // The third bite's head shake: the body stays, the head cells move
        // one cell across the aim (a column north or south, a row east or
        // west), the same silhouette in two parts.
        let style = fur(t, band(s.stamina, sim.stamina_max(s.wind)))
        let body = silhouette.cub(pose, s.tick)
        silhouette.draw_at(mut g, r, c, silhouette.strip(body, false), facing, style)
        let dr = if facing % 2 == 0 then 0 else shake
        let dc = if facing % 2 == 0 then shake else 0
        silhouette.draw_at(mut g, r + dr, c + dc, silhouette.strip(body, true), facing, style)
    } else {
        draw_pose(mut g, t, r, c, facing, band(s.stamina, sim.stamina_max(s.wind)), pose, s.tick)
        if shake != 0 {
            // Plain: the ears row shifts across the aim.
            let dr = if facing == 0 then -1 else if facing == 2 then 2 else shake
            let dc = if facing % 2 == 0 then shake - 1 else (if facing == 1 then 3 else -2)
            draw.put_text(
                mut g,
                r + dr,
                c + dc,
                if facing % 2 == 0 then ".^^." else "^",
                ink(t, true),
            )
        }
    }
    draw_posture(s, t, mut g)
    draw_hud(s, t, mut g)
    world_lines(s, t, mut g)
    if s.gate_hint_until > s.tick {
        draw.put_text(mut g, s.rows - 2, 1, "the thorns need a lunge", ink(t, true))
    }
}

/// The art study's sheet (`docs/ART.md`): the cub facing each of the four
/// ways in each of its four poses over a strip of the Shingle (water,
/// reeds, gravel, grass, the woods, the deep forest), then every foe in
/// every phase and fade facing north and the east form of each, on a 56 by
/// 80 grid. Committed as a golden on both tiers.
pub fn sheet(t: int) -> grid.Grid {
    var g = grid.new(56, 80)
    // Bands of ground, top to bottom.
    var row = 0
    while row < 56 {
        var col = 0
        while col < 80 {
            let v = (row * 7 + col * 13) % 4
            let foliage = 2 * ((row + col) % 2) + (row * 3 + col) % 2
            let cell = if row < 3 {
                sprites.glyph(
                    t,
                    sprites.SP_WATER,
                    if (row * 31 + col * 17) % 5 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 5 {
                sprites.glyph(t, sprites.SP_REEDS, v)
            } else if row < 11 {
                sprites.glyph(
                    t,
                    sprites.SP_GRAVEL,
                    if (row * 11 + col * 3) % 7 == 0 then 1 + v % 3 else 0,
                )
            } else if row < 15 {
                sprites.glyph(t, sprites.SP_GRASS, v)
            } else if row < 25 {
                if (row * 5 + col * 11) % 9 == 0 {
                    sprites.glyph(t, sprites.SP_TRUNK, 0)
                } else {
                    sprites.glyph(t, sprites.SP_CANOPY, foliage)
                }
            } else if row < 28 {
                sprites.glyph(t, sprites.SP_DARK, foliage)
            } else {
                sprites.glyph(t, sprites.SP_GRAVEL, 0)
            }
            grid.put(mut g, row, col, cell)
            col += 1
        }
        row += 1
    }
    draw.put_text(mut g, 5, 1, "cub:   N          E          S          W", ink(t, true))
    var pose = 0
    while pose < 4 {
        var f = 0
        while f < 4 {
            draw_pose(mut g, t, 8 + pose * 5, 10 + f * 11, f, if pose == 3 then 2 else 0, pose, 0)
            f += 1
        }
        draw.put_text(
            mut g,
            8 + pose * 5,
            1,
            if pose == 0 {
                "stand"
            } else if pose == 1 {
                "walk"
            } else if pose == 2 {
                "sneak"
            } else {
                "pant"
            },
            ink(t, true),
        )
        pose += 1
    }
    var kind = 0
    while kind < 3 {
        let species = if kind == 2 then sim.DEER else kind
        let top = 29 + kind * 9
        draw.put_text(
            mut g,
            top,
            1,
            if kind == 0 {
                "weasel: hunt   crouch strike flee   stagger feint  pause  fade0  fade5  fade10"
            } else if kind == 1 {
                "fox:    hunt   crouch strike flee   stagger feint  pause  fade0  fade5  fade10"
            } else {
                "deer:   stand  flee                                       fade0  fade5  fade10"
            },
            ink(t, true),
        )
        var phase = 0
        while phase < 10 {
            if kind < 2 || phase < 2 || phase >= 7 {
                draw_foe(
                    mut g,
                    t,
                    top + 3,
                    9 + phase * 7,
                    species,
                    if phase < 7 {
                        (if phase == 1 && kind == 2 then sim.RETREAT else phase)
                    } else {
                        sim.HUNT
                    },
                    0,
                    if phase < 7 then -1 else (phase - 7) * 5,
                )
            }
            phase += 1
        }
        // The east form: the same silhouette turned, hunting and striking.
        draw.put_text(mut g, top + 6, 1, "east:", ink(t, true))
        draw_foe(mut g, t, top + 6, 12, species, sim.HUNT, 64, -1)
        draw_foe(
            mut g,
            t,
            top + 6,
            24,
            species,
            if kind == 2 then sim.RETREAT else sim.STRIKE,
            64,
            -1,
        )
        draw_foe(mut g, t, top + 6, 36, species, sim.HUNT, 192, -1)
        kind += 1
    }
    g
}

fn band(value: int, maximum: int) -> int {
    if value * 3 > maximum * 2 then 0 else if value * 3 > maximum then 1 else 2
}

fn ink(t: int, bright: bool) -> grid.Cell {
    grid.cell(
        32,
        if t == tier.RICH then (if bright then 180 else 137) else (if bright then 11 else 3),
        sprites.palette(t, sprites.C_GRAVEL),
        if bright then grid.ATTR_BOLD else 0,
    )
}

fn at_world(s: sim.Sim, t: int, mut g: grid.Grid, x: int, y: int, text: str, bright: bool) {
    draw.put_text(
        mut g,
        y - sim.cell_y(s) + sim.screen_row(s),
        x - sim.cell_x(s) + sim.screen_col(s),
        text,
        ink(t, bright),
    )
}

fn draw_world_marks(s: sim.Sim, t: int, mut g: grid.Grid) {
    for drop in s.drops {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(drop.x, sim.FP),
            sim.floor_div(drop.y, sim.FP),
            if drop.until - s.tick > sim.DROP_TICKS / 2 then "*" else ".",
            drop.until - s.tick > sim.DROP_TICKS / 2,
        )
    }
    var cache = 0
    while cache < forest.cache_count(s.area) {
        let (x, y) = forest.cache_position(s.seed, s.field, s.area, cache)
        if s.area == forest.SHINGLE {
            draw_bundle(
                mut g,
                t,
                sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s) - 1,
                sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s) - 2,
                sim.cache_open(s, cache),
            )
        } else {
            at_world(
                s,
                t,
                mut g,
                sim.floor_div(x, sim.FP) - 2,
                sim.floor_div(y, sim.FP),
                if sim.cache_open(s, cache) {
                    "( empty )"
                } else if cache == 0 {
                    "( hollow )"
                } else {
                    "( burrow )"
                },
                false,
            )
        }
        if sim.near(s.x, s.y, x, y, 2 * sim.FP) && !s.den {
            draw.put_text(
                mut g,
                s.rows - 2,
                1,
                if sim.cache_open(s, cache) {
                    if s.area == forest.SHINGLE {
                        "The wrapping is empty; a bundle is in your pouch."
                    } else if cache == 0 {
                        "Old bones. Nothing here carries a scent."
                    } else {
                        "The burrow is empty; its herb is in your pouch."
                    }
                } else {
                    "r dig; the guards must be gone"
                },
                ink(t, true),
            )
        }
        cache += 1
    }
    for tr in s.trail {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(tr.x, sim.FP),
            sim.floor_div(tr.y, sim.FP),
            if tr.until - s.tick > 150 then ":" else ".",
            false,
        )
    }
    var den = 0
    while den < 4 {
        if forest.den_area(den) == s.area {
            let (dx, dy) = forest.den_position(s.seed, den)
            if den == 0 {
                draw_log(
                    mut g,
                    t,
                    sim.floor_div(dy, sim.FP) - sim.cell_y(s) + sim.screen_row(s) + 2,
                    sim.floor_div(dx, sim.FP) - sim.cell_x(s) + sim.screen_col(s) - 4,
                    true,
                )
            } else {
                at_world(
                    s,
                    t,
                    mut g,
                    sim.floor_div(dx, sim.FP) - 3,
                    sim.floor_div(dy, sim.FP) + 1,
                    "( " + forest.den_name(den) + " )",
                    false,
                )
            }
        }
        den += 1
    }
    if s.area == forest.SHINGLE {
        if !s.gate_open {
            var gx = -2
            while gx <= 2 {
                grid.put(
                    mut g,
                    sim.gate_y(s) - sim.cell_y(s) + sim.screen_row(s),
                    gx - sim.cell_x(s) + sim.screen_col(s),
                    thorn_cell(t, gx + 2),
                )
                gx += 1
            }
        }
        at_world(s, t, mut g, -5, sim.gate_y(s) - 3, "Bramblehold", false)
    } else if s.area == forest.BRAMBLEHOLD {
        at_world(s, t, mut g, -3, forest.LENGTH - 3, "Larkmeadow", false)
        at_world(s, t, mut g, 7, 24, "Old Snag's clearing", false)
        at_world(s, t, mut g, -11, 24, "Ember", true)
        at_world(s, t, mut g, -7, 18, "bones, no scent", false)
    } else {
        at_world(s, t, mut g, 7, 24, "scent-marked tree", false)
    }
    var edge = 2
    while edge < 4 {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if edge == 2 {
                draw_log(
                    mut g,
                    t,
                    sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s) - 1,
                    sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s) - 4,
                    false,
                )
            } else {
                at_world(
                    s,
                    t,
                    mut g,
                    sim.floor_div(x, sim.FP) - 3,
                    sim.floor_div(y, sim.FP),
                    "[ hedge ]",
                    true,
                )
            }
        }
        edge += 1
    }
    if s.mark &&
        s.mark_area == s.area &&
        sim.near(s.x, s.y, s.mark_x, s.mark_y, (8 + s.nose * 2) * sim.FP) {
        at_world(
            s,
            t,
            mut g,
            sim.floor_div(s.mark_x, sim.FP),
            sim.floor_div(s.mark_y, sim.FP),
            "*",
            true,
        )
    }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        let fade = if f.health > 0 {
            -1
        } else if f.died >= 0 {
            s.tick - f.died
        } else {
            sim.FOE_FADE_TICKS
        }
        if fade < sim.FOE_FADE_TICKS &&
            (s.area != forest.BRAMBLEHOLD || sim.visible(s, s.x, s.y, f.x, f.y)) {
            let r = sim.floor_div(f.y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let c = sim.floor_div(f.x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            draw_foe(mut g, t, r, c, f.kind, f.phase, f.heading, fade)
            if s.locked == i { draw.put_text(mut g, r + 2, c, "[]", ink(t, true)) }
        }
        i += 1
    }
}

fn draw_posture(s: sim.Sim, t: int, mut g: grid.Grid) {
    let (ox, oy) = sim.attack_offset(s)
    let r = sim.screen_row(s) + sim.floor_div(s.y + oy, sim.FP) - sim.cell_y(s)
    let c = sim.screen_col(s) + sim.floor_div(s.x + ox, sim.FP) - sim.cell_x(s)
    let health = band(s.health, sim.health_max(s.heart))
    let tail = if health == 0 then "/" else if health == 1 then "-" else "_"
    // The health tail sits below and left of the silhouette, clear of it in
    // every facing (north and south fill rows r-1..r+2 of columns c-1..c+2;
    // east and west fill rows r..r+1 from c-3 to c+4).
    draw.put_text(mut g, r + 3, c - 1, tail, ink(t, health == 0))
    let posture = if s.action == sim.PARRY {
        "]"
    } else if s.action == sim.DODGE {
        "o"
    } else if s.action == sim.DRINK {
        "~"
    } else if s.action == sim.FALL {
        "_"
    } else if s.exhausted {
        ":"
    } else {
        ""
    }
    draw.put_text(mut g, r - 1, c + 5, posture, ink(t, true))
    let burst = sim.burst_age(s)
    if burst >= 0 {
        let (bx, by) = sim.burst_point(s)
        let x = sim.floor_div(bx, sim.FP)
        let y = sim.floor_div(by, sim.FP)
        let spread = if burst < 2 then 1 else 2
        at_world(s, t, mut g, x - spread, y - spread, if burst < 2 then "*" else ".", burst == 0)
        at_world(s, t, mut g, x + spread, y - spread, if burst < 2 then "*" else ".", burst == 0)
        at_world(s, t, mut g, x - spread, y + spread, if burst < 2 then "+" else ".", burst == 0)
        at_world(s, t, mut g, x + spread, y + spread, if burst < 2 then "+" else ".", burst == 0)
    }
    if sim.landing(s) {
        let (x, y) = sim.landing_point(s)
        at_world(s, t, mut g, sim.floor_div(x, sim.FP), sim.floor_div(y, sim.FP) + 1, "*", true)
    }
    if s.action == sim.FALL {
        // Thirty ticks: progressively erase the field in a deterministic dissolve.
        var row = 0
        while row < s.rows {
            var col = 0
            while col < s.cols {
                if (row * 7 + col * 11) % 30 < s.tick - s.started {
                    grid.put(mut g, row, col, grid.blank())
                }
                col += 1
            }
            row += 1
        }
        draw.put_text(mut g, r, c - 4, "fallen - scent lost {s.mark_scent}", ink(t, false))
    }
    if at_log_hint(s) {
        draw.put_text(
            mut g,
            s.rows - 1,
            1,
            "r rest at " + forest.den_name(sim.den_here(s)),
            ink(t, false),
        )
    }
    if s.den {
        let style = ink(t, true)
        var row = 3
        while row < 13 {
            draw.put_text(
                mut g,
                row,
                3,
                "                                                        ",
                style,
            )
            row += 1
        }
        draw.put_text(mut g, 3, 4, forest.den_name(s.last_den), style)
        draw.put_text(
            mut g,
            5,
            4,
            "health {s.health}   stamina {s.stamina}   water {s.flasks}   scent {s.scent}",
            style,
        )
        draw.put_text(
            mut g,
            7,
            4,
            "1 heart {s.heart} (next {40 * (s.heart + 1)})   2 wind {s.wind} (next {40 * (s.wind + 1)})",
            style,
        )
        draw.put_text(
            mut g,
            8,
            4,
            "3 fang {s.fang} (next {40 * (s.fang + 1)})   4 paw {s.paw} (next {40 * (s.paw + 1)})",
            style,
        )
        draw.put_text(mut g, 9, 4, "5 nose {s.nose} (next {40 * (s.nose + 1)})", style)
        let bundles = s.caches % 2 + s.caches / 2 % 2 + s.caches / 4 % 2 + s.caches / 8 % 2
        draw.put_text(
            mut g,
            10,
            4,
            "pouch: yarrow {s.yarrow}  marrow {s.marrow}  a bundle {bundles}",
            style,
        )
        draw.put_text(mut g, 11, 4, "r or Esc leave; a stat cannot grow past ten", style)
        draw.put_text(
            mut g,
            12,
            4,
            if s.save_status == 1 {
                "Saving journey... q cancels this pending write"
            } else if s.save_status == 2 {
                "Journey saved; resume at this den"
            } else {
                "Journey not written in this replay"
            },
            style,
        )
    }
}

fn at_log_hint(s: sim.Sim) -> bool { sim.at_den(s) && !s.den && s.action != sim.FALL }

/// Four poses of one silhouette, turned to the facing on the rich tier
/// (`silhouette.cub`), the same footprint in ASCII on the plain. `(row,
/// col)` is the cub's own cell.
pub fn draw_pose(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    facing: int,
    band: int,
    pose: int,
    tick: int,
) {
    let style = fur(t, band)
    if t == tier.RICH {
        silhouette.draw_at(mut g, row, col, silhouette.cub(pose, tick), facing, style)
        return
    }
    let rows = plain_cub(facing, pose)
    let top = if facing % 2 == 0 then row - 1 else row
    let left = if facing % 2 == 0 then col - 1 else col - 3
    var i = 0
    while i < rows.len {
        put_over(mut g, top + i, left, rows[i], style)
        i += 1
    }
    if pose == 1 && tick % 2 == 1 && facing % 2 == 0 {
        // The walk alternates a paw out at the shoulders.
        put_over(mut g, row, if facing == 0 then col - 2 else col + 3, "'", style)
    }
}

/// The quarter a heading faces: 0 north, 1 east, 2 south, 3 west.
fn quarter(heading: int) -> int {
    ((heading + 32) % sim.TURN + sim.TURN) % sim.TURN / 64
}

/// Every foe is one solid silhouette on the rich tier, turned to its
/// heading, its tell a posture of the same drawing (`silhouette.foe`); the
/// plain tier keeps a head, body and tail in ASCII with the same footprint.
/// `(row, col)` is the foe's own cell.
pub fn draw_foe(
    mut g: grid.Grid,
    t: int,
    row: int,
    col: int,
    kind: int,
    phase: int,
    heading: int,
    fade: int,
) {
    if fade >= sim.FOE_FADE_TICKS { return }
    if kind == sim.HAWK { draw_hawk(mut g, t, row, col, phase, fade); return }
    let colour = if kind == sim.DEER {
        (if t == tier.RICH then 180 else 11)
    } else {
        sprites.palette(t, if kind == sim.FOX then sprites.C_FOX else sprites.C_WEASEL)
    }
    let style = grid.cell(32, colour, grid.COLOR_DEFAULT, if fade < 0 then grid.ATTR_BOLD else 0)
    if t == tier.RICH {
        silhouette.draw_at(
            mut g,
            row,
            col,
            silhouette.foe(kind, phase, fade),
            quarter(heading),
            style,
        )
        return
    }
    let rows = plain_foe(kind, phase, fade, quarter(heading))
    let h = rows.len
    let w = rows[0].len
    let top = row - (h - 1) / 2
    let left = col - (w - 1) / 2
    var i = 0
    while i < h {
        put_over(mut g, top + i, left, rows[i], style)
        i += 1
    }
}

/// The plain tier's foes in ASCII with the rich footprints: the weasel two
/// cells by three (six by one turned), the fox four by three and the deer
/// four by four (six by two and eight by two turned). The head leads; a
/// crouch flattens it to `_`, a stagger lifts `!`, a flight trails `~`, a
/// feint curls `?`, a strike thrusts `'`; the fade erodes the head at five
/// ticks and the body at ten.
fn plain_foe(kind: int, phase: int, fade: int, facing: int) -> List[str] {
    var rows = List[str]()
    let crouch = phase == sim.CROUCH || phase == sim.FEINT
    let deer = kind == sim.DEER
    let fox = kind == sim.FOX
    let weasel = kind == sim.WEASEL
    let head = if fade >= 5 {
        (if weasel then ".." else "....")
    } else if deer {
        "Y..Y"
    } else if crouch {
        (if weasel then "__" else "____")
    } else if phase == sim.STAGGER {
        (if weasel then "!!" else "!!!!")
    } else if fox {
        "/^^\\"
    } else {
        "oo"
    }
    let body = if fade >= 10 {
        (if weasel then ". " else " .. ")
    } else if weasel {
        "=="
    } else {
        "####"
    }
    let tail = if phase == sim.RETREAT {
        (if weasel then "~ " else " ~~ ")
    } else if phase == sim.FEINT {
        (if weasel then "? " else " ?? ")
    } else if deer {
        ".||."
    } else if fox {
        " /\\ "
    } else {
        ", "
    }
    if facing % 2 == 0 {
        let north = facing == 0
        (mut rows).push(if north then head else tail)
        if deer { (mut rows).push(if north then "(oo)" else "####") }
        (mut rows).push(if deer then (if north then "####" else "(oo)") else body)
        (mut rows).push(if north then tail else head)
        return rows
    }
    // East and west: the tail, the body and the head along the rows.
    let strike = phase == sim.STRIKE && !deer
    if weasel {
        let strip = if fade >= 10 {
            " .    "
        } else if fade >= 5 {
            ",==.. "
        } else if strike {
            ",==oo'"
        } else {
            ",==oo "
        }
        (mut rows).push(if facing == 1 then strip else reversed(strip))
        return rows
    }
    let top = if deer {
        ".=####Y."
    } else if fade >= 5 {
        "./###.."
    } else if strike {
        "./###^'"
    } else {
        "./###^."
    }
    let low = if deer {
        ",=####>."
    } else if fade >= 10 {
        ",. .  ."
    } else if strike {
        ",=###>'"
    } else {
        ",=###>."
    }
    (mut rows).push(if facing == 1 then top else reversed(top))
    (mut rows).push(if facing == 1 then low else reversed(low))
    rows
}

/// A string reversed, `<`, `>`, `/` and `\\` mirrored.
fn reversed(s: str) -> str {
    var out = ""
    var i = s.len
    while i > 0 {
        i -= 1
        let c = s[i..i + 1]
        out += if c == "<" {
            ">"
        } else if c == ">" {
            "<"
        } else if c == "/" {
            "\\"
        } else if c == "\\" {
            "/"
        } else {
            c
        }
    }
    out
}

/// Text in `style` over the ground, the ground's own background kept.
fn put_over(mut g: grid.Grid, row: int, col: int, text: str, style: grid.Cell) {
    var j = 0
    for b in text.bytes() {
        if b as int != 32 {
            var cell = copy style
            cell.cp = b as int
            cell.bg = grid.at(g, row, col + j).bg
            grid.put(mut g, row, col + j, cell)
        }
        j += 1
    }
}

/// Compact bars reserve eight cells each; the larger posture HUD follows later.
fn meter(value: int, maximum: int) -> str {
    var out = "["
    var i = 0
    while i < 8 {
        out += if value * 8 > i * maximum then "|" else "."
        i += 1
    }
    out + "]"
}

/// Scent is always numeric; spending remains exclusively at the den.
pub fn hud_text(s: sim.Sim) -> str {
    "health " +
        meter(s.health, sim.health_max(s.heart)) +
        " stamina " +
        meter(s.stamina, sim.stamina_max(s.wind)) +
        " scent {s.scent}"
}

fn draw_hud(s: sim.Sim, t: int, mut g: grid.Grid) {
    draw.put_text(mut g, 0, 1, hud_text(s), ink(t, true))
}

/// Hazard-only thorn pair, disjoint from wall and label glyph/colour pairs.
pub fn thorn_cell(t: int, variant: int) -> grid.Cell {
    grid.cell(
        if t == tier.RICH {
            (if variant % 2 == 0 then 10478 else 10486)
        } else {
            (if variant % 2 == 0 then 37 else 38)
        },
        if t == tier.RICH then 196 else 12,
        if t == tier.RICH then 234 else 0,
        grid.ATTR_BOLD,
    )
}

/// Every exit and shortcut has this dim ground band, not a text label.
pub fn exit_shadow(t: int) -> grid.Cell {
    grid.cell(
        if t == tier.RICH then 183 else 46,
        if t == tier.RICH then 238 else 8,
        if t == tier.RICH then 232 else 0,
        0,
    )
}

fn world_lines(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.tick - s.entered < sim.ENTRY_TICKS {
        draw.put_text(mut g, 1, 1, forest.name(s.area), ink(t, true))
    }
    if s.den || s.action == sim.FALL { return }
    if s.area == forest.BRAMBLEHOLD && sim.near(s.x, s.y, -10 * sim.FP, 24 * sim.FP, 3 * sim.FP) {
        draw.put_text(
            mut g,
            s.rows - 2,
            1,
            "Ember: Keep out of the clearing. Old Snag hears the roots.",
            ink(t, true),
        )
    }
    var edge = 2
    while edge < 4 {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if sim.near(s.x, s.y, x, y, 2 * sim.FP) {
                draw.put_text(
                    mut g,
                    s.rows - 1,
                    1,
                    if edge == 2 {
                        if s.shortcuts % 2 == 1 {
                            "r cross the fallen log"
                        } else if s.area == forest.BRAMBLEHOLD {
                            "r push the fallen log toward the bank"
                        } else {
                            "The log must be pushed from Bramblehold"
                        }
                    } else if s.shortcuts / 2 % 2 == 1 {
                        "r crawl through the hedge"
                    } else if s.area == forest.LARKMEADOW {
                        "r dig under the hedge"
                    } else {
                        "The roots yield from the meadow side"
                    },
                    ink(t, true),
                )
            }
        }
        edge += 1
    }
}

/// The hawk's shadow on the ground at its cell: on the rich tier one
/// silhouette four cells across (`silhouette.hawk`: wings out circling,
/// spread wide at the stop, folded in the stoop, half open recovering);
/// the plain tier keeps its ASCII wings, body and shadow mark.
pub fn draw_hawk(mut g: grid.Grid, t: int, row: int, col: int, phase: int, fade: int) {
    if fade >= sim.FOE_FADE_TICKS { return }
    let style = grid.cell(
        32,
        if t == tier.RICH then 181 else 13,
        grid.COLOR_DEFAULT,
        if fade < 0 then grid.ATTR_BOLD else 0,
    )
    if t == tier.RICH {
        let posture = if phase == sim.CROUCH {
            1
        } else if phase == sim.STRIKE {
            2
        } else if phase == sim.RETREAT {
            3
        } else {
            0
        }
        silhouette.draw(mut g, row, col - 1, silhouette.hawk(posture, fade), style)
        return
    }
    let wings = if phase == sim.CROUCH {
        "\\_/"
    } else if phase == sim.STRIKE {
        " | "
    } else if phase == sim.RETREAT {
        "/v\\"
    } else {
        "-v-"
    }
    put_over(mut g, row - 3, col - 1, if fade >= 5 then "..." else wings, style)
    if fade < 10 { put_over(mut g, row - 2, col, if phase == sim.STRIKE then "v" else "o", style) }
    put_over(
        mut g,
        row,
        col - 1,
        if phase == sim.CROUCH then "(_)" else if phase == sim.STRIKE then " * " else " . ",
        style,
    )
}

/// Separate hawk study keeps every posture and fade readable on both tiers.
pub fn hawk_sheet(t: int) -> grid.Grid {
    var g = grid.new(12, 80)
    draw.put_text(
        mut g,
        1,
        1,
        "hawk: circle   stop     stoop    recover   fade0    fade5    fade10",
        ink(t, true),
    )
    var i = 0
    while i < 7 {
        draw_hawk(
            mut g,
            t,
            7,
            8 + i * 10,
            if i < 4 then i else sim.HUNT,
            if i < 4 then -1 else (i - 4) * 5,
        )
        i += 1
    }
    g
}

/// Original opening frames: the crossing, the break, the bank. Scene time
/// is simulation time; no renderer or wall clock can advance it.
pub fn opening_frame(s: sim.Sim, t: int, mut g: grid.Grid) {
    let age = s.tick - s.scene_started
    let frame = age / sim.SCENE_TICKS
    let style = grid.cell(
        32,
        if t == tier.RICH then 153 else 7,
        if t == tier.RICH then 17 else 4,
        0,
    )
    var row = 0
    while row < s.rows {
        var col = 0
        while col < s.cols {
            var cell = copy style
            if row > s.rows / 2 && (row * 7 + col + age / 6) % 9 == 0 {
                cell.cp = if t == tier.RICH then 8776 else 126
            }
            grid.put(mut g, row, col, cell)
            col += 1
        }
        row += 1
    }
    let mid = s.cols / 2
    if frame == 0 {
        var wolf = 0
        while wolf < 4 {
            draw_cub(mut g, t, s.rows / 2 - 2, mid - 18 + wolf * 10, 1, 0)
            wolf += 1
        }
        draw.put_text(mut g, 3, 4, "Late winter. The pack crosses the frozen Ashwater.", style)
        draw.put_text(mut g, 4, 4, "The smallest follows the tracks it knows.", style)
        draw.put_text(mut g, s.rows / 2 + 1, mid - 15, "_____  ______  ______  _____", style)
    } else if frame == 1 {
        draw.put_text(mut g, 3, 4, "The ice gives beneath the last of the line.", style)
        draw.put_text(mut g, 4, 4, "A cry, then water. The tracks are gone.", style)
        draw_cub(mut g, t, s.rows / 2 + 2, mid, 2, 2)
        draw.put_text(mut g, s.rows / 2, mid - 8, "__   _     __   _", style)
    } else {
        draw.put_text(
            mut g,
            3,
            4,
            "Dawn. Gravel beneath its paws. Its mother's scent gone cold.",
            style,
        )
        draw.put_text(mut g, 4, 4, "Home is upstream, and up.", style)
        draw_cub(mut g, t, s.rows / 2 - 2, mid, 0, 1)
        draw.put_text(mut g, s.rows / 2 + 1, mid - 8, ". , . , . , . , .", style)
    }
    draw.put_text(mut g, s.rows - 2, 4, "Any key skips", style)
}

fn shade_exits(s: sim.Sim, t: int, mut g: grid.Grid) {
    var edge = 0
    while edge < 4 {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            let row = sim.floor_div(y, sim.FP) - sim.cell_y(s) + sim.screen_row(s)
            let col = sim.floor_div(x, sim.FP) - sim.cell_x(s) + sim.screen_col(s)
            var dy = -1
            while dy <= 1 {
                var dx = -3
                while dx <= 3 { grid.put(mut g, row + dy, col + dx, exit_shadow(t)); dx += 1 }
                dy += 1
            }
        }
        edge += 1
    }
}

/// Original cut timber: hollow end grain for the den, a lengthwise passage
/// and direction marks for the fallen-log shortcut. Same footprint on both tiers.
pub fn draw_log(mut g: grid.Grid, t: int, row: int, col: int, hollow: bool) {
    let wood = grid.cell(
        32,
        sprites.palette(t, sprites.C_TRUNK),
        sprites.palette(t, sprites.C_GRAVEL),
        grid.ATTR_BOLD,
    )
    draw.put_text(mut g, row, col + 1, "_==_==_", wood)
    draw.put_text(mut g, row + 1, col, if hollow then "(O)===//)" else "<o=====o>", wood)
    draw.put_text(mut g, row + 2, col + 1, "_--_---", wood)
    if t == tier.RICH {
        var grain = copy wood
        grain.cp = 9617
        grid.put(mut g, row, col + 2, grain)
        grid.put(mut g, row, col + 3, grain)
        grid.put(mut g, row, col + 5, grain)
        grid.put(mut g, row, col + 6, grain)
        grid.put(mut g, row + 2, col + 1, grain)
        grid.put(mut g, row + 2, col + 4, grain)
    }
}

/// Wrapped cache treasure; its opened form leaves only the loose binding.
/// Inventory identity is the existing finite Shingle cache bits. Rich: one
/// solid silhouette five cells by three (`silhouette.bundle`); plain: the
/// knot, the cord's cross and the binding in ASCII.
pub fn draw_bundle(mut g: grid.Grid, t: int, row: int, col: int, opened: bool) {
    let cloth = ink(t, !opened)
    if t == tier.RICH {
        var style = copy cloth
        style.bg = grid.COLOR_DEFAULT
        silhouette.draw(mut g, row, col, silhouette.bundle(opened), style)
        return
    }
    if opened {
        draw.put_text(mut g, row + 2, col, "_x___", cloth)
        return
    }
    draw.put_text(mut g, row, col + 1, "\\|/", cloth)
    draw.put_text(mut g, row + 1, col, "(:X:)", cloth)
    draw.put_text(mut g, row + 2, col + 1, "---", cloth)
}

/// Five original shore finds, each five cells wide and two rows tall.
pub fn draw_flotsam(mut g: grid.Grid, t: int, row: int, col: int, kind: int) {
    let wood = grid.cell(
        32,
        if kind == 2 || kind == 3 {
            sprites.palette(t, sprites.C_REED)
        } else {
            sprites.palette(t, sprites.C_TRUNK)
        },
        sprites.palette(t, sprites.C_GRAVEL),
        0,
    )
    let top = if kind == 0 {
        " __/ "
    } else if kind == 1 {
        "/X_/|"
    } else if kind == 2 {
        "~v~v "
    } else if kind == 3 {
        "  _! "
    } else {
        "/x/x/"
    }
    let bottom = if kind == 0 {
        "==/=="
    } else if kind == 1 {
        "|_/ /"
    } else if kind == 2 {
        " v~v~"
    } else if kind == 3 {
        " (__)"
    } else {
        "x/x/~"
    }
    draw.put_text(mut g, row, col, top, wood)
    draw.put_text(mut g, row + 1, col, bottom, wood)
    if t == tier.RICH {
        var face = copy wood
        face.cp = if kind == 2 then 10294 else if kind == 3 then 9617 else 183
        grid.put(mut g, row + 1, col + 2, face)
    }
}

fn shore_finds(s: sim.Sim, t: int, mut g: grid.Grid) {
    if s.area != forest.SHINGLE { return }
    // Finds lie along the whole shore, eleven cells a slot, the seed
    // jittering each; none within eight cells of the spawn.
    let reach = forest.coast_extent(s.field)
    var slot = 0
    while slot * 11 < 2 * reach - 10 {
        let x = 4 - reach + slot * 11 + terrain.variant(s.seed, slot, 211, 3)
        let y = terrain.bank(s.seed, x) + terrain.REED_ROWS + 1
        var clear = x < -8 || x > 7
        var dx = 0
        while dx < 5 {
            var dy = 0
            while dy < 2 {
                if forest.kind(s.seed, s.field, s.area, x + dx, y + dy) != terrain.GRAVEL {
                    clear = false
                }
                dy += 1
            }
            dx += 1
        }
        if clear {
            draw_flotsam(
                mut g,
                t,
                y - sim.cell_y(s) + sim.screen_row(s),
                x - sim.cell_x(s) + sim.screen_col(s),
                (slot + terrain.variant(s.seed, 211, 0, 5)) % 5,
            )
        }
        slot += 1
    }
}

/// Both-tier coast study: logs, all five shore finds, full and empty bundles.
pub fn coast_sheet(t: int) -> grid.Grid {
    var g = grid.new(20, 80)
    var row = 0
    while row < g.rows {
        var col = 0
        while col < g.cols {
            grid.put(mut g, row, col, sprites.glyph(t, sprites.SP_GRAVEL, 0))
            col += 1
        }
        row += 1
    }
    draw.put_text(mut g, 1, 2, "hollow log      fallen log       bundle       opened", ink(t, true))
    draw_log(mut g, t, 3, 3, true)
    draw_log(mut g, t, 3, 19, false)
    draw_bundle(mut g, t, 3, 37, false)
    draw_bundle(mut g, t, 3, 50, true)
    draw.put_text(
        mut g,
        8,
        2,
        "driftwood    crate        kelp         bottle       net",
        ink(t, true),
    )
    var kind = 0
    while kind < 5 { draw_flotsam(mut g, t, 10, 4 + kind * 13, kind); kind += 1 }
    draw.put_text(mut g, 15, 2, "stone in water / forest beyond the bank", ink(t, true))
    var col = 3
    while col < 70 {
        grid.put(
            mut g,
            17,
            col,
            sprites.glyph(
                t,
                if col < 12 {
                    sprites.SP_ROCK
                } else if col < 35 {
                    sprites.SP_WATER
                } else {
                    sprites.SP_DARK
                },
                col % 4,
            ),
        )
        col += 1
    }
    g
}
