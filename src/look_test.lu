//! member: false

use art
use controls
use draw
use grid
use look
use props
use sim
use tier

fn test_cb04c_world_words_are_not_sprites() {
    for t in [tier.RICH, tier.PLAIN] {
        var s = sim.new(7, 80, 24)
        s.area = 1
        s.x = -10 * sim.FP
        s.y = 24 * sim.FP
        s.foes = List[sim.Foe]()
        var g = grid.new(24, 80)
        art.render(s, t, mut g)
        assert(look.no_labels(g), "world names must be original sprites")
        draw.put_text(mut g, 10, 10, "Ember", grid.cell(32, 7, 0, 0))
        assert(!look.no_labels(g), "the census must catch a planted name")
        assert(grid.plain_ok(props.sheet(tier.PLAIN)), "plain sprite clusters use console glyphs")
    }
}

fn test_cb04c_stamina_edge_is_reserved_after_c() {
    var s = sim.new(7, 80, 24)
    s.area = 1
    s.x = 22 * sim.FP
    s.y = 27 * sim.FP
    s.foes = List[sim.Foe]()
    var keys = List[int]()
    (mut keys).push(controls.KEY_DODGE)
    sim.step(mut s, keys)
    // The old bones label's c crossed the bar's right padding at this
    // camera position. Hold the camera explicitly: this is a layer witness.
    s.x = 22 * sim.FP
    s.y = 27 * sim.FP
    for t in [tier.RICH, tier.PLAIN] {
        var g = grid.new(24, 80)
        art.render(s, t, mut g)
        print("HUD after c tier {t}: row3 column22 codepoint {grid.at(g, 3, 22).cp}")
        // cb07: the bars sit flush on the map, so the cell beside the
        // stamina bar is the map's own; what may never show there is
        // lettering (the old bones label's c).
        var row = 0
        while row < 5 {
            let cp = grid.at(g, row, 22).cp
            assert(
                !(cp >= 65 && cp <= 90 || cp >= 97 && cp <= 122),
                "no lettering at the stamina edge after c",
            )
            // The ground's own cell (its glyph and colours; Bramblehold's
            // sight dims the attrs of far cells, `art.terrain_row`).
            let (wx, wy) = sim.world_cell(s, row, 22)
            let ground = art.ground_at(s.seed, s.field, s.area, t, wx, wy)
            let shown = grid.at(g, row, 22)
            assert(
                shown.cp == ground.cp && shown.fg == ground.fg && shown.bg == ground.bg,
                "the stamina edge is the ground's own cell (cb07)",
            )
            row += 1
        }
    }
}
