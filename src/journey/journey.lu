//! Versioned journey data, independent of frames and wall time. A save is
//! canonical text plus a checksum, bounded and validated before it is used.

use forest
use sim
use pouch
use std.fs

/// Named failures for DecodeErrors.
pub error DecodeErrors = {save_corrupt, save_version, save_difficulty}

/// Named failures for LoadErrors.
pub error LoadErrors = {save_io, save_corrupt, save_version, save_difficulty}

/// Named failures for PrepareErrors.
pub error PrepareErrors = {
    save_io,
    save_busy,
    save_cut,
    save_corrupt,
    save_version,
    save_difficulty,
}

/// Named failures for CommitErrors.
pub error CommitErrors = {save_io, save_committed_unsynced}

/// Schema six wraps schema five's ordinary-foe masks with name and played_ms.
/// Schema five migrates with default metadata; schema four also gets empty
/// masks. Earlier shapes remain named save_version failures.
pub const VERSION: int = 6

/// Metadata belongs to the save wrapper, not deterministic simulation state.
pub struct Metadata { name: str, played_ms: int }

/// Portable display names are filename tokens, never paths or whitespace.
pub fn valid_name(name: str) -> bool {
    if name.len == 0 || name.len > 64 { return false }
    for b in name.bytes() {
        let n = b as int
        if !(
            n >= 65 && n <= 90 || n >= 97 && n <= 122 || n >= 48 && n <= 57 || n == 45 || n == 95
        ) {
            return false
        }
    }
    true
}

/// Legacy saves migrate with these defaults; decode validates the full shape.
pub fn metadata(text: str) -> Metadata ! DecodeErrors {
    var result = Metadata { name: "journey", played_ms: 0 }
    if !text.starts_with("CUB 6\n") { return result }
    for line in text.lines() {
        if line.starts_with("name ") { result.name = line[5..line.len] }
        if line.starts_with("played_ms ") {
            result.played_ms = line[10..line.len].to_int() else |_| { return save_corrupt }
        }
    }
    if !valid_name(result.name) || result.played_ms < 0 || result.played_ms > 1000000000000 {
        return save_corrupt
    }
    result
}

/// Preserve wrapper fields when resuming a path.
pub fn load_metadata(path: str) -> Metadata ! LoadErrors {
    let text = fs.read_text(path) else |e| match e {
        not_found => { return Metadata { name: "journey", played_ms: 0 } },
        denied => { return save_io },
        io => { return save_io },
        utf8 => { return save_corrupt },
    }
    metadata(text)?
}

/// Thirty-seven legacy values plus167 bounded item/lore/ground slots.
/// Metadata stays outside deterministic numeric replay snapshots.
pub const SNAPSHOT: int = 204

/// The replay's journey event version this build writes and reads.
pub const JOURNEY: int = 5

/// The widest field a save may name.
pub const FIELD_MAX: int = 10000

/// Canonical persistent state; health resets at the last den, slain foes do not.
pub fn payload(s: sim.Sim) -> str {
    payload_core(s, VERSION) + "name journey\nplayed_ms 0\n" + items_payload(s)
}

fn payload_core(s: sim.Sim, version: int) -> str {
    var masks = ""
    if version >= 5 {
        masks = "slain"
        var area = 0
        while area < forest.AREAS { masks += " {sim.slain_mask(s, area)}"; area += 1 }
        masks += "\n"
    }
    "CUB {version}\n" +
        "seed {s.seed} difficulty {s.difficulty}\n" +
        "growth {s.heart} {s.wind} {s.fang} {s.paw} {s.nose}\n" +
        "water {s.flask_max} scent {s.scent}\n" +
        "den {s.last_den} lit {s.lit_dens} shortcuts {s.shortcuts}\n" +
        "gate {if s.gate_open then 1 else 0} story {s.story} deaths {s.deaths}\n" +
        "mark {if s.mark then 1 else 0} {s.mark_area} {s.mark_x} {s.mark_y} {s.mark_scent}\n" +
        "cache {s.caches} pouch {s.yarrow} {s.marrow} opening {if s.opening_seen then 1 else 0}\n" +
        "field {s.field}\n" +
        "bosses {s.bosses} end {if s.end then 1 else 0} played {s.played} lost {s.lost}\n" +
        "level {sim.level(s)}\n" +
        masks
}

fn items_payload(s: sim.Sim) -> str {
    var text = "items {s.pouch.pine} {s.pouch.ice} {s.pouch.tuft} {s.pouch.uses} {s.pouch.seeded} {s.pouch.lore.len} {s.pouch.pickups.len}"
    for id in s.pouch.lore { text += " {id + 1}" }
    for item in s.pouch.pickups { text += " {pouch.pack(item)}" }
    text + "\n"
}

// Internal simulation-only form used to validate legacy cores and snapshots.
fn payload_version(s: sim.Sim, version: int) -> str {
    payload_core(s, version) + (if version >= 6 then items_payload(s) else "")
}

/// Small non-cryptographic corruption check; intermediate products fit int64.
pub fn checksum(text: str) -> int {
    var h = 7
    var i = 0
    while i < text.len { h = (h * 31 + text.bytes()[i] as int) % 1000000007; i += 1 }
    h
}

/// Byte-identical encoding for the same persistent journey.
pub fn encode(s: sim.Sim) -> str { encode_named(s, Metadata { name: "journey", played_ms: 0 }) }

/// Canonical CUB 6 wrapper around the unchanged CUB 5 simulation payload.
pub fn encode_named(s: sim.Sim, meta: Metadata) -> str {
    let text = payload_core(s, VERSION) + "name {meta.name}\nplayed_ms {meta.played_ms}\n" + items_payload(s)
    text + "check {checksum(text)}\n"
}

/// Reject malformed, unsupported, out-of-range and inconsistent data.
/// Only default wolf difficulty is playable in this build.
pub fn decode(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    if text.len > 16384 { return save_corrupt }
    if !text.starts_with("CUB 6\n") { return decode_core(text, cols, rows)? }
    let meta = metadata(text)?
    var lines = List[str]()
    for line in text.lines() { (mut lines).push(line) }
    // cb13's original fifteen-line wrapper migrates with an empty extension.
    if lines.len != 15 && lines.len != 16 { return save_corrupt }
    let extended = lines.len == 16
    var core = "CUB 6\n"
    var index = 1
    while index < 12 { core += lines[index] + "\n"; index += 1 }
    let inner = if extended then core + lines[14] + "\n" else core.replace("CUB 6\n", "CUB 5\n")
    let s = decode_core(inner + "check {checksum(inner)}\n", cols, rows)?
    let canonical = core + "name {meta.name}\nplayed_ms {meta.played_ms}\n" +
        (if extended then lines[14] + "\n" else "")
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    s
}

fn decode_core(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    if text.len > 16384 { return save_corrupt }
    var words = List[str]()
    for word in text.words() { (mut words).push(word) }
    if words.len < 2 || words[0] != "CUB" { return save_corrupt }
    if words[1] != "4" && words[1] != "5" && words[1] != "6" { return save_version }
    let version = words[1].to_int() else |_| { return save_corrupt }
    let count = if version == 4 then 55 else 56 + forest.AREAS
    if version < 6 && words.len != count || version == 6 && words.len < count + 8 {
        return save_corrupt
    }
    var values = List[int]()
    var i = 0
    while i < words.len {
        if i == 1 ||
            i == 3 ||
            i == 5 ||
            i >= 7 && i <= 11 ||
            i == 13 ||
            i == 15 ||
            i == 17 ||
            i == 19 ||
            i == 21 ||
            i == 23 ||
            i == 25 ||
            i == 27 ||
            i >= 29 && i <= 33 ||
            i == 35 ||
            i == 37 ||
            i == 38 ||
            i == 40 ||
            i == 42 ||
            i == 44 ||
            i == 46 ||
            i == 48 ||
            i == 50 ||
            i == 52 ||
            i == 54 {
            (mut values).push(words[i].to_int() else |_| { return save_corrupt })
        }
        i += 1
    }
    // Shape is verified by re-encoding too: unknown keys, trailing data and
    // alternative numeric spellings cannot sneak past the checksum.
    if values[1] < -1000000000 || values[1] > 1000000000 { return save_corrupt }
    var s = sim.new(values[1], cols, rows)
    if values[25] < forest.FIELD_MIN || values[25] > FIELD_MAX { return save_corrupt }
    s.field = values[25]
    s.difficulty = values[2]
    if s.difficulty != 0 { return save_difficulty }
    s.heart = values[3]
    s.wind = values[4]
    s.fang = values[5]
    s.paw = values[6]
    s.nose = values[7]
    s.flask_max = values[8]
    s.scent = values[9]
    s.last_den = values[10]
    s.lit_dens = values[11]
    s.shortcuts = values[12]
    s.gate_open = values[13] == 1
    s.story = values[14]
    s.deaths = values[15]
    s.mark = values[16] == 1
    s.mark_area = values[17]
    s.mark_x = values[18]
    s.mark_y = values[19]
    s.mark_scent = values[20]
    s.caches = values[21]
    s.yarrow = values[22]
    s.marrow = values[23]
    s.opening_seen = values[24] == 1
    s.bosses = values[26]
    s.end = values[27] == 1
    s.played = values[28]
    s.lost = values[29]
    if s.bosses < 0 ||
        s.bosses > 15 ||
        values[27] < 0 ||
        values[27] > 1 ||
        s.played < 0 ||
        s.played > 1000000000 ||
        s.lost < 0 ||
        s.lost > 1000000000 ||
        s.end && s.bosses / 8 % 2 == 0 ||
        s.shortcuts / 4 % 2 == 1 && s.bosses / 2 % 2 == 0 ||
        s.shortcuts / 8 % 2 == 1 && s.bosses / 4 % 2 == 0 {
        return save_corrupt
    }
    if s.caches < 0 ||
        s.caches > 65535 ||
        s.yarrow < 0 ||
        s.yarrow > 6 ||
        s.marrow < 0 ||
        s.marrow > 6 ||
        values[24] < 0 ||
        values[24] > 1 {
        return save_corrupt
    }
    i = 3
    while i <= 7 { if values[i] < 1 || values[i] > sim.STAT_MAX { return save_corrupt }; i += 1 }
    if values[30] != sim.level(s) { return save_corrupt }
    if s.seed < -1000000000 ||
        s.seed > 1000000000 ||
        s.flask_max != 0 && s.flask_max != 2 && s.flask_max != 3 ||
        s.scent < 0 ||
        s.scent > 1000000000 ||
        s.last_den < 0 ||
        !(forest.den_exists(s.last_den) || forest.den_retired(s.last_den)) ||
        s.lit_dens < 1 ||
        s.lit_dens > 65535 ||
        s.shortcuts < 0 ||
        s.shortcuts > 15 ||
        values[13] < 0 ||
        values[13] > 1 ||
        s.story < 0 ||
        s.story > 1 ||
        s.deaths < 0 ||
        s.deaths > 1000000000 ||
        values[16] < 0 ||
        values[16] > 1 ||
        s.mark_area < 0 ||
        s.mark_area >= forest.AREAS ||
        s.mark_x < -1000000000 ||
        s.mark_x > 1000000000 ||
        s.mark_y < -1000000000 ||
        s.mark_y > 1000000000 ||
        s.mark_scent < 0 ||
        s.mark_scent > 1000000000 {
        return save_corrupt
    }
    // Reserved ids may not appear as found until their locations exist; a
    // retired den (cb05) may, from before its retirement.
    var den = 0
    while den < forest.DEN_LIMIT {
        if !forest.den_exists(den) &&
            !forest.den_retired(den) &&
            sim.light_den(s.lit_dens, den) == s.lit_dens {
            return save_corrupt
        }
        den += 1
    }
    if sim.light_den(s.lit_dens, s.last_den) != s.lit_dens ||
        s.lit_dens % 2 != 1 ||
        !s.gate_open &&
            (s.last_den != 0 || s.shortcuts != 0 || s.story != 0 || s.mark && s.mark_area != 0) ||
        !s.mark && s.mark_scent != 0 {
        return save_corrupt
    }
    if s.mark &&
        forest.blocked(
            s.seed,
            s.field,
            s.mark_area,
            sim.floor_div(s.mark_x, sim.FP),
            sim.floor_div(s.mark_y, sim.FP),
        ) {
        return save_corrupt
    }
    if version >= 5 {
        var area = 0
        while area < forest.AREAS {
            let mask = words[54 + area].to_int() else |_| { return save_corrupt }
            let foes = sim.area_foes(s.seed, s.field, area, 15)
            var limit = 1
            for _ in foes { limit *= 2 }
            if mask < 0 || mask >= limit { return save_corrupt }
            s.slain[area] = mask
            area += 1
        }
    }
    if version >= 6 {
        var items = List[int]()
        let start = 55 + forest.AREAS
        var item = 0
        while item < 7 {
            (mut items).push(words[start + item].to_int() else |_| { return save_corrupt })
            item += 1
        }
        let lines = items[5]
        let ground = items[6]
        if lines < 0 ||
            lines > pouch.LORE_SLOTS ||
            ground < 0 ||
            ground > pouch.PICKUPS ||
            words.len != count + 8 + lines + ground {
            return save_corrupt
        }
        item = 0
        while item < pouch.LORE_SLOTS {
            (mut items).push(
                if item < lines {
                    words[start + 7 + item].to_int() else |_| { return save_corrupt }
                } else {
                    0
                },
            )
            item += 1
        }
        item = 0
        while item < pouch.PICKUPS {
            (mut items).push(
                if item < ground {
                    words[start + 7 + lines + item].to_int() else |_| { return save_corrupt }
                } else {
                    0
                },
            )
            item += 1
        }
        s.pouch = pouch.from_values(items, 0, forest.AREAS) else |_| { return save_corrupt }
        if s.yarrow > pouch.cap(pouch.YARROW) || s.marrow > pouch.cap(pouch.MARROW) {
            return save_corrupt
        }
    }
    let canonical = payload_version(s, version)
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    if s.yarrow > pouch.cap(pouch.YARROW) { s.yarrow = pouch.cap(pouch.YARROW) }
    if s.marrow > pouch.cap(pouch.MARROW) { s.marrow = pouch.cap(pouch.MARROW) }
    let remembered = copy s.slain
    sim.wake(mut s)
    s.slain = remembered
    sim.restore_foes(mut s)
    s.save_status = 2
    s.entered = 0
    s
}

/// Missing saves alone mean new journey; every other read failure is named.
pub fn load(path: str, seed: int, cols: int, rows: int) -> sim.Sim ! LoadErrors {
    let text = fs.read_text(path) else |e| match e {
        not_found => { return sim.new(seed, cols, rows) },
        denied => { return save_io },
        io => { return save_io },
        utf8 => { return save_corrupt },
    }
    decode(text, cols, rows)?
}

/// Stage exclusively in the destination directory, sync and close before
/// replacement. A stale/concurrent stage is a named failure, never truncated.
/// `cut` is the explicit fault witness: stop after half the bytes.
pub fn prepare(path: str, s: sim.Sim, cut: bool) -> () ! PrepareErrors {
    prepare_named(path, s, Metadata { name: "journey", played_ms: 0 }, cut)?
}

/// Same durable staging with the menu's independent metadata.
pub fn prepare_named(path: str, s: sim.Sim, meta: Metadata, cut: bool) -> () ! PrepareErrors {
    let text = encode_named(s, meta)
    let _ = decode(text, s.cols, s.rows)?
    let parent = fs.parent(path) else "."
    fs.create_dir_all(parent) else |_| { return save_io }
    let temp = path + ".pending"
    var file = fs.create_new(temp) else |e| match e {
        exists => { return save_busy },
        not_found => { return save_io },
        denied => { return save_io },
        io => { return save_io },
    }
    var bytes = List[byte]()
    var i = 0
    let count = if cut then text.len / 2 else text.len
    while i < count { (mut bytes).push(text.bytes()[i]); i += 1 }
    fs.write_chunk(mut file, bytes) else |_| {
        fs.close(take file) else |_| {}
        fs.remove(temp) else |_| {}
        return save_io
    }
    fs.sync(mut file) else |_| {
        fs.close(take file) else |_| {}
        fs.remove(temp) else |_| {}
        return save_io
    }
    fs.close(take file) else |_| { fs.remove(temp) else |_| {}; return save_io }
    if cut { fs.remove(temp) else |_| {}; return save_cut }
}

/// Cancel only this session's successfully prepared stage.
pub fn abort(path: str) -> () ! {save_io} {
    fs.remove(path + ".pending") else |_| { return save_io }
}

/// Same-directory rename is atomic on the supported Unix hosts. A directory
/// sync failure AFTER replacement is distinguished from an uncommitted save.
pub fn commit(path: str) -> () ! CommitErrors {
    fs.move_file(path + ".pending", path) else |_| { return save_io }
    fs.sync_dir(fs.parent(path) else ".") else |_| { return save_committed_unsynced }
}

/// Versioned replay snapshot uses the same validated journey representation.
pub fn snapshot(s: sim.Sim) -> List[int] {
    var values = List[int]()
    snapshot_into(s, mut values)
    values
}

/// Reuse a fixed-size numeric checkpoint; idle save comparison allocates nothing.
pub fn snapshot_into(s: sim.Sim, mut values: List[int]) {
    (mut values).reset()
    (mut values).push(s.seed)
    (mut values).push(s.difficulty)
    (mut values).push(s.heart)
    (mut values).push(s.wind)
    (mut values).push(s.fang)
    (mut values).push(s.paw)
    (mut values).push(s.nose)
    (mut values).push(s.flask_max)
    (mut values).push(s.scent)
    (mut values).push(s.last_den)
    (mut values).push(s.lit_dens)
    (mut values).push(s.shortcuts)
    (mut values).push(if s.gate_open then 1 else 0)
    (mut values).push(s.story)
    (mut values).push(s.deaths)
    (mut values).push(if s.mark then 1 else 0)
    (mut values).push(s.mark_area)
    (mut values).push(s.mark_x)
    (mut values).push(s.mark_y)
    (mut values).push(s.mark_scent)
    (mut values).push(s.caches)
    (mut values).push(s.yarrow)
    (mut values).push(s.marrow)
    (mut values).push(if s.opening_seen then 1 else 0)
    (mut values).push(s.field)
    (mut values).push(s.bosses)
    (mut values).push(if s.end then 1 else 0)
    (mut values).push(s.played)
    (mut values).push(s.lost)
    (mut values).push(sim.level(s))
    var area = 0
    while area < forest.AREAS { (mut values).push(sim.slain_mask(s, area)); area += 1 }
    pouch.snapshot_into(s.pouch, mut values)
}

/// Exact equality, never a hash: every canonical payload field is represented.
pub fn same_snapshot(a: List[int], b: List[int]) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len { if a[i] != b[i] { return false }; i += 1 }
    true
}

/// Validate a complete initial replay journey before applying it.
pub fn from_snapshot(v: List[int], cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    if v.len != SNAPSHOT && v.len != 37 && v.len != 30 || v[0] < -1000000000 || v[0] > 1000000000 {
        return save_corrupt
    }
    var s = sim.new(v[0], cols, rows)
    if v[24] < forest.FIELD_MIN || v[24] > FIELD_MAX { return save_corrupt }
    s.field = v[24]
    s.difficulty = v[1]
    s.heart = v[2]
    s.wind = v[3]
    s.fang = v[4]
    s.paw = v[5]
    s.nose = v[6]
    s.flask_max = v[7]
    s.scent = v[8]
    s.last_den = v[9]
    s.lit_dens = v[10]
    s.shortcuts = v[11]
    if v[12] < 0 ||
        v[12] > 1 ||
        v[15] < 0 ||
        v[15] > 1 ||
        v[23] < 0 ||
        v[23] > 1 ||
        v[26] < 0 ||
        v[26] > 1 {
        return save_corrupt
    }
    s.bosses = v[25]
    s.end = v[26] == 1
    s.played = v[27]
    s.lost = v[28]
    var stat = 2
    while stat <= 6 {
        if v[stat] < 1 || v[stat] > sim.STAT_MAX { return save_corrupt }
        stat += 1
    }
    if v[29] != sim.level(s) { return save_corrupt }
    s.gate_open = v[12] == 1
    s.story = v[13]
    s.deaths = v[14]
    s.mark = v[15] == 1
    s.mark_area = v[16]
    s.mark_x = v[17]
    s.mark_y = v[18]
    s.mark_scent = v[19]
    s.caches = v[20]
    s.yarrow = v[21]
    s.marrow = v[22]
    s.opening_seen = v[23] == 1
    if v.len >= 37 {
        var area = 0
        while area < forest.AREAS { s.slain[area] = v[30 + area]; area += 1 }
    }
    if v.len == SNAPSHOT {
        s.pouch = pouch.from_values(v, 37, forest.AREAS) else |_| { return save_corrupt }
    } else {
        if s.yarrow > pouch.cap(pouch.YARROW) { s.yarrow = pouch.cap(pouch.YARROW) }
        if s.marrow > pouch.cap(pouch.MARROW) { s.marrow = pouch.cap(pouch.MARROW) }
    }
    decode(encode(s), cols, rows)?
}
