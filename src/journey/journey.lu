//! Versioned journey data, independent of frames and wall time. A save is
//! canonical text plus a checksum, bounded and validated before it is used.

use forest
use npc
use sim
use pouch
use std.env
use std.fs

/// Named failures for DecodeErrors.
pub error DecodeErrors = {save_corrupt, save_version, save_difficulty}

/// Named failures for LoadErrors.
pub error LoadErrors = {save_io, save_corrupt, save_version, save_difficulty}

/// Named failures for PrepareErrors.
pub error PrepareErrors = {
    save_io,
    save_busy,
    save_cut,
    save_corrupt,
    save_version,
    save_difficulty,
}

/// Named failures for CommitErrors.
pub error CommitErrors = {save_io, save_committed_unsynced}

/// Schema six wraps schema five's ordinary-foe masks with name and played_ms,
/// followed by bounded items, lore and ground pickups. Original CUB6 wrappers
/// migrate with an empty extension; CUB5 also defaults metadata and CUB4 masks.
/// Schema seven (cb14) carries thirteen masks (the map's thirteen areas) and a
/// `gates` line (the burnt oak, the stone mouth) before the metadata; a CUB6,
/// CUB5 or CUB4 file migrates with empty masks for the six new areas and no
/// gate opened, its items, lore, name and time kept.
/// Schema eight (cb16) appends an `npcs` line after the items: what each
/// of the nine has said, the dead, Quill's perch and the NPCs' flags; a
/// CUB 7 (or older) file migrates with nothing said, the sett's open
/// shortcut as Dunmoss's dig and a seeded Bramblehold as Ember's tuft given
/// (cb15's provisional tuft was that tuft), and up to 48 found lore lines
/// (32 before).
/// Schema nine (cb19, R-cb18-3 B) appends a `thefts` line after the NPCs':
/// the item each of the Stand's three martens holds (by spawn, -1 none),
/// kept across rest, death and reload until the cub bites it back; a CUB 8
/// (or older) file migrates holding no theft.
pub const VERSION: int = 9

/// The areas a schema-five or schema-six file carried masks for.
pub const AREAS_V5: int = 7

/// Metadata belongs to the save wrapper, not deterministic simulation state.
pub struct Metadata { name: str, played_ms: int }

/// Portable display names are filename tokens, never paths or whitespace.
pub fn valid_name(name: str) -> bool {
    if name.len == 0 || name.len > 64 { return false }
    for b in name.bytes() {
        let n = b as int
        if !(
            n >= 65 && n <= 90 || n >= 97 && n <= 122 || n >= 48 && n <= 57 || n == 45 || n == 95
        ) {
            return false
        }
    }
    true
}

/// Legacy saves migrate with these defaults; decode validates the full shape.
pub fn metadata(text: str) -> Metadata ! DecodeErrors {
    var result = Metadata { name: "journey", played_ms: 0 }
    if !text.starts_with("CUB 6\n") &&
        !text.starts_with("CUB 7\n") &&
        !text.starts_with("CUB 8\n") &&
        !text.starts_with("CUB 9\n") {
        return result
    }
    for line in text.lines() {
        if line.starts_with("name ") { result.name = line[5..line.len] }
        if line.starts_with("played_ms ") {
            result.played_ms = line[10..line.len].to_int() else |_| { return save_corrupt }
        }
    }
    if !valid_name(result.name) || result.played_ms < 0 || result.played_ms > 1000000000000 {
        return save_corrupt
    }
    result
}

/// Preserve wrapper fields when resuming a path.
pub fn load_metadata(path: str) -> Metadata ! LoadErrors {
    let text = fs.read_text(path) else |e| match e {
        not_found => { return Metadata { name: "journey", played_ms: 0 } },
        denied => { return save_io },
        io => { return save_io },
        utf8 => { return save_corrupt },
    }
    metadata(text)?
}

/// Thirty values, a slain mask an area (`forest.AREAS`, thirteen since cb14;
/// a literal: the checked machine resolves no cross-module name at comptime),
/// the gates (cb14), 183 bounded item/lore/ground slots (cb15's, the lore
/// widened to 48 by cb16) and the NPCs' twelve (cb16: nine said-counts, the
/// dead, the perch, the flags), then cb19's three kept thefts. Metadata
/// stays outside deterministic numeric replay snapshots.
pub const SNAPSHOT: int = 242

/// A `journey 7` snapshot (cb16): no kept thefts.
pub const SNAPSHOT_V7: int = 239

/// A `journey 6` snapshot (cb14): thirty values, thirteen masks, the gates
/// and cb15's 167 slots (32 lore).
pub const SNAPSHOT_V6: int = 211

/// The NPC values a `journey 7` snapshot ends with.
pub const NPC_SLOTS: int = 12

/// A `journey 5` snapshot (cb15): thirty values, seven masks, the 167 slots.
pub const SNAPSHOT_V5: int = 204

/// A `journey 4` snapshot: thirty values and seven masks.
pub const SNAPSHOT_V4: int = 37

/// The replay's journey event version this build writes and reads; journey
/// 7, 6, 5, 4 and 3 snapshots are still read (cb19: journey 8 adds the
/// kept thefts).
pub const JOURNEY: int = 8

/// The widest field a save may name.
pub const FIELD_MAX: int = 10000

/// Canonical persistent state; health resets at the last den, slain foes do not.
pub fn payload(s: sim.Sim) -> str {
    payload_core(s, VERSION) +
        "name journey\nplayed_ms 0\n" +
        items_payload(s) +
        npcs_payload(s) +
        thefts_payload(s)
}

/// The kept thefts' line (cb19): the Stand's martens in spawn order, each
/// the pouch kind it holds or -1.
fn thefts_payload(s: sim.Sim) -> str {
    var text = "thefts"
    for k in s.thefts { text += " {k}" }
    text + "\n"
}

/// The NPCs' line (cb16): the said-counts, the dead mask, Quill's perch
/// (-1 for Larkmeadow's), the flags.
fn npcs_payload(s: sim.Sim) -> str {
    var text = "npcs"
    for n in s.npc_said { text += " {n}" }
    text + " dead {s.npc_dead} perch {s.npc_perch} flags {s.npc_flags}\n"
}

fn payload_core(s: sim.Sim, version: int) -> str {
    var masks = ""
    if version >= 5 {
        masks = "slain"
        var area = 0
        let areas = if version >= 7 then forest.AREAS else AREAS_V5
        while area < areas { masks += " {sim.slain_mask(s, area)}"; area += 1 }
        masks += "\n"
        if version >= 7 { masks += "gates {s.gates}\n" }
    }
    "CUB {version}\n" +
        "seed {s.seed} difficulty {s.difficulty}\n" +
        "growth {s.heart} {s.wind} {s.fang} {s.paw} {s.nose}\n" +
        "water {s.flask_max} scent {s.scent}\n" +
        "den {s.last_den} lit {s.lit_dens} shortcuts {s.shortcuts}\n" +
        "gate {if s.gate_open then 1 else 0} story {s.story} deaths {s.deaths}\n" +
        "mark {if s.mark then 1 else 0} {s.mark_area} {s.mark_x} {s.mark_y} {s.mark_scent}\n" +
        "cache {s.caches} pouch {s.yarrow} {s.marrow} opening {if s.opening_seen then 1 else 0}\n" +
        "field {s.field}\n" +
        "bosses {s.bosses} end {if s.end then 1 else 0} played {s.played} lost {s.lost}\n" +
        "level {sim.level(s)}\n" +
        masks
}

fn items_payload(s: sim.Sim) -> str {
    var text = "items {s.pouch.pine} {s.pouch.ice} {s.pouch.tuft} {s.pouch.uses} {s.pouch.seeded} {s.pouch.lore.len} {s.pouch.pickups.len}"
    for id in s.pouch.lore { text += " {id + 1}" }
    for item in s.pouch.pickups { text += " {pouch.pack(item)}" }
    text + "\n"
}

// Internal simulation-only form used to validate legacy cores and snapshots.
fn payload_version(s: sim.Sim, version: int) -> str {
    payload_core(s, version) + (if version >= 6 then items_payload(s) else "")
}

/// Small non-cryptographic corruption check; intermediate products fit int64.
pub fn checksum(text: str) -> int {
    var h = 7
    var i = 0
    while i < text.len { h = (h * 31 + text.bytes()[i] as int) % 1000000007; i += 1 }
    h
}

/// Byte-identical encoding for the same persistent journey.
pub fn encode(s: sim.Sim) -> str { encode_named(s, Metadata { name: "journey", played_ms: 0 }) }

/// Canonical CUB9 wrapper with metadata before the persistent item, NPC
/// and theft extensions.
pub fn encode_named(s: sim.Sim, meta: Metadata) -> str {
    let text = payload_core(s, VERSION) +
        "name {meta.name}\nplayed_ms {meta.played_ms}\n" +
        items_payload(s) +
        npcs_payload(s) +
        thefts_payload(s)
    text + "check {checksum(text)}\n"
}

/// Reject malformed, unsupported, out-of-range and inconsistent data.
/// Only default wolf difficulty is playable in this build.
pub fn decode(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    if text.len > 16384 { return save_corrupt }
    if text.starts_with("CUB 9\n") { return decode_nine(text, cols, rows)? }
    if text.starts_with("CUB 8\n") { return decode_eight(text, cols, rows)? }
    if text.starts_with("CUB 7\n") { return decode_seven(text, cols, rows)? }
    if !text.starts_with("CUB 6\n") { return decode_core(text, cols, rows, pouch.LORE_SLOTS_V6)? }
    let meta = metadata(text)?
    var lines = List[str]()
    for line in text.lines() { (mut lines).push(line) }
    // cb13's original fifteen-line wrapper migrates with an empty extension.
    if lines.len != 15 && lines.len != 16 { return save_corrupt }
    let extended = lines.len == 16
    var core = "CUB 6\n"
    var index = 1
    while index < 12 { core += lines[index] + "\n"; index += 1 }
    let inner = if extended then core + lines[14] + "\n" else core.replace("CUB 6\n", "CUB 5\n")
    let s = decode_core(inner + "check {checksum(inner)}\n", cols, rows, pouch.LORE_SLOTS_V6)?
    let canonical = core +
        "name {meta.name}\nplayed_ms {meta.played_ms}\n" +
        (if extended then lines[14] + "\n" else "")
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    s
}

/// CUB7: the core (thirteen lines: the version, ten state lines, the slain
/// masks, the gates), the name, played_ms, the items line, the check.
fn decode_seven(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    let meta = metadata(text)?
    var lines = List[str]()
    for line in text.lines() { (mut lines).push(line) }
    if lines.len != 17 { return save_corrupt }
    var core = ""
    var index = 0
    while index < 13 { core += lines[index] + "\n"; index += 1 }
    let inner = core + lines[15] + "\n"
    let s = decode_core(inner + "check {checksum(inner)}\n", cols, rows, pouch.LORE_SLOTS_V6)?
    let canonical = core + "name {meta.name}\nplayed_ms {meta.played_ms}\n" + lines[15] + "\n"
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    s
}

/// CUB8 (cb16): CUB7's lines with the `npcs` line between the items and
/// the check. The core is read as CUB7's (its checksum re-made), the NPCs'
/// values validated, then the whole re-encoded must be the text.
fn decode_eight(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    let meta = metadata(text)?
    var lines = List[str]()
    for line in text.lines() { (mut lines).push(line) }
    if lines.len != 18 { return save_corrupt }
    var core = "CUB 7\n"
    var index = 1
    while index < 13 { core += lines[index] + "\n"; index += 1 }
    let inner = core + lines[15] + "\n"
    var s = decode_core(inner + "check {checksum(inner)}\n", cols, rows, pouch.LORE_SLOTS)?
    var words = List[str]()
    for word in lines[16].words() { (mut words).push(word) }
    if words.len != 16 ||
        words[0] != "npcs" ||
        words[10] != "dead" ||
        words[12] != "perch" ||
        words[14] != "flags" {
        return save_corrupt
    }
    var said = List[int]()
    var who = 0
    while who < npc.COUNT {
        (mut said).push(words[1 + who].to_int() else |_| { return save_corrupt })
        who += 1
    }
    let dead = words[11].to_int() else |_| { return save_corrupt }
    let perch = words[13].to_int() else |_| { return save_corrupt }
    let flags = words[15].to_int() else |_| { return save_corrupt }
    if !npcs_valid(s, said, dead, perch, flags) { return save_corrupt }
    s.npc_said = said
    s.npc_dead = dead
    s.npc_perch = perch
    s.npc_flags = flags
    let canonical = core.replace("CUB 7\n", "CUB 8\n") +
        "name {meta.name}\nplayed_ms {meta.played_ms}\n" +
        lines[15] +
        "\n" +
        npcs_payload(s)
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    s
}

/// CUB9 (cb19): CUB8's lines with the `thefts` line between the NPCs' and
/// the check. The rest is read as CUB8's (its checksum re-made), the
/// thefts validated and given back to the Stand's martens, then the text's
/// own lines re-made must be the text (as CUB8's are: a decode may move
/// what the core holds, a retired last den waking at a kept one, so the
/// journey's re-encoding is not the canonical form).
fn decode_nine(text: str, cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    let _ = metadata(text)?
    var lines = List[str]()
    for line in text.lines() { (mut lines).push(line) }
    if lines.len != 19 { return save_corrupt }
    var eight = "CUB 8\n"
    var index = 1
    while index < 17 { eight += lines[index] + "\n"; index += 1 }
    var s = decode_eight(eight + "check {checksum(eight)}\n", cols, rows)?
    var words = List[str]()
    for word in lines[17].words() { (mut words).push(word) }
    if words.len != 1 + sim.MARTEN_SLOTS || words[0] != "thefts" { return save_corrupt }
    var thefts = List[int]()
    var k = 0
    while k < sim.MARTEN_SLOTS {
        (mut thefts).push(words[1 + k].to_int() else |_| { return save_corrupt })
        k += 1
    }
    if !sim.thefts_valid(thefts) { return save_corrupt }
    s.thefts = thefts
    sim.apply_thefts(mut s)
    var canonical = "CUB 9\n"
    index = 1
    while index < 17 { canonical += lines[index] + "\n"; index += 1 }
    canonical += thefts_payload(s)
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    s
}

/// The NPCs' values a journey may hold (cb16): each said-count within its
/// lines, the dead and the flags within their bits, Quill's perch -1 or a
/// den he perches at that the journey has lit, after his first line; the
/// sett's shortcut open only once Dunmoss has dug it; Ember's mouthful
/// after her second line, the story after the Hermit's first, Quill's tuft
/// after his first.
pub fn npcs_valid(s: sim.Sim, said: List[int], dead: int, perch: int, flags: int) -> bool {
    if said.len != npc.COUNT { return false }
    var who = 0
    while who < npc.COUNT {
        if said[who] < 0 || said[who] > npc.lines(who) { return false }
        who += 1
    }
    if dead < 0 || dead >= npc.DEAD_LIMIT || flags < 0 || flags >= npc.FLAGS_LIMIT { return false }
    if perch != -1 {
        if !npc.perch_den(perch) ||
            sim.light_den(s.lit_dens, perch) != s.lit_dens ||
            said[npc.QUILL] < 1 {
            return false
        }
    }
    let sett = forest.shortcut_bit(forest.EDGE_SETT)
    if s.shortcuts / sett % 2 == 1 && flags / npc.DUG % 2 == 0 { return false }
    if flags / npc.STOLEN % 2 == 1 && said[npc.EMBER] < 2 { return false }
    if flags / npc.STORY % 2 == 1 && said[npc.HERMIT] < 1 { return false }
    if flags / npc.TUFT_SOLD % 2 == 1 && said[npc.QUILL] < 1 { return false }
    true
}

/// A journey from before cb16 meets the NPCs (CUB 7 and older, `journey 6`
/// and older): nothing said, none dead, Quill at Larkmeadow; the sett's
/// open shortcut was dug (the squeeze was its only gate then); a seeded
/// Bramblehold already holds or held cb15's provisional tuft, which is
/// Ember's (R-cb16-3 A), so she gives no second.
pub fn migrate_npcs(mut s: sim.Sim) {
    let sett = forest.shortcut_bit(forest.EDGE_SETT)
    if s.shortcuts / sett % 2 == 1 && s.npc_flags / npc.DUG % 2 == 0 { s.npc_flags += npc.DUG }
    if s.pouch.seeded / pouch.bit(forest.BRAMBLEHOLD) % 2 == 1 &&
        s.npc_flags / npc.TUFT_GIVEN % 2 == 0 {
        s.npc_flags += npc.TUFT_GIVEN
    }
}

fn decode_core(text: str, cols: int, rows: int, lore_max: int) -> sim.Sim ! DecodeErrors {
    if text.len > 16384 { return save_corrupt }
    var words = List[str]()
    for word in text.words() { (mut words).push(word) }
    if words.len < 2 || words[0] != "CUB" { return save_corrupt }
    if words[1] != "4" && words[1] != "5" && words[1] != "6" && words[1] != "7" {
        return save_version
    }
    let version = words[1].to_int() else |_| { return save_corrupt }
    let areas = if version >= 7 then forest.AREAS else AREAS_V5
    let count = if version == 4 then 55 else if version <= 6 then 56 + areas else 58 + areas
    if version < 6 && words.len != count || version >= 6 && words.len < count + 8 {
        return save_corrupt
    }
    var values = List[int]()
    var i = 0
    while i < words.len {
        if i == 1 ||
            i == 3 ||
            i == 5 ||
            i >= 7 && i <= 11 ||
            i == 13 ||
            i == 15 ||
            i == 17 ||
            i == 19 ||
            i == 21 ||
            i == 23 ||
            i == 25 ||
            i == 27 ||
            i >= 29 && i <= 33 ||
            i == 35 ||
            i == 37 ||
            i == 38 ||
            i == 40 ||
            i == 42 ||
            i == 44 ||
            i == 46 ||
            i == 48 ||
            i == 50 ||
            i == 52 ||
            i == 54 {
            (mut values).push(words[i].to_int() else |_| { return save_corrupt })
        }
        i += 1
    }
    // Shape is verified by re-encoding too: unknown keys, trailing data and
    // alternative numeric spellings cannot sneak past the checksum.
    if values[1] < -1000000000 || values[1] > 1000000000 { return save_corrupt }
    var s = sim.new(values[1], cols, rows)
    if values[25] < forest.FIELD_MIN || values[25] > FIELD_MAX { return save_corrupt }
    s.field = values[25]
    s.difficulty = values[2]
    if s.difficulty != 0 { return save_difficulty }
    s.heart = values[3]
    s.wind = values[4]
    s.fang = values[5]
    s.paw = values[6]
    s.nose = values[7]
    s.flask_max = values[8]
    s.scent = values[9]
    s.last_den = values[10]
    s.lit_dens = values[11]
    s.shortcuts = values[12]
    s.gate_open = values[13] == 1
    s.story = values[14]
    s.deaths = values[15]
    s.mark = values[16] == 1
    s.mark_area = values[17]
    s.mark_x = values[18]
    s.mark_y = values[19]
    s.mark_scent = values[20]
    s.caches = values[21]
    s.yarrow = values[22]
    s.marrow = values[23]
    s.opening_seen = values[24] == 1
    s.bosses = values[26]
    s.end = values[27] == 1
    s.played = values[28]
    s.lost = values[29]
    if s.bosses < 0 ||
        s.bosses > 15 ||
        values[27] < 0 ||
        values[27] > 1 ||
        s.played < 0 ||
        s.played > 1000000000 ||
        s.lost < 0 ||
        s.lost > 1000000000 ||
        s.end && s.bosses / 8 % 2 == 0 ||
        s.shortcuts / 4 % 2 == 1 && s.bosses / 2 % 2 == 0 ||
        s.shortcuts / 8 % 2 == 1 && s.bosses / 4 % 2 == 0 {
        return save_corrupt
    }
    if s.caches < 0 ||
        s.caches >= cache_limit() ||
        s.yarrow < 0 ||
        s.yarrow > 6 ||
        s.marrow < 0 ||
        s.marrow > 6 ||
        values[24] < 0 ||
        values[24] > 1 {
        return save_corrupt
    }
    i = 3
    while i <= 7 { if values[i] < 1 || values[i] > sim.STAT_MAX { return save_corrupt }; i += 1 }
    if values[30] != sim.level(s) { return save_corrupt }
    if s.seed < -1000000000 ||
        s.seed > 1000000000 ||
        s.flask_max != 0 && s.flask_max != 2 && s.flask_max != 3 ||
        s.scent < 0 ||
        s.scent > 1000000000 ||
        s.last_den < 0 ||
        !(forest.den_exists(s.last_den) || forest.den_retired(s.last_den)) ||
        s.lit_dens < 1 ||
        s.lit_dens > 65535 ||
        s.shortcuts < 0 ||
        s.shortcuts > forest.SHORTCUTS_ALL ||
        // The sett's squeeze is a growth gate (cb14, R-cb14-2 A): a journey
        // that went through it has the paw for it.
        s.shortcuts / 128 % 2 == 1 && s.paw < sim.UNDERTEETH_PAW ||
        values[13] < 0 ||
        values[13] > 1 ||
        s.story < 0 ||
        s.story > 1 ||
        s.deaths < 0 ||
        s.deaths > 1000000000 ||
        values[16] < 0 ||
        values[16] > 1 ||
        s.mark_area < 0 ||
        s.mark_area >= forest.AREAS ||
        s.mark_x < -1000000000 ||
        s.mark_x > 1000000000 ||
        s.mark_y < -1000000000 ||
        s.mark_y > 1000000000 ||
        s.mark_scent < 0 ||
        s.mark_scent > 1000000000 {
        return save_corrupt
    }
    // Reserved ids may not appear as found until their locations exist; a
    // retired den (cb05) may, from before its retirement.
    var den = 0
    while den < forest.DEN_LIMIT {
        if !forest.den_exists(den) &&
            !forest.den_retired(den) &&
            sim.light_den(s.lit_dens, den) == s.lit_dens {
            return save_corrupt
        }
        den += 1
    }
    if sim.light_den(s.lit_dens, s.last_den) != s.lit_dens ||
        s.lit_dens % 2 != 1 ||
        !s.gate_open &&
            (s.last_den != 0 || s.shortcuts != 0 || s.story != 0 || s.mark && s.mark_area != 0) ||
        !s.mark && s.mark_scent != 0 {
        return save_corrupt
    }
    if s.mark &&
        forest.blocked(
            s.seed,
            s.field,
            s.mark_area,
            sim.floor_div(s.mark_x, sim.FP),
            sim.floor_div(s.mark_y, sim.FP),
        ) {
        return save_corrupt
    }
    if version >= 5 {
        var area = 0
        while area < areas {
            let mask = words[54 + area].to_int() else |_| { return save_corrupt }
            // The count alone (cb18: placing the six in every area of
            // every decode ran the checked machine's budget out).
            var n = sim.area_foe_count(s.seed, s.field, area, 15)
            var limit = 1
            while n > 0 {
                limit *= 2
                n -= 1
            }
            if mask < 0 || mask >= limit { return save_corrupt }
            s.slain[area] = mask
            area += 1
        }
        if version >= 7 {
            if words[54 + areas] != "gates" { return save_corrupt }
            let gates = words[55 + areas].to_int() else |_| { return save_corrupt }
            if gates < 0 || gates > sim.GATE_OAK + sim.GATE_MOUTH { return save_corrupt }
            s.gates = gates
        }
    }
    if version >= 6 {
        var items = List[int]()
        let start = (if version >= 7 then 57 else 55) + areas
        var item = 0
        while item < 7 {
            (mut items).push(words[start + item].to_int() else |_| { return save_corrupt })
            item += 1
        }
        let lines = items[5]
        let ground = items[6]
        if lines < 0 ||
            lines > lore_max ||
            ground < 0 ||
            ground > pouch.PICKUPS ||
            words.len != count + 8 + lines + ground {
            return save_corrupt
        }
        item = 0
        while item < pouch.LORE_SLOTS {
            (mut items).push(
                if item < lines {
                    words[start + 7 + item].to_int() else |_| { return save_corrupt }
                } else {
                    0
                },
            )
            item += 1
        }
        item = 0
        while item < pouch.PICKUPS {
            (mut items).push(
                if item < ground {
                    words[start + 7 + lines + item].to_int() else |_| { return save_corrupt }
                } else {
                    0
                },
            )
            item += 1
        }
        s.pouch = pouch.from_values(items, 0, areas) else |_| { return save_corrupt }
        if s.yarrow > pouch.cap(pouch.YARROW) || s.marrow > pouch.cap(pouch.MARROW) {
            return save_corrupt
        }
    }
    let canonical = payload_version(s, version)
    if canonical + "check {checksum(canonical)}\n" != text { return save_corrupt }
    if s.yarrow > pouch.cap(pouch.YARROW) { s.yarrow = pouch.cap(pouch.YARROW) }
    if s.marrow > pouch.cap(pouch.MARROW) { s.marrow = pouch.cap(pouch.MARROW) }
    let remembered = copy s.slain
    sim.wake(mut s)
    s.slain = remembered
    sim.restore_foes(mut s)
    s.save_status = 2
    s.entered = 0
    // The CUB8 reader sets the NPCs' own values over these.
    migrate_npcs(mut s)
    s
}

/// The oldest save this cub reads (CUB 4 migrates; CUB 1 to 3 are the
/// tutorial era's and are refused by name).
pub const OLDEST: int = 4

/// The version a save's text names on its first line (`CUB N`), or -1 when
/// the text is not a cub save at all.
pub fn version_of(text: str) -> int {
    var words = List[str]()
    for line in text.lines() {
        for word in line.words() { (mut words).push(word) }
        break
    }
    if words.len != 2 || words[0] != "CUB" { return -1 }
    let n = words[1].to_int() else |_| { return -1 }
    if n < 0 then -1 else n
}

/// The version found in the save at `path` (`version_of`), -1 when it
/// cannot be read or is not a cub save.
pub fn version_at(path: str) -> int {
    let text = fs.read_text(path) else |_| { return -1 }
    version_of(text)
}

/// A path as a sentence shows it (cb19): under the home directory as
/// `~/...` (the home's resolved form too), anything else whole.
pub fn shown(path: str) -> str {
    let home = env.get("HOME") else ""
    if home == "" { return path }
    for h in [home, fs.realpath(home) else home] {
        if path.starts_with(h + "/") { return "~" + path[h.len..path.len] }
    }
    path
}

/// What a save is, for a sentence: "a CUB 1 save" or "not a cub save".
pub fn found(version: int) -> str {
    if version < 0 then "not a cub save" else "a CUB {version} save"
}

/// The versions this cub reads, for a sentence.
pub fn wanted() -> str { "this cub reads CUB {OLDEST} to CUB {VERSION}" }

/// The sentence a refused save gets (cb19, cub#91 A (c), cub#50): the file,
/// the version found, the versions this cub reads and what to do, never a
/// bare error name; the name stays in brackets at the end for a search.
/// `error` is the refusal's name (`save_version`, `save_corrupt`,
/// `save_difficulty`, `save_io`); `path` the file refused.
pub fn refusal(path: str, error: str) -> str { refusal_of(shown(path), version_at(path), error) }

/// `refusal`'s sentence for a file shown as `file` whose first line names
/// `v` (-1: not a cub save).
pub fn refusal_of(file: str, v: int, error: str) -> str {
    let what = if error == "save_version" {
        if v >= 0 && v < OLDEST {
            "{file} is {found(v)}, from an older cub; {wanted()}. Start a new journey with --save ANOTHER_PATH, or move the old file aside"
        } else if v > VERSION {
            "{file} is {found(v)}, from a newer cub; {wanted()}. Play it with that cub, or start a new journey here with --save ANOTHER_PATH"
        } else {
            "{file} is {found(v)}; {wanted()}. Start a new journey with --save ANOTHER_PATH, or move the file aside"
        }
    } else if error == "save_corrupt" {
        "{file} is {found(v)} that does not read back whole (its check or a line is wrong); {wanted()}. Move it aside and start a new journey with --save ANOTHER_PATH"
    } else if error == "save_difficulty" {
        "{file} is {found(v)} on a difficulty this build does not play; {wanted()} on wolf alone. Start a new journey with --save ANOTHER_PATH"
    } else if error == "save_io" {
        "{file} could not be read as a file; {wanted()}. Check that it is a readable file, or start a new journey with --save ANOTHER_PATH"
    } else {
        "{file} was refused; {wanted()}. Start a new journey with --save ANOTHER_PATH"
    }
    "{what}. It was not changed. [{error}]"
}

/// The sentence a failed save write gets (cb19): the file, what happened
/// and what to do; the previous journey on disk is named as kept when it is.
pub fn write_failure(path: str, error: str) -> str {
    let what = if error == "save_busy" {
        "{shown(path)}.pending already exists: another cub is saving this journey, or one stopped mid-write. The previous save is kept; remove the .pending file once no cub is running"
    } else if error == "save_cut" {
        "{shown(path)} was not replaced: the write was cut on purpose (--save-cut). The previous save is kept"
    } else if error == "save_committed_unsynced" {
        "{shown(path)} was written, but its directory could not be synced: the new save is in place and may not survive a power cut"
    } else if error == "save_io" {
        "{shown(path)} could not be written. The previous save is kept; check the directory exists and is writable"
    } else if error == "save_version" || error == "save_corrupt" || error == "save_difficulty" {
        "{shown(path)} did not read back as a CUB {VERSION} save after it was staged. The previous save is kept"
    } else {
        "{shown(path)} could not be saved. The previous save is kept"
    }
    "{what}. [{error}]"
}

/// Missing saves alone mean new journey; every other read failure is named.
pub fn load(path: str, seed: int, cols: int, rows: int) -> sim.Sim ! LoadErrors {
    let text = fs.read_text(path) else |e| match e {
        not_found => { return sim.new(seed, cols, rows) },
        denied => { return save_io },
        io => { return save_io },
        utf8 => { return save_corrupt },
    }
    decode(text, cols, rows)?
}

/// Stage exclusively in the destination directory, sync and close before
/// replacement. A stale/concurrent stage is a named failure, never truncated.
/// `cut` is the explicit fault witness: stop after half the bytes.
pub fn prepare(path: str, s: sim.Sim, cut: bool) -> () ! PrepareErrors {
    prepare_named(path, s, Metadata { name: "journey", played_ms: 0 }, cut)?
}

/// Same durable staging with the menu's independent metadata.
pub fn prepare_named(path: str, s: sim.Sim, meta: Metadata, cut: bool) -> () ! PrepareErrors {
    let text = encode_named(s, meta)
    let _ = decode(text, s.cols, s.rows)?
    let parent = fs.parent(path) else "."
    fs.create_dir_all(parent) else |_| { return save_io }
    let temp = path + ".pending"
    var file = fs.create_new(temp) else |e| match e {
        exists => { return save_busy },
        not_found => { return save_io },
        denied => { return save_io },
        io => { return save_io },
    }
    var bytes = List[byte]()
    var i = 0
    let count = if cut then text.len / 2 else text.len
    while i < count { (mut bytes).push(text.bytes()[i]); i += 1 }
    fs.write_chunk(mut file, bytes) else |_| {
        fs.close(take file) else |_| {}
        fs.remove(temp) else |_| {}
        return save_io
    }
    fs.sync(mut file) else |_| {
        fs.close(take file) else |_| {}
        fs.remove(temp) else |_| {}
        return save_io
    }
    fs.close(take file) else |_| { fs.remove(temp) else |_| {}; return save_io }
    if cut { fs.remove(temp) else |_| {}; return save_cut }
}

/// Cancel only this session's successfully prepared stage.
pub fn abort(path: str) -> () ! {save_io} {
    fs.remove(path + ".pending") else |_| { return save_io }
}

/// Same-directory rename is atomic on the supported Unix hosts. A directory
/// sync failure AFTER replacement is distinguished from an uncommitted save.
pub fn commit(path: str) -> () ! CommitErrors {
    fs.move_file(path + ".pending", path) else |_| { return save_io }
    fs.sync_dir(fs.parent(path) else ".") else |_| { return save_committed_unsynced }
}

/// Versioned replay snapshot uses the same validated journey representation.
pub fn snapshot(s: sim.Sim) -> List[int] {
    var values = List[int]()
    snapshot_into(s, mut values)
    values
}

/// Reuse a fixed-size numeric checkpoint; idle save comparison allocates nothing.
pub fn snapshot_into(s: sim.Sim, mut values: List[int]) {
    (mut values).reset()
    (mut values).push(s.seed)
    (mut values).push(s.difficulty)
    (mut values).push(s.heart)
    (mut values).push(s.wind)
    (mut values).push(s.fang)
    (mut values).push(s.paw)
    (mut values).push(s.nose)
    (mut values).push(s.flask_max)
    (mut values).push(s.scent)
    (mut values).push(s.last_den)
    (mut values).push(s.lit_dens)
    (mut values).push(s.shortcuts)
    (mut values).push(if s.gate_open then 1 else 0)
    (mut values).push(s.story)
    (mut values).push(s.deaths)
    (mut values).push(if s.mark then 1 else 0)
    (mut values).push(s.mark_area)
    (mut values).push(s.mark_x)
    (mut values).push(s.mark_y)
    (mut values).push(s.mark_scent)
    (mut values).push(s.caches)
    (mut values).push(s.yarrow)
    (mut values).push(s.marrow)
    (mut values).push(if s.opening_seen then 1 else 0)
    (mut values).push(s.field)
    (mut values).push(s.bosses)
    (mut values).push(if s.end then 1 else 0)
    (mut values).push(s.played)
    (mut values).push(s.lost)
    (mut values).push(sim.level(s))
    var area = 0
    while area < forest.AREAS { (mut values).push(sim.slain_mask(s, area)); area += 1 }
    (mut values).push(s.gates)
    pouch.snapshot_into(s.pouch, mut values)
    for n in s.npc_said { (mut values).push(n) }
    (mut values).push(s.npc_dead)
    (mut values).push(s.npc_perch)
    (mut values).push(s.npc_flags)
    for k in s.thefts { (mut values).push(k) }
}

/// One past the widest `caches` word a journey may hold: every cache bit
/// (`forest.CACHE_BITS`) set.
pub fn cache_limit() -> int {
    var limit = 1
    var i = 0
    while i < forest.CACHE_BITS { limit *= 2; i += 1 }
    limit
}

/// Exact equality, never a hash: every canonical payload field is represented.
pub fn same_snapshot(a: List[int], b: List[int]) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len { if a[i] != b[i] { return false }; i += 1 }
    true
}

/// Validate a complete initial replay journey before applying it.
pub fn from_snapshot(v: List[int], cols: int, rows: int) -> sim.Sim ! DecodeErrors {
    if v.len != SNAPSHOT &&
        v.len != SNAPSHOT_V7 &&
        v.len != SNAPSHOT_V6 &&
        v.len != SNAPSHOT_V5 &&
        v.len != SNAPSHOT_V4 &&
        v.len != 30 ||
        v[0] < -1000000000 ||
        v[0] > 1000000000 {
        return save_corrupt
    }
    var s = sim.new(v[0], cols, rows)
    if v[24] < forest.FIELD_MIN || v[24] > FIELD_MAX { return save_corrupt }
    s.field = v[24]
    s.difficulty = v[1]
    s.heart = v[2]
    s.wind = v[3]
    s.fang = v[4]
    s.paw = v[5]
    s.nose = v[6]
    s.flask_max = v[7]
    s.scent = v[8]
    s.last_den = v[9]
    s.lit_dens = v[10]
    s.shortcuts = v[11]
    if v[12] < 0 ||
        v[12] > 1 ||
        v[15] < 0 ||
        v[15] > 1 ||
        v[23] < 0 ||
        v[23] > 1 ||
        v[26] < 0 ||
        v[26] > 1 {
        return save_corrupt
    }
    s.bosses = v[25]
    s.end = v[26] == 1
    s.played = v[27]
    s.lost = v[28]
    var stat = 2
    while stat <= 6 {
        if v[stat] < 1 || v[stat] > sim.STAT_MAX { return save_corrupt }
        stat += 1
    }
    if v[29] != sim.level(s) { return save_corrupt }
    s.gate_open = v[12] == 1
    s.story = v[13]
    s.deaths = v[14]
    s.mark = v[15] == 1
    s.mark_area = v[16]
    s.mark_x = v[17]
    s.mark_y = v[18]
    s.mark_scent = v[19]
    s.caches = v[20]
    s.yarrow = v[21]
    s.marrow = v[22]
    s.opening_seen = v[23] == 1
    if v.len == SNAPSHOT_V4 || v.len == SNAPSHOT_V5 {
        var area = 0
        while area < AREAS_V5 { s.slain[area] = v[30 + area]; area += 1 }
    }
    if v.len == SNAPSHOT || v.len == SNAPSHOT_V7 || v.len == SNAPSHOT_V6 {
        var area = 0
        while area < forest.AREAS { s.slain[area] = v[30 + area]; area += 1 }
        s.gates = v[30 + forest.AREAS]
    }
    if v.len == SNAPSHOT || v.len == SNAPSHOT_V7 {
        s.pouch = pouch.from_values(v, 31 + forest.AREAS, forest.AREAS) else |_| {
            return save_corrupt
        }
        let at = 31 + forest.AREAS + pouch.SAVE_SLOTS
        var said = List[int]()
        var who = 0
        while who < npc.COUNT { (mut said).push(v[at + who]); who += 1 }
        if !npcs_valid(s, said, v[at + npc.COUNT], v[at + npc.COUNT + 1], v[at + npc.COUNT + 2]) {
            return save_corrupt
        }
        s.npc_said = said
        s.npc_dead = v[at + npc.COUNT]
        s.npc_perch = v[at + npc.COUNT + 1]
        s.npc_flags = v[at + npc.COUNT + 2]
        // A journey 8 snapshot ends with the kept thefts (cb19); a journey
        // 7 one holds none.
        if v.len == SNAPSHOT {
            var thefts = List[int]()
            var k = 0
            while k < sim.MARTEN_SLOTS { (mut thefts).push(v[SNAPSHOT_V7 + k]); k += 1 }
            if !sim.thefts_valid(thefts) { return save_corrupt }
            s.thefts = thefts
        }
    } else if v.len == SNAPSHOT_V6 {
        s.pouch = pouch.from_values_sized(
            v,
            31 + forest.AREAS,
            forest.AREAS,
            pouch.LORE_SLOTS_V6,
        ) else |_| {
            return save_corrupt
        }
        migrate_npcs(mut s)
    } else if v.len == SNAPSHOT_V5 {
        s.pouch = pouch.from_values_sized(v, SNAPSHOT_V4, AREAS_V5, pouch.LORE_SLOTS_V6) else |_| {
            return save_corrupt
        }
        migrate_npcs(mut s)
    } else {
        if s.yarrow > pouch.cap(pouch.YARROW) { s.yarrow = pouch.cap(pouch.YARROW) }
        if s.marrow > pouch.cap(pouch.MARROW) { s.marrow = pouch.cap(pouch.MARROW) }
    }
    decode(encode(s), cols, rows)?
}
