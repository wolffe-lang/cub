//! sim — the cub on the Shingle: a position, a heading, a speed and the
//! held keys that steer them, over `terrain`'s ground, with the camera on
//! the cub (ruling #130, R-CB-3: a scrolling world, not screens). Pure and
//! deterministic: a run is a function of the seed and the keys by tick
//! (the track's rule 3), which is what the goldens pin.
//!
//! The realism bars (the campaign's): the cub has a position in fixed
//! point, a heading that turns at `TURN_RATE` toward the held direction
//! (it never pivots), a speed that rises at `ACCEL` and falls at `BRAKE`;
//! a key is held by the engine's model from its autorepeat ticks alone.
//! Trunks, deep forest and the Ashwater stop it. The stats of section 3 are
//! here as the first constants (every number `docs/DESIGN.md`'s, proposed;
//! R-CB-7: the maintainer's by play): the scaffold moves a fresh cub with
//! heart, wind, fang, paw and nose at 1; the fight, den and scent loop follows below.

use controls
use forest
use meadow
use input
use silhouette
use terrain
use world

/// Fixed-point units a cell (the engine's).
pub const FP: int = 256

/// Heading units a full turn: 0 north, 64 east, 128 south, 192 west.
pub const TURN: int = 256

/// The trot, fixed-point units a tick at paw 1 (`TROT_V + 2 × paw`, the
/// bible's section 3), before the pace dial: the stat base.
pub const TROT_V: int = 36

/// The pace dial (R-cb02c-1 A): the trot, the sneak, the turn rate, the
/// acceleration, the braking and the foes' speeds are its products. 110
/// was cb01b's ("Bump cub speed by 10 %"); the maintainer's word on
/// cb02b's build, 2026-10-25: "The cub moves much too slowly", so 165,
/// half as fast again; the maintainer's standing word on that build, 2026-10-26:
/// "The cub moves much too slowly … Bump the cub speed by 20 %", so 198
/// (cb03). The one constant to move: everything below
/// follows it, rounded to the nearest unit.
pub const WALK_PERCENT: int = 198

/// cb01b's pace, the base the dial's products are scaled from.
pub const PACE_BASE_PERCENT: int = 110

/// A sneak's speed: half the trot (section 4), the ratio the dial keeps.
pub const SNEAK_V: int = ((TROT_V + 2) * WALK_PERCENT + 50) / 100 / 2

/// Acceleration, FP units a tick each tick: 4 at cb01b's pace, scaled
/// with it, so the trot from a stop still takes 11 ticks.
pub const ACCEL: int = (4 * WALK_PERCENT + PACE_BASE_PERCENT / 2) / PACE_BASE_PERCENT

/// Braking: 8 at cb01b's pace, scaled with it; a stop from the trot in
/// 6 ticks, a cub stops faster than it starts.
pub const BRAKE: int = (8 * WALK_PERCENT + PACE_BASE_PERCENT / 2) / PACE_BASE_PERCENT

/// The cub's turn rate, heading units a tick: 16 at cb01b's pace, scaled
/// with it so the turning circle (speed over turn rate) is the one cb01b's
/// play accepted: a quarter turn in 3 ticks, about in 6. The cub turns,
/// never pivots.
pub const TURN_RATE: int = (16 * WALK_PERCENT + PACE_BASE_PERCENT / 2) / PACE_BASE_PERCENT

/// A ground foe's pace through a turn it cannot make in one tick: half
/// its pursuit (R-cb02c-6 A).
pub const FOE_TURN_V: int = FOE_STALK_V / 2

/// The ground foes' turn rate: cb01b's 16, not scaled with the pace. A
/// foe as fast as the cub on the straight turns wider, so the fox keeps
/// up on the straight and loses in the turns.
pub const FOE_TURN_RATE: int = 16

/// The dial at which cb02c set the stride and the standing sway (the
/// maintainer's "Make it natural" on cb02b's build): the gait's base. The
/// stride and the sway scale with the dial from here (R-cb03-5 A), so a
/// faster cub strides longer, not quicker: the wag and the paws keep the
/// cadence in seconds that cb02c's play set, and a tail frame still holds
/// three ticks or more at the trot.
pub const GAIT_BASE_PERCENT: int = 165

/// A stride, fixed-point units of travel: both paws' frames once (cb02c).
/// 832 at the dial's 165 (998 at 198): at the trot a stride takes 13
/// ticks, a trot's cadence of about two strides a second; the cub's body
/// is four cells, a stride a little under it.
pub const STRIDE: int = (832 * WALK_PERCENT + GAIT_BASE_PERCENT / 2) / GAIT_BASE_PERCENT

/// One wag of the tail: two strides (R-cb02c-2 A, the maintainer's word,
/// 2026-10-25: "its tail oscillates too quickly. Make it natural."). The
/// tail is tied to the gait, never to the tick: 26 ticks (0.9 s) at the
/// trot, 18 at half as fast again.
pub const GAIT_CYCLE: int = 2 * STRIDE

/// The gait's floor, units a tick: below it (standing, the windups, the
/// first ticks of a start) the tail still sways, one wag in 59 ticks
/// (2 s), so a standing cub's tail is slow, never still. 28 at the dial's
/// 165, scaled with the stride (R-cb03-5 A).
pub const SWAY_V: int = (28 * WALK_PERCENT + GAIT_BASE_PERCENT / 2) / GAIT_BASE_PERCENT

/// Advance the gait by the ground covered this tick, never less than
/// the standing sway.
fn gait_step(mut s: Sim) {
    let v = if s.speed > SWAY_V then s.speed else SWAY_V
    s.gait = (s.gait + v) % GAIT_CYCLE
}

/// The paws' frame, 0 or 1: it flips every half stride, so each stride
/// shows both.
pub fn legs(s: Sim) -> int {
    s.gait / (STRIDE / 2) % 2
}

/// The tail's eighth of a wag, 0..7 (`silhouette.wag` turns it into the
/// tail's offset).
pub fn tail_phase(s: Sim) -> int {
    s.gait * 8 / GAIT_CYCLE
}

/// The health band the posture draws (cb03, R-cb03-2 A): 0 full (three
/// quarters and above), 1 hurt (half and above), 2 badly hurt (a quarter
/// and above), 3 dying. The numbers themselves show only at a den and on
/// the death card (R-cb03-3 A).
pub fn hurt_band(s: Sim) -> int {
    let max = health_max(s.heart)
    if s.health * 4 >= max * 3 {
        0
    } else if s.health * 2 >= max {
        1
    } else if s.health * 4 >= max {
        2
    } else {
        3
    }
}

/// The breath's frame, 0 or 1 (cb03): standing still, the body widens a
/// pixel on the in-breath every two seconds fresh (`BREATH_TICKS`), faster
/// when tired; spent, the pant's mouth opens and closes every eight ticks.
/// Moving, 0: the gait carries the body.
pub fn breath(s: Sim) -> int {
    if s.exhausted { return s.tick / PANT_TICKS % 2 }
    if s.speed > 0 || s.action != IDLE { return 0 }
    let half = if s.stamina * 3 > stamina_max(s.wind) * 2 {
        BREATH_TICKS / 2
    } else {
        BREATH_TICKS / 3
    }
    s.tick / half % 2
}

/// One breath at rest, ticks: two seconds fresh, 1.2 s tired (cb03).
pub const BREATH_TICKS: int = 60

/// Half a pant, ticks: the mouth open four ticks, closed four (cb03).
pub const PANT_TICKS: int = 4

/// The boss whose theme the score sounds, 0..3 (the boar, the lynx, the
/// elk, the shadow alpha; `score.boss_part`), or -1 for none. cb03 leaves
/// the slot (`s.boss`); cb04's fights set it.
pub fn boss_theme(s: Sim) -> int {
    s.boss
}

/// Heart, wind, fang, paw and nose at the start (section 3): 1 each.
pub const STAT_START: int = 1

/// Health at heart `h`: `40 + 12 × h`.
pub fn health_max(heart: int) -> int {
    40 + 12 * base_stat(heart) + 3 * extra_stat(heart)
}

/// Stamina at wind `w`: `60 + 10 × w`.
pub fn stamina_max(wind: int) -> int {
    60 + 10 * base_stat(wind) + 2 * extra_stat(wind)
}

/// The trot at paw `p`.
pub fn trot_at(paw: int) -> int {
    ((TROT_V + 2 * base_stat(paw) + extra_stat(paw) / 2) * WALK_PERCENT + 50) / 100
}

/// The quarter sine, 65 entries of `[0, 256]` over `[0, 64]` heading units.
fn quarter_sin(i: int) -> int {
    match i {
        0 => 0,
        1 => 6,
        2 => 13,
        3 => 19,
        4 => 25,
        5 => 31,
        6 => 38,
        7 => 44,
        8 => 50,
        9 => 56,
        10 => 62,
        11 => 68,
        12 => 74,
        13 => 80,
        14 => 86,
        15 => 92,
        16 => 98,
        17 => 104,
        18 => 109,
        19 => 115,
        20 => 121,
        21 => 126,
        22 => 132,
        23 => 137,
        24 => 142,
        25 => 147,
        26 => 152,
        27 => 157,
        28 => 162,
        29 => 167,
        30 => 172,
        31 => 177,
        32 => 181,
        33 => 185,
        34 => 190,
        35 => 194,
        36 => 198,
        37 => 202,
        38 => 206,
        39 => 209,
        40 => 213,
        41 => 216,
        42 => 220,
        43 => 223,
        44 => 226,
        45 => 229,
        46 => 231,
        47 => 234,
        48 => 237,
        49 => 239,
        50 => 241,
        51 => 243,
        52 => 245,
        53 => 247,
        54 => 248,
        55 => 250,
        56 => 251,
        57 => 252,
        58 => 253,
        59 => 254,
        60 => 255,
        61 => 255,
        62 => 256,
        63 => 256,
        _ => 256,
    }
}

/// Sine of a heading, in `[-256, 256]`: east is 256 at heading 64.
pub fn sin(h: int) -> int {
    let a = (h % TURN + TURN) % TURN
    if a <= 64 {
        return quarter_sin(a)
    }
    if a <= 128 {
        return quarter_sin(128 - a)
    }
    if a <= 192 {
        return 0 - quarter_sin(a - 128)
    }
    0 - quarter_sin(256 - a)
}

/// Cosine of a heading: north is 256 at heading 0.
pub fn cos(h: int) -> int {
    sin(h + 64)
}

/// The heading units from `from` to `to` by the shortest way, in
/// `(-128, 128]`.
pub fn turn_toward(from: int, to: int) -> int {
    var d = (to - from) % TURN
    if d > 128 {
        d -= TURN
    }
    if d <= -128 {
        d += TURN
    }
    d
}

/// The cub: where it is (fixed-point world cells, x east, y south), the
/// heading it faces and the one it wants, its speed, its stats and what
/// they give, and the eight held movement keys.
pub struct Sim {
    seed: int,
    field: int,
    cols: int,
    rows: int,
    tick: int,
    x: int,
    y: int,
    heading: int,
    heading_target: int,
    speed: int,
    sneaking: bool,
    moving: bool,
    blocked: int,
    heart: int,
    wind: int,
    fang: int,
    paw: int,
    nose: int,
    health: int,
    stamina: int,
    holds: List[input.Hold],
    aim_order: List[int],
    aim_serial: int,
    sprint_hold: input.Hold,
    sprinting: bool,
    sprint_charge: int,
    attack_heading: int,
    chained_heading: int,
    action: int,
    started: int,
    chained: bool,
    combo: int,
    exhausted: bool,
    locked: int,
    unseen: int,
    riposte: int,
    riposte_foe: int,
    flasks: int,
    scent: int,
    den: bool,
    rest_row: int,
    rest_pending: List[int],
    rest_refused: int,
    death_at: int,
    deaths: int,
    mark: bool,
    mark_x: int,
    mark_y: int,
    mark_scent: int,
    pickup_at: int,
    pickup_x: int,
    pickup_y: int,
    pickup_area: int,
    gate_open: bool,
    area: int,
    last_den: int,
    lit_dens: int,
    shortcuts: int,
    story: int,
    difficulty: int,
    flask_max: int,
    mark_area: int,
    entered: int,
    edge_ready: bool,
    save_status: int,
    gate_hint_until: int,
    drops: List[Drop],
    meat: List[Meat],
    caches: int,
    yarrow: int,
    marrow: int,
    opening_seen: bool,
    scene: int,
    scene_started: int,
    cue: int,
    foes: List[Foe],
    slain: List[int],
    away_loot: List[AreaLoot],
    trail: List[Trail],
    gait: int,
    body_facing: int,
    boss: int,
    bosses: int,
    end: bool,
    played: int,
    played_at: int,
    lost: int,
}

/// A new cub at the Shingle's start, facing north toward the water, still.
pub fn new(seed: int, cols: int, rows: int) -> Sim {
    let (x, y) = terrain.start(seed)
    var holds = List[input.Hold]()
    var aim_order = List[int]()
    var i = 0
    while i < 8 {
        (mut holds).push(input.hold_new())
        (mut aim_order).push(0)
        i += 1
    }
    Sim {
        seed: seed,
        field: forest.field_of(cols),
        cols: cols,
        rows: rows,
        tick: 0,
        x: x,
        y: y,
        heading: 0,
        heading_target: 0,
        speed: 0,
        sneaking: false,
        moving: false,
        blocked: 0,
        heart: STAT_START,
        wind: STAT_START,
        fang: STAT_START,
        paw: STAT_START,
        nose: STAT_START,
        health: health_max(STAT_START),
        stamina: stamina_max(STAT_START),
        holds: holds,
        aim_order: aim_order,
        aim_serial: 0,
        sprint_hold: input.hold_new(),
        sprinting: false,
        sprint_charge: 0,
        attack_heading: 0,
        chained_heading: 0,
        action: IDLE,
        started: 0,
        chained: false,
        combo: 0,
        exhausted: false,
        locked: -1,
        unseen: 0,
        riposte: 0,
        riposte_foe: -1,
        flasks: 0,
        scent: 0,
        den: false,
        rest_row: 0,
        rest_pending: List[int](),
        rest_refused: 0,
        death_at: 0,
        deaths: 0,
        mark: false,
        mark_x: 0,
        mark_y: 0,
        mark_scent: 0,
        pickup_at: -12,
        pickup_x: 0,
        pickup_y: 0,
        pickup_area: 0,
        gate_open: false,
        area: forest.SHINGLE,
        last_den: 0,
        lit_dens: 1,
        shortcuts: 0,
        story: 0,
        difficulty: 0,
        flask_max: 0,
        mark_area: 0,
        entered: -120,
        edge_ready: true,
        save_status: 0,
        gate_hint_until: 0,
        drops: List[Drop](),
        meat: List[Meat](),
        caches: 0,
        yarrow: 0,
        marrow: 0,
        opening_seen: false,
        scene: 0,
        scene_started: 0,
        cue: 0,
        foes: area_foes(seed, forest.field_of(cols), forest.SHINGLE, 0),
        slain: empty_slain(),
        away_loot: empty_loot(),
        trail: List[Trail](),
        gait: 0,
        body_facing: 0,
        boss: -1,
        bosses: 0,
        end: false,
        played: 0,
        played_at: 0,
        lost: 0,
    }
}

/// The ticks the journey has been played, across sessions: the saved
/// count plus this session's since it was last folded in (cb04: the end
/// card's time).
pub fn played_ticks(s: Sim) -> int {
    s.played + s.tick - s.played_at
}

/// Fold this session's ticks into the saved count, at a rest or a death
/// (the moments the journey is written anyway; a save a tick would be no
/// save at all).
fn mark_time(mut s: Sim) {
    s.played += s.tick - s.played_at
    s.played_at = s.tick
}

/// The screen's size changed: the camera keeps the cub at the centre.
pub fn resize(mut s: Sim, cols: int, rows: int) {
    s.cols = cols
    s.rows = rows
}

/// The cub's screen row: the centre (R-CB-3, the camera on the cub).
pub fn screen_row(s: Sim) -> int {
    s.rows / 2
}

/// The cub's screen column: the centre.
pub fn screen_col(s: Sim) -> int {
    s.cols / 2
}

/// The world cell under screen `(row, col)`: the camera's corner plus the
/// offset, the cub's own cell at the centre.
pub fn world_cell(s: Sim, row: int, col: int) -> (int, int) {
    (cell_x(s) - screen_col(s) + col, cell_y(s) - screen_row(s) + row)
}

/// The cub's world column.
pub fn cell_x(s: Sim) -> int {
    floor_div(s.x, FP)
}

/// The cub's world row.
pub fn cell_y(s: Sim) -> int {
    floor_div(s.y, FP)
}

/// Floor division keeps negative world coordinates in their true cells.
pub fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b < 0 then q - 1 else q
}

/// The direction the cub faces, 0 north, 1 east, 2 south, 3 west (the
/// nearest quarter).
pub fn facing(s: Sim) -> int {
    ((s.heading + 32) % TURN + TURN) % TURN / 64
}

fn toward(v: int, target: int, step: int) -> int {
    if v < target {
        return if v + step > target then target else v + step
    }
    if v > target {
        return if v - step < target then target else v - step
    }
    v
}

/// The heading a set of held directions means: north 0, east 64, south
/// 128, west 192, the diagonals between; or -1 when none or when opposites
/// cancel.
pub fn heading_of(up: bool, down: bool, left: bool, right: bool) -> int {
    let dy = (if down then 1 else 0) - (if up then 1 else 0)
    let dx = (if right then 1 else 0) - (if left then 1 else 0)
    if dx == 0 && dy == 0 {
        return -1
    }
    if dx == 0 {
        return if dy < 0 then 0 else 128
    }
    if dy == 0 {
        return if dx > 0 then 64 else 192
    }
    if dy < 0 {
        return if dx > 0 then 32 else 224
    }
    if dx > 0 then 96 else 160
}

/// One tick: the keys pressed this tick (cub's numbers), the holds read,
/// the heading turned, the speed changed, the cub moved where the ground
/// lets it.
fn locomotion(mut s: Sim) {
    var held = List[bool]()
    var i = 0
    while i < 8 {
        (mut held).push(input.held(s.holds[i], s.tick))
        i += 1
    }
    let sneak_held = held[4] || held[5] || held[6] || held[7]
    let want = heading_of(
        held[0] || held[4],
        held[1] || held[5],
        held[2] || held[6],
        held[3] || held[7],
    )
    s.moving = want >= 0
    s.sneaking = s.moving && sneak_held
    if s.moving && s.locked < 0 {
        s.heading_target = want
    }
    if s.locked >= 0 {
        s.heading_target = heading_to(s.x, s.y, s.foes[s.locked].x, s.foes[s.locked].y)
    }
    // The turn, at the turn rate, by the shortest way.
    let d = turn_toward(s.heading, s.heading_target)
    let step_h = if d > TURN_RATE then TURN_RATE else if d < 0 - TURN_RATE then 0 - TURN_RATE else d
    s.heading = ((s.heading + step_h) % TURN + TURN) % TURN
    swing_body(mut s)
    // The speed: toward the trot (or the sneak) while a key is held, to a
    // stop when none is.
    s.sprinting = s.action == IDLE &&
        s.moving &&
        !s.sneaking &&
        !s.exhausted &&
        s.stamina > 0 &&
        sprint_held(s)
    var pace = if s.health * 3 < health_max(s.heart) then trot_at(s.paw) / 2 else trot_at(s.paw)
    // The Shallows' current (cb04): the cub wades at half its pace, the
    // elk's second phase's ground.
    if in_shallows(s, s.x, s.y) { pace = pace / 2 }
    let want_v = if !s.moving || s.action != IDLE {
        0
    } else if s.sneaking {
        trot_at(s.paw) / 2
    } else if s.sprinting {
        if in_shallows(s, s.x, s.y) then sprint_at(s.paw) / 2 else sprint_at(s.paw)
    } else {
        pace
    }
    s.speed = toward(s.speed, want_v, if want_v > s.speed then ACCEL else BRAKE)
    // The attack, each axis on its own, so a wall along one lets the other
    // slide; a blocked axis stops the cub.
    let dx = s.speed * sin(s.heading) / 256
    let dy = 0 - s.speed * cos(s.heading) / 256
    let nx = s.x + dx
    if !blocked(s, floor_div(nx, FP), cell_y(s)) && !cub_blocked_by_body(s, nx, s.y) {
        s.x = nx
    } else {
        s.speed = 0
        s.blocked += 1
    }
    let ny = s.y + dy
    if !blocked(s, cell_x(s), floor_div(ny, FP)) && !cub_blocked_by_body(s, s.x, ny) {
        s.y = ny
    } else {
        s.speed = 0
        s.blocked += 1
    }
}

/// The distance walked, cells, for the closing line.
pub fn distance_cells(s: Sim) -> int {
    let (x0, y0) = terrain.start(s.seed)
    let dx = (s.x - x0) / FP
    let dy = (s.y - y0) / FP
    (if dx < 0 then 0 - dx else dx) + (if dy < 0 then 0 - dy else dy)
}

/// A world cell's variant, for the frame (the engine's hash).
pub fn variant(s: Sim, x: int, y: int, n: int) -> int {
    world.hash(s.seed + 31, x, y, n)
}

// Bible §§3–8, and dated proposals in docs/DESIGN.md.
/// No action in progress.
pub const IDLE: int = 0

/// Light bite action.
pub const BITE: int = 1

/// Heavy lunge action.
pub const LUNGE: int = 2

/// Timed defensive action.
pub const PARRY: int = 3

/// Three-cell evasive hop.
pub const DODGE: int = 4

/// Thirty-tick water action.
pub const DRINK: int = 5

/// Death fade action.
pub const FALL: int = 6

/// Active parry ticks, excluding recovery.
pub const PARRY_WINDOW: int = 9

/// Ticks a parried foe cannot attack.
pub const STAGGER_TICKS: int = 30

/// Lifetime of a deposited scent cell.
pub const TRAIL_TICKS: int = 300

/// Mouthfuls restored by a den.
pub const FLASKS: int = 3

/// Health restored in the final fifteen drinking ticks.
pub const FLASK_HEAL: int = 40

/// Stamina per idle tick; walking receives half.
pub const REGEN: int = 2

/// Stamina needed to clear exhaustion.
pub const EXHAUST_RECOVER: int = 24

/// The campaign's small stat set: soft cap ten, hard cap forty.
pub const STAT_SOFT: int = 10

/// Hard ceiling on an individual stat.
pub const STAT_MAX: int = 40

fn base_stat(n: int) -> int { if n > STAT_SOFT then STAT_SOFT else n }

fn extra_stat(n: int) -> int { if n > STAT_SOFT then n - STAT_SOFT else 0 }

/// One shared level, not five separately priced purchase tracks.
pub fn level(s: Sim) -> int { s.heart + s.wind + s.fang + s.paw + s.nose - 4 }

/// Published Dark Souls cubic as a numerical shape, k=1/20. L is the
/// current level; below twelve cub's own table joins it without a jump.
/// Integer half-up rounding avoids cross-host floating point differences.
pub fn level_cost(l: int) -> int {
    assert(l >= 1 && l <= 196, "bounded total level")
    if l < 12 {
        return match l {
            1 => 24,
            2 => 25,
            3 => 26,
            4 => 27,
            5 => 28,
            6 => 30,
            7 => 32,
            8 => 34,
            9 => 36,
            10 => 38,
            _ => 40,
        }
    }
    (2 * l * l * l + 306 * l * l + 10560 * l - 89500 + 1000) / 2000
}

/// Scent visibility in cells; beyond ten each two nose levels add one cell.
pub fn scent_reach(nose: int) -> int { 8 + 2 * base_stat(nose) + extra_stat(nose) / 2 }

/// Lock search retains its smaller starting radius, with the same soft cap.
pub fn lock_reach(nose: int) -> int { SIGHT + base_stat(nose) + extra_stat(nose) / 4 }

/// The value and next effect used by the den's five choices.
pub fn stat_value(s: Sim, stat: int) -> int {
    match stat {
        0 => s.heart,
        1 => s.wind,
        2 => s.fang,
        3 => s.paw,
        _ => s.nose,
    }
}

/// Effect at a given stat value, in health/stamina/damage/FP/cells.
pub fn stat_effect(stat: int, value: int) -> int {
    match stat {
        0 => health_max(value),
        1 => stamina_max(value),
        2 => bite_damage(value),
        3 => trot_at(value),
        _ => scent_reach(value),
    }
}

/// Weasel species identifier.
pub const WEASEL: int = 0

/// Fox species identifier.
pub const FOX: int = 1

/// Perception and pursuit phase.
pub const HUNT: int = 0

/// Real attack windup.
pub const CROUCH: int = 1

/// Active foe attack.
pub const STRIKE: int = 2

/// Recovery with movement away from the target.
pub const RETREAT: int = 3

/// Defenceless recovery after parry or lunge.
pub const STAGGER: int = 4

/// Fox false windup; never deals damage.
pub const FEINT: int = 5

/// Gap before the fox real windup.
pub const PAUSE: int = 6

/// Readable ticks between crouch and strike.
pub const WEASEL_WINDUP: int = 12

/// Base sight radius in cells.
pub const SIGHT: int = 8

/// Enemy trail detection radius in cells.
pub const SCENT_RADIUS: int = 6

/// A world-space scent sample with an exclusive expiry tick.
pub struct Trail { x: int, y: int, until: int }

/// A deterministic opponent, its ground body and timed attack.
pub struct Foe {
    kind: int,
    x: int,
    y: int,
    heading: int,
    speed: int,
    stamina: int,
    health: int,
    phase: int,
    since: int,
    target_x: int,
    target_y: int,
    home_x: int,
    home_y: int,
    hit: bool,
    last_hit: int,
    died: int,
    attack: int,
    poise: int,
    poise_at: int,
    engaged: bool,
}

/// Damage of an unmodified bite at this fang level.
pub fn bite_damage(fang: int) -> int { 6 + 2 * base_stat(fang) + extra_stat(fang) / 2 }

/// Invulnerable ticks at this paw level (integer division).
pub fn dodge_iframes(paw: int) -> int { 6 + base_stat(paw) / 2 + extra_stat(paw) / 8 }

/// Absolute value for bounded world coordinates.
pub fn abs(v: int) -> int { if v < 0 then 0 - v else v }

/// Whether two fixed-point points are within an inclusive radius.
pub fn near(x: int, y: int, tx: int, ty: int, radius: int) -> bool {
    let dx = x - tx
    let dy = y - ty
    dx * dx + dy * dy <= radius * radius
}

/// Close-quarters unit-fixture foes; live encounters use area_foes.
pub fn spawn_foes(seed: int) -> List[Foe] {
    let (_, y) = terrain.start(seed)
    var foes = List[Foe]()
    var i = 0
    while i < 3 {
        let x = (if i == 0 then 9 else if i == 1 then 13 else 20) * FP
        (mut foes).push(Foe {
            kind: if i == 2 then FOX else WEASEL,
            x: x,
            y: y,
            heading: 64,
            speed: 0,
            stamina: 60,
            health: if i == 2 then 24 else 8,
            phase: HUNT,
            since: 0,
            target_x: x,
            target_y: y,
            home_x: x,
            home_y: y,
            hit: false,
            last_hit: -1,
            died: -1,
            attack: 0,
            poise: 0,
            poise_at: 0,
            engaged: false,
        })
        i += 1
    }
    foes
}

/// World row of the southern thorn gate.
pub fn gate_y(s: Sim) -> int {
    let (_, y) = terrain.start(s.seed)
    floor_div(y, FP) + forest.LENGTH - 3
}

/// Whether fixed-point `(x, y)` stands in the Shallows' water (cb04).
pub fn in_shallows(s: Sim, x: int, y: int) -> bool {
    forest.kind(s.seed, s.field, s.area, floor_div(x, FP), floor_div(y, FP)) == terrain.SHALLOWS
}

/// Terrain and unopened thorns block a world cell.
pub fn blocked(s: Sim, x: int, y: int) -> bool {
    (s.area == forest.SHINGLE || s.area == forest.BRAMBLEHOLD) &&
        !s.gate_open &&
        y == forest.thorn_row(s.seed, s.area) &&
        x >= -2 &&
        x <= 2 ||
        forest.blocked(s.seed, s.field, s.area, x, y)
}

/// Occlusion is integer sampled at half-cell intervals, including the endpoint.
pub fn visible(s: Sim, x: int, y: int, tx: int, ty: int) -> bool {
    let dx = tx - x
    let dy = ty - y
    let steps = (abs(dx) + abs(dy)) / (FP / 2) + 1
    var i = 1
    while i <= steps {
        if blocked(s, floor_div(x + dx * i / steps, FP), floor_div(y + dy * i / steps, FP)) {
            return false
        }
        i += 1
    }
    true
}

/// Eight-way bearing between two points, or -1 at coincidence.
pub fn heading_to(x: int, y: int, tx: int, ty: int) -> int {
    let dx = tx - x
    let dy = ty - y
    // Eight directions, still approached at TURN_RATE rather than pivoted.
    heading_of(
        dy < 0 && abs(dy) * 2 >= abs(dx),
        dy > 0 && abs(dy) * 2 >= abs(dx),
        dx < 0 && abs(dx) * 2 >= abs(dy),
        dx > 0 && abs(dx) * 2 >= abs(dy),
    )
}

fn in_front(x: int, y: int, heading: int, tx: int, ty: int) -> bool {
    let dx = tx - x
    let dy = ty - y
    let dot = dx * sin(heading) - dy * cos(heading)
    let cross = dx * cos(heading) + dy * sin(heading)
    dot >= 0 && abs(cross) <= dot
}

/// Cone, range and occlusion jointly determine foe sight.
pub fn can_see(s: Sim, f: Foe) -> bool {
    // A lifted flock warns nearby hunters even behind their sight cone.
    if s.area == forest.LARKMEADOW && meadow_near(s, 5, 5) && near(f.x, f.y, s.x, s.y, 12 * FP) {
        return true
    }
    near(f.x, f.y, s.x, s.y, (if s.area == forest.BRAMBLEHOLD then 5 else SIGHT) * FP) &&
        in_front(f.x, f.y, f.heading, s.x, s.y) &&
        visible(s, f.x, f.y, s.x, s.y)
}

/// Whether the current tick is inside the half-open parry window.
pub fn parrying(s: Sim) -> bool {
    s.action == PARRY && s.tick - s.started < PARRY_WINDOW
}

/// Whether the current tick is inside the dodge iframe window.
pub fn invulnerable(s: Sim) -> bool {
    s.action == DODGE && s.tick - s.started < dodge_iframes(s.paw)
}

/// Apply damage unless protected; zero health replaces the scent mark.
pub fn hurt(mut s: Sim, damage: int) {
    if s.action == FALL || s.den || invulnerable(s) { return }
    s.health -= damage
    if s.action == DRINK { s.action = IDLE }
    if s.health <= 0 {
        s.health = 0
        s.action = FALL
        s.started = s.tick
        s.death_at = s.tick
        s.deaths += 1
        mark_time(mut s)
        // Replace, never accumulate: a second death destroys the first mark;
        // the scent it held is lost for good (R-CB-1), and counted (cb04).
        if s.mark { s.lost += s.mark_scent }
        s.mark = true
        s.mark_area = s.area
        s.mark_x = s.x
        s.mark_y = s.y
        s.mark_scent = s.scent
        s.scent = 0
        s.locked = -1
        s.speed = 0
    }
}

fn reset_world(mut s: Sim) {
    s.health = health_max(s.heart)
    s.stamina = stamina_max(s.wind)
    s.flasks = s.flask_max
    s.action = IDLE
    s.speed = 0
    s.exhausted = false
    s.locked = -1
    s.riposte = 0
    s.riposte_foe = -1
    s.chained = false
    s.combo = 0
    s.slain = empty_slain()
    s.away_loot = empty_loot()
    s.foes = area_foes(s.seed, s.field, s.area, s.bosses)
    (mut s.drops).reset()
    (mut s.meat).reset()
    (mut s.trail).reset()
    var i = 0
    while i < s.holds.len { s.holds[i] = input.hold_new(); i += 1 }
    s.sprint_hold = input.hold_new()
    s.sprinting = false
    s.sprint_charge = 0
    settle_bodies(mut s)
}

/// Whether the hollow log is within resting reach.
pub fn at_den(s: Sim) -> bool {
    den_here(s) >= 0
}

/// Spend the shared next-level cost on one stat, only inside a den.
pub fn grow(mut s: Sim, stat: int) {
    if !s.den { return }
    if stat < 0 || stat > 4 { return }
    let value = stat_value(s, stat)
    let cost = level_cost(level(s))
    if value >= STAT_MAX || s.scent < cost { return }
    s.scent -= cost
    if stat == 0 { s.heart += 1 }
    if stat == 1 { s.wind += 1 }
    if stat == 2 { s.fang += 1 }
    if stat == 3 { s.paw += 1 }
    if stat == 4 { s.nose += 1 }
    s.health = health_max(s.heart)
    s.stamina = stamina_max(s.wind)
}

fn lock_next(mut s: Sim) {
    var best = -1
    var distance = 999999999
    var i = 0
    // First lock is nearest; later presses cycle stable spawn order.
    while i < s.foes.len {
        let j = if s.locked < 0 then i else (s.locked + 1 + i) % s.foes.len
        let f = copy s.foes[j]
        if f.health > 0 &&
            near(s.x, s.y, f.x, f.y, lock_reach(s.nose) * FP) &&
            visible(s, s.x, s.y, f.x, f.y) {
            let d = (s.x - f.x) * (s.x - f.x) + (s.y - f.y) * (s.y - f.y)
            if s.locked >= 0 { best = j; break }
            if d < distance { best = j; distance = d }
        }
        i += 1
    }
    s.locked = best
    s.unseen = 0
}

fn start_action(mut s: Sim, action: int, cost: int) {
    if s.action != IDLE || s.stamina < cost { return }
    if s.exhausted && (action == LUNGE || action == HEAVY || action == DASH || action == DODGE) {
        return
    }
    s.stamina -= cost
    if s.stamina == 0 { s.exhausted = true }
    s.attack_heading = if action == LUNGE || action == DASH then s.heading else attack_aim(s)
    s.action = action
    s.combo = if action == BITE then 1 else 0
    s.started = s.tick
    s.speed = 0
    s.chained = false
    alpha_reacts(mut s, action)
}

fn action_keys(mut s: Sim, keys: List[int]) {
    for k in keys {
        // Rest consumes these inputs; no held motion leaks out of the menu.
        if s.den { rest_key(mut s, k); continue }
        if controls.is_move(k) {
            let i = k - controls.KEY_UP
            if s.holds[i].last != s.tick { input.hold_press(mut s.holds[i], s.tick) }
            s.aim_serial += 1
            s.aim_order[i] = s.aim_serial
        }
        if k == controls.KEY_RELEASE { s.locked = -1; s.den = false }
        if k == controls.KEY_LOCK { lock_next(mut s) }
        if k >= controls.KEY_HEART && k <= controls.KEY_NOSE { grow(mut s, k - controls.KEY_HEART) }
        if k == controls.KEY_REST && at_den(s) {
            s.last_den = den_here(s)
            s.lit_dens = light_den(s.lit_dens, s.last_den)
            mark_time(mut s)
            reset_world(mut s)
            s.den = true
            rest_reset(mut s)
        }
        if s.den { continue }
        if k == controls.KEY_REST && !at_den(s) { cache_key(mut s); shortcut_key(mut s) }
        if k == controls.KEY_BITE {
            if s.action == BITE && s.tick - s.started >= 5 && s.tick - s.started < 11 {
                s.chained = true
                s.chained_heading = attack_aim(s)
            }
            if s.sprinting {
                start_action(mut s, DASH, DASH_COST)
            } else {
                start_action(mut s, BITE, 12)
            }
        }
        if k == controls.KEY_HEAVY { start_action(mut s, HEAVY, HEAVY_COST) }
        if k == controls.KEY_LUNGE { start_action(mut s, LUNGE, 30) }
        if k == controls.KEY_PARRY { start_action(mut s, PARRY, 10) }
        if k == controls.KEY_DODGE && s.sprint_hold.last != s.tick {
            let repeat = s.tick - s.sprint_hold.last <= 30
            input.hold_press(mut s.sprint_hold, s.tick)
            if !repeat { start_action(mut s, DODGE, 18) }
        }
        if k == controls.KEY_WATER && s.action == IDLE && s.flasks > 0 {
            s.flasks -= 1
            start_action(mut s, DRINK, 0)
        }
    }
}

fn strike_foes(mut s: Sim) {
    let age = s.tick - s.started
    let active = s.action == BITE && age >= 3 && age < 5 ||
        s.action == LUNGE && age >= 9 && age < 12 ||
        s.action == HEAVY && age >= HEAVY_WINDUP && age < HEAVY_WINDUP + HEAVY_ACTIVE ||
        s.action == DASH && age >= 3 && age < 6
    if !active { return }
    let reach = if s.action == LUNGE || s.action == HEAVY || s.action == DASH then 4 else 2
    let (gate_x, gate_target_y) = gate_target(s)
    if s.action == LUNGE &&
        s.area == forest.SHINGLE &&
        !s.gate_open &&
        near(s.x, s.y, gate_x, gate_target_y, 4 * FP) &&
        in_front(s.x, s.y, attack_direction(s), gate_x, gate_target_y) {
        s.gate_open = true
    }
    if s.action == BITE &&
        s.area == forest.SHINGLE &&
        !s.gate_open &&
        near(s.x, s.y, gate_x, gate_target_y, 2 * FP) &&
        in_front(s.x, s.y, attack_direction(s), gate_x, gate_target_y) {
        s.gate_hint_until = s.tick + ENTRY_TICKS
    }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        if f.health > 0 &&
            f.kind != HAWK &&
            f.last_hit != s.started &&
            in_reach(s, i, reach) &&
            in_front(s.x, s.y, attack_direction(s), f.x, f.y) {
            var damage = bite_damage(s.fang)
            if s.action == LUNGE { damage *= 3 }
            if s.action == HEAVY { damage *= HEAVY_DAMAGE }
            if s.action == DASH { damage *= 2 }
            if s.action == BITE && s.tick < s.riposte && i == s.riposte_foe {
                damage *= 2
                s.riposte = 0
            }
            // The alpha's guard turns a bite (cb04): no damage, the cub's
            // bite ends, and the alpha ripostes with a bite of its own
            // whose windup is the parry window's floor.
            if f.kind == ALPHA && f.phase == FOE_PARRY && s.action == BITE {
                s.foes[i].last_hit = s.started
                s.action = IDLE
                s.combo = 0
                s.chained = false
                s.foes[i].phase = CROUCH
                s.foes[i].attack = 0
                s.foes[i].since = s.tick - (boss_move(ALPHA, 0, phase_two(f)).windup - PARRY_WINDOW)
                s.foes[i].target_x = s.x
                s.foes[i].target_y = s.y
                i += 1
                continue
            }
            s.foes[i].health -= damage
            s.foes[i].last_hit = s.started
            if s.foes[i].health <= 0 {
                s.foes[i].died = s.tick
                if is_boss(f.kind) {
                    beat_boss(mut s, f.kind, f.x, f.y)
                } else {
                    leave_drop(
                        mut s,
                        f.x,
                        f.y,
                        if f.kind == FOX then 20 else if f.kind == DEER then 5 else 8,
                    )
                }
            } else if is_boss(f.kind) {
                // Poise (the bible's section 4): a boss never staggers from
                // a bite; a lunge or a heavy into a travelling attack's
                // windup or run staggers it at once, and otherwise their
                // damage within POISE_TICKS accumulates to a stagger.
                if s.action == LUNGE || s.action == HEAVY {
                    let travelling = boss_move(f.kind, f.attack, phase_two(f)).travel > 0 &&
                        (f.phase == CROUCH || f.phase == STRIKE)
                    if s.tick - f.poise_at > POISE_TICKS { s.foes[i].poise = 0 }
                    s.foes[i].poise += damage
                    s.foes[i].poise_at = s.tick
                    if travelling || s.foes[i].poise >= POISE {
                        s.foes[i].poise = 0
                        s.foes[i].phase = STAGGER
                        s.foes[i].since = s.tick
                    }
                }
            } else if s.action == LUNGE || s.action == HEAVY {
                s.foes[i].phase = STAGGER
                s.foes[i].since = s.tick
            }
        }
        i += 1
    }
}

/// Run ground foe `i` one tick toward `(tx, ty)` as it pursues, its turn
/// rate and its turning pace included (the instrument's and the tests'
/// handle on a foe's gait; the game's own steering is `foes_step`).
pub fn run_foe(mut s: Sim, i: int, tx: int, ty: int) {
    s.foes[i].target_x = tx
    s.foes[i].target_y = ty
    move_foe(mut s, i, false)
}

/// Opponents attack on the ground. The presentation's arc never moves their
/// body through another creature or alters the damage envelope.
fn move_foe(mut s: Sim, i: int, away: bool) {
    let f = copy s.foes[i]
    var h = heading_to(f.x, f.y, f.target_x, f.target_y)
    if h < 0 { s.foes[i].speed = 0; return }
    if away { h = (h + 128) % TURN }
    let d = turn_toward(f.heading, h)
    let heading = (
        f.heading +
            (
                if d > FOE_TURN_RATE {
                    FOE_TURN_RATE
                } else if d < 0 - FOE_TURN_RATE {
                    0 - FOE_TURN_RATE
                } else {
                    d
                }
            ) +
            TURN
    ) %
        TURN
    // A turn it cannot make this tick checks a foe's run (R-cb02c-6 A): it
    // brakes toward its turning pace until the heading is nearly round,
    // then runs on. So the fox keeps up on the straight and loses in turns.
    let sharp = d > FOE_TURN_RATE || d < 0 - FOE_TURN_RATE
    let top = if away then FOE_RETREAT_V else FOE_STALK_V
    let want_v = if sharp && f.speed > FOE_TURN_V then FOE_TURN_V else top
    let speed = toward(f.speed, want_v, if want_v < f.speed then BRAKE else ACCEL)
    // The turn first: a body swung round into another is the mover's to
    // clear (R-cb02c-3 A): it steps out along the line between them, or
    // keeps its old heading this tick when it has no room.
    turn_foe(mut s, i, heading)
    let g = copy s.foes[i]
    let nx = g.x + speed * sin(g.heading) / FP
    let ny = g.y - speed * cos(g.heading) / FP
    // Then the step: one into the terrain or into a body is not taken
    // (the mover yields, pushed back along its own motion).
    let stops = blocked(s, floor_div(nx, FP), floor_div(ny, FP)) ||
        foe_blocked_by_body(s, i, nx, ny, g.heading)
    s.foes[i].speed = if stops then 0 else speed
    if !stops { s.foes[i].x = nx; s.foes[i].y = ny }
}

fn foes_step(mut s: Sim) {
    var i = 0
    while i < s.foes.len && s.action != FALL {
        let f = copy s.foes[i]
        if f.health <= 0 { i += 1; continue }
        if f.kind == HAWK {
            hawk_step(mut s, i)
            i += 1
            continue
        }
        if is_boss(f.kind) {
            boss_step(mut s, i)
            i += 1
            continue
        }
        if f.kind == DEER {
            if f.phase == STAGGER {
                s.foes[i].speed = 0
                turn_foe(mut s, i, heading_to(f.x, f.y, s.x, s.y))
                if s.tick - f.since >= STAGGER_TICKS {
                    s.foes[i].phase = HUNT
                    s.foes[i].stamina = 60
                }
            } else if near(f.x, f.y, s.x, s.y, 7 * FP) {
                s.foes[i].phase = RETREAT
                s.foes[i].target_x = s.x
                s.foes[i].target_y = s.y
                if f.stamina >= 2 {
                    move_foe(mut s, i, true)
                    s.foes[i].stamina -= 2
                } else {
                    s.foes[i].phase = STAGGER
                    s.foes[i].since = s.tick
                    s.foes[i].speed = 0
                }
            } else {
                s.foes[i].speed = 0
                // Quiet deer gather at the local old kill; no extra currency.
                let (ax, ay, kind) = meadow.anchor(s.seed, floor_div(f.x, FP), floor_div(f.y, FP))
                if kind == 3 {
                    s.foes[i].target_x = ax * FP
                    s.foes[i].target_y = ay * FP
                    move_foe(mut s, i, false)
                }
            }
            i += 1
            continue
        }
        let age = s.tick - f.since
        if f.phase == HUNT {
            // A foe whose body touches the cub's knows where it is, whatever
            // stands between their middles (cb02c: bodies have extent now).
            var tracks = can_see(s, f) || gap(cub_body(s), foe_body(f)) == 0
            var tx = s.x
            var ty = s.y
            if !tracks {
                var j = s.trail.len - 1
                while j >= 0 {
                    let tr = copy s.trail[j]
                    if tr.until > s.tick &&
                        near(f.x, f.y, tr.x, tr.y, SCENT_RADIUS * FP) &&
                        visible(s, f.x, f.y, tr.x, tr.y) {
                        tracks = true
                        tx = tr.x
                        ty = tr.y
                        break
                    }
                    j -= 1
                }
            }
            if tracks {
                s.foes[i].target_x = tx
                s.foes[i].target_y = ty
                if in_reach(s, i, 2) && f.stamina >= 12 {
                    s.foes[i].phase = if f.kind == FOX then FEINT else CROUCH
                    s.foes[i].since = s.tick
                    s.foes[i].target_x = s.x
                    s.foes[i].target_y = s.y
                    s.foes[i].speed = 0
                    s.foes[i].stamina -= 12
                } else {
                    move_foe(mut s, i, false)
                }
            } else {
                s.foes[i].speed = 0
            }
            if s.foes[i].stamina < 60 { s.foes[i].stamina += 1 }
        } else if f.phase == FEINT && age >= 10 {
            s.foes[i].phase = PAUSE
            s.foes[i].since = s.tick
        } else if f.phase == PAUSE && age >= 6 {
            s.foes[i].phase = CROUCH
            s.foes[i].since = s.tick
            s.foes[i].target_x = s.x
            s.foes[i].target_y = s.y
        } else if f.phase == CROUCH && age >= WEASEL_WINDUP {
            s.foes[i].phase = STRIKE
            s.foes[i].since = s.tick
            s.foes[i].hit = false
        } else if f.phase == STRIKE && age >= (if f.kind == FOX then 3 else 2) {
            s.foes[i].phase = RETREAT
            s.foes[i].since = s.tick
        } else if f.phase == RETREAT {
            move_foe(mut s, i, true)
            if s.area == forest.LARKMEADOW && s.foes[i].stamina > 0 { s.foes[i].stamina -= 1 }
            if age >= 24 {
                s.foes[i].phase = if s.area == forest.LARKMEADOW then STAGGER else HUNT
                s.foes[i].since = s.tick
                s.foes[i].speed = 0
            }
        } else if f.phase == STAGGER && age >= STAGGER_TICKS {
            s.foes[i].phase = if f.kind == WEASEL then RETREAT else HUNT
            s.foes[i].since = s.tick
        }
        if s.foes[i].phase == CROUCH || s.foes[i].phase == FEINT {
            let h = heading_to(f.x, f.y, s.foes[i].target_x, s.foes[i].target_y)
            if h >= 0 {
                let d = turn_toward(f.heading, h)
                let turn = if d > FOE_TURN_RATE {
                    FOE_TURN_RATE
                } else if d < 0 - FOE_TURN_RATE {
                    0 - FOE_TURN_RATE
                } else {
                    d
                }
                turn_foe(mut s, i, (f.heading + turn + TURN) % TURN)
            }
        }
        // Test current phase so the first active tick is not lost.
        if s.foes[i].phase == STRIKE &&
            !s.foes[i].hit &&
            in_reach(s, i, 2) &&
            in_front(f.x, f.y, f.heading, s.x, s.y) {
            s.foes[i].hit = true
            if parrying(s) {
                s.foes[i].phase = STAGGER
                s.foes[i].since = s.tick
                s.riposte = s.tick + STAGGER_TICKS
                s.riposte_foe = i
            } else if !invulnerable(s) {
                hurt(mut s, if f.kind == FOX then 16 else 10)
                if f.kind == FOX && s.flasks > 0 { s.flasks -= 1 }
            }
        }
        i += 1
    }
}

fn action_step(mut s: Sim, want: int) {
    let age = s.tick - s.started
    if s.action == DODGE && age < dodge_iframes(s.paw) {
        let h = if want < 0 then s.heading else want
        let frames = dodge_iframes(s.paw)
        let distance = (age + 1) * 3 * FP / frames - age * 3 * FP / frames
        let nx = s.x + distance * sin(h) / FP
        let ny = s.y - distance * cos(h) / FP
        let body = cub_blocked_by_body(s, nx, ny)
        if !body && !blocked(s, floor_div(nx, FP), floor_div(ny, FP)) { s.x = nx; s.y = ny }
    }
    if s.action == DRINK && age >= 15 && age < 30 {
        let healed = (age - 14) * FLASK_HEAL / 15 - (age - 15) * FLASK_HEAL / 15
        s.health += healed
        if s.health > health_max(s.heart) { s.health = health_max(s.heart) }
    }
    strike_foes(mut s)
    let duration = if s.action == BITE {
        11
    } else if s.action == LUNGE {
        24
    } else if s.action == DASH {
        16
    } else if s.action == HEAVY {
        HEAVY_WINDUP + HEAVY_ACTIVE + HEAVY_RECOVERY
    } else if s.action == PARRY {
        15
    } else if s.action == DODGE {
        dodge_iframes(s.paw) + 4
    } else if s.action == DRINK {
        30
    } else {
        0
    }
    if s.action != IDLE && age >= duration {
        let chain = s.action == BITE && s.chained
        let next_combo = s.combo % 3 + 1
        s.combo = 0
        s.action = IDLE
        if chain {
            let aim = s.chained_heading
            start_action(mut s, BITE, 12)
            if s.action == BITE { s.attack_heading = aim; s.combo = next_combo }
        }
    }
}

fn trail_step(mut s: Sim, ox: int, oy: int) {
    var kept = List[Trail]()
    for tr in s.trail { if tr.until > s.tick { (mut kept).push(tr) } }
    s.trail = kept
    if !s.sneaking && (floor_div(ox, FP) != cell_x(s) || floor_div(oy, FP) != cell_y(s)) {
        (mut s.trail).push(Trail {
            x: s.x,
            y: s.y,
            until: s.tick +
                TRAIL_TICKS +
                (
                    if s.area == forest.LARKMEADOW && meadow_near(s, 7, 3) {
                        150
                    } else {
                        0
                    }
                ),
        })
    }
}

/// Tick order is part of the replay contract: input, movement, action,
/// foe attack, trail, recovery. Actions use half-open tick intervals.
pub fn step(mut s: Sim, keys: List[int]) {
    s.tick += 1
    s.cue = 0
    if s.scene != 0 {
        scene_step(mut s, keys.len > 0)
        return
    }
    if s.action == FALL {
        if s.tick - s.started >= 30 {
            wake(mut s)
            s.entered = s.tick
        }
        return
    }
    action_keys(mut s, keys)
    if s.den { return }
    if s.locked >= 0 {
        let f = copy s.foes[s.locked]
        if f.health <= 0 {
            s.locked = -1
        } else {
            if near(s.x, s.y, f.x, f.y, lock_reach(s.nose) * FP) && visible(s, s.x, s.y, f.x, f.y) {
                s.unseen = 0
            } else {
                s.unseen += 1
            }
            if s.unseen >= 60 { s.locked = -1 }
        }
    }
    swing_body(mut s)
    settle_bodies(mut s)
    let ox = s.x
    let oy = s.y
    locomotion(mut s)
    gait_step(mut s)
    let want = heading_of(
        input.held(s.holds[0], s.tick) || input.held(s.holds[4], s.tick),
        input.held(s.holds[1], s.tick) || input.held(s.holds[5], s.tick),
        input.held(s.holds[2], s.tick) || input.held(s.holds[6], s.tick),
        input.held(s.holds[3], s.tick) || input.held(s.holds[7], s.tick),
    )
    action_step(mut s, want)
    foes_step(mut s)
    if s.action == FALL { return }
    if transitions(mut s, ox, oy) { return }
    trail_step(mut s, ox, oy)
    drops_step(mut s)
    healing_pickups(mut s)
    if s.mark && s.mark_area == s.area && pickup_near(s, s.mark_x, s.mark_y) {
        pickup_flash(mut s, s.mark_x, s.mark_y)
        s.scent += s.mark_scent
        s.mark = false
        s.mark_scent = 0
    }
    if s.sprinting {
        s.sprint_charge += SPRINT_PER_SECOND
        if s.sprint_charge >= 30 {
            s.sprint_charge -= 30
            s.stamina -= 1
            if s.stamina <= 0 {
                s.stamina = 0
                s.exhausted = true
                s.sprinting = false
            }
        }
    } else if s.action == IDLE {
        s.stamina += if s.moving then REGEN / 2 else REGEN
        if s.stamina > stamina_max(s.wind) { s.stamina = stamina_max(s.wind) }
        if s.stamina >= EXHAUST_RECOVER { s.exhausted = false }
    }
    end_due(mut s)
}

/// One tick of a scene: the opening (1) ends on a key or after its three
/// sequence; the title (2) on a key, then the opening for a new journey; the
/// end (3) shows its three frames (a key skips to the card) and the card
/// until a key (`r` keeps playing, R-cb04-4 A).
fn scene_step(mut s: Sim, key: bool) {
    let age = s.tick - s.scene_started
    if s.scene == 1 {
        if key || age >= OPENING_TICKS {
            s.scene = 0
            s.opening_seen = true
            s.entered = s.tick
        }
    } else if s.scene == SCENE_TITLE {
        if key {
            s.scene = 0
            s.entered = s.tick
            opening(mut s)
        }
    } else if age < END_CARD_AT {
        if key { s.scene_started = s.tick - END_CARD_AT }
    } else if key {
        s.scene = 0
        s.entered = s.tick
    }
}

/// The end begins when the alpha's fade is done: the ford, the wolf, the
/// pack's howl, the card (cb04).
fn end_due(mut s: Sim) {
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        if f.kind == ALPHA && f.health <= 0 && f.died >= 0 && s.tick - f.died == BOSS_FADE_TICKS {
            s.scene = SCENE_END
            s.scene_started = s.tick
            s.cue = CUE_HOWL
        }
        i += 1
    }
}

/// The end card follows the end's three frames (ticks into the scene).
pub const END_CARD_AT: int = SCENE_TICKS * 3

/// Show the title (the live start, and a script's `title 1` event): the
/// four bosses' silhouettes, lit where the save says beaten, the keys, and
/// after `TITLE_IDLE` idle ticks the recorded demo behind it.
pub fn title(mut s: Sim) {
    s.scene = SCENE_TITLE
    s.scene_started = s.tick
    s.cue = CUE_TITLE
}

/// Idle ticks on the title before the demo plays (ten seconds).
pub const TITLE_IDLE: int = 300

// Bodies (cb02c; the maintainer's word, 2026-10-25: "Enemies should never
// overlap with the cub. They should have collision to prevent weird attack
// moments where the enemy is behind the cub and can't be hit."). A body is
// the rectangle of cells a creature's drawing covers (`silhouette`'s sizes,
// turned to the facing the frame draws), so what collides is what is seen.
// Movers yield: a step into a body is not taken; a body swung round into
// another (a turn) is the swinger's to clear unless it is the cub's, when
// the foe steps aside; the start of every tick settles whatever a reset or
// a fixture left overlapping. The envelopes count from the bodies: a reach
// of n cells is n - 1 clear cells between two bodies (R-cb02c-4 A), so a
// foe in contact is always in a bite's reach, never behind the cub out of it.

/// A footprint: world cells, both corners inclusive.
pub struct Body {
    x0: int,
    y0: int,
    x1: int,
    y1: int,
}

fn rect(w: int, h: int, facing: int, cx: int, cy: int) -> Body {
    let (dc, dr, cols, rows) = silhouette.footprint(w, h, facing)
    Body { x0: cx + dc, y0: cy + dr, x1: cx + dc + cols - 1, y1: cy + dr + rows - 1 }
}

/// The quarter a heading falls in: 0 north, 1 east, 2 south, 3 west.
pub fn quarter(heading: int) -> int {
    ((heading + 32) % TURN + TURN) % TURN / 64
}

/// The facing the cub's body would take now: an attack's aim during a
/// bite, a lunge or a heavy, else the heading's quarter.
pub fn wanted_facing(s: Sim) -> int {
    if s.action == BITE || s.action == LUNGE || s.action == HEAVY || s.action == DASH {
        return quarter(s.attack_heading)
    }
    facing(s)
}

/// The cub's drawing's size in pixels: the cub's, or the wolf's after the
/// end (cb04: the silhouette grows one size, and so does the body).
pub fn cub_size(s: Sim) -> (int, int) {
    if s.end then silhouette.wolf_size() else silhouette.cub_size()
}

/// The cub's body at fixed-point `(x, y)` facing `facing`.
pub fn cub_body_at(s: Sim, x: int, y: int, facing: int) -> Body {
    let (w, h) = cub_size(s)
    rect(w, h, facing, floor_div(x, FP), floor_div(y, FP))
}

/// The cub's body where it stands, the way the frame draws it.
pub fn cub_body(s: Sim) -> Body {
    cub_body_at(s, s.x, s.y, s.body_facing)
}

/// A foe's body at `(x, y)` with `heading`.
pub fn foe_body_at(f: Foe, x: int, y: int, heading: int) -> Body {
    let (w, h) = silhouette.foe_size(f.kind)
    rect(w, h, quarter(heading), floor_div(x, FP), floor_div(y, FP))
}

/// A foe's body where it stands.
pub fn foe_body(f: Foe) -> Body {
    foe_body_at(f, f.x, f.y, f.heading)
}

fn axis_gap(a0: int, a1: int, b0: int, b1: int) -> int {
    (if b0 - a1 > a0 - b1 then b0 - a1 else a0 - b1) - 1
}

/// Clear cells between two bodies, the larger axis's: 0 when they touch
/// at a side or a corner, negative when they share a cell.
pub fn gap(a: Body, b: Body) -> int {
    let gx = axis_gap(a.x0, a.x1, b.x0, b.x1)
    let gy = axis_gap(a.y0, a.y1, b.y0, b.y1)
    if gx > gy then gx else gy
}

/// Whether two bodies share a cell.
pub fn overlap(a: Body, b: Body) -> bool {
    gap(a, b) < 0
}

/// A ground body that collides: alive and not the hawk (whose shadow is
/// not solid).
pub fn solid(f: Foe) -> bool {
    f.health > 0 && f.kind != HAWK
}

/// Whether foe `i` is within a reach of `reach` cells of the cub: at most
/// `reach - 1` clear cells between their bodies, and in sight unless the
/// bodies touch (R-cb02c-4 A). A bite's reach is 2, a lunge's and a
/// heavy's 4, a foe's own strike 2; the cone is the caller's.
pub fn in_reach(s: Sim, i: int, reach: int) -> bool {
    let f = copy s.foes[i]
    let cb = cub_body(s)
    let fb = foe_body(f)
    let g = gap(cb, fb)
    g >= 0 && g <= reach - 1 && (g == 0 || clear_between(s, cb, fb, f.x, f.y))
}

/// Sight between the cub and a foe as `visible` samples it, from middle
/// to middle, except that ground under either body does not stand
/// between them: a trunk the cub's drawing covers is not in its way.
fn clear_between(s: Sim, a: Body, b: Body, tx: int, ty: int) -> bool {
    let dx = tx - s.x
    let dy = ty - s.y
    let steps = (abs(dx) + abs(dy)) / (FP / 2) + 1
    var i = 1
    while i <= steps {
        let cx = floor_div(s.x + dx * i / steps, FP)
        let cy = floor_div(s.y + dy * i / steps, FP)
        let under = cx >= a.x0 && cx <= a.x1 && cy >= a.y0 && cy <= a.y1 ||
            cx >= b.x0 && cx <= b.x1 && cy >= b.y0 && cy <= b.y1
        if !under && blocked(s, cx, cy) { return false }
        i += 1
    }
    true
}

/// Clear cells between the cub's body and foe `i`'s.
pub fn body_gap(s: Sim, i: int) -> int {
    gap(cub_body(s), foe_body(s.foes[i]))
}

/// Whether the cub's body at `(x, y)` would share a cell with a solid foe.
fn cub_blocked_by_body(s: Sim, x: int, y: int) -> bool {
    let b = cub_body_at(s, x, y, s.body_facing)
    for f in s.foes {
        if solid(f) && overlap(b, foe_body(f)) { return true }
    }
    false
}

/// Whether foe `i`'s body at `(x, y)` with `heading` would share a cell
/// with the cub's or another solid foe's.
fn foe_blocked_by_body(s: Sim, i: int, x: int, y: int, heading: int) -> bool {
    let b = foe_body_at(s.foes[i], x, y, heading)
    if s.action != FALL && overlap(b, cub_body(s)) { return true }
    var j = 0
    while j < s.foes.len {
        if j != i && solid(s.foes[j]) && overlap(b, foe_body(s.foes[j])) { return true }
        j += 1
    }
    false
}

/// Move foe `i` out of every body along the line from `from`'s middle to
/// its own, a quarter cell at a time, up to eight cells; failing that
/// along the seven other compass lines, nearest first. False when no
/// clear, unblocked place was found (the foe stays).
fn push_out(mut s: Sim, i: int, from: Body) -> bool {
    let f = copy s.foes[i]
    let b = foe_body(f)
    var h0 = heading_to(
        (from.x0 + from.x1) * FP / 2,
        (from.y0 + from.y1) * FP / 2,
        (b.x0 + b.x1) * FP / 2,
        (b.y0 + b.y1) * FP / 2,
    )
    if h0 < 0 { h0 = (f.heading + 128) % TURN }
    var k = 0
    while k < 8 {
        // 0, +1, -1, +2, -2 ... eighths of a turn from the line.
        let turn = if k == 0 then 0 else if k % 2 == 1 then (k + 1) / 2 * 32 else 0 - k / 2 * 32
        let dir = ((h0 + turn) % TURN + TURN) % TURN
        var n = 1
        while n <= 32 {
            let x = f.x + sin(dir) * n * FP / 4 / FP
            let y = f.y - cos(dir) * n * FP / 4 / FP
            // A boss yields only within its arena (cb04: it never leaves).
            let kept = !is_boss(f.kind) || in_arena_at(s, x, y)
            if kept &&
                !blocked(s, floor_div(x, FP), floor_div(y, FP)) &&
                !foe_blocked_by_body(s, i, x, y, f.heading) {
                s.foes[i].x = x
                s.foes[i].y = y
                return true
            }
            n += 1
        }
        k += 1
    }
    false
}

/// Turn foe `i` to `heading`; if its body, swung round, would share a cell
/// with another, it steps out of the way, or keeps its heading when it
/// cannot.
fn turn_foe(mut s: Sim, i: int, heading: int) {
    let f = copy s.foes[i]
    if quarter(heading) == quarter(f.heading) || !foe_blocked_by_body(s, i, f.x, f.y, heading) {
        s.foes[i].heading = heading
        return
    }
    s.foes[i].heading = heading
    if !push_out(mut s, i, cub_body(s)) {
        s.foes[i].heading = f.heading
        s.foes[i].x = f.x
        s.foes[i].y = f.y
    }
}

/// The cub's body takes the facing it wants (a turn's quarter, an
/// attack's aim). A foe in the way of the swing steps aside (R-cb02c-5 A:
/// the body that did not attack yields to the cub's turn, as a tie goes
/// against the foe); with no room the cub's body keeps its facing this
/// tick, so a turn never swings the cub into a foe.
fn swing_body(mut s: Sim) {
    let want = wanted_facing(s)
    if want == s.body_facing { return }
    let b = cub_body_at(s, s.x, s.y, want)
    var clear = true
    var i = 0
    while i < s.foes.len {
        if solid(s.foes[i]) && overlap(b, foe_body(s.foes[i])) {
            let was = s.body_facing
            s.body_facing = want
            if !push_out(mut s, i, b) { clear = false }
            s.body_facing = was
        }
        i += 1
    }
    if clear { s.body_facing = want }
}

/// Settle what a reset, an area's entry or a fixture left overlapping:
/// each foe sharing a cell with the cub steps out of it, then each with an
/// earlier foe steps out of that one, in the foes' order, the pass
/// repeated while anything moved (at most four passes): the seed's result
/// alone, and no overlap survives that has room to be undone.
pub fn settle_bodies(mut s: Sim) {
    var pass = 0
    var moved = true
    while moved && pass < 4 {
        moved = false
        let cub = cub_body(s)
        var i = 0
        while i < s.foes.len {
            if solid(s.foes[i]) {
                if s.action != FALL && overlap(foe_body(s.foes[i]), cub) {
                    if push_out(mut s, i, cub) { moved = true }
                }
                var j = 0
                while j < i {
                    if solid(s.foes[j]) && overlap(foe_body(s.foes[i]), foe_body(s.foes[j])) {
                        if push_out(mut s, i, foe_body(s.foes[j])) { moved = true }
                    }
                    j += 1
                }
            }
            i += 1
        }
        pass += 1
    }
}

/// Foe pursuit: 44 at cb01b's pace, scaled with the dial (R-cb02c-1 A),
/// so a weasel still outruns a starting cub and a sneak stays under it.
pub const FOE_STALK_V: int = (44 * WALK_PERCENT + PACE_BASE_PERCENT / 2) / PACE_BASE_PERCENT

/// Retreat: 48 at cb01b's pace, scaled; faster than a fresh cub's trot.
pub const FOE_RETREAT_V: int = (48 * WALK_PERCENT + PACE_BASE_PERCENT / 2) / PACE_BASE_PERCENT

/// Arrow aim memory shared in name and duration with pack pk06b (500 ms).
pub const AIM_WINDOW_TICKS: int = 15

fn aim_axis_order(s: Sim, axis: int) -> int {
    var order = 0
    var i = axis
    while i < 8 {
        if (input.held(s.holds[i], s.tick) || s.tick - s.holds[i].last <= AIM_WINDOW_TICKS) &&
            s.aim_order[i] > order {
            order = s.aim_order[i]
        }
        i += 4
    }
    order
}

/// Lock wins; otherwise latest opposing arrow wins per axis, then facing.
pub fn attack_aim(s: Sim) -> int {
    if s.locked >= 0 && s.locked < s.foes.len && s.foes[s.locked].health > 0 {
        let h = heading_to(s.x, s.y, s.foes[s.locked].x, s.foes[s.locked].y)
        if h >= 0 { return h }
    }
    let up = aim_axis_order(s, 0)
    let down = aim_axis_order(s, 1)
    let left = aim_axis_order(s, 2)
    let right = aim_axis_order(s, 3)
    let h = heading_of(up > down, down > up, left > right, right > left)
    if h >= 0 then h else s.heading
}

/// The bite and lunge's presentation distances; hit reaches remain 2 and 4.
pub const BITE_ARC: int = FP

/// Long leap distance in fixed point, before collision clipping.
pub const LUNGE_ARC: int = 3 * FP

/// Integer out-and-back triangle, like pack's arc, with a fixed apex.
pub fn leap_arc(heading: int, age: int, ticks: int, distance: int) -> (int, int) {
    if age <= 0 || age >= ticks { return (0, 0) }
    let n = if age <= ticks / 2 then age else ticks - age
    let travel = distance * n / (ticks / 2)
    (sin(heading) * travel / FP, 0 - cos(heading) * travel / FP)
}

/// Clip the full path in eighth-cell steps, not just the endpoint.
/// Ground physics and the camera never use these presentation coordinates.
pub fn clip_arc(s: Sim, ox: int, oy: int) -> (int, int) {
    let span = if abs(ox) > abs(oy) then abs(ox) else abs(oy)
    let steps = span / (FP / 8) + 1
    var x = 0
    var y = 0
    var n = 1
    while n <= steps {
        let dx = ox * n / steps
        let dy = oy * n / steps
        let nx = s.x + dx
        let ny = s.y + dy
        let stops = blocked(s, floor_div(nx, FP), floor_div(ny, FP)) ||
            drawn_body_in(s, cub_body_at(s, nx, ny, s.body_facing))
        if stops { break }
        x = dx
        y = dy
        n += 1
    }
    (x, y)
}

/// The cub's bounded presentation offset, pure and independent of tier.
pub fn attack_offset(s: Sim) -> (int, int) {
    let age = s.tick - s.started
    if s.action == BITE {
        let distance = if s.combo == 3 then COMBO_FINISH_ARC else BITE_ARC
        let (x, y) = leap_arc(attack_direction(s), age - 2, 3, distance)
        let lean = if age >= 3 && age < 5 {
            if s.combo == 1 then 0 - COMBO_LEAN else if s.combo == 2 then COMBO_LEAN else 0
        } else {
            0
        }
        return clip_arc(
            s,
            x + cos(s.attack_heading) * lean / FP,
            y + sin(s.attack_heading) * lean / FP,
        )
    }
    if s.action == DASH {
        let (x, y) = leap_arc(s.attack_heading, age - 2, 4, 4 * FP)
        return clip_arc(s, x, y)
    }
    if s.action == LUNGE {
        if age < 9 {
            let back = if age < 3 then 0 else if age < 6 then FP else 2 * FP
            return clip_arc(
                s,
                0 - sin(s.attack_heading) * back / FP,
                cos(s.attack_heading) * back / FP,
            )
        }
        let (x, y) = leap_arc(s.attack_heading, age - 8, 4, LUNGE_ARC)
        return clip_arc(s, x, y)
    }
    if s.action == HEAVY {
        if age < HEAVY_WINDUP {
            let steps = if age < 5 then 0 else if age < 10 then 1 else 2
            let back = steps * FP
            return clip_arc(
                s,
                0 - sin(s.attack_heading) * back / FP,
                cos(s.attack_heading) * back / FP,
            )
        }
        let (x, y) = leap_arc(s.attack_heading, age - HEAVY_WINDUP + 1, HEAVY_ACTIVE + 1, HEAVY_ARC)
        return clip_arc(s, x, y)
    }
    (0, 0)
}

/// One contact flash on the arc's apex, at the hit foe (or the empty apex).
pub fn landing(s: Sim) -> bool {
    s.action == BITE && s.tick - s.started == 3 || s.action == LUNGE && s.tick - s.started == 10
}

/// Landing mark destination; the actual hit envelope, never a new collider.
pub fn landing_point(s: Sim) -> (int, int) {
    for f in s.foes {
        if f.last_hit == s.started { return (f.x, f.y) }
    }
    let (dx, dy) = attack_offset(s)
    (s.x + dx, s.y + dy)
}

/// First/second bite lean, in fixed point perpendicular to the aim.
pub const COMBO_LEAN: int = FP / 2

/// Third bite's longer presentation arc; its reach and damage stay unchanged.
pub const COMBO_FINISH_ARC: int = 2 * FP

/// Two recovery ticks shaking the third bite's head left and right.
pub fn head_shake(s: Sim) -> int {
    if s.action != DASH && (s.action != BITE || s.combo != 3) { return 0 }
    let age = s.tick - s.started
    let shake = if s.action == DASH {
        if age == 3 || age == 5 then -1 else if age == 4 then 1 else 0
    } else if age == 5 then -1 else if age == 6 then 1 else 0
    if shake == 0 { return 0 }
    // The head moves a cell across the aim; it never moves into a body
    // (cb02c): with a foe against that side the head holds still.
    let (ox, oy) = attack_offset(s)
    var b = cub_body_at(s, s.x + ox, s.y + oy, s.body_facing)
    if s.body_facing % 2 == 0 {
        if shake < 0 { b.x0 -= 1 } else { b.x1 += 1 }
    } else if shake < 0 {
        b.y0 -= 1
    } else {
        b.y1 += 1
    }
    if drawn_body_in(s, b) then 0 else shake
}

/// Whether a rectangle shares a cell with a foe body the frame draws: a
/// solid foe, or a ground foe fading out (presentation clips against both;
/// collision against the solid alone).
fn drawn_body_in(s: Sim, b: Body) -> bool {
    for f in s.foes {
        if (solid(f) || f.kind != HAWK && f.died >= 0 && s.tick - f.died < FOE_FADE_TICKS) &&
            overlap(b, foe_body(f)) {
            return true
        }
    }
    false
}

/// Heavy attack fallback action (the terminal cannot distinguish Shift+Space).
pub const HEAVY: int = 7

/// Proposed stamina cost, above the lunge's 30.
pub const HEAVY_COST: int = 42

/// Two visible back-steps precede the heavier leap.
pub const HEAVY_WINDUP: int = 15

/// Heavy active ticks, with the ordinary four-cell hit envelope.
pub const HEAVY_ACTIVE: int = 6

/// Heavy recovery is slower than the lunge's twelve ticks.
pub const HEAVY_RECOVERY: int = 18

/// Heavy damage in multiples of a bite; surviving ordinary foes stagger.
pub const HEAVY_DAMAGE: int = 4

/// Heavy presentation arc, longer than the lunge's three cells.
pub const HEAVY_ARC: int = 4 * FP

/// Burst age, -1 outside the four-tick fading landing burst.
pub fn burst_age(s: Sim) -> int {
    let age = s.tick - s.started - HEAVY_WINDUP - 2
    if s.action == HEAVY && age >= 0 && age < 4 then age else -1
}

/// The burst stays at the apex while the cub returns; no moving emitter.
pub fn burst_point(s: Sim) -> (int, int) {
    for f in s.foes { if f.last_hit == s.started { return (f.x, f.y) } }
    let (x, y) = clip_arc(
        s,
        sin(s.attack_heading) * HEAVY_ARC / FP,
        0 - cos(s.attack_heading) * HEAVY_ARC / FP,
    )
    (s.x + x, s.y + y)
}

/// A defeated foe dissolves over fifteen ticks, retaining its sprite briefly.
pub const FOE_FADE_TICKS: int = 15

/// The meadow's aerial foe. Values are proposed in DESIGN.md.
pub const HAWK: int = 2

/// Ticks for which the shadow stops before striking.
pub const HAWK_TELL: int = 18

/// Ticks before the hawk circles again.
pub const HAWK_RECOVERY: int = 36

/// Damage of an unanswered stoop.
pub const HAWK_DAMAGE: int = 14

/// Ticks for the unobtrusive area entry line.
pub const ENTRY_TICKS: int = 90

/// Set the selected den bit, leaving other lit dens unchanged.
pub fn light_den(bits: int, den: int) -> int {
    var mask = 1
    var i = 0
    while i < den { mask *= 2; i += 1 }
    if bits / mask % 2 == 0 then bits + mask else bits
}

/// The den in resting reach, or -1.
pub fn den_here(s: Sim) -> int {
    var den = 0
    while den < forest.DEN_LIMIT {
        let (x, y) = forest.den_position(s.seed, den)
        if s.area == forest.den_area(den) && near(s.x, s.y, x, y, 3 * FP) { return den }
        den += 1
    }
    -1
}

/// Loot waiting in an area uses the original absolute simulation-tick expiry.
pub struct AreaLoot {
    drops: List[Drop],
    meat: List[Meat],
}

fn empty_slain() -> List[int] {
    var out = List[int]()
    var area = 0
    while area < forest.AREAS { (mut out).push(0); area += 1 }
    out
}

fn empty_loot() -> List[AreaLoot] {
    var out = List[AreaLoot]()
    var area = 0
    while area < forest.AREAS {
        (mut out).push(AreaLoot { drops: List[Drop](), meat: List[Meat]() })
        area += 1
    }
    out
}

/// Slain ordinary-foe ordinals, independent of a boss's presence. Include
/// current deaths immediately, so an asynchronous save never misses a kill.
pub fn slain_mask(s: Sim, area: int) -> int {
    // A save during the death card is already a last-den respawn.
    if s.action == FALL { return 0 }
    var mask = s.slain[area]
    if area != s.area { return mask }
    var bit = 1
    for foe in s.foes {
        if !is_boss(foe.kind) {
            if foe.health <= 0 && mask / bit % 2 == 0 { mask += bit }
            bit *= 2
        }
    }
    mask
}

/// Re-entry heals and homes living foes, but never revives slain ordinals.
/// Boss permanence continues to use the separate beaten-boss bits.
pub fn restore_foes(mut s: Sim) {
    s.foes = area_foes(s.seed, s.field, s.area, s.bosses)
    var bit = 1
    var i = 0
    while i < s.foes.len {
        if !is_boss(s.foes[i].kind) {
            if s.slain[s.area] / bit % 2 == 1 {
                s.foes[i].health = 0
                s.foes[i].died = s.tick - DROP_TICKS
            }
            bit *= 2
        }
        i += 1
    }
}

/// Initial encounters for one seeded area: the ordinary foes by group,
/// the cache guards, and the area's boss at its arena's centre unless the
/// journey has beaten it (`bosses`, the save's bits).
pub fn area_foes(seed: int, field: int, area: int, bosses: int) -> List[Foe] {
    var foes = List[Foe]()
    if forest.has_arena(area) {
        let kind = boss_of(area)
        if bosses / boss_bit(kind) % 2 == 0 {
            let (cx, cy, _) = forest.arena(seed, field, area)
            var b = make_foe(kind, cx * FP + FP / 2, (forest.origin(seed, area) + cy) * FP + FP / 2)
            // Facing the way the cub comes: north, down the route; the boar
            // west, toward its clearing's mouth.
            b.heading = if area == forest.BRAMBLEHOLD then 192 else 0
            (mut foes).push(b)
        }
    }
    var group = 0
    while group < 3 {
        let at = encounter_row(
            seed,
            area,
            (if group == 0 then 52 else if group == 1 then 76 else 134) +
                world.hash(seed, area, group + 131, 5),
        )
        // The second thicket den sits at 90..93: do not spawn near it.
        // The second thicket den sits at 90..93; the arenas at 100..124 in
        // the last three areas: the middle group stays out of both.
        if group != 1 || area == forest.SHINGLE || area == forest.LARKMEADOW {
            let open = area == forest.LARKMEADOW || area == forest.RIVER
            let count = if open then 2 else if group == 1 then 1 else 2
            var member = 0
            while member < count {
                let kind = if open {
                    (if member == 0 then HAWK else DEER)
                } else if group == 1 || area == forest.CRAGS || area == forest.OLDDEN {
                    FOX
                } else {
                    WEASEL
                }
                let x = (forest.spine(seed, area, at) + member * 2 - 1) * FP
                let y = (forest.origin(seed, area) + at) * FP
                (mut foes).push(make_foe(kind, x, y))
                member += 1
            }
        }
        group += 1
    }
    // The side branches end in harder, finite cache guards.
    var cache = 0
    while cache < forest.cache_count(area) {
        let (x, cy) = forest.cache_position(seed, field, area, cache)
        if area == forest.SHINGLE {
            var foe = make_foe(FOX, x, cy - 3 * FP)
            foe.health = 40
            (mut foes).push(foe)
            cache += 1
            continue
        }
        // Guards stand shoulder to shoulder, a body's width apart (cb02c:
        // never one inside another's drawing).
        let kind = if cache == 0 then WEASEL else FOX
        let (w, _) = silhouette.foe_size(kind)
        let (_, _, wide, _) = silhouette.footprint(w, 12, 0)
        var guard = 0
        while guard < (if cache == 0 then 3 else 2) {
            // From the cache back along its branch toward the route, so
            // every guard stands on the branch's ground.
            let gx = x + (if cache == 0 then guard else 0 - guard) * wide * FP
            let gy = (
                forest.origin(seed, area) + forest.branch(seed, area, cache, floor_div(gx, FP)) + 1
            ) *
                FP +
                FP / 2
            (mut foes).push(make_foe(kind, gx, gy))
            guard += 1
        }
        cache += 1
    }
    foes
}

// Rounding a switchback can move a path foe toward a den. Advance its
// seeded group along the same carved route until both spawn slots retain
// the existing quiet radius. Post-cluster refuges deliberately stay closer.
fn encounter_row(seed: int, area: int, at: int) -> int {
    if area != forest.BRAMBLEHOLD || at < 130 { return at }
    var row = at
    while row < forest.LENGTH - 8 {
        var clear = true
        var den = 0
        while den < forest.DENS {
            if forest.den_area(den) == area {
                let (dx, dy) = forest.den_position(seed, den)
                for side in [-1, 1] {
                    let x = (forest.spine(seed, area, row) + side) * FP
                    let y = (forest.origin(seed, area) + row) * FP
                    let ox = (x - dx) / FP
                    let oy = (y - dy) / FP
                    if ox * ox + oy * oy < forest.FIRST_FOE_CELLS * forest.FIRST_FOE_CELLS {
                        clear = false
                    }
                }
            }
            den += 1
        }
        if clear { return row }
        row += 1
    }
    row
}

fn make_foe(kind: int, x: int, y: int) -> Foe {
    Foe {
        kind: kind,
        x: x,
        y: y,
        heading: 0,
        speed: 0,
        stamina: 60,
        health: foe_health(kind),
        phase: HUNT,
        since: 0,
        target_x: x,
        target_y: y,
        home_x: x,
        home_y: y,
        hit: false,
        last_hit: -1,
        died: -1,
        attack: 0,
        poise: 0,
        poise_at: 0,
        engaged: false,
    }
}

/// Travel resets only local encounter state, never health, water or currency.
pub fn enter_area(mut s: Sim, area: int, x: int, y: int) {
    s.slain[s.area] = slain_mask(s, s.area)
    s.away_loot[s.area].drops = copy s.drops
    s.away_loot[s.area].meat = copy s.meat
    s.area = area
    s.x = x
    s.y = y
    s.entered = s.tick
    s.edge_ready = false
    restore_foes(mut s)
    s.drops = copy s.away_loot[area].drops
    s.meat = copy s.away_loot[area].meat
    (mut s.trail).reset()
    s.locked = -1
    s.riposte = 0
    s.riposte_foe = -1
    s.action = IDLE
    s.speed = 0
    s.chained = false
    s.combo = 0
    s.den = false
    var i = 0
    while i < s.holds.len {
        s.holds[i] = input.hold_new()
        s.aim_order[i] = 0
        i += 1
    }
    settle_bodies(mut s)
}

/// Whether the journey has opened shortcut `edge`.
pub fn shortcut_open(s: Sim, edge: int) -> bool {
    let bit = forest.shortcut_bit(edge)
    bit > 0 && s.shortcuts / bit % 2 == 1
}

/// Open shortcut `edge` in the journey (idempotent).
pub fn open_shortcut(mut s: Sim, edge: int) {
    if !shortcut_open(s, edge) { s.shortcuts += forest.shortcut_bit(edge) }
}

/// Traverse an unlocked incident edge; false for unavailable edges.
pub fn cross_edge(mut s: Sim, edge: int) -> bool {
    let to = forest.other(s.area, edge)
    if to < 0 || edge == 0 && !s.gate_open { return false }
    if !forest.path_edge(edge) && !shortcut_open(s, edge) { return false }
    let (x, y) = forest.portal(s.seed, to, edge)
    // Arrival is off the trigger; a return requires walking back to it:
    // north of a far-end portal (the way back), south of an entry.
    enter_area(
        mut s,
        to,
        x,
        y + (if forest.path_edge(edge) && forest.exit_end(to, edge) then -2 * FP else 2 * FP),
    )
    true
}

fn shortcut_key(mut s: Sim) {
    var edge = 0
    while edge < forest.EDGES {
        if !forest.path_edge(edge) && forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if near(s.x, s.y, x, y, 2 * FP) {
                // Open only from the far side, then either side can traverse
                // it; the ledge and the shallows are opened by their bosses.
                if edge == 2 && s.area == forest.BRAMBLEHOLD && !shortcut_open(s, edge) {
                    s.cue = 1
                    open_shortcut(mut s, edge)
                }
                if edge == 3 && s.area == forest.LARKMEADOW && !shortcut_open(s, edge) {
                    s.cue = 2
                    open_shortcut(mut s, edge)
                }
                let _ = cross_edge(mut s, edge)
                return
            }
        }
        edge += 1
    }
}

/// A body cell moving from non-shadow to shadow counts, including diagonals.
pub fn shadow_crossed(s: Sim, edge: int, old_x: int, old_y: int) -> bool {
    if old_x == s.x && old_y == s.y { return false }
    let dx = floor_div(s.x, FP) - floor_div(old_x, FP)
    let dy = floor_div(s.y, FP) - floor_div(old_y, FP)
    let after = cub_body(s)
    var y = after.y0
    while y <= after.y1 {
        var x = after.x0
        while x <= after.x1 {
            if forest.shadow_cell(s.seed, s.area, edge, x, y) &&
                !forest.shadow_cell(s.seed, s.area, edge, x - dx, y - dy) {
                return true
            }
            x += 1
        }
        y += 1
    }
    false
}

/// Rearm outside the old centre trigger; the body-crossing test prevents idle bounce.
pub fn transitions(mut s: Sim, old_x: int, old_y: int) -> bool {
    // Arrival is unchanged at two cells inside. It may overlap the shadow,
    // but its centre is already outside the old one-cell trigger. Rearm
    // before considering the first return step, not after leaving the body band.
    if !s.edge_ready {
        var old_close = false
        var e = 0
        while e < forest.EDGES {
            if forest.other(s.area, e) >= 0 {
                let (x, y) = forest.portal(s.seed, s.area, e)
                if near(old_x, old_y, x, y, FP) { old_close = true }
            }
            e += 1
        }
        if !old_close { s.edge_ready = true }
    }
    var close = false
    var edge = 0
    let body = cub_body(s)
    while edge < forest.EDGES {
        if forest.other(s.area, edge) >= 0 {
            let (px, py) = forest.portal(s.seed, s.area, edge)
            if near(s.x, s.y, px, py, FP) { close = true }
            let touching = body.x1 >= px / FP - 3 &&
                body.x0 <= px / FP + 3 &&
                body.y1 >= py / FP - 1 &&
                body.y0 <= py / FP + 1
            if touching {
                if s.edge_ready &&
                    shadow_crossed(s, edge, old_x, old_y) &&
                    cross_edge(mut s, edge) {
                    return true
                }
            }
        }
        edge += 1
    }
    if !close { s.edge_ready = true }
    if s.area == forest.BRAMBLEHOLD && near(s.x, s.y, -10 * FP, 24 * FP, 3 * FP) { s.story = 1 }
    false
}

/// Airborne until the stoop: the stopping shadow fixes the target for the
/// whole tell. A straight-line dive hits only that committed target.
fn hawk_step(mut s: Sim, i: int) {
    let f = copy s.foes[i]
    let age = s.tick - f.since
    if f.phase == HUNT {
        if near(f.x, f.y, s.x, s.y, 10 * FP) {
            s.foes[i].phase = CROUCH
            s.foes[i].since = s.tick
            s.foes[i].target_x = s.x
            s.foes[i].target_y = s.y
            s.foes[i].x = s.x
            s.foes[i].y = s.y
        } else {
            // A bounded diamond shadow orbit, fixed around the meadow clearing.
            let phase = s.tick % 120
            s.foes[i].x = f.home_x + sin(phase * TURN / 120) * 2
            s.foes[i].y = f.home_y + cos(phase * TURN / 120) * 2
        }
    } else if f.phase == CROUCH && age >= HAWK_TELL {
        s.foes[i].phase = STRIKE
        s.foes[i].since = s.tick
        if near(s.x, s.y, f.target_x, f.target_y, FP) {
            if parrying(s) {
                s.foes[i].health = 0
                s.foes[i].died = s.tick
                leave_drop(mut s, f.target_x, f.target_y, 12)
            } else {
                hurt(mut s, HAWK_DAMAGE)
            }
        }
    } else if f.phase == STRIKE && age >= 3 {
        s.foes[i].phase = RETREAT
        s.foes[i].since = s.tick
    } else if f.phase == RETREAT && age >= HAWK_RECOVERY {
        s.foes[i].phase = HUNT
        s.foes[i].since = s.tick
    }
}

/// Resume and death share the same den and reset rules.
pub fn wake(mut s: Sim) {
    s.area = forest.den_area(s.last_den)
    let (x, y) = forest.den_position(s.seed, s.last_den)
    s.x = x
    s.y = y
    reset_world(mut s)
    s.den = false
    s.edge_ready = true
}

/// Nearest point of the complete five-cell collision rectangle, including
/// the fractional span of its last cell. Never aim at a cell origin instead.
pub fn gate_target(s: Sim) -> (int, int) {
    let left = -2 * FP
    let right = 3 * FP - 1
    let top = gate_y(s) * FP
    let bottom = top + FP - 1
    (
        if s.x < left then left else if s.x > right then right else s.x,
        if s.y < top then top else if s.y > bottom then bottom else s.y,
    )
}

/// Prey leaves five scent, and eating it heals first (bible §6).
pub const DEER: int = 3

/// A visible pickup remains for this many simulation ticks.
pub const DROP_TICKS: int = 300

/// Each opening frame lasts this many ticks unless any key skips it.
pub const SCENE_TICKS: int = 90

/// Pickups use the drawn body plus this many whole cells on every side.
pub const PICKUP_MARGIN: int = 1

/// Contact ring, inclusive, in world cells; negative and fractional positions
/// use the same floor as the drawing. Nose growth may widen this margin later.
pub fn pickup_near(s: Sim, x: int, y: int) -> bool {
    let b = cub_body(s)
    let cx = floor_div(x, FP)
    let cy = floor_div(y, FP)
    cx >= b.x0 - PICKUP_MARGIN &&
        cx <= b.x1 + PICKUP_MARGIN &&
        cy >= b.y0 - PICKUP_MARGIN &&
        cy <= b.y1 + PICKUP_MARGIN
}

/// Remember one bounded visual burst; successive pickups replace it.
pub fn pickup_flash(mut s: Sim, x: int, y: int) {
    s.pickup_at = s.tick
    s.pickup_x = x
    s.pickup_y = y
    s.pickup_area = s.area
}

/// A local, transient scent pickup, distinct from the persistent death mark.
pub struct Drop { x: int, y: int, value: int, until: int }

fn leave_drop(mut s: Sim, x: int, y: int, value: int) {
    (mut s.drops).push(Drop { x: x, y: y, value: value, until: s.tick + DROP_TICKS })
    if value <= 20 { (mut s.meat).push(Meat { x: x, y: y, until: s.tick + DROP_TICKS }) }
}

fn drops_step(mut s: Sim) {
    var keep = List[Drop]()
    var i = 0
    while i < s.drops.len {
        let drop = copy s.drops[i]
        i += 1
        if drop.until > s.tick {
            if drop.until - s.tick < DROP_TICKS && pickup_near(s, drop.x, drop.y) {
                pickup_flash(mut s, drop.x, drop.y)
                s.scent += drop.value
            } else {
                (mut keep).push(copy drop)
            }
        }
    }
    s.drops = keep
}

/// Start the opening only for a new journey. Keys/skips live in the normal
/// simulation event stream, so the scene needs no wall-clock or second loop.
/// The opening lasts thirty seconds; the ending keeps its own 90-tick cards.
pub const OPENING_TICKS: int = 900

/// Half-open shot boundaries, shared by rendering and replay witnesses.
pub fn opening_shot(age: int) -> int {
    let ends = [210, 225, 300, 330, 360, 420, 480, 510, 600, 660, 720, 765, 789, 810, 840, 900]
    var i = 0
    while i < ends.len {
        if age < ends[i] { return i }
        i += 1
    }
    16
}

/// Start the opening only when the journey has not seen it.
pub fn opening(mut s: Sim) {
    if !s.opening_seen { s.scene = 1; s.scene_started = s.tick }
}

/// Names reserved for the score and later story scenes, not played audio.
pub fn scene_hook(scene: int) -> str {
    match scene {
        1 => "scene.opening",
        2 => "scene.den.first",
        3 => "scene.elk.choice",
        4 => "scene.alpha.offer",
        5 => "scene.ending.home",
        6 => "scene.ending.alone",
        7 => "scene.ending.shadow",
        _ => "",
    }
}

/// Whether a seeded cache has already been opened during this journey.
pub fn cache_open(s: Sim, cache: int) -> bool {
    s.caches / cache_mask(s.area, cache) % 2 == 1
}

/// The journey's cache bit as a mask (`forest.cache_bit`).
fn cache_mask(area: int, cache: int) -> int {
    var mask = 1
    var i = 0
    while i < forest.cache_bit(area, cache) { mask *= 2; i += 1 }
    mask
}

fn cache_key(mut s: Sim) {
    var cache = 0
    while cache < forest.cache_count(s.area) {
        let (x, y) = forest.cache_position(s.seed, s.field, s.area, cache)
        if pickup_near(s, x, y) && !cache_open(s, cache) {
            for foe in s.foes {
                if foe.health > 0 && near(foe.x, foe.y, x, y, 6 * FP) { return }
            }
            pickup_flash(mut s, x, y)
            s.caches += cache_mask(s.area, cache)
            if cache == 1 {
                if s.area == forest.LARKMEADOW { s.yarrow += 1 } else { s.marrow += 1 }
            }
            s.cue = 3
        }
        cache += 1
    }
}

/// Reserved score hooks emitted once on the corresponding interaction.
pub fn cue_hook(cue: int) -> str {
    match cue {
        1 => "shortcut.log.push",
        2 => "shortcut.hedge.dig",
        3 => "cache.open",
        4 => "boss.boar",
        5 => "boss.lynx",
        6 => "boss.elk",
        7 => "boss.alpha",
        8 => "boss.beaten",
        9 => "howl",
        10 => "title",
        _ => "",
    }
}

// The bosses (cb04, M-CB4): four big bodies on cb02c's rules (never
// overlapping, the contact ring inside the attack envelope), each holding
// an arena it never leaves, with two or three telegraphed attacks whose
// windups are readable at the cub's pace (every parryable telegraph at
// least the parry window; the one unparryable attack beaten by a dodge),
// a second phase at half health, poise instead of a stagger on every bite,
// and a beaten state the save keeps that opens the boss's shortcut home.
// Every number is `docs/DESIGN.md`'s, proposed (R-CB-7).

/// Old Snag, the boar of the thicket.
pub const BOAR: int = 4

/// Whisper, the lynx of the crags.
pub const LYNX: int = 5

/// Alder, the elk of the river.
pub const ELK: int = 6

/// Ashgrim, the shadow alpha of the old den.
pub const ALPHA: int = 7

/// The alpha's guard: its parry, a phase of nine ticks in which a bite is
/// turned and answered (cb04).
pub const FOE_PARRY: int = 7

/// The alpha's hop: its dodge, six ticks of invulnerable sideways travel.
pub const FOE_DODGE: int = 8

/// A beaten boss fades over this many ticks (three times a foe's).
pub const BOSS_FADE_TICKS: int = 45

/// Lunge and heavy damage within `POISE_TICKS` that staggers a boss.
pub const POISE: int = 60

/// The window poise accumulates over.
pub const POISE_TICKS: int = 60

/// The alpha's guard lasts the parry window.
pub const GUARD_TICKS: int = PARRY_WINDOW

/// The alpha's hop: ticks and cells (the cub's dodge).
pub const HOP_TICKS: int = 6

/// Whether a kind is a boss.
pub fn is_boss(kind: int) -> bool {
    kind >= BOAR && kind <= ALPHA
}

/// The boss an area holds (`forest.has_arena` says which areas do).
pub fn boss_of(area: int) -> int {
    if area == forest.BRAMBLEHOLD {
        BOAR
    } else if area == forest.CRAGS {
        LYNX
    } else if area == forest.RIVER {
        ELK
    } else {
        ALPHA
    }
}

/// The save's bit for a boss: the boar 1, the lynx 2, the elk 4, the
/// alpha 8.
pub fn boss_bit(kind: int) -> int {
    match kind {
        4 => 1,
        5 => 2,
        6 => 4,
        _ => 8,
    }
}

/// A boss's name (the bible's).
pub fn boss_name(kind: int) -> str {
    match kind {
        4 => "Old Snag",
        5 => "Whisper",
        6 => "Alder",
        _ => "Ashgrim",
    }
}

/// A foe's health at birth by kind: the weasel's and fox's (the bible's),
/// the bosses' (proposed): the boar sturdy, the lynx fast and low, the elk
/// slow and high, the alpha between.
pub fn foe_health(kind: int) -> int {
    match kind {
        1 => 24,
        4 => 240,
        5 => 140,
        6 => 400,
        7 => 300,
        _ => 8,
    }
}

/// The scent a beaten boss leaves (the bible's section 6; the alpha
/// nothing: the end).
pub fn boss_scent(kind: int) -> int {
    match kind {
        4 => 120,
        5 => 200,
        6 => 300,
        _ => 0,
    }
}

/// The shortcut a beaten boss opens: the boar pushes the log, the lynx
/// frees the ledge, the elk yields the shallows; the alpha opens the end
/// (no edge).
pub fn boss_shortcut(kind: int) -> int {
    match kind {
        4 => 2,
        5 => 7,
        6 => 8,
        _ => -1,
    }
}

/// A boss's pursuit, FP units a tick: the boar slow but a charger, the
/// lynx fast, the elk slow, the alpha the cub's own pace.
fn boss_speed(kind: int) -> int {
    match kind {
        4 => 54,
        5 => 90,
        6 => 48,
        _ => 63,
    }
}

/// A boss's turn rate, heading units a tick: the boar turns slowly (the
/// maintainer's flank), the lynx quickly.
fn boss_turn(kind: int) -> int {
    match kind {
        4 => 8,
        5 => 20,
        6 => 10,
        _ => 16,
    }
}

/// One telegraphed attack: its windup (the tell, ticks), its active ticks,
/// its recovery, its damage, its reach in cells (counted from the bodies,
/// R-cb02c-4 A), whether a parry turns it, how fast it travels (FP units a
/// tick along the committed line; 0 for a standing attack), and whether it
/// hits all round (the stamp) rather than in the cone ahead.
pub struct Move {
    windup: int,
    active: int,
    recovery: int,
    damage: int,
    reach: int,
    parryable: bool,
    travel: int,
    around: bool,
}

fn mv(
    windup: int,
    active: int,
    recovery: int,
    damage: int,
    reach: int,
    parryable: bool,
    travel: int,
    around: bool,
) -> Move {
    Move {
        windup: windup,
        active: active,
        recovery: recovery,
        damage: damage,
        reach: reach,
        parryable: parryable,
        travel: travel,
        around: around,
    }
}

/// The moves a boss has (0, 1 and, in some, 2); `phase2` shortens the
/// windups of the fast fights (the lynx, the alpha) and the boar's gore.
/// Every parryable windup stays at or above `PARRY_WINDOW`; the one
/// unparryable attack of each boss is the one a dodge beats.
pub fn boss_move(kind: int, attack: int, phase2: bool) -> Move {
    let quick = if phase2 then 3 else 0
    if kind == BOAR {
        // The gore (parry it); the charge (dodge sideways; a lunge into it
        // staggers the boar); phase 2 charges twice (the second windup
        // shorter, the run the same).
        if attack == 0 { return mv(14 - (if phase2 then 2 else 0), 3, 20, 14, 3, true, 0, false) }
        if attack == 1 { return mv(24, 18, 30, 22, 2, false, 96, false) }
        return mv(12, 18, 30, 22, 2, false, 96, false)
    }
    if kind == LYNX {
        // The swipe; the pounce from a ledge (its long steady tell; parry
        // the landing); the rake, which cannot be parried.
        if attack == 0 { return mv(13 - quick, 2, 18, 12, 3, true, 0, false) }
        if attack == 1 { return mv(15 - quick, 6, 24, 16, 2, true, 320, false) }
        return mv(18 - quick, 8, 20, 10, 4, false, 0, false)
    }
    if kind == ELK {
        // The sweep of the antlers; the stamp, all round, unparryable;
        // phase 2 adds the stag's charge (parry or lunge it).
        if attack == 0 { return mv(20 - (if phase2 then 4 else 0), 4, 30, 18, 5, true, 0, false) }
        if attack == 1 { return mv(24, 2, 36, 24, 3, false, 0, true) }
        return mv(18, 14, 30, 20, 2, true, 80, false)
    }
    // The alpha: the cub's own bite and lunge mirrored (the bite's reach a
    // cell more than the cub's: a big body's turn during the tell can
    // open a cell), and in phase 2 a howl that heals it unless its long
    // windup is punished.
    if attack == 0 { return mv(12 - quick, 2, 10, 14, 3, true, 0, false) }
    if attack == 1 { return mv(15 - quick, 4, 18, 20, 2, false, 256, false) }
    mv(20, 1, 10, 0, 0, true, 0, false)
}

/// The moves a boss has in a phase: two, or three in phase 2 for the elk
/// and the alpha (the lynx's three always; the boar's third is its second
/// charge, never chosen on its own).
fn boss_moves(kind: int, phase2: bool) -> int {
    if kind == LYNX { return 3 }
    if kind == BOAR { return 2 }
    if phase2 then 3 else 2
}

/// Whether a boss is in its second phase: half its health gone.
pub fn phase_two(f: Foe) -> bool {
    is_boss(f.kind) && f.health * 2 < foe_health(f.kind)
}

/// Whether fixed-point `(x, y)` lies in the area's arena.
pub fn in_arena_at(s: Sim, x: int, y: int) -> bool {
    forest.in_arena(
        s.seed,
        s.field,
        s.area,
        floor_div(x, FP),
        floor_div(y, FP) - forest.origin(s.seed, s.area),
    )
}

/// Whether the cub stands in the area's arena (the bar's rule, R-cb04-2 A).
pub fn cub_in_arena(s: Sim) -> bool {
    in_arena_at(s, s.x, s.y)
}

/// Whether foe `i` faces the cub (the cone its standing attacks land in).
pub fn foe_faces_cub(s: Sim, i: int) -> bool {
    let f = copy s.foes[i]
    in_front(f.x, f.y, f.heading, s.x, s.y)
}

/// The live boss of the area, or -1.
pub fn boss_index(s: Sim) -> int {
    var i = 0
    while i < s.foes.len {
        if is_boss(s.foes[i].kind) && s.foes[i].health > 0 { return i }
        i += 1
    }
    -1
}

/// Whether a boss's body may stand at `(x, y)` with `heading`: inside its
/// arena (it never leaves its ground), on ground its kind can take (the
/// lynx stands on the bowl's stone, its ledges), and in no other body.
fn boss_may_stand(s: Sim, i: int, x: int, y: int, heading: int) -> bool {
    if !in_arena_at(s, x, y) { return false }
    let cx = floor_div(x, FP)
    let cy = floor_div(y, FP)
    let k = forest.kind(s.seed, s.field, s.area, cx, cy)
    let stone = s.foes[i].kind == LYNX && k == terrain.ROCK
    if !stone && blocked(s, cx, cy) { return false }
    !foe_blocked_by_body(s, i, x, y, heading)
}

/// Turn boss `i` toward `heading` at its own turn rate (halved in
/// recovery: the boar turns slowly after a charge), the swing yielding as
/// a foe's does.
fn boss_turn_toward(mut s: Sim, i: int, want: int) {
    let f = copy s.foes[i]
    var rate = boss_turn(f.kind)
    if f.phase == RETREAT { rate = (rate + 1) / 2 }
    let d = turn_toward(f.heading, want)
    let step = if d > rate then rate else if d < 0 - rate then 0 - rate else d
    turn_foe(mut s, i, (f.heading + step + TURN) % TURN)
}

/// Run boss `i` one tick toward `(tx, ty)` at speed `v`: a turn first,
/// then a step that yields to the arena's edge, the ground and the bodies.
fn boss_run(mut s: Sim, i: int, tx: int, ty: int, v: int) {
    let f = copy s.foes[i]
    let h = heading_to(f.x, f.y, tx, ty)
    if h < 0 { s.foes[i].speed = 0; return }
    boss_turn_toward(mut s, i, h)
    let g = copy s.foes[i]
    let speed = toward(g.speed, v, if v < g.speed then BRAKE else ACCEL)
    let nx = g.x + speed * sin(g.heading) / FP
    let ny = g.y - speed * cos(g.heading) / FP
    if boss_may_stand(s, i, nx, ny, g.heading) {
        s.foes[i].x = nx
        s.foes[i].y = ny
        s.foes[i].speed = speed
    } else {
        s.foes[i].speed = 0
    }
}

/// The lynx's nearest ledge (a pillar's middle), fixed point.
fn nearest_perch(s: Sim, f: Foe) -> (int, int) {
    var best_x = f.home_x
    var best_y = f.home_y
    var best = 1000000000
    var k = 0
    while k < forest.PILLARS {
        let (px, py) = forest.pillar(s.seed, s.field, k)
        let x = px * FP + FP
        let y = (forest.origin(s.seed, s.area) + py) * FP + FP
        let d = (x - f.x) * (x - f.x) + (y - f.y) * (y - f.y)
        if d < best {
            best = d
            best_x = x
            best_y = y
        }
        k += 1
    }
    (best_x, best_y)
}

/// The attack boss `i` opens with now, or -1 to keep closing: a standing
/// attack when the cub is within its reach, a travelling one from further
/// off, the seed's hash choosing where two fit (never a stream: the hash
/// of the tick).
fn pick_move(s: Sim, i: int) -> int {
    let f = copy s.foes[i]
    let p2 = phase_two(f)
    let g = body_gap(s, i)
    let roll = world.hash(s.seed, s.tick, i + 17, 6)
    if f.kind == BOAR {
        if g <= boss_move(BOAR, 0, p2).reach - 1 && roll < 4 { return 0 }
        if g >= 2 && g <= 12 { return 1 }
        if g <= 1 && roll >= 4 { return 1 }
        return -1
    }
    if f.kind == LYNX {
        if g <= 2 { return if roll < 4 then 0 else 2 }
        if g >= 3 && g <= 9 { return 1 }
        return -1
    }
    if f.kind == ELK {
        if g <= 2 && roll < 2 { return 1 }
        if g <= boss_move(ELK, 0, p2).reach - 1 {
            return if p2 && roll >= 4 && g >= 3 then 2 else 0
        }
        if p2 && g <= 10 { return 2 }
        return -1
    }
    // The alpha: a bite in reach, a lunge from a little further, in phase
    // 2 now and then the howl.
    if p2 && roll == 5 && g >= 3 { return 2 }
    if g <= 2 { return 0 }
    if g >= 3 && g <= 6 { return 1 }
    -1
}

/// Begin attack `m` for boss `i`: the windup, aimed where the cub stands
/// now (a travelling attack's line is committed here, so a sideways dodge
/// beats it).
fn begin_move(mut s: Sim, i: int, m: int) {
    s.foes[i].phase = CROUCH
    s.foes[i].attack = m
    s.foes[i].since = s.tick
    s.foes[i].target_x = s.x
    s.foes[i].target_y = s.y
    s.foes[i].speed = 0
    s.foes[i].hit = false
}

/// An attack lands on the cub: turned by a parry when the attack allows it
/// (the boss staggers, the riposte doubles the next bite), else damage
/// unless the dodge's frames hold.
fn boss_hit(mut s: Sim, i: int, m: Move) {
    s.foes[i].hit = true
    if m.parryable && parrying(s) {
        s.foes[i].phase = STAGGER
        s.foes[i].since = s.tick
        s.riposte = s.tick + STAGGER_TICKS
        s.riposte_foe = i
        return
    }
    if !invulnerable(s) { hurt(mut s, m.damage) }
}

/// One tick of boss `i`.
fn boss_step(mut s: Sim, i: int) {
    let f = copy s.foes[i]
    let age = s.tick - f.since
    let p2 = phase_two(f)
    let m = boss_move(f.kind, f.attack, p2)
    if f.phase == HUNT {
        let engaged = cub_in_arena(s) || body_gap(s, i) <= 4
        if engaged && !f.engaged { s.cue = CUE_BOSS + f.kind - BOAR }
        s.foes[i].engaged = engaged
        // The score's slot (cb03's `boss_theme`): the theme while engaged.
        s.boss = if engaged then f.kind - BOAR else -1
        if !engaged {
            // The cub has left: the boss trots home and waits, its damage
            // kept until a rest (R-cb04-3 A).
            if !near(f.x, f.y, f.home_x, f.home_y, FP) {
                boss_run(mut s, i, f.home_x, f.home_y, boss_speed(f.kind))
            } else {
                s.foes[i].speed = 0
            }
            return
        }
        let pick = pick_move(s, i)
        if pick >= 0 {
            begin_move(mut s, i, pick)
            return
        }
        var tx = s.x
        var ty = s.y
        if f.kind == LYNX && body_gap(s, i) > 9 {
            // The lynx keeps to its ledges until the cub is near enough to
            // pounce on.
            let (px, py) = nearest_perch(s, f)
            tx = px
            ty = py
        }
        if f.kind == ELK && p2 && !in_shallows(s, f.x, f.y) && body_gap(s, i) > 3 {
            // Phase 2: the elk wades into the ford, where the cub is slow.
            let b = forest.river_bank(s.seed, s.field, forest.ARENA_ROW)
            tx = (b - 5) * FP + FP / 2
            ty = (forest.origin(s.seed, s.area) + forest.ARENA_ROW) * FP + FP / 2
        }
        if near(f.x, f.y, tx, ty, FP / 2) {
            s.foes[i].speed = 0
        } else {
            boss_run(mut s, i, tx, ty, boss_speed(f.kind))
        }
        return
    }
    if f.phase == CROUCH {
        // The tell: the body turns toward where the cub stood, slowly.
        let h = heading_to(f.x, f.y, f.target_x, f.target_y)
        if h >= 0 { boss_turn_toward(mut s, i, h) }
        s.foes[i].speed = 0
        if age >= m.windup {
            s.foes[i].phase = STRIKE
            s.foes[i].since = s.tick
            s.foes[i].hit = false
        }
        return
    }
    if f.phase == STRIKE {
        if m.travel > 0 {
            // The run along the committed line: a step that would enter the
            // cub's body is the hit (bodies never overlap); a step the
            // arena, the ground or another body refuses ends the run.
            let nx = f.x + m.travel * sin(f.heading) / FP
            let ny = f.y - m.travel * cos(f.heading) / FP
            let b = foe_body_at(f, nx, ny, f.heading)
            var stop = false
            if !f.hit && s.action != FALL && overlap(b, cub_body(s)) {
                boss_hit(mut s, i, m)
                // A parry turned it: the stagger stands, the run is over.
                if s.foes[i].phase == STAGGER { s.foes[i].speed = 0; return }
                stop = true
            } else if boss_may_stand(s, i, nx, ny, f.heading) {
                s.foes[i].x = nx
                s.foes[i].y = ny
                s.foes[i].speed = m.travel
            } else {
                stop = true
            }
            if stop || age + 1 >= m.active {
                s.foes[i].speed = 0
                end_strike(mut s, i, p2)
            }
            return
        }
        // A standing attack: the first tick in reach and in the cone (or
        // all round) lands once.
        if !f.hit && age < m.active && s.action != FALL {
            let g = body_gap(s, i)
            let hits = g >= 0 &&
                g <= m.reach - 1 &&
                (m.around || in_front(f.x, f.y, f.heading, s.x, s.y))
            if hits && m.damage > 0 {
                boss_hit(mut s, i, m)
                // A parry turned it: the stagger stands past the strike's end.
                if s.foes[i].phase == STAGGER { return }
            }
            if f.kind == ALPHA && f.attack == 2 {
                // The howl: the alpha heals unless its windup was punished.
                s.foes[i].health += 30
                if s.foes[i].health > foe_health(ALPHA) { s.foes[i].health = foe_health(ALPHA) }
                s.foes[i].hit = true
                s.cue = CUE_HOWL
            }
        }
        if age + 1 >= m.active { end_strike(mut s, i, p2) }
        return
    }
    if f.phase == RETREAT {
        s.foes[i].speed = 0
        if age >= m.recovery { s.foes[i].phase = HUNT; s.foes[i].since = s.tick }
        return
    }
    if f.phase == STAGGER {
        s.foes[i].speed = 0
        if age >= STAGGER_TICKS { s.foes[i].phase = HUNT; s.foes[i].since = s.tick }
        return
    }
    if f.phase == FOE_PARRY {
        if age >= GUARD_TICKS { s.foes[i].phase = HUNT; s.foes[i].since = s.tick }
        return
    }
    if f.phase == FOE_DODGE {
        // Three cells across the cub's aim over six ticks, invulnerable.
        let h = (f.attack + TURN) % TURN
        let distance = (age + 1) * 3 * FP / HOP_TICKS - age * 3 * FP / HOP_TICKS
        let nx = f.x + distance * sin(h) / FP
        let ny = f.y - distance * cos(h) / FP
        if boss_may_stand(s, i, nx, ny, f.heading) { s.foes[i].x = nx; s.foes[i].y = ny }
        if age + 1 >= HOP_TICKS {
            s.foes[i].phase = HUNT
            s.foes[i].since = s.tick
            s.foes[i].attack = 0
        }
        return
    }
}

/// A strike's end: the recovery; the boar's first charge in phase 2 goes
/// straight into its second windup.
fn end_strike(mut s: Sim, i: int, p2: bool) {
    let f = copy s.foes[i]
    if f.kind == BOAR && f.attack == 1 && p2 {
        begin_move(mut s, i, 2)
        return
    }
    s.foes[i].phase = RETREAT
    s.foes[i].since = s.tick
}

/// The alpha mirrors the cub (cb04): a bite begun within its reach meets
/// its guard half the time (three quarters in phase 2); a lunge or a heavy
/// begun within six cells meets its hop as often. The seed's hash of the
/// tick decides, never a stream.
fn alpha_reacts(mut s: Sim, action: int) {
    let i = boss_index(s)
    if i < 0 || s.foes[i].kind != ALPHA || s.foes[i].phase != HUNT { return }
    let f = copy s.foes[i]
    let roll = world.hash(s.seed, s.tick, 23, 4)
    let often = if phase_two(f) then 3 else 2
    let g = body_gap(s, i)
    if action == BITE && g <= 2 && roll < often {
        s.foes[i].phase = FOE_PARRY
        s.foes[i].since = s.tick
        return
    }
    if (action == LUNGE || action == HEAVY) && g <= 6 && roll < often {
        s.foes[i].phase = FOE_DODGE
        s.foes[i].since = s.tick
        // Across the cub's aim, to the side with room.
        let side = (s.attack_heading + 64) % TURN
        let nx = f.x + 3 * FP * sin(side) / FP
        let ny = f.y - 3 * FP * cos(side) / FP
        s.foes[i].attack = if boss_may_stand(s, i, nx, ny, f.heading) {
            side
        } else {
            (side + 128) % TURN
        }
    }
}

/// A boss is beaten: the save remembers it, its shortcut home opens, its
/// scent lies where it fell (a drop, as any foe's), the cue sounds; the
/// alpha's fall is the end (cb04's scene 3).
fn beat_boss(mut s: Sim, kind: int, x: int, y: int) {
    s.boss = -1
    s.bosses += (if s.bosses / boss_bit(kind) % 2 == 0 then boss_bit(kind) else 0)
    let edge = boss_shortcut(kind)
    if edge >= 0 { open_shortcut(mut s, edge) }
    if boss_scent(kind) > 0 { leave_drop(mut s, x, y, boss_scent(kind)) }
    s.cue = CUE_BEATEN
    if kind == ALPHA {
        s.end = true
        mark_time(mut s)
    }
}

/// The cue a boss fight begins with: `CUE_BOSS + kind - BOAR`, one slot a
/// boss (cb03's theme slots, named in `cue_hook`).
pub const CUE_BOSS: int = 4

/// A boss falls.
pub const CUE_BEATEN: int = 8

/// The alpha howls; the pack howls at the end.
pub const CUE_HOWL: int = 9

/// The title's own part begins.
pub const CUE_TITLE: int = 10

/// The end's scene (cb04): the ford, the wolf crossing, the end card.
pub const SCENE_END: int = 3

/// The title's scene (cb04).
pub const SCENE_TITLE: int = 2

/// Sprint cap at a paw level, always above the meadow's 86 FP/tick flee.
pub fn sprint_at(paw: int) -> int { trot_at(paw) * 8 / 5 }

/// Repeat-inferred c hold; the first press still performs an immediate dodge.
pub fn sprint_held(s: Sim) -> bool {
    input.held(s.sprint_hold, s.tick) && s.sprint_hold.last - s.sprint_hold.prev <= 30
}

/// Sprint stamina per thirty moving ticks, charged with an integer accumulator.
pub const SPRINT_PER_SECOND: int = 12

/// Forward snapping sprint attack: three active frames, reach four, no combo.
pub const DASH: int = 8

/// More than the lunge's thirty stamina.
pub const DASH_COST: int = 36

/// Combo's hit cone and presentation rotate about the committed eight-way aim.
pub fn attack_direction(s: Sim) -> int {
    let slant = if s.action != BITE {
        0
    } else if s.combo == 1 {
        -11
    } else if s.combo == 2 {
        11
    } else {
        0
    }
    (s.attack_heading + slant + TURN) % TURN
}

/// Hits landed by the current snapping lunge, for real-key and pty witnesses.
pub fn dash_hits(s: Sim) -> int {
    if s.action != DASH { return 0 }
    var n = 0
    for f in s.foes { if f.last_hit == s.started { n += 1 } }
    n
}

fn meadow_near(s: Sim, kind: int, radius: int) -> bool {
    let (x, y, _) = meadow.anchor(s.seed, cell_x(s), cell_y(s))
    let width = forest.half_width(s.field)
    y >= 6 &&
        y < forest.LENGTH - 4 &&
        x > -width + 4 &&
        x < width - 4 &&
        !forest.on_path(s.seed, s.field, s.area, x, y) &&
        meadow.near_kind(s.seed, cell_x(s), cell_y(s), kind, radius)
}

/// A kill's small immediate heal, separate from its scent and death mark.
pub struct Meat { x: int, y: int, until: int }

/// Health restored by one fresh meat pickup, clamped to the heart cap.
pub const MEAT_HEAL: int = 10

/// The first spring teaches two mouthfuls; the second upgrades to FLASKS.
pub const SPRINGS: int = 2

/// Region of a spring's stable id.
pub fn spring_area(id: int) -> int { if id == 0 then forest.SHINGLE else forest.LARKMEADOW }

/// A spring on the carved route, beyond the entry den (fixed point).
pub fn spring_position(seed: int, id: int) -> (int, int) {
    let area = spring_area(id)
    let at = if id == 0 then 24 else 72
    (forest.spine(seed, area, at) * FP + FP / 2, (forest.origin(seed, area) + at) * FP + FP / 2)
}

/// Draw a spring until its finite discovery has been claimed. The later
/// spring requires learning to drink first; capacity itself persists this.
pub fn spring_available(s: Sim, id: int) -> bool {
    id >= 0 &&
        id < SPRINGS &&
        s.area == spring_area(id) &&
        (if id == 0 then s.flask_max == 0 else s.flask_max == 2)
}

// One collection seam, using cb04c's body/contact-ring rule unchanged.
fn cb04a_pickup_near(s: Sim, x: int, y: int) -> bool { pickup_near(s, x, y) }

/// The one collection path for meat and springs; drawing owns no effects.
pub fn healing_pickups(mut s: Sim) {
    var keep = List[Meat]()
    var i = 0
    while i < s.meat.len {
        let meat = copy s.meat[i]
        i += 1
        if meat.until > s.tick {
            if meat.until - s.tick < DROP_TICKS && cb04a_pickup_near(s, meat.x, meat.y) {
                pickup_flash(mut s, meat.x, meat.y)
                s.health += MEAT_HEAL
                if s.health > health_max(s.heart) { s.health = health_max(s.heart) }
            } else {
                (mut keep).push(copy meat)
            }
        }
    }
    s.meat = keep
    var id = 0
    while id < SPRINGS {
        let (x, y) = spring_position(s.seed, id)
        if spring_available(s, id) && cb04a_pickup_near(s, x, y) {
            pickup_flash(mut s, x, y)
            s.flask_max = if id == 0 then 2 else FLASKS
            s.flasks = s.flask_max
        }
        id += 1
    }
}

/// Discard every unconfirmed choice. This state is deliberately absent from schema four.
pub fn rest_reset(mut s: Sim) {
    s.rest_row = 0
    s.rest_refused = 0
    (mut s.rest_pending).reset()
    var i = 0
    while i < 5 { (mut s.rest_pending).push(0); i += 1 }
}

/// Pending increments of a stat, including a freshly entered fixture's empty menu.
pub fn rest_delta(s: Sim, stat: int) -> int {
    if stat >= 0 && stat < s.rest_pending.len then s.rest_pending[stat] else 0
}

/// Number of staged purchases, not five independently priced tracks.
pub fn rest_levels(s: Sim) -> int {
    var n = 0
    for delta in s.rest_pending { n += delta }
    n
}

/// Sum cb04a's shared curve at each intervening level.
pub fn rest_cost(s: Sim) -> int {
    var cost = 0
    var n = 0
    while n < rest_levels(s) { cost += level_cost(level(s) + n); n += 1 }
    cost
}

/// Menu input: wrap over five stats and Confirm; apply as one transaction.
pub fn rest_key(mut s: Sim, key: int) {
    if !s.den { return }
    if s.rest_pending.len != 5 { rest_reset(mut s) }
    if key == controls.KEY_RELEASE || key == controls.KEY_REST {
        rest_reset(mut s)
        s.den = false
        return
    }
    if key == controls.KEY_UP { s.rest_row = (s.rest_row + 5) % 6 }
    if key == controls.KEY_DOWN { s.rest_row = (s.rest_row + 1) % 6 }
    if s.rest_row < 5 && key == controls.KEY_LEFT {
        if s.rest_pending[s.rest_row] > 0 { s.rest_pending[s.rest_row] -= 1 }
        s.rest_refused = 0
    }
    if s.rest_row < 5 && key == controls.KEY_RIGHT {
        let value = stat_value(s, s.rest_row) + rest_delta(s, s.rest_row)
        if value < STAT_MAX {
            let cost = rest_cost(s) + level_cost(level(s) + rest_levels(s))
            if cost <= s.scent {
                s.rest_pending[s.rest_row] += 1
                s.rest_refused = 0
            } else {
                s.rest_refused = cost
            }
        }
    }
    if s.rest_row == 5 && (key == controls.KEY_CONFIRM || key == controls.KEY_BITE) {
        let cost = rest_cost(s)
        if cost > s.scent { s.rest_refused = cost; return }
        s.heart += s.rest_pending[0]
        s.wind += s.rest_pending[1]
        s.fang += s.rest_pending[2]
        s.paw += s.rest_pending[3]
        s.nose += s.rest_pending[4]
        s.scent -= cost
        s.health = health_max(s.heart)
        s.stamina = stamina_max(s.wind)
        rest_reset(mut s)
    }
}
