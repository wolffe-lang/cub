//! sim — the cub on the Shingle: a position, a heading, a speed and the
//! held keys that steer them, over `terrain`'s ground, with the camera on
//! the cub (ruling #130, R-CB-3: a scrolling world, not screens). Pure and
//! deterministic: a run is a function of the seed and the keys by tick
//! (the track's rule 3), which is what the goldens pin.
//!
//! The realism bars (the campaign's): the cub has a position in fixed
//! point, a heading that turns at `TURN_RATE` toward the held direction
//! (it never pivots), a speed that rises at `ACCEL` and falls at `BRAKE`;
//! a key is held by the engine's model from its autorepeat ticks alone.
//! Trunks, deep forest and the Ashwater stop it. The stats of section 3 are
//! here as the first constants (every number `docs/DESIGN.md`'s, proposed;
//! R-CB-7: the maintainer's by play): the scaffold moves a fresh cub with
//! heart, wind, fang, paw and nose at 1; the fight, den and scent loop follows below.

use controls
use forest
use input
use terrain
use world

/// Fixed-point units a cell (the engine's).
pub const FP: int = 256

/// Heading units a full turn: 0 north, 64 east, 128 south, 192 west.
pub const TURN: int = 256

/// The trot, fixed-point units a tick at paw 1 (`TROT_V + 2 × paw`, the
/// bible's section 3): 0.15 cells a tick, 4.4 a second, a cub's pace
/// under pack's migrating trot of 40.
pub const TROT_V: int = 36

/// A sneak's speed: half the trot (section 4).
pub const SNEAK_V: int = 21

/// Walk and sneak multiplier, rounded to the nearest fixed-point unit.
pub const WALK_PERCENT: int = 110

/// Acceleration, FP units a tick each tick: the trot from a stop in 9 ticks.
pub const ACCEL: int = 4

/// Braking: a stop from the trot in 5 ticks; a cub stops faster than it starts.
pub const BRAKE: int = 8

/// The turn rate, heading units a tick: a quarter turn in 4 ticks, about
/// turned in 8 (267 ms). The cub turns, never pivots.
pub const TURN_RATE: int = 16

/// Heart, wind, fang, paw and nose at the start (section 3): 1 each.
pub const STAT_START: int = 1

/// Health at heart `h`: `40 + 12 × h`.
pub fn health_max(heart: int) -> int {
    40 + 12 * heart
}

/// Stamina at wind `w`: `60 + 10 × w`.
pub fn stamina_max(wind: int) -> int {
    60 + 10 * wind
}

/// The trot at paw `p`.
pub fn trot_at(paw: int) -> int {
    ((TROT_V + 2 * paw) * WALK_PERCENT + 50) / 100
}

/// The quarter sine, 65 entries of `[0, 256]` over `[0, 64]` heading units.
fn quarter_sin(i: int) -> int {
    match i {
        0 => 0,
        1 => 6,
        2 => 13,
        3 => 19,
        4 => 25,
        5 => 31,
        6 => 38,
        7 => 44,
        8 => 50,
        9 => 56,
        10 => 62,
        11 => 68,
        12 => 74,
        13 => 80,
        14 => 86,
        15 => 92,
        16 => 98,
        17 => 104,
        18 => 109,
        19 => 115,
        20 => 121,
        21 => 126,
        22 => 132,
        23 => 137,
        24 => 142,
        25 => 147,
        26 => 152,
        27 => 157,
        28 => 162,
        29 => 167,
        30 => 172,
        31 => 177,
        32 => 181,
        33 => 185,
        34 => 190,
        35 => 194,
        36 => 198,
        37 => 202,
        38 => 206,
        39 => 209,
        40 => 213,
        41 => 216,
        42 => 220,
        43 => 223,
        44 => 226,
        45 => 229,
        46 => 231,
        47 => 234,
        48 => 237,
        49 => 239,
        50 => 241,
        51 => 243,
        52 => 245,
        53 => 247,
        54 => 248,
        55 => 250,
        56 => 251,
        57 => 252,
        58 => 253,
        59 => 254,
        60 => 255,
        61 => 255,
        62 => 256,
        63 => 256,
        _ => 256,
    }
}

/// Sine of a heading, in `[-256, 256]`: east is 256 at heading 64.
pub fn sin(h: int) -> int {
    let a = (h % TURN + TURN) % TURN
    if a <= 64 {
        return quarter_sin(a)
    }
    if a <= 128 {
        return quarter_sin(128 - a)
    }
    if a <= 192 {
        return 0 - quarter_sin(a - 128)
    }
    0 - quarter_sin(256 - a)
}

/// Cosine of a heading: north is 256 at heading 0.
pub fn cos(h: int) -> int {
    sin(h + 64)
}

/// The heading units from `from` to `to` by the shortest way, in
/// `(-128, 128]`.
pub fn turn_toward(from: int, to: int) -> int {
    var d = (to - from) % TURN
    if d > 128 {
        d -= TURN
    }
    if d <= -128 {
        d += TURN
    }
    d
}

/// The cub: where it is (fixed-point world cells, x east, y south), the
/// heading it faces and the one it wants, its speed, its stats and what
/// they give, and the eight held movement keys.
pub struct Sim {
    seed: int,
    cols: int,
    rows: int,
    tick: int,
    x: int,
    y: int,
    heading: int,
    heading_target: int,
    speed: int,
    sneaking: bool,
    moving: bool,
    blocked: int,
    heart: int,
    wind: int,
    fang: int,
    paw: int,
    nose: int,
    health: int,
    stamina: int,
    holds: List[input.Hold],
    aim_order: List[int],
    aim_serial: int,
    attack_heading: int,
    chained_heading: int,
    action: int,
    started: int,
    chained: bool,
    combo: int,
    exhausted: bool,
    locked: int,
    unseen: int,
    riposte: int,
    riposte_foe: int,
    flasks: int,
    scent: int,
    den: bool,
    death_at: int,
    deaths: int,
    mark: bool,
    mark_x: int,
    mark_y: int,
    mark_scent: int,
    gate_open: bool,
    area: int,
    last_den: int,
    lit_dens: int,
    shortcuts: int,
    story: int,
    difficulty: int,
    flask_max: int,
    mark_area: int,
    entered: int,
    edge_ready: bool,
    save_status: int,
    gate_hint_until: int,
    drops: List[Drop],
    caches: int,
    yarrow: int,
    marrow: int,
    opening_seen: bool,
    scene: int,
    scene_started: int,
    cue: int,
    foes: List[Foe],
    trail: List[Trail],
}

/// A new cub at the Shingle's start, facing north toward the water, still.
pub fn new(seed: int, cols: int, rows: int) -> Sim {
    let (x, y) = terrain.start(seed)
    var holds = List[input.Hold]()
    var aim_order = List[int]()
    var i = 0
    while i < 8 {
        (mut holds).push(input.hold_new())
        (mut aim_order).push(0)
        i += 1
    }
    Sim {
        seed: seed,
        cols: cols,
        rows: rows,
        tick: 0,
        x: x,
        y: y,
        heading: 0,
        heading_target: 0,
        speed: 0,
        sneaking: false,
        moving: false,
        blocked: 0,
        heart: STAT_START,
        wind: STAT_START,
        fang: STAT_START,
        paw: STAT_START,
        nose: STAT_START,
        health: health_max(STAT_START),
        stamina: stamina_max(STAT_START),
        holds: holds,
        aim_order: aim_order,
        aim_serial: 0,
        attack_heading: 0,
        chained_heading: 0,
        action: IDLE,
        started: 0,
        chained: false,
        combo: 0,
        exhausted: false,
        locked: -1,
        unseen: 0,
        riposte: 0,
        riposte_foe: -1,
        flasks: FLASKS,
        scent: 0,
        den: false,
        death_at: 0,
        deaths: 0,
        mark: false,
        mark_x: 0,
        mark_y: 0,
        mark_scent: 0,
        gate_open: false,
        area: forest.SHINGLE,
        last_den: 0,
        lit_dens: 1,
        shortcuts: 0,
        story: 0,
        difficulty: 0,
        flask_max: FLASKS,
        mark_area: 0,
        entered: -120,
        edge_ready: true,
        save_status: 0,
        gate_hint_until: 0,
        drops: List[Drop](),
        caches: 0,
        yarrow: 0,
        marrow: 0,
        opening_seen: false,
        scene: 0,
        scene_started: 0,
        cue: 0,
        foes: area_foes(seed, forest.SHINGLE),
        trail: List[Trail](),
    }
}

/// The screen's size changed: the camera keeps the cub at the centre.
pub fn resize(mut s: Sim, cols: int, rows: int) {
    s.cols = cols
    s.rows = rows
}

/// The cub's screen row: the centre (R-CB-3, the camera on the cub).
pub fn screen_row(s: Sim) -> int {
    s.rows / 2
}

/// The cub's screen column: the centre.
pub fn screen_col(s: Sim) -> int {
    s.cols / 2
}

/// The world cell under screen `(row, col)`: the camera's corner plus the
/// offset, the cub's own cell at the centre.
pub fn world_cell(s: Sim, row: int, col: int) -> (int, int) {
    (cell_x(s) - screen_col(s) + col, cell_y(s) - screen_row(s) + row)
}

/// The cub's world column.
pub fn cell_x(s: Sim) -> int {
    floor_div(s.x, FP)
}

/// The cub's world row.
pub fn cell_y(s: Sim) -> int {
    floor_div(s.y, FP)
}

/// Floor division keeps negative world coordinates in their true cells.
pub fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b < 0 then q - 1 else q
}

/// The direction the cub faces, 0 north, 1 east, 2 south, 3 west (the
/// nearest quarter).
pub fn facing(s: Sim) -> int {
    ((s.heading + 32) % TURN + TURN) % TURN / 64
}

fn toward(v: int, target: int, step: int) -> int {
    if v < target {
        return if v + step > target then target else v + step
    }
    if v > target {
        return if v - step < target then target else v - step
    }
    v
}

/// The heading a set of held directions means: north 0, east 64, south
/// 128, west 192, the diagonals between; or -1 when none or when opposites
/// cancel.
pub fn heading_of(up: bool, down: bool, left: bool, right: bool) -> int {
    let dy = (if down then 1 else 0) - (if up then 1 else 0)
    let dx = (if right then 1 else 0) - (if left then 1 else 0)
    if dx == 0 && dy == 0 {
        return -1
    }
    if dx == 0 {
        return if dy < 0 then 0 else 128
    }
    if dy == 0 {
        return if dx > 0 then 64 else 192
    }
    if dy < 0 {
        return if dx > 0 then 32 else 224
    }
    if dx > 0 then 96 else 160
}

/// One tick: the keys pressed this tick (cub's numbers), the holds read,
/// the heading turned, the speed changed, the cub moved where the ground
/// lets it.
fn locomotion(mut s: Sim) {
    var held = List[bool]()
    var i = 0
    while i < 8 {
        (mut held).push(input.held(s.holds[i], s.tick))
        i += 1
    }
    let sneak_held = held[4] || held[5] || held[6] || held[7]
    let want = heading_of(
        held[0] || held[4],
        held[1] || held[5],
        held[2] || held[6],
        held[3] || held[7],
    )
    s.moving = want >= 0
    s.sneaking = s.moving && sneak_held
    if s.moving && s.locked < 0 {
        s.heading_target = want
    }
    if s.locked >= 0 {
        s.heading_target = heading_to(s.x, s.y, s.foes[s.locked].x, s.foes[s.locked].y)
    }
    // The turn, at the turn rate, by the shortest way.
    let d = turn_toward(s.heading, s.heading_target)
    let step_h = if d > TURN_RATE then TURN_RATE else if d < 0 - TURN_RATE then 0 - TURN_RATE else d
    s.heading = ((s.heading + step_h) % TURN + TURN) % TURN
    // The speed: toward the trot (or the sneak) while a key is held, to a
    // stop when none is.
    let pace = if s.health * 3 < health_max(s.heart) then trot_at(s.paw) / 2 else trot_at(s.paw)
    let want_v = if !s.moving || s.action != IDLE {
        0
    } else if s.sneaking {
        trot_at(s.paw) / 2
    } else {
        pace
    }
    s.speed = toward(s.speed, want_v, if want_v > s.speed then ACCEL else BRAKE)
    // The move, each axis on its own, so a wall along one lets the other
    // slide; a blocked axis stops the cub.
    let dx = s.speed * sin(s.heading) / 256
    let dy = 0 - s.speed * cos(s.heading) / 256
    let nx = s.x + dx
    if !blocked(s, floor_div(nx, FP), cell_y(s)) && !body_at(s, nx, s.y) {
        s.x = nx
    } else {
        s.speed = 0
        s.blocked += 1
    }
    let ny = s.y + dy
    if !blocked(s, cell_x(s), floor_div(ny, FP)) && !body_at(s, s.x, ny) {
        s.y = ny
    } else {
        s.speed = 0
        s.blocked += 1
    }
}

/// The distance walked, cells, for the closing line.
pub fn distance_cells(s: Sim) -> int {
    let (x0, y0) = terrain.start(s.seed)
    let dx = (s.x - x0) / FP
    let dy = (s.y - y0) / FP
    (if dx < 0 then 0 - dx else dx) + (if dy < 0 then 0 - dy else dy)
}

/// A world cell's variant, for the frame (the engine's hash).
pub fn variant(s: Sim, x: int, y: int, n: int) -> int {
    world.hash(s.seed + 31, x, y, n)
}

// Bible §§3–8, and dated proposals in docs/DESIGN.md.
/// No action in progress.
pub const IDLE: int = 0

/// Light bite action.
pub const BITE: int = 1

/// Heavy lunge action.
pub const LUNGE: int = 2

/// Timed defensive action.
pub const PARRY: int = 3

/// Three-cell evasive hop.
pub const DODGE: int = 4

/// Thirty-tick water action.
pub const DRINK: int = 5

/// Death fade action.
pub const FALL: int = 6

/// Active parry ticks, excluding recovery.
pub const PARRY_WINDOW: int = 9

/// Ticks a parried foe cannot attack.
pub const STAGGER_TICKS: int = 30

/// Lifetime of a deposited scent cell.
pub const TRAIL_TICKS: int = 300

/// Mouthfuls restored by a den.
pub const FLASKS: int = 3

/// Health restored in the final fifteen drinking ticks.
pub const FLASK_HEAL: int = 40

/// Stamina per idle tick; walking receives half.
pub const REGEN: int = 2

/// Stamina needed to clear exhaustion.
pub const EXHAUST_RECOVER: int = 24

/// Next stat level multiplies this cost.
pub const SCENT_LEVEL_BASE: int = 40

/// Weasel species identifier.
pub const WEASEL: int = 0

/// Fox species identifier.
pub const FOX: int = 1

/// Perception and pursuit phase.
pub const HUNT: int = 0

/// Real attack windup.
pub const CROUCH: int = 1

/// Active foe attack.
pub const STRIKE: int = 2

/// Recovery with movement away from the target.
pub const RETREAT: int = 3

/// Defenceless recovery after parry or lunge.
pub const STAGGER: int = 4

/// Fox false windup; never deals damage.
pub const FEINT: int = 5

/// Gap before the fox real windup.
pub const PAUSE: int = 6

/// Readable ticks between crouch and strike.
pub const WEASEL_WINDUP: int = 12

/// Base sight radius in cells.
pub const SIGHT: int = 8

/// Enemy trail detection radius in cells.
pub const SCENT_RADIUS: int = 6

/// A world-space scent sample with an exclusive expiry tick.
pub struct Trail { x: int, y: int, until: int }

/// A deterministic opponent, its ground body and timed attack.
pub struct Foe {
    kind: int,
    x: int,
    y: int,
    heading: int,
    speed: int,
    stamina: int,
    health: int,
    phase: int,
    since: int,
    target_x: int,
    target_y: int,
    home_x: int,
    home_y: int,
    hit: bool,
    last_hit: int,
    died: int,
}

/// Damage of an unmodified bite at this fang level.
pub fn bite_damage(fang: int) -> int { 6 + 2 * fang }

/// Invulnerable ticks at this paw level (integer division).
pub fn dodge_iframes(paw: int) -> int { 6 + paw / 2 }

/// Absolute value for bounded world coordinates.
pub fn abs(v: int) -> int { if v < 0 then 0 - v else v }

/// Whether two fixed-point points are within an inclusive radius.
pub fn near(x: int, y: int, tx: int, ty: int, radius: int) -> bool {
    let dx = x - tx
    let dy = y - ty
    dx * dx + dy * dy <= radius * radius
}

/// Close-quarters unit-fixture foes; live encounters use area_foes.
pub fn spawn_foes(seed: int) -> List[Foe] {
    let (_, y) = terrain.start(seed)
    var foes = List[Foe]()
    var i = 0
    while i < 3 {
        let x = (if i == 0 then 9 else if i == 1 then 13 else 20) * FP
        (mut foes).push(Foe {
            kind: if i == 2 then FOX else WEASEL,
            x: x,
            y: y,
            heading: 64,
            speed: 0,
            stamina: 60,
            health: if i == 2 then 24 else 8,
            phase: HUNT,
            since: 0,
            target_x: x,
            target_y: y,
            home_x: x,
            home_y: y,
            hit: false,
            last_hit: -1,
            died: -1,
        })
        i += 1
    }
    foes
}

/// World row of the southern thorn gate.
pub fn gate_y(s: Sim) -> int {
    let (_, y) = terrain.start(s.seed)
    floor_div(y, FP) + forest.LENGTH - 3
}

/// Terrain and unopened thorns block a world cell.
pub fn blocked(s: Sim, x: int, y: int) -> bool {
    s.area == forest.SHINGLE && !s.gate_open && y == gate_y(s) && x >= -2 && x <= 2 ||
        forest.blocked(s.seed, s.area, x, y)
}

/// Occlusion is integer sampled at half-cell intervals, including the endpoint.
pub fn visible(s: Sim, x: int, y: int, tx: int, ty: int) -> bool {
    let dx = tx - x
    let dy = ty - y
    let steps = (abs(dx) + abs(dy)) / (FP / 2) + 1
    var i = 1
    while i <= steps {
        if blocked(s, floor_div(x + dx * i / steps, FP), floor_div(y + dy * i / steps, FP)) {
            return false
        }
        i += 1
    }
    true
}

/// Eight-way bearing between two points, or -1 at coincidence.
pub fn heading_to(x: int, y: int, tx: int, ty: int) -> int {
    let dx = tx - x
    let dy = ty - y
    // Eight directions, still approached at TURN_RATE rather than pivoted.
    heading_of(
        dy < 0 && abs(dy) * 2 >= abs(dx),
        dy > 0 && abs(dy) * 2 >= abs(dx),
        dx < 0 && abs(dx) * 2 >= abs(dy),
        dx > 0 && abs(dx) * 2 >= abs(dy),
    )
}

fn in_front(x: int, y: int, heading: int, tx: int, ty: int) -> bool {
    let dx = tx - x
    let dy = ty - y
    let dot = dx * sin(heading) - dy * cos(heading)
    let cross = dx * cos(heading) + dy * sin(heading)
    dot >= 0 && abs(cross) <= dot
}

/// Cone, range and occlusion jointly determine foe sight.
pub fn can_see(s: Sim, f: Foe) -> bool {
    near(f.x, f.y, s.x, s.y, (if s.area == forest.BRAMBLEHOLD then 5 else SIGHT) * FP) &&
        in_front(f.x, f.y, f.heading, s.x, s.y) &&
        visible(s, f.x, f.y, s.x, s.y)
}

/// Whether the current tick is inside the half-open parry window.
pub fn parrying(s: Sim) -> bool {
    s.action == PARRY && s.tick - s.started < PARRY_WINDOW
}

/// Whether the current tick is inside the dodge iframe window.
pub fn invulnerable(s: Sim) -> bool {
    s.action == DODGE && s.tick - s.started < dodge_iframes(s.paw)
}

/// Apply damage unless protected; zero health replaces the scent mark.
pub fn hurt(mut s: Sim, damage: int) {
    if s.action == FALL || s.den || invulnerable(s) { return }
    s.health -= damage
    if s.action == DRINK { s.action = IDLE }
    if s.health <= 0 {
        s.health = 0
        s.action = FALL
        s.started = s.tick
        s.death_at = s.tick
        s.deaths += 1
        // Replace, never accumulate: a second death destroys the first mark.
        s.mark = true
        s.mark_area = s.area
        s.mark_x = s.x
        s.mark_y = s.y
        s.mark_scent = s.scent
        s.scent = 0
        s.locked = -1
        s.speed = 0
    }
}

fn reset_world(mut s: Sim) {
    s.health = health_max(s.heart)
    s.stamina = stamina_max(s.wind)
    s.flasks = s.flask_max
    s.action = IDLE
    s.speed = 0
    s.exhausted = false
    s.locked = -1
    s.riposte = 0
    s.riposte_foe = -1
    s.chained = false
    s.combo = 0
    s.foes = area_foes(s.seed, s.area)
    (mut s.drops).reset()
    (mut s.trail).reset()
    var i = 0
    while i < s.holds.len { s.holds[i] = input.hold_new(); i += 1 }
}

/// Whether the hollow log is within resting reach.
pub fn at_den(s: Sim) -> bool {
    den_here(s) >= 0
}

/// Spend scent on the selected stat only at a den; capped at ten.
pub fn grow(mut s: Sim, stat: int) {
    if !s.den { return }
    let level = if stat == 0 {
        s.heart
    } else if stat == 1 {
        s.wind
    } else if stat == 2 {
        s.fang
    } else if stat == 3 {
        s.paw
    } else {
        s.nose
    }
    let cost = SCENT_LEVEL_BASE * (level + 1)
    if level >= 10 || s.scent < cost { return }
    s.scent -= cost
    if stat == 0 { s.heart += 1 }
    if stat == 1 { s.wind += 1 }
    if stat == 2 { s.fang += 1 }
    if stat == 3 { s.paw += 1 }
    if stat == 4 { s.nose += 1 }
    s.health = health_max(s.heart)
    s.stamina = stamina_max(s.wind)
}

fn lock_next(mut s: Sim) {
    var best = -1
    var distance = 999999999
    var i = 0
    // First lock is nearest; later presses cycle stable spawn order.
    while i < s.foes.len {
        let j = if s.locked < 0 then i else (s.locked + 1 + i) % s.foes.len
        let f = copy s.foes[j]
        if f.health > 0 &&
            near(s.x, s.y, f.x, f.y, (SIGHT + s.nose) * FP) &&
            visible(s, s.x, s.y, f.x, f.y) {
            let d = (s.x - f.x) * (s.x - f.x) + (s.y - f.y) * (s.y - f.y)
            if s.locked >= 0 { best = j; break }
            if d < distance { best = j; distance = d }
        }
        i += 1
    }
    s.locked = best
    s.unseen = 0
}

fn start_action(mut s: Sim, action: int, cost: int) {
    if s.action != IDLE || s.stamina < cost { return }
    if s.exhausted && (action == LUNGE || action == HEAVY || action == DODGE) { return }
    s.stamina -= cost
    if s.stamina == 0 { s.exhausted = true }
    s.attack_heading = attack_aim(s)
    s.action = action
    s.combo = if action == BITE then 1 else 0
    s.started = s.tick
    s.speed = 0
    s.chained = false
}

fn action_keys(mut s: Sim, keys: List[int]) {
    for k in keys {
        if controls.is_move(k) {
            let i = k - controls.KEY_UP
            if s.holds[i].last != s.tick { input.hold_press(mut s.holds[i], s.tick) }
            s.aim_serial += 1
            s.aim_order[i] = s.aim_serial
        }
        if k == controls.KEY_RELEASE { s.locked = -1; s.den = false }
        if k == controls.KEY_LOCK { lock_next(mut s) }
        if k >= controls.KEY_HEART && k <= controls.KEY_NOSE { grow(mut s, k - controls.KEY_HEART) }
        if k == controls.KEY_REST && at_den(s) {
            s.last_den = den_here(s)
            s.lit_dens = light_den(s.lit_dens, s.last_den)
            reset_world(mut s)
            s.den = !s.den
        }
        if s.den { continue }
        if k == controls.KEY_REST && !at_den(s) { cache_key(mut s); shortcut_key(mut s) }
        if k == controls.KEY_BITE {
            if s.action == BITE && s.tick - s.started >= 5 && s.tick - s.started < 11 {
                s.chained = true
                s.chained_heading = attack_aim(s)
            }
            start_action(mut s, BITE, 12)
        }
        if k == controls.KEY_HEAVY { start_action(mut s, HEAVY, HEAVY_COST) }
        if k == controls.KEY_LUNGE { start_action(mut s, LUNGE, 30) }
        if k == controls.KEY_PARRY { start_action(mut s, PARRY, 10) }
        if k == controls.KEY_DODGE { start_action(mut s, DODGE, 18) }
        if k == controls.KEY_WATER && s.action == IDLE && s.flasks > 0 {
            s.flasks -= 1
            start_action(mut s, DRINK, 0)
        }
    }
}

fn strike_foes(mut s: Sim) {
    let age = s.tick - s.started
    let active = s.action == BITE && age >= 3 && age < 5 ||
        s.action == LUNGE && age >= 9 && age < 12 ||
        s.action == HEAVY && age >= HEAVY_WINDUP && age < HEAVY_WINDUP + HEAVY_ACTIVE
    if !active { return }
    let reach = if s.action == LUNGE || s.action == HEAVY then 4 else 2
    let (gate_x, gate_target_y) = gate_target(s)
    if s.action == LUNGE &&
        s.area == forest.SHINGLE &&
        !s.gate_open &&
        near(s.x, s.y, gate_x, gate_target_y, 4 * FP) &&
        in_front(s.x, s.y, s.attack_heading, gate_x, gate_target_y) {
        s.gate_open = true
    }
    if s.action == BITE &&
        s.area == forest.SHINGLE &&
        !s.gate_open &&
        near(s.x, s.y, gate_x, gate_target_y, 2 * FP) &&
        in_front(s.x, s.y, s.attack_heading, gate_x, gate_target_y) {
        s.gate_hint_until = s.tick + ENTRY_TICKS
    }
    var i = 0
    while i < s.foes.len {
        let f = copy s.foes[i]
        if f.health > 0 &&
            f.kind != HAWK &&
            f.last_hit != s.started &&
            near(s.x, s.y, f.x, f.y, reach * FP) &&
            in_front(s.x, s.y, s.attack_heading, f.x, f.y) &&
            visible(s, s.x, s.y, f.x, f.y) {
            var damage = bite_damage(s.fang)
            if s.action == LUNGE { damage *= 3 }
            if s.action == HEAVY { damage *= HEAVY_DAMAGE }
            if s.action == BITE && s.tick < s.riposte && i == s.riposte_foe {
                damage *= 2
                s.riposte = 0
            }
            s.foes[i].health -= damage
            s.foes[i].last_hit = s.started
            if s.foes[i].health <= 0 {
                s.foes[i].died = s.tick
                leave_drop(
                    mut s,
                    f.x,
                    f.y,
                    if f.kind == FOX then 20 else if f.kind == DEER then 5 else 8,
                )
            } else if s.action == LUNGE || s.action == HEAVY {
                s.foes[i].phase = STAGGER
                s.foes[i].since = s.tick
            }
        }
        i += 1
    }
}

/// Opponents move on the ground. The presentation's arc never moves their
/// body through another creature or alters the damage envelope.
fn move_foe(mut s: Sim, i: int, away: bool) {
    let f = copy s.foes[i]
    var h = heading_to(f.x, f.y, f.target_x, f.target_y)
    if h < 0 { s.foes[i].speed = 0; return }
    if away { h = (h + 128) % TURN }
    let d = turn_toward(f.heading, h)
    let heading = (
        f.heading +
            (if d > TURN_RATE then TURN_RATE else if d < 0 - TURN_RATE then 0 - TURN_RATE else d) +
            TURN
    ) %
        TURN
    let speed = toward(f.speed, if away then FOE_RETREAT_V else FOE_STALK_V, ACCEL)
    let nx = f.x + speed * sin(heading) / FP
    let ny = f.y - speed * cos(heading) / FP
    var stops = blocked(s, floor_div(nx, FP), floor_div(ny, FP)) || near(nx, ny, s.x, s.y, FP)
    var j = 0
    while j < s.foes.len {
        if j != i &&
            s.foes[j].health > 0 &&
            s.foes[j].kind != HAWK &&
            near(nx, ny, s.foes[j].x, s.foes[j].y, FP) {
            stops = true
        }
        j += 1
    }
    s.foes[i].heading = heading
    s.foes[i].speed = if stops then 0 else speed
    if !stops { s.foes[i].x = nx; s.foes[i].y = ny }
}

fn foes_step(mut s: Sim) {
    var i = 0
    while i < s.foes.len && s.action != FALL {
        let f = copy s.foes[i]
        if f.health <= 0 { i += 1; continue }
        if f.kind == HAWK {
            hawk_step(mut s, i)
            i += 1
            continue
        }
        if f.kind == DEER {
            if near(f.x, f.y, s.x, s.y, 7 * FP) {
                s.foes[i].target_x = s.x
                s.foes[i].target_y = s.y
                move_foe(mut s, i, true)
            }
            i += 1
            continue
        }
        let age = s.tick - f.since
        if f.phase == HUNT {
            var tracks = can_see(s, f)
            var tx = s.x
            var ty = s.y
            if !tracks {
                var j = s.trail.len - 1
                while j >= 0 {
                    let tr = copy s.trail[j]
                    if tr.until > s.tick &&
                        near(f.x, f.y, tr.x, tr.y, SCENT_RADIUS * FP) &&
                        visible(s, f.x, f.y, tr.x, tr.y) {
                        tracks = true
                        tx = tr.x
                        ty = tr.y
                        break
                    }
                    j -= 1
                }
            }
            if tracks {
                s.foes[i].target_x = tx
                s.foes[i].target_y = ty
                if near(f.x, f.y, s.x, s.y, 2 * FP) &&
                    visible(s, f.x, f.y, s.x, s.y) &&
                    f.stamina >= 12 {
                    s.foes[i].phase = if f.kind == FOX then FEINT else CROUCH
                    s.foes[i].since = s.tick
                    s.foes[i].target_x = s.x
                    s.foes[i].target_y = s.y
                    s.foes[i].speed = 0
                    s.foes[i].stamina -= 12
                } else {
                    move_foe(mut s, i, false)
                }
            } else {
                s.foes[i].speed = 0
            }
            if s.foes[i].stamina < 60 { s.foes[i].stamina += 1 }
        } else if f.phase == FEINT && age >= 10 {
            s.foes[i].phase = PAUSE
            s.foes[i].since = s.tick
        } else if f.phase == PAUSE && age >= 6 {
            s.foes[i].phase = CROUCH
            s.foes[i].since = s.tick
            s.foes[i].target_x = s.x
            s.foes[i].target_y = s.y
        } else if f.phase == CROUCH && age >= WEASEL_WINDUP {
            s.foes[i].phase = STRIKE
            s.foes[i].since = s.tick
            s.foes[i].hit = false
        } else if f.phase == STRIKE && age >= (if f.kind == FOX then 3 else 2) {
            s.foes[i].phase = RETREAT
            s.foes[i].since = s.tick
        } else if f.phase == RETREAT {
            move_foe(mut s, i, true)
            if age >= 24 { s.foes[i].phase = HUNT }
        } else if f.phase == STAGGER && age >= STAGGER_TICKS {
            s.foes[i].phase = if f.kind == WEASEL then RETREAT else HUNT
            s.foes[i].since = s.tick
        }
        if s.foes[i].phase == CROUCH || s.foes[i].phase == FEINT {
            let h = heading_to(f.x, f.y, s.foes[i].target_x, s.foes[i].target_y)
            if h >= 0 {
                let d = turn_toward(f.heading, h)
                let turn = if d > TURN_RATE {
                    TURN_RATE
                } else if d < 0 - TURN_RATE {
                    0 - TURN_RATE
                } else {
                    d
                }
                s.foes[i].heading = (f.heading + turn + TURN) % TURN
            }
        }
        // Test current phase so the first active tick is not lost.
        if s.foes[i].phase == STRIKE &&
            !s.foes[i].hit &&
            near(f.x, f.y, s.x, s.y, 2 * FP) &&
            in_front(f.x, f.y, f.heading, s.x, s.y) &&
            visible(s, f.x, f.y, s.x, s.y) {
            s.foes[i].hit = true
            if parrying(s) {
                s.foes[i].phase = STAGGER
                s.foes[i].since = s.tick
                s.riposte = s.tick + STAGGER_TICKS
                s.riposte_foe = i
            } else if !invulnerable(s) {
                hurt(mut s, if f.kind == FOX then 16 else 10)
                if f.kind == FOX && s.flasks > 0 { s.flasks -= 1 }
            }
        }
        i += 1
    }
}

fn action_step(mut s: Sim, want: int) {
    let age = s.tick - s.started
    if s.action == DODGE && age < dodge_iframes(s.paw) {
        let h = if want < 0 then s.heading else want
        let frames = dodge_iframes(s.paw)
        let distance = (age + 1) * 3 * FP / frames - age * 3 * FP / frames
        let nx = s.x + distance * sin(h) / FP
        let ny = s.y - distance * cos(h) / FP
        let body = body_at(s, nx, ny)
        if !body && !blocked(s, floor_div(nx, FP), floor_div(ny, FP)) { s.x = nx; s.y = ny }
    }
    if s.action == DRINK && age >= 15 && age < 30 {
        let healed = (age - 14) * FLASK_HEAL / 15 - (age - 15) * FLASK_HEAL / 15
        s.health += healed
        if s.health > health_max(s.heart) { s.health = health_max(s.heart) }
    }
    strike_foes(mut s)
    let duration = if s.action == BITE {
        11
    } else if s.action == LUNGE {
        24
    } else if s.action == HEAVY {
        HEAVY_WINDUP + HEAVY_ACTIVE + HEAVY_RECOVERY
    } else if s.action == PARRY {
        15
    } else if s.action == DODGE {
        dodge_iframes(s.paw) + 4
    } else if s.action == DRINK {
        30
    } else {
        0
    }
    if s.action != IDLE && age >= duration {
        let chain = s.action == BITE && s.chained
        let next_combo = s.combo % 3 + 1
        s.combo = 0
        s.action = IDLE
        if chain {
            let aim = s.chained_heading
            start_action(mut s, BITE, 12)
            if s.action == BITE { s.attack_heading = aim; s.combo = next_combo }
        }
    }
}

fn trail_step(mut s: Sim, ox: int, oy: int) {
    var kept = List[Trail]()
    for tr in s.trail { if tr.until > s.tick { (mut kept).push(tr) } }
    s.trail = kept
    if !s.sneaking && (floor_div(ox, FP) != cell_x(s) || floor_div(oy, FP) != cell_y(s)) {
        (mut s.trail).push(Trail { x: s.x, y: s.y, until: s.tick + TRAIL_TICKS })
    }
}

/// Tick order is part of the replay contract: input, movement, action,
/// foe attack, trail, recovery. Actions use half-open tick intervals.
pub fn step(mut s: Sim, keys: List[int]) {
    s.tick += 1
    s.cue = 0
    if s.scene != 0 {
        if keys.len > 0 || s.tick - s.scene_started >= SCENE_TICKS * 3 {
            s.scene = 0
            s.opening_seen = true
            s.entered = s.tick
        }
        return
    }
    if s.action == FALL {
        if s.tick - s.started >= 30 {
            s.area = forest.den_area(s.last_den)
            s.entered = s.tick
            let (x, y) = forest.den_position(s.seed, s.last_den)
            s.x = x
            s.y = y
            reset_world(mut s)
        }
        return
    }
    action_keys(mut s, keys)
    if s.den { return }
    if s.locked >= 0 {
        let f = copy s.foes[s.locked]
        if f.health <= 0 {
            s.locked = -1
        } else {
            if near(s.x, s.y, f.x, f.y, (SIGHT + s.nose) * FP) && visible(s, s.x, s.y, f.x, f.y) {
                s.unseen = 0
            } else {
                s.unseen += 1
            }
            if s.unseen >= 60 { s.locked = -1 }
        }
    }
    let ox = s.x
    let oy = s.y
    locomotion(mut s)
    let want = heading_of(
        input.held(s.holds[0], s.tick) || input.held(s.holds[4], s.tick),
        input.held(s.holds[1], s.tick) || input.held(s.holds[5], s.tick),
        input.held(s.holds[2], s.tick) || input.held(s.holds[6], s.tick),
        input.held(s.holds[3], s.tick) || input.held(s.holds[7], s.tick),
    )
    action_step(mut s, want)
    foes_step(mut s)
    if s.action == FALL { return }
    if transitions(mut s) { return }
    trail_step(mut s, ox, oy)
    drops_step(mut s)
    if s.mark && s.mark_area == s.area && near(s.x, s.y, s.mark_x, s.mark_y, FP) {
        s.scent += s.mark_scent
        s.mark = false
        s.mark_scent = 0
    }
    if s.action == IDLE {
        s.stamina += if s.moving then REGEN / 2 else REGEN
        if s.stamina > stamina_max(s.wind) { s.stamina = stamina_max(s.wind) }
        if s.stamina >= EXHAUST_RECOVER { s.exhausted = false }
    }
}

fn body_at(s: Sim, x: int, y: int) -> bool {
    for f in s.foes {
        if f.health > 0 && f.kind != HAWK && near(x, y, f.x, f.y, FP) { return true }
    }
    false
}

/// Foe pursuit and retreat speeds, unchanged by the cub speed increase.
pub const FOE_STALK_V: int = 44

/// Retreat remains faster than a fresh cub walk.
pub const FOE_RETREAT_V: int = 48

/// Arrow aim memory shared in name and duration with pack pk06b (500 ms).
pub const AIM_WINDOW_TICKS: int = 15

fn aim_axis_order(s: Sim, axis: int) -> int {
    var order = 0
    var i = axis
    while i < 8 {
        if (input.held(s.holds[i], s.tick) || s.tick - s.holds[i].last <= AIM_WINDOW_TICKS) &&
            s.aim_order[i] > order {
            order = s.aim_order[i]
        }
        i += 4
    }
    order
}

/// Lock wins; otherwise latest opposing arrow wins per axis, then facing.
pub fn attack_aim(s: Sim) -> int {
    if s.locked >= 0 && s.locked < s.foes.len && s.foes[s.locked].health > 0 {
        let h = heading_to(s.x, s.y, s.foes[s.locked].x, s.foes[s.locked].y)
        if h >= 0 { return h }
    }
    let up = aim_axis_order(s, 0)
    let down = aim_axis_order(s, 1)
    let left = aim_axis_order(s, 2)
    let right = aim_axis_order(s, 3)
    let h = heading_of(up > down, down > up, left > right, right > left)
    if h >= 0 then h else s.heading
}

/// The bite and lunge's presentation distances; hit reaches remain 2 and 4.
pub const BITE_ARC: int = FP

/// Long leap distance in fixed point, before collision clipping.
pub const LUNGE_ARC: int = 3 * FP

/// Integer out-and-back triangle, like pack's arc, with a fixed apex.
pub fn leap_arc(heading: int, age: int, ticks: int, distance: int) -> (int, int) {
    if age <= 0 || age >= ticks { return (0, 0) }
    let n = if age <= ticks / 2 then age else ticks - age
    let travel = distance * n / (ticks / 2)
    (sin(heading) * travel / FP, 0 - cos(heading) * travel / FP)
}

/// Clip the full path in eighth-cell steps, not just the endpoint.
/// Ground physics and the camera never use these presentation coordinates.
pub fn clip_arc(s: Sim, ox: int, oy: int) -> (int, int) {
    let span = if abs(ox) > abs(oy) then abs(ox) else abs(oy)
    let steps = span / (FP / 8) + 1
    var x = 0
    var y = 0
    var n = 1
    while n <= steps {
        let dx = ox * n / steps
        let dy = oy * n / steps
        let nx = s.x + dx
        let ny = s.y + dy
        var stops = blocked(s, floor_div(nx, FP), floor_div(ny, FP))
        for f in s.foes {
            if (
                f.health > 0 && f.kind != HAWK || f.died >= 0 && s.tick - f.died < FOE_FADE_TICKS
            ) &&
                abs(nx - f.x) < 2 * FP &&
                abs(ny - f.y) < 2 * FP {
                stops = true
            }
        }
        if stops { break }
        x = dx
        y = dy
        n += 1
    }
    (x, y)
}

/// The cub's bounded presentation offset, pure and independent of tier.
pub fn attack_offset(s: Sim) -> (int, int) {
    let age = s.tick - s.started
    if s.action == BITE {
        let distance = if s.combo == 3 then COMBO_FINISH_ARC else BITE_ARC
        let (x, y) = leap_arc(s.attack_heading, age - 2, 3, distance)
        let lean = if age >= 3 && age < 5 {
            if s.combo == 1 then 0 - COMBO_LEAN else if s.combo == 2 then COMBO_LEAN else 0
        } else {
            0
        }
        return clip_arc(
            s,
            x + cos(s.attack_heading) * lean / FP,
            y + sin(s.attack_heading) * lean / FP,
        )
    }
    if s.action == LUNGE {
        let (x, y) = leap_arc(s.attack_heading, age - 8, 4, LUNGE_ARC)
        return clip_arc(s, x, y)
    }
    if s.action == HEAVY {
        if age < HEAVY_WINDUP {
            let steps = if age < 5 then 0 else if age < 10 then 1 else 2
            let back = steps * FP
            return clip_arc(
                s,
                0 - sin(s.attack_heading) * back / FP,
                cos(s.attack_heading) * back / FP,
            )
        }
        let (x, y) = leap_arc(s.attack_heading, age - HEAVY_WINDUP + 1, HEAVY_ACTIVE + 1, HEAVY_ARC)
        return clip_arc(s, x, y)
    }
    (0, 0)
}

/// One contact flash on the arc's apex, at the hit foe (or the empty apex).
pub fn landing(s: Sim) -> bool {
    s.action == BITE && s.tick - s.started == 3 || s.action == LUNGE && s.tick - s.started == 10
}

/// Landing mark destination; the actual hit envelope, never a new collider.
pub fn landing_point(s: Sim) -> (int, int) {
    for f in s.foes {
        if f.last_hit == s.started { return (f.x, f.y) }
    }
    let (dx, dy) = attack_offset(s)
    (s.x + dx, s.y + dy)
}

/// First/second bite lean, in fixed point perpendicular to the aim.
pub const COMBO_LEAN: int = FP / 2

/// Third bite's longer presentation arc; its reach and damage stay unchanged.
pub const COMBO_FINISH_ARC: int = 2 * FP

/// Two recovery ticks shaking the third bite's head left and right.
pub fn head_shake(s: Sim) -> int {
    if s.action != BITE || s.combo != 3 { return 0 }
    let age = s.tick - s.started
    if age == 5 then -1 else if age == 6 then 1 else 0
}

/// Heavy attack fallback action (the terminal cannot distinguish Shift+Space).
pub const HEAVY: int = 7

/// Proposed stamina cost, above the lunge's 30.
pub const HEAVY_COST: int = 42

/// Two visible back-steps precede the heavier leap.
pub const HEAVY_WINDUP: int = 15

/// Heavy active ticks, with the ordinary four-cell hit envelope.
pub const HEAVY_ACTIVE: int = 6

/// Heavy recovery is slower than the lunge's twelve ticks.
pub const HEAVY_RECOVERY: int = 18

/// Heavy damage in multiples of a bite; surviving ordinary foes stagger.
pub const HEAVY_DAMAGE: int = 4

/// Heavy presentation arc, longer than the lunge's three cells.
pub const HEAVY_ARC: int = 4 * FP

/// Burst age, -1 outside the four-tick fading landing burst.
pub fn burst_age(s: Sim) -> int {
    let age = s.tick - s.started - HEAVY_WINDUP - 2
    if s.action == HEAVY && age >= 0 && age < 4 then age else -1
}

/// The burst stays at the apex while the cub returns; no moving emitter.
pub fn burst_point(s: Sim) -> (int, int) {
    for f in s.foes { if f.last_hit == s.started { return (f.x, f.y) } }
    let (x, y) = clip_arc(
        s,
        sin(s.attack_heading) * HEAVY_ARC / FP,
        0 - cos(s.attack_heading) * HEAVY_ARC / FP,
    )
    (s.x + x, s.y + y)
}

/// A defeated foe dissolves over fifteen ticks, retaining its sprite briefly.
pub const FOE_FADE_TICKS: int = 15

/// The meadow's aerial foe. Values are proposed in DESIGN.md.
pub const HAWK: int = 2

/// Ticks for which the shadow stops before striking.
pub const HAWK_TELL: int = 18

/// Ticks before the hawk circles again.
pub const HAWK_RECOVERY: int = 36

/// Damage of an unanswered stoop.
pub const HAWK_DAMAGE: int = 14

/// Ticks for the unobtrusive area entry line.
pub const ENTRY_TICKS: int = 90

/// Set the selected den bit, leaving other lit dens unchanged.
pub fn light_den(bits: int, den: int) -> int {
    let mask = if den == 0 then 1 else if den == 1 then 2 else if den == 2 then 4 else 8
    if bits / mask % 2 == 0 then bits + mask else bits
}

/// The den in resting reach, or -1.
pub fn den_here(s: Sim) -> int {
    var den = 0
    while den < 4 {
        let (x, y) = forest.den_position(s.seed, den)
        if s.area == forest.den_area(den) && near(s.x, s.y, x, y, FP) { return den }
        den += 1
    }
    -1
}

/// Initial encounters for one seeded area.
pub fn area_foes(seed: int, area: int) -> List[Foe] {
    var foes = List[Foe]()
    var group = 0
    while group < 3 {
        let at = (if group == 0 then 52 else if group == 1 then 76 else 134) +
            world.hash(seed, area, group + 131, 5)
        // The second thicket den sits at 90..93: do not spawn near it.
        if area != forest.BRAMBLEHOLD || group != 1 {
            let count = if area == forest.LARKMEADOW then 2 else if group == 1 then 1 else 2
            var member = 0
            while member < count {
                let kind = if area == forest.LARKMEADOW {
                    (if member == 0 then HAWK else DEER)
                } else if group == 1 {
                    FOX
                } else {
                    WEASEL
                }
                let x = (forest.spine(seed, area, at) + member * 2 - 1) * FP
                let y = (forest.origin(seed, area) + at) * FP
                (mut foes).push(make_foe(kind, x, y))
                member += 1
            }
        }
        group += 1
    }
    // The two side branches end in harder, finite cache guards.
    var cache = 0
    while cache < 2 {
        let (x, cy) = forest.cache_position(seed, area, cache)
        if area == forest.SHINGLE {
            var foe = make_foe(FOX, x, cy + FP)
            foe.health = 40
            (mut foes).push(foe)
            cache += 1
            continue
        }
        var guard = 0
        while guard < (if cache == 0 then 3 else 2) {
            let gx = x + (guard - 1) * FP
            let gy = (
                forest.origin(seed, area) + forest.branch(seed, area, cache, floor_div(gx, FP)) + 1
            ) *
                FP +
                FP / 2
            (mut foes).push(make_foe(if cache == 0 then WEASEL else FOX, gx, gy))
            guard += 1
        }
        cache += 1
    }
    foes
}

fn make_foe(kind: int, x: int, y: int) -> Foe {
    Foe {
        kind: kind,
        x: x,
        y: y,
        heading: 0,
        speed: 0,
        stamina: 60,
        health: if kind == FOX then 24 else 8,
        phase: HUNT,
        since: 0,
        target_x: x,
        target_y: y,
        home_x: x,
        home_y: y,
        hit: false,
        last_hit: -1,
        died: -1,
    }
}

/// Travel resets only local encounter state, never health, water or currency.
pub fn enter_area(mut s: Sim, area: int, x: int, y: int) {
    s.area = area
    s.x = x
    s.y = y
    s.entered = s.tick
    s.edge_ready = false
    s.foes = area_foes(s.seed, area)
    (mut s.drops).reset()
    (mut s.trail).reset()
    s.locked = -1
    s.riposte = 0
    s.riposte_foe = -1
    s.action = IDLE
    s.speed = 0
    s.chained = false
    s.combo = 0
    s.den = false
    var i = 0
    while i < s.holds.len {
        s.holds[i] = input.hold_new()
        s.aim_order[i] = 0
        i += 1
    }
}

/// Traverse an unlocked incident edge; false for unavailable edges.
pub fn cross_edge(mut s: Sim, edge: int) -> bool {
    let to = forest.other(s.area, edge)
    if to < 0 || edge == 0 && !s.gate_open { return false }
    if edge == 2 && s.shortcuts % 2 == 0 || edge == 3 && s.shortcuts / 2 % 2 == 0 { return false }
    let (x, y) = forest.portal(s.seed, to, edge)
    // Arrival is off the trigger; a return requires walking back to it.
    enter_area(
        mut s,
        to,
        x,
        y +
            (
                if edge == 0 && to == forest.SHINGLE || edge == 1 && to == forest.BRAMBLEHOLD {
                    -2 * FP
                } else {
                    2 * FP
                }
            ),
    )
    true
}

fn shortcut_key(mut s: Sim) {
    var edge = 2
    while edge < 4 {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if near(s.x, s.y, x, y, 2 * FP) {
                // Open only from the far side, then either side can traverse it.
                if edge == 2 && s.area == forest.BRAMBLEHOLD && s.shortcuts % 2 == 0 {
                    s.cue = 1
                    s.shortcuts += 1
                }
                if edge == 3 && s.area == forest.LARKMEADOW && s.shortcuts / 2 % 2 == 0 {
                    s.cue = 2
                    s.shortcuts += 2
                }
                let _ = cross_edge(mut s, edge)
                return
            }
        }
        edge += 1
    }
}

fn transitions(mut s: Sim) -> bool {
    var close = false
    var edge = 0
    while edge < 2 {
        if forest.other(s.area, edge) >= 0 {
            let (x, y) = forest.portal(s.seed, s.area, edge)
            if near(s.x, s.y, x, y, FP) {
                close = true
                if s.edge_ready && cross_edge(mut s, edge) { return true }
            }
        }
        edge += 1
    }
    if !close { s.edge_ready = true }
    if s.area == forest.BRAMBLEHOLD && near(s.x, s.y, -10 * FP, 24 * FP, 3 * FP) { s.story = 1 }
    false
}

/// Airborne until the stoop: the stopping shadow fixes the target for the
/// whole tell. A straight-line dive hits only that committed target.
fn hawk_step(mut s: Sim, i: int) {
    let f = copy s.foes[i]
    let age = s.tick - f.since
    if f.phase == HUNT {
        if near(f.x, f.y, s.x, s.y, 10 * FP) {
            s.foes[i].phase = CROUCH
            s.foes[i].since = s.tick
            s.foes[i].target_x = s.x
            s.foes[i].target_y = s.y
            s.foes[i].x = s.x
            s.foes[i].y = s.y
        } else {
            // A bounded diamond shadow orbit, fixed around the meadow clearing.
            let phase = s.tick % 120
            s.foes[i].x = f.home_x + sin(phase * TURN / 120) * 2
            s.foes[i].y = f.home_y + cos(phase * TURN / 120) * 2
        }
    } else if f.phase == CROUCH && age >= HAWK_TELL {
        s.foes[i].phase = STRIKE
        s.foes[i].since = s.tick
        if near(s.x, s.y, f.target_x, f.target_y, FP) {
            if parrying(s) {
                s.foes[i].health = 0
                s.foes[i].died = s.tick
                leave_drop(mut s, f.target_x, f.target_y, 12)
            } else {
                hurt(mut s, HAWK_DAMAGE)
            }
        }
    } else if f.phase == STRIKE && age >= 3 {
        s.foes[i].phase = RETREAT
        s.foes[i].since = s.tick
    } else if f.phase == RETREAT && age >= HAWK_RECOVERY {
        s.foes[i].phase = HUNT
        s.foes[i].since = s.tick
    }
}

/// Resume and death share the same den and reset rules.
pub fn wake(mut s: Sim) {
    s.area = forest.den_area(s.last_den)
    let (x, y) = forest.den_position(s.seed, s.last_den)
    s.x = x
    s.y = y
    reset_world(mut s)
    s.den = false
    s.edge_ready = true
}

/// Nearest point of the complete five-cell collision rectangle, including
/// the fractional span of its last cell. Never aim at a cell origin instead.
pub fn gate_target(s: Sim) -> (int, int) {
    let left = -2 * FP
    let right = 3 * FP - 1
    let top = gate_y(s) * FP
    let bottom = top + FP - 1
    (
        if s.x < left then left else if s.x > right then right else s.x,
        if s.y < top then top else if s.y > bottom then bottom else s.y,
    )
}

/// Prey leaves five scent, and eating it heals first (bible §6).
pub const DEER: int = 3

/// A visible pickup remains for this many simulation ticks.
pub const DROP_TICKS: int = 300

/// Each opening frame lasts this many ticks unless any key skips it.
pub const SCENE_TICKS: int = 90

/// A local, transient scent pickup, distinct from the persistent death mark.
pub struct Drop { x: int, y: int, value: int, until: int }

fn leave_drop(mut s: Sim, x: int, y: int, value: int) {
    (mut s.drops).push(Drop { x: x, y: y, value: value, until: s.tick + DROP_TICKS })
}

fn drops_step(mut s: Sim) {
    var keep = List[Drop]()
    for drop in s.drops {
        if drop.until > s.tick {
            if near(s.x, s.y, drop.x, drop.y, FP) {
                s.scent += drop.value
                if drop.value == 5 {
                    s.health += 10
                    if s.health > health_max(s.heart) { s.health = health_max(s.heart) }
                }
            } else {
                (mut keep).push(copy drop)
            }
        }
    }
    s.drops = keep
}

/// Start the opening only for a new journey. Keys/skips live in the normal
/// simulation event stream, so the scene needs no wall-clock or second loop.
pub fn opening(mut s: Sim) {
    if !s.opening_seen { s.scene = 1; s.scene_started = s.tick }
}

/// Names reserved for the score and later story scenes, not played audio.
pub fn scene_hook(scene: int) -> str {
    match scene {
        1 => "scene.opening",
        2 => "scene.den.first",
        3 => "scene.elk.choice",
        4 => "scene.alpha.offer",
        5 => "scene.ending.home",
        6 => "scene.ending.alone",
        7 => "scene.ending.shadow",
        _ => "",
    }
}

/// Whether a seeded cache has already been opened during this journey.
pub fn cache_open(s: Sim, cache: int) -> bool {
    var mask = 1
    var i = 0
    while i < s.area * 2 + cache { mask *= 2; i += 1 }
    s.caches / mask % 2 == 1
}

fn cache_key(mut s: Sim) {
    var cache = 0
    while cache < 2 {
        let (x, y) = forest.cache_position(s.seed, s.area, cache)
        if near(s.x, s.y, x, y, 2 * FP) && !cache_open(s, cache) {
            for foe in s.foes {
                if foe.health > 0 && near(foe.x, foe.y, x, y, 6 * FP) { return }
            }
            var mask = 1
            var i = 0
            while i < s.area * 2 + cache { mask *= 2; i += 1 }
            s.caches += mask
            if cache == 1 {
                if s.area == forest.LARKMEADOW { s.yarrow += 1 } else { s.marrow += 1 }
            }
            s.cue = 3
        }
        cache += 1
    }
}

/// Reserved score hooks emitted once on the corresponding interaction.
pub fn cue_hook(cue: int) -> str {
    if cue == 1 {
        "shortcut.log.push"
    } else if cue == 2 {
        "shortcut.hedge.dig"
    } else if cue == 3 {
        "cache.open"
    } else {
        ""
    }
}
