//! sim — the cub on the Shingle: a position, a heading, a speed and the
//! held keys that steer them, over `terrain`'s ground, with the camera on
//! the cub (ruling #130, R-CB-3: a scrolling world, not screens). Pure and
//! deterministic: a run is a function of the seed and the keys by tick
//! (the track's rule 3), which is what the goldens pin.
//!
//! The realism bars (the campaign's): the cub has a position in fixed
//! point, a heading that turns at `TURN_RATE` toward the held direction
//! (it never pivots), a speed that rises at `ACCEL` and falls at `BRAKE`;
//! a key is held by the engine's model from its autorepeat ticks alone.
//! Trunks, deep forest and the Ashwater stop it. The stats of section 3 are
//! here as the first constants (every number `docs/DESIGN.md`'s, proposed;
//! R-CB-7: the maintainer's by play): the scaffold moves a fresh cub with
//! heart, wind, fang, paw and nose at 1 and drains nothing yet.

use controls
use input
use terrain
use world

/// Fixed-point units a cell (the engine's).
pub const FP: int = 256

/// Heading units a full turn: 0 north, 64 east, 128 south, 192 west.
pub const TURN: int = 256

/// The trot, fixed-point units a tick at paw 1 (`TROT_V + 2 × paw`, the
/// bible's section 3): 0.15 cells a tick, 4.4 a second, a cub's pace
/// under pack's migrating trot of 40.
pub const TROT_V: int = 36

/// A sneak's speed: half the trot (section 4).
pub const SNEAK_V: int = 18

/// Acceleration, FP units a tick each tick: the trot from a stop in 9 ticks.
pub const ACCEL: int = 4

/// Braking: a stop from the trot in 5 ticks; a cub stops faster than it starts.
pub const BRAKE: int = 8

/// The turn rate, heading units a tick: a quarter turn in 4 ticks, about
/// turned in 8 (267 ms). The cub turns, never pivots.
pub const TURN_RATE: int = 16

/// Heart, wind, fang, paw and nose at the start (section 3): 1 each.
pub const STAT_START: int = 1

/// Health at heart `h`: `40 + 12 × h`.
pub fn health_max(heart: int) -> int {
    40 + 12 * heart
}

/// Stamina at wind `w`: `60 + 10 × w`.
pub fn stamina_max(wind: int) -> int {
    60 + 10 * wind
}

/// The trot at paw `p`.
pub fn trot_at(paw: int) -> int {
    TROT_V + 2 * paw
}

/// The quarter sine, 65 entries of `[0, 256]` over `[0, 64]` heading units.
fn quarter_sin(i: int) -> int {
    match i {
        0 => 0,
        1 => 6,
        2 => 13,
        3 => 19,
        4 => 25,
        5 => 31,
        6 => 38,
        7 => 44,
        8 => 50,
        9 => 56,
        10 => 62,
        11 => 68,
        12 => 74,
        13 => 80,
        14 => 86,
        15 => 92,
        16 => 98,
        17 => 104,
        18 => 109,
        19 => 115,
        20 => 121,
        21 => 126,
        22 => 132,
        23 => 137,
        24 => 142,
        25 => 147,
        26 => 152,
        27 => 157,
        28 => 162,
        29 => 167,
        30 => 172,
        31 => 177,
        32 => 181,
        33 => 185,
        34 => 190,
        35 => 194,
        36 => 198,
        37 => 202,
        38 => 206,
        39 => 209,
        40 => 213,
        41 => 216,
        42 => 220,
        43 => 223,
        44 => 226,
        45 => 229,
        46 => 231,
        47 => 234,
        48 => 237,
        49 => 239,
        50 => 241,
        51 => 243,
        52 => 245,
        53 => 247,
        54 => 248,
        55 => 250,
        56 => 251,
        57 => 252,
        58 => 253,
        59 => 254,
        60 => 255,
        61 => 255,
        62 => 256,
        63 => 256,
        _ => 256,
    }
}

/// Sine of a heading, in `[-256, 256]`: east is 256 at heading 64.
pub fn sin(h: int) -> int {
    let a = (h % TURN + TURN) % TURN
    if a <= 64 {
        return quarter_sin(a)
    }
    if a <= 128 {
        return quarter_sin(128 - a)
    }
    if a <= 192 {
        return 0 - quarter_sin(a - 128)
    }
    0 - quarter_sin(256 - a)
}

/// Cosine of a heading: north is 256 at heading 0.
pub fn cos(h: int) -> int {
    sin(h + 64)
}

/// The heading units from `from` to `to` by the shortest way, in
/// `(-128, 128]`.
pub fn turn_toward(from: int, to: int) -> int {
    var d = (to - from) % TURN
    if d > 128 {
        d -= TURN
    }
    if d <= -128 {
        d += TURN
    }
    d
}

/// The cub: where it is (fixed-point world cells, x east, y south), the
/// heading it faces and the one it wants, its speed, its stats and what
/// they give, and the eight held movement keys.
pub struct Sim {
    seed: int,
    cols: int,
    rows: int,
    tick: int,
    x: int,
    y: int,
    heading: int,
    heading_target: int,
    speed: int,
    sneaking: bool,
    moving: bool,
    blocked: int,
    heart: int,
    wind: int,
    fang: int,
    paw: int,
    nose: int,
    health: int,
    stamina: int,
    holds: List[input.Hold],
}

/// A new cub at the Shingle's start, facing north toward the water, still.
pub fn new(seed: int, cols: int, rows: int) -> Sim {
    let (x, y) = terrain.start(seed)
    var holds = List[input.Hold]()
    var i = 0
    while i < 8 {
        (mut holds).push(input.hold_new())
        i += 1
    }
    Sim {
        seed: seed,
        cols: cols,
        rows: rows,
        tick: 0,
        x: x,
        y: y,
        heading: 0,
        heading_target: 0,
        speed: 0,
        sneaking: false,
        moving: false,
        blocked: 0,
        heart: STAT_START,
        wind: STAT_START,
        fang: STAT_START,
        paw: STAT_START,
        nose: STAT_START,
        health: health_max(STAT_START),
        stamina: stamina_max(STAT_START),
        holds: holds,
    }
}

/// The screen's size changed: the camera keeps the cub at the centre.
pub fn resize(mut s: Sim, cols: int, rows: int) {
    s.cols = cols
    s.rows = rows
}

/// The cub's screen row: the centre (R-CB-3, the camera on the cub).
pub fn screen_row(s: Sim) -> int {
    s.rows / 2
}

/// The cub's screen column: the centre.
pub fn screen_col(s: Sim) -> int {
    s.cols / 2
}

/// The world cell under screen `(row, col)`: the camera's corner plus the
/// offset, the cub's own cell at the centre.
pub fn world_cell(s: Sim, row: int, col: int) -> (int, int) {
    // PLANT (cb00-plant-camera): the camera stops following the cub twenty
    // columns from the start (a camera fixed once the cub walks off its
    // first screen: the scroll golden is the gate that must see it).
    let (x0, _) = terrain.start(s.seed)
    var cx = cell_x(s)
    if cx < x0 / FP - 20 {
        cx = x0 / FP - 20
    }
    if cx > x0 / FP + 20 {
        cx = x0 / FP + 20
    }
    (cx - screen_col(s) + col, cell_y(s) - screen_row(s) + row)
}

/// The cub's world column.
pub fn cell_x(s: Sim) -> int {
    floor_div(s.x, FP)
}

/// The cub's world row.
pub fn cell_y(s: Sim) -> int {
    floor_div(s.y, FP)
}

fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b < 0 then q - 1 else q
}

/// The direction the cub faces, 0 north, 1 east, 2 south, 3 west (the
/// nearest quarter).
pub fn facing(s: Sim) -> int {
    ((s.heading + 32) % TURN + TURN) % TURN / 64
}

fn toward(v: int, target: int, step: int) -> int {
    if v < target {
        return if v + step > target then target else v + step
    }
    if v > target {
        return if v - step < target then target else v - step
    }
    v
}

/// The heading a set of held directions means: north 0, east 64, south
/// 128, west 192, the diagonals between; or -1 when none or when opposites
/// cancel.
pub fn heading_of(up: bool, down: bool, left: bool, right: bool) -> int {
    let dy = (if down then 1 else 0) - (if up then 1 else 0)
    let dx = (if right then 1 else 0) - (if left then 1 else 0)
    if dx == 0 && dy == 0 {
        return -1
    }
    if dx == 0 {
        return if dy < 0 then 0 else 128
    }
    if dy == 0 {
        return if dx > 0 then 64 else 192
    }
    if dy < 0 {
        return if dx > 0 then 32 else 224
    }
    if dx > 0 then 96 else 160
}

/// One tick: the keys pressed this tick (cub's numbers), the holds read,
/// the heading turned, the speed changed, the cub moved where the ground
/// lets it.
pub fn step(mut s: Sim, keys: List[int]) {
    s.tick += 1
    for k in keys {
        if controls.is_move(k) {
            input.hold_press(mut s.holds[k - controls.KEY_UP], s.tick)
        }
    }
    var held = List[bool]()
    var i = 0
    while i < 8 {
        (mut held).push(input.held(s.holds[i], s.tick))
        i += 1
    }
    let sneak_held = held[4] || held[5] || held[6] || held[7]
    let want = heading_of(
        held[0] || held[4],
        held[1] || held[5],
        held[2] || held[6],
        held[3] || held[7],
    )
    s.moving = want >= 0
    s.sneaking = s.moving && sneak_held
    if s.moving {
        s.heading_target = want
    }
    // The turn, at the turn rate, by the shortest way.
    let d = turn_toward(s.heading, s.heading_target)
    let step_h = if d > TURN_RATE then TURN_RATE else if d < 0 - TURN_RATE then 0 - TURN_RATE else d
    s.heading = ((s.heading + step_h) % TURN + TURN) % TURN
    // The speed: toward the trot (or the sneak) while a key is held, to a
    // stop when none is.
    let want_v = if !s.moving then 0 else if s.sneaking then SNEAK_V else trot_at(s.paw)
    s.speed = toward(s.speed, want_v, if want_v > s.speed then ACCEL else BRAKE)
    // The move, each axis on its own, so a wall along one lets the other
    // slide; a blocked axis stops the cub.
    let dx = s.speed * sin(s.heading) / 256
    let dy = 0 - s.speed * cos(s.heading) / 256
    let nx = s.x + dx
    if !terrain.blocked(s.seed, floor_div(nx, FP), cell_y(s)) {
        s.x = nx
    } else {
        s.speed = 0
        s.blocked += 1
    }
    let ny = s.y + dy
    if !terrain.blocked(s.seed, cell_x(s), floor_div(ny, FP)) {
        s.y = ny
    } else {
        s.speed = 0
        s.blocked += 1
    }
}

/// The distance walked, cells, for the closing line.
pub fn distance_cells(s: Sim) -> int {
    let (x0, y0) = terrain.start(s.seed)
    let dx = (s.x - x0) / FP
    let dy = (s.y - y0) / FP
    (if dx < 0 then 0 - dx else dx) + (if dy < 0 then 0 - dy else dy)
}

/// A world cell's variant, for the frame (the engine's hash).
pub fn variant(s: Sim, x: int, y: int, n: int) -> int {
    world.hash(s.seed + 31, x, y, n)
}
