//! member: false

use controls
use forest
use journey
use pouch
use sim
use inventory
use lore
use grid
use tier

fn press(mut s: sim.Sim, key: int) {
    var keys = List[int]()
    (mut keys).push(key)
    sim.step(mut s, keys)
}

fn wait(mut s: sim.Sim, ticks: int) {
    var keys = List[int]()
    var n = 0
    while n < ticks { sim.step(mut s, keys); n += 1 }
}

fn quiet() -> sim.Sim {
    var s = sim.new(7, 80, 24)
    (mut s.foes).reset()
    s.pouch.seeded = pouch.bit(forest.AREAS) - 1
    s
}

fn test_cb15_yarrow_stops_bleeding_and_heals_ten_clamped() {
    var s = quiet()
    s.health = 20
    sim.bleed(mut s)
    assert(sim.give_item(mut s, pouch.YARROW), "give yarrow")
    assert(sim.consume_item(mut s, pouch.YARROW), "consume")
    assert(s.health == 30 && s.pouch.bleeding == 0 && s.yarrow == 0, "ten and no bleed")
    s.health = 50
    let _ = sim.give_item(mut s, pouch.YARROW)
    let _ = sim.consume_item(mut s, pouch.YARROW)
    assert(s.health == 52, "clamp")
}

fn test_cb15_marrow_heals_thirty_over_sixty_and_damage_interrupts() {
    var s = quiet()
    s.health = 10
    let _ = sim.give_item(mut s, pouch.MARROW)
    let _ = sim.consume_item(mut s, pouch.MARROW)
    wait(mut s, 59)
    assert(s.health == 39 && s.pouch.marrow_ticks == 1, "29 instalments")
    wait(mut s, 1)
    assert(s.health == 40 && s.pouch.marrow_ticks == 0, "thirtieth at tick60")
    s.health = 10
    let _ = sim.give_item(mut s, pouch.MARROW)
    let _ = sim.consume_item(mut s, pouch.MARROW)
    wait(mut s, 20)
    sim.hurt(mut s, 3)
    wait(mut s, 60)
    assert(s.health == 17 && s.marrow == 0, "cancel without refund")
}

fn test_cb15_bleeding_licks_after_twenty_still_ticks() {
    var s = quiet()
    sim.bleed(mut s)
    wait(mut s, 19)
    assert(s.health == 33 && s.pouch.bleeding > 0, "nineteen health ticks")
    wait(mut s, 1)
    assert(s.health == 33 && s.pouch.bleeding == 0, "lick cures before twentieth damage")
}

fn test_cb15_pine_clears_trail_and_hides_exactly_six_hundred_ticks() {
    var s = quiet()
    (mut s.trail).push(sim.Trail { x: s.x, y: s.y, until: 100 })
    let _ = sim.give_item(mut s, pouch.PINE)
    assert(sim.consume_item(mut s, pouch.PINE), "pine")
    assert(s.trail.len == 0 && sim.trail_hidden(s), "old trail gone")
    s.tick = 599
    assert(sim.trail_hidden(s), "last hidden tick")
    s.tick = 600
    assert(!sim.trail_hidden(s), "exclusive expiry")
}

fn test_cb15_ice_prefers_lock_then_nearest_in_front_and_lasts_ninety() {
    var s = quiet()
    (mut s.foes).push(sim.make_ashen(s.x, s.y - 3 * sim.FP))
    (mut s.foes).push(sim.make_ashen(s.x, s.y - 5 * sim.FP))
    let _ = sim.give_item(mut s, pouch.ICE)
    s.locked = 1
    assert(sim.ice_target(s) == 1, "lock wins")
    assert(sim.consume_item(mut s, pouch.ICE), "throw")
    assert(sim.foe_speed(s, 1, 40) == 20 && s.foes[1].slow_until == 90, "half speed")
    s.tick = 90
    assert(sim.foe_speed(s, 1, 40) == 40, "expiry")
    s.locked = -1
    assert(sim.ice_target(s) == 0, "nearest front")
    s.heading = 128
    let _ = sim.give_item(mut s, pouch.ICE)
    assert(!sim.consume_item(mut s, pouch.ICE) && s.pouch.ice == 1, "no target no spend")
}

fn test_cb15_tuft_on_death_keeps_scent_without_a_mark_once() {
    var s = quiet()
    s.scent = 77
    let _ = sim.give_item(mut s, pouch.TUFT)
    sim.hurt(mut s, 100)
    assert(s.scent == 77 && !s.mark && s.mark_scent == 0, "tuft retains scent with no mark")
    assert(s.pouch.tuft == 0 && s.pouch.uses == 1 && s.deaths == 1, "one passive use")
    sim.wake(mut s)
    sim.hurt(mut s, 100)
    assert(
        s.scent == 0 && s.mark && s.mark_scent == 77 && s.pouch.uses == 1,
        "second death ordinary",
    )
}

fn test_cb15_caps_and_full_pickup_refusal() {
    var s = quiet()
    var k = 0
    while k < pouch.KINDS {
        var n = 0
        while n < pouch.cap(k) { assert(sim.give_item(mut s, k), "below cap"); n += 1 }
        assert(!sim.give_item(mut s, k) && sim.item_count(s, k) == pouch.cap(k), "cap")
        k += 1
    }
    let _ = pouch.leave(mut s.pouch, s.area, sim.cell_x(s), sim.cell_y(s), pouch.YARROW)
    assert(sim.pickup_item(mut s) && s.pouch.pickups.len == 1, "full stack leaves ground item")
}

// cb15's provisional tuft (four cells east of Bramblehold's first den) is
// Ember's since cb16 (R-cb16-3 A): her den holds the first tuft and her
// third line gives it (`npc_test`); Bramblehold seeds its six marrow alone.
fn test_cb16_bramblehold_seeds_six_marrow_and_the_first_tuft_is_embers() {
    var s = quiet()
    s.area = forest.BRAMBLEHOLD
    s.pouch.seeded = 0
    wait(mut s, 1)
    var tufts = 0
    for p in s.pouch.pickups {
        if p.kind == pouch.TUFT { tufts += 1 }
        assert(!forest.blocked(s.seed, s.field, s.area, p.x, p.y), "reachable ground")
    }
    assert(tufts == 0 && s.pouch.pickups.len == 6, "six marrow, no tuft")
    wait(mut s, 1)
    assert(s.pouch.pickups.len == 6, "seed only once")
}

fn test_cb15_r_at_a_den_recovers_a_dropped_item_and_still_rests() {
    var s = quiet()
    let _ = sim.give_item(mut s, pouch.TUFT)
    assert(sim.drop_item(mut s, pouch.TUFT) && s.pouch.tuft == 0, "drop on den cell")
    press(mut s, controls.KEY_REST)
    assert(s.den && s.pouch.tuft == 1 && s.pouch.pickups.len == 0, "take then unchanged rest")
}

fn test_cb15_drop_repickup_and_discard_menu_paths_pause_the_forest() {
    var s = quiet()
    let _ = sim.give_item(mut s, pouch.YARROW)
    let x = s.x
    let health = s.health
    press(mut s, controls.KEY_INVENTORY)
    press(mut s, controls.KEY_BITE)
    press(mut s, controls.KEY_DOWN)
    press(mut s, controls.KEY_BITE)
    assert(s.yarrow == 0 && s.pouch.pickups.len == 1, "menu drop")
    wait(mut s, 10)
    assert(s.x == x && s.health == health, "paused")
    press(mut s, controls.KEY_INVENTORY)
    assert(!s.pouch.open, "i closes")
    assert(sim.pickup_item(mut s) && s.yarrow == 1 && s.pouch.pickups.len == 0, "repickup")
    press(mut s, controls.KEY_INVENTORY)
    press(mut s, controls.KEY_BITE)
    press(mut s, controls.KEY_DOWN)
    press(mut s, controls.KEY_DOWN)
    press(mut s, controls.KEY_BITE)
    assert(s.yarrow == 0 && s.pouch.pickups.len == 0, "discard destroys")
    press(mut s, controls.KEY_RELEASE)
    assert(!s.pouch.open && sim.held_direction(s) < 0, "Esc closes and clears holds")
}

fn test_cb15_menu_consume_and_aim_paths() {
    var s = quiet()
    s.health = 20
    let _ = sim.give_item(mut s, pouch.YARROW)
    press(mut s, controls.KEY_INVENTORY)
    press(mut s, controls.KEY_BITE)
    press(mut s, controls.KEY_BITE)
    assert(s.health == 30 && s.yarrow == 0, "consume path")
    press(mut s, controls.KEY_RELEASE)
    let _ = sim.give_item(mut s, pouch.ICE)
    (mut s.foes).push(sim.make_ashen(s.x, s.y - 4 * sim.FP))
    press(mut s, controls.KEY_INVENTORY)
    press(mut s, controls.KEY_BITE)
    press(mut s, controls.KEY_BITE)
    assert(s.pouch.aiming && s.pouch.ice == 1, "ask for aim")
    press(mut s, controls.KEY_BITE)
    assert(!s.pouch.aiming && s.pouch.ice == 0, "throw path")
    press(mut s, controls.KEY_RELEASE)
    assert(s.foes[0].slow_until == s.tick + 90, "ninety world ticks after unpause")
}

fn test_cb15_a_found_frame_appends_its_existing_words_without_r() {
    var s = quiet()
    s.area = forest.LARKMEADOW
    let (kind, x, y) = forest.landmark(s.seed, s.field, s.area, 2)
    assert(kind == forest.LM_FRAME, "existing frame")
    s.x = x * sim.FP + sim.FP / 2
    s.y = (forest.origin(s.seed, s.area) + y) * sim.FP + sim.FP / 2
    wait(mut s, 2)
    assert(
        s.pouch.lore.len == 1 && s.pouch.lore[0] == lore.ASH_SHELTER,
        "nearby discovery, deduplicated",
    )
    assert(
        lore.ASH_SHELTER == 11 &&
            lore.COUNT == 33 &&
            lore.line(11).starts_with("The charred frame"),
        "append-only words (cb14 appends 13..31)",
    )
}

fn test_cb15_lore_appends_once_and_rest_lore_is_scrollable() {
    var s = quiet()
    sim.remember_lore(mut s, 2)
    sim.remember_lore(mut s, 1)
    sim.remember_lore(mut s, 2)
    assert(s.pouch.lore.len == 2 && s.pouch.lore[0] == 2 && s.pouch.lore[1] == 1, "discovery order")
    s.den = true
    sim.rest_reset(mut s)
    s.rest_row = 6
    press(mut s, controls.KEY_BITE)
    assert(s.pouch.lore_open, "Lore row")
    press(mut s, controls.KEY_DOWN)
    assert(s.pouch.lore_row == 1, "scroll")
    press(mut s, controls.KEY_RELEASE)
    assert(s.den && !s.pouch.lore_open, "return to den")
}

fn test_cb15_save_and_replay_snapshot_keep_pouch_lore_and_ground_items() {
    var s = quiet()
    let _ = sim.give_item(mut s, pouch.TUFT)
    let _ = sim.give_item(mut s, pouch.PINE)
    sim.remember_lore(mut s, 2)
    let _ = pouch.leave(mut s.pouch, 0, 3, 12, pouch.ICE)
    s.pouch.uses = 2
    let text = journey.encode(s)
    let restored = journey.decode(text, 80, 24) else { assert(false, "save"); return }
    assert(journey.encode(restored) == text, "canonical round trip")
    assert(
        restored.pouch.tuft == 1 && restored.pouch.uses == 2 && restored.pouch.lore[0] == 2,
        "persistent items",
    )
    assert(
        pouch.pack(restored.pouch.pickups[0]) == pouch.pack(s.pouch.pickups[0]),
        "persistent drop",
    )
    let replayed = journey.from_snapshot(journey.snapshot(s), 80, 24) else {
        assert(false, "snapshot")
        return
    }
    assert(journey.encode(replayed) == text, "same replay initial world")
}

fn test_cb15_migrates_cub_five_counts_and_rejects_bad_new_state() {
    let payload = "CUB 5\nseed 7 difficulty 0\ngrowth 1 1 1 1 1\nwater 0 scent 0\nden 0 lit 1 shortcuts 0\ngate 0 story 0 deaths 0\nmark 0 0 0 0 0\ncache 0 pouch 6 6 opening 0\nfield 80\nbosses 0 end 0 played 0 lost 0\nlevel 1\nslain 0 0 0 0 0 0 0\n"
    let migrated = journey.decode(
        payload + "check {journey.checksum(payload)}\n",
        80,
        24,
    ) else |e| {
        assert(false, "CUB5 migration {e}")
        return
    }
    assert(
        migrated.yarrow == 5 &&
            migrated.marrow == 3 &&
            migrated.pouch.uses == 0 &&
            migrated.pouch.lore.len == 0 &&
            migrated.pouch.pickups.len == 0,
        "cap old counts, new fields empty",
    )
    var bad = quiet()
    bad.pouch.tuft = 2
    var rejected = false
    let _ = journey.decode(journey.encode(bad), 80, 24) else |_| { rejected = true; quiet() }
    assert(rejected, "new tuft cap validated")
}

fn test_cb15_pine_makes_the_lynx_lose_the_cub() {
    var s = quiet()
    s.area = forest.CRAGS
    let (x, y, _) = forest.arena(s.seed, s.field, s.area)
    s.x = x * sim.FP
    s.y = (forest.origin(s.seed, s.area) + y) * sim.FP
    s.foes = sim.area_foes(s.seed, s.field, s.area, 0)
    let _ = sim.give_item(mut s, pouch.PINE)
    let _ = sim.consume_item(mut s, pouch.PINE)
    wait(mut s, 1)
    for f in s.foes {
        if f.kind == sim.LYNX {
            assert(!f.engaged && f.speed == 0 && f.phase == sim.HUNT, "lynx loses scent")
        }
    }
    assert(s.boss == -1, "no engaged lynx theme")
}

fn test_cb15_menu_freezes_marrow_bleed_trail_and_absolute_expiries() {
    var s = quiet()
    s.health = 20
    let _ = sim.give_item(mut s, pouch.MARROW)
    let _ = sim.consume_item(mut s, pouch.MARROW)
    let _ = sim.give_item(mut s, pouch.PINE)
    press(mut s, controls.KEY_INVENTORY)
    let health = s.health
    wait(mut s, 100)
    assert(s.health == health && s.pouch.marrow_ticks == 60, "menu consumes no world tick")
    let _ = sim.consume_item(mut s, pouch.PINE)
    wait(mut s, 20)
    press(mut s, controls.KEY_RELEASE)
    assert(s.pouch.hidden == s.tick + 600, "new pine starts at the paused world time")
    wait(mut s, 60)
    assert(s.health == 50 && s.pouch.marrow_ticks == 0, "heal resumes without fast-forward")
}

fn test_cb15_inventory_preserves_bite_age_and_two_queued_links() {
    var s = quiet()
    sim.combat_witness(mut s)
    s.tick = 2
    s.action = sim.BITE
    s.combo = 1
    s.started = 0
    s.action_x = s.x
    s.action_y = s.y
    s.chained = 2
    s.chained_heading = 0
    s.chained_second_heading = 0
    press(mut s, controls.KEY_INVENTORY)
    wait(mut s, 100)
    press(mut s, controls.KEY_RELEASE)
    assert(s.tick - s.started == 2 && s.chained == 2, "opening tick does not consume an action age")
    wait(mut s, 1)
    assert(
        s.tick - s.started == 3 && sim.strike_peak(s),
        "first resumed tick is the first strike age",
    )
    wait(mut s, 8)
    assert(s.combo == 2 && s.chained == 1, "first queued link survives")
    wait(mut s, 13)
    assert(s.combo == 3 && s.chained == 0, "second queued link survives")
}

fn test_cb15_inventory_preserves_cb11_six_tick_combo_grace() {
    var s = quiet()
    s.combo_previous = 1
    s.combo_until = 6
    press(mut s, controls.KEY_INVENTORY)
    wait(mut s, 100)
    press(mut s, controls.KEY_RELEASE)
    assert(s.combo_until == s.tick + 6, "combat grace retains all six world ticks")
    press(mut s, controls.KEY_BITE)
    assert(s.action == sim.BITE && s.combo == 2, "fresh post-menu press continues the chain")
}

fn test_cb15_inventory_preserves_riposte_and_foe_poise_windows() {
    var s = quiet()
    (mut s.foes).push(sim.make_ashen(s.x + 30 * sim.FP, s.y))
    s.riposte = 50
    s.riposte_foe = 0
    s.foes[0].poise = 7
    s.foes[0].poise_at = 0
    press(mut s, controls.KEY_INVENTORY)
    wait(mut s, 100)
    press(mut s, controls.KEY_RELEASE)
    assert(
        s.riposte == 152 && s.foes[0].poise_at == 102 && s.foes[0].poise == 7,
        "paused combat windows retain their remaining time",
    )
}

fn test_cb15_inventory_also_pauses_offscreen_loot_expiry() {
    var s = quiet()
    (mut s.away_loot[1].drops).push(sim.Drop { x: 0, y: 0, value: 8, until: 90 })
    (mut s.away_loot[1].meat).push(sim.Meat { x: 0, y: 0, until: 300 })
    press(mut s, controls.KEY_INVENTORY)
    wait(mut s, 100)
    press(mut s, controls.KEY_RELEASE)
    assert(
        s.away_loot[1].drops[0].until == 192 && s.away_loot[1].meat[0].until == 402,
        "all cached loot deadlines include the opening and closing paused ticks",
    )
}

fn test_cb15_ground_pool_refuses_a_drop_without_losing_inventory() {
    var s = quiet()
    var n = 0
    while n < pouch.PICKUPS {
        assert(pouch.leave(mut s.pouch, 0, n, 0, pouch.YARROW), "bounded ground slot")
        n += 1
    }
    let _ = sim.give_item(mut s, pouch.YARROW)
    assert(
        !sim.drop_item(mut s, pouch.YARROW) &&
            s.yarrow == 1 &&
            s.pouch.pickups.len == pouch.PICKUPS,
        "no silent destruction when full",
    )
}

fn test_cb15_ice_slows_the_airborne_orbit_without_changing_its_tell() {
    var s = quiet()
    let foes = sim.area_foes(s.seed, s.field, forest.LARKMEADOW, 0)
    for f in foes { if f.kind == sim.HAWK { (mut s.foes).push(copy f); break } }
    assert(s.foes.len == 1, "real hawk")
    s.foes[0].home_x = s.x + 30 * sim.FP
    s.foes[0].home_y = s.y
    s.foes[0].x = s.foes[0].home_x
    s.foes[0].y = s.y
    s.foes[0].slow_until = 90
    wait(mut s, 20)
    assert(s.foes[0].slow_lag == 10 && s.foes[0].phase == sim.HUNT, "half orbit clock")
    let x = s.foes[0].x
    press(mut s, controls.KEY_INVENTORY)
    wait(mut s, 20)
    assert(s.foes[0].x == x, "paused orbit")
    press(mut s, controls.KEY_RELEASE)
    assert(s.foes[0].slow_until == s.tick + 70, "only menu time added to slow duration")
}

fn test_cb15_species_drop_rolls_are_stable_and_match_rates() {
    var rate = 10
    while rate <= 25 {
        var count = 0
        var seed = 0
        while seed < 100 { if pouch.drops(seed, 2, 7, rate) { count += 1 }; seed += 1 }
        assert(count == rate, "each percentile occurs once in one hundred seeds")
        rate += 5
    }
}

fn test_cb15_burn_hook_melts_carried_and_local_ice_only() {
    var s = quiet()
    let _ = sim.give_item(mut s, pouch.ICE)
    let _ = pouch.leave(mut s.pouch, 0, 0, 0, pouch.ICE)
    let _ = pouch.leave(mut s.pouch, 1, 0, 0, pouch.ICE)
    sim.melt_ice(mut s)
    assert(
        s.pouch.ice == 0 && s.pouch.pickups.len == 1 && s.pouch.pickups[0].area == 1,
        "Burn hook",
    )
}

fn test_cb15_pickup_sprites_and_inventory_exist_on_both_tiers() {
    var s = quiet()
    let _ = sim.give_item(mut s, pouch.YARROW)
    var t = tier.PLAIN
    while t <= tier.RICH {
        var g = grid.new(24, 80)
        inventory.render(s, t, mut g)
        assert(grid.at(g, 3, 5).cp == 84, "The pouch title")
        var k = 0
        while k < pouch.KINDS {
            inventory.pickup(mut g, t, 12, 10 + 8 * k, k, 0)
            assert(grid.at(g, 11, 9 + 8 * k).cp != 32, "shaped pickup")
            k += 1
        }
        t += 1
    }
}
