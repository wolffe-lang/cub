//! The cub's five item kinds and bounded, persistent world pickups.
//! No wall clock or random stream: a foe's roll is seed/area/spawn_id identity.

/// The sprig: stop bleeding and heal ten.
pub const YARROW: int = 0

/// Slow healing from a marrow bone.
pub const MARROW: int = 1

/// A pine bough hides scent.
pub const PINE: int = 2

/// A thrown shard slows its target.
pub const ICE: int = 3

/// The passive, single-use scent protection.
pub const TUFT: int = 4

/// Five stackable kinds.
pub const KINDS: int = 5

/// Maximum world pickups; a full pool refuses inventory drops.
pub const PICKUPS: int = 128

/// Maximum discovered lore lines, in discovery order.
pub const LORE_SLOTS: int = 32

/// Seven scalars, thirty-two lore ids and one hundred twenty-eight pickups.
pub const SAVE_SLOTS: int = 167

/// Cell coordinates, never a second actor or a fractional position.
pub struct Pickup { area: int, x: int, y: int, kind: int }

/// Existing yarrow and marrow counts retain their stable Sim fields.
pub struct Pouch {
    pine: int,
    ice: int,
    tuft: int,
    uses: int,
    seeded: int,
    pickups: List[Pickup],
    lore: List[int],
    marrow_ticks: int,
    marrow_phase: int,
    hidden: int,
    bleeding: int,
    still: int,
    open: bool,
    paused_at: int,
    row: int,
    tooltip: bool,
    choice: int,
    aiming: bool,
    lore_open: bool,
    lore_row: int,
    legacy_rest: bool,
}

/// Empty persistent pouch with all transient effects and menus inactive.
pub fn new() -> Pouch {
    Pouch {
        pine: 0,
        ice: 0,
        tuft: 0,
        uses: 0,
        seeded: 0,
        pickups: List[Pickup](),
        lore: List[int](),
        marrow_ticks: 0,
        marrow_phase: 0,
        hidden: 0,
        bleeding: 0,
        still: 0,
        open: false,
        paused_at: 0,
        row: 0,
        tooltip: false,
        choice: 0,
        aiming: false,
        lore_open: false,
        lore_row: 0,
        legacy_rest: false,
    }
}

/// Stack limit for a valid kind: five sprigs, one tuft, three otherwise.
pub fn cap(kind: int) -> int { if kind == YARROW then 5 else if kind == TUFT then 1 else 3 }

/// Display name for an item row.
pub fn name(kind: int) -> str {
    match kind {
        0 => "Yarrow",
        1 => "Marrow",
        2 => "Pine",
        3 => "A shard of ice",
        _ => "The mother's tuft",
    }
}

/// One-line effect and timing, shared by the list and tooltip.
pub fn effect(kind: int) -> str {
    match kind {
        0 => "Stops bleeding; heals 10 now.",
        1 => "Heals 30 over 60 ticks; a hit interrupts.",
        2 => "Hides the trail for 600 ticks.",
        3 => "Aim within 6 cells; half speed, 90 ticks.",
        _ => "Passive: the next death keeps its scent.",
    }
}

/// Stable bounded roll; negative seeds remain well-defined without abs(MIN).
pub fn roll(seed: int, area: int, spawn_id: int) -> int {
    let n = (seed % 1000003 + 1000003) % 1000003
    (n * 48271 + area * 7919 + spawn_id * 104729 + 17) % 100
}

/// The caller supplies the species' explicit rate, not a mutable RNG.
pub fn drops(seed: int, area: int, spawn_id: int, percent: int) -> bool {
    roll(seed, area, spawn_id) < percent
}

/// Area bit in the finite discovery mask; callers bound area to zero through31.
pub fn bit(area: int) -> int {
    var n = 1
    var i = 0
    while i < area { n *= 2; i += 1 }
    n
}

/// Compact fixed replay slot: fields have independently validated bounds.
pub fn pack(p: Pickup) -> int {
    ((p.area * 5 + p.kind) * 20001 + p.x + 10000) * 200001 + p.y + 100000 + 1
}

/// Inverse of pack for a positive validated packed value.
pub fn unpack(n: int) -> Pickup {
    let v = n - 1
    Pickup {
        y: v % 200001 - 100000,
        x: v / 200001 % 20001 - 10000,
        kind: v / 200001 / 20001 % 5,
        area: v / 200001 / 20001 / 5,
    }
}

/// Append once, preserving discovery order; invalid or excess lore is refused.
pub fn add_lore(mut p: Pouch, id: int) {
    if id < 0 || id >= 1000 || p.lore.len >= LORE_SLOTS { return }
    for old in p.lore { if old == id { return } }
    (mut p.lore).push(id)
}

/// A full ground pool refuses a drop instead of silently destroying an item.
pub fn leave(mut p: Pouch, area: int, x: int, y: int, kind: int) -> bool {
    if p.pickups.len >= PICKUPS ||
        area < 0 ||
        area >= 32 ||
        x < -10000 ||
        x > 10000 ||
        y < -100000 ||
        y > 100000 ||
        kind < 0 ||
        kind >= KINDS {
        return false
    }
    (mut p.pickups).push(Pickup { area: area, x: x, y: y, kind: kind })
    true
}

/// Remove the pickup at a valid index while retaining stable ground order.
pub fn remove(mut p: Pouch, at: int) {
    var i = at
    while i + 1 < p.pickups.len { p.pickups[i] = copy p.pickups[i + 1]; i += 1 }
    let _ = (mut p.pickups).pop()
}

/// Fixed-width numeric persistence: deterministic padding is validated too.
pub fn snapshot_into(p: Pouch, mut v: List[int]) {
    (mut v).push(p.pine)
    (mut v).push(p.ice)
    (mut v).push(p.tuft)
    (mut v).push(p.uses)
    (mut v).push(p.seeded)
    (mut v).push(p.lore.len)
    (mut v).push(p.pickups.len)
    var i = 0
    while i < LORE_SLOTS { (mut v).push(if i < p.lore.len then p.lore[i] + 1 else 0); i += 1 }
    i = 0
    while i < PICKUPS { (mut v).push(if i < p.pickups.len then pack(p.pickups[i]) else 0); i += 1 }
}

/// Refuse invalid bounds, duplicate lore, bad padding or out-of-world areas.
pub fn from_values(v: List[int], at: int, areas: int) -> Pouch ! {invalid} {
    if at < 0 || v.len < at + SAVE_SLOTS { return invalid }
    if v[at] < 0 ||
        v[at] > 3 ||
        v[at + 1] < 0 ||
        v[at + 1] > 3 ||
        v[at + 2] < 0 ||
        v[at + 2] > 1 ||
        v[at + 3] < 0 ||
        v[at + 3] > 1000000000 ||
        v[at + 4] < 0 ||
        v[at + 4] >= bit(areas) ||
        v[at + 5] < 0 ||
        v[at + 5] > LORE_SLOTS ||
        v[at + 6] < 0 ||
        v[at + 6] > PICKUPS {
        return invalid
    }
    var p = new()
    p.pine = v[at]
    p.ice = v[at + 1]
    p.tuft = v[at + 2]
    p.uses = v[at + 3]
    p.seeded = v[at + 4]
    var i = 0
    while i < LORE_SLOTS {
        let n = v[at + 7 + i]
        if i < v[at + 5] {
            if n < 1 || n > 1000 { return invalid }
            for old in p.lore { if old == n - 1 { return invalid } }
            (mut p.lore).push(n - 1)
        } else if n != 0 {
            return invalid
        }
        i += 1
    }
    i = 0
    while i < PICKUPS {
        let n = v[at + 7 + LORE_SLOTS + i]
        if i < v[at + 6] {
            if n <= 0 || n > areas * 5 * 20001 * 200001 { return invalid }
            let item = unpack(n)
            if item.area >= areas || pack(item) != n { return invalid }
            (mut p.pickups).push(item)
        } else if n != 0 {
            return invalid
        }
        i += 1
    }
    p
}
