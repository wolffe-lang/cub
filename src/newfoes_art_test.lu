//! member: false

use art
use grid
use sim
use sprites
use silhouette
use tier

fn sprite_envelopes(kind: int) {
    for t in [tier.RICH, tier.PLAIN] {
        for phase in [sim.HUNT, sim.CROUCH, sim.STRIKE, sim.RETREAT] {
            var quarter = 0
            while quarter < 4 {
                var f = sim.make_new_foe(kind, 10 * sim.FP, 6 * sim.FP)
                f.heading = quarter * 64
                let body = sim.foe_body(f)
                var g = grid.new(12, 20)
                art.draw_new_foe(mut g, t, 6, 10, kind, phase, quarter * 64, -1)
                var painted = 0
                var r = 0
                while r < g.rows {
                    var c = 0
                    while c < g.cols {
                        if grid.at(g, r, c).cp != 32 {
                            assert(
                                c >= body.x0 && c <= body.x1 && r >= body.y0 && r <= body.y1,
                                "the drawing and the hit body agree in every quarter",
                            )
                            painted += 1
                        }
                        c += 1
                    }
                    r += 1
                }
                assert(painted > 0, "visible foe and visible tell")
                assert(t != tier.PLAIN || grid.plain_ok(g), "plain repertoire")
                quarter += 1
            }
        }
    }
}

fn test_cb18_marten_four_way_envelopes() { sprite_envelopes(sim.MARTEN) }

fn test_cb18_adder_four_way_envelopes() { sprite_envelopes(sim.ASH_ADDER) }

fn test_cb18_moths_four_way_envelopes() { sprite_envelopes(sim.CINDER_MOTHS) }

fn test_cb18_heron_four_way_envelopes() { sprite_envelopes(sim.HERON) }

fn test_cb18_glow_four_way_envelopes() { sprite_envelopes(sim.GLOW_WORMS) }

fn test_cb18_wisp_four_way_envelopes() { sprite_envelopes(sim.WISP) }

fn test_cb18_moth_dimming_keeps_every_glyph_and_uses_dim_on_both_tiers() {
    var s = sim.new_foe_arena(1, 80, 24, sim.CINDER_MOTHS)
    s.foes[0].phase = sim.CROUCH
    s.foes[0].x = s.x
    s.foes[0].y = s.y - 2 * sim.FP
    for t in [tier.RICH, tier.PLAIN] {
        var g = grid.new(24, 80)
        art.render(s, t, mut g)
        let dimmed = copy g
        s.foes[0].phase = sim.HUNT
        art.render(s, t, mut g)
        var r = 0
        while r < g.rows {
            var c = 0
            while c < g.cols {
                // The foe's own tell changes its glyph: compare distant
                // forest and HUD, not the differently posed moth body.
                if r < 5 || r > 18 {
                    assert(
                        grid.at(g, r, c).cp == grid.at(dimmed, r, c).cp,
                        "no third-glyph blanking",
                    )
                }
                assert(grid.at(dimmed, r, c).attrs == grid.ATTR_DIM, "palette dim, no bold")
                c += 1
            }
            r += 1
        }
        s.foes[0].phase = sim.CROUCH
    }
}

fn test_cb18_glow_contact_flashes_exactly_six_frames_and_scatters_the_cluster() {
    var s = sim.new_foe_arena(1, 80, 24, sim.GLOW_WORMS)
    (mut s.foes).push(sim.make_new_foe(sim.GLOW_WORMS, s.x + 4 * sim.FP, s.y))
    s.foes[0].x = s.x
    s.foes[0].y = s.y
    sim.new_foe_step(mut s, 0)
    assert(s.foes[0].health == 0 && s.blind_until == 6, "touch flashes and consumes exactly one")
    assert(s.foes[1].health > 0 && s.foes[1].phase == sim.RETREAT, "others scatter, not vanish")
    for t in [tier.RICH, tier.PLAIN] {
        var age = 0
        while age < 7 {
            s.tick = age
            var g = grid.new(4, 8)
            art.new_foe_palette(s, t, mut g)
            if age < 6 {
                assert(
                    grid.at(g, 0, 0).cp == 32 &&
                        grid.at(g, 0, 0).bg == (if t == tier.RICH then 15 else 7),
                    "six white frames",
                )
            } else {
                assert(grid.at(g, 0, 0).bg == grid.COLOR_DEFAULT, "seventh frame sees again")
            }
            age += 1
        }
    }
}

fn test_cb18_snuffed_wisp_returns_at_three_hundred_not_before() {
    var s = sim.new_foe_arena(1, 80, 24, sim.WISP)
    s.foes[0].phase = sim.SNUFFED
    s.foes[0].since = 20
    s.tick = 319
    sim.new_foe_step(mut s, 0)
    assert(s.foes[0].phase == sim.SNUFFED, "299 ticks is too soon")
    s.tick = 320
    sim.new_foe_step(mut s, 0)
    assert(
        s.foes[0].phase == sim.HUNT && s.foes[0].health > 0,
        "300 tick return, not a respawned kill",
    )
}

fn test_cb18_moth_bitmap_loses_two_visible_moths_per_bite() {
    for count in [5, 3, 1, 0] {
        let b = art.new_foe_bitmap_count(sim.CINDER_MOTHS, sim.CROUCH, count)
        var lit = 0
        for pixel in b.px { lit += pixel }
        assert(lit == count, "the live count is drawn, not a permanent five-moth sprite")
    }
}

fn test_cb18_glow_worms_carry_light_and_their_death_darkens_the_cave() {
    var s = sim.new_foe_arena(1, 80, 24, sim.GLOW_WORMS)
    let (x, y) = sim.world_cell(s, 12, 55)
    s.foes[0].x = x * sim.FP
    s.foes[0].y = y * sim.FP
    var g = grid.new(24, 80)
    art.dim_glow_cave(s, true, mut g)
    assert(grid.at(g, 12, 55).attrs == 0, "live worm carries light beyond cub sight")
    assert(grid.at(g, 12, 40).attrs == 0, "cub still sees three cells without a worm")
    assert(grid.at(g, 0, 0).attrs == grid.ATTR_DIM, "unlit cave is dim, not erased")
    s.foes[0].health = 0
    grid.clear(mut g)
    art.dim_glow_cave(s, true, mut g)
    assert(grid.at(g, 12, 55).attrs == grid.ATTR_DIM, "killing a worm extinguishes its light")
}

fn test_cb18_one_glow_contact_does_not_consume_all_three_before_they_scatter() {
    var s = sim.new_foe_arena(1, 80, 24, sim.GLOW_WORMS)
    s.foes[0].x = s.x
    s.foes[0].y = s.y
    let x = s.x
    let y = s.y
    (mut s.foes).push(sim.make_new_foe(sim.GLOW_WORMS, x + 4 * sim.FP, y))
    (mut s.foes).push(sim.make_new_foe(sim.GLOW_WORMS, x - 4 * sim.FP, y))
    sim.step(mut s, List[int]())
    assert(
        s.foes[0].health == 0 && s.foes[1].health > 0 && s.foes[2].health > 0,
        "only the touched worm flashes; the others survive the same shipping tick",
    )
    assert(
        s.foes[1].x > x + 4 * sim.FP && s.foes[2].x < x - 4 * sim.FP,
        "both siblings actually scatter, not merely acquire a phase flag",
    )
    assert(s.blind_until == 7, "one six-frame flash, not a chain of same-tick contacts")
}

fn declared_new_glyphs(kind: int) {
    let allowed = sprites.rich_code_points()
    let counts = if kind == sim.CINDER_MOTHS then [1, 3, 5] else [5]
    for count in counts {
        for phase in [sim.HUNT, sim.CROUCH, sim.STRIKE, sim.RETREAT] {
            var q = 0
            while q < 4 {
                let b = silhouette.turned(art.new_foe_bitmap_count(kind, phase, count), q)
                var r = 0
                while r < silhouette.rows(b) {
                    var c = 0
                    while c < silhouette.cols(b) {
                        let cp = silhouette.cell_cp(b, r, c)
                        if cp > 255 {
                            var found = false
                            for declared in allowed { if cp == declared { found = true } }
                            if !found {
                                print(
                                    "cb18 missing glyph kind={kind} count={count} phase={phase} quarter={q} cp={cp}",
                                )
                            }
                            assert(
                                found,
                                "every live-count and active/recovery glyph belongs to the declared font extent",
                            )
                        }
                        c += 1
                    }
                    r += 1
                }
                q += 1
            }
        }
    }
}

fn test_cb18_marten_all_live_glyphs_declared() { declared_new_glyphs(sim.MARTEN) }

fn test_cb18_adder_all_live_glyphs_declared() { declared_new_glyphs(sim.ASH_ADDER) }

