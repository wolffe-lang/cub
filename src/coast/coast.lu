//! Independent shipping-binary coast census, bounded scratch per seed.

use art
use forest
use grid
use sim
use terrain
use tier

/// No empty forest run is allowed: N=0.
pub const EMPTY_MAX: int = 0

/// Maximum cardinal distance from den-reachable ground to a useful route.
pub const WALK_MAX: int = 200

const WIDTH: int = 81

const TOP: int = -16

const HEIGHT: int = 177

/// Flood actual collision cells. Targets are the thorn-route centreline
/// and the two cache centres, not the generator's connectivity promises.
fn distances(seed: int, targets: bool) -> List[int] {
    var dist = List[int]()
    var queue = List[int]()
    var i = 0
    while i < WIDTH * HEIGHT { (mut dist).push(-1); i += 1 }
    let o = forest.origin(seed, 0)
    var y = TOP
    while y <= forest.LENGTH {
        var x = -40
        while x <= 40 {
            var source = !targets && x == 0 && y == 0
            if targets {
                source = y >= 10 && x == forest.spine(seed, 0, y)
                var cache = 0
                while cache < 2 {
                    let (cx, cy) = forest.cache_position(seed, 0, cache)
                    if x == sim.floor_div(cx, sim.FP) && y == sim.floor_div(cy, sim.FP) - o {
                        source = true
                    }
                    cache += 1
                }
            }
            if source && !forest.blocked(seed, 0, x, y + o) {
                let at = (y - TOP) * WIDTH + x + 40
                dist[at] = 0
                (mut queue).push(at)
            }
            x += 1
        }
        y += 1
    }
    var head = 0
    while head < queue.len {
        let cell = queue[head]
        let x = cell % WIDTH - 40
        let y = cell / WIDTH + TOP
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= -40 && nx <= 40 && ny >= TOP && ny <= forest.LENGTH {
                let at = (ny - TOP) * WIDTH + nx + 40
                if dist[at] < 0 && !forest.blocked(seed, 0, nx, ny + o) {
                    dist[at] = dist[cell] + 1
                    (mut queue).push(at)
                }
            }
            d += 1
        }
        head += 1
    }
    dist
}

/// Den flood reaches both complete alcoves, and every visited cell has a
/// target within K; return the measured maximum, trap on a broken promise.
pub fn walk_bound(seed: int) -> int {
    let den = distances(seed, false)
    let targets = distances(seed, true)
    let o = forest.origin(seed, 0)
    var cache = 0
    while cache < 2 {
        let (x, y) = forest.cache_position(seed, 0, cache)
        let cx = sim.floor_div(x, sim.FP)
        let cy = sim.floor_div(y, sim.FP) - o
        var dx = -3
        while dx <= 3 {
            var dy = -3
            while dy <= 3 {
                if dx * dx + dy * dy <= 16 {
                    if den[(cy + dy - TOP) * WIDTH + cx + dx + 40] < 0 {
                        eprint(
                            "coast: seed {seed} cache {cache} cell {cx + dx},{cy + dy} kind {forest.kind(seed, 0, cx + dx, cy + dy + o)}",
                        )
                    }
                    assert(
                        den[(cy + dy - TOP) * WIDTH + cx + dx + 40] >= 0,
                        "cb02a branch alcove unreachable seed {seed} cache {cache}",
                    )
                }
                dy += 1
            }
            dx += 1
        }
        cache += 1
    }
    var max_steps = 0
    var i = 0
    while i < den.len {
        if den[i] >= 0 {
            assert(
                targets[i] >= 0 && targets[i] <= WALK_MAX,
                "cb02a aimless reachable ground seed {seed} cell {i}",
            )
            if targets[i] > max_steps { max_steps = targets[i] }
            // A bounded shore cannot leak through the side or river edge.
            if i % WIDTH == 0 || i % WIDTH == WIDTH - 1 {
                let x = if i % WIDTH == 0 then -41 else 41
                assert(forest.blocked(seed, 0, x, i / WIDTH + TOP + o), "cb02a side escape")
            }
            assert(i / WIDTH != 0, "cb02a river escape seed {seed}")
        }
        i += 1
    }
    max_steps
}

/// Inspect the actual renderer's terrain layer, avoiding intentional HUD,
/// actor and prop overlays. Cover every area, both widths, and both tiers.
pub fn empty_run(seed: int) -> int {
    var longest = 0
    var area = 0
    while area < 3 {
        var size = 0
        while size < 2 {
            let cols = if size == 0 then 80 else 200
            let rows = if size == 0 then 24 else 60
            var t = tier.PLAIN
            while t <= tier.RICH {
                var camera = 0
                while camera <= forest.LENGTH + rows {
                    var shift = 0
                    while shift < (if cols == 80 then 2 else 1) {
                        region frame {
                            var s = sim.new(seed, cols, rows)
                            s.area = area
                            s.y = (forest.origin(seed, area) + camera) * sim.FP
                            s.x = shift * sim.FP
                            var g = grid.new(rows, cols)
                            var row = 0
                            while row < rows {
                                art.terrain_row(s, t, row, mut g)
                                var run = 0
                                var col = 0
                                while col < cols {
                                    let (x, y) = sim.world_cell(s, row, col)
                                    let k = forest.kind(seed, area, x, y)
                                    let c = grid.at(g, row, col)
                                    if (
                                        k == terrain.DARK ||
                                            k == terrain.CANOPY ||
                                            k == terrain.TRUNK
                                    ) &&
                                        (c.cp == 32 || c.fg == c.bg) {
                                        run += 1
                                    } else {
                                        run = 0
                                    }
                                    if run > longest { longest = run }
                                    col += 1
                                }
                                row += 1
                            }
                            if t == tier.PLAIN { assert(grid.plain_ok(g), "cb02a plain forest") }
                        }
                        shift += 1
                    }
                    camera += rows
                }
                t += 1
            }
            size += 1
        }
        area += 1
    }
    assert(longest <= EMPTY_MAX, "cb02a empty forest seed {seed} run {longest}")
    longest
}

/// Coast slope, not a forced short straight-run: long gentle banks are valid.
pub fn bank_step(seed: int) -> int {
    var max_step = 0
    var x = -100
    while x < 100 {
        let d = terrain.bank(seed, x + 1) - terrain.bank(seed, x)
        let step = if d < 0 then 0 - d else d
        if step > max_step { max_step = step }
        x += 1
    }
    assert(max_step <= 1, "cb02a sawtooth bank")
    max_step
}
