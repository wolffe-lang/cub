//! wide — cb05's censuses of the wide forest, each an instrument the
//! shipping binary runs over fifty seeds and both fields (`tools/gameplay.py`
//! gates them): the dens' spacing in route cells (R-cb05-3), the foes an
//! area starts with (R-cb05-4), the bends of every route and branch (no
//! reversal within eight cells: the sawtooths' census), every spur's end
//! at something named, and the time the terrain layer takes to classify
//! an area. Every measure reads the real tiles or the real centrelines,
//! never the generator's promises.

use clock
use forest
use npc
use sim
use terrain
use town

/// Rows between the two headings a turn is measured from, and the window
/// two turns of opposite sign may not share.
pub const BEND_WINDOW: int = 8

/// Half the heading's baseline, samples.
pub const BEND_ARM: int = 4

/// The least cross product (of two baselines of about eight cells) that
/// counts as a turn: about fourteen degrees, above a staircase's jitter.
pub const BEND_TURN: int = 16

/// The most milliseconds the terrain layer may take over an area at
/// field 200 (item 6).
pub const GEN_MS: int = 50

/// The foes a big area starts with, boss excluded (R-cb05-4 A).
pub const FOES_BIG_MIN: int = 12

/// ... and at most.
pub const FOES_BIG_MAX: int = 18

/// The foes a later area starts with.
pub const FOES_LATE_MIN: int = 8

/// ... and at most (cb14: twelve and the alcove guards, R-cb14-5).
pub const FOES_LATE_MAX: int = 14

/// The foes one of cb14's areas starts with until cb18 fills its table:
/// its alcove guards (two pairs and one; Gravehollow's a pair and one).
pub const FOES_NEW_MIN: int = 3

/// ... and at most.
pub const FOES_NEW_MAX: int = 32

/// An area's map as text (cb14's instrument): one character a cell over
/// the whole width and length at a field, the route and every carved
/// cell `.`, the dens `D`, the caches `C`, the portals `P`, the landmarks
/// `L`, the arena's centre `A`, the foes `f` (a boss `B`), and the kinds
/// by letter otherwise. Exit 2 on an unknown area.
pub fn area_map(seed: int, area: int, field: int) -> int {
    if area < 0 || area >= forest.AREAS { return 2 }
    let w = forest.bound(field, area)
    let o = forest.origin(seed, area)
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let l = forest.length(area)
    let width = w * 2 + 1
    var marks = List[int]()
    var i = 0
    while i < width * (l - top + 1) { (mut marks).push(0); i += 1 }
    var den = 0
    while den < forest.DEN_LIMIT {
        if forest.den_area(den) == area {
            let (x, y) = den_cell(seed, area, den)
            mark(mut marks, w, top, l, x, y, 68)
        }
        den += 1
    }
    var edge = 0
    while edge < forest.EDGES {
        if forest.other(area, edge) >= 0 {
            let (x, y) = forest.portal(seed, area, edge)
            mark(mut marks, w, top, l, x / forest.FP, y / forest.FP - o, 80)
        }
        edge += 1
    }
    var cache = 0
    while cache < forest.cache_count(area) {
        let (x, y) = forest.cache_position(seed, field, area, cache)
        mark(
            mut marks,
            w,
            top,
            l,
            (x - forest.FP / 2) / forest.FP,
            (y - forest.FP / 2) / forest.FP - o,
            67,
        )
        cache += 1
    }
    var k = 0
    while k < forest.landmark_count(area) {
        let (_, lx, ly) = forest.landmark(seed, field, area, k)
        mark(mut marks, w, top, l, lx, ly, 76)
        k += 1
    }
    if forest.has_arena(area) {
        let (cx, cy, _) = forest.arena(seed, field, area)
        mark(mut marks, w, top, l, cx, cy, 65)
    }
    for f in sim.area_foes(seed, field, area, 0) {
        let fx = sim.floor_div(f.x, forest.FP)
        let fy = sim.floor_div(f.y, forest.FP) - o
        mark(mut marks, w, top, l, fx, fy, if sim.is_boss(f.kind) then 66 else 102)
    }
    print("area {area} {forest.name(area)} seed {seed} field {field} width {width} rows {top}..{l}")
    var at = top
    while at <= l {
        var line = ""
        var x = 0 - w
        while x <= w {
            let m = marks[(at - top) * width + x + w]
            let kind = forest.kind(seed, field, area, x, o + at)
            let ch = if m != 0 {
                m
            } else if forest.on_path(seed, field, area, x, o + at) && !terrain.solid(kind) {
                46
            } else {
                kind_letter(kind)
            }
            line += ch as char
            x += 1
        }
        print(line)
        at += 1
    }
    // Every destination by name with its ground and the flood's answer:
    // what `--world-audit`'s `reached` column counts.
    let seen = forest.flood(seed, field, area)
    den = 0
    while den < forest.DEN_LIMIT {
        if forest.den_area(den) == area {
            let (x, y) = den_cell(seed, area, den)
            destination("den {den}", seed, field, area, x, y, seen)
        }
        den += 1
    }
    edge = 0
    while edge < forest.EDGES {
        if forest.other(area, edge) >= 0 {
            let (x, y) = forest.portal(seed, area, edge)
            destination("portal {edge}", seed, field, area, x / forest.FP, y / forest.FP - o, seen)
        }
        edge += 1
    }
    cache = 0
    while cache < forest.cache_count(area) {
        let (x, y) = forest.cache_position(seed, field, area, cache)
        destination(
            "cache {cache}",
            seed,
            field,
            area,
            (x - forest.FP / 2) / forest.FP,
            (y - forest.FP / 2) / forest.FP - o,
            seen,
        )
        cache += 1
    }
    k = 0
    while k < forest.landmark_count(area) {
        let (_, lx, ly) = forest.landmark(seed, field, area, k)
        destination("landmark {k}", seed, field, area, lx, ly, seen)
        k += 1
    }
    if forest.has_arena(area) {
        let (cx, cy, _) = forest.arena(seed, field, area)
        destination("arena", seed, field, area, cx, cy, seen)
    }
    0
}

/// One destination's line: its local cell, open or BLOCKED, reached or
/// UNREACHED by the flood.
fn destination(what: str, seed: int, field: int, area: int, x: int, at: int, seen: List[int]) {
    let o = forest.origin(seed, area)
    let ground = if forest.blocked(seed, field, area, x, o + at) then "BLOCKED" else "open"
    let flood = if forest.reached(seen, field, area, x, at) then "reached" else "UNREACHED"
    print("{what} at {x},{at} {ground} {flood}")
}

fn mark(mut marks: List[int], w: int, top: int, l: int, x: int, at: int, ch: int) {
    if x < 0 - w || x > w || at < top || at > l { return }
    marks[(at - top) * (w * 2 + 1) + x + w] = ch
}

/// A terrain kind's letter on the map.
fn kind_letter(k: int) -> int {
    match k {
        0 => 32,  // gravel
        1 => 44,  // grass ,
        2 => 124,  // trunk |
        3 => 59,  // canopy ;
        4 => 35,  // dark #
        5 => 126,  // water ~
        6 => 39,  // reeds '
        7 => 79,  // rock O
        8 => 61,  // shallows =
        9 => 58,  // ash :
        10 => 87,  // wall W
        11 => 42,  // ember *
        12 => 32,  // needles
        13 => 73,  // pine I
        14 => 33,  // char !
        15 => 37,  // drift %
        16 => 111,  // stone o
        17 => 35,  // cave #
        18 => 64,  // glow @
        19 => 83,  // spring S
        20 => 94,  // mound ^
        21 => 77,  // menhir M
        22 => 71,  // gate G
        _ => 63,
    }
}

/// Cardinal tile distances from local cell `(sx, sy)` over an area's real
/// tiles, one a cell, -1 unreached (`forest.flood`'s walk with a count).
fn distances(seed: int, field: int, area: int, sx: int, sy: int) -> List[int] {
    let w = forest.bound(field, area)
    let width = w * 2 + 1
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    let o = forest.origin(seed, area)
    let l = forest.length(area)
    var dist = List[int]()
    var queue = List[int]()
    var i = 0
    while i < width * (l - top + 1) { (mut dist).push(-1); i += 1 }
    if sx < 0 - w || sx > w || sy < top || sy > l { return dist }
    let start = (sy - top) * width + sx + w
    dist[start] = 0
    (mut queue).push(start)
    var head = 0
    while head < queue.len {
        let cell = queue[head]
        let x = cell % width - w
        let y = cell / width + top
        var d = 0
        while d < 4 {
            let nx = x + (if d == 0 then -1 else if d == 1 then 1 else 0)
            let ny = y + (if d == 2 then -1 else if d == 3 then 1 else 0)
            if nx >= 0 - w && nx <= w && ny >= top && ny <= l {
                let at = (ny - top) * width + nx + w
                if dist[at] < 0 && !forest.blocked(seed, field, area, nx, ny + o) {
                    dist[at] = dist[cell] + 1
                    (mut queue).push(at)
                }
            }
            d += 1
        }
        head += 1
    }
    dist
}

fn at_cell(dist: List[int], field: int, area: int, x: int, at: int) -> int {
    let w = forest.bound(field, area)
    let width = w * 2 + 1
    let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
    if x < 0 - w || x > w || at < top || at > forest.length(area) { return -1 }
    dist[(at - top) * width + x + w]
}

/// A den's local cell.
fn den_cell(seed: int, area: int, den: int) -> (int, int) {
    let (x, y) = forest.den_position(seed, den)
    ((x - forest.FP / 2) / forest.FP, (y - forest.FP / 2) / forest.FP - forest.origin(seed, area))
}

/// The exit portal of an area along the way on (its far end), local.
fn exit_cell(seed: int, area: int) -> (int, int) {
    var edge = 0
    while edge < forest.EDGES {
        if forest.path_edge(edge) && forest.other(area, edge) >= 0 && forest.exit_end(area, edge) {
            let (x, y) = forest.portal(seed, area, edge)
            return (x / forest.FP, y / forest.FP - forest.origin(seed, area))
        }
        edge += 1
    }
    (0, -1)
}

/// The next area along the way on, -1 at the end.
fn next_area(area: int) -> int {
    var edge = 0
    while edge < forest.EDGES {
        if forest.path_edge(edge) && forest.other(area, edge) >= 0 && forest.exit_end(area, edge) {
            return forest.other(area, edge)
        }
        edge += 1
    }
    -1
}

/// The dens of an area in route order (by row).
fn dens_of(seed: int, area: int) -> List[int] {
    var out = List[int]()
    var id = 0
    while id < forest.DEN_LIMIT {
        if forest.den_area(id) == area {
            let (_, row) = den_cell(seed, area, id)
            var k = 0
            while k < out.len {
                let (_, r) = den_cell(seed, area, out[k])
                if r > row { break }
                k += 1
            }
            (mut out).insert(k, id)
        }
        id += 1
    }
    out
}

/// The dens' spacing (R-cb05-3): per seed and field, every area's den
/// count, the least route distance (a walk over the real tiles) between
/// its dens, and the walk from its last den to the next area's first den
/// along the way on (through both portals); shortcuts reported apart,
/// never gated (a shortcut is short by design). Exit 1 if an area has
/// more than `DENS_PER_AREA` dens or any route spacing is under
/// `DEN_SPACING`.
pub fn den_spacing() -> int {
    print("seed field area dens within_min within_max onward shortcut_min")
    var seed = 0
    var worst_within = 100000
    var worst_onward = 100000
    while seed < 50 {
        for field in [80, 200] {
            region world {
                var area = forest.SHINGLE
                while area >= 0 {
                    let dens = dens_of(seed, area)
                    var within_min = 0
                    var within_max = 0
                    var k = 0
                    while k + 1 < dens.len {
                        let (ax, ay) = den_cell(seed, area, dens[k])
                        let (bx, by) = den_cell(seed, area, dens[k + 1])
                        let dist = distances(seed, field, area, ax, ay)
                        let d = at_cell(dist, field, area, bx, by)
                        if d < 0 {
                            print(
                                "den-spacing: den {dens[k + 1]} unreached from den {dens[k]} seed {seed} field {field}",
                            )
                            return 1
                        }
                        if within_min == 0 || d < within_min { within_min = d }
                        if d > within_max { within_max = d }
                        k += 1
                    }
                    // Onward: the last den to the exit, then through any
                    // area without a den (cb14: the Howe, Gravehollow) to
                    // the next den along the way on; 0 when none follows.
                    var onward = 0
                    let next = next_area(area)
                    if next >= 0 && dens.len > 0 {
                        let (lx, ly) = den_cell(seed, area, dens[dens.len - 1])
                        let (ex, ey) = exit_cell(seed, area)
                        let dist = distances(seed, field, area, lx, ly)
                        var walk = at_cell(dist, field, area, ex, ey)
                        var ahead = next
                        while ahead >= 0 && dens_of(seed, ahead).len == 0 && walk >= 0 {
                            let (ax, ay) = exit_cell(seed, ahead)
                            let through = at_cell(
                                distances(seed, field, ahead, 0, 1),
                                field,
                                ahead,
                                ax,
                                ay,
                            )
                            walk = if through < 0 || next_area(ahead) < 0 {
                                -2
                            } else {
                                walk + through
                            }
                            ahead = next_area(ahead)
                        }
                        if walk == -2 {
                            onward = 0
                        } else {
                            let nd = dens_of(seed, ahead)
                            let (fx, fy) = den_cell(seed, ahead, nd[0])
                            let entry = distances(seed, field, ahead, 0, 1)
                            let from_entry = at_cell(entry, field, ahead, fx, fy)
                            if walk < 0 || from_entry < 0 {
                                print(
                                    "den-spacing: onward walk unreached seed {seed} field {field} area {area}",
                                )
                                return 1
                            }
                            onward = walk + from_entry
                        }
                    }
                    // Shortcuts: the den nearest each mouth, both sides.
                    var shortcut_min = 0
                    var edge = 0
                    while edge < forest.EDGES {
                        if !forest.path_edge(edge) && forest.other(area, edge) >= 0 {
                            let other = forest.other(area, edge)
                            if other > area {
                                let (px, py) = forest.portal(seed, area, edge)
                                let (qx, qy) = forest.portal(seed, other, edge)
                                let here = distances(
                                    seed,
                                    field,
                                    area,
                                    px / forest.FP,
                                    py / forest.FP - forest.origin(seed, area),
                                )
                                let there = distances(
                                    seed,
                                    field,
                                    other,
                                    qx / forest.FP,
                                    qy / forest.FP - forest.origin(seed, other),
                                )
                                var a = 100000
                                for den in dens {
                                    let (x, y) = den_cell(seed, area, den)
                                    let d = at_cell(here, field, area, x, y)
                                    if d >= 0 && d < a { a = d }
                                }
                                var b = 100000
                                for den in dens_of(seed, other) {
                                    let (x, y) = den_cell(seed, other, den)
                                    let d = at_cell(there, field, other, x, y)
                                    if d >= 0 && d < b { b = d }
                                }
                                if shortcut_min == 0 || a + b < shortcut_min {
                                    shortcut_min = a + b
                                }
                            }
                        }
                        edge += 1
                    }
                    print(
                        "{seed} {field} {area} {dens.len} {within_min} {within_max} {onward} {shortcut_min}",
                    )
                    if dens.len > forest.DENS_PER_AREA ||
                        within_min > 0 && within_min < forest.DEN_SPACING ||
                        onward > 0 && onward < forest.DEN_SPACING {
                        print("den-spacing: RED seed {seed} field {field} area {area}")
                        return 1
                    }
                    if within_min > 0 && within_min < worst_within { worst_within = within_min }
                    if onward > 0 && onward < worst_onward { worst_onward = onward }
                    // The Underteeth hangs off the chain (the sett from the
                    // Teeth, the roots out into the Hush): measured after
                    // the Teeth, its den against the ledge cleft through
                    // the sett and against the cold den through the roots.
                    if area == forest.CRAGS {
                        let u = forest.UNDERTEETH
                        let ud = dens_of(seed, u)
                        let (ux, uy) = den_cell(seed, u, ud[0])
                        let (sx, sy) = forest.portal(seed, u, forest.EDGE_SETT)
                        let (rx, ry) = forest.portal(seed, u, forest.EDGE_ROOTS)
                        let inside = distances(seed, field, u, ux, uy)
                        let to_sett = at_cell(
                            inside,
                            field,
                            u,
                            sx / forest.FP,
                            sy / forest.FP - forest.origin(seed, u),
                        )
                        let to_roots = at_cell(
                            inside,
                            field,
                            u,
                            rx / forest.FP,
                            ry / forest.FP - forest.origin(seed, u),
                        )
                        let (cx, cy) = den_cell(seed, area, dens[0])
                        let (mx, my) = forest.portal(seed, area, forest.EDGE_SETT)
                        let teeth = at_cell(
                            distances(seed, field, area, cx, cy),
                            field,
                            area,
                            mx / forest.FP,
                            my / forest.FP - forest.origin(seed, area),
                        )
                        let hd = dens_of(seed, forest.HUSH)
                        let (hx, hy) = den_cell(seed, forest.HUSH, hd[0])
                        let (nx, ny) = forest.portal(seed, forest.HUSH, forest.EDGE_ROOTS)
                        let hush = at_cell(
                            distances(seed, field, forest.HUSH, hx, hy),
                            field,
                            forest.HUSH,
                            nx / forest.FP,
                            ny / forest.FP - forest.origin(seed, forest.HUSH),
                        )
                        if to_sett < 0 || to_roots < 0 || teeth < 0 || hush < 0 {
                            print("den-spacing: the Underteeth unreached seed {seed} field {field}")
                            return 1
                        }
                        let in_ = teeth + to_sett
                        let out = to_roots + hush
                        print("{seed} {field} {u} {ud.len} 0 0 {out} {in_}")
                        if in_ < forest.DEN_SPACING || out < forest.DEN_SPACING {
                            print("den-spacing: RED seed {seed} field {field} area {u}")
                            return 1
                        }
                        if in_ < worst_onward { worst_onward = in_ }
                        if out < worst_onward { worst_onward = out }
                    }
                    area = next
                }
            }
        }
        seed += 1
    }
    print("den-spacing: green, least within an area {worst_within}, least onward {worst_onward}")
    0
}

/// The foes an area starts with (R-cb05-4): per seed, field and area the
/// ordinary foes (the boss excluded) and the count of each kind. Exit 1
/// if a big area (the town, the thicket, the meadow) starts outside
/// 12..18 or a later area outside 8..12; the Shingle is the tutorial's.
pub fn foe_census() -> int {
    print("seed field area foes weasels foxes hawks deer ashen")
    var seed = 0
    while seed < 50 {
        for field in [80, 200] {
            var area = 0
            while area < forest.AREAS {
                let foes = sim.area_foes(seed, field, area, 0)
                var n = 0
                var kinds = [0, 0, 0, 0, 0]
                for f in foes {
                    if !sim.is_boss(f.kind) {
                        n += 1
                        if !sim.is_new_foe(f.kind) {
                            let k = if f.kind == sim.ASHEN then 4 else f.kind
                            kinds[k] += 1
                        }
                    }
                }
                print(
                    "{seed} {field} {area} {n} {kinds[0]} {kinds[1]} {kinds[2]} {kinds[3]} {kinds[4]}",
                )
                let big = area == forest.TOWN ||
                    area == forest.BRAMBLEHOLD ||
                    area == forest.LARKMEADOW
                // cb14: the Teeth, the Shallows and the Hush carry their
                // alcove guards on top of R-cb05-4's band (R-cb14-5); the
                // new areas hold their guards alone until cb18's foes.
                let fresh = area >= forest.STAND
                let lo = if big then FOES_BIG_MIN else if fresh then FOES_NEW_MIN else FOES_LATE_MIN
                let hi = if big then FOES_BIG_MAX else if fresh then FOES_NEW_MAX else FOES_LATE_MAX
                if area != forest.SHINGLE && (n < lo || n > hi) {
                    print("foe-census: RED area {area} has {n} foes")
                    return 1
                }
                area += 1
            }
        }
        seed += 1
    }
    let _ = new_foe_distribution()
    print("foe-census: green")
    0
}

/// A route's sample at `t`: the spine (path 0), the fork (1, Bramblehold),
/// a shaped branch (2 + cache), the coast's offshoots on the Shingle.
fn route_point(seed: int, field: int, area: int, path: int, t: int) -> (int, int) {
    if path == 0 { return (forest.spine(seed, area, t), t) }
    if path == 1 { return (forest.fork(seed, field, t), t) }
    if area == forest.SHINGLE { return (forest.coast_branch_x(seed, field, path - 2, t), t) }
    forest.branch_point(seed, field, area, path - 2, t)
}

fn route_range(seed: int, field: int, area: int, path: int) -> (int, int) {
    if path == 0 { return (0, forest.length(area)) }
    if path == 1 { return (forest.FORK_FROM, forest.FORK_TO) }
    if area == forest.SHINGLE { return (0, forest.coast_end(seed, path - 2)) }
    (0, forest.branch_len(seed, field, area, path - 2))
}

fn route_count(area: int) -> int {
    if area == forest.SHINGLE { return 2 + 4 }
    if area == forest.TOWN { return 1 }
    2 + forest.cache_count(area)
}

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// The bends (item 1's census): along every route and shaped branch,
/// sampled a cell at a time, the turn at each sample is the cross product
/// of the baseline four samples back and the one four ahead; a turn counts
/// above `BEND_TURN`; a reversal is two counted turns of opposite sign
/// within `BEND_WINDOW` samples. Exit 1 on any reversal on an inland route
/// or branch (the coast's offshoots are cb02's, reported, not gated).
pub fn bends() -> int {
    print("area routes samples turns reversals")
    var red = 0
    var area = 0
    while area < forest.AREAS {
        var samples = 0
        var turns = 0
        var reversals = 0
        var routes = 0
        var seed = 0
        while seed < 50 {
            for field in [80, 200] {
                var path = 0
                while path < route_count(area) {
                    if path == 1 && area != forest.BRAMBLEHOLD { path += 1; continue }
                    let (from, to) = route_range(seed, field, area, path)
                    routes += 1
                    var last_sign = 0
                    var last_at = -100
                    var t = from + BEND_ARM
                    while t <= to - BEND_ARM {
                        let (ax, ay) = route_point(seed, field, area, path, t - BEND_ARM)
                        let (bx, by) = route_point(seed, field, area, path, t)
                        let (cx, cy) = route_point(seed, field, area, path, t + BEND_ARM)
                        let ux = bx - ax
                        let uy = by - ay
                        let vx = cx - bx
                        let vy = cy - by
                        let cross = ux * vy - uy * vx
                        samples += 1
                        if abs(cross) >= BEND_TURN {
                            let sign = if cross > 0 then 1 else -1
                            turns += 1
                            if last_sign != 0 && sign != last_sign && t - last_at <= BEND_WINDOW {
                                reversals += 1
                                if area != forest.SHINGLE || path < 2 {
                                    print(
                                        "bends: reversal seed {seed} field {field} area {area} path {path} at {t}",
                                    )
                                    red += 1
                                }
                            }
                            last_sign = sign
                            last_at = t
                        }
                        t += 1
                    }
                    path += 1
                }
            }
            seed += 1
        }
        print("{area} {routes} {samples} {turns} {reversals}")
        area += 1
    }
    if red > 0 { print("bends: RED {red} reversals within {BEND_WINDOW} cells"); return 1 }
    print("bends: green, no reversal within {BEND_WINDOW} cells on any inland route or branch")
    0
}

/// Every spur ends at something named (item 5): each branch's end and each
/// pocket's end lies within three cells of a cache, a landmark or a den,
/// and the flood reaches it. Exit 1 otherwise.
pub fn spurs() -> int {
    print("seed field area spurs")
    var seed = 0
    while seed < 50 {
        for field in [80, 200] {
            region world {
                var area = 0
                while area < forest.AREAS {
                    let seen = forest.flood(seed, field, area)
                    var spurs = 0
                    var k = 0
                    let branches = if area == forest.TOWN || area == forest.SHINGLE {
                        0
                    } else {
                        forest.cache_count(area)
                    }
                    while k < branches + forest.pocket_count(area) {
                        let (ex, ey) = if k < branches {
                            forest.branch_point(
                                seed,
                                field,
                                area,
                                k,
                                forest.branch_len(seed, field, area, k),
                            )
                        } else {
                            forest.pocket_end(seed, area, k - branches)
                        }
                        if !forest.reached(seen, field, area, ex, ey) {
                            print(
                                "spurs: end unreached seed {seed} field {field} area {area} spur {k}",
                            )
                            return 1
                        }
                        if !named_near(seed, field, area, ex, ey) {
                            print(
                                "spurs: end unnamed seed {seed} field {field} area {area} spur {k} at {ex},{ey}",
                            )
                            return 1
                        }
                        spurs += 1
                        k += 1
                    }
                    print("{seed} {field} {area} {spurs}")
                    area += 1
                }
            }
        }
        seed += 1
    }
    print("spurs: green, every spur ends at a cache, a landmark or a den")
    0
}

/// Whether a cache, a landmark or a den lies within three cells of a
/// local cell.
fn named_near(seed: int, field: int, area: int, x: int, at: int) -> bool {
    let o = forest.origin(seed, area)
    var c = 0
    while c < forest.cache_count(area) {
        let (cx, cy) = forest.cache_position(seed, field, area, c)
        if abs((cx - forest.FP / 2) / forest.FP - x) <= 3 &&
            abs((cy - forest.FP / 2) / forest.FP - o - at) <= 3 {
            return true
        }
        c += 1
    }
    var k = 0
    while k < forest.landmark_count(area) {
        let (_, lx, ly) = forest.landmark(seed, field, area, k)
        if abs(lx - x) <= 3 && abs(ly - at) <= 3 { return true }
        k += 1
    }
    var den = 0
    while den < forest.DEN_LIMIT {
        if forest.den_area(den) == area {
            let (dx, dy) = den_cell(seed, area, den)
            if abs(dx - x) <= 3 && abs(dy - at) <= 3 { return true }
        }
        den += 1
    }
    false
}

/// The terrain layer's cost (item 6): every cell of an area classified
/// once (`forest.kind` over the whole width and length), both fields,
/// seed 1, milliseconds; exit 1 if an area at field 200 takes over
/// `GEN_MS`.
pub fn gen_bench() -> int {
    print("field area cells ms")
    var slow = 0
    for field in [80, 200] {
        var area = 0
        while area < forest.AREAS {
            let w = forest.bound(field, area)
            let o = forest.origin(1, area)
            let top = if area == forest.SHINGLE then forest.COAST_TOP else 0
            let t0 = clock.now_ns()
            var cells = 0
            var solid = 0
            var at = top
            while at <= forest.length(area) {
                var x = 0 - w
                while x <= w {
                    let k = forest.kind(1, field, area, x, o + at)
                    if k == terrain.TRUNK || k == terrain.DARK || k == terrain.WALL { solid += 1 }
                    cells += 1
                    x += 1
                }
                at += 1
            }
            let ms = (clock.now_ns() - t0) / 1000000
            print("{field} {area} {cells} {ms} solid {solid}")
            if field == 200 && ms > GEN_MS { slow += 1 }
            area += 1
        }
    }
    let _ = town.PLOTS
    if slow > 0 { print("gen-bench: RED {slow} areas over {GEN_MS} ms at field 200"); return 1 }
    print("gen-bench: green, every area under {GEN_MS} ms at field 200")
    0
}

/// Complete appended distribution, also callable without repeating legacy rows.
pub fn new_foe_distribution() -> int {
    // Appended distribution, never insert columns into inherited rows.
    print("new-foes seed field area martens adders moth_swarms herons glow_worms wisps")
    var six = 0
    var near = 0
    var nearest = 1000
    var new_seed = 0
    while new_seed < 50 {
        for field in [80, 200] {
            var area = forest.STAND
            while area <= forest.HOWE {
                let fs = sim.area_foes(new_seed, field, area, 0)
                let folk = sim.folk(new_seed, field, area)
                var counts = [0, 0, 0, 0, 0, 0]
                for f in fs {
                    if sim.is_new_foe(f.kind) {
                        counts[f.kind - sim.MARTEN] += 1
                        // cb16's NPCs: none of the six spawns within an
                        // NPC's talk radius (`npc.FACE_GAP` clear cells).
                        let g = sim.folk_gap(f, folk)
                        if g < nearest { nearest = g }
                        if g <= npc.FACE_GAP {
                            print(
                                "new-foe-near-npc {new_seed} {field} {area} {f.kind} {f.x / sim.FP} {f.y / sim.FP} {g}",
                            )
                            near += 1
                        }
                        six += 1
                    }
                }
                print(
                    "new-foes {new_seed} {field} {area} {counts[0]} {counts[1]} {counts[2]} {counts[3]} {counts[4]} {counts[5]}",
                )
                area += 1
            }
        }
        new_seed += 1
    }
    if near > 0 {
        print(
            "new-foe-npc-gap: RED, {near} of {six} spawns within {npc.FACE_GAP} clear cells of an NPC",
        )
        return 1
    }
    print(
        "new-foe-npc-gap: green, {six} spawns over 50 seeds at both fields, the nearest {nearest} clear cells from an NPC (talk radius {npc.FACE_GAP})",
    )
    0
}
