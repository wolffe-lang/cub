//! controls — cub's key vocabulary over the engine's decoder (the campaign's
//! controls table and the design bible's section 4). The engine (`input`)
//! turns the terminal's bytes into the terminal's keys; this module says
//! what each means to cub, in the numbers the simulation and the replay
//! file use. Every key below is recorded in a replay (`vocab`), so a run's
//! file is complete from the first build on; what the simulation applies
//! grows with the lanes (cb00: the moves of the feet and the quit; cb01:
//! bite, lunge, parry, dodge, lock-on, water, rest).
//!
//! The table: the arrows move (the cub turns toward the held direction at
//! its turn rate, never pivots); Shift+arrow sneaks that way (half speed,
//! no trail: the bible's section 4 — so Shift+Down is a sneak here, not
//! pack's parry; cub's parry is `z` alone, R-cb00-4 A); Space bites; `x`
//! lunges; `z` parries; `c` dodges; Tab locks on; `w` drinks; `r` rests at a
//! den; `m` mutes the music (cb03); `q` or Esc quits; Ctrl-C interrupts.

use input
use replay

/// No key (never pushed; the zero value).
pub const KEY_NONE: int = 0

/// Up: move north.
pub const KEY_UP: int = 1

/// Down: move south.
pub const KEY_DOWN: int = 2

/// Left: move west.
pub const KEY_LEFT: int = 3

/// Right: move east.
pub const KEY_RIGHT: int = 4

/// Shift+Up: sneak north.
pub const KEY_SNEAK_UP: int = 5

/// Shift+Down: sneak south.
pub const KEY_SNEAK_DOWN: int = 6

/// Shift+Left: sneak west.
pub const KEY_SNEAK_LEFT: int = 7

/// Shift+Right: sneak east.
pub const KEY_SNEAK_RIGHT: int = 8

/// Space: bite (cb01).
pub const KEY_BITE: int = 9

/// `x`: lunge (cb01).
pub const KEY_LUNGE: int = 10

/// `z`: parry (cb01).
pub const KEY_PARRY: int = 11

/// `c`: dodge (cb01).
pub const KEY_DODGE: int = 12

/// Tab: lock on the nearest foe (cb01).
pub const KEY_LOCK: int = 13

/// `w`: a mouthful of water (cb01).
pub const KEY_WATER: int = 14

/// `r`: rest at a den (cb01).
pub const KEY_REST: int = 15

/// `q` or Esc: quit.
pub const KEY_QUIT: int = 16

/// Ctrl-C as a byte: interrupt (the signal path is the terminal's).
pub const KEY_INTERRUPT: int = 17

/// The number of keys (every id below this).
pub const KEY_RELEASE: int = 18

/// Input identifier: heart.
pub const KEY_HEART: int = 19

/// Input identifier: wind.
pub const KEY_WIND: int = 20

/// Input identifier: fang.
pub const KEY_FANG: int = 21

/// Input identifier: paw.
pub const KEY_PAW: int = 22

/// Input identifier: nose.
pub const KEY_NOSE: int = 23

/// Input identifier: count.
pub const KEY_HEAVY: int = 24

/// Number of replay key identifiers.
pub const KEY_COUNT: int = 37

/// What a character means, or `KEY_NONE`.
fn char_key(b: int) -> int {
    if b >= 49 && b <= 53 {
        return KEY_HEART + b - 49
    }
    if b == 32 {
        return KEY_BITE
    }
    if b == 115 || b == 83 { return KEY_HEAVY }
    if b == 120 || b == 88 {
        return KEY_LUNGE
    }
    if b == 122 || b == 90 {
        return KEY_PARRY
    }
    if b == 99 || b == 67 {
        return KEY_DODGE
    }
    if b == 119 || b == 87 {
        return KEY_WATER
    }
    if b == 109 || b == 77 { return KEY_MUTE }
    if b == 114 || b == 82 {
        return KEY_REST
    }
    if b == 113 || b == 81 {
        return KEY_QUIT
    }
    KEY_NONE
}

/// cub's key for one of the engine's, or `KEY_NONE` for one cub does not
/// read.
pub fn map(k: int) -> int {
    if k == input.KEY_ENTER { return KEY_CONFIRM }
    if k == input.KEY_UP {
        return KEY_UP
    }
    if k == input.KEY_DOWN {
        return KEY_DOWN
    }
    if k == input.KEY_LEFT {
        return KEY_LEFT
    }
    if k == input.KEY_RIGHT {
        return KEY_RIGHT
    }
    if k == input.KEY_SHIFT_UP {
        return KEY_SNEAK_UP
    }
    if k == input.KEY_SHIFT_DOWN {
        return KEY_SNEAK_DOWN
    }
    if k == input.KEY_SHIFT_LEFT {
        return KEY_SNEAK_LEFT
    }
    if k == input.KEY_SHIFT_RIGHT {
        return KEY_SNEAK_RIGHT
    }
    if k == input.KEY_TAB {
        return KEY_LOCK
    }
    if k == input.KEY_ESC {
        return KEY_RELEASE
    }
    if k == input.KEY_INTERRUPT {
        return KEY_INTERRUPT
    }
    let ch = input.char_of(k)
    let mapped = if ch >= 0 then char_key(ch) else KEY_NONE
    if mapped == KEY_NONE then KEY_SKIP else mapped
}

/// Every key of `raw` mapped and pushed onto `keys`, in order, the ones
/// cub does not read dropped.
pub fn map_all(raw: List[int], mut keys: List[int]) {
    for k in raw {
        let m = map(k)
        if m != KEY_NONE {
            (mut keys).push(m)
        }
    }
}

/// Whether `k` is one of the eight movement keys.
pub fn is_move(k: int) -> bool {
    k >= KEY_UP && k <= KEY_SNEAK_RIGHT
}

/// The key's name in a replay file (lair's `docs/REPLAY.md`; cub's words).
pub fn key_name(k: int) -> str {
    replay.key_name(vocab(), k)
}

/// The key a replay file's name means; `parse` for a name that is none.
pub fn key_of(name: str) -> int ! {parse} {
    replay.key_of(vocab(), name)
}

/// The numeric events by index: `health` and `scent` (cb01's deltas),
/// `opening` (cb02's scene), `journey` (the snapshot's version) and the
/// snapshot's values `saved-0` to `saved-29` (`journey.SNAPSHOT`).
pub const EV_HEALTH: int = 0

/// The scent delta.
pub const EV_SCENT: int = 1

/// The opening scene.
pub const EV_OPENING: int = 2

/// The journey snapshot's version.
pub const EV_JOURNEY: int = 3

/// The first snapshot value; `EV_SAVED + i` is `saved-i`.
pub const EV_SAVED: int = 4

/// The snapshot's values (`journey.SNAPSHOT`, named here so the vocabulary
/// imports nothing of the save).
pub const SAVED: int = 30

/// The title scene (cb04): `title 1` at a tick shows the title there.
pub const EV_TITLE: int = 34

/// The bosses beaten, set as a test/debug delta (cb04): `bosses N` sets
/// the save's bits, as `health` and `scent` move the cub's numbers.
pub const EV_BOSSES: int = 35

/// A ghost's trailer (cb04, `ghost`): the cub's position each of the last
/// ticks before a death, as the game's own words.
pub const EV_GHOST_X: int = 36

/// The trailer's y.
pub const EV_GHOST_Y: int = 37

/// The trailer's facing.
pub const EV_GHOST_FACE: int = 38

/// The trailer's pose.
pub const EV_GHOST_POSE: int = 39

/// The trailer's area.
pub const EV_GHOST_AREA: int = 40

/// The death's serial (the journey's death count), once per trailer.
pub const EV_GHOST_DEATH: int = 41

/// The number of numeric events.
pub const EV_COUNT: int = 49

/// cub's words for the replay file: the keys by number, and the numeric
/// events by index (`EV_*`).
pub fn vocab() -> replay.Vocab {
    var names = List[str]()
    for w in "none up down left right sneak-up sneak-down sneak-left sneak-right bite lunge parry dodge lock water rest quit interrupt release heart wind fang paw nose heavy skip mute confirm exact ctrl-down ctrl-up shift-down shift-up up-release down-release left-release right-release".
        words() {
        (mut names).push(w)
    }
    var args = List[str]()
    (mut args).push("health")
    (mut args).push("scent")
    (mut args).push("opening")
    (mut args).push("journey")
    var part = 0
    while part < SAVED { (mut args).push("saved-{part}"); part += 1 }
    for w in "title bosses ghost-x ghost-y ghost-face ghost-pose ghost-area ghost-death".words() {
        (mut args).push(w)
    }
    // Slots 30..35 are cb04f's (six slain masks); 36 is cb05's seventh
    // area's, appended after them.
    part = 30
    while part < 37 { (mut args).push("saved-{part}"); part += 1 }
    replay.vocab(take names, take args)
}

/// An otherwise unused decoded key; skips scenes, inert during play.
pub const KEY_SKIP: int = 25

/// `m`: the music off, on again (cb03); the live loop's, inert in the
/// simulation, recorded like every key so a replay is complete.
pub const KEY_MUTE: int = 26

/// Enter confirms the staged den purchases; inert outside rest.
pub const KEY_CONFIRM: int = 27

/// Snapshot event slots 30..36 are appended, never renumbering older events
/// (30..35 cb04f's six slain masks, 36 the seventh area's, cb05).
pub fn saved_event(part: int) -> int { if part < 30 then EV_SAVED + part else 42 + part - 30 }
/// Negotiated input mode, recorded before the first live tick.
pub const KEY_EXACT: int = 28

/// Control modifier down (or refreshed by a legacy Ctrl+arrow).
pub const KEY_CTRL_DOWN: int = 29

/// Control modifier released.
pub const KEY_CTRL_UP: int = 30

/// Shift modifier down.
pub const KEY_SHIFT_DOWN: int = 31

/// Shift modifier released.
pub const KEY_SHIFT_UP: int = 32

/// Four arrow releases in Up/Down/Left/Right order.
pub const KEY_ARROW_RELEASE: int = 33

/// Project engine events to replayable game keys; releases never act.
/// Modifier transitions precede the key, including modifiers held at entry.
pub fn events(raw: List[input.Event], mut keys: List[int]) {
    for e in raw {
        (mut keys).push(if e.mods & input.MOD_CTRL != 0 then KEY_CTRL_DOWN else KEY_CTRL_UP)
        (mut keys).push(if e.mods & input.MOD_SHIFT != 0 then KEY_SHIFT_DOWN else KEY_SHIFT_UP)
        if e.kind == input.RELEASE {
            if e.key >= input.KEY_UP && e.key <= input.KEY_RIGHT {
                (mut keys).push(KEY_ARROW_RELEASE + e.key - input.KEY_UP)
            }
            continue
        }
        if e.key >= input.KEY_LEFT_SHIFT && e.key <= input.KEY_ALT { continue }
        var k = map(e.key)
        if k >= KEY_UP && k <= KEY_RIGHT && e.mods & input.MOD_SHIFT != 0 { k += 4 }
        if k == KEY_BITE && e.mods & input.MOD_SHIFT != 0 { k = KEY_HEAVY }
        // A held c never becomes a sprint or automatically queues a roll.
        if k == KEY_DODGE && e.kind == input.REPEAT { continue }
        if k != KEY_NONE { (mut keys).push(k) }
    }
}
