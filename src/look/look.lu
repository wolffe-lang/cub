//! The level's presentation instrument. Walk the camera over every route
//! row and named prop, independently of combat/path planning. No keys or
//! growth overrides claim a playable walk; gameplay/pty cover that layer.

use art
use forest
use grid
use sim

/// A world layer must not carry any retired placeholder word. Fixed HUD,
/// dialogue and interaction rows are deliberately outside the level layer.
pub fn no_labels(g: grid.Grid) -> bool {
    let words = [
        "Ember",
        "hollow",
        "burrow",
        "empty",
        "Bramblehold",
        "Larkmeadow",
        "Old Snag",
        "bones,",
        "scent-marked",
        "The Teeth",
        "The Shallows",
        "Gravehollow",
        "pack's",
        "[ hedge ]",
        "[ ledge ]",
        "[ shallows ]",
        "[Log]",
    ]
    // Bars, numeric status, water and the den hint occupy rows0..7.
    var row = 8
    while row < g.rows - 2 {
        var text = ""
        var col = 0
        while col < g.cols {
            let cp = grid.at(g, row, col).cp
            text += if cp < 128 then cp as char else ' '
            col += 1
        }
        for word in words { if text.contains(word) { return false } }
        row += 1
    }
    true
}

fn frame_at(mut s: sim.Sim, x: int, y: int, mut count: int) -> bool {
    s.x = x
    s.y = y
    s.tick += 1
    var t = 0
    while t < 2 {
        region frame {
            var g = grid.new(s.rows, s.cols)
            art.render(s, t, mut g)
            if !no_labels(g) {
                print("look: PLACEHOLDER seed {s.seed} area {s.area} x {x} y {y} tier {t}")
                return false
            }
        }
        count += 1
        t += 1
    }
    true
}

/// Fifty deterministic seeds, both tiers: every route row and each cache,
/// shortcut and former world-label position is centred in a rendered frame.
pub fn census() -> int {
    var count = 0
    var seed = 0
    while seed < 50 {
        region world {
            var s = sim.new(seed, 80, 24)
            s.foes = List[sim.Foe]()
            var area = 0
            while area < forest.AREAS {
                s.area = area
                var y = 0
                while y < forest.LENGTH {
                    let x = forest.spine(seed, area, y)
                    if !frame_at(
                        mut s,
                        x * sim.FP,
                        (y + forest.origin(seed, area)) * sim.FP,
                        mut count,
                    ) {
                        return 1
                    }
                    y += 1
                }
                var k = 0
                while k < forest.cache_count(area) {
                    let (x, cy) = forest.cache_position(seed, s.field, area, k)
                    if !frame_at(mut s, x, cy, mut count) { return 1 }
                    s.caches = 65535
                    if !frame_at(mut s, x, cy, mut count) { return 1 }
                    s.caches = 0
                    k += 1
                }
                var edge = 0
                while edge < forest.EDGES {
                    if forest.other(area, edge) >= 0 {
                        let (x, py) = forest.portal(seed, area, edge)
                        if !frame_at(mut s, x, py, mut count) { return 1 }
                    }
                    edge += 1
                }
                for spot in [-10, -4, 0, 8, 10, 12] {
                    for py in [18, 24, 30, 36, forest.BOAR_ROW - 2, forest.LENGTH - 3] {
                        if !frame_at(mut s, spot * sim.FP, py * sim.FP, mut count) { return 1 }
                    }
                }
                area += 1
            }
        }
        print("look: seed {seed} both tiers no placeholders")
        seed += 1
    }
    print("look: green seeds {seed} frames {count}")
    0
}

/// Compare the shipping actor layer against cell-clipped sprite composition at
/// every route row. Camera moves; actor world positions do not. Any omitted
/// in-view cell is a failure, even if another part of that foe remained visible.
pub fn foe_census() -> int {
    var frames = 0
    var missing = 0
    var legacy_hidden = 0
    var seed = 0
    while seed < 50 {
        for field in [80, 200] {
            region world {
                var s = sim.new(seed, field, if field == 80 then 24 else 60)
                var area = 0
                while area < forest.AREAS {
                    s.area = area
                    s.foes = sim.area_foes(seed, field, area, 0)
                    var y = 0
                    while y <= forest.LENGTH {
                        s.x = forest.spine(seed, area, y) * sim.FP
                        s.y = (forest.origin(seed, area) + y) * sim.FP
                        for t in [0, 1] {
                            region frame {
                                var actual = grid.new(s.rows, s.cols)
                                var expected = grid.new(s.rows, s.cols)
                                art.draw_foes(s, t, mut actual)
                                var i = 0
                                while i < s.foes.len {
                                    let f = copy s.foes[i]
                                    let r = sim.floor_div(f.y, sim.FP) -
                                        sim.cell_y(s) +
                                        sim.screen_row(s)
                                    let c = sim.floor_div(f.x, sim.FP) -
                                        sim.cell_x(s) +
                                        sim.screen_col(s)
                                    art.draw_foe(
                                        mut expected,
                                        t,
                                        r,
                                        c,
                                        f.kind,
                                        f.phase,
                                        f.heading,
                                        -1,
                                    )
                                    let body = sim.foe_body(f)
                                    let left = body.x0 - sim.cell_x(s) + sim.screen_col(s)
                                    let right = body.x1 - sim.cell_x(s) + sim.screen_col(s)
                                    let top = body.y0 - sim.cell_y(s) + sim.screen_row(s)
                                    let bottom = body.y1 - sim.cell_y(s) + sim.screen_row(s)
                                    if area == 1 &&
                                        right >= 0 &&
                                        left < s.cols &&
                                        bottom >= 0 &&
                                        top < s.rows &&
                                        !sim.visible(s, s.x, s.y, f.x, f.y) {
                                        legacy_hidden += 1
                                    }
                                    i += 1
                                }
                                i = 0
                                var mismatch = false
                                while i < actual.cells.len {
                                    if !grid.same(actual.cells[i], expected.cells[i]) {
                                        mismatch = true
                                    }
                                    i += 1
                                }
                                if mismatch { missing += 1 }
                                frames += 1
                            }
                        }
                        y += 1
                    }
                    area += 1
                }
            }
        }
        print(
            "foes: seed {seed} frames {frames} omitted_frames {missing} legacy_hidden_foe_frames {legacy_hidden}",
        )
        seed += 1
    }
    print("foes: frames {frames} omitted_frames {missing} legacy_hidden_foe_frames {legacy_hidden}")
    if missing == 0 then 0 else 1
}
