#!/usr/bin/env python3
"""tools/score-check — the score's gate over the built binaries (cb03).

    python3 -I tools/score-check [--update]

For the native and the release binary: every part renders to the bytes
the golden pins (tests/goldens/score/<name>.sha256 holds the PCM's sha256
and length; <name>.head.pcm its first second, so a diff has bytes to show:
R-cb03-4 B), the cue schedule's replay renders to tests/goldens/score/
replay.pcm (the whole six seconds), each loop's seam is quiet (the last
tick under the bar, the first tick's attack rising from near silence), a
WAV carries the canonical header over the same bytes, and a part that does
not parse is refused by name with no output written. --update writes the
goldens afresh from the release binary.

cb17: every scene script (`cub --score-scene NAME OUT`, one for each part
cb17 wrote, and `six`, the replay above) pins its cue schedule as text
(tests/goldens/score/scene-<name>.cues: a `tick T cue NAME` line for every
cue it starts) and its mixer's PCM by sha256 and length (scene-<name>.sha256);
`six` renders the very bytes of replay.pcm; the Hush's first entry is silent
from the Shallows' fade to its 300th tick (R-cb17-1 A). A part dropped from
the bank turns its scene's cue into the silence: a red golden by name.
The sound census (`cub --sound-census`, the release binary): cb14's walk from
the Shingle to Gravehollow, with the Stand's lookout, replayed through the
schedule; every area entered cues its own part, the lookout the reveal, the
Mere's water the crossing, the Howe the walk, the Hush its wait and motif.
And the memory gate's budget with every part loaded: tools/memory-probe.py
over the release binary's real loop with the music on through the OSS stub
(silent on every host: the stub refuses by name, no player starts), seed 7,
4096 bytes a tick, as tools/check-memory holds the muted game.
"""
import hashlib
import os
import struct
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "target" / "score"
GOLD = ROOT / "tests" / "goldens" / "score"
HEAD_BYTES = 48000 * 4
SEAM_BAR = 256
# The bank's order (`score.names`): cb03's eleven, then cb17's fourteen.
NAMES = ["title", "shingle", "bramblehold", "larkmeadow", "boss-boar", "boss-lynx",
         "boss-elk", "boss-alpha", "den", "death", "crack",
         "cinderwick", "stand", "burn", "teeth", "underteeth", "mere", "shallows", "hush",
         "howe", "gravehollow", "moonford", "reveal", "crossing", "walk"]
ONCE = ["death", "crack", "reveal"]
# The scene scripts (`score.scene_names`) and their ticks.
SCENES = [("six", 180), ("cinderwick", 150), ("stand", 150), ("reveal", 330), ("burn", 150),
          ("teeth", 150), ("underteeth", 150), ("mere", 150), ("crossing", 180),
          ("shallows", 150), ("hush", 510), ("howe", 150), ("walk", 195),
          ("gravehollow", 240), ("moonford", 180)]
TICK = 1600 * 4


def run(binary, *args, ok=0):
    p = subprocess.run([str(binary), *map(str, args)], capture_output=True)
    if p.returncode != ok:
        raise AssertionError("%s: exit %s (wanted %s): %s" % (args, p.returncode, ok, p.stderr.decode()))
    return p


def names(binary):
    """The listing: every part with its length, then every scene script."""
    p = run(binary, "--score-list")
    parts, scenes = [], []
    for line in p.stdout.decode().splitlines():
        w = line.split()
        if w[0] == "scene":
            assert w[2] == "ticks", line
            scenes.append((w[1], int(w[3])))
            continue
        assert w[0] == "part" and w[2] == "seconds" and not scenes, line
        parts.append((w[1], int(w[3]), w[5] == "1"))
    return parts, scenes


def peak(b):
    n = len(b) // 2
    s = struct.unpack("<%dh" % n, b)
    return max(max(s), -min(s))


def check_part(binary, tier, name, seconds, once, update):
    pcm = OUT / ("%s-%s.pcm" % (name, tier))
    run(binary, "--score-render", name, pcm)
    b = pcm.read_bytes()
    assert len(b) == seconds * 48000 * 4, (name, len(b))
    assert any(b), "%s renders silence" % name
    digest = hashlib.sha256(b).hexdigest()
    line = "%s %d\n" % (digest, len(b))
    if update and tier == "release":
        (GOLD / (name + ".sha256")).write_text(line)
        (GOLD / (name + ".head.pcm")).write_bytes(b[:HEAD_BYTES])
        print("score-golden %s written %s" % (name, digest), flush=True)
    else:
        want = (GOLD / (name + ".sha256")).read_text()
        head = (GOLD / (name + ".head.pcm")).read_bytes()
        if b[:HEAD_BYTES] != head:
            first = next(i for i in range(len(head)) if b[i] != head[i])
            raise AssertionError("score-golden %s/%s FAILED: the first second differs at byte %d" % (name, tier, first))
        if line != want:
            raise AssertionError("score-golden %s/%s FAILED: %s != %s" % (name, tier, line.strip(), want.strip()))
        print("score-golden %s/%s ok %s" % (name, tier, digest), flush=True)
    # The seam: a loop's last tick is quiet (under the bar, -42 dBFS), so
    # its restart meets no tail; a part may open on a downbeat (the boar's
    # drum), so the start is not held. A sting's end is the mixer's fade.
    tick = 1600 * 4
    if not once:
        last = peak(b[-tick:])
        assert last <= SEAM_BAR, "score-seam %s FAILED: the last tick peaks at %d (bar %d)" % (name, last, SEAM_BAR)
        print("score-seam %s/%s ok last-tick peak %d" % (name, tier, last), flush=True)
    return b


def check_scene(binary, tier, name, ticks, update):
    """A scene script's cue schedule (text) and its mixer's PCM (sha256)."""
    pcm = OUT / ("scene-%s-%s.pcm" % (name, tier))
    p = run(binary, "--score-scene", name, pcm)
    cued = p.stdout.decode()
    b = pcm.read_bytes()
    assert len(b) == ticks * TICK, (name, len(b))
    digest = hashlib.sha256(b).hexdigest()
    line = "%s %d\n" % (digest, len(b))
    if update and tier == "release":
        (GOLD / ("scene-%s.cues" % name)).write_text(cued)
        (GOLD / ("scene-%s.sha256" % name)).write_text(line)
        print("score-scene %s written %s" % (name, digest), flush=True)
    else:
        want = (GOLD / ("scene-%s.cues" % name)).read_text()
        if cued != want:
            got_lines, want_lines = cued.splitlines(), want.splitlines()
            first = next((i for i in range(max(len(got_lines), len(want_lines)))
                          if i >= len(got_lines) or i >= len(want_lines) or got_lines[i] != want_lines[i]), 0)
            raise AssertionError("score-scene %s/%s FAILED: the cue schedule differs at line %d: %r, golden %r" % (
                name, tier, first + 1,
                got_lines[first] if first < len(got_lines) else None,
                want_lines[first] if first < len(want_lines) else None))
        if line != (GOLD / ("scene-%s.sha256" % name)).read_text():
            raise AssertionError("score-scene %s/%s FAILED: the mixer's PCM %s, golden %s" % (
                name, tier, line.strip(), (GOLD / ("scene-%s.sha256" % name)).read_text().strip()))
        print("score-scene %s/%s ok %d cues %s" % (name, tier, len(cued.splitlines()), digest), flush=True)
    return b


def check_memory():
    """The resident growth over the real loop with every part prepared."""
    import json
    p = subprocess.run([sys.executable, "-I", str(ROOT / "tools" / "memory-probe.py"),
                        "--bin", str(ROOT / "target" / "release" / "cub"),
                        "--work", str(ROOT / "target" / "memory-probes"),
                        "--seed", "7", "--warmup", "60", "--ticks", "600", "--timeout", "120",
                        "--ceiling", "2147483648", "--budget", "4096", "--sound-backend", "oss"],
                       capture_output=True, text=True)
    rows = [json.loads(l) for l in p.stdout.splitlines() if l.startswith("{")]
    verdict = rows[-1] if rows else {}
    if p.returncode != 0 or verdict.get("status") != "GREEN":
        raise AssertionError("score-memory FAILED (exit %d): %s %s" % (p.returncode, verdict, p.stderr[-300:]))
    start = rows[0]["rss_bytes"] if rows else 0
    print("score-memory ok %.1f bytes/tick over %d ticks (budget 4096), sound on (oss), first sample %d KiB, %d to %d bytes" % (
        verdict["bytes_per_tick"], verdict["ticks"], start // 1024,
        verdict["start"]["rss_bytes"], verdict["end"]["rss_bytes"]), flush=True)


def check_census():
    """The schedule over the real walk: the binary's own rows, exit 0."""
    p = run(ROOT / "target" / "release" / "cub", "--sound-census")
    lines = p.stdout.decode().splitlines()
    assert lines and lines[-1].startswith("sound-census entries"), lines[-3:]
    print("score-census ok: %s" % lines[-1], flush=True)


def main():
    update = "--update" in sys.argv[1:]
    OUT.mkdir(parents=True, exist_ok=True)
    GOLD.mkdir(parents=True, exist_ok=True)
    for tier in ("release", "native"):
        binary = ROOT / "target" / tier / "cub"
        listed, scenes = names(binary)
        assert scenes == SCENES, scenes
        # The cue schedules first (cb17): a part missing from the bank is
        # its scene's red line by name before any listing or render row.
        played = {}
        for name, ticks in SCENES:
            played[name] = check_scene(binary, tier, name, ticks, update)
        s = played["hush"]
        # R-cb17-1 A: the Shallows fade out over their 9 ticks from tick 45;
        # from tick 55 to the wait's end (tick 345) nothing.
        quiet = peak(s[55 * TICK:345 * TICK])
        assert quiet == 0, "score-hush %s FAILED: the first entry's wait peaks at %d" % (tier, quiet)
        assert peak(s[346 * TICK:405 * TICK]) > 0, "score-hush %s FAILED: no motif after the wait" % tier
        print("score-hush %s ok ticks 55-344 silent, the motif from 345" % tier, flush=True)
        assert [n for n, _, _ in listed] == NAMES, listed
        assert [n for n, _, once in listed if once] == ONCE, listed
        for name, seconds, once in listed:
            check_part(binary, tier, name, seconds, once, update)
        replay = OUT / ("replay-%s.pcm" % tier)
        run(binary, "--score-replay", replay)
        b = replay.read_bytes()
        assert len(b) == 180 * 6400, len(b)
        if update and tier == "release":
            (GOLD / "replay.pcm").write_bytes(b)
            print("score-golden replay written", flush=True)
        else:
            want = (GOLD / "replay.pcm").read_bytes()
            if b != want:
                first = next(i for i in range(min(len(b), len(want))) if b[i] != want[i])
                raise AssertionError("score-golden replay/%s FAILED at byte %d" % (tier, first))
            print("score-golden replay/%s ok %s" % (tier, hashlib.sha256(b).hexdigest()), flush=True)
        assert played["six"] == b, "score-scene six/%s FAILED: not the replay's bytes" % tier
        print("score-scene six/%s is replay.pcm" % tier, flush=True)
        # The replay's shape: silent before the title's fade-in completes
        # its first tick is quiet; the sting's bytes louder than the den's.
        wave = OUT / ("den-%s.wav" % tier)
        run(binary, "--score-wav", "den", wave)
        w = wave.read_bytes()
        assert w[:4] == b"RIFF" and w[8:16] == b"WAVEfmt " and w[36:40] == b"data"
        assert struct.unpack("<IHHIIHH", w[16:36]) == (16, 1, 2, 48000, 192000, 4, 16)
        assert struct.unpack("<I", w[4:8])[0] == len(w) - 8 and struct.unpack("<I", w[40:44])[0] == len(w) - 44
        assert w[44:] == (OUT / ("den-%s.pcm" % tier)).read_bytes()
        print("score-wav %s ok" % tier, flush=True)
        bad = OUT / ("bad-%s.pcm" % tier)
        bad.unlink(missing_ok=True)
        failure = run(binary, "--score-render", "no-such-part", bad, ok=2)
        assert b"no-such-part" in failure.stderr and not bad.exists()
        print("score-refusal %s ok" % tier, flush=True)
    check_census()
    check_memory()
    print("score-check: green")


if __name__ == "__main__":
    main()
