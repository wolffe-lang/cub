#!/usr/bin/env python3
"""tools/score-embed — write src/score/parts.lu from score/*.part.

The parts are written and reviewed as text under score/ (px32's part
format); the game carries them inside its binary, so `cub` plays from any
directory and an install needs no data files. This tool is the one way
the module is written; `src/score_test.lu` holds the embedded text to the
files, so a part edited without a rerun is a red test, never a stale tune.

    python3 -I tools/score-embed
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCORE = os.path.join(ROOT, "score")
OUT = os.path.join(ROOT, "src", "score", "parts.lu")
# The bank's order: the mixer's cue names (score.lu's `names`).
ORDER = ["title", "shingle", "bramblehold", "larkmeadow", "boss-boar", "boss-lynx",
         "boss-elk", "boss-alpha", "den", "death"]


def literal(text):
    out = []
    for ch in text:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "{":
            out.append("{{")
        elif ch == "}":
            out.append("}}")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def main():
    files = sorted(f[:-5] for f in os.listdir(SCORE) if f.endswith(".part"))
    if files != sorted(ORDER):
        print("score-embed: score/ holds %s, the order names %s" % (files, sorted(ORDER)))
        return 1
    lines = ["//! parts — the score's text, embedded (GENERATED by tools/score-embed",
             "//! from score/*.part; edit the files, rerun the tool). cb03.",
             "",
             "/// The text of the part `name` as committed under score/, or \"\".",
             "pub fn text(name: str) -> str {"]
    first = True
    for name in ORDER:
        with open(os.path.join(SCORE, name + ".part"), encoding="utf-8") as f:
            body = f.read()
        lines.append("    %sif name == \"%s\" {" % ("" if first else "} else ", name))
        lines.append("        return %s" % literal(body))
        first = False
    lines.append("    }")
    lines.append('    ""')
    lines.append("}")
    lines.append("")
    with open(OUT, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    print("score-embed: wrote %s (%d parts)" % (os.path.relpath(OUT, ROOT), len(ORDER)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
