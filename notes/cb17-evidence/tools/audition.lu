//! audition — cb17's scratch renderer (not in the repo): a part file to
//! PCM at its own length, through the engine's reader and mixer exactly as
//! cub's score module prepares it. `audition PART OUT.pcm`.

use sound
use std.env
use std.fs

fn body_of(text: str) -> str {
    var body = ""
    for line in text.lines() {
        let ws = line.words()
        if ws.len > 0 && ws[0] == "cue" { continue }
        body = body + line + "\n"
    }
    body
}

fn main() -> int {
    let args = env.args()
    if args.len != 2 {
        eprint("usage: audition PART OUT.pcm")
        return 2
    }
    let text = fs.read_text(args[0]) else |_| {
        eprint("audition: cannot read {args[0]}")
        return 2
    }
    let s = sound.read(body_of(text))
    if s.err != "" {
        eprint("audition: {args[0]}: {s.err}")
        return 2
    }
    let seconds = (s.total + 999999) / 1000000
    let p = sound.prepare(args[0], text, seconds) else |_| { return 2 }
    fs.write_bytes(args[1], p.pcm) else |_| {
        eprint("audition: cannot write {args[1]}")
        return 2
    }
    print("seconds {seconds} total_us {s.total} fade {p.fade} layer {if p.layer then 1 else 0}")
    0
}
